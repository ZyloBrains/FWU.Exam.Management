@model fwu_examination_management_system.Models.CProgram
@{ ViewData["Title"] = "Create Program"; }
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Create Program</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-6"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div><label asp-for="ProgramName" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="ProgramName" class="w-full" placeholder="Enter program name" /><span asp-validation-for="ProgramName" class="text-red-500 text-xs mt-1 block"></span></div>
                <div><label asp-for="ShortName" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="ShortName" class="w-full" placeholder="Enter short name" /><span asp-validation-for="ShortName" class="text-red-500 text-xs mt-1 block"></span></div>
                <div><label asp-for="LevelId" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="LevelId" type="number" class="w-full" placeholder="Enter level ID" /><span asp-validation-for="LevelId" class="text-red-500 text-xs mt-1 block"></span></div>
                <div><label asp-for="FacultyId" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="FacultyId" type="number" class="w-full" placeholder="Enter faculty ID" /><span asp-validation-for="FacultyId" class="text-red-500 text-xs mt-1 block"></span></div>
                <div><label asp-for="Duration" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="Duration" type="number" class="w-full" placeholder="Enter duration (years)" /><span asp-validation-for="Duration" class="text-red-500 text-xs mt-1 block"></span></div>
                <div class="flex items-center gap-3 pt-4"><input asp-for="IsActive" type="checkbox" class="text-blue-600" /><label asp-for="IsActive" class="text-sm font-semibold text-gray-700">Active</label></div>
            </div>
            <div class="flex items-center gap-3 mt-8 pt-6 border-t border-gray-200">
                <button type="submit" class="px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm"><i class="fas fa-save mr-2"></i>Save</button>
                <a asp-action="Index" class="px-6 py-3 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
