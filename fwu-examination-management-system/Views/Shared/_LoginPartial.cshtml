@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="flex flex-col sm:flex-row">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <a class="block px-3 py-2 text-gray-700 hover:text-gray-900" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
    </li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="px-3 py-2 text-gray-700 hover:text-gray-900 bg-transparent border-none cursor-pointer">Logout</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="block px-3 py-2 text-gray-700 hover:text-gray-900" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li>
        <a class="block px-3 py-2 text-gray-700 hover:text-gray-900" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
