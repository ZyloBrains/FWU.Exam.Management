@model fwu_examination_management_system.Models.AcademicYear
@{ ViewData["Title"] = "Delete Academic Year"; }
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-3"><a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200"><i class="fas fa-arrow-left text-gray-600"></i></a><div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center"><i class="fas fa-trash text-red-600"></i></div><h1 class="text-2xl font-bold text-gray-800">Delete Academic Year</h1></div>
    <div class="bg-white rounded-xl shadow-sm border border-red-200 p-6">
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6"><p class="text-sm text-red-700"><i class="fas fa-exclamation-triangle mr-2"></i>Are you sure you want to delete this academic year?</p></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6"><div><p class="text-xs text-gray-500 font-medium uppercase">Name</p><p class="text-sm font-semibold text-gray-800 mt-1">@Model.AcademicYearName</p></div><div><p class="text-xs text-gray-500 font-medium uppercase">Code</p><p class="text-sm text-gray-800 mt-1">@Model.AcademicYearCode</p></div></div>
        <form asp-action="Delete" method="post"><input type="hidden" asp-for="AcademicYearID" /><div class="flex items-center gap-3 pt-4 border-t border-gray-200"><button type="submit" class="px-5 py-2.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 shadow-sm"><i class="fas fa-trash mr-2"></i>Delete</button><a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200">Cancel</a></div></form>
    </div>
</div>
