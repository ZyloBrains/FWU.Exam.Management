@model fwu_examination_management_system.Models.ExamSchedule
@{ ViewData["Title"] = "Exam Schedule Details"; }
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center"><i class="fas fa-clock text-orange-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Exam Schedule Details</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="md:col-span-2 detail-field"><p class="field-label">Schedule Name</p><p class="field-value">@Model.ExamScheduleName</p></div>
            <div class="detail-field"><p class="field-label">Schedule Code</p><p class="field-value">@(Model.ExamScheduleCode ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Academic Year ID</p><p class="field-value">@Model.AcademicYearID</p></div>
            <div class="detail-field"><p class="field-label">Level ID</p><p class="field-value">@Model.LevelID</p></div>
            <div class="detail-field"><p class="field-label">Year Part ID</p><p class="field-value">@Model.YearPartID</p></div>
            <div class="detail-field"><p class="field-label">Exam Type ID</p><p class="field-value">@Model.ExamTypeID</p></div>
            <div class="detail-field"><p class="field-label">Start Date (AD)</p><p class="field-value">@(Model.StartFromAD?.ToString("yyyy-MM-dd") ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">End Date (AD)</p><p class="field-value">@(Model.EndToAD?.ToString("yyyy-MM-dd") ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Start Date (BS)</p><p class="field-value">@(Model.StartFromBS ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">End Date (BS)</p><p class="field-value">@(Model.EndToBS ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Start Time</p><p class="field-value">@Model.StartTime.ToString("hh\\:mm")</p></div>
            <div class="detail-field"><p class="field-label">End Time</p><p class="field-value">@Model.EndTime.ToString("hh\\:mm")</p></div>
            <div class="detail-field"><p class="field-label">Remarks</p><p class="field-value">@(Model.Remarks ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Status</p><p class="mt-1">@if (Model.Active) { <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Active</span> } else { <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Inactive</span> }</p></div>
        </div>
        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@Model.ExamScheduleID" class="px-6 py-3 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition-colors shadow-sm"><i class="fas fa-edit mr-2"></i>Edit</a> }
            <a asp-action="Index" class="px-6 py-3 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-colors">Back to List</a>
        </div>
    </div>
</div>
