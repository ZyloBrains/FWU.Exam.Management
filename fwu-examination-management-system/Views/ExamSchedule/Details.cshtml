@model fwu_examination_management_system.Models.ExamSchedule
@{ ViewData["Title"] = "Exam Schedule Details"; }
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center"><i class="fas fa-clock text-orange-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Exam Schedule Details</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2"><p class="text-xs text-gray-500 font-medium uppercase">Schedule Name</p><p class="text-sm font-semibold text-gray-800 mt-1">@Model.ExamScheduleName</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Schedule Code</p><p class="text-sm text-gray-700 mt-1">@(Model.ExamScheduleCode ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Academic Year ID</p><p class="text-sm text-gray-700 mt-1">@Model.AcademicYearID</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Level ID</p><p class="text-sm text-gray-700 mt-1">@Model.LevelID</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Year Part ID</p><p class="text-sm text-gray-700 mt-1">@Model.YearPartID</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Exam Type ID</p><p class="text-sm text-gray-700 mt-1">@Model.ExamTypeID</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Start Date (AD)</p><p class="text-sm text-gray-700 mt-1">@(Model.StartFromAD?.ToString("yyyy-MM-dd") ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">End Date (AD)</p><p class="text-sm text-gray-700 mt-1">@(Model.EndToAD?.ToString("yyyy-MM-dd") ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Start Date (BS)</p><p class="text-sm text-gray-700 mt-1">@(Model.StartFromBS ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">End Date (BS)</p><p class="text-sm text-gray-700 mt-1">@(Model.EndToBS ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Start Time</p><p class="text-sm text-gray-700 mt-1">@Model.StartTime.ToString(@"hh\:mm")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">End Time</p><p class="text-sm text-gray-700 mt-1">@Model.EndTime.ToString(@"hh\:mm")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Remarks</p><p class="text-sm text-gray-700 mt-1">@(Model.Remarks ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Status</p><p class="mt-1">@if (Model.Active) { <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span> } else { <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span> }</p></div>
        </div>
        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@Model.ExamScheduleID" class="px-5 py-2.5 bg-amber-500 text-white text-sm font-medium rounded-lg hover:bg-amber-600 transition-colors shadow-sm"><i class="fas fa-edit mr-2"></i>Edit</a> }
            <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">Back to List</a>
        </div>
    </div>
</div>
