@model fwu_examination_management_system.Models.ExamSchedule
@{ ViewData["Title"] = "Delete Exam Schedule"; }
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center"><i class="fas fa-trash text-red-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Delete Exam Schedule</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-red-200 p-6">
        <div class="flex items-start gap-3 p-4 bg-red-50 rounded-lg mb-6"><i class="fas fa-exclamation-triangle text-red-500 mt-0.5"></i><div><p class="text-sm font-semibold text-red-800">Are you sure you want to delete this exam schedule?</p><p class="text-xs text-red-600 mt-1">This action cannot be undone.</p></div></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2"><p class="text-xs text-gray-500 font-medium uppercase">Schedule Name</p><p class="text-sm font-semibold text-gray-800 mt-1">@Model.ExamScheduleName</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Code</p><p class="text-sm text-gray-700 mt-1">@(Model.ExamScheduleCode ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Start Date</p><p class="text-sm text-gray-700 mt-1">@(Model.StartFromAD?.ToString("yyyy-MM-dd") ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">End Date</p><p class="text-sm text-gray-700 mt-1">@(Model.EndToAD?.ToString("yyyy-MM-dd") ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Status</p><p class="mt-1">@if (Model.Active) { <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span> } else { <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span> }</p></div>
        </div>
        <form asp-action="Delete" method="post" class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-200">
            <input type="hidden" asp-for="ExamScheduleID" />
            <button type="submit" class="px-5 py-2.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors shadow-sm"><i class="fas fa-trash mr-2"></i>Delete</button>
            <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">Cancel</a>
        </form>
    </div>
</div>
