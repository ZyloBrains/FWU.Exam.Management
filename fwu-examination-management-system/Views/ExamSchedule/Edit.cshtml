@model fwu_examination_management_system.Models.ExamSchedule
@{ ViewData["Title"] = "Edit Exam Schedule"; }
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center"><i class="fas fa-clock text-orange-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Edit Exam Schedule</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>
            <input type="hidden" asp-for="ExamScheduleID" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedDate" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2"><label asp-for="ExamScheduleName" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="ExamScheduleName" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /><span asp-validation-for="ExamScheduleName" class="text-red-500 text-xs"></span></div>
                <div><label asp-for="ExamScheduleCode" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="ExamScheduleCode" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="AcademicYearID" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="AcademicYearID" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="LevelID" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="LevelID" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="YearPartID" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="YearPartID" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="ExamTypeID" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="ExamTypeID" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="StartFromAD" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="StartFromAD" type="date" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="EndToAD" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="EndToAD" type="date" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="StartFromBS" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="StartFromBS" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="EndToBS" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="EndToBS" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="StartTime" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="StartTime" type="time" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="EndTime" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="EndTime" type="time" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div class="md:col-span-2"><label asp-for="Remarks" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><textarea asp-for="Remarks" rows="2" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea></div>
                <div class="flex items-center gap-2"><input asp-for="Active" type="checkbox" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" /><label asp-for="Active" class="text-sm font-medium text-gray-700"></label></div>
            </div>
            <div class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-200">
                <button type="submit" class="px-5 py-2.5 bg-amber-500 text-white text-sm font-medium rounded-lg hover:bg-amber-600 transition-colors shadow-sm"><i class="fas fa-save mr-2"></i>Save Changes</button>
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
