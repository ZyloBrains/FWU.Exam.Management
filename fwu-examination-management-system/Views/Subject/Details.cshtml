@model fwu_examination_management_system.Models.SubjectDetail
@{ ViewData["Title"] = "Subject Details"; }
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center"><i class="fas fa-book text-teal-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Subject Details</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div><p class="text-xs text-gray-500 font-medium uppercase">Subject Code</p><p class="text-sm font-semibold text-gray-800 mt-1">@Model.SubjectCode</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Subject Name</p><p class="text-sm font-semibold text-gray-800 mt-1">@Model.SubjectName</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Short Name</p><p class="text-sm text-gray-700 mt-1">@(Model.ShortName ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Program ID</p><p class="text-sm text-gray-700 mt-1">@Model.ProgramID</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Year Part ID</p><p class="text-sm text-gray-700 mt-1">@Model.YearPartID</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Subject Type ID</p><p class="text-sm text-gray-700 mt-1">@Model.SubjectTypeId</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Theory Full Mark</p><p class="text-sm text-gray-700 mt-1">@Model.TheoryFullMark</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Theory Pass Mark</p><p class="text-sm text-gray-700 mt-1">@Model.TheoryPassMark</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Practical Full Mark</p><p class="text-sm text-gray-700 mt-1">@(Model.PracticalFullMark?.ToString() ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Practical Pass Mark</p><p class="text-sm text-gray-700 mt-1">@(Model.PracticalPassMark?.ToString() ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Credit Hour</p><p class="text-sm text-gray-700 mt-1">@(Model.CreditHour?.ToString() ?? "—")</p></div>
            <div><p class="text-xs text-gray-500 font-medium uppercase">Display Order</p><p class="text-sm text-gray-700 mt-1">@(Model.DisplayOrder?.ToString() ?? "—")</p></div>
            <div class="md:col-span-2"><p class="text-xs text-gray-500 font-medium uppercase">Remarks</p><p class="text-sm text-gray-700 mt-1">@(Model.Remarks ?? "—")</p></div>
            <div class="md:col-span-2 flex flex-wrap gap-3">
                @if (Model.HasTheory) { <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-700 rounded">Theory</span> }
                @if (Model.HasPractical) { <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 text-purple-700 rounded">Practical</span> }
                @if (Model.HasInternal) { <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 text-indigo-700 rounded">Internal</span> }
                @if (Model.IsCompulsory) { <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-700 rounded">Compulsory</span> }
                @if (Model.IsActive) { <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span> } else { <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span> }
            </div>
        </div>
        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@Model.SubjectDetailID" class="px-5 py-2.5 bg-amber-500 text-white text-sm font-medium rounded-lg hover:bg-amber-600 transition-colors shadow-sm"><i class="fas fa-edit mr-2"></i>Edit</a> }
            <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">Back to List</a>
        </div>
    </div>
</div>
