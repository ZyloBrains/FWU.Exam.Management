@model fwu_examination_management_system.Models.SubjectDetail
@{ ViewData["Title"] = "Edit Subject"; }
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center"><i class="fas fa-book text-teal-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Edit Subject</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>
            <input type="hidden" asp-for="SubjectDetailID" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedDate" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div><label asp-for="SubjectCode" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="SubjectCode" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /><span asp-validation-for="SubjectCode" class="text-red-500 text-xs"></span></div>
                <div><label asp-for="SubjectName" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="SubjectName" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /><span asp-validation-for="SubjectName" class="text-red-500 text-xs"></span></div>
                <div><label asp-for="ShortName" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="ShortName" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="ProgramID" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="ProgramID" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="YearPartID" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="YearPartID" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="SubjectTypeId" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="SubjectTypeId" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="TheoryFullMark" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="TheoryFullMark" type="number" step="0.01" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="TheoryPassMark" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="TheoryPassMark" type="number" step="0.01" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="PracticalFullMark" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="PracticalFullMark" type="number" step="0.01" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="PracticalPassMark" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="PracticalPassMark" type="number" step="0.01" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="CreditHour" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="CreditHour" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div><label asp-for="DisplayOrder" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><input asp-for="DisplayOrder" type="number" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" /></div>
                <div class="md:col-span-2"><label asp-for="Remarks" class="block text-xs font-semibold text-gray-600 uppercase mb-1"></label><textarea asp-for="Remarks" rows="2" class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea></div>
                <div class="flex items-center gap-4 md:col-span-2 flex-wrap">
                    <div class="flex items-center gap-2"><input asp-for="HasTheory" type="checkbox" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" /><label asp-for="HasTheory" class="text-sm font-medium text-gray-700"></label></div>
                    <div class="flex items-center gap-2"><input asp-for="HasPractical" type="checkbox" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" /><label asp-for="HasPractical" class="text-sm font-medium text-gray-700"></label></div>
                    <div class="flex items-center gap-2"><input asp-for="HasInternal" type="checkbox" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" /><label asp-for="HasInternal" class="text-sm font-medium text-gray-700"></label></div>
                    <div class="flex items-center gap-2"><input asp-for="IsCompulsory" type="checkbox" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" /><label asp-for="IsCompulsory" class="text-sm font-medium text-gray-700"></label></div>
                    <div class="flex items-center gap-2"><input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" /><label asp-for="IsActive" class="text-sm font-medium text-gray-700"></label></div>
                </div>
            </div>
            <div class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-200">
                <button type="submit" class="px-5 py-2.5 bg-amber-500 text-white text-sm font-medium rounded-lg hover:bg-amber-600 transition-colors shadow-sm"><i class="fas fa-save mr-2"></i>Save Changes</button>
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
