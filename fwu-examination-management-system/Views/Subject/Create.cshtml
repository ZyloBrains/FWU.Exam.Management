@model fwu_examination_management_system.Models.SubjectDetail
@{
    ViewData["Title"] = "Create Subject";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index"
           class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-book text-teal-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Subject</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <!-- Subject Information -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                    Subject Information
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>
                        <label asp-for="SubjectCode" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="SubjectCode"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter subject code" />
                        <span asp-validation-for="SubjectCode"
                              class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="SubjectName" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="SubjectName"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter subject name" />
                        <span asp-validation-for="SubjectName"
                              class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="ShortName" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="ShortName"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter short name" />
                    </div>

                    <div>
                        <label asp-for="ProgramID" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="ProgramID" type="number"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter program ID" />
                    </div>

                    <div>
                        <label asp-for="YearPartID" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="YearPartID" type="number"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter year part ID" />
                    </div>

                    <div>
                        <label asp-for="SubjectTypeId" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="SubjectTypeId" type="number"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter subject type ID" />
                    </div>

                </div>
            </div>


            <!-- Marks Information -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                    Marks Information
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>
                        <label asp-for="TheoryFullMark" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="TheoryFullMark" type="number" step="0.01"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="e.g. 100" />
                    </div>

                    <div>
                        <label asp-for="TheoryPassMark" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="TheoryPassMark" type="number" step="0.01"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="e.g. 40" />
                    </div>

                    <div>
                        <label asp-for="PracticalFullMark" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="PracticalFullMark" type="number" step="0.01"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="e.g. 50" />
                    </div>

                    <div>
                        <label asp-for="PracticalPassMark" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="PracticalPassMark" type="number" step="0.01"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="e.g. 20" />
                    </div>

                    <div>
                        <label asp-for="CreditHour" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="CreditHour" type="number"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter credit hours" />
                    </div>

                    <div>
                        <label asp-for="DisplayOrder" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="DisplayOrder" type="number"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter display order" />
                    </div>

                </div>
            </div>


            <!-- Remarks -->
            <div>
                <label asp-for="Remarks" class="text-sm font-medium text-gray-700"></label>
                <textarea asp-for="Remarks" rows="3"
                          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                          placeholder="Enter remarks"></textarea>
            </div>


            <!-- Options -->
            <div class="flex items-center gap-6 flex-wrap pt-2">
                <div class="flex items-center gap-3">
                    <input asp-for="HasTheory" type="checkbox" class="text-blue-600" />
                    <label asp-for="HasTheory" class="text-sm font-medium text-gray-700"></label>
                </div>

                <div class="flex items-center gap-3">
                    <input asp-for="HasPractical" type="checkbox" class="text-blue-600" />
                    <label asp-for="HasPractical" class="text-sm font-medium text-gray-700"></label>
                </div>

                <div class="flex items-center gap-3">
                    <input asp-for="HasInternal" type="checkbox" class="text-blue-600" />
                    <label asp-for="HasInternal" class="text-sm font-medium text-gray-700"></label>
                </div>

                <div class="flex items-center gap-3">
                    <input asp-for="IsCompulsory" type="checkbox" class="text-blue-600" />
                    <label asp-for="IsCompulsory" class="text-sm font-medium text-gray-700"></label>
                </div>

                <div class="flex items-center gap-3">
                    <input asp-for="IsActive" type="checkbox" class="text-blue-600" />
                    <label asp-for="IsActive" class="text-sm font-medium text-gray-700"></label>
                </div>
            </div>


            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit"
                        class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>

                <a asp-action="Index"
                   class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}