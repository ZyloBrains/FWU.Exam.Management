@model fwu_examination_management_system.Models.SubjectDetail
@{ ViewData["Title"] = "Create Subject"; }
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center"><i class="fas fa-book text-teal-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Create Subject</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-6"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div><label asp-for="SubjectCode" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="SubjectCode" class="w-full" placeholder="Enter subject code" /><span asp-validation-for="SubjectCode" class="text-red-500 text-xs mt-1 block"></span></div>
                <div><label asp-for="SubjectName" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="SubjectName" class="w-full" placeholder="Enter subject name" /><span asp-validation-for="SubjectName" class="text-red-500 text-xs mt-1 block"></span></div>
                <div><label asp-for="ShortName" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="ShortName" class="w-full" placeholder="Enter short name" /></div>
                <div><label asp-for="ProgramID" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="ProgramID" type="number" class="w-full" placeholder="Enter program ID" /></div>
                <div><label asp-for="YearPartID" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="YearPartID" type="number" class="w-full" placeholder="Enter year part ID" /></div>
                <div><label asp-for="SubjectTypeId" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="SubjectTypeId" type="number" class="w-full" placeholder="Enter subject type ID" /></div>
                <div><label asp-for="TheoryFullMark" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="TheoryFullMark" type="number" step="0.01" class="w-full" placeholder="e.g. 100" /></div>
                <div><label asp-for="TheoryPassMark" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="TheoryPassMark" type="number" step="0.01" class="w-full" placeholder="e.g. 40" /></div>
                <div><label asp-for="PracticalFullMark" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="PracticalFullMark" type="number" step="0.01" class="w-full" placeholder="e.g. 50" /></div>
                <div><label asp-for="PracticalPassMark" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="PracticalPassMark" type="number" step="0.01" class="w-full" placeholder="e.g. 20" /></div>
                <div><label asp-for="CreditHour" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="CreditHour" type="number" class="w-full" placeholder="Enter credit hours" /></div>
                <div><label asp-for="DisplayOrder" class="block text-sm font-semibold text-gray-700 mb-2"></label><input asp-for="DisplayOrder" type="number" class="w-full" placeholder="Enter display order" /></div>
                <div class="md:col-span-2"><label asp-for="Remarks" class="block text-sm font-semibold text-gray-700 mb-2"></label><textarea asp-for="Remarks" rows="3" class="w-full" placeholder="Enter remarks"></textarea></div>
                <div class="flex items-center gap-6 md:col-span-2 flex-wrap pt-2">
                    <div class="flex items-center gap-3"><input asp-for="HasTheory" type="checkbox" class="text-blue-600" /><label asp-for="HasTheory" class="text-sm font-semibold text-gray-700"></label></div>
                    <div class="flex items-center gap-3"><input asp-for="HasPractical" type="checkbox" class="text-blue-600" /><label asp-for="HasPractical" class="text-sm font-semibold text-gray-700"></label></div>
                    <div class="flex items-center gap-3"><input asp-for="HasInternal" type="checkbox" class="text-blue-600" /><label asp-for="HasInternal" class="text-sm font-semibold text-gray-700"></label></div>
                    <div class="flex items-center gap-3"><input asp-for="IsCompulsory" type="checkbox" class="text-blue-600" /><label asp-for="IsCompulsory" class="text-sm font-semibold text-gray-700"></label></div>
                    <div class="flex items-center gap-3"><input asp-for="IsActive" type="checkbox" class="text-blue-600" /><label asp-for="IsActive" class="text-sm font-semibold text-gray-700"></label></div>
                </div>
            </div>
            <div class="flex items-center gap-3 mt-8 pt-6 border-t border-gray-200">
                <button type="submit" class="px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm"><i class="fas fa-save mr-2"></i>Create</button>
                <a asp-action="Index" class="px-6 py-3 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
