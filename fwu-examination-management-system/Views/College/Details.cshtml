@model fwu_examination_management_system.Models.College
@{ ViewData["Title"] = "College Details"; }

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center"><i class="fas fa-school text-amber-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">College Details</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="detail-field"><p class="field-label">Code</p><p class="field-value">@Model.CollegeCode</p></div>
            <div class="detail-field"><p class="field-label">Name</p><p class="field-value">@Model.CollegeName</p></div>
            <div class="detail-field"><p class="field-label">Short Name</p><p class="field-value">@(Model.ShortName ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Email</p><p class="field-value">@(Model.EmailAddress ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Phone</p><p class="field-value">@(Model.Phone1 ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Principal</p><p class="field-value">@(Model.PrincipalName ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Web Address</p><p class="field-value">@(Model.WebAddress ?? "—")</p></div>
            <div class="detail-field"><p class="field-label">Status</p><p class="mt-1">@if (Model.IsActive) { <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Active</span> } else { <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Inactive</span> }</p></div>
        </div>
        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.CollegeID" class="px-6 py-3 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition-colors shadow-sm"><i class="fas fa-edit mr-2"></i>Edit</a>
            }
            <a asp-action="Index" class="px-6 py-3 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-colors">Back to List</a>
        </div>
    </div>
</div>
