@{
    var org = ViewBag.Organization as Organization;
    ViewData["Title"] = org?.Name ?? "Home";
}

@if (org != null)
{
    var userCount = (int)(ViewBag.UserCount ?? 0);

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">@org.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Logo + identity card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column align-items-center text-center py-4">
                    @if (!string.IsNullOrEmpty(org.LogoPath))
                    {
                        <img src="@org.LogoPath" alt="@org.Name logo"
                             class="mb-3 rounded" style="max-height:120px;object-fit:contain;" />
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center mb-3"
                             style="width:100px;height:100px;">
                            <span class="text-secondary fs-1">🏛</span>
                        </div>
                    }
                    <h4 class="fw-bold mb-1">@org.Name</h4>
                    <span class="badge bg-primary mb-2">@org.OfficeCode</span>
                </div>
            </div>
        </div>

        <!-- Details card -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-semibold">Organization Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@org.Address</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@org.ContactNumber</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8"><a href="mailto:@org.Email">@org.Email</a></dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Stats card -->
        <div class="col-md-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column align-items-center justify-content-center py-4">
                    <span class="display-5 fw-bold text-primary">@userCount</span>
                    <span class="text-muted small mt-1">Registered Users</span>
                    <a asp-controller="OrgDashboard" asp-action="Users"
                       asp-route-officeCode="@org.OfficeCode"
                       class="btn btn-sm btn-outline-primary mt-3">
                        Manage Users
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <h1 class="display-4">Welcome</h1>
        <p class="text-muted">Sign in to access your organization's dashboard.</p>
    </div>
}
