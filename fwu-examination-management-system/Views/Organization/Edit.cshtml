@model fwu_examination_management_system.Models.Organization

@{
    ViewData["Title"] = "Edit Organization";
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-edit text-amber-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit Organization</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="Edit" enctype="multipart/form-data" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="LogoPath" />

            <div>
                <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
                <span asp-validation-for="Name" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="OfficeCode" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="OfficeCode" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
                    <span asp-validation-for="OfficeCode" class="text-xs text-red-500 mt-1"></span>
                </div>
                <div>
                    <label asp-for="ContactNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="ContactNumber" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
                    <span asp-validation-for="ContactNumber" class="text-xs text-red-500 mt-1"></span>
                </div>
            </div>

            <div>
                <label asp-for="Address" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Address" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
                <span asp-validation-for="Address" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Email" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Logo</label>
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <div class="mb-3">
                        <img id="logoPreview" src="@Model.LogoPath" alt="Current logo" class="max-h-[120px] rounded-lg border border-gray-200" />
                    </div>
                }
                else
                {
                    <img id="logoPreview" src="#" alt="Logo preview" class="mb-3 hidden max-h-[120px] rounded-lg border border-gray-200" />
                }
                <input type="file" name="logoFile" id="logoFile" accept="image/*"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
                <p class="text-xs text-gray-500 mt-1">Leave empty to keep the current logo.</p>
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200 shadow-sm">
                    <i class="fas fa-save mr-1"></i> Save
                </button>
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors duration-200">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('logoFile').addEventListener('change', function () {
            const preview = document.getElementById('logoPreview');
            if (this.files && this.files[0]) {
                preview.src = URL.createObjectURL(this.files[0]);
                preview.classList.remove('hidden');
            }
        });
    </script>
}
