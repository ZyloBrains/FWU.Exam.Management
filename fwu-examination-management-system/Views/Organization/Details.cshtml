@model fwu_examination_management_system.Models.Organization

@{
    ViewData["Title"] = "Organization Details";
}

<h1>Organization Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OfficeCode)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.OfficeCode)</dd>

