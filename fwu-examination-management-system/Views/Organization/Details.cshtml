@model fwu_examination_management_system.Models.Organization

@{
    ViewData["Title"] = "Organization Details";
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-building text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Organization Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 divide-y divide-gray-100">
        @if (!string.IsNullOrEmpty(Model.LogoPath))
        {
            <div class="p-6 flex justify-center">
                <img src="@Model.LogoPath" alt="@Model.Name logo" class="max-h-[100px] object-contain rounded-lg" />
            </div>
        }
        <div class="p-6 space-y-4">
            <div class="flex flex-col sm:flex-row gap-1">
                <span class="text-sm font-medium text-gray-500 sm:w-36 shrink-0">Name</span>
                <span class="text-sm text-gray-800 font-medium">@Model.Name</span>
            </div>
            <div class="flex flex-col sm:flex-row gap-1">
                <span class="text-sm font-medium text-gray-500 sm:w-36 shrink-0">Office Code</span>
                <span class="inline-block px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-700 rounded w-fit">@Model.OfficeCode</span>
            </div>
            <div class="flex flex-col sm:flex-row gap-1">
                <span class="text-sm font-medium text-gray-500 sm:w-36 shrink-0">Contact Number</span>
                <span class="text-sm text-gray-800">@Model.ContactNumber</span>
            </div>
            <div class="flex flex-col sm:flex-row gap-1">
                <span class="text-sm font-medium text-gray-500 sm:w-36 shrink-0">Address</span>
                <span class="text-sm text-gray-800">@Model.Address</span>
            </div>
            <div class="flex flex-col sm:flex-row gap-1">
                <span class="text-sm font-medium text-gray-500 sm:w-36 shrink-0">Email</span>
                <a href="mailto:@Model.Email" class="text-sm text-blue-600 hover:underline">@Model.Email</a>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200 shadow-sm">
            <i class="fas fa-edit mr-1"></i> Edit
        </a>
        <a asp-action="Index"
           class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors duration-200">
            Back to List
        </a>
    </div>
</div>
