@model fwu_examination_management_system.Models.Organization

@{
    ViewData["Title"] = "Delete Organization";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-trash text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete Organization</h1>
        </div>
    </div>

    <!-- Warning Card -->
    <div class="bg-red-50 border-2 border-red-200 rounded-xl p-4 flex items-start gap-3">
        <i class="fas fa-exclamation-triangle text-red-500 mt-0.5"></i>
        <p class="text-sm font-semibold text-red-700">Are you sure you want to delete this organization? This action cannot be undone.</p>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
            <div class="detail-field"><p class="field-label">Name</p><p class="field-value">@Model.Name</p></div>
            <div class="detail-field"><p class="field-label">Office Code</p><p class="field-value">@Model.OfficeCode</p></div>
            <div class="detail-field"><p class="field-label">Contact</p><p class="field-value">@Model.ContactNumber</p></div>
            <div class="detail-field"><p class="field-label">Address</p><p class="field-value">@Model.Address</p></div>
            <div class="detail-field md:col-span-2"><p class="field-label">Email</p><p class="field-value">@Model.Email</p></div>
        </div>

        <!-- Actions -->
        <form asp-action="Delete" class="flex items-center gap-3 pt-6 border-t border-gray-200">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="px-6 py-3 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                <i class="fas fa-trash mr-1"></i> Delete
            </button>
            <a asp-action="Index" class="px-6 py-3 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                Cancel
            </a>
        </form>
    </div>
</div>
