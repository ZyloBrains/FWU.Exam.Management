@model fwu_examination_management_system.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-user-edit text-amber-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit User</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 form-card">
        <form asp-action="Edit" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>
            <input type="hidden" asp-for="Id" />

            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="Email" class="w-full" />
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="OrganizationId" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <select asp-for="OrganizationId" asp-items="ViewBag.Organizations"
                        class="w-full bg-white">
                    <option value="">-- Select Organization --</option>
                </select>
            </div>

            <div class="flex items-center gap-3 pt-6 border-t border-gray-200">
                <button type="submit" class="px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-save mr-1"></i> Save
                </button>
                <a asp-action="Index" class="px-6 py-3 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
