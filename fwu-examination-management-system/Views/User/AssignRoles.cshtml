@model fwu_examination_management_system.ViewModels.AssignRolesViewModel

@{
    ViewData["Title"] = "Assign Roles";
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-user-shield text-purple-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Assign Roles</h1>
                <p class="text-sm text-gray-500 mt-0.5">@Model.UserEmail</p>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="AssignRoles" class="space-y-5">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserEmail" />

            <div class="space-y-3">
                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                    <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition-colors duration-150">
                        <input type="hidden" name="Roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                        <input type="checkbox" name="Roles[@i].IsAssigned" value="true"
                               id="role_@i"
                               class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                               @(Model.Roles[i].IsAssigned ? "checked" : "") />
                        <input type="hidden" name="Roles[@i].IsAssigned" value="false" />
                        <div class="flex items-center gap-2">
                            <i class="fas fa-shield-alt text-sm text-gray-400"></i>
                            <span class="text-sm font-medium text-gray-700">@Model.Roles[i].RoleName</span>
                        </div>
                    </label>
                }
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200 shadow-sm">
                    <i class="fas fa-save mr-1"></i> Save
                </button>
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors duration-200">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
