@model fwu_examination_management_system.ViewModels.AssignRolesViewModel

@{
    ViewData["Title"] = "Assign Roles";
}

<h1>Assign Roles</h1>
<h5 class="text-muted mb-3">@Model.UserEmail</h5>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AssignRoles">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserEmail" />

            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <div class="form-check mb-2">
                    <input type="hidden" name="Roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                    <input type="checkbox" name="Roles[@i].IsAssigned" value="true"
                           id="role_@i" class="form-check-input"
                           @(Model.Roles[i].IsAssigned ? "checked" : "") />
                    <input type="hidden" name="Roles[@i].IsAssigned" value="false" />
                    <label class="form-check-label" for="role_@i">@Model.Roles[i].RoleName</label>
                </div>
            }

            <div class="mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
