@model IEnumerable<FWU.Exam.Management.Domain.Entities.SmsConfiguration>

@{
    ViewData["Title"] = "SMS Configurations - PDF";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }
        th { background-color: #f2f2f2; font-weight: bold; }
        h1 { font-size: 18px; }
    </style>
</head>
<body>
    <h1>SMS Configurations</h1>
    <p>Page @ViewBag.CurrentPage (Showing @ViewBag.PageSize of @ViewBag.TotalCount records)</p>
    <table>
        <thead>
            <tr>
                <th>API URL</th>
                <th>Mode</th>
                <th>Tags</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ApiUrl</td>
                    <td>@item.Mode</td>
                    <td>@item.Tags</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
