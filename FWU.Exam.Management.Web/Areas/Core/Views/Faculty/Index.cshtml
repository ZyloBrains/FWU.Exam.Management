@model IEnumerable<Faculty>
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Faculties";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "Name";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
    var orgLoginEmail = TempData["OrgLoginEmail"]?.ToString();
    var orgLoginPassword = TempData["OrgLoginPassword"]?.ToString();
    var orgOfficeCode = TempData["OrgOfficeCode"]?.ToString();
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6" x-data="{ openExport: false }">

    @if (!string.IsNullOrWhiteSpace(orgLoginEmail) && !string.IsNullOrWhiteSpace(orgLoginPassword) && !string.IsNullOrWhiteSpace(orgOfficeCode))
    {
        <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-sm text-green-800">
            <div class="font-semibold mb-1">Faculty login created</div>
            <div>Email: <span class="font-medium">@orgLoginEmail</span></div>
            <div>Temporary Password: <span class="font-medium">@orgLoginPassword</span></div>
            <div>Org Page: <a class="underline" asp-area="" asp-controller="FacultyDashboard" asp-action="Index" asp-route-officeCode="@orgOfficeCode">/faculty/@orgOfficeCode</a></div>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="rounded-lg bg-red-50 p-4 border border-red-200 flex items-start shadow-sm">
            <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-sm font-medium text-red-800 whitespace-pre-line">@errorMessage</div>
        </div>
    }

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-building text-blue-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Faculties</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> total records
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <!-- Export dropdown -->
            <div class="relative">
                <button x-on:click="openExport = !openExport"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-download text-xs"></i> Export
                </button>
                <div x-show="openExport"
                     x-on:click.away="openExport = false"
                     x-transition
                     class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                    <a asp-action="ExportToCsv"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-csv text-blue-600"></i> CSV (All)
                    </a>
                    <a asp-action="ExportToPdf"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-pdf text-red-600"></i> PDF (All)
                    </a>
                    <a asp-action="ExportToExcel"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-excel text-green-600"></i> Excel (All)
                    </a>
                </div>
            </div>
            @if (HasPerm("faculties.create"))
            {
                <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    <!-- Search form -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by name, code, email, contact, or address..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Sort controls -->
    <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="text-gray-500">Sort by:</span>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-sort="name" asp-route-sortDir="@(currentSort == "name" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "name" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-600") hover:bg-blue-50">
            Name @(currentSort == "name" ? (currentSortDir == "asc" ? "\u2191" : "\u2193") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-sort="officecode" asp-route-sortDir="@(currentSort == "officecode" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "officecode" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-600") hover:bg-blue-50">
            Office Code @(currentSort == "officecode" ? (currentSortDir == "asc" ? "\u2191" : "\u2193") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-sort="email" asp-route-sortDir="@(currentSort == "email" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "email" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-600") hover:bg-blue-50">
            Email @(currentSort == "email" ? (currentSortDir == "asc" ? "\u2191" : "\u2193") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-sort="contactnumber" asp-route-sortDir="@(currentSort == "contactnumber" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "contactnumber" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-600") hover:bg-blue-50">
            Contact @(currentSort == "contactnumber" ? (currentSortDir == "asc" ? "\u2191" : "\u2193") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-sort="address" asp-route-sortDir="@(currentSort == "address" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "address" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-600") hover:bg-blue-50">
            Address @(currentSort == "address" ? (currentSortDir == "asc" ? "\u2191" : "\u2193") : "")
        </a>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Name</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Office Code</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Contact</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Address</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Email</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{
                    int serial = 1;
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                        <td class="px-4 py-3 text-gray-600">@serial</td>
                        @{ serial++; }
                        <td class="px-4 py-3 font-medium text-gray-800">@item.Name</td>
                        <td class="px-4 py-3">
                            <span class="inline-block px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-700 rounded">@item.OfficeCode</span>
                        </td>
                        <td class="px-4 py-3 text-gray-600">@item.ContactNumber</td>
                        <td class="px-4 py-3 text-gray-600 max-w-[200px] truncate">@item.Address</td>
                        <td class="px-4 py-3 text-gray-600">@item.Email</td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md" title="Details">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                @if (HasPerm("faculties.edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md" title="Edit">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                }
                                @if (HasPerm("faculties.delete"))
                                {
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-building text-4xl mb-3 opacity-50"></i>
                <p>No faculties found.</p>
            </div>
        }
    </div>

    <!-- Mobile cards -->
    <div class="lg:hidden space-y-3">
        @{
            int serialMobile = 1;
        }
        @foreach (var item in Model)
        {
            var currentMobileSerial = serialMobile;
            serialMobile++;
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-building text-blue-600 text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">#@currentMobileSerial</p>
                            <h3 class="font-semibold text-gray-800 text-sm">@item.Name</h3>
                            <p class="text-xs text-gray-500">@item.OfficeCode</p>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                    <div class="text-gray-500">Contact</div>
                    <div class="text-gray-800">@item.ContactNumber</div>
                    <div class="text-gray-500">Email</div>
                    <div class="text-gray-800 truncate">@item.Email</div>
                    <div class="text-gray-500">Address</div>
                    <div class="text-gray-800 truncate">@item.Address</div>
                </div>
                <div class="flex items-center gap-2 pt-4 border-t border-gray-100 mt-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                        Details
                    </a>
                    @if (HasPerm("faculties.edit"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            Edit
                        </a>
                    }
                    @if (HasPerm("faculties.delete"))
                    {
                        <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            Delete
                        </a>
                    }
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-500">
                <i class="fas fa-building text-4xl mb-3 opacity-50"></i>
                <p>No faculties found.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "Faculty")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}
