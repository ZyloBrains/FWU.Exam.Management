@model Faculty
@{
    ViewData["Title"] = "Create Faculty";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-building text-blue-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Create Faculty</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" enctype="multipart/form-data" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <!-- Section: Basic Info -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Name" class="text-xs sm:text-sm font-medium text-gray-700"></label>
                        <input asp-for="Name" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter faculty name" />
                        <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="grid grid-cols-3 gap-5">
                        <div>
                            <label asp-for="OfficeCode" class="text-xs sm:text-sm font-medium text-gray-700"></label>
                            <input asp-for="OfficeCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter office code" />
                            <span asp-validation-for="OfficeCode" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="ShortName" class="text-xs sm:text-sm font-medium text-gray-700"></label>
                            <input asp-for="ShortName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g. MG" />
                            <span asp-validation-for="ShortName" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="ContactNumber" class="text-xs sm:text-sm font-medium text-gray-700"></label>
                            <input asp-for="ContactNumber" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter contact number" />
                            <span asp-validation-for="ContactNumber" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Address & Email side by side -->
                    <div class="grid grid-cols-2 gap-5">
                        <div>
                            <label asp-for="Address" class="text-xs sm:text-sm font-medium text-gray-700"></label>
                            <input asp-for="Address" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter address" />
                            <span asp-validation-for="Address" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Email" class="text-xs sm:text-sm font-medium text-gray-700"></label>
                            <input asp-for="Email" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter email" />
                            <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="TenantId" class="text-xs sm:text-sm font-medium text-gray-700"></label>
                        <select asp-for="TenantId" asp-items="ViewBag.TenantList" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- No Tenant --</option>
                        </select>
                        <span asp-validation-for="TenantId" class="text-xs text-red-500 mt-1 block"></span>
                        <p class="text-xs text-gray-500 mt-1">Optional. Leave unassigned to keep this faculty available for linking to a tenant later.</p>
                    </div>
                </div>
            </div>

            <!-- Section: Admin Login -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Admin Login</h2>
                <div class="space-y-4">
                    <div>
                        <label class="text-xs sm:text-sm font-medium text-gray-700">Admin Password</label>
                        <div class="flex gap-2">
                            <input type="text" name="adminPassword" id="adminPassword"
                                   class="flex-1 border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono"
                                   placeholder="Leave empty to auto-generate" />
                            <button type="button" onclick="generatePassword()"
                                    class="px-4 py-2 bg-gray-100 text-gray-700 text-xs sm:text-sm font-medium rounded-lg hover:bg-gray-200 transition border border-gray-300">
                                <i class="fas fa-key mr-1"></i> Generate
                            </button>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">The email above will be used as the admin login. Leave password empty to auto-generate a secure temporary password.</p>
                    </div>
                </div>
            </div>

            <!-- Section: Logo -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Faculty Logo</h2>
                <div>
                    <input type="file" name="logoFile" id="logoFile" accept="image/*"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm file:mr-3 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                    <img id="logoPreview" src="#" alt="Logo preview" class="mt-2 hidden max-h-[120px] rounded-lg border border-gray-300 shadow-sm" />
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('logoFile').addEventListener('change', function () {
            const preview = document.getElementById('logoPreview');
            if (this.files && this.files[0]) {
                preview.src = URL.createObjectURL(this.files[0]);
                preview.classList.remove('hidden');
            } else {
                preview.src = '#';
                preview.classList.add('hidden');
            }
        });

        function generatePassword() {
            const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let result = '';
            for (let i = 0; i < 8; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('adminPassword').value = result + '@@' + '1';
        }
    </script>
}
