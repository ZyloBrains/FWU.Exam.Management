@model TestGumpNowEmailViewModel

@{
    ViewData["Title"] = "Send Test GumpNow Email";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-envelope-open-text text-purple-600"></i>
            </div>
            @await Html.PartialAsync("_AlertMessages")
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Send Test GumpNow Email</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Index" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 gap-5">
                <div>
                    <label asp-for="ToEmail" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="ToEmail" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="recipient@example.com" />
                    <span asp-validation-for="ToEmail" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Subject" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="Subject" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" />
                    <span asp-validation-for="Subject" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <!-- Send Mode Toggle -->
                <div>
                    <label class="text-xs sm:text-sm font-medium text-gray-700 block mb-2">Send Mode</label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" asp-for="SendMode" value="html" class="w-4 h-4 text-purple-600 focus:ring-purple-500" onchange="toggleMode()" />
                            <span class="text-sm text-gray-700">HTML Body (No Template Needed)</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" asp-for="SendMode" value="template" class="w-4 h-4 text-purple-600 focus:ring-purple-500" onchange="toggleMode()" />
                            <span class="text-sm text-gray-700">GumpNow Template</span>
                        </label>
                    </div>
                </div>

                <!-- HTML Body Section -->
                <div id="htmlSection">
                    <label asp-for="HtmlBody" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                    <textarea asp-for="HtmlBody" rows="18" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 font-mono text-xs"></textarea>
                    <p class="text-xs text-gray-400 mt-1">Pre-filled with a professional test email template</p>
                </div>

                <!-- Template Section -->
                <div id="templateSection" style="display:none;">
                    <div>
                        <label asp-for="TemplateId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="TemplateId" type="text" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="welcome_email" />
                        <span asp-validation-for="TemplateId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="mt-4">
                        <label asp-for="ContextVariables" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <textarea asp-for="ContextVariables" rows="6" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 font-mono" placeholder="name=John Doe&#10;college=XYZ College&#10;program=BSc CS"></textarea>
                        <span asp-validation-for="ContextVariables" class="text-xs text-red-500 mt-1 block"></span>
                        <p class="text-xs text-gray-400 mt-1">Enter key=value pairs, one per line</p>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-purple-600 text-white text-sm font-semibold rounded-lg hover:bg-purple-700 transition shadow-md">
                    <i class="fas fa-paper-plane mr-1"></i> Send
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function toggleMode() {
            var mode = document.querySelector('input[name="SendMode"]:checked').value;
            document.getElementById('htmlSection').style.display = mode === 'html' ? 'block' : 'none';
            document.getElementById('templateSection').style.display = mode === 'template' ? 'block' : 'none';
        }
    </script>
}
