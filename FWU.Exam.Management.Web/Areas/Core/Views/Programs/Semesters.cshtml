@model FWU.Exam.Management.Web.ViewModels.ProgramSemestersViewModel

@{
    ViewData["Title"] = "Program Semester Assignments";
    var assignedSet = new HashSet<int>(Model.AssignedSemesterIds);
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-check text-cyan-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Program Semester Assignments</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">@Model.ProgramCode - @Model.ProgramName</p>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-6 sm:p-8">
        <form asp-action="Semesters" asp-route-id="@Model.ProgramId" method="post" class="space-y-6">
            <input type="hidden" asp-for="ProgramId" />

            @if (Model.Groups.Count == 0)
            {
                <div class="text-center py-12 text-gray-500">
                    <i class="fas fa-calendar-alt text-4xl mb-3 opacity-50"></i>
                    <p>No semesters available. Create semesters first.</p>
                </div>
            }
            else
            {
                foreach (var group in Model.Groups)
                {
                    <div>
                        <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                            Academic Year: @group.Title
                            <span class="text-xs font-normal text-gray-400">(@group.Semesters.Count selected)</span>
                        </h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                            @foreach (var item in group.Semesters)
                            {
                                var isChecked = assignedSet.Contains(item.SemesterId);
                                <label class="flex items-start gap-3 border @(isChecked ? "border-cyan-400 bg-cyan-50" : "border-gray-200") rounded-lg px-4 py-3 cursor-pointer hover:border-cyan-300 transition-colors">
                                    <input type="checkbox" name="semesterIds" value="@item.SemesterId" @(isChecked ? "checked" : "")
                                           class="mt-0.5 h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" />
                                    <div class="min-w-0">
                                        <div class="text-sm font-medium text-gray-800">@item.Display</div>
                                        @if (!string.IsNullOrEmpty(item.FacultyName))
                                        {
                                            <div class="text-xs text-gray-400">@item.FacultyName</div>
                                        }
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }
            }

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
                <a asp-action="Index" class="px-6 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition shadow-sm">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2.5 bg-cyan-600 text-white text-sm font-semibold rounded-lg hover:bg-cyan-700 transition shadow-md">
                    <i class="fas fa-save text-xs mr-1"></i> Save Assignments
                </button>
            </div>
        </form>
    </div>
</div>
