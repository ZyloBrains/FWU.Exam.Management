@model IEnumerable<AcademicYear>
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Academic Years";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentSearch = ViewBag.Search as string ?? "";

    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6" x-data="{ search: '@currentSearch', openExport: false, get filtered() { return this.search.toLowerCase(); } }">
    @await Html.PartialAsync("_AlertMessages")
    <!-- Header and action buttons -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-pink-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar text-pink-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Academic Years</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> total records
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            @await Html.PartialAsync("_ExportDropdown", new ExportDropdownModel
            {
                RouteValues = new Dictionary<string, string>
                {
                    ["search"] = currentSearch
                },
                ButtonClass = "bg-green-600 hover:bg-green-700",
                ScopeLabel = ""
            })
            @if (HasPerm("academicyears.create"))
            {
                <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    <!-- Search form (includes page size selector) -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by name, code, remark..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs sm:text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    @* <!-- Live search input (client-side) -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="text" x-model="search"
                   placeholder="Live search on current page..."
                   class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
    </div> *@

    <!-- Desktop table (visible on md and up) -->
    <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Code</th>
                    @* <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Code (Nepali)</th> *@
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Name</th>
                    @* <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Name (Nepali)</th> *@
                    @* <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Remark</th> *@
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Start</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">End</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Running</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{
                    int serial = 0;
                }
                @foreach (var item in Model)
                {
                    serial++;
                    var showCondition = "search === '' || " +
                        $"'{item.AcademicYearName?.ToLower()}'.includes(filtered) || " +
                        $"'{item.AcademicYearNameNepali?.ToLower()}'.includes(filtered) || " +
                        $"'{item.AcademicYearCode}'.includes(filtered) || " +
                        $"'{item.AcademicYearCodeNepali?.ToLower()}'.includes(filtered) || " +
                        $"'{item.Remark?.ToLower()}'.includes(filtered)";
                    <tr class="hover:bg-gray-50" x-show="@showCondition" x-transition>
                        <td class="px-6 py-4 text-gray-600">@serial</td>
                        <td class="px-6 py-4 font-medium text-gray-800">@item.AcademicYearCode</td>
                        @* <td class="px-6 py-4 text-gray-600">@item.AcademicYearCodeNepali</td> *@
                        <td class="px-6 py-4 text-gray-800">@item.AcademicYearName</td>
                        @* <td class="px-6 py-4 text-gray-600">@item.AcademicYearNameNepali</td> *@
                        @* <td class="px-6 py-4 text-gray-500 max-w-xs truncate">@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</td> *@
                        <td class="px-6 py-4 text-gray-600">@(item.StartDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="px-6 py-4 text-gray-600">@(item.EndDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="px-6 py-4">
                            @if (item.IsRunning)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-700 rounded">Running</span>
                            }
                            else
                            {
                                <span class="text-xs text-gray-400">No</span>
                            }
                        </td>
                        <td class="px-6 py-4">
                            @if (item.IsActive)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                @if (HasPerm("academicyears.edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md" title="Edit">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                }
                                @if (HasPerm("academicyears.delete"))
                                {
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile card layout (visible below md) -->
    <div class="md:hidden space-y-3">
        @{
            int serialMobile = 0;
        }
        @foreach (var item in Model)
        {
            serialMobile++;
            var showCondition = "search === '' || " +
                $"'{item.AcademicYearName?.ToLower()}'.includes(filtered) || " +
                $"'{item.AcademicYearNameNepali?.ToLower()}'.includes(filtered) || " +
                $"'{item.AcademicYearCode}'.includes(filtered) || " +
                $"'{item.AcademicYearCodeNepali?.ToLower()}'.includes(filtered) || " +
                $"'{item.Remark?.ToLower()}'.includes(filtered)";
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4" x-show="@showCondition" x-transition>
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-pink-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-calendar text-pink-600 text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">#@serialMobile</p>
                            <h3 class="font-semibold text-gray-800 text-sm">@item.AcademicYearName</h3>
                            <p class="text-xs text-gray-500">Code: @item.AcademicYearCode</p>
                        </div>
                    </div>
                    <div>
                        @if (item.IsActive)
                        {
                            <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span>
                        }
                        else
                        {
                            <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                    <div class="text-gray-500">Code (Nepali)</div>
                    <div class="text-gray-800">@item.AcademicYearCodeNepali</div>
                    <div class="text-gray-500">Name (Nepali)</div>
                    <div class="text-gray-800">@item.AcademicYearNameNepali</div>
                    <div class="text-gray-500">Start Date</div>
                    <div class="text-gray-800">@(item.StartDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                    <div class="text-gray-500">End Date</div>
                    <div class="text-gray-800">@(item.EndDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                    <div class="text-gray-500">Remark</div>
                    <div class="text-gray-800 truncate">@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</div>
                    <div class="text-gray-500">Running</div>
                    <div class="text-gray-800">@(item.IsRunning ? "Yes" : "No")</div>
                </div>

                <div class="flex items-center gap-2 pt-4 border-t border-gray-100 mt-2">
                    @if (HasPerm("academicyears.edit"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            Edit
                        </a>
                    }
                    @if (HasPerm("academicyears.delete"))
                    {
                        <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            Delete
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "AcademicYears")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}