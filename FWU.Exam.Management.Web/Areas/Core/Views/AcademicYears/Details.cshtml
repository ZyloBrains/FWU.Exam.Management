
@model AcademicYear

@{
    ViewData["Title"] = "Academic Year Details";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-pink-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar text-pink-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Academic Year Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <!-- Basic Information Section -->
        <div class="mb-6">
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Academic Year Code</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Model.AcademicYearCode</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Academic Year Code (Nepali)</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Model.AcademicYearCodeNepali</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Academic Year Name</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Model.AcademicYearName</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Academic Year Name (Nepali)</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Model.AcademicYearNameNepali</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Remark</p>
                    <p class="mt-1 text-gray-800">@(string.IsNullOrEmpty(Model.Remark) ? "—" : Model.Remark)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Status</p>
                    <div class="mt-1 flex gap-3">
                        @if (Model.IsRunning)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-blue-100 text-blue-700 rounded-full">Running</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-500 rounded-full">Not Running</span>
                        }
                        @if (Model.IsActive)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Active</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Audit Information Section -->
        @* <div class="mt-6 pt-4 border-t border-gray-200">
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Audit Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Created By</p>
                    <p class="mt-1 text-gray-800">@(string.IsNullOrEmpty(Model.CreatedBy) ? "—" : Model.CreatedBy)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Created Date</p>
                    <p class="mt-1 text-gray-800">@(Model.CreatedDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Modified By</p>
                    <p class="mt-1 text-gray-800">@(string.IsNullOrEmpty(Model.ModifiedBy) ? "—" : Model.ModifiedBy)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Modified Date</p>
                    <p class="mt-1 text-gray-800">@(Model.ModifiedDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</p>
                </div>
            </div>
        </div> *@

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-8 border-t border-gray-200">
            <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <a asp-action="Index"
                   class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>