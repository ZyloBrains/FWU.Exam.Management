@model TestEmailViewModel

@{
    ViewData["Title"] = "Send Test Email";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-envelope text-emerald-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Send Test Email</h1>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">@error</div>
    }

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Index" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 gap-5">
                <div>
                    <label asp-for="ToEmail" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="ToEmail" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="recipient@example.com" />
                    <span asp-validation-for="ToEmail" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Subject" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="Subject" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="Email subject" />
                    <span asp-validation-for="Subject" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Body" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <textarea asp-for="Body" rows="10" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono" placeholder="HTML body content"></textarea>
                    <span asp-validation-for="Body" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition shadow-md">
                    <i class="fas fa-paper-plane mr-1"></i> Send
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
