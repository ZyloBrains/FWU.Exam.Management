@model FWU.Exam.Management.Domain.Entities.Level
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);

    ViewData["Title"] = "Level Details";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Level Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <p class="text-sm font-medium text-gray-600">Level Code</p>
                <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.LevelCode)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Display Order</p>
                <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.LevelDisplayOrder)</p>
            </div>
            <div class="md:col-span-2">
                <p class="text-sm font-medium text-gray-600">Level Name</p>
                <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.LevelName)</p>
            </div>
            <div class="md:col-span-2">
                <p class="text-sm font-medium text-gray-600">Level Name (Nepali)</p>
                <p class="mt-1 text-gray-800">@(Model.LevelNameNepali ?? "-")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Currently Running</p>
                <div class="mt-1">
                    @if (Model.IsRunning==true)
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-blue-100 text-blue-700 rounded-full">? Running</span>
                    }
                    else
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-500 rounded-full">Not Running</span>
                    }
                </div>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Status</p>
                <div class="mt-1">
                    @if (Model.IsActive)
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">? Active</span>
                    }
                    else
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">? Inactive</span>
                    }
                </div>
            </div>
            <div class="md:col-span-2">
                <p class="text-sm font-medium text-gray-600">Remarks</p>
                <p class="mt-1 text-gray-800">@(Model.Remarks ?? "-")</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (HasPerm("levels.edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
