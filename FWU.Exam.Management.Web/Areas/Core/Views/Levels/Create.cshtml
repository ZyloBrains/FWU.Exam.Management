@model FWU.Exam.Management.Domain.Entities.Level

@{
    ViewData["Title"] = "Create Level";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-cyan-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Level</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="LevelCode" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="LevelCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" placeholder="e.g., BACHELOR, MASTER, PHD" />
                    <span asp-validation-for="LevelCode" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LevelDisplayOrder" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="LevelDisplayOrder" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" placeholder="e.g., 1, 2, 3" />
                    <span asp-validation-for="LevelDisplayOrder" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label for="LevelName" class="text-sm font-medium text-gray-700 block mb-1">LevelName <span class="text-red-500">*</span></label>
                    <input asp-for="LevelName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" placeholder="Enter level name" />
                    <span asp-validation-for="LevelName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Remarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <textarea asp-for="Remarks" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" placeholder="Enter remarks (optional)"></textarea>
                    <span asp-validation-for="Remarks" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsRunning" type="checkbox" class="w-4 h-4 text-cyan-600 rounded focus:ring-cyan-500" />
                        <label asp-for="IsRunning" class="text-sm font-medium text-gray-700">Currently Running</label>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Check if this level is currently active for admissions</p>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-cyan-600 rounded focus:ring-cyan-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-cyan-600 text-white text-sm font-semibold rounded-lg hover:bg-cyan-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
