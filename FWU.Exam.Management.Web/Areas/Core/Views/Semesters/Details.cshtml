@model FWU.Exam.Management.Domain.Entities.Semesters.Semester
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Semester Details";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Core" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Semester Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <p class="text-sm font-medium text-gray-600">Code</p>
                <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.Code)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Name</p>
                <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Name)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Number</p>
                <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Number)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Year</p>
                <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Year)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Start Date</p>
                <p class="mt-1 text-gray-800">@Model.StartDate.ToString("yyyy-MM-dd")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">End Date</p>
                <p class="mt-1 text-gray-800">@Model.EndDate.ToString("yyyy-MM-dd")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Academic Year</p>
                <p class="mt-1 text-gray-800">@(Model.AcademicYear?.AcademicYearName ?? "-")</p>
            </div>
            <div class="md:col-span-2">
                <p class="text-sm font-medium text-gray-600">Remark</p>
                <p class="mt-1 text-gray-800">@(Model.Remark ?? "-")</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (HasPerm("semesters.edit"))
            {
                <a asp-action="Edit" asp-area="Core" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" asp-area="Core" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
