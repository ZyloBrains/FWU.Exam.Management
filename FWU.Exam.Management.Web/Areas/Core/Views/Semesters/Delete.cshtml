@model FWU.Exam.Management.Domain.Entities.Semesters.Semester

@{
    ViewData["Title"] = "Delete Semester";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Core" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-red-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Delete Semester</h1>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <!-- Warning Alert -->
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this semester? This action cannot be undone.
                </p>
            </div>
        </div>

        <!-- Details Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 mb-8">
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Code</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Code)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Name</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Name)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Number</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Number)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Year</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Year)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Start Date</p>
                <p class="text-gray-800 font-medium">@Model.StartDate.ToString("yyyy-MM-dd")</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">End Date</p>
                <p class="text-gray-800 font-medium">@Model.EndDate.ToString("yyyy-MM-dd")</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Academic Year</p>
                <p class="text-gray-800 font-medium">@(Model.AcademicYear?.AcademicYearName ?? "-")</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Faculty</p>
                <p class="text-gray-800 font-medium">@(Model.Faculty?.Name ?? "-")</p>
            </div>
            <div class="md:col-span-2">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Remark</p>
                <p class="text-gray-800 font-medium">@(Model.Remark ?? "-")</p>
            </div>
        </div>

        <!-- Warning Note -->
        <div class="bg-yellow-50 border-l-4 border-yellow-500 rounded-lg p-4 mb-6">
            <div class="flex items-start">
                <i class="fas fa-info-circle text-yellow-500 mr-3 text-lg mt-0.5"></i>
                <div>
                    <p class="text-sm font-semibold text-yellow-800">Important Note:</p>
                    <p class="text-xs text-yellow-700 mt-1">
                        Deleting this semester may affect any exam schedules, subject offerings, and enrollments associated with this semester.
                    </p>
                </div>
            </div>
        </div>

        <!-- Delete Form -->
        <form asp-action="Delete" asp-area="Core" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this semester? This action cannot be undone.');"
                        class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" asp-area="Core" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
