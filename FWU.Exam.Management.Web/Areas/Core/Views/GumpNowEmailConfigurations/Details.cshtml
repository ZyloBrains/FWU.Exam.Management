@model FWU.Exam.Management.Domain.Entities.GumpNowEmailConfiguration
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "GumpNow Email Configuration Details";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-envelope-open-text text-blue-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">GumpNow Email Configuration Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="mb-6">
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Configuration Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">API URL</p>
                    <p class="mt-1 text-gray-800 font-semibold break-all">@Html.DisplayFor(model => model.ApiUrl)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">API Key</p>
                    <p class="mt-1 text-gray-800">●●●●●●●●●●●●●●●●</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">From Address</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.FromAddr)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Mode</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Mode)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Override Unsubscription</p>
                    <div class="mt-1">
                        @if (Model.OverrideUnsubscription)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">✓ Enabled</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">✗ Disabled</span>
                        }
                    </div>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Status</p>
                    <div class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">✓ Active</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">✗ Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-6 pt-2">
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">API Information</h2>
            <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-xs text-gray-500 mb-2">GumpNow API Endpoint:</p>
                <code class="text-xs sm:text-sm text-gray-800 break-all">@Model.ApiUrl</code>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (HasPerm("gumpnowemail.edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
