@model FWU.Exam.Management.Domain.Entities.Payments.ESewaConfiguration

@{
    ViewData["Title"] = "Edit eSewa Configuration";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-credit-card text-blue-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Edit eSewa Configuration</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">eSewa Payment Gateway Settings</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ProductCode" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ProductCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="PAYMENT_PRODUCT_CODE" />
                        <span asp-validation-for="ProductCode" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ServiceChargeAmount" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ServiceChargeAmount" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="0.00" />
                        <span asp-validation-for="ServiceChargeAmount" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="PostUrl" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="PostUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="https://pay.esewa.com.np/api/epay/main/v2/form" />
                        <span asp-validation-for="PostUrl" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SuccessUrl" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="SuccessUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="https://example.com/success" />
                        <span asp-validation-for="SuccessUrl" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="VerifyUrl" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="VerifyUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="https://pay.esewa.com.np/api/epay/transaction/status/" />
                        <span asp-validation-for="VerifyUrl" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="SecretKey" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="SecretKey" type="password" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Secret key" />
                        <span asp-validation-for="SecretKey" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
