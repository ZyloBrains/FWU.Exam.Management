@model Tenant
@{
    ViewData["Title"] = "Tenant Details";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-9 h-9 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600 text-sm"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-building text-blue-600 text-sm"></i>
            </div>
            <h1 class="text-xl font-bold text-gray-800">Tenant Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        @if (!string.IsNullOrEmpty(Model.LogoPath))
        {
            <div class="pb-5 mb-5 border-b border-gray-200 flex justify-center">
                <img src="@Model.LogoPath" alt="@Model.Name logo"
                     class="w-32 h-32 object-cover rounded-full border border-gray-300 shadow-sm" />
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="p-3 border border-gray-200 rounded-lg shadow-sm bg-gray-50">
                <p class="text-xs font-semibold text-gray-500 uppercase">Name</p>
                <p class="text-base font-medium text-gray-800">@Model.Name</p>
            </div>
            <div class="p-3 border border-gray-200 rounded-lg shadow-sm bg-gray-50">
                <p class="text-xs font-semibold text-gray-500 uppercase">Office Code</p>
                <p class="text-base font-medium text-gray-800">@Model.OfficeCode</p>
            </div>
            <div class="p-3 border border-gray-200 rounded-lg shadow-sm bg-gray-50">
                <p class="text-xs font-semibold text-gray-500 uppercase">Contact Number</p>
                <p class="text-base font-medium text-gray-800">@Model.ContactNumber</p>
            </div>
            <div class="p-3 border border-gray-200 rounded-lg shadow-sm bg-gray-50">
                <p class="text-xs font-semibold text-gray-500 uppercase">Address</p>
                <p class="text-base font-medium text-gray-800">@Model.Address</p>
            </div>
            <div class="p-3 border border-gray-200 rounded-lg shadow-sm bg-gray-50 md:col-span-2">
                <p class="text-xs font-semibold text-gray-500 uppercase">Email</p>
                <p class="text-base font-medium text-blue-600">
                    <a href="mailto:@Model.Email" class="hover:underline">@Model.Email</a>
                </p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 mt-6 pt-4 border-t border-gray-200">
            <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-sm">
                <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <a asp-action="Index"
                   class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-sm">
                Back to List
            </a>
        </div>
    </div>
</div>
