@model IEnumerable<FWU.Exam.Management.Domain.Entities.SmtpConfiguration>
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "SMTP Configurations";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "Host";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6" x-data="{ openExport: false }">
    @await Html.PartialAsync("_AlertMessages")
    <!-- Header and action buttons -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-envelope text-green-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">SMTP Configurations</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> total records
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            @await Html.PartialAsync("_ExportDropdown", new ExportDropdownModel
            {
                RouteValues = new Dictionary<string, string>
                {
                    ["search"] = currentSearch,
                    ["page"] = currentPage.ToString(),
                    ["pageSize"] = pageSize.ToString(),
                    ["sort"] = currentSort,
                    ["sortDir"] = currentSortDir
                },
                ButtonClass = "bg-green-600 hover:bg-green-700",
                ScopeLabel = " (Current Page)"
            })
            @if (HasPerm("smtp.create"))
            {
                <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    <!-- Search form -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by host, from email, username..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" />
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-green-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-green-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs sm:text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Sorting Controls -->
    <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="text-gray-500">Sort by:</span>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="host" asp-route-sortDir="@(currentSort == "host" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "host" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600") hover:bg-green-50">
            Host @(currentSort == "host" ? (currentSortDir == "asc" ? "?" : "?") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="from" asp-route-sortDir="@(currentSort == "from" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "from" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600") hover:bg-green-50">
            From Email @(currentSort == "from" ? (currentSortDir == "asc" ? "?" : "?") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="port" asp-route-sortDir="@(currentSort == "port" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "port" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600") hover:bg-green-50">
            Port @(currentSort == "port" ? (currentSortDir == "asc" ? "?" : "?") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="username" asp-route-sortDir="@(currentSort == "username" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "username" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600") hover:bg-green-50">
            Username @(currentSort == "username" ? (currentSortDir == "asc" ? "?" : "?") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="enablessl" asp-route-sortDir="@(currentSort == "enablessl" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "enablessl" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600") hover:bg-green-50">
            SSL @(currentSort == "enablessl" ? (currentSortDir == "asc" ? "?" : "?") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="isactive" asp-route-sortDir="@(currentSort == "isactive" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "isactive" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600") hover:bg-green-50">
            Active @(currentSort == "isactive" ? (currentSortDir == "asc" ? "?" : "?") : "")
        </a>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Host</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">From Email</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Port</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Username</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">SSL</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Active</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{
                    int serial = (ViewBag.CurrentPage - 1) * ViewBag.PageSize;
                }
                @foreach (var item in Model)
                {
                    serial++;
                    <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                        <td class="px-4 py-3 text-gray-600">@serial</td>
                        <td class="px-4 py-3 font-medium text-gray-800">@item.Host</td>
                        <td class="px-4 py-3 text-gray-600">@item.From</td>
                        <td class="px-4 py-3 text-gray-600">@item.Port</td>
                        <td class="px-4 py-3 text-gray-600">@item.UserName</td>
                        <td class="px-4 py-3">
                            @if (item.EnableSsl)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Enabled</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">Disabled</span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            @if (item.IsActive)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">Inactive</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md" title="Details">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                @if (HasPerm("smtp.edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md" title="Edit">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                }
                                @if (HasPerm("smtp.delete"))
                                {
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-envelope text-4xl mb-3 opacity-50"></i>
                <p>No SMTP configurations found.</p>
            </div>
        }
    </div>

    <!-- Mobile card layout -->
    <div class="lg:hidden space-y-3">
        @{
            int serialMobile = (ViewBag.CurrentPage - 1) * ViewBag.PageSize;
        }
        @foreach (var item in Model)
        {
            serialMobile++;
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-envelope text-green-600 text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">#@serialMobile</p>
                            <h3 class="font-semibold text-gray-800 text-sm">@item.Host</h3>
                            <p class="text-xs text-gray-500">Port: @item.Port</p>
                        </div>
                    </div>
                    <div>
                        @if (item.EnableSsl)
                        {
                            <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">SSL</span>
                        }
                        else
                        {
                            <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">No SSL</span>
                        }
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                    <div class="text-gray-500">From Email</div>
                    <div class="text-gray-800">@item.From</div>
                    <div class="text-gray-500">Username</div>
                    <div class="text-gray-800">@item.UserName</div>
                    <div class="text-gray-500">Password</div>
                    <div class="text-gray-800">********</div>
                    <div class="text-gray-500">Active</div>
                    <div class="text-gray-800">@(item.IsActive ? "Yes" : "No")</div>
                </div>
                <div class="flex items-center gap-2 pt-4 border-t border-gray-100 mt-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                        Details
                    </a>
                    @if (HasPerm("smtp.edit"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            Edit
                        </a>
                    }
                    @if (HasPerm("smtp.delete"))
                    {
                        <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            Delete
                        </a>
                    }
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-500">
                <i class="fas fa-envelope text-4xl mb-3 opacity-50"></i>
                <p>No SMTP configurations found.</p>
            </div>
        }
    </div>

    <!-- Pagination + Page Size Selector -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Previous
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Previous</span>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Next
                    </a>
                }
                else
                {
                    <span class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Next</span>
                }
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-xs sm:text-sm text-gray-700">
                        Showing <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>
                        to <span class="font-medium">@(Math.Min(currentPage * pageSize, totalCount))</span>
                        of <span class="font-medium">@totalCount</span> results
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <label class="text-xs sm:text-sm text-gray-700">Rows:</label>
                        <select class="select2 border border-gray-300 rounded-md px-2 py-1 text-sm focus:ring-green-500 focus:border-green-500"
                                onchange="window.location.href='@Url.Action("Index", new { search = currentSearch, sort = currentSort, sortDir = currentSortDir, pageSize = "__val__" })'.replace('__val__', this.value)">
                            <option value="10" selected="@(pageSize == 10)">10</option>
                            <option value="25" selected="@(pageSize == 25)">25</option>
                            <option value="50" selected="@(pageSize == 50)">50</option>
                            <option value="100" selected="@(pageSize == 100)">100</option>
                        </select>
                    </div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                               class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == 1 ? "pointer-events-none opacity-50" : "")">
                            <i class="fas fa-chevron-left text-xs"></i>
                        </a>
                        @{
                            var startPage = Math.Max(1, currentPage - 2);
                            var endPage = Math.Min(totalPages, currentPage + 2);
                            if (startPage > 1)
                            {
                                <a asp-action="Index" asp-route-page="1" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                                if (startPage > 2)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                                }
                            }
                            for (int i = startPage; i <= endPage; i++)
                            {
                                <a asp-action="Index" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold @(i == currentPage ? "bg-green-600 text-white" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50")">@i</a>
                            }
                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                                }
                                <a asp-action="Index" asp-route-page="@totalPages" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">@totalPages</a>
                            }
                        }
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                               class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == totalPages ? "pointer-events-none opacity-50" : "")">
                            <i class="fas fa-chevron-right text-xs"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 34px; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; padding: 0.125rem 0; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding-left: 0.5rem; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 32px; }
    </style>
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "SmtpConfigurations")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
    <script>
        $(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: 'resolve' }); });
    </script>
}