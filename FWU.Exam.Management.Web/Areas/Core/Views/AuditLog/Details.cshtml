@model FWU.Exam.Management.Domain.Entities.AuditLog

@{
    ViewData["Title"] = "Audit Log Details";

    List<Dictionary<string, object>>? changes = null;
    if (!string.IsNullOrEmpty(Model.ChangesJson))
    {
        changes = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, object>>>(Model.ChangesJson);
    }
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-history text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Audit Log Details</h1>
                <p class="text-sm text-gray-500 mt-0.5">Change record for @Model.EntityName #@Model.EntityId</p>
            </div>
        </div>
        <a asp-action="Index" asp-area="Core" class="px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
            <i class="fas fa-arrow-left mr-1"></i> Back to List
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div>
                <label class="block text-sm font-medium text-gray-500 mb-1">Timestamp</label>
                <p class="text-sm text-gray-800 font-medium">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-500 mb-1">Entity</label>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                    @Model.EntityName
                </span>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-500 mb-1">Entity ID</label>
                <p class="text-sm text-gray-800 font-mono font-medium">@Model.EntityId</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-500 mb-1">Action</label>
                @switch (Model.Action)
                {
                    case "Created":
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                            <i class="fas fa-plus-circle mr-1"></i> Created
                        </span>
                        break;
                    case "Updated":
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                            <i class="fas fa-edit mr-1"></i> Updated
                        </span>
                        break;
                    case "Deleted":
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                            <i class="fas fa-trash mr-1"></i> Deleted
                        </span>
                        break;
                    default:
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
                            @Model.Action
                        </span>
                        break;
                }
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-500 mb-1">User</label>
                <p class="text-sm text-gray-800 font-medium">@Model.UserName</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-500 mb-1">User ID</label>
                <p class="text-sm text-gray-800 font-mono">@Model.UserId</p>
            </div>
        </div>
    </div>

    @if (changes != null && changes.Count > 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">
                    <i class="fas fa-exchange-alt mr-2 text-indigo-500"></i>
                    Field Changes (@changes.Count)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Field</th>
                            <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Old Value</th>
                            <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">New Value</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var change in changes)
                        {
                            var field = change.ContainsKey("field") ? change["field"]?.ToString() : "";
                            var oldValue = change.ContainsKey("old") ? change["old"]?.ToString() : null;
                            var newValue = change.ContainsKey("new") ? change["new"]?.ToString() : null;
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-3 font-medium text-gray-800">@field</td>
                                <td class="px-6 py-3">
                                    @if (oldValue != null)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded bg-red-50 text-red-700 text-xs font-mono">
                                            @oldValue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs italic">null</span>
                                    }
                                </td>
                                <td class="px-6 py-3">
                                    @if (newValue != null)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded bg-green-50 text-green-700 text-xs font-mono">
                                            @newValue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs italic">null</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
            <i class="fas fa-info-circle text-3xl text-gray-300 mb-3"></i>
            <p class="text-sm text-gray-500">No field-level changes recorded for this entry.</p>
        </div>
    }
</div>
