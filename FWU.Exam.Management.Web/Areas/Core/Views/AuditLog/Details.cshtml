@model FWU.Exam.Management.Domain.Entities.AuditLog

@{
    ViewData["Title"] = "Audit Log Details";
    var isActivity = string.Equals(Model.Kind, "Activity", StringComparison.OrdinalIgnoreCase);

    List<Dictionary<string, object>>? changes = null;
    if (!string.IsNullOrEmpty(Model.ChangesJson))
    {
        changes = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, object>>>(Model.ChangesJson);
    }

    object? activityDetails = null;
    if (!string.IsNullOrEmpty(Model.DetailsJson))
    {
        activityDetails = System.Text.Json.JsonSerializer.Deserialize<object>(Model.DetailsJson);
    }
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-history text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Audit Log Details</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    @if (isActivity)
                    {
                        <span>Activity record</span>
                    }
                    else
                    {
                        <span>Change record for @Model.EntityName #@Model.EntityId</span>
                    }
                </p>
            </div>
        </div>
        <a asp-action="Index" asp-area="Core" class="px-4 py-2 bg-gray-100 text-gray-700 text-xs sm:text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
            <i class="fas fa-arrow-left mr-1"></i> Back to List
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">Timestamp</label>
                <p class="text-xs sm:text-sm text-gray-800 font-medium">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">Type</label>
                @if (isActivity)
                {
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-violet-100 text-violet-700">
                        <i class="fas fa-bolt mr-1"></i> Activity
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                        <i class="fas fa-database mr-1"></i> Data Change
                    </span>
                }
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">@(isActivity ? "Activity Type" : "Entity")</label>
                @if (isActivity)
                {
                    <p class="text-xs sm:text-sm text-gray-800 font-mono font-medium">@Model.ActivityType</p>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                        @Model.EntityName
                    </span>
                }
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">@(isActivity ? "Severity" : "Entity ID")</label>
                @if (isActivity)
                {
                    if (!string.IsNullOrEmpty(Model.Severity))
                    {
                        switch (Model.Severity)
                        {
                            case "Warning":
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">Warning</span>
                                break;
                            case "Error":
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">Error</span>
                                break;
                            default:
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">Info</span>
                                break;
                        }
                    }
                }
                else
                {
                    <p class="text-xs sm:text-sm text-gray-800 font-mono font-medium">@Model.EntityId</p>
                }
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">User</label>
                <p class="text-xs sm:text-sm text-gray-800 font-medium">@Model.UserName</p>
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">User ID</label>
                <p class="text-xs sm:text-sm text-gray-800 font-mono">@Model.UserId</p>
            </div>
            @if (Model.RowCount > 1)
            {
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">Rows Affected</label>
                    <p class="text-xs sm:text-sm text-gray-800 font-medium">@Model.RowCount</p>
                </div>
            }
        </div>
    </div>

    @if (isActivity)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-base sm:text-lg font-semibold text-gray-800 mb-4">
                <i class="fas fa-bolt mr-2 text-violet-500"></i>
                Activity Details
            </h3>
            <div class="mb-4">
                <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">Description</label>
                <p class="text-sm text-gray-800">@(Model.Description ?? "No description.")</p>
            </div>
            @if (activityDetails != null)
            {
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-500 mb-1">Payload</label>
                    <pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-xs text-gray-800 overflow-x-auto"><code>@activityDetails</code></pre>
                </div>
            }
            else
            {
                <p class="text-xs sm:text-sm text-gray-500">No structured payload recorded for this activity.</p>
            }
        </div>
    }
    else if (changes != null && changes.Count > 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-base sm:text-lg font-semibold text-gray-800">
                    <i class="fas fa-exchange-alt mr-2 text-indigo-500"></i>
                    Field Changes (@changes.Count)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Field</th>
                            <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Old Value</th>
                            <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">New Value</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var change in changes)
                        {
                            var field = change.ContainsKey("field") ? change["field"]?.ToString() : "";
                            var oldValue = change.ContainsKey("old") ? change["old"]?.ToString() : null;
                            var newValue = change.ContainsKey("new") ? change["new"]?.ToString() : null;
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-3 font-medium text-gray-800">@field</td>
                                <td class="px-6 py-3">
                                    @if (oldValue != null)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded bg-red-50 text-red-700 text-xs font-mono">
                                            @oldValue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs italic">null</span>
                                    }
                                </td>
                                <td class="px-6 py-3">
                                    @if (newValue != null)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded bg-green-50 text-green-700 text-xs font-mono">
                                            @newValue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs italic">null</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
            <i class="fas fa-info-circle text-3xl text-gray-300 mb-3"></i>
            <p class="text-xs sm:text-sm text-gray-500">No field-level changes recorded for this entry.</p>
        </div>
    }
</div>
