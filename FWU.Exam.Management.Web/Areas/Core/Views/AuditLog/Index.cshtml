@model IEnumerable<FWU.Exam.Management.Domain.Entities.AuditLog>

@{
    ViewData["Title"] = "Audit Log";
    var totalCount = (int)ViewBag.TotalCount;
    var page = (int)ViewBag.Page;
    var pageSize = (int)ViewBag.PageSize;
    var totalPages = (int)ViewBag.TotalPages;
    var kinds = (List<string>)ViewData["Kinds"]!;
    var severities = (List<string>)ViewData["Severities"]!;
    var entityNames = (List<string>)ViewData["EntityNames"]!;
    var activityTypes = (List<string>)ViewData["ActivityTypes"]!;
    var actions = (List<string>)ViewData["Actions"]!;
    var hasActiveFilter =
        !string.IsNullOrEmpty(ViewBag.Kind) ||
        !string.IsNullOrEmpty(ViewBag.EntityName) ||
        !string.IsNullOrEmpty(ViewBag.Action) ||
        !string.IsNullOrEmpty(ViewBag.ActivityType) ||
        !string.IsNullOrEmpty(ViewBag.Severity) ||
        !string.IsNullOrEmpty(ViewBag.UserName) ||
        !string.IsNullOrEmpty(ViewBag.From) ||
        !string.IsNullOrEmpty(ViewBag.To) ||
        !string.IsNullOrEmpty(ViewBag.Search);
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-history text-indigo-600"></i>
            </div>
            <div>
    @await Html.PartialAsync("_AlertMessages")
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Audit Log</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Track all changes and business activities across the system.</p>
            </div>
        </div>
        <div class="text-xs sm:text-sm text-gray-500">
            @totalCount total records
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <button type="button" onclick="toggleFilters()"
                class="w-full flex items-center justify-between text-left focus:outline-none">
            <span class="flex items-center gap-2 text-sm font-semibold text-gray-700">
                <i class="fas fa-filter text-blue-600"></i> Filters
                @if (hasActiveFilter)
                {
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                        Active
                    </span>
                }
            </span>
            <i id="filterChevron" class="fas fa-chevron-down text-gray-400 transition-transform @(hasActiveFilter ? "rotate-180" : "")"></i>
        </button>
        <form id="filterForm" method="get" asp-action="Index" asp-area="Core" class="space-y-4 @(hasActiveFilter ? "" : "hidden") mt-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Type</label>
                    <select name="kind" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Types</option>
                        @foreach (var k in kinds)
                        {
                            <option value="@k" selected="@(ViewBag.Kind == k ? "selected" : null)">@k</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Entity</label>
                    <select name="entityName" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Entities</option>
                        @foreach (var name in entityNames)
                        {
                            <option value="@name" selected="@(ViewBag.EntityName == name ? "selected" : null)">@name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Action</label>
                    <select name="actionType" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Actions</option>
                        @foreach (var act in actions)
                        {
                            <option value="@act" selected="@(ViewBag.Action == act ? "selected" : null)">@act</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Activity Type</label>
                    <select name="activityType" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Activities</option>
                        @foreach (var at in activityTypes)
                        {
                            <option value="@at" selected="@(ViewBag.ActivityType == at ? "selected" : null)">@at</option>
                        }
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Severity</label>
                    <select name="severity" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Severities</option>
                        @foreach (var s in severities)
                        {
                            <option value="@s" selected="@(ViewBag.Severity == s ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">User</label>
                    <input type="text" name="userName" value="@ViewBag.UserName" placeholder="Search user..."
                           class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Search</label>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Entity, ID, user, description..."
                           class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">From Date</label>
                    <input type="date" name="from" value="@ViewBag.From"
                           class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">To Date</label>
                    <input type="date" name="to" value="@ViewBag.To"
                           class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
                <div class="flex items-end gap-2">
                    <button type="submit" class="flex-1 inline-flex items-center justify-center px-6 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                        <i class="fas fa-search mr-1"></i> Show Logs
                    </button>
                    <a href="?kind=" class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-gray-100 text-gray-700 text-xs sm:text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
                        <i class="fas fa-times mr-1"></i> Clear Filters
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Timestamp</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Type</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Source</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Activity / Action</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">User</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Severity</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            var isActivity = string.Equals(log.Kind, "Activity", StringComparison.OrdinalIgnoreCase);
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">
                                    @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td class="px-4 py-3">
                                    @if (isActivity)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-violet-100 text-violet-700">
                                            <i class="fas fa-bolt mr-1"></i> Activity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                            <i class="fas fa-database mr-1"></i> Data Change
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (isActivity)
                                    {
                                        <span class="text-xs text-gray-500 font-mono">@log.ActivityType</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
                                            @log.EntityName
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (isActivity)
                                    {
                                        <span class="text-gray-800">@log.Description</span>
                                    }
                                    else
                                    {
                                        @switch (log.Action)
                                        {
                                            case "Created":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                                                    <i class="fas fa-plus-circle mr-1"></i> Created
                                                </span>
                                                break;
                                            case "Updated":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                                                    <i class="fas fa-edit mr-1"></i> Updated
                                                </span>
                                                break;
                                            case "Deleted":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                                                    <i class="fas fa-trash mr-1"></i> Deleted
                                                </span>
                                                break;
                                            default:
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
                                                    @log.Action
                                                </span>
                                                break;
                                        }
                                        @if (log.RowCount > 1)
                                        {
                                            <span class="ml-2 text-xs text-gray-500">(@log.RowCount row(s))</span>
                                        }
                                        else if (!string.IsNullOrEmpty(log.ChangesJson))
                                        {
                                            var changeCount = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, object>>>(log.ChangesJson)?.Count ?? 0;
                                            <span class="ml-2 text-xs text-gray-400">@changeCount field(s)</span>
                                        }
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-600">@log.UserName</td>
                                <td class="px-4 py-3">
                                    @if (isActivity && !string.IsNullOrEmpty(log.Severity))
                                    {
                                        switch (log.Severity)
                                        {
                                            case "Warning":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">Warning</span>
                                                break;
                                            case "Error":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">Error</span>
                                                break;
                                            default:
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">Info</span>
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">-</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <a asp-action="Details" asp-route-id="@log.Id"
                                       class="text-blue-600 hover:text-blue-800 text-xs font-medium">
                                        <i class="fas fa-eye mr-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-4 py-12 text-center">
                                <i class="fas fa-history text-4xl text-gray-300 mb-3"></i>
                                <p class="text-xs sm:text-sm text-gray-500">No audit log entries found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            var qs = $"&kind={ViewBag.Kind}&entityName={ViewBag.EntityName}&actionType={ViewBag.Action}&activityType={ViewBag.ActivityType}&severity={ViewBag.Severity}&userName={ViewBag.UserName}&from={ViewBag.From}&to={ViewBag.To}&search={ViewBag.Search}";
            <div class="px-4 py-3 border-t border-gray-200 flex items-center justify-between">
                <div class="text-xs sm:text-sm text-gray-500">
                    Showing @((page - 1) * pageSize + 1) to @Math.Min(page * pageSize, totalCount) of @totalCount
                </div>
                <div class="flex items-center gap-1">
                    @if (page > 1)
                    {
                        <a href="?page=@(page - 1)@qs"
                           class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                    {
                        <a href="?page=@i@qs"
                           class="px-3 py-1.5 text-sm border rounded-lg @(i == page ? "bg-blue-600 text-white border-blue-600" : "border-gray-200 hover:bg-gray-50") transition-colors">
                            @i
                        </a>
                    }
                    @if (page < totalPages)
                    {
                        <a href="?page=@(page + 1)@qs"
                           class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script>
    function toggleFilters() {
        var form = document.getElementById('filterForm');
        var chevron = document.getElementById('filterChevron');
        form.classList.toggle('hidden');
        chevron.classList.toggle('rotate-180');
    }
</script>
