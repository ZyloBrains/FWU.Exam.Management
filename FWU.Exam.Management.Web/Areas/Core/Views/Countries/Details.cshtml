@model FWU.Exam.Management.Domain.Entities.Country

@{
    ViewData["Title"] = "Country Details";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-globe text-cyan-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Country Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="detail-field">
                <div class="field-label">Country Name</div>
                <div class="field-value">@(Model.CountryName ?? "-")</div>
            </div>
            <div class="detail-field">
                <div class="field-label">Status</div>
                <div class="field-value">
                    @if (Model.IsActive)
                    {
                        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">Inactive</span>
                    }
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-6 border-t border-gray-200 mt-6">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-6 py-2 bg-cyan-600 text-white text-sm font-semibold rounded-lg hover:bg-cyan-700 transition shadow-md">
                <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
