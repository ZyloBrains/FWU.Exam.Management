@model FWU.Exam.Management.Domain.Entities.Country

@{
    ViewData["Title"] = "Delete Country";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-globe text-cyan-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Delete Country</h1>
        </div>
    </div>

    <div class="bg-red-50 rounded-xl shadow-lg border border-red-200 p-8">
        <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center shrink-0">
                <i class="fas fa-exclamation-triangle text-red-600"></i>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-red-800">Are you sure you want to delete this?</h3>
                <p class="text-sm text-red-600 mt-1">This action cannot be undone.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="detail-field">
                <div class="field-label">Country Name</div>
                <div class="field-value">@(Model.CountryName ?? "-")</div>
            </div>
            <div class="detail-field">
                <div class="field-label">Status</div>
                <div class="field-value">
                    @if (Model.IsActive)
                    {
                        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">Inactive</span>
                    }
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-4 border-t border-red-200">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="px-6 py-2 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md">
                    <i class="fas fa-trash mr-1"></i> Delete
                </button>
            </form>
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Cancel
            </a>
        </div>
    </div>
</div>
