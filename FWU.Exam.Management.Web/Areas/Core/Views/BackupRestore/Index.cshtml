@model List<FWU.Exam.Management.Application.Interfaces.BackupInfo>

@{
    ViewData["Title"] = "Backup & Restore";
    var dbName = ViewBag.DbName as string ?? "Unknown";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-database text-emerald-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Backup & Restore</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Manage database backups for <strong>@dbName</strong></p>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-base sm:text-lg font-semibold text-gray-800">
                    <i class="fas fa-download mr-2 text-emerald-500"></i>Create Backup
                </h3>
                <p class="text-xs sm:text-sm text-gray-500 mt-1">Create a full backup of the database. Backups are stored locally.</p>
            </div>
        </div>
        <form method="post" asp-action="Backup" asp-area="Core" class="flex flex-col sm:flex-row gap-3 items-end">
            @Html.AntiForgeryToken()
            <div class="flex-1 w-full">
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Backup Name (optional)</label>
                <input type="text" name="backupName" placeholder="e.g., before-migration, production-snapshot"
                       class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
            <button type="submit" class="px-6 py-2.5 bg-emerald-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors shadow-sm whitespace-nowrap"
                    onclick="return confirm('Create a database backup now?');">
                <i class="fas fa-database mr-1"></i> Backup Now
            </button>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
            <h3 class="text-base sm:text-lg font-semibold text-gray-800">
                <i class="fas fa-list mr-2 text-blue-500"></i>Existing Backups
            </h3>
            <span class="text-xs sm:text-sm text-gray-500">@Model.Count file(s)</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">File Name</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Size</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Created</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model.Any())
                    {
                        @foreach (var backup in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-file-archive text-blue-400"></i>
                                        <span class="font-mono text-gray-800">@backup.FileName</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-gray-600">@backup.SizeDisplay</td>
                                <td class="px-4 py-3 text-gray-600">@backup.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-action="Download" asp-route-fileName="@backup.FileName"
                                           class="px-3 py-1.5 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors">
                                            <i class="fas fa-download mr-1"></i> Download
                                        </a>
                                        <form method="post" asp-action="Restore" asp-area="Core" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="backupFileName" value="@backup.FileName" />
                                            <button type="submit" class="px-3 py-1.5 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors"
                                                    onclick="return confirm('Restore database from @backup.FileName?\n\nThis will OVERWRITE the current database. All unsaved changes will be lost.');">
                                                <i class="fas fa-undo mr-1"></i> Restore
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-area="Core" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="fileName" value="@backup.FileName" />
                                            <button type="submit" class="px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors"
                                                    onclick="return confirm('Delete backup file @backup.FileName?');">
                                                <i class="fas fa-trash mr-1"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-4 py-12 text-center">
                                <i class="fas fa-database text-4xl text-gray-300 mb-3"></i>
                                <p class="text-xs sm:text-sm text-gray-500">No backups found. Create your first backup above.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5">
        <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-amber-100 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                <i class="fas fa-info-circle text-amber-600"></i>
            </div>
            <div class="text-sm text-amber-800">
                <p class="font-semibold mb-1">Important Notes:</p>
                <ul class="list-disc list-inside space-y-1 text-amber-700">
                    <li>Backups are stored in <code class="bg-amber-100 px-1 rounded">App_Data/Backups/</code> relative to the application.</li>
                    <li>Restore will <strong>overwrite</strong> the current database. Ensure you have a recent backup before restoring.</li>
                    <li>During restore, all connected users will be temporarily disconnected.</li>
                    <li>Download backups to a safe location for off-site storage.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
