@model FWU.Exam.Management.Domain.Entities.Notice

@{
    ViewData["Title"] = "Create Notice";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-bullhorn text-emerald-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Notice</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 gap-5">
                <div>
                    <label asp-for="NoticeTitle" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="NoticeTitle" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="Enter notice title" />
                    <span asp-validation-for="NoticeTitle" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="NoticePreview" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <textarea asp-for="NoticePreview" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="Brief preview (max 1024 characters)"></textarea>
                    <span asp-validation-for="NoticePreview" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="NoticeContent" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <textarea asp-for="NoticeContent" rows="12" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono" placeholder="Enter notice content (HTML supported)"></textarea>
                    <span asp-validation-for="NoticeContent" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="PublishedDate" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="PublishedDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="PublishedDate" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
