@model FWU.Exam.Management.Domain.Entities.Notice
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Notice Details";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-bullhorn text-blue-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Notice Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 gap-6">
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Title</p>
                <p class="mt-1 text-gray-800 font-semibold text-lg">@Html.DisplayFor(model => model.NoticeTitle)</p>
            </div>
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Preview</p>
                <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.NoticePreview)</p>
            </div>
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Published Date</p>
                <p class="mt-1 text-gray-800">@(Model.PublishedDate?.ToString("yyyy-MM-dd") ?? "-")</p>
            </div>
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Content</p>
                <div class="mt-1 p-4 bg-gray-50 rounded-lg border border-gray-200 prose prose-sm max-w-none">
                    @Html.Raw(Model.NoticeContent)
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (HasPerm("notices.edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
