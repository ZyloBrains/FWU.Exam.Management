@model FWU.Exam.Management.Domain.Entities.Notice

@{
    ViewData["Title"] = "Delete Notice";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-bullhorn text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete Notice</h1>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <!-- Warning Alert -->
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this notice? This action cannot be undone.
                </p>
            </div>
        </div>

        <!-- Details Section -->
        <div class="grid grid-cols-1 gap-x-8 gap-y-5 mb-8">
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Title</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.NoticeTitle)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Preview</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.NoticePreview)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Published Date</p>
                <p class="text-gray-800 font-medium">@(Model.PublishedDate?.ToString("yyyy-MM-dd") ?? "-")</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Content</p>
                <div class="mt-1 p-4 bg-gray-50 rounded-lg border border-gray-200 max-h-64 overflow-y-auto">
                    @Html.Raw(Model.NoticeContent)
                </div>
            </div>
        </div>

        <!-- Warning Note -->
        <div class="bg-yellow-50 border-l-4 border-yellow-500 rounded-lg p-4 mb-6">
            <div class="flex items-start">
                <i class="fas fa-info-circle text-yellow-500 mr-3 text-lg mt-0.5"></i>
                <div>
                    <p class="text-sm font-semibold text-yellow-800">Important Note:</p>
                    <p class="text-xs text-yellow-700 mt-1">
                        Deleting this notice will permanently remove it from the system. This may affect public display of notices.
                    </p>
                </div>
            </div>
        </div>

        <!-- Delete Form -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this notice? This action cannot be undone.');"
                        class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
