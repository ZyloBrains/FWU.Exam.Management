@model FWU.Exam.Management.Domain.Entities.Payments.KhaltiConfiguration

@{
    ViewData["Title"] = "Create Khalti Configuration";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-credit-card text-purple-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Khalti Configuration</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Khalti Payment Gateway Settings</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ProductName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ProductName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="Product Name" />
                        <span asp-validation-for="ProductName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Amount" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="Amount" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="0.00" />
                        <span asp-validation-for="Amount" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ServiceCharge" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ServiceCharge" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="0" />
                        <span asp-validation-for="ServiceCharge" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="WebsiteUrl" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="WebsiteUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="https://example.com" />
                        <span asp-validation-for="WebsiteUrl" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="PostUrl" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="PostUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="https://khalti.com/api/payment/" />
                        <span asp-validation-for="PostUrl" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ReturnUrl" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ReturnUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="https://example.com/return" />
                        <span asp-validation-for="ReturnUrl" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="VerifyUrl" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="VerifyUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="https://khalti.com/api/verify/" />
                        <span asp-validation-for="VerifyUrl" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="AuthorizationKey" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="AuthorizationKey" type="password" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="Secret key / Authorization key" />
                        <span asp-validation-for="AuthorizationKey" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-purple-600 text-white text-sm font-semibold rounded-lg hover:bg-purple-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
