@model FWU.Exam.Management.Domain.Entities.Payments.KhaltiConfiguration
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Khalti Configuration Details";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-credit-card text-blue-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Khalti Configuration Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="mb-6">
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Configuration Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Product Name</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.ProductName)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Amount</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Amount)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Service Charge</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ServiceCharge)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Website URL</p>
                    <p class="mt-1 text-gray-800 break-all">@Html.DisplayFor(model => model.WebsiteUrl)</p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Post URL</p>
                    <p class="mt-1 text-gray-800 break-all">@Html.DisplayFor(model => model.PostUrl)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Return URL</p>
                    <p class="mt-1 text-gray-800 break-all">@Html.DisplayFor(model => model.ReturnUrl)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Verify URL</p>
                    <p class="mt-1 text-gray-800 break-all">@Html.DisplayFor(model => model.VerifyUrl)</p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Authorization Key</p>
                    <p class="mt-1 text-gray-800">********</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (HasPerm("khalti.edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
