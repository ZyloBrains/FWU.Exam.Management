@model FWU.Exam.Management.Domain.Entities.Subjects.SubjectCatalog

@{
    ViewData["Title"] = "Edit Subject Catalog";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-book text-amber-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit Subject Catalog</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="SubjectCode" class="text-sm font-medium text-gray-700 block mb-1">Subject Code <span class="text-red-500">*</span></label>
                    <input asp-for="SubjectCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="e.g., MATH101, ENG201" />
                    <span asp-validation-for="SubjectCode" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ShortName" class="text-sm font-medium text-gray-700 block mb-1">Short Name</label>
                    <input asp-for="ShortName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="e.g., Math, English" />
                    <span asp-validation-for="ShortName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="SubjectName" class="text-sm font-medium text-gray-700 block mb-1">Subject Name <span class="text-red-500">*</span></label>
                    <input asp-for="SubjectName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="e.g., Mathematics I, English Composition" />
                    <span asp-validation-for="SubjectName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="SubjectTypeId" class="text-sm font-medium text-gray-700 block mb-1">Subject Type</label>
                    <select asp-for="SubjectTypeId" asp-items="ViewBag.SubjectTypeId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                        <option value="">-- Select Subject Type --</option>
                    </select>
                    <span asp-validation-for="SubjectTypeId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="CreditHours" class="text-sm font-medium text-gray-700 block mb-1">Credit Hours</label>
                    <input asp-for="CreditHours" type="number" min="1" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="e.g., 3, 4, 5" />
                    <span asp-validation-for="CreditHours" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Description" class="text-sm font-medium text-gray-700 block mb-1">Description</label>
                    <textarea asp-for="Description" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Enter description (optional)"></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
