@model FWU.Exam.Management.Web.ViewModels.SubjectOfferingBulkCreateViewModel

@{
    ViewData["Title"] = "Create Subject Offerings";
}

<div class="max-w-6xl mx-auto mt-2 space-y-3 px-4"
     x-data="subjectOfferingForm()"
     x-init="init()">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-indigo-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Subject Offerings</h1>
        </div>
    </div>

    <form asp-action="Create" method="post" @@submit.prevent="submitForm()">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2 mb-4"></div>

        <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-6 mb-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="ProgramId" class="text-sm font-medium text-gray-700 block mb-1">Program</label>
                    <select asp-for="ProgramId" asp-items="ViewBag.ProgramId"
                            class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">-- Select Program --</option>
                    </select>
                    <span asp-validation-for="ProgramId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="SemesterId" class="text-sm font-medium text-gray-700 block mb-1">Semester</label>
                    <select asp-for="SemesterId" asp-items="ViewBag.SemesterId"
                            class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">-- Select Semester --</option>
                    </select>
                    <span asp-validation-for="SemesterId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-6 mb-4">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-gray-700">Subjects</h3>
                <span class="text-xs bg-indigo-100 text-indigo-700 font-medium px-2.5 py-1 rounded-full"
                      x-show="selectedSubjects.length > 0"
                      x-text="selectedSubjects.length + ' selected'"></span>
            </div>

            <div class="relative mb-4" @@click.away="showDropdown = false">
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text"
                           x-model="search"
                           @@focus="showDropdown = true"
                           @@input="showDropdown = true"
                           placeholder="Search and add subjects by code or name..."
                           class="w-full border border-gray-300 rounded-lg pl-9 pr-10 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                    <button type="button"
                            x-show="search.length > 0"
                            @@click="search = ''; showDropdown = false"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div x-show="showDropdown && filteredSubjects.length > 0"
                     class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl max-h-60 overflow-y-auto">
                    <template x-for="subject in filteredSubjects" :key="subject.id">
                        <div class="flex items-center justify-between px-4 py-2.5 hover:bg-indigo-50 cursor-pointer border-b border-gray-100 last:border-b-0 transition"
                             @@click="addSubject(subject)">
                            <div>
                                <p class="text-sm font-medium text-gray-800">
                                    <span class="font-mono text-indigo-600" x-text="subject.code"></span>
                                    <span class="text-gray-400 mx-1">-</span>
                                    <span x-text="subject.name"></span>
                                </p>
                                <p class="text-xs text-gray-400" x-text="subject.type + (subject.credits ? ' | ' + subject.credits + ' cr' : '')"></p>
                            </div>
                            <i class="fas fa-plus text-xs text-indigo-400"></i>
                        </div>
                    </template>
                </div>

                <div x-show="showDropdown && search.length > 0 && filteredSubjects.length === 0"
                     class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl p-4 text-center text-sm text-gray-400">
                    No subjects match "<span x-text="search"></span>"
                </div>
            </div>

            <template x-if="selectedSubjects.length === 0">
                <div class="text-center py-8 text-gray-400 text-sm border-2 border-dashed border-gray-200 rounded-lg">
                    <i class="fas fa-search text-2xl mb-2 block text-gray-300"></i>
                    <p>Search and add subjects above</p>
                </div>
            </template>

            <div class="space-y-3">
                <template x-for="(subject, index) in selectedSubjects" :key="subject.id">
                    <div class="border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                        <div class="flex items-center justify-between px-4 py-3 bg-gradient-to-r from-gray-50 to-white border-b border-gray-100">
                            <div class="flex items-center gap-3">
                                <span class="text-xs text-gray-400 font-mono bg-gray-100 px-1.5 py-0.5 rounded shrink-0"
                                      x-text="'#' + (index + 1)"></span>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">
                                        <span class="font-mono text-indigo-600" x-text="subject.code"></span>
                                        <span class="text-gray-400 mx-1">-</span>
                                        <span x-text="subject.name"></span>
                                    </p>
                                </div>
                            </div>
                            <button type="button"
                                    class="w-7 h-7 bg-red-50 text-red-400 rounded-full flex items-center justify-center hover:bg-red-100 hover:text-red-600 transition shrink-0"
                                    @@click="removeSubject(index)">
                                <i class="fas fa-times text-xs"></i>
                            </button>
                        </div>

                        <div class="p-4 space-y-3">
                            <div class="flex items-center gap-6">
                                <div class="flex items-center gap-2">
                                    <input type="hidden" :name="'Subjects[' + index + '].IsCompulsory'" :value="subject.isCompulsory" />
                                    <button type="button"
                                            @@click="subject.isCompulsory = !subject.isCompulsory"
                                            :class="subject.isCompulsory ? 'bg-indigo-600 border-indigo-600' : 'bg-white border-gray-300'"
                                            class="w-4 h-4 rounded border-2 flex items-center justify-center transition shrink-0">
                                        <i x-show="subject.isCompulsory" class="fas fa-check text-white text-[8px]"></i>
                                    </button>
                                    <span class="text-sm text-gray-600">Compulsory</span>
                                </div>
                                <div>
                                    <label class="text-xs text-gray-500 block mb-0.5">Display Order</label>
                                    <input type="number" min="1"
                                           :name="'Subjects[' + index + '].DisplayOrder'"
                                           x-model="subject.displayOrder"
                                           class="w-20 border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1 border-t border-gray-100">
                                <div>
                                    <div class="flex items-center gap-2 mb-2">
                                        <input type="hidden" :name="'Subjects[' + index + '].HasTheory'" :value="subject.hasTheory" />
                                        <button type="button"
                                                @@click="subject.hasTheory = !subject.hasTheory"
                                                :class="subject.hasTheory ? 'bg-indigo-600 border-indigo-600' : 'bg-white border-gray-300'"
                                                class="w-4 h-4 rounded border-2 flex items-center justify-center transition shrink-0">
                                            <i x-show="subject.hasTheory" class="fas fa-check text-white text-[8px]"></i>
                                        </button>
                                        <span class="text-sm font-medium text-gray-700">Theory</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Full Marks</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].TheoryFullMarks'"
                                                   x-model="subject.theoryFullMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Pass Marks</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].TheoryPassMarks'"
                                                   x-model="subject.theoryPassMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <div class="flex items-center gap-2 mb-2">
                                        <input type="hidden" :name="'Subjects[' + index + '].HasPractical'" :value="subject.hasPractical" />
                                        <button type="button"
                                                @@click="subject.hasPractical = !subject.hasPractical"
                                                :class="subject.hasPractical ? 'bg-indigo-600 border-indigo-600' : 'bg-white border-gray-300'"
                                                class="w-4 h-4 rounded border-2 flex items-center justify-center transition shrink-0">
                                            <i x-show="subject.hasPractical" class="fas fa-check text-white text-[8px]"></i>
                                        </button>
                                        <span class="text-sm font-medium text-gray-700">Practical</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Full Marks</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].PracticalFullMarks'"
                                                   x-model="subject.practicalFullMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Pass Marks</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].PracticalPassMarks'"
                                                   x-model="subject.practicalPassMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <div class="flex items-center gap-2 mb-2">
                                        <input type="hidden" :name="'Subjects[' + index + '].HasInternal'" :value="subject.hasInternal" />
                                        <button type="button"
                                                @@click="subject.hasInternal = !subject.hasInternal"
                                                :class="subject.hasInternal ? 'bg-indigo-600 border-indigo-600' : 'bg-white border-gray-300'"
                                                class="w-4 h-4 rounded border-2 flex items-center justify-center transition shrink-0">
                                            <i x-show="subject.hasInternal" class="fas fa-check text-white text-[8px]"></i>
                                        </button>
                                        <span class="text-sm font-medium text-gray-700">Internal</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-x-2 gap-y-1">
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Theory Full</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].InternalTheoryFullMarks'"
                                                   x-model="subject.internalTheoryFullMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Theory Pass</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].InternalTheoryPassMarks'"
                                                   x-model="subject.internalTheoryPassMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Practical Full</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].InternalPracticalFullMarks'"
                                                   x-model="subject.internalPracticalFullMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                        <div>
                                            <label class="text-xs text-gray-500 block mb-0.5">Practical Pass</label>
                                            <input type="number" step="0.5" min="0"
                                                   :name="'Subjects[' + index + '].InternalPracticalPassMarks'"
                                                   x-model="subject.internalPracticalPassMarks"
                                                   class="w-full border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-indigo-500" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" :name="'Subjects[' + index + '].SubjectCatalogId'" :value="subject.id" />
                    </div>
                </template>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <button type="submit"
                    class="px-6 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
                    x-bind:disabled="selectedSubjects.length === 0">
                <i class="fas fa-save mr-1.5"></i>
                Save <span x-text="selectedSubjects.length"></span> Offering(s)
            </button>
            <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function subjectOfferingForm() {
            return {
                allSubjects: [],
                search: '',
                showDropdown: false,
                selectedSubjects: [],

                init() {
                    this.allSubjects = @Html.Raw(ViewBag.SubjectCatalogsJson ?? "[]");
                },

                get filteredSubjects() {
                    if (!this.search.trim()) return [];
                    const q = this.search.toLowerCase().trim();
                    const selectedIds = new Set(this.selectedSubjects.map(s => s.id));
                    return this.allSubjects.filter(s =>
                        !selectedIds.has(s.id) && (
                            (s.code && s.code.toLowerCase().includes(q)) ||
                            (s.name && s.name.toLowerCase().includes(q)) ||
                            (s.type && s.type.toLowerCase().includes(q))
                        )
                    );
                },

                addSubject(subject) {
                    if (this.selectedSubjects.some(s => s.id === subject.id)) return;
                    this.selectedSubjects.push({
                        id: subject.id,
                        code: subject.code,
                        name: subject.name,
                        isCompulsory: true,
                        displayOrder: this.selectedSubjects.length + 1,
                        hasTheory: true,
                        hasPractical: false,
                        hasInternal: false,
                        theoryFullMarks: 75,
                        theoryPassMarks: 27,
                        practicalFullMarks: null,
                        practicalPassMarks: null,
                        internalTheoryFullMarks: null,
                        internalTheoryPassMarks: null,
                        internalPracticalFullMarks: null,
                        internalPracticalPassMarks: null
                    });
                    this.search = '';
                    this.showDropdown = false;
                },

                removeSubject(index) {
                    this.selectedSubjects.splice(index, 1);
                    this.selectedSubjects.forEach((s, i) => s.displayOrder = i + 1);
                },

                submitForm() {
                    if (this.selectedSubjects.length === 0) {
                        alert('Please add at least one subject.');
                        return;
                    }
                    this.$el.submit();
                }
            };
        }
    </script>
}
