@model FWU.Exam.Management.Web.ViewModels.SubjectOfferingBulkCreateViewModel

@{
    ViewData["Title"] = "Create Subject Offerings";
}

<div class="space-y-6 overflow-auto max-w-full"
     x-data="subjectOfferingForm()"
     x-init="init()">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-indigo-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Create Subject Offerings</h1>
        </div>
    </div>

    <form asp-action="Create" method="post" @@submit.prevent="submitForm()">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2 mb-4"></div>

        <div class="bg-white rounded-lg shadow border border-gray-200 p-4 mb-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="ProgramId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-2">Program</label>
                    <select asp-for="ProgramId" asp-items="ViewBag.ProgramId"
                            class="select2 w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">-- Select Program --</option>
                    </select>
                    <span asp-validation-for="ProgramId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="CurriculumVersionId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-2">Curriculum Version</label>
                    <select asp-for="CurriculumVersionId" asp-items="ViewBag.CurriculumVersionId"
                            class="select2 w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">-- Select Curriculum Version --</option>
                    </select>
                    <span asp-validation-for="CurriculumVersionId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
            <p class="text-xs text-gray-400 mt-3" x-text="statusMessage"></p>
        </div>

        <template x-if="semesters.length === 0">
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-10 text-center text-sm text-gray-400">
                <i class="fas fa-calendar-alt text-3xl mb-2 block text-gray-300"></i>
                <p x-text="statusMessage"></p>
            </div>
        </template>

        <template x-for="(sem, semIndex) in semesters" :key="sem.semesterId">
            <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-6 mb-4">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                        <span class="w-8 h-8 bg-indigo-100 text-indigo-700 rounded-lg flex items-center justify-center text-xs font-bold">
                            <span x-text="semIndex + 1"></span>
                        </span>
                        <span x-text="sem.semesterName"></span>
                    </h3>
                    <input type="hidden" :name="'Semesters[' + semIndex + '].SemesterId'" :value="sem.semesterId" />
                    <input type="hidden" :name="'Semesters[' + semIndex + '].SemesterName'" :value="sem.semesterName" />
                    <span class="text-xs bg-indigo-100 text-indigo-700 font-medium px-2.5 py-1 rounded-full"
                          x-show="sem.selectedSubjects.length > 0"
                          x-text="sem.selectedSubjects.length + ' selected'"></span>
                </div>

                <div class="relative mb-4" @@click.away="sem.showDropdown = false">
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="text"
                               x-model="sem.search"
                               @@focus="sem.showDropdown = true"
                               @@input="sem.showDropdown = true"
                               placeholder="Search and add subjects by code or name..."
                               class="w-full border border-gray-300 rounded-lg pl-9 pr-10 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <button type="button"
                                x-show="sem.search.length > 0"
                                @@click="sem.search = ''; sem.showDropdown = false"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div x-show="sem.showDropdown && filteredSubjectsFor(sem).length > 0"
                         class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl max-h-60 overflow-y-auto">
                        <template x-for="subject in filteredSubjectsFor(sem)" :key="subject.id">
                            <div class="flex items-center justify-between px-4 py-2.5 hover:bg-indigo-50 cursor-pointer border-b border-gray-100 last:border-b-0 transition"
                                 @@click="addSubject(sem, subject)">
                                <div>
                                    <p class="text-sm font-medium text-gray-800">
                                        <span class="font-mono text-indigo-600" x-text="subject.code"></span>
                                        <span class="text-gray-400 mx-1">-</span>
                                        <span x-text="subject.name"></span>
                                    </p>
                                    <p class="text-xs text-gray-400" x-text="subject.type + (subject.credits ? ' | ' + subject.credits + ' cr' : '')"></p>
                                </div>
                                <i class="fas fa-plus text-xs text-indigo-400"></i>
                            </div>
                        </template>
                    </div>

                    <div x-show="sem.showDropdown && sem.search.length > 0 && filteredSubjectsFor(sem).length === 0"
                         class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl p-4 text-center text-sm text-gray-400">
                        No subjects match "<span x-text="sem.search"></span>"
                    </div>
                </div>

                <template x-if="sem.selectedSubjects.length === 0">
                    <div class="text-center py-8 text-gray-400 text-sm border-2 border-dashed border-gray-200 rounded-lg">
                        <i class="fas fa-search text-2xl mb-2 block text-gray-300"></i>
                        <p>Search and add subjects for this semester</p>
                    </div>
                </template>

                <div class="space-y-3">
                    <template x-for="(subject, index) in sem.selectedSubjects" :key="subject.id">
                        @{
                            await Html.RenderPartialAsync("_SubjectOfferingSelectedCard");
                        }
                    </template>
                </div>
            </div>
        </template>

        <div class="flex items-center gap-4">
            <button type="submit"
                    class="px-6 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
                    x-bind:disabled="totalSelected === 0">
                <i class="fas fa-save mr-1.5"></i>
                Save <span x-text="totalSelected"></span> Offering(s)
            </button>
            <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <link href="~/lib/select2/css/select2.min.css" asp-append-version="true" rel="stylesheet" />
    <script src="~/lib/select2/js/select2.min.js" asp-append-version="true"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #6366f1;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
        }
    </style>

    <script>
        document.addEventListener('alpine:init', function () {
            document.querySelectorAll('.select2').forEach(function (el) {
                $(el).select2({width:'resolve'});
            });
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
    <script>
        function subjectOfferingForm() {
            return {
                allSubjects: [],
                semesters: [],
                statusMessage: '',

                init() {
                    this.allSubjects = @Html.Raw(ViewBag.SubjectCatalogsJson ?? "[]");
                    const initial = @Html.Raw(ViewBag.InitialSemestersJson ?? "[]");
                    const existing = @Html.Raw(ViewBag.InitialExistingJson ?? "{}");
                    this.semesters = initial.map(s => ({
                        semesterId: s.semesterId,
                        semesterName: s.semesterName,
                        search: '',
                        showDropdown: false,
                        existingSubjectIds: existing[s.semesterId] || [],
                        selectedSubjects: (s.subjects || []).map(sub => ({
                            id: sub.id,
                            code: sub.code,
                            name: sub.name,
                            isCompulsory: !!sub.isCompulsory,
                            displayOrder: sub.displayOrder || 1,
                            hasTheory: !!sub.hasTheory,
                            hasPractical: !!sub.hasPractical,
                            hasInternal: !!sub.hasInternal,
                            theoryFullMarks: sub.theoryFullMarks,
                            theoryPassMarks: sub.theoryPassMarks,
                            practicalFullMarks: sub.practicalFullMarks,
                            practicalPassMarks: sub.practicalPassMarks,
                            internalTheoryFullMarks: sub.internalTheoryFullMarks,
                            internalTheoryPassMarks: sub.internalTheoryPassMarks
                        }))
                    }));
                    this.statusMessage = this.semesters.length
                        ? 'Add subjects for each semester below, then click Save.'
                        : 'Select a program and curriculum version to load its semesters.';
                },

                get totalSelected() {
                    return this.semesters.reduce(function (sum, sem) {
                        return sum + sem.selectedSubjects.length;
                    }, 0);
                },

                filteredSubjectsFor(sem) {
                    if (!sem.search.trim()) return [];
                    const q = sem.search.toLowerCase().trim();
                    const selectedIds = new Set(sem.selectedSubjects.map(s => s.id));
                    const existingIdsSet = new Set(sem.existingSubjectIds);
                    return this.allSubjects.filter(s =>
                        !selectedIds.has(s.id) &&
                        !existingIdsSet.has(s.id) && (
                            (s.code && s.code.toLowerCase().includes(q)) ||
                            (s.name && s.name.toLowerCase().includes(q)) ||
                            (s.type && s.type.toLowerCase().includes(q))
                        )
                    );
                },

                addSubject(sem, subject) {
                    if (sem.selectedSubjects.some(s => s.id === subject.id)) return;
                    if (sem.existingSubjectIds.includes(subject.id)) {
                        alert(`Already exists: "${subject.code} - ${subject.name}" is already offered in ${sem.semesterName} for the selected program.`);
                        sem.search = '';
                        sem.showDropdown = false;
                        return;
                    }
                    sem.selectedSubjects.push({
                        id: subject.id,
                        code: subject.code,
                        name: subject.name,
                        isCompulsory: true,
                        displayOrder: sem.selectedSubjects.length + 1,
                        hasTheory: true,
                        hasPractical: false,
                        hasInternal: false,
                        theoryFullMarks: 75,
                        theoryPassMarks: 27,
                        practicalFullMarks: null,
                        practicalPassMarks: null,
                        internalTheoryFullMarks: null,
                        internalTheoryPassMarks: null
                    });
                    sem.search = '';
                    sem.showDropdown = false;
                },

                removeSubject(sem, index) {
                    sem.selectedSubjects.splice(index, 1);
                    sem.selectedSubjects.forEach(function (s, i) { s.displayOrder = i + 1; });
                },

                async loadSemesters() {
                    const programId = document.getElementById('ProgramId').value;
                    const curriculumVersionId = document.getElementById('CurriculumVersionId').value;
                    if (!programId || !curriculumVersionId) {
                        this.semesters = [];
                        this.statusMessage = 'Select a program and curriculum version to load its semesters.';
                        return;
                    }
                    try {
                        const resp = await fetch(tenantUrl(`/Subjects/SubjectOfferings/GetSemestersForCreate?programId=${programId}&curriculumVersionId=${curriculumVersionId}`));
                        const data = await resp.json();
                        this.semesters = data.map(s => ({
                            semesterId: s.semesterId,
                            semesterName: s.semesterName,
                            search: '',
                            showDropdown: false,
                            existingSubjectIds: [],
                            selectedSubjects: []
                        }));
                        this.statusMessage = this.semesters.length
                            ? 'Add subjects for each semester below, then click Save.'
                            : 'No semesters were found for the selected curriculum version.';
                        await this.refreshExistingSubjects();
                    } catch (e) {
                        this.semesters = [];
                        this.statusMessage = 'Could not load semesters. Please try again.';
                    }
                },

                async refreshExistingSubjects() {
                    const programId = document.getElementById('ProgramId').value;
                    const curriculumVersionId = document.getElementById('CurriculumVersionId').value;
                    if (!programId || !curriculumVersionId) return;
                    const resp = await fetch(tenantUrl(`/Subjects/SubjectOfferings/GetExistingSubjectsBySemesters?programId=${programId}&curriculumVersionId=${curriculumVersionId}`));
                    const data = await resp.json();
                    this.semesters.forEach(sem => {
                        sem.existingSubjectIds = data[sem.semesterId] || [];
                    });
                },

                submitForm() {
                    if (this.totalSelected === 0) {
                        alert('Please add at least one subject to at least one semester.');
                        return;
                    }
                    this.$el.submit();
                }
            };
        }

        function resetSelect2($el) {
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.select2('destroy');
            }
            $el.empty().append('<option value="">-- Select Curriculum Version --</option>');
        }

        function loadSemestersAlpine() {
            var root = document.querySelector('[x-data="subjectOfferingForm()"]');
            if (root && typeof Alpine !== 'undefined') {
                var data = Alpine.$data(root);
                if (data && typeof data.loadSemesters === 'function') data.loadSemesters();
            }
        }

        function refreshExistingSubjects() {
            var root = document.querySelector('[x-data="subjectOfferingForm()"]');
            if (root && typeof Alpine !== 'undefined') {
                var data = Alpine.$data(root);
                if (data && typeof data.refreshExistingSubjects === 'function') data.refreshExistingSubjects();
            }
        }

        function loadCurriculumVersions(selectedId) {
            var programId = $('#ProgramId').val();
            var versionSelect = $('#CurriculumVersionId');

            resetSelect2(versionSelect);

            if (!programId) {
                versionSelect.prop('disabled', true);
                versionSelect.select2({ width: 'resolve' });
                return;
            }

            versionSelect.prop('disabled', false);
            $.get(tenantUrl("/Subjects/SubjectOfferings/GetCurriculumVersionsByProgram"), { programId: programId }, function (data) {
                $.each(data, function (index, item) {
                    versionSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                });
                if (selectedId) versionSelect.val(selectedId);
                versionSelect.select2({ width: 'resolve' });
                refreshExistingSubjects();
            }).fail(function () {
                versionSelect.prop('disabled', true);
                versionSelect.select2({ width: 'resolve' });
            });
        }

        $("#ProgramId").change(function () {
            loadCurriculumVersions();
            loadSemestersAlpine();
        });

        $("#CurriculumVersionId").change(function () {
            loadSemestersAlpine();
        });

        $(function () {
            if (!$("#CurriculumVersionId").val()) {
                loadSemestersAlpine();
            }
        });
    </script>
}
