@model IEnumerable<FWU.Exam.Management.Domain.Entities.Subjects.SubjectOffering>
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Subject Offerings";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
    var searched = ViewBag.Searched == true;
    var resultCount = (int)(ViewBag.ResultCount ?? 0);
}

<div class="space-y-6" x-data="{ openExport: false }">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Subject Offerings</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    Filter by academic year, program and semester, then search to view subject offerings.
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative">
                <button x-on:click="openExport = !openExport"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-download text-xs"></i> Export
                </button>
                <div x-show="openExport"
                     x-on:click.away="openExport = false"
                     x-transition
                     class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                    <a asp-action="ExportToCsv" asp-area="Subjects"
                       asp-route-academicYearId="@(ViewBag.CurrentAcademicYearId as int?)"
                       asp-route-programId="@(ViewBag.CurrentProgramId as int?)"
                       asp-route-semesterId="@(ViewBag.CurrentSemesterId as int?)"
                       class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-csv text-blue-600"></i> Export CSV
                    </a>
                    <a asp-action="ExportToPdf" asp-area="Subjects"
                       asp-route-academicYearId="@(ViewBag.CurrentAcademicYearId as int?)"
                       asp-route-programId="@(ViewBag.CurrentProgramId as int?)"
                       asp-route-semesterId="@(ViewBag.CurrentSemesterId as int?)"
                       class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-pdf text-red-600"></i> Export PDF
                    </a>
                    <a asp-action="ExportToExcel" asp-area="Subjects"
                       asp-route-academicYearId="@(ViewBag.CurrentAcademicYearId as int?)"
                       asp-route-programId="@(ViewBag.CurrentProgramId as int?)"
                       asp-route-semesterId="@(ViewBag.CurrentSemesterId as int?)"
                       class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-excel text-green-600"></i> Export Excel
                    </a>
                </div>
            </div>
            @if (HasPerm("subjectofferings.create"))
            {
                <a asp-action="Create" asp-area="Subjects" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" asp-area="Subjects" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Academic Year</label>
                <select id="AcademicYearId" name="academicYearId" asp-items="ViewBag.AcademicYearId"
                        class="select2 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">-- Select Academic Year --</option>
                </select>
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Program</label>
                <select id="ProgramId" name="programId"
                        class="select2 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">-- Select Program --</option>
                </select>
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Semester</label>
                <select id="SemesterId" name="semesterId"
                        class="select2 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">-- Select Semester --</option>
                </select>
            </div>
            <div class="flex items-end gap-2">
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-search text-xs"></i> Search
                </button>
                <a asp-action="Index" asp-area="Subjects"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
                    <i class="fas fa-undo text-xs"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <div>
        @if (searched)
        {
            <div class="mb-3 flex items-center justify-between">
                <p class="text-sm text-gray-600"><span class="font-semibold text-gray-800">@resultCount</span> subject(s) found.</p>
            </div>
            @await Html.PartialAsync("_SearchResults", Model)
        }
        else
        {
            <div class="text-center py-16 text-gray-400 text-sm bg-white rounded-xl shadow-sm border border-gray-200">
                <i class="fas fa-search text-4xl mb-3 opacity-40"></i>
                <p>Select filters and click Search to view subject offerings.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #6366f1;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
        }
    </style>

    <script>
        var initialProgramId = '@(ViewBag.InitialProgramId ?? 0)';
        var initialSemesterId = '@(ViewBag.InitialSemesterId ?? 0)';

        function initSelect2(selector) {
            if ($(selector).hasClass('select2-hidden-accessible')) {
                $(selector).select2('destroy');
            }
            $(selector).select2({ width: 'resolve' });
        }

        function loadSemesters(programId, academicYearId, preferredSemesterId) {
            if (!programId || !academicYearId) {
                $('#SemesterId').html('<option value="">-- Select Semester --</option>');
                initSelect2('#SemesterId');
                return;
            }

            $.getJSON(tenantUrl("/Subjects/SubjectOfferings/GetSemestersByProgram"), { programId: programId, academicYearId: academicYearId }, function (data) {
                var html = '<option value="">-- Select Semester --</option>' + data.map(function (s) {
                    return '<option value="' + s.semesterId + '">' + s.semesterName + '</option>';
                }).join('');
                $('#SemesterId').html(html);
                initSelect2('#SemesterId');

                if (preferredSemesterId && data.some(function (s) { return s.semesterId == preferredSemesterId; })) {
                    $('#SemesterId').val(String(preferredSemesterId));
                }
            }).fail(function () {
                $('#SemesterId').html('<option value="">-- Select Semester --</option>');
                initSelect2('#SemesterId');
            });
        }

        function loadPrograms(academicYearId, preferredProgramId, preferredSemesterId) {
            $('#ProgramId').html('<option value="">-- Select Program --</option>');
            initSelect2('#ProgramId');
            $('#SemesterId').html('<option value="">-- Select Semester --</option>');
            initSelect2('#SemesterId');

            if (!academicYearId) return;

            $.getJSON(tenantUrl("/Subjects/SubjectOfferings/GetProgramsByAcademicYear"), { academicYearId: academicYearId }, function (data) {
                var html = '<option value="">-- Select Program --</option>' + data.map(function (p) {
                    return '<option value="' + p.programId + '">' + p.programName + '</option>';
                }).join('');
                $('#ProgramId').html(html);
                initSelect2('#ProgramId');

                var target = null;
                if (preferredProgramId && data.some(function (p) { return p.programId == preferredProgramId; })) {
                    target = preferredProgramId;
                }
                if (target) {
                    $('#ProgramId').val(String(target));
                    loadSemesters(target, academicYearId, preferredSemesterId);
                }
            }).fail(function () {
                $('#ProgramId').html('<option value="">-- Select Program --</option>');
                initSelect2('#ProgramId');
            });
        }

        function archiveRecord(id) {
            if (!confirm('Are you sure you want to archive this subject offering? It will no longer appear in active listings.')) return;

            $.ajax({
                url: '@Url.Action("ArchiveAjax", "SubjectOfferings")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('An error occurred while archiving.');
                }
            });
        }

        $(function () {
            initSelect2('#AcademicYearId');
            initSelect2('#ProgramId');
            initSelect2('#SemesterId');

            $('#AcademicYearId').change(function () {
                var ay = $(this).val();
                loadPrograms(ay, null, null);
            });

            $('#ProgramId').change(function () {
                var pid = $(this).val();
                var ay = $('#AcademicYearId').val();
                loadSemesters(pid, ay, null);
            });

            var ay = $('#AcademicYearId').val();
            if (ay) {
                loadPrograms(ay, initialProgramId, initialSemesterId);
            }
        });
    </script>
}
