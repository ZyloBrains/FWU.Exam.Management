@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Subject Offerings";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6" x-data="{ openExport: false }">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Subject Offerings</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    Browse subjects by Academic Year → Program → Semester.
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative">
                <button x-on:click="openExport = !openExport"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-download text-xs"></i> Export
                </button>
                <div x-show="openExport"
                     x-on:click.away="openExport = false"
                     x-transition
                     class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                    <a asp-action="ExportToCsv" asp-area="Subjects"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-csv text-blue-600"></i> Export CSV
                    </a>
                    <a asp-action="ExportToPdf" asp-area="Subjects"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-pdf text-red-600"></i> Export PDF
                    </a>
                    <a asp-action="ExportToExcel" asp-area="Subjects"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-excel text-green-600"></i> Export Excel
                    </a>
                </div>
            </div>
            @if (HasPerm("subjectofferings.create"))
            {
                <a asp-action="Create" asp-area="Subjects" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Academic Year</label>
        <select id="AcademicYearId" asp-items="ViewBag.AcademicYearId"
                class="select2 w-full max-w-sm border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="">-- Select Academic Year --</option>
        </select>
    </div>

    <div class="flex flex-col lg:flex-row gap-4">
        <aside class="lg:w-72 lg:shrink-0 space-y-3">
            <div class="relative">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input id="programSearch" type="text" placeholder="Search programs..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div id="programList"
                 class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 max-h-[600px] lg:max-h-[72vh] overflow-y-auto divide-y divide-gray-100">
                <div class="p-4 text-sm text-gray-400">Loading programs...</div>
            </div>
            <select id="programSelectMobile" class="lg:hidden w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <option value="">-- Select Program --</option>
            </select>
        </aside>

        <main class="flex-1 min-w-0">
            <div id="mainPane">
                <div class="text-center py-16 text-gray-400 text-sm bg-white rounded-xl shadow-sm border border-gray-200">
                    <i class="fas fa-list-alt text-4xl mb-3 opacity-40"></i>
                    <p>Select an academic year, a program, then a semester to view its subject offerings.</p>
                </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #6366f1;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
        }
    </style>

    <script>
        var currentProgramId = null;
        var currentSemesterId = null;
        var initialProgramId = '@(ViewBag.InitialProgramId ?? 0)';
        var initialSemesterId = '@(ViewBag.InitialSemesterId ?? 0)';

        function emptyPane() {
            return '<div class="text-center py-16 text-gray-400 text-sm bg-white rounded-xl shadow-sm border border-gray-200">' +
                '<i class="fas fa-list-alt text-4xl mb-3 opacity-40"></i>' +
                '<p>Select a program and semester to view its subject offerings.</p></div>';
        }

        function scrollToPane() {
            var pane = document.getElementById('mainPane');
            if (pane) pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function loadPrograms(academicYearId, preferredProgramId, preferredSemesterId) {
            currentProgramId = null;
            currentSemesterId = null;
            $('#programList').html('<div class="p-4 text-sm text-gray-400">Loading programs...</div>');
            $('#programSelectMobile').html('<option value="">-- Select Program --</option>');

            if (!academicYearId) {
                $('#programList').html('<div class="p-4 text-sm text-gray-400">Select an academic year first.</div>');
                $('#mainPane').html(emptyPane());
                return;
            }

            $.get(tenantUrl("/Subjects/SubjectOfferings/GetProgramsByAcademicYear"), { academicYearId: academicYearId }, function (data) {
                if (!data.length) {
                    $('#programList').html('<div class="p-4 text-sm text-gray-400">No programs with subject offerings for this year.</div>');
                    $('#programSelectMobile').html('<option value="">-- No Programs --</option>');
                    $('#mainPane').html(emptyPane());
                    return;
                }

                var itemsHtml = data.map(function (p) {
                    return '<button type="button" data-program-id="' + p.programId + '" class="w-full text-left px-4 py-3 hover:bg-indigo-50 transition-colors program-item" onclick="loadSemesters(' + p.programId + ', null, true)">' +
                        '<div class="flex items-center justify-between gap-2">' +
                        '<div class="min-w-0">' +
                        '<div class="text-sm font-medium text-gray-800 truncate">' + p.programName + '</div>' +
                        '<div class="text-xs text-gray-400">' + p.semesterCount + ' semester(s) · ' + p.subjectCount + ' subject(s)</div>' +
                        '</div>' +
                        '<i class="fas fa-chevron-right text-[10px] text-gray-300"></i>' +
                        '</div></button>';
                }).join('');

                $('#programList').html(itemsHtml);
                $('#programSelectMobile').html('<option value="">-- Select Program --</option>' +
                    data.map(function (p) {
                        return '<option value="' + p.programId + '">' + p.programName + ' (' + p.subjectCount + ')</option>';
                    }).join(''));
                filterPrograms();

                var target = null;
                if (preferredProgramId && data.some(function (p) { return p.programId == preferredProgramId; })) {
                    target = preferredProgramId;
                } else if (data.length) {
                    target = data[0].programId;
                }
                if (target) loadSemesters(target, preferredSemesterId, false);
            });
        }

        function filterPrograms() {
            var q = $('#programSearch').val().toLowerCase().trim();
            $('#programList .program-item').each(function () {
                var show = !q || $(this).text().toLowerCase().indexOf(q) !== -1;
                $(this).toggle(show);
            });
        }

        function semesterCardsPane(programName, semesters) {
            var cards = semesters.map(function (s) {
                return '<button type="button" data-semester-id="' + s.semesterId + '" class="semester-item group text-left bg-white rounded-xl shadow-sm border border-gray-200 p-4 hover:border-indigo-300 hover:shadow transition-colors" onclick="loadSubjects(' + currentProgramId + ', ' + s.semesterId + ', true)">' +
                    '<div class="flex items-center justify-between">' +
                    '<div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center">' +
                    '<i class="fas fa-book-open text-indigo-600 text-xs"></i>' +
                    '</div>' +
                    '<span class="text-[11px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full">Sem ' + s.semesterNumber + '</span>' +
                    '</div>' +
                    '<p class="text-sm font-semibold text-gray-800 mt-2 truncate">' + (s.semesterName || 'Semester ' + s.semesterNumber) + '</p>' +
                    '<p class="text-xs text-gray-400 mt-0.5">' + s.subjectCount + ' subject(s)</p>' +
                    '</button>';
            }).join('');

            return '<div class="space-y-4">' +
                '<div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4 flex items-center gap-3">' +
                '<div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-building text-indigo-600 text-xs"></i></div>' +
                '<div>' +
                '<h2 class="text-sm font-bold text-gray-800">' + programName + '</h2>' +
                '<p class="text-xs text-gray-500">Select a semester to view its subject offerings.</p>' +
                '</div>' +
                '</div>' +
                '<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">' + cards + '</div>' +
                '</div>';
        }

        function loadSemesters(programId, preferredSemesterId, scrollToContent) {
            currentProgramId = programId;
            currentSemesterId = null;
            $('.program-item').removeClass('bg-indigo-50 border-l-4 border-indigo-500');
            $('.program-item[data-program-id="' + programId + '"]').addClass('bg-indigo-50 border-l-4 border-indigo-500');
            $('#programSelectMobile').val(programId);

            $('#mainPane').html('<div class="text-center py-16 text-gray-400 text-sm"><i class="fas fa-spinner fa-spin text-2xl mb-2 block text-gray-300"></i>Loading semesters...</div>');

            var ay = $('#AcademicYearId').val();
            if (history.replaceState) history.replaceState(null, '', ay ? '?academicYearId=' + ay + '&programId=' + programId : '?');

            $.get(tenantUrl("/Subjects/SubjectOfferings/GetSemestersByProgram"), { programId: programId, academicYearId: ay }, function (data) {
                if (!data.length) {
                    $('#mainPane').html('<div class="text-center py-16 text-gray-500 bg-white rounded-xl shadow-sm border border-gray-200">' +
                        '<i class="fas fa-book-open text-4xl mb-3 opacity-50"></i>' +
                        '<p>No semesters with subject offerings for this program.</p></div>');
                    if (scrollToContent) scrollToPane();
                    return;
                }

                var programName = $('.program-item[data-program-id="' + programId + '"]').find('.text-sm.font-medium').text() || 'Program';
                $('#mainPane').html(semesterCardsPane(programName, data));
                if (scrollToContent) scrollToPane();

                var target = null;
                if (preferredSemesterId && data.some(function (s) { return s.semesterId == preferredSemesterId; })) {
                    target = preferredSemesterId;
                }
                if (target) loadSubjects(programId, target, false);
            }).fail(function () {
                $('#mainPane').html('<div class="text-center py-12 text-red-500 text-sm">Failed to load semesters.</div>');
            });
        }

        function loadSubjects(programId, semesterId, scrollToContent) {
            currentProgramId = programId;
            currentSemesterId = semesterId;
            $('.semester-item').removeClass('border-indigo-500 ring-1 ring-indigo-200 bg-indigo-50');
            $('.semester-item[data-semester-id="' + semesterId + '"]').addClass('border-indigo-500 ring-1 ring-indigo-200 bg-indigo-50');

            $('#mainPane').html('<div class="text-center py-16 text-gray-400 text-sm"><i class="fas fa-spinner fa-spin text-2xl mb-2 block text-gray-300"></i>Loading subjects...</div>');

            $.get(tenantUrl("/Subjects/SubjectOfferings/GetProgramSubjects"), { programId: programId, semesterId: semesterId }, function (html) {
                var backBar = '<div class="mb-3">' +
                    '<button onclick="loadSemesters(' + programId + ', null, true)" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">' +
                    '<i class="fas fa-arrow-left text-xs"></i> All Semesters</button>' +
                    '</div>';
                $('#mainPane').html(backBar + html);
                if (scrollToContent) scrollToPane();
            }).fail(function () {
                $('#mainPane').html('<div class="text-center py-12 text-red-500 text-sm">Failed to load subjects.</div>');
            });

            var ay = $('#AcademicYearId').val();
            if (history.replaceState) history.replaceState(null, '', ay ? '?academicYearId=' + ay + '&programId=' + programId + '&semesterId=' + semesterId : '?');
        }

        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;

            $.ajax({
                url: '@Url.Action("DeleteAjax", "SubjectOfferings")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        if (currentProgramId && currentSemesterId) {
                            loadSubjects(currentProgramId, currentSemesterId);
                        } else {
                            location.reload();
                        }
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('An error occurred while deleting.');
                }
            });
        }

        $(function () {
            $('#AcademicYearId').select2({ width: 'resolve' });

            $('#AcademicYearId').change(function () {
                var ay = $(this).val();
                loadPrograms(ay, null, null);
                if (history.replaceState) history.replaceState(null, '', ay ? '?academicYearId=' + ay : '?');
            });

            $('#programSelectMobile').change(function () {
                var pid = $(this).val();
                if (pid) loadSemesters(pid, null, true);
            });

            $('#programSearch').on('input', function () {
                filterPrograms();
            });

            var ay = $('#AcademicYearId').val();
            if (ay) {
                loadPrograms(ay, initialProgramId, initialSemesterId);
            } else {
                $('#programList').html('<div class="p-4 text-sm text-gray-400">Select an academic year first.</div>');
            }
        });
    </script>
}
