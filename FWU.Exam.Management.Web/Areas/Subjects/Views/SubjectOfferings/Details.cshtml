@model FWU.Exam.Management.Domain.Entities.Subjects.SubjectOffering
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);

    ViewData["Title"] = "Subject Offering Details";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-blue-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Subject Offering Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Subject</p>
                <p class="mt-1 text-gray-800 font-semibold">@(Model.SubjectCatalog?.SubjectName ?? "-")</p>
                <p class="text-xs text-gray-500">@(Model.SubjectCatalog?.SubjectCode ?? "")</p>
            </div>
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Program</p>
                <p class="mt-1 text-gray-800">@(Model.Program?.ProgramName ?? "-")</p>
            </div>
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Semester</p>
                <p class="mt-1 text-gray-800">@(Model.Semester?.Name ?? "-")</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Display Order</p>
                <p class="mt-1 text-gray-800">@Model.DisplayOrder</p>
            </div>
            <div>
                <p class="text-xs sm:text-sm font-medium text-gray-600">Type</p>
                <div class="mt-1">
                    @if (Model.IsCompulsory)
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-blue-100 text-blue-700 rounded-full">Compulsory</span>
                    }
                    else
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded-full">Elective</span>
                    }
                </div>
            </div>
        </div>

        <div class="border-t border-gray-200 pt-6">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Evaluation Breakdown</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="border border-gray-200 rounded-lg p-4 @(Model.HasTheory ? "bg-green-50" : "bg-gray-50")">
                    <div class="flex items-center gap-2 mb-3">
                        <h4 class="text-sm font-semibold text-gray-700">Theory</h4>
                        @if (Model.HasTheory)
                        {
                            <span class="px-2 py-0.5 text-xs bg-green-100 text-green-700 rounded-full">Enabled</span>
                        }
                        else
                        {
                            <span class="px-2 py-0.5 text-xs bg-gray-200 text-gray-500 rounded-full">Disabled</span>
                        }
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                        <div>
                            <p class="text-xs text-gray-500">Full Marks</p>
                            <p class="font-medium">@Model.TheoryFullMarks</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500">Pass Marks</p>
                            <p class="font-medium">@Model.TheoryPassMarks</p>
                        </div>
                    </div>
                </div>

                <div class="border border-gray-200 rounded-lg p-4 @(Model.HasPractical ? "bg-blue-50" : "bg-gray-50")">
                    <div class="flex items-center gap-2 mb-3">
                        <h4 class="text-sm font-semibold text-gray-700">Practical</h4>
                        @if (Model.HasPractical)
                        {
                            <span class="px-2 py-0.5 text-xs bg-blue-100 text-blue-700 rounded-full">Enabled</span>
                        }
                        else
                        {
                            <span class="px-2 py-0.5 text-xs bg-gray-200 text-gray-500 rounded-full">Disabled</span>
                        }
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                        <div>
                            <p class="text-xs text-gray-500">Full Marks</p>
                            <p class="font-medium">@(Model.PracticalFullMarks ?? 0)</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500">Pass Marks</p>
                            <p class="font-medium">@(Model.PracticalPassMarks ?? 0)</p>
                        </div>
                    </div>
                </div>

                <div class="border border-gray-200 rounded-lg p-4 @(Model.HasInternal ? "bg-purple-50" : "bg-gray-50")">
                    <div class="flex items-center gap-2 mb-3">
                        <h4 class="text-sm font-semibold text-gray-700">Internal</h4>
                        @if (Model.HasInternal)
                        {
                            <span class="px-2 py-0.5 text-xs bg-purple-100 text-purple-700 rounded-full">Enabled</span>
                        }
                        else
                        {
                            <span class="px-2 py-0.5 text-xs bg-gray-200 text-gray-500 rounded-full">Disabled</span>
                        }
                    </div>
                    <div class="text-sm">
                        <div class="grid grid-cols-2 gap-2 mb-2">
                            <p class="text-xs text-gray-500">Theory: @(Model.InternalTheoryFullMarks ?? 0)/@(Model.InternalTheoryPassMarks ?? 0)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (HasPerm("subjectofferings.edit"))
            {
                <a asp-action="Edit" asp-area="Subjects" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
