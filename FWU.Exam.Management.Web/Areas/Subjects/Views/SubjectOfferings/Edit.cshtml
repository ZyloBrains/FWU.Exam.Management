@model FWU.Exam.Management.Domain.Entities.Subjects.SubjectOffering

@{
    ViewData["Title"] = "Edit Subject Offering";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-amber-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Edit Subject Offering</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TenantId" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="border-b border-gray-200 pb-4 mb-2">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Basic Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
                    <div>
                        <label asp-for="SubjectCatalogId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Subject</label>
                        <select asp-for="SubjectCatalogId" asp-items="ViewBag.SubjectCatalogId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                            <option value="">-- Select Subject --</option>
                        </select>
                        <span asp-validation-for="SubjectCatalogId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ProgramId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Program</label>
                        <select asp-for="ProgramId" asp-items="ViewBag.ProgramId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                            <option value="">-- Select Program --</option>
                        </select>
                        <span asp-validation-for="ProgramId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Academic Year</label>
                        <select id="AcademicYearId" name="academicYearId" asp-items="ViewBag.AcademicYearId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                            <option value="">-- Select Academic Year --</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="SemesterId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Semester</label>
                        <select asp-for="SemesterId" asp-items="ViewBag.SemesterId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                            <option value="">-- Select Semester --</option>
                        </select>
                        <span asp-validation-for="SemesterId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-4">
                    <div>
                        <label asp-for="DisplayOrder" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" min="1" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" />
                        <span asp-validation-for="DisplayOrder" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="flex items-center gap-6 pt-6">
                        <div class="flex items-center gap-2">
                            <input asp-for="IsCompulsory" type="checkbox" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                            <label asp-for="IsCompulsory" class="text-xs sm:text-sm font-medium text-gray-700">Compulsory</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-b border-gray-200 pb-4">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Evaluation Components</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                        <div class="flex items-center gap-2 mb-3">
                            <input asp-for="HasTheory" type="checkbox" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                            <label asp-for="HasTheory" class="text-sm font-semibold text-gray-700">Theory</label>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label asp-for="TheoryFullMarks" class="text-xs text-gray-500 block mb-1">Full Marks</label>
                                <input asp-for="TheoryFullMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="TheoryFullMarks" class="text-xs text-red-500 block"></span>
                            </div>
                            <div>
                                <label asp-for="TheoryPassMarks" class="text-xs text-gray-500 block mb-1">Pass Marks</label>
                                <input asp-for="TheoryPassMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="TheoryPassMarks" class="text-xs text-red-500 block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                        <div class="flex items-center gap-2 mb-3">
                            <input asp-for="HasPractical" type="checkbox" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                            <label asp-for="HasPractical" class="text-sm font-semibold text-gray-700">Practical</label>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label asp-for="PracticalFullMarks" class="text-xs text-gray-500 block mb-1">Full Marks</label>
                                <input asp-for="PracticalFullMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="PracticalFullMarks" class="text-xs text-red-500 block"></span>
                            </div>
                            <div>
                                <label asp-for="PracticalPassMarks" class="text-xs text-gray-500 block mb-1">Pass Marks</label>
                                <input asp-for="PracticalPassMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="PracticalPassMarks" class="text-xs text-red-500 block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                        <div class="flex items-center gap-2 mb-3">
                            <input asp-for="HasInternal" type="checkbox" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                            <label asp-for="HasInternal" class="text-sm font-semibold text-gray-700">Internal</label>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label asp-for="InternalTheoryFullMarks" class="text-xs text-gray-500 block mb-1">Theory Full</label>
                                <input asp-for="InternalTheoryFullMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="InternalTheoryFullMarks" class="text-xs text-red-500 block"></span>
                            </div>
                            <div>
                                <label asp-for="InternalTheoryPassMarks" class="text-xs text-gray-500 block mb-1">Theory Pass</label>
                                <input asp-for="InternalTheoryPassMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="InternalTheoryPassMarks" class="text-xs text-red-500 block"></span>
                            </div>
                            <div>
                                <label asp-for="InternalPracticalFullMarks" class="text-xs text-gray-500 block mb-1">Practical Full</label>
                                <input asp-for="InternalPracticalFullMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="InternalPracticalFullMarks" class="text-xs text-red-500 block"></span>
                            </div>
                            <div>
                                <label asp-for="InternalPracticalPassMarks" class="text-xs text-gray-500 block mb-1">Practical Pass</label>
                                <input asp-for="InternalPracticalPassMarks" type="number" step="0.5" min="0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
                                <span asp-validation-for="InternalPracticalPassMarks" class="text-xs text-red-500 block"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #f59e0b;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(245,158,11,0.2);
        }
    </style>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () { $('.select2').select2({ width: 'resolve' }); });

        function loadSemesters(academicYearId, programId) {
            $('#SemesterId').select2('destroy');
            var semesterDropdown = $("#SemesterId");
            semesterDropdown.empty().append('<option value="">-- Select Semester --</option>');

            if (!academicYearId) {
                semesterDropdown.prop('disabled', true);
                $('#SemesterId').select2({ width: 'resolve' });
                return;
            }

            $.get(tenantUrl("/Subjects/SubjectOfferings/GetSemestersByAcademicYear"), { academicYearId: academicYearId, programId: programId }, function (data) {
                $.each(data, function (index, item) {
                    semesterDropdown.append('<option value="' + item.id + '">' + item.name + '</option>');
                });
                var initialSemesterId = '@Model.SemesterId';
                if (initialSemesterId) semesterDropdown.val(initialSemesterId);
                semesterDropdown.prop('disabled', false);
                semesterDropdown.select2({ width: 'resolve' });
            });
        }

        $("#AcademicYearId").change(function () {
            loadSemesters($(this).val(), $("#ProgramId").val());
        });

        $("#ProgramId").change(function () {
            if ($("#AcademicYearId").val()) {
                loadSemesters($("#AcademicYearId").val(), $(this).val());
            }
        });

        loadSemesters($("#AcademicYearId").val(), $("#ProgramId").val());
    </script>
}
