@model FWU.Exam.Management.Domain.Entities.Subjects.SubjectType

@{
    ViewData["Title"] = "Create Subject Type";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-fuchsia-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-tags text-fuchsia-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Subject Type</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Code" class="text-sm font-medium text-gray-700 block mb-1">Code <span class="text-red-500">*</span></label>
                    <input asp-for="Code" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-fuchsia-500 focus:border-fuchsia-500" placeholder="e.g., CORE, ELEC, THY, PRAC" />
                    <span asp-validation-for="Code" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="MaxAllowedSubjects" class="text-sm font-medium text-gray-700 block mb-1">Max Allowed Subjects</label>
                    <input asp-for="MaxAllowedSubjects" type="number" min="1" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-fuchsia-500 focus:border-fuchsia-500" placeholder="e.g., 10, 20, 30" />
                    <span asp-validation-for="MaxAllowedSubjects" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Name" class="text-sm font-medium text-gray-700 block mb-1">Subject Type Name <span class="text-red-500">*</span></label>
                    <input asp-for="Name" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-fuchsia-500 focus:border-fuchsia-500" placeholder="e.g., Core Subject, Elective, Theory, Practical" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsDefault" type="checkbox" class="w-4 h-4 text-fuchsia-600 rounded focus:ring-fuchsia-500" />
                        <label asp-for="IsDefault" class="text-sm font-medium text-gray-700">Set as Default</label>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Only one subject type can be default at a time.</p>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsActive" type="checkbox" checked="checked" class="w-4 h-4 text-fuchsia-600 rounded focus:ring-fuchsia-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-fuchsia-500 text-white text-sm font-semibold rounded-lg hover:bg-fuchsia-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
