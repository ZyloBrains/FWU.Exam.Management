@model ReportFilterViewModel
@{
    ViewData["Title"] = "Bank Voucher List Report";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="text-gray-400 hover:text-gray-600 transition-colors">
            <i class="fas fa-arrow-left text-lg"></i>
        </a>
        <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-file-invoice-dollar text-cyan-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Bank Voucher List</h1>
            <p class="text-xs sm:text-sm text-gray-500">Bank voucher listing report</p>
        </div>
    </div>

    <partial name="_ReportFilter" model="Model" />

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-file-invoice-dollar text-gray-400 text-2xl"></i>
        </div>
        <h3 class="text-base sm:text-lg font-semibold text-gray-700 mb-2">Bank Voucher List Report</h3>
        <p class="text-gray-500 text-xs sm:text-sm max-w-md mx-auto">
            Select filters above and click "Generate Report" to view bank voucher details including voucher numbers, amounts, banks, colleges, and payment dates.
        </p>
    </div>
</div>
