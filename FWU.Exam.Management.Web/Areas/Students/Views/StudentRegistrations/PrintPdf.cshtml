@{
    Layout = null;
    var totalCount = ViewBag.TotalCount ?? 0;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Student Registrations Report</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11px;
            padding: 20px;
            color: #333;
        }
        .header { margin-bottom: 20px; border-bottom: 2px solid #0d9488; padding-bottom: 10px; }
        .header h1 { color: #0d9488; font-size: 20px; margin-bottom: 6px; }
        .report-info { color: #666; font-size: 11px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 6px 8px; text-align: left; }
        th { background-color: #f3f4f6; font-weight: 600; font-size: 10px; text-transform: uppercase; color: #555; }
        tr:nth-child(even) { background-color: #fafafa; }
        td { font-size: 11px; }
        .badge { padding: 2px 6px; border-radius: 9999px; font-size: 10px; font-weight: 500; }
        .badge-green { background: #d1fae5; color: #065f46; }
        .badge-red { background: #fee2e2; color: #991b1b; }
        .badge-yellow { background: #fef3c7; color: #92400e; }
        .footer { margin-top: 30px; text-align: center; font-size: 10px; color: #999; border-top: 1px solid #eee; padding-top: 10px; }
        @@media print {
            body { padding: 0; font-size: 10px; }
            .no-print { display: none !important; }
            table { page-break-inside: auto; }
            tr { page-break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="no-print" style="margin-bottom: 15px; text-align: right;">
        <button onclick="window.print()" style="padding: 8px 20px; background: #0d9488; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 13px;">
            Print / Save as PDF
        </button>
    </div>

    <div class="header">
        <h1>Student Registrations Report</h1>
        <div class="report-info">
            <p>Generated on: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") &nbsp; | &nbsp; Total Records: @totalCount</p>
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <p>Search Filter: @searchTerm</p>
            }
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width:35px">#</th>
                <th>Reg No</th>
                <th>Student Name</th>
                <th>Academic Year</th>
                <th>Faculty</th>
                <th>Contact</th>
                <th>Email</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{ int serial = 1; }
            @if (Model != null)
            {
                @foreach (dynamic item in Model)
                {
                    <tr>
                        <td>@serial</td>
                        <td>@item.RegistrationNumber</td>
                        <td>@item.FullName</td>
                        <td>@item.AcademicYear</td>
                        <td>@item.Faculty</td>
                        <td>@item.ContactNumber</td>
                        <td>@item.Email</td>
                        <td>
                            @{
                                var status = (string)(item.Status ?? "Pending");
                                var badgeClass = status == "Approved" ? "badge-green" : status == "Rejected" ? "badge-red" : "badge-yellow";
                            }
                            <span class="badge @badgeClass">@status</span>
                        </td>
                    </tr>
                    serial++;
                }
            }
        </tbody>
    </table>

    @if (Model == null || serial == 1)
    {
        <p style="text-align: center; color: #999; margin-top: 20px;">No records found.</p>
    }

    <div class="footer">
        <p>This is a system-generated report. &mdash; FWU Examination Management System</p>
    </div>

    <script>
        window.onload = function () { window.print(); };
    </script>
</body>
</html>