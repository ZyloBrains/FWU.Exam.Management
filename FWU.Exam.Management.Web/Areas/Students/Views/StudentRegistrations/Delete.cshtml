@model StudentRegistration

@{
    ViewData["Title"] = "Delete Student Registration";
}

<h1 class="text-xl sm:text-2xl font-bold text-gray-800 mb-1">Delete Student Registration</h1>
<p class="text-sm text-red-600 mb-4">Are you sure you want to delete this?</p>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6 max-w-lg">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">@Model?.FirstName @Model?.LastName</h2>

    <div class="space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.RegistrationNumber)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.RegistrationNumber)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.FirstName)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.FirstName)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.LastName)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.LastName)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.Email)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.Email)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.ContactNumber)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.ContactNumber)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.Level)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.Level.LevelName)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.Faculty)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.Faculty.Name)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.Program)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.Program.ProgramName)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.College)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.College.Name)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.AcademicYear)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.AcademicYear.AcademicYearName)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.StudentCategory)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.StudentCategory.StudentCategoryName)</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <span class="text-xs font-semibold text-gray-500 uppercase sm:w-36 shrink-0">@Html.DisplayNameFor(model => model.IsActive)</span>
            <span class="text-sm text-gray-900">@Html.DisplayFor(model => model.IsActive)</span>
        </div>
    </div>

    <form asp-action="Delete" class="flex items-center gap-3 mt-6 pt-4 border-t border-gray-100">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="px-6 py-2.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors shadow-sm">
            Delete
        </button>
        <a asp-action="Index" class="px-6 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
            Back to List
        </a>
    </form>
</div>
