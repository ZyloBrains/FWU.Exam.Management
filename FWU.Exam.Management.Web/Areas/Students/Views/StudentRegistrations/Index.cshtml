@{
    ViewData["Title"] = "Student Registrations";
}

<div class="space-y-6" x-data="{ openExport: false, showFilters: false }">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-user-graduate text-teal-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Student Registrations</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage student directories, search records, and bulk import new data.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> New Registration
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <!-- Search & Filter Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <!-- Row 1: Search Box + Actions -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input id="searchBox" type="search" placeholder="Search by name, registration no, email, phone..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
            </div>
            <div class="flex items-center gap-2">
                <button type="button" x-on:click="showFilters = !showFilters"
                        :class="showFilters ? 'bg-teal-50 text-teal-700 border-teal-200' : 'bg-white text-gray-700 border-gray-200'"
                        class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium border rounded-lg hover:bg-gray-50 transition-colors">
                    <i class="fas fa-filter text-xs"></i> Filters
                    <span x-show="activeFilterCount > 0" x-text="activeFilterCount"
                          class="ml-1 inline-flex items-center justify-center w-5 h-5 text-xs font-bold text-white bg-teal-500 rounded-full"></span>
                </button>
                @await Html.PartialAsync("_ExportDropdown", new ExportDropdownModel
                {
                    ButtonClass = "bg-teal-600 hover:bg-teal-700",
                    ScopeLabel = " (All)",
                    JavascriptCallbacks = new Dictionary<string, string>
                    {
                        ["csv"] = "exportCsv()",
                        ["pdf"] = "exportPdf()",
                        ["excel"] = "exportExcel()"
                    }
                })
            </div>
        </div>

        <!-- Row 2: Filter Dropdowns (Collapsible) -->
        <div x-show="showFilters" x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 -translate-y-2"
             class="mt-4 pt-4 border-t border-gray-200">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Academic Year</label>
                    <select id="filterAcademicYear" class="filter-select w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                        <option value="">All Years</option>
                        @if (ViewBag.AcademicYears is SelectList ayList)
                        {
                            foreach (var item in ayList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Faculty</label>
                    <select id="filterFaculty" class="filter-select w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                        <option value="">All Faculties</option>
                        @if (ViewBag.Faculties is SelectList fList)
                        {
                            foreach (var item in fList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">College</label>
                    <select id="filterCollege" class="filter-select w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                        <option value="">All Colleges</option>
                        @if (ViewBag.Colleges is SelectList cList)
                        {
                            foreach (var item in cList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Level</label>
                    <select id="filterLevel" class="filter-select w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                        <option value="">All Levels</option>
                        @if (ViewBag.Levels is SelectList lList)
                        {
                            foreach (var item in lList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Program</label>
                    <select id="filterProgram" class="filter-select w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                        <option value="">All Programs</option>
                        @if (ViewBag.Programs is SelectList pList)
                        {
                            foreach (var item in pList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Status</label>
                    <select id="filterStatus" class="filter-select w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between mt-3 gap-3">
                <div class="flex items-center gap-2 text-xs text-gray-400">
                    <i class="fas fa-info-circle"></i>
                    <span>Filters apply automatically when changed</span>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <form asp-action="ImportExcel" method="post" enctype="multipart/form-data" class="flex items-center gap-2 bg-gray-50 p-1.5 rounded-lg border border-dashed border-gray-300">
                        <input type="file" name="file" accept=".xlsx" class="block w-full text-xs text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-white file:text-gray-700 file:ring-1 file:ring-gray-300 hover:file:bg-gray-50 transition cursor-pointer" required />
                        <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-800 text-white rounded-md text-xs font-medium hover:bg-gray-900 transition shrink-0">
                            <i class="fas fa-upload text-xs"></i> Import
                        </button>
                    </form>
                    <select id="pageSize" class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                        <option value="10">10 / page</option>
                        <option value="25">25 / page</option>
                        <option value="50" selected>50 / page</option>
                        <option value="9999">All</option>
                    </select>
                    <button type="button" x-on:click="clearAllFilters()"
                            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                        <i class="fas fa-times text-xs"></i> Clear All
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Reg No</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Student Name</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Academic Year</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Faculty</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Contact</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="registrationsBody" class="divide-y divide-gray-100">
                <tr>
                    <td colspan="8" class="px-4 py-20 text-center">
                        <div class="flex flex-col items-center justify-center">
                            <i class="fas fa-spinner fa-pulse text-2xl text-teal-600 mb-4"></i>
                            <span class="text-sm text-gray-500 font-medium">Loading registrations...</span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Mobile card layout -->
    <div class="lg:hidden space-y-3" id="mobileCardsContainer">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
            <i class="fas fa-spinner fa-pulse text-2xl text-teal-600 mb-3"></i>
            <p class="text-sm text-gray-500">Loading registrations...</p>
        </div>
    </div>

    <!-- Pagination -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
        <div class="text-sm text-gray-500 font-medium" id="summaryText">
            Showing <span class="font-semibold text-gray-900">0</span> to <span class="font-semibold text-gray-900">0</span> of <span class="font-semibold text-gray-900">0</span> entries
        </div>
        <div class="flex items-center justify-between sm:justify-end gap-2">
            <button id="prevPage" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-teal-500 disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm">
                <i class="fas fa-chevron-left text-xs"></i> Previous
            </button>
            <span class="text-sm font-semibold text-gray-700 min-w-[4rem] text-center" id="pageInfo">1 / 1</span>
            <button id="nextPage" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-teal-500 disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm">
                Next <i class="fas fa-chevron-right text-xs"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 34px; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; padding: 0.125rem 0; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding-left: 0.5rem; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 32px; }
    </style>
    <script>
        (function () {
            const searchBox = document.getElementById('searchBox');
            const pageSizeSelect = document.getElementById('pageSize');
            const prevBtn = document.getElementById('prevPage');
            const nextBtn = document.getElementById('nextPage');
            const pageInfo = document.getElementById('pageInfo');
            const summaryText = document.getElementById('summaryText');
            const tbody = document.getElementById('registrationsBody');
            const mobileContainer = document.getElementById('mobileCardsContainer');

            const filterAcademicYear = document.getElementById('filterAcademicYear');
            const filterFaculty = document.getElementById('filterFaculty');
            const filterCollege = document.getElementById('filterCollege');
            const filterLevel = document.getElementById('filterLevel');
            const filterProgram = document.getElementById('filterProgram');
            const filterStatus = document.getElementById('filterStatus');
            const filterSelects = [filterAcademicYear, filterFaculty, filterCollege, filterLevel, filterProgram, filterStatus];

            let page = 1;
            let pageSize = parseInt(pageSizeSelect.value, 10);
            let searchTimeout = null;
            let totalRecords = 0;

            const base = window.location.pathname.replace(/\/Students\/StudentRegistrations.*/, '');

            // Alpine.js active filter count
            window.activeFilterCount = 0;
            const updateFilterCount = () => {
                let count = 0;
                filterSelects.forEach(s => { if (s.value) count++; });
                window.activeFilterCount = count;
            };

            const getFilterParams = () => {
                const params = new URLSearchParams();
                params.append('searchTerm', searchBox.value.trim());
                params.append('page', page);
                params.append('pageSize', pageSize);
                if (filterAcademicYear.value) params.append('academicYear', filterAcademicYear.value);
                if (filterFaculty.value) params.append('facultyId', filterFaculty.value);
                if (filterCollege.value) params.append('collegeId', filterCollege.value);
                if (filterLevel.value) params.append('levelId', filterLevel.value);
                if (filterProgram.value) params.append('programId', filterProgram.value);
                if (filterStatus.value) params.append('status', filterStatus.value);
                return params.toString();
            };

            window.clearAllFilters = () => {
                searchBox.value = '';
                filterSelects.forEach(s => s.value = '');
                updateFilterCount();
                page = 1;
                loadData();
            };

            const showLoading = () => {
                tbody.innerHTML = `<tr><td colspan="8" class="px-4 py-20 text-center">
                    <div class="flex flex-col items-center justify-center">
                        <i class="fas fa-spinner fa-pulse text-2xl text-teal-600 mb-4"></i>
                        <span class="text-sm text-gray-500 font-medium">Loading registrations...</span>
                    </div>
                </td></tr>`;
                mobileContainer.innerHTML = `<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                    <i class="fas fa-spinner fa-pulse text-2xl text-teal-600 mb-3"></i>
                    <p class="text-sm text-gray-500">Loading registrations...</p>
                </div>`;
            };

            const loadData = async () => {
                showLoading();
                try {
                    const response = await fetch(`${base}/Students/StudentRegistrations/GetPagedData?${getFilterParams()}`);
                    const result = await response.json();
                    totalRecords = result.totalCount;
                    renderTable(result.data);
                    updatePagination();
                } catch (error) {
                    console.error('Error fetching data:', error);
                    tbody.innerHTML = '<tr><td colspan="8" class="px-4 py-12 text-center"><div class="flex flex-col items-center"><i class="fas fa-exclamation-triangle text-3xl text-red-400 mb-3"></i><span class="text-sm font-medium text-red-600 mb-1">Failed to load data</span><p class="text-xs text-gray-500">Please refresh the page and try again.</p></div></td></tr>';
                    mobileContainer.innerHTML = '<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center"><i class="fas fa-exclamation-triangle text-3xl text-red-400 mb-3"></i><span class="text-sm font-medium text-red-600 mb-1">Failed to load data</span><p class="text-xs text-gray-500">Please refresh the page and try again.</p></div>';
                }
            };

            const renderStatusBadge = (status) => {
                const cls = status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700';
                return `<span class="px-2 py-0.5 text-xs font-medium rounded-full ${cls}">${status || '-'}</span>`;
            };

            const renderActions = (item, isMobile) => {
                const approveReject = (item.status === 'Pending' || !item.status) ? `
                    <button onclick="event.stopPropagation(); window.updateRegStatus(${item.id}, 'Approved')" class="${isMobile ? 'flex-1 text-center py-2 text-xs font-medium text-green-700 bg-green-50 rounded-lg hover:bg-green-100' : 'p-1.5 text-green-600 hover:bg-green-50 rounded-md'}" title="Approve">
                        <i class="fas fa-check text-xs"></i>${isMobile ? ' Approve' : ''}
                    </button>
                    <button onclick="event.stopPropagation(); window.updateRegStatus(${item.id}, 'Rejected')" class="${isMobile ? 'flex-1 text-center py-2 text-xs font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100' : 'p-1.5 text-red-600 hover:bg-red-50 rounded-md'}" title="Reject">
                        <i class="fas fa-times text-xs"></i>${isMobile ? ' Reject' : ''}
                    </button>
                ` : '';
                return `
                    ${approveReject}
                    <a href="${base}/Students/StudentRegistrations/Details/${item.id}" onclick="event.stopPropagation()" class="${isMobile ? 'flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100' : 'p-1.5 text-blue-600 hover:bg-blue-50 rounded-md'}" title="Details">
                        <i class="fas fa-eye text-xs"></i>${isMobile ? ' Details' : ''}
                    </a>
                    <a href="${base}/Students/StudentRegistrations/Edit/${item.id}" onclick="event.stopPropagation()" class="${isMobile ? 'flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100' : 'p-1.5 text-amber-600 hover:bg-amber-50 rounded-md'}" title="Edit">
                        <i class="fas fa-edit text-xs"></i>${isMobile ? ' Edit' : ''}
                    </a>
                    <a href="javascript:void(0)" onclick="event.stopPropagation(); window.deleteStudentRegistration(${item.id})" class="${isMobile ? 'flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100' : 'p-1.5 text-red-600 hover:bg-red-50 rounded-md'}" title="Delete">
                        <i class="fas fa-trash text-xs"></i>${isMobile ? ' Delete' : ''}
                    </a>
                `;
            };

            const renderEmpty = () => `
                <tr><td colspan="8" class="px-4 py-20 text-center">
                    <div class="flex flex-col items-center justify-center">
                        <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                        <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                        <p class="text-sm text-gray-500">Try adjusting your search or filter criteria.</p>
                    </div>
                </td></tr>`;

            const renderEmptyMobile = () => `
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                    <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                    <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                    <p class="text-sm text-gray-500">Try adjusting your search or filter criteria.</p>
                </div>`;

            const renderTable = (items) => {
                if (items.length === 0) {
                    tbody.innerHTML = renderEmpty();
                    mobileContainer.innerHTML = renderEmptyMobile();
                    return;
                }

                tbody.innerHTML = items.map((item, index) => `
                    <tr class="hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location.href='${base}/Students/StudentRegistrations/Details/${item.id}'">
                        <td class="px-4 py-3 text-sm text-gray-500">${(page - 1) * pageSize + index + 1}</td>
                        <td class="px-4 py-3">
                            <span class="font-mono text-xs font-semibold text-gray-900 bg-gray-100 px-2 py-1 rounded">${item.registrationNumber || '-'}</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="font-medium text-gray-800 text-sm">${item.fullName || '-'}</div>
                        </td>
                        <td class="px-4 py-3 text-gray-600 text-sm">${item.academicYear || '-'}</td>
                        <td class="px-4 py-3 text-gray-600 text-sm">${item.faculty || '-'}</td>
                        <td class="px-4 py-3">
                            <div class="text-sm text-gray-600">${item.contactNumber || '-'}</div>
                            <div class="text-xs text-gray-400">${item.email || '-'}</div>
                        </td>
                        <td class="px-4 py-3">${renderStatusBadge(item.status)}</td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-1">${renderActions(item, false)}</div>
                        </td>
                    </tr>
                `).join('');

                mobileContainer.innerHTML = items.map((item, index) => `
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded">${(page - 1) * pageSize + index + 1}</span>
                                <div>
                                    <h3 class="font-semibold text-gray-800 text-sm">${item.fullName || '-'}</h3>
                                    <p class="text-xs text-gray-500">${item.registrationNumber || '-'}</p>
                                </div>
                            </div>
                            ${renderStatusBadge(item.status)}
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                            <div class="text-gray-500">Academic Year</div>
                            <div class="text-gray-800">${item.academicYear || '-'}</div>
                            <div class="text-gray-500">Faculty</div>
                            <div class="text-gray-800">${item.faculty || '-'}</div>
                            <div class="text-gray-500">Contact</div>
                            <div class="text-gray-800">${item.contactNumber || '-'}</div>
                            <div class="text-gray-500">Email</div>
                            <div class="text-gray-800 truncate">${item.email || '-'}</div>
                        </div>
                        <div class="flex items-center gap-2 pt-3 mt-2 border-t border-gray-100">
                            ${renderActions(item, true)}
                        </div>
                    </div>
                `).join('');
            };

            const updatePagination = () => {
                const totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));
                const start = (page - 1) * pageSize + 1;
                const end = Math.min(page * pageSize, totalRecords);

                pageInfo.textContent = `${page} / ${totalPages}`;
                summaryText.innerHTML = `Showing <span class="font-semibold text-gray-900">${totalRecords === 0 ? 0 : start}</span> to <span class="font-semibold text-gray-900">${end}</span> of <span class="font-semibold text-gray-900">${totalRecords}</span> entries`;

                prevBtn.disabled = page <= 1;
                nextBtn.disabled = page >= totalPages;
            };

            searchBox.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    page = 1;
                    loadData();
                }, 600);
            });

            searchBox.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    clearTimeout(searchTimeout);
                    page = 1;
                    loadData();
                }
            });

            filterSelects.forEach(sel => {
                sel.addEventListener('change', () => {
                    updateFilterCount();
                    page = 1;
                    loadData();
                });
            });

            $(pageSizeSelect).on('change', function () {
                pageSize = parseInt(this.value, 10);
                page = 1;
                loadData();
            });

            prevBtn.addEventListener('click', () => {
                if (page > 1) {
                    page--;
                    loadData();
                }
            });

            nextBtn.addEventListener('click', () => {
                const totalPages = Math.ceil(totalRecords / pageSize);
                if (page < totalPages) {
                    page++;
                    loadData();
                }
            });

            window.exportPdf = () => {
                window.open(`${base}/Students/StudentRegistrations/ExportToPdf?searchTerm=${encodeURIComponent(searchBox.value.trim())}`, '_blank');
            };

            window.exportExcel = () => {
                window.location.href = `${base}/Students/StudentRegistrations/ExportToExcel?searchTerm=${encodeURIComponent(searchBox.value.trim())}`;
            };

            window.exportCsv = () => {
                window.location.href = `${base}/Students/StudentRegistrations/ExportToCsv?searchTerm=${encodeURIComponent(searchBox.value.trim())}`;
            };

            window.deleteStudentRegistration = async (id) => {
                if (!confirm('Are you sure you want to delete this registration?')) return;
                try {
                    const response = await fetch(`${base}/Students/StudentRegistrations/DeleteAjax?id=${id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                    });
                    const result = await response.json();
                    if (result.success) {
                        alert(result.message);
                        loadData();
                    } else {
                        alert('Error: ' + result.message);
                    }
                } catch (error) {
                    alert('An error occurred while deleting.');
                }
            };

            window.updateRegStatus = async (id, status) => {
                if (!confirm(`Are you sure you want to mark this registration as ${status}?`)) return;

                try {
                    const response = await fetch(`${base}/Students/StudentRegistrations/UpdateStatus?id=${id}&status=${status}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                    });

                    if (response.ok) {
                        loadData();
                    } else {
                        alert('Failed to update status. Please try again.');
                    }
                } catch (error) {
                    console.error('Status update failed:', error);
                    alert('An error occurred. Please try again.');
                }
            };

            loadData();
        })();
    </script>
}
