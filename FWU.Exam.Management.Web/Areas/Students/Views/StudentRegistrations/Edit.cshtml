@using FWU.Exam.Management.Domain.Entities.Students
@model StudentRegistration

@{
    ViewData["Title"] = "Edit Student Registration";
}

<div class="min-h-screen bg-gray-100 py-8">
    <div class="space-y-6">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h1 class="text-xl font-semibold text-gray-800">Edit Student Registration</h1>
            </div>

            <div class="px-6 py-6">
                <form asp-action="Edit" class="space-y-6" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
                    <input type="hidden" asp-for="Id" />

                    @if (string.IsNullOrEmpty(Model?.RegistrationNumber))
                    {
                        <div id="generateRegSection" class="bg-white rounded-xl shadow-sm border-2 border-dashed border-amber-300 p-4 mb-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h3 class="text-sm font-semibold text-amber-800">Registration Number Not Generated</h3>
                                    <p class="mt-1 text-sm text-amber-600">Generate a system-assigned registration number for this student.</p>
                                </div>
                                <button id="generateRegBtn" type="button" onclick="generateRegNumber(@Model.Id)"
                                        class="inline-flex items-center px-4 py-2 bg-amber-600 text-white rounded-lg text-sm font-medium hover:bg-amber-700 transition shadow-sm">
                                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                    Generate Registration Number
                                </button>
                            </div>
                            <div id="generateRegSpinner" class="hidden mt-3 flex items-center gap-2 text-sm text-amber-700">
                                <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                                Generating registration number...
                            </div>
                            <div id="generateRegResult" class="hidden mt-3"></div>
                        </div>
                    }

                    <!-- Personal Information -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Personal Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div>
                                <label asp-for="AcademicYearId" class="block text-sm font-medium text-gray-700 mb-1">
                                    Academic Year
                                    *
                                </label>
                                <select asp-for="AcademicYearId"
                                        class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm placeholder-gray-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500"
                                        asp-items="ViewBag.AcademicYearId"></select>
                            </div>

                            <div>
                                <label asp-for="LevelId" class="block text-sm font-medium text-gray-700 mb-1">Level/Grade *</label>
                                <select asp-for="LevelId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.LevelId"></select>
                            </div>

                            <div>
                                <label asp-for="FacultyId" class="block text-sm font-medium text-gray-700 mb-1">Faculty</label>
                                <select asp-for="FacultyId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.FacultyId">
                                    <option value="">Select Faculty</option>
                                </select>
                            </div>

                            <div>
                                <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College/Campus *</label>
                                <select asp-for="CollegeId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.CollegeId"><option value="">Select College</option></select>
                            </div>

                            <div>
                                <label asp-for="ProgramId" class="block text-sm font-medium text-gray-700 mb-1">Program</label>
                                <select asp-for="ProgramId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.ProgramId">
                                    <option value="">Select Program</option>
                                </select>
                            </div>
                            
                            <div class="md:col-span-3">
                                <label class="block text-sm text-gray-600 mb-1">Name <span class="text-red-500">*</span></label>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <input asp-for="FirstName" placeholder="First Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                    <input asp-for="MiddleName" placeholder="Middle Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                    <input asp-for="LastName" placeholder="Last Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>

                            <div>
                                <label asp-for="GenderId" class="block text-sm text-gray-600 mb-1">Gender *</label>
                                <select asp-for="GenderId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.GenderId"></select>
                            </div>

                            <div>
                                <label asp-for="DateOfBirthBS" class="block text-sm text-gray-600 mb-1">Date of Birth (BS)</label>
                                <input asp-for="DateOfBirthBS" placeholder="YYYY-MM-DD" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="DateOfBirthBS" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="DateOfBirthAD" class="block text-sm text-gray-600 mb-1">Date of Birth (AD)</label>
                                <input asp-for="DateOfBirthAD" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="DateOfBirthAD" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="EthnicityId" class="block text-sm text-gray-600 mb-1">Ethnicity</label>
                                <select asp-for="EthnicityId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.EthnicityId"></select>
                            </div>

                            <div>
                                <label asp-for="Nationality" class="block text-sm text-gray-600 mb-1">Nationality</label>
                                <input asp-for="Nationality" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Nationality" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="Religion" class="block text-sm text-gray-600 mb-1">Religion</label>
                                <input asp-for="Religion" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Religion" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="Email" class="block text-sm text-gray-600 mb-1">Email</label>
                                <input asp-for="Email" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="ContactNumber" class="block text-sm text-gray-600 mb-1">Phone</label>
                                <input asp-for="ContactNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="ContactNumber" class="text-red-600 text-xs"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Student Category -->
                    <div>
                        <label asp-for="StudentCategoryId" class="block text-sm font-medium">Student Category *</label>
                        <select asp-for="StudentCategoryId" asp-items="ViewBag.StudentCategoryId"
                                class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 shadow-sm">
                            <option value="">Select Category</option>
                        </select>
                        <span asp-validation-for="StudentCategoryId" class="text-red-600 text-xs"></span>
                    </div>

                    <!-- Parents / Guardian Information -->
                    @{
                        var guardian = ViewBag.Guardian as StudentGuardian;
                        var fatherName = guardian?.FatherName ?? "";
                        var fatherFirstName = fatherName.Contains(' ') ? fatherName[..fatherName.LastIndexOf(' ')] : fatherName;
                        var fatherLastName = fatherName.Contains(' ') ? fatherName[(fatherName.LastIndexOf(' ') + 1)..] : "";
                        var motherName = guardian?.MotherName ?? "";
                        var motherFirstName = motherName.Contains(' ') ? motherName[..motherName.LastIndexOf(' ')] : motherName;
                        var motherLastName = motherName.Contains(' ') ? motherName[(motherName.LastIndexOf(' ') + 1)..] : "";
                    }
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Parents / Guardian Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="md:col-span-1">
                                <label class="block text-sm text-gray-600 mb-1">Father Name</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <input name="FatherFirstName" value="@fatherFirstName" placeholder="First Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                    <input name="FatherLastName" value="@fatherLastName" placeholder="Last Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Father Occupation</label>
                                <input name="FatherOccupation" value="@(guardian?.FatherProfession ?? "")" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Father Phone</label>
                                <input name="FatherPhone" value="@(guardian?.FatherContactNumber ?? "")" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div class="md:col-span-1">
                                <label class="block text-sm text-gray-600 mb-1">Mother Name</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <input name="MotherFirstName" value="@motherFirstName" placeholder="First Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                    <input name="MotherLastName" value="@motherLastName" placeholder="Last Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Mother Occupation</label>
                                <input name="MotherOccupation" value="@(guardian?.MotherProfession ?? "")" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Mother Phone</label>
                                <input name="MotherPhone" value="@(guardian?.MotherContactNumber ?? "")" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Address Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Province *</label>
                                <select id="ProvinceId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" asp-items="@ViewBag.Provinces">
                                    <option value="">Select Province</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">District *</label>
                                <select id="DistrictId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                    <option value="">Select District</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Local Level *</label>
                                <select id="LocalLevelId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                    <option value="">Select Local Level</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Ward Number</label>
                                <input id="WardNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Tole/Street</label>
                                <input id="ToleStreet" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">House Number</label>
                                <input id="HouseNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>                           
                        </div>
                    </div>

                    <!-- Qualification Info -->
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <h2 class="text-sm font-semibold text-gray-700">Qualification Info</h2>
                            <button type="button" onclick="addQualificationRow()" class="inline-flex items-center px-3 py-1.5 bg-teal-50 text-teal-700 rounded-md text-xs font-medium hover:bg-teal-100 transition border border-teal-200">
                                + Add Qualification
                            </button>
                        </div>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm text-left" id="qualificationTable">
                                <thead>
                                    <tr class="border-b">
                                        <th class="py-2 pr-4">Previous Level</th>
                                        <th class="py-2 pr-4">Board</th>
                                        <th class="py-2 pr-4">Institute</th>
                                        <th class="py-2 pr-4">Passed Year</th>
                                        <th class="py-2 pr-4">Percentage</th>
                                        <th class="py-2 pr-4">Roll Number</th>
                                        <th class="py-2 pr-4">Document</th>
                                        <th class="py-2"></th>
                                    </tr>
                                </thead>
                                <tbody id="qualificationBody">
                                <tr id="noQualificationRow">
                                    <td colspan="8" class="py-4 text-center text-gray-400 text-sm">No qualifications added yet. Click "Add Qualification" to add academic records.</td>
                                </tr>
                            </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Hidden Fields -->
                    <input type="hidden" asp-for="IsActive" />

                    <div class="flex items-center space-x-3">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded-md text-sm hover:bg-teal-700 transition focus:outline-none focus:ring-2 focus:ring-teal-400 focus:ring-offset-1">Save changes</button>
                        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition focus:outline-none focus:ring-2 focus:ring-gray-300 focus:ring-offset-1">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #14b8a6;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(20,184,166,0.2);
        }
    </style>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var qualificationIndex = @(((System.Collections.Generic.List<StudentQualification>)ViewBag.Qualifications)?.Count ?? 0);

        function getPreviousLevelOptions() {
            var html = '<option value="">Select Level</option>';
            @foreach (var item in ViewBag.PreviousLevelId)
            {
                <text>html += '<option value="@item.Value">@item.Text</option>';</text>
            }
            return html;
        }

        function getBoardOptions() {
            var html = '<option value="">Select Board</option>';
            @foreach (var item in ViewBag.BoardId)
            {
                <text>html += '<option value="@item.Value">@item.Text</option>';</text>
            }
            return html;
        }

        function addQualificationRow(data) {
            data = data || {};
            var idx = qualificationIndex++;
            var row = document.createElement('tr');
            row.className = 'qualification-row border-b hover:bg-gray-50';
            row.innerHTML =
                '<td class="py-2 pr-4">' +
                    '<select name="Qualifications.PreviousLevelId" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-xs">' + getPreviousLevelOptions() + '</select>' +
                '</td>' +
                '<td class="py-2 pr-4">' +
                    '<select name="Qualifications.BoardId" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-xs">' + getBoardOptions() + '</select>' +
                '</td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.InstituteName" value="' + (data.institute || '') + '" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="Institute" /></td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.PassedYear" value="' + (data.year || '') + '" class="w-20 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="Year" /></td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.Percentage" value="' + (data.pct || '') + '" class="w-20 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="%" step="0.01" /></td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.ExamRollNumber" value="' + (data.roll || '') + '" class="w-24 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="Roll No" /></td>' +
                '<td class="py-2 pr-4">' +
                    '<input type="file" name="Qualifications.DocumentFile_' + idx + '" class="w-28 text-xs" accept=".pdf,.jpg,.jpeg,.png" />' +
                '</td>' +
                '<td class="py-2">' +
                    '<button type="button" onclick="this.closest(\'tr\').remove()" class="text-red-500 hover:text-red-700 text-xs">Remove</button>' +
                '</td>';
            document.getElementById('qualificationBody').appendChild(row);
            document.getElementById('noQualificationRow').style.display = 'none';

            if (data.previousLevelId) row.querySelector('[name="Qualifications.PreviousLevelId"]').value = data.previousLevelId;
            if (data.boardId) row.querySelector('[name="Qualifications.BoardId"]').value = data.boardId;
        }

        @{
            var qualsJson = "";
            var qualsData = ViewBag.Qualifications as System.Collections.Generic.List<StudentQualification>;
            if (qualsData != null && qualsData.Count > 0)
            {
                var jsonItems = qualsData.Select(q => new {
                    previousLevelId = q.PreviousLevelId,
                    boardId = q.BoardId,
                    institute = q.InstituteName ?? "",
                    year = q.PassedYear ?? "",
                    pct = q.Percentage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                    roll = q.ExamRollNumber ?? "",
                    doc = q.DocumentPath ?? ""
                });
                qualsJson = System.Text.Json.JsonSerializer.Serialize(jsonItems);
            }
        }

        function loadDistricts(provinceId, selectedDistrictId, callback) {
            $('#DistrictId').select2('destroy');
            if (!provinceId) {
                $("#DistrictId").empty().append('<option value="">Select District</option>');
                $('#DistrictId').select2({width:'resolve'});
                if (callback) callback();
                return;
            }

            $.get(tenantUrl("/Students/StudentRegistrations/GetDistrictsByProvince"), { provinceId: provinceId }, function (data) {
                var dropdown = $("#DistrictId");
                dropdown.empty();
                dropdown.append('<option value="">Select District</option>');
                $.each(data, function (index, item) {
                    var selected = selectedDistrictId && item.id == selectedDistrictId ? ' selected' : '';
                    dropdown.append(`<option value="${item.id}"${selected}>${item.name}</option>`);
                });
                dropdown.trigger('change');
                if (callback) callback();
            });
        }

        function loadLocalLevels(districtId, selectedLocalLevelId, callback) {
            $('#LocalLevelId').select2('destroy');
            if (!districtId) {
                $("#LocalLevelId").empty().append('<option value="">Select Local Level</option>');
                $('#LocalLevelId').select2({width:'resolve'});
                if (callback) callback();
                return;
            }

            $.get(tenantUrl("/Students/StudentRegistrations/GetLocalLevelsByDistrict"), { districtId: districtId }, function (data) {
                var dropdown = $("#LocalLevelId");
                dropdown.empty();
                dropdown.append('<option value="">Select Local Level</option>');
                $.each(data, function (index, item) {
                    var selected = selectedLocalLevelId && item.id == selectedLocalLevelId ? ' selected' : '';
                    dropdown.append(`<option value="${item.id}"${selected}>${item.name}</option>`);
                });
                dropdown.trigger('change');
                if (callback) callback();
            });
        }

        var _cascadeBusy = false;

        function loadExistingQualifications() {
            var data = @Html.Raw(string.IsNullOrEmpty(qualsJson) ? "[]" : qualsJson);
            data.forEach(function(q) { addQualificationRow(q); });
        }

        function loadFaculties(levelId, selectedFacultyId, callback) {
            $('#FacultyId').select2('destroy');
            if (!levelId) {
                $("#FacultyId").empty().append('<option value="">Select Faculty</option>');
                $('#FacultyId').select2({width:'resolve'});
                if (callback) callback();
                return;
            }

            $.get(tenantUrl("/Students/StudentRegistrations/GetFacultiesByLevel"),
                { levelId: levelId },
                function (data) {
                    var dropdown = $("#FacultyId");
                    dropdown.empty();
                    dropdown.append('<option value="">Select Faculty</option>');
                    $.each(data, function (index, item) {
                        var selected = selectedFacultyId && item.id == selectedFacultyId ? 'selected' : '';
                        dropdown.append(`<option value="${item.id}" ${selected}>${item.name}</option>`);
                    });
                    dropdown.trigger('change');
                    if (callback) callback();
            });
        }

        function loadColleges(facultyId, selectedCollegeId, callback) {
            $('#CollegeId').select2('destroy');
            if (!facultyId) {
                $("#CollegeId").empty().append('<option value="">Select College</option>');
                $('#CollegeId').select2({width:'resolve'});
                if (callback) callback();
                return;
            }

            $.get(tenantUrl("/Students/StudentRegistrations/GetCollegesByFaculty"),
                { facultyId: facultyId },
                function (data) {
                    var dropdown = $("#CollegeId");
                    dropdown.empty();
                    dropdown.append('<option value="">Select College</option>');
                    $.each(data, function (index, item) {
                        var selected = selectedCollegeId && item.id == selectedCollegeId ? 'selected' : '';
                        dropdown.append(`<option value="${item.id}" ${selected}>${item.name}</option>`);
                    });
                    dropdown.trigger('change');
                    if (callback) callback();
            });
        }

        function loadPrograms(collegeId, selectedProgramId, callback) {
            $('#ProgramId').select2('destroy');
            var levelId = $("#LevelId").val();

            if (!collegeId) {
                $("#ProgramId").empty().append('<option value="">Select Program</option>');
                $('#ProgramId').select2({width:'resolve'});
                if (callback) callback();
                return;
            }

            $.get(tenantUrl("/Students/StudentRegistrations/GetProgramsByCollege"),
                { collegeId: collegeId, levelId: levelId || null },
                function (data) {
                    var dropdown = $("#ProgramId");
                    dropdown.empty();
                    dropdown.append('<option value="">Select Program</option>');
                    $.each(data, function (i, item) {
                        var selected = selectedProgramId && item.id == selectedProgramId ? ' selected' : '';
                        dropdown.append(`<option value="${item.id}"${selected}>${item.name}</option>`);
                    });
                    dropdown.trigger('change');
                    if (callback) callback();
            });
        }

        $(function () {
            $('.select2').select2({ width: 'resolve' });
            loadExistingQualifications();

            var convertTimer;
            $("#DateOfBirthBS").on("input", function () {
                var val = $(this).val().trim();
                if (val.length < 10) return;
                clearTimeout(convertTimer);
                convertTimer = setTimeout(function () {
                    $.get(tenantUrl("/Students/StudentRegistrations/ConvertBsToAd"), { bsDate: val }, function (data) {
                        if (data.adDate) $("#DateOfBirthAD").val(data.adDate);
                    });
                }, 300);
            });

            $("#DateOfBirthAD").on("input", function () {
                var val = $(this).val().trim();
                if (val.length < 8) return;
                clearTimeout(convertTimer);
                convertTimer = setTimeout(function () {
                    $.get(tenantUrl("/Students/StudentRegistrations/ConvertAdToBs"), { adDate: val }, function (data) {
                        if (data.bsDate) $("#DateOfBirthBS").val(data.bsDate);
                    });
                }, 300);
            });

            // Province -> District
            $("#ProvinceId").change(function () {
                var provinceId = $(this).val();
                $("#DistrictId").html('<option>Loading...</option>');
                $("#LocalLevelId").html('<option value="">Select Local Level</option>');
                $.get(tenantUrl("/Students/StudentRegistrations/GetDistrictsByProvince"), { provinceId: provinceId }, function (data) {
                    var dropdown = $("#DistrictId");
                    dropdown.empty();
                    dropdown.append('<option value="">Select District</option>');
                    $.each(data, function (index, item) {
                        dropdown.append(`<option value="${item.id}">${item.name}</option>`);
                    });
                    dropdown.trigger('change');
                    if (window._addrPendingDistrictId) {
                        $("#DistrictId").val(window._addrPendingDistrictId).trigger('change');
                        window._addrPendingDistrictId = null;
                    }
                });
            });

            // District -> LocalLevel
            $("#DistrictId").change(function () {
                var districtId = $(this).val();
                $("#LocalLevelId").html('<option value="">Loading...</option>');
                $.get(tenantUrl("/Students/StudentRegistrations/GetLocalLevelsByDistrict"), { districtId: districtId }, function (data) {
                    var dropdown = $("#LocalLevelId");
                    dropdown.empty();
                    dropdown.append('<option value="">Select Local Level</option>');
                    $.each(data, function (index, item) {
                        dropdown.append(`<option value="${item.id}">${item.name}</option>`);
                    });
                    dropdown.trigger('change');
                    if (window._addrPendingLocalLevelId) {
                        $("#LocalLevelId").val(window._addrPendingLocalLevelId).trigger('change');
                        window._addrPendingLocalLevelId = null;
                    }
                });
            });

            // Level -> Faculty + clear downstream
            $("#LevelId").change(function () {
                if (_cascadeBusy) return;
                var levelId = $(this).val();
                $("#FacultyId").select2('destroy');
                $("#CollegeId").select2('destroy');
                $("#ProgramId").select2('destroy');
                $("#CollegeId").empty().append('<option value="">Select College</option>');
                $("#ProgramId").empty().append('<option value="">Select Program</option>');
                $('#FacultyId').select2({width:'resolve'});
                $('#CollegeId').select2({width:'resolve'});
                $('#ProgramId').select2({width:'resolve'});
                loadFaculties(levelId, null);
            });

            // Faculty -> College + clear downstream
            $("#FacultyId").change(function () {
                if (_cascadeBusy) return;
                var facultyId = $(this).val();
                $("#CollegeId").html('<option>Loading...</option>');
                $("#ProgramId").empty().append('<option value="">Select Program</option>');
                $('#CollegeId').select2({width:'resolve'});
                $('#ProgramId').select2({width:'resolve'});
                loadColleges(facultyId, null);
            });

            // College -> Program
            $("#CollegeId").change(function () {
                if (_cascadeBusy) return;
                var collegeId = $(this).val();
                $("#ProgramId").empty().append('<option value="">Select Program</option>');
                loadPrograms(collegeId, null);
            });

            // On page load, cascade initial values (suppress cascading change handlers via _cascadeBusy)
            _cascadeBusy = true;
            var initLevelId = $("#LevelId").val();
            var initFacultyId = $("#FacultyId").val();
            var initCollegeId = $("#CollegeId").val();
            var initProgramId = $("#ProgramId").val();
            var initProvinceId = $("#ProvinceId").val();
            var initDistrictId = $("#DistrictId").val();
            var initLocalLevelId = $("#LocalLevelId").val();

            if (initProvinceId) {
                loadDistricts(initProvinceId, initDistrictId, function () {
                    if (initDistrictId) loadLocalLevels(initDistrictId, initLocalLevelId);
                });
            }

            function cascadeDone() { _cascadeBusy = false; }

            if (initLevelId) {
                loadFaculties(initLevelId, initFacultyId, function () {
                    if (initFacultyId) {
                        loadColleges(initFacultyId, initCollegeId, function () {
                            if (initCollegeId) {
                                loadPrograms(initCollegeId, initProgramId, cascadeDone);
                            } else { cascadeDone(); }
                        });
                    } else { cascadeDone(); }
                });
            } else { cascadeDone(); }

            // Pre-populate address cascade (pending vars handled in change handler callbacks)
            var existingProvinceId = @((ViewBag.ExistingProvinceId as int?)?.ToString() ?? "null");
            var existingDistrictId = @((ViewBag.ExistingDistrictId as int?)?.ToString() ?? "null");
            var existingLocalLevelId = @((ViewBag.ExistingLocalLevelId as int?)?.ToString() ?? "null");

            if (existingProvinceId && existingProvinceId !== null) {
                window._addrPendingDistrictId = existingDistrictId;
                window._addrPendingLocalLevelId = existingLocalLevelId;
                $("#ProvinceId").val(existingProvinceId).trigger('change');
            }
            var ward = '@(ViewBag.ExistingWardNumber?.ToString() ?? "")';
            var tole = '@(ViewBag.ExistingToleStreet?.ToString() ?? "")';
            var house = '@(ViewBag.ExistingHouseNumber?.ToString() ?? "")';
            if (ward) $('#WardNumber').val(ward);
            if (tole) $('#ToleStreet').val(tole);
            if (house) $('#HouseNumber').val(house);
        });

        // Init Select2 on all dropdowns
        $('#AcademicYearId, #LevelId, #FacultyId, #CollegeId, #ProgramId, #GenderId, #EthnicityId, #StudentCategoryId, #ProvinceId, #DistrictId, #LocalLevelId').select2({
            width: '100%',
            placeholder: function () { return $(this).find('option:first').text(); },
            allowClear: false
        });

        function generateRegNumber(id) {
            var btn = document.getElementById('generateRegBtn');
            var spinner = document.getElementById('generateRegSpinner');
            var result = document.getElementById('generateRegResult');
            var section = document.getElementById('generateRegSection');

            if (btn) btn.disabled = true;
            if (spinner) spinner.classList.remove('hidden');
            if (result) result.classList.add('hidden');

            $.post(tenantUrl('/Students/StudentRegistrations/GenerateRegistrationNumber'), { id: id })
                .done(function (res) {
                    if (res.success) {
                        if (section) {
                            section.className = 'bg-green-50 border border-green-300 rounded-xl p-4 mb-6';
                            section.innerHTML =
                                '<div class="flex items-center gap-3">' +
                                    '<svg class="h-6 w-6 text-green-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' +
                                    '<div>' +
                                        '<p class="text-sm font-medium text-green-800">Registration Number Generated</p>' +
                                        '<p class="mt-1 text-lg font-bold text-green-700 font-mono">' + res.registrationNumber + '</p>' +
                                    '</div>' +
                                '</div>';
                        }
                    } else {
                        if (result) {
                            result.className = 'mt-3 text-sm text-red-600';
                            result.textContent = 'Error: ' + (res.message || 'Unknown error');
                            result.classList.remove('hidden');
                        }
                        if (btn) btn.disabled = false;
                        if (spinner) spinner.classList.add('hidden');
                    }
                })
                .fail(function () {
                    if (result) {
                        result.className = 'mt-3 text-sm text-red-600';
                        result.textContent = 'An unexpected error occurred.';
                        result.classList.remove('hidden');
                    }
                    if (btn) btn.disabled = false;
                    if (spinner) spinner.classList.add('hidden');
                });
        }
    </script>
}
