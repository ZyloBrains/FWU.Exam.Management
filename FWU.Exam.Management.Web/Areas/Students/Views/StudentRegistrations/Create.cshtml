@using FWU.Exam.Management.Domain.Entities.Students
@model StudentRegistration

@{
    ViewData["Title"] = "Create Student Registration";
}

<div class="min-h-screen bg-gray-100 py-8">
    <div class="space-y-6">
        <div class="flex items-center gap-3 mb-4">
            <a asp-action="Index" class="w-10 h-10 bg-white rounded-lg flex items-center justify-center hover:bg-gray-100 transition shadow-sm border border-gray-200">
                <i class="fas fa-arrow-left text-gray-600"></i>
            </a>
            <h1 class="text-xl font-semibold text-gray-800">Student Registration</h1>
        </div>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
            </div>

            <div class="px-6 py-6">
                <form asp-action="Create" class="space-y-6" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                    <!-- Personal Information -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Personal Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div>
                                <label asp-for="AcademicYearId" class="block text-sm font-medium text-gray-700 mb-1">
                                    Academic Year
                                    *
                                </label>
                                <select asp-for="AcademicYearId"
                                        class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm placeholder-gray-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500"
                                        asp-items="ViewBag.AcademicYearId"></select>
                            </div>

                            <div>
                                <label asp-for="LevelId" class="block text-sm font-medium text-gray-700 mb-1">Level/Grade *</label>
                                <select asp-for="LevelId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.LevelId"></select>
                            </div>

                            <div>
                                <label asp-for="FacultyId" class="block text-sm font-medium text-gray-700 mb-1">Faculty</label>
                                <select asp-for="FacultyId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.FacultyId">
                                    <option value="">Select Faculty</option>
                                </select>
                            </div>

                            <div>
                                <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College/Campus *</label>
                                <select asp-for="CollegeId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.CollegeId"></select>
                            </div>

                            <div>
                                <label asp-for="DepartmentId" class="block text-sm font-medium text-gray-700 mb-1">Department *</label>
                                <select asp-for="DepartmentId"
                                        class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm"
                                        asp-items="ViewBag.DepartmentId">
                                    <option value="">Select Department</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="ProgramId" class="block text-sm font-medium text-gray-700 mb-1">Program</label>
                                <select asp-for="ProgramId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.ProgramId">
                                    <option value="">Select Program</option>
                                </select>
                            </div>

                            <div class="md:col-span-3">
                                <label class="block text-sm text-gray-600 mb-1">Name <span class="text-red-500">*</span></label>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <input asp-for="FirstName" placeholder="First Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                    <input asp-for="MiddleName" placeholder="Middle Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                    <input asp-for="LastName" placeholder="Last Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>

                            <div>
                                <label asp-for="GenderId" class="block text-sm text-gray-600 mb-1">Gender *</label>
                                <select asp-for="GenderId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.GenderId"></select>
                            </div>

                            <div>
                                <label asp-for="DateOfBirthBS" class="block text-sm text-gray-600 mb-1">Date of Birth (BS)</label>
                                <input asp-for="DateOfBirthBS" placeholder="YYYY-MM-DD" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="DateOfBirthBS" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="DateOfBirthAD" class="block text-sm text-gray-600 mb-1">Date of Birth (AD)</label>
                                <input asp-for="DateOfBirthAD" placeholder="MM-DD-YYYY" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="DateOfBirthAD" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="RegistrationNumber" class="block text-sm text-gray-600 mb-1">College Roll No</label>
                                <input asp-for="RegistrationNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="RegistrationNumber" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="EthnicityId" class="block text-sm text-gray-600 mb-1">Ethnicity</label>
                                <select asp-for="EthnicityId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.EthnicityId"></select>
                            </div>

                            <div>
                                <label asp-for="Nationality" class="block text-sm text-gray-600 mb-1">Nationality</label>
                                <input asp-for="Nationality" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Nationality" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="Religion" class="block text-sm text-gray-600 mb-1">Religion</label>
                                <input asp-for="Religion" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Religion" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="Email" class="block text-sm text-gray-600 mb-1">Email</label>
                                <input asp-for="Email" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="ContactNumber" class="block text-sm text-gray-600 mb-1">Phone</label>
                                <input asp-for="ContactNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="ContactNumber" class="text-red-600 text-xs"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Student Category -->
                    <div>
                        <label asp-for="StudentCategoryId" class="block text-sm font-medium">Student Category *</label>
                        <select asp-for="StudentCategoryId" asp-items="ViewBag.StudentCategoryId"
                                class="select2 w-full px-3 py-2 border rounded-md bg-white text-sm">
                            <option value="">Select Category</option>
                        </select>
                        <span asp-validation-for="StudentCategoryId" class="text-red-600 text-xs"></span>
                    </div>

                    <!-- Parents / Guardian Information -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Parents / Guardian Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="md:col-span-1">
                                <label class="block text-sm text-gray-600 mb-1">Father Name</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <input name="FatherFirstName" placeholder="First Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                    <input name="FatherLastName" placeholder="Last Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Father Occupation</label>
                                <input name="FatherOccupation" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Father Phone</label>
                                <input name="FatherPhone" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div class="md:col-span-1">
                                <label class="block text-sm text-gray-600 mb-1">Mother Name</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <input name="MotherFirstName" placeholder="First Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                    <input name="MotherLastName" placeholder="Last Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Mother Occupation</label>
                                <input name="MotherOccupation" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Mother Phone</label>
                                <input name="MotherPhone" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Address Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Province *</label>
                                <select id="ProvinceId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" asp-items="@ViewBag.Provinces">
                                    <option>Select Province</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">District *</label>
                                <select id="DistrictId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                                    <option>Select District</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Local Level *</label>
                                <select id="LocalLevelId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                                    <option>Select Local Level</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Ward Number</label>
                                <input id="WardNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Tole/Street</label>
                                <input id="ToleStreet" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">House Number</label>
                                <input id="HouseNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                            </div>
                        </div>
                    </div>

                    <!-- Qualification Info -->
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <h2 class="text-sm font-semibold text-gray-700">Qualification Info</h2>
                            <button type="button" onclick="addQualificationRow()" class="inline-flex items-center px-3 py-1.5 bg-teal-50 text-teal-700 rounded-md text-xs font-medium hover:bg-teal-100 transition border border-teal-200">
                                + Add Qualification
                            </button>
                        </div>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm text-left" id="qualificationTable">
                                <thead>
                                    <tr class="border-b">
                                        <th class="py-2 pr-4">Previous Level</th>
                                        <th class="py-2 pr-4">Board</th>
                                        <th class="py-2 pr-4">Institute</th>
                                        <th class="py-2 pr-4">Passed Year</th>
                                        <th class="py-2 pr-4">Percentage</th>
                                        <th class="py-2 pr-4">Roll Number</th>
                                        <th class="py-2 pr-4">Document</th>
                                        <th class="py-2"></th>
                                    </tr>
                                </thead>
                                <tbody id="qualificationBody">
                                    <tr id="noQualificationRow">
                                        <td colspan="8" class="py-4 text-center text-gray-400 text-sm">No qualifications added yet. Click "Add Qualification" to add academic records.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded-md text-sm hover:bg-teal-700 transition">Save changes</button>
                        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #14b8a6;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(20,184,166,0.2);
        }
    </style>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var qualificationIndex = 0;

        function getPreviousLevelOptions() {
            var html = '<option value="">Select Level</option>';
            @foreach (var item in ViewBag.PreviousLevelId)
            {
                <text>html += '<option value="@item.Value">@item.Text</option>';</text>
            }
            return html;
        }

        function getBoardOptions() {
            var html = '<option value="">Select Board</option>';
            @foreach (var item in ViewBag.BoardId)
            {
                <text>html += '<option value="@item.Value">@item.Text</option>';</text>
            }
            return html;
        }

        function addQualificationRow(data) {
            data = data || {};
            var idx = qualificationIndex++;
            var row = document.createElement('tr');
            row.className = 'qualification-row border-b hover:bg-gray-50';
            row.innerHTML =
                '<td class="py-2 pr-4">' +
                    '<select name="Qualifications.PreviousLevelId" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-xs">' + getPreviousLevelOptions() + '</select>' +
                '</td>' +
                '<td class="py-2 pr-4">' +
                    '<select name="Qualifications.BoardId" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-xs">' + getBoardOptions() + '</select>' +
                '</td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.InstituteName" value="' + (data.institute || '') + '" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="Institute" /></td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.PassedYear" value="' + (data.year || '') + '" class="w-20 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="Year" /></td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.Percentage" value="' + (data.pct || '') + '" class="w-20 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="%" step="0.01" /></td>' +
                '<td class="py-2 pr-4"><input name="Qualifications.ExamRollNumber" value="' + (data.roll || '') + '" class="w-24 px-2 py-1.5 border border-gray-300 rounded text-xs" placeholder="Roll No" /></td>' +
                '<td class="py-2 pr-4">' +
                    '<input type="file" name="Qualifications.DocumentFile_' + idx + '" class="w-28 text-xs" accept=".pdf,.jpg,.jpeg,.png" />' +
                '</td>' +
                '<td class="py-2">' +
                    '<button type="button" onclick="this.closest(\'tr\').remove()" class="text-red-500 hover:text-red-700 text-xs">Remove</button>' +
                '</td>';
            document.getElementById('qualificationBody').appendChild(row);
            document.getElementById('noQualificationRow').style.display = 'none';

            if (data.previousLevelId) row.querySelector('[name="Qualifications.PreviousLevelId"]').value = data.previousLevelId;
            if (data.boardId) row.querySelector('[name="Qualifications.BoardId"]').value = data.boardId;
        }

        function loadPrograms() {
            var collegeId = $("#CollegeId").val();
            var levelId = $("#LevelId").val();
            var departmentId = $("#DepartmentId").val();

            $('#ProgramId').select2('destroy');
            $("#ProgramId").html('<option>Loading...</option>');

            if (!collegeId) {
                var programDropdown = $("#ProgramId");
                programDropdown.empty();
                programDropdown.append('<option value="">Select Program</option>');
                return;
            }

            $.get(tenantUrl("/Students/StudentRegistrations/GetProgramsByCollege"),
                { collegeId: collegeId, levelId: levelId || null, departmentId: departmentId || null },
                function (data) {
                    var programDropdown = $("#ProgramId");
                    programDropdown.empty();
                    programDropdown.append('<option value="">Select Program</option>');
                    $.each(data, function (index, item) {
                        programDropdown.append(`<option value="${item.id}">${item.name}</option>`);
                    });
                    $('#ProgramId').select2();
            });
        }

        $(function () {
            $('.select2').select2();

            var convertTimer;
            $("#DateOfBirthBS").on("input", function () {
                var bs = $(this).val().trim();
                if (bs.length === 10) {
                    clearTimeout(convertTimer);
                    convertTimer = setTimeout(function () {
                        $.get(tenantUrl("/Students/StudentRegistrations/ConvertBsToAd"), { bsDate: bs }, function (data) {
                            if (data.adDate) $("#DateOfBirthAD").val(data.adDate);
                        });
                    }, 300);
                }
            });

            $("#DateOfBirthAD").on("input", function () {
                var ad = $(this).val().trim();
                if (ad.length >= 8) {
                    clearTimeout(convertTimer);
                    convertTimer = setTimeout(function () {
                        $.get(tenantUrl("/Students/StudentRegistrations/ConvertAdToBs"), { adDate: ad }, function (data) {
                            if (data.bsDate) $("#DateOfBirthBS").val(data.bsDate);
                        });
                    }, 300);
                }
            });

            // Province -> District
            $("#ProvinceId").change(function () {
                var provinceId = $(this).val();

                $('#DistrictId').select2('destroy');
                $('#LocalLevelId').select2('destroy');
                $("#DistrictId").html('<option>Loading...</option>');
                $("#LocalLevelId").html('<option>Select Local Level</option>');

                $.get(tenantUrl("/Students/StudentRegistrations/GetDistrictsByProvince"),
                    { provinceId: provinceId },
                    function (data) {
                        let districtDropdown = $("#DistrictId");
                        districtDropdown.empty();
                        districtDropdown.append('<option value="">Select District</option>');
                        $.each(data, function (index, item) {
                            districtDropdown.append(`<option value="${item.id}">${item.name}</option>`);
                        });
                        $('#DistrictId').select2();
                });
            });

            // District -> LocalLevel
            $("#DistrictId").change(function () {
                var districtId = $(this).val();

                $('#LocalLevelId').select2('destroy');
                $("#LocalLevelId").html('<option>Loading...</option>');

                $.get(tenantUrl("/Students/StudentRegistrations/GetLocalLevelsByDistrict"),
                    { districtId: districtId },
                    function (data) {
                        let localDropdown = $("#LocalLevelId");
                        localDropdown.empty();
                        localDropdown.append('<option value="">Select Local Level</option>');
                        $.each(data, function (index, item) {
                            localDropdown.append(`<option value="${item.id}">${item.name}</option>`);
                        });
                        $('#LocalLevelId').select2();
                });
            });

            // Level -> Faculty
            $("#LevelId").change(function () {
                var levelId = $(this).val();

                $('#FacultyId').select2('destroy');
                $('#CollegeId').select2('destroy');
                $('#DepartmentId').select2('destroy');
                $('#ProgramId').select2('destroy');
                $("#FacultyId").html('<option>Loading...</option>');
                $("#CollegeId").html('<option value="">Select College</option>');
                $("#DepartmentId").html('<option value="">Select Department</option>');
                $("#ProgramId").html('<option value="">Select Program</option>');

                if (!levelId) {
                    var facultyDropdown = $("#FacultyId");
                    facultyDropdown.empty();
                    facultyDropdown.append('<option value="">Select Faculty</option>');
                    $('#FacultyId').select2();
                    return;
                }

                $.get(tenantUrl("/Students/StudentRegistrations/GetFacultiesByLevel"),
                    { levelId: levelId },
                    function (data) {
                        var facultyDropdown = $("#FacultyId");
                        facultyDropdown.empty();
                        facultyDropdown.append('<option value="">Select Faculty</option>');
                        $.each(data, function (index, item) {
                            facultyDropdown.append(`<option value="${item.id}">${item.name}</option>`);
                        });
                        $('#FacultyId').select2();
                });
            });

            // Faculty -> College
            $("#FacultyId").change(function () {
                var facultyId = $(this).val();

                $('#CollegeId').select2('destroy');
                $('#DepartmentId').select2('destroy');
                $('#ProgramId').select2('destroy');
                $("#CollegeId").html('<option>Loading...</option>');
                $("#DepartmentId").html('<option value="">Select Department</option>');
                $("#ProgramId").html('<option value="">Select Program</option>');

                if (!facultyId) {
                    var collegeDropdown = $("#CollegeId");
                    collegeDropdown.empty();
                    collegeDropdown.append('<option value="">Select College</option>');
                    $('#CollegeId').select2();
                    return;
                }

                $.get(tenantUrl("/Students/StudentRegistrations/GetCollegesByFaculty"),
                    { facultyId: facultyId },
                    function (data) {
                        var collegeDropdown = $("#CollegeId");
                        collegeDropdown.empty();
                        collegeDropdown.append('<option value="">Select College</option>');
                        $.each(data, function (index, item) {
                            collegeDropdown.append(`<option value="${item.id}">${item.name}</option>`);
                        });
                        $('#CollegeId').select2();
                });
            });

            // College -> Department + Program
            $("#CollegeId").change(function () {
                var collegeId = $(this).val();

                $('#DepartmentId').select2('destroy');
                $('#ProgramId').select2('destroy');
                $("#DepartmentId").html('<option>Loading...</option>');
                $("#ProgramId").html('<option>Loading...</option>');

                if (!collegeId) {
                    $("#DepartmentId").empty().append('<option value="">Select Department</option>');
                    $("#ProgramId").empty().append('<option value="">Select Program</option>');
                    return;
                }

                $.get(tenantUrl("/Students/StudentRegistrations/GetDepartmentsByCollege"),
                    { collegeId: collegeId },
                    function (data) {
                        var deptDropdown = $("#DepartmentId");
                        deptDropdown.empty();
                        deptDropdown.append('<option value="">Select Department</option>');
                        $.each(data, function (index, item) {
                            deptDropdown.append(`<option value="${item.id}">${item.name}</option>`);
                        });
                        $('#DepartmentId').select2();
                });

                loadPrograms();
            });

            // Department -> Program
            $("#DepartmentId").change(function () {
                loadPrograms();
            });

            var convertTimer;
            $("#DateOfBirthBS").on("input", function () {
                var bs = $(this).val().trim();
                if (bs.length === 10) {
                    clearTimeout(convertTimer);
                    convertTimer = setTimeout(function () {
                        $.get(tenantUrl("/Students/StudentRegistrations/ConvertBsToAd"), { bsDate: bs }, function (data) {
                            if (data.adDate) $("#DateOfBirthAD").val(data.adDate);
                        });
                    }, 300);
                }
            });

            $("#DateOfBirthAD").on("input", function () {
                var ad = $(this).val().trim();
                if (ad.length >= 8) {
                    clearTimeout(convertTimer);
                    convertTimer = setTimeout(function () {
                        $.get(tenantUrl("/Students/StudentRegistrations/ConvertAdToBs"), { adDate: ad }, function (data) {
                            if (data.bsDate) $("#DateOfBirthBS").val(data.bsDate);
                        });
                    }, 300);
                }
            });
        });
    </script>
}
