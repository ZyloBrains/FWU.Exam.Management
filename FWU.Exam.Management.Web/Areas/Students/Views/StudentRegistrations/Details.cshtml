@using FWU.Exam.Management.Domain.Entities.Students
@model StudentRegistration

@{
    ViewData["Title"] = "Student Registration Details";
    var isActive = Model?.IsActive == true;
    var isRegGenerated = Model?.IsRegistrationNumberGenerated == true;
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="md:flex md:items-center md:justify-between mb-8 pb-5 border-b border-gray-200">
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl font-bold leading-tight text-gray-900 tracking-tight">Student Details</h1>
            <p class="mt-2 text-sm text-gray-500">Complete academic, personal, and verification information for the student.</p>
        </div>
        <div class="mt-4 flex md:ml-4 md:mt-0 gap-3">
            <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transition-all">
                <svg class="-ml-1 mr-2 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transition-all">
                <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                Edit Registration
            </a>
        </div>
    </div>

    <!-- Quick Stats Profile Banner -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8 overflow-hidden">
        <div class="p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 bg-gradient-to-r from-gray-50 to-white">
            <div class="flex items-center gap-5">
                <div class="h-16 w-16 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-2xl shadow-sm">
                    @(Model?.FirstName?.FirstOrDefault() ?? 'U')@(Model?.LastName?.FirstOrDefault() ?? 'N')
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">@(Model?.FirstName) @(Model?.MiddleName) @(Model?.LastName)</h2>
                    <div class="mt-1 flex items-center gap-2 text-sm text-gray-500">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        @(Model?.Email ?? "No email provided")
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center rounded-full px-3 py-1 font-medium @(isActive ? "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20" : "bg-gray-100 text-gray-700 ring-1 ring-inset ring-gray-500/20")">
                    <svg class="mr-1.5 h-2 w-2 @(isActive ? "text-emerald-500" : "text-gray-400")" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg>
                    @(isActive ? "Active Enrollment" : "Inactive")
                </span>
                <span class="inline-flex items-center rounded-full px-3 py-1 font-medium @(isRegGenerated ? "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20" : "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20")">
                    @(isRegGenerated ? "Registration Generated" : "Pending Generation")
                </span>
            </div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-gray-200 border-t border-gray-200">
            <div class="p-4 sm:px-6">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Registration No.</p>
                <p class="mt-1 text-lg font-semibold text-gray-900">@(Model?.RegistrationNumber ?? "-")</p>
            </div>
            <div class="p-4 sm:px-6">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Academic Year</p>
                <p class="mt-1 text-lg font-semibold text-gray-900">@(Model?.AcademicYear?.AcademicYearName ?? "-")</p>
            </div>
            <div class="p-4 sm:px-6">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Program Level</p>
                <p class="mt-1 text-lg font-semibold text-gray-900">@(Model?.Level?.LevelName ?? "-")</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Personal Info -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-medium text-gray-900 flex items-center">
                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    Personal Information
                </h3>
            </div>
            <div class="px-6 py-5">
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">First Name</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.FirstName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Middle Name</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.MiddleName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Last Name</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.LastName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Nepali Name</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.NepaliName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Date of Birth (BS)</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.DateOfBirthBS ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Date of Birth (AD)</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.DateOfBirthAD ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Gender</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Gender?.GenderName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Blood Group</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.BloodGroup ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Nationality</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Nationality ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Religion</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Religion ?? "-")</dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Contact & Address -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-medium text-gray-900 flex items-center">
                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                    Contact & Address
                </h3>
            </div>
            <div class="px-6 py-5">
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Mobile Number</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.ContactNumber ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Phone</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Phone ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-2">
                        <dt class="text-sm font-medium text-gray-500">Email Address</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Email ?? "-")</dd>
                    </div>
                    
                    <div class="sm:col-span-2 mt-4 pt-4 border-t border-gray-100">
                        <h4 class="text-sm font-semibold text-gray-900 mb-4">Permanent Address</h4>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div class="sm:col-span-1">
                                <dt class="text-sm font-medium text-gray-500">Ward Number</dt>
                                <dd class="mt-1 text-sm text-gray-900">@(Model?.PermanentAddress?.WardNumber?.ToString() ?? "-")</dd>
                            </div>
                            <div class="sm:col-span-1">
                                <dt class="text-sm font-medium text-gray-500">Tole / Street</dt>
                                <dd class="mt-1 text-sm text-gray-900">@(Model?.PermanentAddress?.ToleStreet ?? "-")</dd>
                            </div>
                            <div class="sm:col-span-1">
                                <dt class="text-sm font-medium text-gray-500">House Number</dt>
                                <dd class="mt-1 text-sm text-gray-900">@(Model?.PermanentAddress?.HouseNumber ?? "-")</dd>
                            </div>
                        </div>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Academic Information -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-medium text-gray-900 flex items-center">
                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                    Academic Details
                </h3>
            </div>
            <div class="px-6 py-5">
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
                    <div class="sm:col-span-2">
                        <dt class="text-sm font-medium text-gray-500">College / Institution</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.College?.Name ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Faculty</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Faculty?.Name ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Program</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Program?.ProgramName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Student Category</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.StudentCategory?.StudentCategoryName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Ethnicity</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.Ethnicity?.EthnicityName ?? "-")</dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Verification & Status -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-medium text-gray-900 flex items-center">
                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Verification & Tracking
                </h3>
            </div>
            <div class="px-6 py-5">
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Verified By (User ID)</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.VerifiedBy?.ToString() ?? "Pending Verification")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Verification Date</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(Model?.VerifiedDate?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Entrance Roll Number</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            @if (!string.IsNullOrEmpty(Model?.EntranceRollNumber))
                            {
                                <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded font-medium font-mono text-xs">@Model.EntranceRollNumber</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">System Status</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            @(isActive ? "Active Enrollment" : "Disabled/Archived")
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

    </div>

    <!-- Parents / Guardian Section -->
    @{
        var guardian = ViewBag.Guardian as StudentGuardian;
    }
    @if (guardian != null)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mt-8">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-medium text-gray-900 flex items-center">
                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    Parents / Guardian Information
                </h3>
            </div>
            <div class="px-6 py-5">
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Father Name</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(guardian.FatherName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Father Occupation</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(guardian.FatherProfession ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Father Phone</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(guardian.FatherContactNumber ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Mother Name</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(guardian.MotherName ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Mother Occupation</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(guardian.MotherProfession ?? "-")</dd>
                    </div>
                    <div class="sm:col-span-1">
                        <dt class="text-sm font-medium text-gray-500">Mother Phone</dt>
                        <dd class="mt-1 text-sm text-gray-900">@(guardian.MotherContactNumber ?? "-")</dd>
                    </div>
                </dl>
            </div>
        </div>
    }

    <!-- Qualifications Section -->
    @{
        var qualList = ViewBag.Qualifications as List<StudentQualification>;
    }
    @if (qualList != null && qualList.Count > 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mt-8">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-medium text-gray-900 flex items-center">
                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    Qualifications
                </h3>
            </div>
            <div class="px-6 py-5">
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm text-left">
                        <thead>
                            <tr class="border-b text-gray-500">
                                <th class="py-2 pr-4 font-medium">Level</th>
                                <th class="py-2 pr-4 font-medium">Board</th>
                                <th class="py-2 pr-4 font-medium">Institute</th>
                                <th class="py-2 pr-4 font-medium">Year</th>
                                <th class="py-2 pr-4 font-medium">Percentage</th>
                                <th class="py-2 pr-4 font-medium">Roll No</th>
                                <th class="py-2 font-medium">Document</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in qualList)
                            {
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="py-2 pr-4">@q.PreviousLevel?.PreviousLevelName</td>
                                    <td class="py-2 pr-4">@q.Board?.BoardName</td>
                                    <td class="py-2 pr-4">@q.InstituteName</td>
                                    <td class="py-2 pr-4">@q.PassedYear</td>
                                    <td class="py-2 pr-4">@q.Percentage?.ToString("0.##")%</td>
                                    <td class="py-2 pr-4">@q.ExamRollNumber</td>
                                    <td class="py-2">
                                        @if (!string.IsNullOrEmpty(q.DocumentPath))
                                        {
                                            <a href="@q.DocumentPath" target="_blank" class="text-teal-600 hover:text-teal-800 underline">View</a>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
