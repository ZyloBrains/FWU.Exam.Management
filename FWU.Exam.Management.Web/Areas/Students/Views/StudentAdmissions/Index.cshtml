@model IEnumerable<FWU.Exam.Management.Domain.Entities.Students.StudentAdmission>

@{
    ViewData["Title"] = "Student Admissions";
}

<div class="space-y-6" x-data="{ showFilters: false }">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-user-plus text-teal-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Student Admissions</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage student admissions, track completion status, and generate reports.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> New Admission
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @await Html.PartialAsync("_AlertMessages")

    <!-- Toolbar -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index">
            <input type="hidden" name="sort" value="@ViewBag.Sort" />
            <input type="hidden" name="sortDir" value="@ViewBag.SortDir" />

            <!-- Row 1: Search Box + Actions -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <div class="relative flex-1">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="search" name="search" value="@ViewBag.Search"
                           placeholder="Search by student name, college, program, roll no..."
                           class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <button type="button" x-on:click="showFilters = !showFilters"
                            :class="showFilters ? 'bg-teal-50 text-teal-700 border-teal-200' : 'bg-white text-gray-700 border-gray-200'"
                            class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium border rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-filter text-xs"></i> Filters
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-teal-600 border border-teal-600 rounded-lg hover:bg-teal-700 transition-colors">
                        <i class="fas fa-search text-xs"></i> Search
                    </button>
                    @await Html.PartialAsync("_ExportDropdown", new ExportDropdownModel
                    {
                        RouteValues = new Dictionary<string, string>
                        {
                            ["search"] = ViewBag.Search?.ToString() ?? "",
                            ["sort"] = ViewBag.Sort?.ToString() ?? "",
                            ["sortDir"] = ViewBag.SortDir?.ToString() ?? "",
                            ["collegeId"] = ViewBag.CollegeId?.ToString() ?? "",
                            ["programId"] = ViewBag.ProgramId?.ToString() ?? "",
                            ["fromDate"] = ViewBag.FromDate?.ToString() ?? "",
                            ["toDate"] = ViewBag.ToDate?.ToString() ?? "",
                            ["status"] = ViewBag.Status?.ToString() ?? ""
                        },
                        ButtonClass = "bg-green-600 hover:bg-green-700",
                        ScopeLabel = " (All)"
                    })
                </div>
            </div>

            <!-- Row 2: Filter Dropdowns (Collapsible) -->
            <div x-show="showFilters" x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 -translate-y-2"
                 class="mt-4 pt-4 border-t border-gray-200">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">College</label>
                        <select id="filterCollege" name="collegeId" onchange="loadPrograms(this)" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                            <option value="">All Colleges</option>
                            @if (ViewBag.Colleges is SelectList cList)
                            {
                                foreach (var item in cList)
                                {
                                    <option value="@item.Value" selected="@(item.Value == ViewBag.CollegeId?.ToString())">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Program</label>
                        <select id="filterProgram" name="programId" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                            <option value="">All Programs</option>
                            @if (ViewBag.Programs is SelectList pList)
                            {
                                foreach (var item in pList)
                                {
                                    <option value="@item.Value" selected="@(item.Value == ViewBag.ProgramId?.ToString())">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">From Date</label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">To Date</label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Status</label>
                        <select name="status" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                            <option value="">All Statuses</option>
                            <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                            <option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option>
                            <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                            <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between mt-3 gap-3">
                    <div class="flex items-center gap-2 text-xs text-gray-400">
                        <i class="fas fa-info-circle"></i>
                        <span>Select filters and press Search to apply</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <a asp-action="Index" asp-route-pageSize="@ViewBag.PageSize" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir"
                           class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                            <i class="fas fa-times text-xs"></i> Clear All
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">S.N.</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Student Name</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="college" asp-route-sortDir="@(ViewBag.Sort == "college" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" asp-route-collegeId="@ViewBag.CollegeId" asp-route-programId="@ViewBag.ProgramId" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-status="@ViewBag.Status" class="hover:text-teal-600">College</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="program" asp-route-sortDir="@(ViewBag.Sort == "program" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" asp-route-collegeId="@ViewBag.CollegeId" asp-route-programId="@ViewBag.ProgramId" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-status="@ViewBag.Status" class="hover:text-teal-600">Program</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="admissiondate" asp-route-sortDir="@(ViewBag.Sort == "admissiondate" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" asp-route-collegeId="@ViewBag.CollegeId" asp-route-programId="@ViewBag.ProgramId" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-status="@ViewBag.Status" class="hover:text-teal-600">Admission Date</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="iscompleted" asp-route-sortDir="@(ViewBag.Sort == "iscompleted" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" asp-route-collegeId="@ViewBag.CollegeId" asp-route-programId="@ViewBag.ProgramId" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-status="@ViewBag.Status" class="hover:text-teal-600">Status</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model != null && Model.Any())
                {
                    int sn = ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1;
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                            <td class="px-4 py-3 text-gray-500 text-sm">@sn</td>
                            <td class="px-4 py-3 font-medium text-gray-800 text-sm">
                                @(string.Join(" ", new[] { item.FirstName, item.MiddleName, item.LastName }.Where(p => !string.IsNullOrWhiteSpace(p))))
                            </td>
                            <td class="px-4 py-3 text-gray-600 text-sm">@(item.College?.Name ?? "-")</td>
                            <td class="px-4 py-3 text-gray-600 text-sm">@(item.Program?.ProgramName ?? "-")</td>
                            <td class="px-4 py-3 text-gray-600 text-sm">@item.AdmissionDate.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.IsCompleted ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-800")">
                                    @(item.IsCompleted ? "Completed" : "Pending")
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details">
                                        <i class="fas fa-eye text-xs"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        sn++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-4 py-20 text-center">
                            <div class="flex flex-col items-center">
                                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                                <p class="text-sm text-gray-500">We couldn't find anything matching your search criteria.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile card layout -->
    <div class="lg:hidden space-y-3">
        @if (Model != null && Model.Any())
        {
            int snM = ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1;
            @foreach (var item in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-graduate text-teal-600 text-sm"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-800 text-sm">
                                    @(string.Join(" ", new[] { item.FirstName, item.MiddleName, item.LastName }.Where(p => !string.IsNullOrWhiteSpace(p))))
                                </h3>
                                <p class="text-xs text-gray-500">@(item.College?.Name ?? "-")</p>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-1">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.IsCompleted ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-800")">
                                @(item.IsCompleted ? "Completed" : "Pending")
                            </span>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                        <div class="text-gray-500">Program</div>
                        <div class="text-gray-800">@(item.Program?.ProgramName ?? "-")</div>
                        <div class="text-gray-500">Admission Date</div>
                        <div class="text-gray-800">@item.AdmissionDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="flex items-center gap-2 pt-3 mt-2 border-t border-gray-100">
                        <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                            Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            Edit
                        </a>
                        <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            Delete
                        </a>
                    </div>
                </div>
                snM++;
            }
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">We couldn't find anything matching your search criteria.</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
            <div class="text-sm text-gray-500 font-medium">
                Showing <span class="font-semibold text-gray-900">@(((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1)</span> to <span class="font-semibold text-gray-900">@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalCount))</span> of <span class="font-semibold text-gray-900">@ViewBag.TotalCount</span> entries
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-2">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir" asp-route-collegeId="@ViewBag.CollegeId" asp-route-programId="@ViewBag.ProgramId" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-status="@ViewBag.Status" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        <i class="fas fa-chevron-left text-xs"></i> Previous
                    </a>
                }
                <span class="text-sm font-semibold text-gray-700 min-w-[4rem] text-center">@ViewBag.CurrentPage / @ViewBag.TotalPages</span>
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir" asp-route-collegeId="@ViewBag.CollegeId" asp-route-programId="@ViewBag.ProgramId" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-status="@ViewBag.Status" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        Next <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function loadPrograms(select) {
            var collegeId = select.value;
            var programSelect = document.getElementById('filterProgram');
            programSelect.innerHTML = '<option value="">All Programs</option>';
            if (!collegeId) return;
            $.getJSON('@Url.Action("GetCollegePrograms", "StudentAdmissions")', { collegeId: collegeId }, function (data) {
                $.each(data, function (i, p) {
                    programSelect.appendChild(new Option(p.name, p.id));
                });
            });
        }
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "StudentAdmissions")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}
