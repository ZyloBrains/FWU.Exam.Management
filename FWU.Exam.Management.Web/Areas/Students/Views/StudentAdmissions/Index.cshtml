@model IEnumerable<FWU.Exam.Management.Domain.Entities.Students.StudentAdmission>

@{
    ViewData["Title"] = "Student Admissions";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-user-plus text-teal-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Student Admissions</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage student admissions, track completion status, and generate reports.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> New Admission
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg text-sm flex items-start gap-2">
            <i class="fas fa-check-circle mt-0.5"></i>
            <span>@successMessage</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm flex items-start gap-2">
            <i class="fas fa-exclamation-circle mt-0.5"></i>
            <span>@errorMessage</span>
        </div>
    }

    <!-- Toolbar -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-1">
                <div class="relative flex-1">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <form method="get" asp-action="Index" class="m-0">
                        <input type="search" name="search" value="@ViewBag.Search" placeholder="Search by college, program, roll no..."
                               class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
                        <input type="hidden" name="sort" value="@ViewBag.Sort" />
                        <input type="hidden" name="sortDir" value="@ViewBag.SortDir" />
                    </form>
                </div>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <a asp-action="ExportToCsv" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir" class="inline-flex items-center gap-2 px-3 py-2 bg-emerald-600 text-white text-xs font-medium rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                    <i class="fas fa-file-csv"></i> CSV
                </a>
                <a asp-action="ExportToPdf" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir" class="inline-flex items-center gap-2 px-3 py-2 bg-red-600 text-white text-xs font-medium rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                    <i class="fas fa-file-pdf"></i> PDF
                </a>
                <a asp-action="ExportToExcel" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir" class="inline-flex items-center gap-2 px-3 py-2 bg-green-600 text-white text-xs font-medium rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                    <i class="fas fa-file-excel"></i> Excel
                </a>
            </div>
        </div>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">S.N.</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="collegerollnumber" asp-route-sortDir="@(ViewBag.Sort == "collegerollnumber" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-teal-600">College Roll No.</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="college" asp-route-sortDir="@(ViewBag.Sort == "college" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-teal-600">College</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="program" asp-route-sortDir="@(ViewBag.Sort == "program" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-teal-600">Program</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="admissiondate" asp-route-sortDir="@(ViewBag.Sort == "admissiondate" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-teal-600">Admission Date</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="iscompleted" asp-route-sortDir="@(ViewBag.Sort == "iscompleted" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-teal-600">Status</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">
                        <a asp-action="Index" asp-route-sort="isactive" asp-route-sortDir="@(ViewBag.Sort == "isactive" && ViewBag.SortDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-teal-600">Active</a>
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model != null && Model.Any())
                {
                    int sn = ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1;
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                            <td class="px-4 py-3 text-gray-500 text-sm">@sn</td>
                            <td class="px-4 py-3 font-medium text-gray-800 text-sm">@(item.CollegeRollNumber ?? "-")</td>
                            <td class="px-4 py-3 text-gray-600 text-sm">@(item.College?.Name ?? "-")</td>
                            <td class="px-4 py-3 text-gray-600 text-sm">@(item.Program?.ProgramName ?? "-")</td>
                            <td class="px-4 py-3 text-gray-600 text-sm">@item.AdmissionDate.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.IsCompleted ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-800")">
                                    @(item.IsCompleted ? "Completed" : "Pending")
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-gray-100 text-gray-600")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-1">
                                    @if (!item.IsCompleted)
                                    {
                                        <form asp-action="CompleteAdmission" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-1.5 text-green-600 hover:bg-green-50 rounded-md transition-colors" title="Complete Admission">
                                                <i class="fas fa-check text-xs"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details">
                                        <i class="fas fa-eye text-xs"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        sn++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-4 py-20 text-center">
                            <div class="flex flex-col items-center">
                                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                                <p class="text-sm text-gray-500">We couldn't find anything matching your search criteria.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile card layout -->
    <div class="lg:hidden space-y-3">
        @if (Model != null && Model.Any())
        {
            int snM = ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1;
            @foreach (var item in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-graduate text-teal-600 text-sm"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-800 text-sm">#@(item.CollegeRollNumber ?? "-")</h3>
                                <p class="text-xs text-gray-500">@(item.College?.Name ?? "-")</p>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-1">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.IsCompleted ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-800")">
                                @(item.IsCompleted ? "Completed" : "Pending")
                            </span>
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-gray-100 text-gray-600")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                        <div class="text-gray-500">Program</div>
                        <div class="text-gray-800">@(item.Program?.ProgramName ?? "-")</div>
                        <div class="text-gray-500">Admission Date</div>
                        <div class="text-gray-800">@item.AdmissionDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="flex items-center gap-2 pt-3 mt-2 border-t border-gray-100">
                        @if (!item.IsCompleted)
                        {
                            <form asp-action="CompleteAdmission" asp-route-id="@item.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="flex-1 text-center py-2 text-xs font-medium text-green-700 bg-green-50 rounded-lg hover:bg-green-100">
                                    <i class="fas fa-check mr-1"></i> Complete
                                </button>
                            </form>
                        }
                        <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                            Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            Edit
                        </a>
                        <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            Delete
                        </a>
                    </div>
                </div>
                snM++;
            }
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">We couldn't find anything matching your search criteria.</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
            <div class="text-sm text-gray-500 font-medium">
                Showing <span class="font-semibold text-gray-900">@(((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1)</span> to <span class="font-semibold text-gray-900">@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalCount))</span> of <span class="font-semibold text-gray-900">@ViewBag.TotalCount</span> entries
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-2">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        <i class="fas fa-chevron-left text-xs"></i> Previous
                    </a>
                }
                <span class="text-sm font-semibold text-gray-700 min-w-[4rem] text-center">@ViewBag.CurrentPage / @ViewBag.TotalPages</span>
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-sortDir="@ViewBag.SortDir" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        Next <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "StudentAdmissions")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}
