@model FWU.Exam.Management.Domain.Entities.Students.StudentAdmission

@{
    ViewData["Title"] = "Create Student Admission";
}

<div class="min-h-screen bg-gray-100 py-8">
    <div class="space-y-6">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h1 class="text-xl font-semibold text-gray-800">New Student Admission</h1>
            </div>

            <div class="px-6 py-6">
                <form asp-action="Create" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                    <div class="bg-blue-50 border border-blue-200 rounded-md p-4">
                        <div class="flex items-center gap-2 text-blue-800 mb-2">
                            <i class="fas fa-user-check"></i>
                            <span class="font-medium">Link Existing Student Registration</span>
                        </div>
                        <p class="text-sm text-blue-600 mb-3">Search a registered student to auto-fill the admission form below. Fields already filled will not be overwritten.</p>

                        <div id="selectedStudentBox" class="@(ViewBag.SelectedStudent != null ? "" : "hidden") bg-teal-50 border border-teal-200 rounded-md p-3 mb-3">
                            @{
                                var linkedReg = ViewBag.SelectedStudent as FWU.Exam.Management.Domain.Entities.Students.StudentRegistration;
                            }
                            <div class="flex items-center justify-between gap-2">
                                <div class="text-sm text-teal-800">
                                    <span class="font-medium">Linked to:</span>
                                    <span id="linkedName">@(linkedReg?.FirstName) @(linkedReg?.MiddleName) @(linkedReg?.LastName)</span>
                                    <span id="linkedRegNo" class="text-teal-600">(@linkedReg?.RegistrationNumber)</span>
                                </div>
                                <button type="button" id="clearStudentBtn" class="text-xs text-red-600 hover:text-red-700 font-medium">
                                    <i class="fas fa-times"></i> Clear
                                </button>
                            </div>
                        </div>

                        <div class="flex gap-2">
                            <input type="text" id="studentSearch" placeholder="Search by name, email or registration number..."
                                   class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm" />
                            <button type="button" id="searchStudentBtn" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700 transition">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                        <div id="studentResults" class="mt-3 hidden"></div>
                        <input type="hidden" name="studentRegistrationId" id="selectedStudentId"
                               value="@(ViewBag.StudentRegistrationId?.ToString() ?? "")" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College *</label>
                            <select asp-for="CollegeId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.CollegeId">
                                <option value="">Select College</option>
                            </select>
                            <span asp-validation-for="CollegeId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="ProgramsId" class="block text-sm font-medium text-gray-700 mb-1">Program *</label>
                            <select asp-for="ProgramsId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.ProgramsId">
                                <option value="">Select Program</option>
                            </select>
                            <span asp-validation-for="ProgramsId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="AdmissionDate" class="block text-sm font-medium text-gray-700 mb-1">Admission Date *</label>
                            <input asp-for="AdmissionDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="AdmissionDate" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="AcademicYearId" class="block text-sm font-medium text-gray-700 mb-1">Academic Year *</label>
                            <select asp-for="AcademicYearId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.AcademicYearId">
                                <option value="">Select Academic Year</option>
                            </select>
                            <span asp-validation-for="AcademicYearId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="CollegeRollNumber" class="block text-sm font-medium text-gray-700 mb-1">College Roll Number</label>
                            <input asp-for="CollegeRollNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="CollegeRollNumber" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1">First Name *</label>
                            <input asp-for="FirstName" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="FirstName" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="MiddleName" class="block text-sm font-medium text-gray-700 mb-1">Middle Name</label>
                            <input asp-for="MiddleName" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="MiddleName" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name *</label>
                            <input asp-for="LastName" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="LastName" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="NepaliName" class="block text-sm font-medium text-gray-700 mb-1">Nepali Name</label>
                            <input asp-for="NepaliName" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="NepaliName" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="DateOfBirthBS" class="block text-sm font-medium text-gray-700 mb-1">Date of Birth (BS)</label>
                            <input asp-for="DateOfBirthBS" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="DateOfBirthBS" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="DateOfBirthAD" class="block text-sm font-medium text-gray-700 mb-1">Date of Birth (AD)</label>
                            <input asp-for="DateOfBirthAD" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="DateOfBirthAD" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="GenderId" class="block text-sm font-medium text-gray-700 mb-1">Gender</label>
                            <select asp-for="GenderId" asp-items="ViewBag.GenderId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                <option value="">Select Gender</option>
                            </select>
                            <span asp-validation-for="GenderId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="ContactNumber" class="block text-sm font-medium text-gray-700 mb-1">Contact Number</label>
                            <input asp-for="ContactNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="ContactNumber" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="Phone" class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                            <input asp-for="Phone" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="Phone" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input asp-for="Email" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="CheckedBy" class="block text-sm font-medium text-gray-700 mb-1">Checked By</label>
                            <input asp-for="CheckedBy" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="CheckedBy" class="text-red-600 text-xs"></span>
                        </div>

                        <input type="hidden" asp-for="AppUserId" />

                        <div class="flex items-center pt-6">
                            <label class="inline-flex items-center">
                                <input asp-for="HasFeeExemption" class="rounded border-gray-300 text-teal-600 shadow-sm focus:border-teal-300 focus:ring focus:ring-teal-200 focus:ring-opacity-50" />
                                <span class="ml-2 text-sm text-gray-700">Has Fee Exemption</span>
                            </label>
                        </div>

                        <div class="flex items-center pt-6">
                            <label class="inline-flex items-center">
                                <input asp-for="IsCompleted" class="rounded border-gray-300 text-teal-600 shadow-sm focus:border-teal-300 focus:ring focus:ring-teal-200 focus:ring-opacity-50" />
                                <span class="ml-2 text-sm text-gray-700">Is Completed</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3 pt-4 border-t border-gray-100">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded-md text-sm hover:bg-teal-700 transition">Save changes</button>
                        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="~/lib/select2/css/select2.min.css" asp-append-version="true" rel="stylesheet" />
    <script src="~/lib/select2/js/select2.min.js" asp-append-version="true"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #14b8a6;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(20,184,166,0.2);
        }
    </style>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(function () {
            $('.select2').select2({ width: 'resolve' });

            $("#CollegeId").change(function () {
                var collegeId = $(this).val();
                $('#ProgramsId').select2('destroy');

                if (!collegeId) {
                    $("#ProgramsId").empty().append('<option value="">Select Program</option>');
                    $('#ProgramsId').select2({width:'resolve'});
                    return;
                }

                $.get(tenantUrl("/Students/StudentAdmissions/GetCollegePrograms"), { collegeId: collegeId }, function (data) {
                    var programDropdown = $("#ProgramsId");
                    programDropdown.empty();
                    programDropdown.append('<option value="">Select Program</option>');
                    $.each(data, function (index, item) {
                        programDropdown.append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                    programDropdown.select2({width:'resolve'});
                });
            });

            $("#searchStudentBtn").click(function () {
                var searchTerm = $("#studentSearch").val().trim();
                if (searchTerm.length < 2) return;

                var collegeId = $("#CollegeId").val();

                $.get(tenantUrl("/Students/StudentAdmissions/SearchStudents"), { search: searchTerm, collegeId: collegeId }, function (data) {
                    var container = $("#studentResults");
                    container.removeClass("hidden").empty();

                    if (data.length === 0) {
                        container.html('<p class="text-sm text-gray-500">No students found.</p>');
                        return;
                    }

                    var html = '<table class="w-full text-sm border rounded-md">';
                    html += '<thead><tr class="bg-gray-50 border-b"><th class="px-3 py-2 text-left">Reg No</th><th class="px-3 py-2 text-left">Name</th><th class="px-3 py-2 text-left">Email</th><th class="px-3 py-2 text-left">Program</th><th class="px-3 py-2">Action</th></tr></thead><tbody>';
                    $.each(data, function (i, s) {
                        html += '<tr class="border-b hover:bg-gray-50">';
                        html += '<td class="px-3 py-2">' + (s.registrationNumber || '-') + '</td>';
                        html += '<td class="px-3 py-2">' + (s.fullName || '-') + '</td>';
                        html += '<td class="px-3 py-2">' + (s.email || '-') + '</td>';
                        html += '<td class="px-3 py-2">' + (s.programName || '-') + '</td>';
                        html += '<td class="px-3 py-2 text-center"><button type="button" class="select-student px-3 py-1 bg-teal-600 text-white rounded text-xs hover:bg-teal-700" data-json="' + encodeURIComponent(JSON.stringify(s)) + '">Select</button></td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    container.html(html);
                });
            });

            function setSelectValue($sel, value) {
                $sel.select2('destroy');
                if (value) {
                    $sel.val(value);
                } else {
                    $sel.val(null).trigger('change');
                }
                $sel.select2({ width: 'resolve' });
            }

            function fillSelectIfEmpty($sel, value) {
                if (!value) return;
                if ($sel.val() === '' || $sel.val() === null) {
                    setSelectValue($sel, value);
                }
            }

            function fillIfEmpty($input, value) {
                if (!value) return;
                if ($input.is(':checkbox')) return;
                if ($input.val() === '' || $input.val() === null) {
                    $input.val(value);
                }
            }

            function showLinked(s, id) {
                $("#selectedStudentBox").removeClass("hidden");
                $("#linkedName").text(s.fullName || '');
                $("#linkedRegNo").text((s.registrationNumber ? '(' + s.registrationNumber + ')' : ''));
                $("#selectedStudentId").val(id);
                $("#studentResults").addClass("hidden");
            }

            function applyStudentToForm(s) {
                fillIfEmpty($("#FirstName"), s.firstName);
                fillIfEmpty($("#MiddleName"), s.middleName);
                fillIfEmpty($("#LastName"), s.lastName);
                fillIfEmpty($("#NepaliName"), s.nepaliName);
                fillIfEmpty($("#DateOfBirthBS"), s.dateOfBirthBS);
                fillIfEmpty($("#DateOfBirthAD"), s.dateOfBirthAD);
                fillIfEmpty($("#ContactNumber"), s.contactNumber);
                fillIfEmpty($("#Phone"), s.phone);
                fillIfEmpty($("#Email"), s.email);
                fillIfEmpty($("#CollegeRollNumber"), s.registrationNumber);
                fillSelectIfEmpty($("#GenderId"), s.genderId);
                fillSelectIfEmpty($("#AcademicYearId"), s.academicYearId);

                var $college = $("#CollegeId");
                var currentCollege = $college.val();
                if (s.collegeId && (!currentCollege || currentCollege === '')) {
                    setSelectValue($college, s.collegeId);
                    // After college is set, load its programs and select the matching program
                    $.get(tenantUrl("/Students/StudentAdmissions/GetCollegePrograms"), { collegeId: s.collegeId }, function (progData) {
                        var $program = $("#ProgramsId");
                        $program.select2('destroy');
                        $program.empty().append('<option value="">Select Program</option>');
                        $.each(progData, function (idx, item) {
                            $program.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                        if (s.programId && ($program.val() === '' || $program.val() === null)) {
                            $program.val(String(s.programId));
                        }
                        $program.select2({ width: 'resolve' });
                    });
                } else {
                    fillSelectIfEmpty($("#ProgramsId"), s.programId);
                }
            }

            $(document).on("click", ".select-student", function () {
                var s = JSON.parse(decodeURIComponent($(this).data("json")));
                applyStudentToForm(s);
                showLinked(s, s.id);
            });

            $("#clearStudentBtn").click(function () {
                $("#selectedStudentId").val('');
                $("#selectedStudentBox").addClass("hidden");
            });
        });
    </script>
}
