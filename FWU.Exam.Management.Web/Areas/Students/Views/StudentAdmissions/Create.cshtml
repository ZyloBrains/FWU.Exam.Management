@model FWU.Exam.Management.Domain.Entities.Students.StudentAdmission

@{
    ViewData["Title"] = "Create Student Admission";
}

<div class="min-h-screen bg-gray-100 py-8">
    <div class="space-y-6">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h1 class="text-xl font-semibold text-gray-800">New Student Admission</h1>
            </div>

            <div class="px-6 py-6">
                <form asp-action="Create" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                    @if (ViewBag.SelectedStudent != null)
                    {
                        var reg = ViewBag.SelectedStudent as FWU.Exam.Management.Domain.Entities.Students.StudentRegistration;
                        <div class="bg-teal-50 border border-teal-200 rounded-md p-4">
                            <div class="flex items-center gap-2 text-teal-800 mb-2">
                                <i class="fas fa-user-check"></i>
                                <span class="font-medium">Admitting Student:</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-sm text-teal-700">
                                <div><strong>Name:</strong> @(reg?.FirstName) @(reg?.LastName)</div>
                                <div><strong>Reg No:</strong> @reg?.RegistrationNumber</div>
                                <div><strong>Email:</strong> @reg?.Email</div>
                                <div><strong>Program:</strong> @reg?.Program?.ProgramName</div>
                            </div>
                            <input type="hidden" name="studentRegistrationId" value="@reg?.Id" />
                        </div>
                    }
                    else
                    {
                        <div class="bg-blue-50 border border-blue-200 rounded-md p-4">
                            <div class="flex items-center gap-2 text-blue-800 mb-2">
                                <i class="fas fa-info-circle"></i>
                                <span class="font-medium">Select a Student</span>
                            </div>
                            <p class="text-sm text-blue-600 mb-3">Search and select a student registration to auto-fill admission details.</p>
                            <div class="flex gap-2">
                                <input type="text" id="studentSearch" placeholder="Search by name, email or registration number..."
                                       class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm" />
                                <button type="button" id="searchStudentBtn" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700 transition">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                            <div id="studentResults" class="mt-3 hidden"></div>
                            <input type="hidden" name="studentRegistrationId" id="selectedStudentId" value="" />
                        </div>
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College *</label>
                            <select asp-for="CollegeId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.CollegeId">
                                <option value="">Select College</option>
                            </select>
                            <span asp-validation-for="CollegeId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="ProgramsId" class="block text-sm font-medium text-gray-700 mb-1">Program *</label>
                            <select asp-for="ProgramsId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.ProgramsId">
                                <option value="">Select Program</option>
                            </select>
                            <span asp-validation-for="ProgramsId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="AdmissionDate" class="block text-sm font-medium text-gray-700 mb-1">Admission Date *</label>
                            <input asp-for="AdmissionDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="AdmissionDate" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="CollegeRollNumber" class="block text-sm font-medium text-gray-700 mb-1">College Roll Number</label>
                            <input asp-for="CollegeRollNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="CollegeRollNumber" class="text-red-600 text-xs"></span>
                        </div>

                        <input type="hidden" asp-for="AppUserId" />

                        <div class="flex items-center pt-6">
                            <label class="inline-flex items-center">
                                <input asp-for="HasFeeExemption" class="rounded border-gray-300 text-teal-600 shadow-sm focus:border-teal-300 focus:ring focus:ring-teal-200 focus:ring-opacity-50" />
                                <span class="ml-2 text-sm text-gray-700">Has Fee Exemption</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3 pt-4 border-t border-gray-100">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded-md text-sm hover:bg-teal-700 transition">Save changes</button>
                        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #14b8a6;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(20,184,166,0.2);
        }
    </style>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            $('select:not(#CollegeId):not(#ProgramsId)').select2({ width: '100%' });

            $("#CollegeId").change(function () {
                var collegeId = $(this).val();
                $("#ProgramsId").html('<option value="">Loading...</option>');

                $.get(tenantUrl("/Students/StudentAdmissions/GetCollegePrograms"), { collegeId: collegeId }, function (data) {
                    var programDropdown = $("#ProgramsId");
                    programDropdown.empty();
                    programDropdown.append('<option value="">Select Program</option>');
                    $.each(data, function (index, item) {
                        programDropdown.append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });

            $("#searchStudentBtn").click(function () {
                var searchTerm = $("#studentSearch").val().trim();
                if (searchTerm.length < 2) return;

                var collegeId = $("#CollegeId").val();
                if (!collegeId) {
                    alert("Please select a college first.");
                    return;
                }

                $.get(tenantUrl("/Students/StudentAdmissions/SearchStudents"), { search: searchTerm, collegeId: collegeId }, function (data) {
                    var container = $("#studentResults");
                    container.removeClass("hidden").empty();

                    if (data.length === 0) {
                        container.html('<p class="text-sm text-gray-500">No students found.</p>');
                        return;
                    }

                    var html = '<table class="w-full text-sm border rounded-md">';
                    html += '<thead><tr class="bg-gray-50 border-b"><th class="px-3 py-2 text-left">Reg No</th><th class="px-3 py-2 text-left">Name</th><th class="px-3 py-2 text-left">Email</th><th class="px-3 py-2">Action</th></tr></thead><tbody>';
                    $.each(data, function (i, s) {
                        html += '<tr class="border-b hover:bg-gray-50">';
                        html += '<td class="px-3 py-2">' + (s.registrationNumber || '-') + '</td>';
                        html += '<td class="px-3 py-2">' + s.fullName + '</td>';
                        html += '<td class="px-3 py-2">' + s.email + '</td>';
                        html += '<td class="px-3 py-2 text-center"><button type="button" class="select-student px-3 py-1 bg-teal-600 text-white rounded text-xs hover:bg-teal-700" data-id="' + s.id + '" data-name="' + s.fullName + '" data-reg="' + (s.registrationNumber || '') + '" data-email="' + s.email + '" data-program="' + (s.program || '') + '">Select</button></td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    container.html(html);
                });
            });

            $(document).on("click", ".select-student", function () {
                var id = $(this).data("id");
                var name = $(this).data("name");
                var reg = $(this).data("reg");
                var email = $(this).data("email");
                var program = $(this).data("program");

                $("#selectedStudentId").val(id);
                $("#studentResults").addClass("hidden");

                var infoHtml = '<div class="bg-teal-50 border border-teal-200 rounded-md p-4">';
                infoHtml += '<div class="flex items-center gap-2 text-teal-800 mb-2"><i class="fas fa-user-check"></i><span class="font-medium">Admitting Student:</span></div>';
                infoHtml += '<div class="grid grid-cols-2 gap-2 text-sm text-teal-700">';
                infoHtml += '<div><strong>Name:</strong> ' + name + '</div>';
                infoHtml += '<div><strong>Reg No:</strong> ' + reg + '</div>';
                infoHtml += '<div><strong>Email:</strong> ' + email + '</div>';
                infoHtml += '<div><strong>Program:</strong> ' + program + '</div>';
                infoHtml += '</div><input type="hidden" name="studentRegistrationId" value="' + id + '" /></div>';

                $("#studentSearch").closest(".bg-blue-50").replaceWith(infoHtml);
            });

            @if (ViewBag.StudentRegistrationId != null)
            {
                <text>
                // Auto-search the pre-selected student
                var preId = @ViewBag.StudentRegistrationId;
                </text>
            }
        });
    </script>
}
