@model FWU.Exam.Management.Domain.Entities.Students.StudentAdmission

@{
    ViewData["Title"] = "Create Student Admission";
}

<div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h1 class="text-xl font-semibold text-gray-800">New Student Admission</h1>
            </div>

            <div class="px-6 py-6">
                <form asp-action="Create" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College *</label>
                            <select asp-for="CollegeId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.CollegeId">
                                <option value="">Select College</option>
                            </select>
                            <span asp-validation-for="CollegeId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="ProgramsId" class="block text-sm font-medium text-gray-700 mb-1">Program *</label>
                            <select asp-for="ProgramsId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.ProgramsId">
                                <option value="">Select Program</option>
                            </select>
                            <span asp-validation-for="ProgramsId" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="AdmissionDate" class="block text-sm font-medium text-gray-700 mb-1">Admission Date *</label>
                            <input asp-for="AdmissionDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="AdmissionDate" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="CollegeRollNumber" class="block text-sm font-medium text-gray-700 mb-1">College Roll Number</label>
                            <input asp-for="CollegeRollNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="CollegeRollNumber" class="text-red-600 text-xs"></span>
                        </div>

                        <div>
                            <label asp-for="AppUserId" class="block text-sm font-medium text-gray-700 mb-1">App User ID</label>
                            <input asp-for="AppUserId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            <span asp-validation-for="AppUserId" class="text-red-600 text-xs"></span>
                        </div>

                        <div class="flex items-center pt-6">
                            <label class="inline-flex items-center">
                                <input asp-for="HasFeeExemption" class="rounded border-gray-300 text-teal-600 shadow-sm focus:border-teal-300 focus:ring focus:ring-teal-200 focus:ring-opacity-50" />
                                <span class="ml-2 text-sm text-gray-700">Has Fee Exemption</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3 pt-4 border-t border-gray-100">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded-md text-sm hover:bg-teal-700 transition">Save changes</button>
                        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            $("#CollegeId").change(function () {
                var collegeId = $(this).val();
                $("#ProgramsId").html('<option value="">Loading...</option>');

                $.get(tenantUrl("/Students/StudentAdmissions/GetCollegePrograms"), { collegeId: collegeId }, function (data) {
                    var programDropdown = $("#ProgramsId");
                    programDropdown.empty();
                    programDropdown.append('<option value="">Select Program</option>');
                    $.each(data, function (index, item) {
                        programDropdown.append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });
        });
    </script>
}
