@model IEnumerable<FWU.Exam.Management.Domain.Entities.Exams.RetotalRequest>

@{
    ViewData["Title"] = "My Retotal Requests";
}

<div class="space-y-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-redo-alt text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Retotal / Re-evaluation Requests</h1>
                <p class="text-sm text-gray-500 mt-0.5">Track your re-evaluation requests for exam results.</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        @* Desktop Table (hidden on mobile) *@
        <div class="overflow-x-auto hidden sm:block">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Exam Schedule</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Subject</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Original Grade</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Revised Grade</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Fee</th>
                        <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Requested</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3 text-gray-600">@(item.ExamRegistration?.ExamSchedule?.ExamScheduleName ?? "-")</td>
                            <td class="px-4 py-3 text-gray-800 font-medium">@(item.ExamSubjectResult?.SubjectOffering?.SubjectCatalog?.SubjectName ?? "-")</td>
                            <td class="px-4 py-3">
                                <span class="font-semibold text-gray-800">@(item.OriginalGradeLetter ?? "-")</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (item.RetotalledGradeLetter != null)
                                {
                                    <span class="font-semibold text-green-600">@item.RetotalledGradeLetter</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                @{
                                    var statusColor = item.Status switch
                                    {
                                        FWU.Exam.Management.Domain.Enums.RetotalStatus.Pending => "bg-yellow-100 text-yellow-700",
                                        FWU.Exam.Management.Domain.Enums.RetotalStatus.UnderReview => "bg-blue-100 text-blue-700",
                                        FWU.Exam.Management.Domain.Enums.RetotalStatus.Approved => "bg-green-100 text-green-700",
                                        FWU.Exam.Management.Domain.Enums.RetotalStatus.Rejected => "bg-red-100 text-red-700",
                                        FWU.Exam.Management.Domain.Enums.RetotalStatus.Completed => "bg-gray-100 text-gray-700",
                                        _ => "bg-gray-100 text-gray-700"
                                    };
                                }
                                <span class="px-2 py-0.5 text-xs font-medium @statusColor rounded-full">@item.Status</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (item.FeePaid)
                                {
                                    <span class="text-green-600 text-xs font-medium">Paid</span>
                                }
                                else
                                {
                                    <span class="text-red-600 text-xs font-medium">Unpaid</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-gray-500 text-xs">@item.RequestedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobile Card Layout (hidden on sm+) *@
        <div class="sm:hidden divide-y divide-gray-100">
            @foreach (var item in Model)
            {
                var mobileStatusColor = item.Status switch
                {
                    FWU.Exam.Management.Domain.Enums.RetotalStatus.Pending => "bg-yellow-100 text-yellow-700",
                    FWU.Exam.Management.Domain.Enums.RetotalStatus.UnderReview => "bg-blue-100 text-blue-700",
                    FWU.Exam.Management.Domain.Enums.RetotalStatus.Approved => "bg-green-100 text-green-700",
                    FWU.Exam.Management.Domain.Enums.RetotalStatus.Rejected => "bg-red-100 text-red-700",
                    FWU.Exam.Management.Domain.Enums.RetotalStatus.Completed => "bg-gray-100 text-gray-700",
                    _ => "bg-gray-100 text-gray-700"
                };
                <div class="p-4 space-y-2">
                    <div class="flex items-start justify-between gap-2">
                        <p class="text-sm font-medium text-gray-900 min-w-0 truncate">@(item.ExamSubjectResult?.SubjectOffering?.SubjectCatalog?.SubjectName ?? "-")</p>
                        <span class="px-2 py-0.5 text-xs font-medium @mobileStatusColor rounded-full shrink-0">@item.Status</span>
                    </div>
                    <p class="text-xs text-gray-500 truncate">@(item.ExamRegistration?.ExamSchedule?.ExamScheduleName ?? "-")</p>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="text-gray-500">Original: <span class="font-semibold text-gray-800">@(item.OriginalGradeLetter ?? "-")</span></span>
                        @if (item.RetotalledGradeLetter != null)
                        {
                            <span class="text-gray-500">Revised: <span class="font-semibold text-green-600">@item.RetotalledGradeLetter</span></span>
                        }
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-gray-400">@item.RequestedDate.ToString("yyyy-MM-dd")</span>
                        @if (item.FeePaid)
                        {
                            <span class="text-green-600 font-medium">Paid</span>
                        }
                        else
                        {
                            <span class="text-red-600 font-medium">Unpaid</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <i class="fas fa-redo-alt text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No retotal requests</h3>
                <p class="text-sm text-gray-500">You haven't submitted any re-evaluation requests yet.</p>
                <a asp-action="RequestRetotal" asp-area="Students" class="inline-flex items-center gap-2 mt-4 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Request Retotal
                </a>
            </div>
        }
    </div>

    @if (Model.Any())
    {
        <div class="text-center">
            <a asp-action="RequestRetotal" asp-area="Students" class="inline-flex items-center gap-2 w-full sm:w-auto justify-center px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> New Retotal Request
            </a>
        </div>
    }
</div>
