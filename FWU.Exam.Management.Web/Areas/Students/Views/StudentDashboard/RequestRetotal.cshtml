@{
    ViewData["Title"] = "Request Retotal";
    var examSubjectResultId = ViewBag.ExamSubjectResultId as int?;
    var subjectName = ViewBag.SubjectName as string ?? "Select a subject from your marksheet";
    var originalGrade = ViewBag.OriginalGrade as string;
    var originalMarks = ViewBag.OriginalMarks as decimal?;
    var examScheduleName = ViewBag.ExamScheduleName as string;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-redo-alt text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Request Re-evaluation</h1>
                <p class="text-sm text-gray-500 mt-0.5">Submit a retotal request for re-evaluation of your exam result.</p>
            </div>
        </div>
        <a asp-action="RetotalRequests" asp-area="Students" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors self-start">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    @if (!examSubjectResultId.HasValue)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="text-center py-8">
                <i class="fas fa-info-circle text-4xl text-blue-300 mb-4"></i>
                <h3 class="text-lg font-semibold text-gray-800 mb-2">Select from Marksheet</h3>
                <p class="text-sm text-gray-500 mb-4">
                    Go to your marksheet, find the subject you want re-evaluated, and click the "Request Retotal" button on that subject.
                </p>
                <a asp-action="Marksheet" asp-area="Students" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-file-alt"></i> Go to Marksheet
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="px-4 sm:px-6 py-4 border-b border-gray-100">
                <h2 class="text-lg font-semibold text-gray-800">Subject Details</h2>
            </div>
            <div class="p-4 sm:p-6 space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Exam Schedule</label>
                        <p class="mt-1 text-sm text-gray-900">@examScheduleName</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Subject</label>
                        <p class="mt-1 text-sm text-gray-900 font-medium">@subjectName</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Current Grade</label>
                        <p class="mt-1 text-sm text-gray-900">@originalGrade</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Current Marks</label>
                        <p class="mt-1 text-sm text-gray-900">@originalMarks?.ToString("N2")</p>
                    </div>
                </div>
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-yellow-800">
                    <i class="fas fa-info-circle mr-1"></i>
                    A fee of <strong>Rs. 500</strong> per subject is required for re-evaluation.
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-4">Submit Request</h2>
            <form method="post" asp-action="SubmitRetotalRequest" asp-area="Students">
                @Html.AntiForgeryToken()
                <input type="hidden" name="examSubjectResultId" value="@examSubjectResultId.Value" />
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Reason for Re-evaluation</label>
                        <textarea name="reason" rows="3" maxlength="500" required
                                  class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                  placeholder="Explain why you believe the marks should be re-evaluated..."></textarea>
                    </div>
                    <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                        <i class="fas fa-paper-plane"></i> Submit Request
                    </button>
                </div>
            </form>
        </div>
    }
</div>
