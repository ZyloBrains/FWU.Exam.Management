@model FWU.Exam.Management.Web.ViewModels.ReapplyExamViewModel

@{
    ViewData["Title"] = "Re-apply Exam Form";
}

<div class="min-h-screen pb-20 sm:pb-6">
    @await Html.PartialAsync("_AlertMessages")

    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-br from-blue-600 via-blue-700 to-blue-800 mb-4 sm:mb-6">
        <div class="absolute inset-0 bg-grid-white/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
        <div class="absolute top-0 right-0 w-48 h-48 sm:w-72 sm:h-72 bg-blue-400/10 rounded-full blur-3xl"></div>
        <div class="relative px-4 py-4 sm:px-8 sm:py-6">
            <div class="flex items-start gap-3 sm:gap-4">
                <div class="h-10 w-10 sm:h-14 sm:w-14 bg-white/10 backdrop-blur-xl rounded-xl sm:rounded-2xl flex items-center justify-center shadow-2xl border border-white/20 shrink-0">
                    <svg class="h-5 w-5 sm:h-7 sm:w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-lg sm:text-2xl font-extrabold text-white tracking-tight truncate">Re-apply Exam Form</h1>
                    <p class="mt-0.5 text-blue-200/80 text-xs sm:text-sm truncate">@Model.ExamScheduleName</p>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                        @if (!string.IsNullOrWhiteSpace(Model.SemesterName))
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-white/10 backdrop-blur-sm rounded-md text-[11px] sm:text-xs font-medium text-white/90 border border-white/10">
                                <i class="fas fa-layer-group text-blue-200 text-[9px]"></i>
                                @Model.SemesterName
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ExamTypeName))
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-white/10 backdrop-blur-sm rounded-md text-[11px] sm:text-xs font-medium text-white/90 border border-white/10">
                                <i class="fas fa-clipboard-list text-blue-200 text-[9px]"></i>
                                @Model.ExamTypeName
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.EndDateBs))
                    {
                        <div class="mt-2 sm:ml-[3.75rem]">
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-red-500/20 backdrop-blur-sm rounded-lg text-[11px] sm:text-xs font-semibold text-white border border-red-400/30">
                                <i class="fas fa-clock text-red-200"></i>
                                Submission Deadline: @Model.EndDateBs BS
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="grid gap-3 md:grid-cols-2">
        <!-- Rejection reason -->
        <div class="rounded-xl border border-red-200 bg-red-50 p-3 flex items-start gap-2.5">
            <div class="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center bg-red-100 text-red-600 text-sm">
                <i class="fas fa-ban"></i>
            </div>
            <div class="min-w-0 text-xs sm:text-sm text-red-800">
                <span class="font-semibold">Your previous exam form was rejected</span>
                @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                {
                    <p class="mt-0.5 leading-snug"><span class="font-semibold">Reason:</span> @Model.RejectionReason</p>
                }
            </div>
        </div>

        <!-- Already paid -->
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 flex items-start gap-2.5">
            <div class="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center bg-emerald-100 text-emerald-600 text-sm">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="min-w-0 text-xs sm:text-sm text-emerald-800">
                <span class="font-semibold">Payment already confirmed</span>
                <p class="mt-0.5 leading-snug">Paid: <span class="font-bold">Rs. @Model.PaidAmount.ToString("N2")</span>. Additional papers cost only the difference &mdash; reductions are not refunded.</p>
            </div>
        </div>
    </div>

    @if (Model.HasUnpaidTopUp)
    {
        <div class="mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 flex items-start gap-2.5">
            <div class="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center bg-amber-100 text-amber-600 text-sm">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="min-w-0 text-xs sm:text-sm text-amber-800">
                <span class="font-semibold">You have an unfinished additional payment</span>
                <p class="mt-0.5 leading-snug">A previous attempt added extra papers but the difference was never paid. Submitting again will replace it automatically.</p>
            </div>
        </div>
    }

    <!-- Subject selection -->
    <form id="reapplyForm" asp-action="ApplyAgain" asp-route-examScheduleId="@Model.ExamScheduleId" method="post"
          data-exam-fee="@Model.ExamFee" data-practical-fee="@Model.PracticalFee" data-paid="@Model.PaidAmount" class="mt-3 sm:mt-4">
        <input type="hidden" name="examScheduleId" value="@Model.ExamScheduleId" />
        <input type="hidden" name="selectedSubjectIds" id="hfSelectedSubjectIds" />
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
            <div class="flex items-center gap-2.5 px-4 sm:px-5 py-3 border-b border-gray-100 shrink-0">
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-md shadow-blue-500/20">
                    <i class="fas fa-book text-white text-xs"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-sm sm:text-base font-bold text-gray-900">Subject Selection</h2>
                    <p class="text-[11px] sm:text-xs text-gray-500 truncate">@Model.SemesterName &mdash; tick the papers you need to re-sit</p>
                </div>
            </div>

            <div class="max-h-[19rem] sm:max-h-[22rem] overflow-y-auto overscroll-contain">
                <table class="w-full text-sm text-left">
                    <thead class="bg-gray-50 sticky top-0 z-10">
                        <tr>
                            <th class="px-3 sm:px-5 py-2.5 text-[11px] font-semibold text-gray-500 uppercase w-12">SN</th>
                            <th class="px-3 sm:px-5 py-2.5 text-[11px] font-semibold text-gray-500 uppercase">Subject</th>
                            <th class="px-3 sm:px-5 py-2.5 text-[11px] font-semibold text-gray-500 uppercase hidden sm:table-cell">Code</th>
                            <th class="px-3 sm:px-5 py-2.5 text-[11px] font-semibold text-gray-500 uppercase text-center">Theory</th>
                            <th class="px-3 sm:px-5 py-2.5 text-[11px] font-semibold text-gray-500 uppercase text-center">Practical</th>
                            <th class="px-3 sm:px-5 py-2.5 text-[11px] font-semibold text-gray-500 uppercase text-right">Practical Fee</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 bg-white">
                        @{
                            var sn = 0;
                        }
                        @foreach (var s in Model.Subjects)
                        {
                            if (!s.HasTheory && !s.HasPractical)
                            {
                                continue;
                            }
                            sn++;
                            <tr class="hover:bg-gray-50 transition-colors @(s.FailedTheory || s.FailedPractical ? "bg-red-50/40" : "")">
                                <td class="px-3 sm:px-5 py-2 text-gray-500">@sn</td>
                                <td class="px-3 sm:px-5 py-2 min-w-0">
                                    <span class="block text-xs sm:text-sm font-medium text-gray-900 truncate">@s.SubjectName</span>
                                    @if (s.IsCompulsory || !string.IsNullOrWhiteSpace(s.SubjectTypeName))
                                    {
                                        <span class="mt-0.5 flex items-center gap-1 flex-wrap">
                                            @if (s.IsCompulsory)
                                            {
                                                <span class="inline-flex items-center px-1.5 py-px rounded text-[9px] font-semibold bg-blue-100 text-blue-700">Compulsory</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(s.SubjectTypeName))
                                            {
                                                <span class="inline-flex items-center px-1.5 py-px rounded text-[9px] font-medium bg-gray-100 text-gray-600">@s.SubjectTypeName</span>
                                            }
                                        </span>
                                    }
                                </td>
                                <td class="px-3 sm:px-5 py-2 text-xs text-gray-500 hidden sm:table-cell">@s.SubjectCode</td>
                                <td class="px-3 sm:px-5 py-2 text-center">
                                    @if (s.HasTheory)
                                    {
                                        <label class="inline-flex items-center gap-1.5 cursor-pointer select-none @(s.FailedTheory ? "text-red-600" : "text-gray-600")">
                                            <input type="checkbox" class="leg-checkbox rounded border-gray-300 h-4 w-4"
                                                   data-offering="@s.SubjectOfferingId" data-leg="T"
                                                   onchange="updateTotals()"
                                                   checked="@(s.SelectedTheory ? "checked" : null)" />
                                            @if (s.FailedTheory)
                                            {
                                                <span class="px-1 py-0.5 rounded bg-red-100 text-[10px] font-semibold text-red-600">Failed</span>
                                            }
                                        </label>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300">&mdash;</span>
                                    }
                                </td>
                                <td class="px-3 sm:px-5 py-2 text-center">
                                    @if (s.HasPractical)
                                    {
                                        <label class="inline-flex items-center gap-1.5 cursor-pointer select-none @(s.FailedPractical ? "text-red-600" : "text-gray-600")">
                                            <input type="checkbox" class="leg-checkbox rounded border-gray-300 h-4 w-4"
                                                   data-offering="@s.SubjectOfferingId" data-leg="P"
                                                   data-practical-fee="@s.PracticalFee"
                                                   onchange="updateTotals()"
                                                   checked="@(s.SelectedPractical ? "checked" : null)" />
                                            @if (s.FailedPractical)
                                            {
                                                <span class="px-1 py-0.5 rounded bg-red-100 text-[10px] font-semibold text-red-600">Failed</span>
                                            }
                                        </label>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300">&mdash;</span>
                                    }
                                </td>
                                <td class="px-3 sm:px-5 py-2 text-right fee-cell" data-offering="@s.SubjectOfferingId">
                                    <span class="text-gray-300">&mdash;</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="border-t border-gray-100 px-3 sm:px-5 py-3">
                <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-2">Payment Method</p>
                <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs sm:text-sm text-gray-700">
                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                        <input type="radio" name="paymentMethod" value="Cash" class="accent-blue-600" />
                        Cash / On-counter
                    </label>
                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                        <input type="radio" name="paymentMethod" value="esewa" class="accent-blue-600" />
                        eSewa
                    </label>
                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                        <input type="radio" name="paymentMethod" value="khalti" class="accent-blue-600" />
                        Khalti
                    </label>
                </div>
                <p class="mt-1 text-[10px] sm:text-xs text-gray-400 leading-snug">Only needed if your selection adds an extra charge below.</p>
                <div id="topupWarning" class="hidden mt-2 flex items-center gap-2 text-xs sm:text-sm font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
                    <i class="fas fa-circle-exclamation text-amber-500"></i>
                    <span>Additional payment due: <span id="deltaAmount" class="text-amber-900">Rs 0</span> &mdash; choose a payment method above to complete the re-application.</span>
                </div>
            </div>

            <div class="sticky bottom-0 z-10 px-3 sm:px-5 py-2.5 bg-gray-50/95 backdrop-blur border-t border-gray-100 flex items-center justify-between gap-2">
                <a asp-action="ExamForms"
                   class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg border border-gray-300 bg-white text-xs sm:text-sm font-semibold text-gray-700 hover:bg-gray-100 transition-colors">
                    Cancel
                </a>
                <button type="submit"
                        class="inline-flex items-center justify-center gap-1.5 px-5 py-2 rounded-lg bg-blue-600 text-white text-xs sm:text-sm font-semibold hover:bg-blue-700 active:scale-[0.98] transition-all shadow-sm shadow-blue-600/25">
                    <i class="fas fa-paper-plane text-[10px]"></i>
                    Resubmit Application
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function collectSelection() {
            var legsByOffering = {};
            document.querySelectorAll('.leg-checkbox:checked').forEach(function(cb) {
                var offeringId = cb.getAttribute('data-offering');
                if (!legsByOffering[offeringId]) legsByOffering[offeringId] = [];
                legsByOffering[offeringId].push(cb.getAttribute('data-leg'));
            });
            return Object.keys(legsByOffering).map(function(offeringId) {
                return offeringId + ':' + legsByOffering[offeringId].join('');
            });
        }

        function updateTotals() {
            var form = document.getElementById('reapplyForm');
            var examFee = parseFloat(form.getAttribute('data-exam-fee')) || 0;
            var practicalFee = parseFloat(form.getAttribute('data-practical-fee')) || 0;
            var paid = parseFloat(form.getAttribute('data-paid')) || 0;

            var practicalCount = 0;
            document.querySelectorAll('.leg-checkbox:checked').forEach(function(cb) {
                if (cb.getAttribute('data-leg') === 'P') practicalCount++;
            });

            var newTotal = examFee + (practicalCount * practicalFee);
            var delta = Math.max(0, newTotal - paid);

            document.getElementById('hfSelectedSubjectIds').value = collectSelection().join(',');

            var warning = document.getElementById('topupWarning');
            if (delta > 0) {
                warning.classList.remove('hidden');
                document.getElementById('deltaAmount').innerText = 'Rs ' + delta.toLocaleString();
            } else {
                warning.classList.add('hidden');
            }

            // Per-row practical fee column: show the charge only while the
            // practical leg of that row is ticked.
            document.querySelectorAll('.fee-cell').forEach(function(cell) {
                var offeringId = cell.getAttribute('data-offering');
                var cb = document.querySelector('.leg-checkbox[data-offering="' + offeringId + '"][data-leg="P"]');
                var fee = cb ? (parseFloat(cb.getAttribute('data-practical-fee')) || 0) : 0;
                if (cb && cb.checked && fee > 0) {
                    cell.innerHTML = '<span class="font-semibold text-gray-800">Rs ' + fee.toLocaleString() + '</span>';
                } else {
                    cell.innerHTML = '<span class="text-gray-300">&mdash;</span>';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateTotals();

            document.querySelectorAll('.leg-checkbox').forEach(function(cb) {
                cb.addEventListener('change', updateTotals);
            });

            document.getElementById('reapplyForm').addEventListener('submit', function(e) {
                updateTotals();
                if (!document.getElementById('hfSelectedSubjectIds').value) {
                    e.preventDefault();
                    alert('Please select at least one exam paper (theory or practical).');
                    return;
                }

                var topUpDue = !document.getElementById('topupWarning').classList.contains('hidden');
                if (topUpDue && !document.querySelector('input[name="paymentMethod"]:checked')) {
                    e.preventDefault();
                    alert('Your selection adds an extra charge. Please choose a payment method for the additional amount.');
                }
            });
        });
    </script>
}
