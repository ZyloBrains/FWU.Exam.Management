@model FWU.Exam.Management.Web.ViewModels.StudentProfileViewModel

@{
    ViewData["Title"] = "Student Profile";
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-lg flex items-center justify-center shadow-sm">
            <i class="fas fa-user-graduate text-white"></i>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Student Profile</h1>
            <p class="text-sm text-gray-500 mt-0.5">Manage your personal information and documents</p>
        </div>
    </div>

    <form method="post" asp-action="UpdateProfile" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- Profile Hero Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-500 px-6 py-8">
                <div class="flex items-center gap-5">
                    <div class="relative">
                        <div class="w-20 h-20 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center overflow-hidden ring-4 ring-white/30 shadow-lg">
                            @if (!string.IsNullOrEmpty(Model.PhotoPath))
                            {
                                <img src="@Model.PhotoPath" alt="Photo" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <i class="fas fa-user text-3xl text-white"></i>
                            }
                        </div>
                        <span class="absolute -bottom-1 -right-1 w-6 h-6 bg-emerald-400 border-2 border-white rounded-full flex items-center justify-center">
                            <i class="fas fa-check text-white text-[10px]"></i>
                        </span>
                    </div>
                    <div class="text-white">
                        <h2 class="text-xl font-bold">@Model.FullName</h2>
                        <p class="text-blue-100 text-sm flex items-center gap-1.5 mt-0.5">
                            <i class="fas fa-id-card text-xs"></i> @Model.RegistrationNumber
                        </p>
                        @if (!string.IsNullOrEmpty(Model.College))
                        {
                            <p class="text-blue-100 text-xs mt-1 flex items-center gap-1.5">
                                <i class="fas fa-university text-xs"></i> @Model.College
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="p-6 space-y-7">
                <!-- Personal Information -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-user-circle text-blue-600 text-sm"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wider">Personal Information</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Full Name</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.FullName</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Gender</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Gender</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Date Of Birth</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.DateOfBirthBS / @Model.DateOfBirthAD (AD)</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Ethnicity</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Ethnicity</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Category</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Category</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Nepali Name</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.NepaliName) ? "—" : Model.NepaliName)</p>
                        </div>
                    </div>
                </div>

                <!-- Contact -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-8 h-8 bg-emerald-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-phone-alt text-emerald-600 text-sm"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wider">Contact</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Contact Number</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.ContactNumber</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Email</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Email</p>
                        </div>
                    </div>
                </div>

                <!-- Other Information -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-8 h-8 bg-amber-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-info-circle text-amber-600 text-sm"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wider">Other Information</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Address</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Address</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Blood Group</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.BloodGroup</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Nationality</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Nationality) ? "—" : Model.Nationality)</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Religion</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Religion</p>
                        </div>
                    </div>
                </div>

                <!-- Academic Information -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-8 h-8 bg-purple-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-graduation-cap text-purple-600 text-sm"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wider">Academic Information</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Academic Year</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.AcademicYear</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Registration No</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.RegistrationNumber</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Level</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Level</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Faculty</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.Faculty</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100">
                            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">College</span>
                            <p class="text-sm font-semibold text-gray-800 mt-1">@Model.College</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upload Documents Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-rose-50 rounded-lg flex items-center justify-center">
                        <i class="fas fa-cloud-upload-alt text-rose-600 text-sm"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-semibold text-gray-800">Upload Documents</h3>
                        <p class="text-xs text-gray-400">Update your profile photo and signature</p>
                    </div>
                </div>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Photo Upload -->
                    <div class="bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 hover:border-blue-400 transition-colors p-5">
                        <div class="flex flex-col items-center text-center">
                            <div class="w-24 h-24 rounded-xl bg-white shadow-sm flex items-center justify-center overflow-hidden mb-3 ring-1 ring-gray-200">
                                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                                {
                                    <img src="@Model.PhotoPath" id="photoPreview" alt="Photo" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div id="photoPreviewPlaceholder" class="flex flex-col items-center justify-center text-gray-300">
                                        <i class="fas fa-camera text-3xl"></i>
                                        <span class="text-[10px] mt-1 font-medium">No Photo</span>
                                    </div>
                                }
                                <img src="" id="photoPreviewImg" class="w-full h-full object-cover hidden" alt="Preview" />
                            </div>
                            <p class="text-sm font-medium text-gray-700">Profile Photo</p>
                            <p class="text-xs text-gray-400 mt-0.5">PNG, JPG. Max 2 MB</p>
                            <label class="mt-3 inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-400 cursor-pointer transition-colors shadow-sm">
                                <i class="fas fa-upload"></i>
                                Choose File
                                <input type="file" name="photo" accept="image/*" class="hidden" onchange="previewFile(this, 'photoPreviewImg', 'photoPreviewPlaceholder')" />
                            </label>
                        </div>
                    </div>

                    <!-- Signature Upload -->
                    <div class="bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 hover:border-indigo-400 transition-colors p-5">
                        <div class="flex flex-col items-center text-center">
                            <div class="w-24 h-24 rounded-xl bg-white shadow-sm flex items-center justify-center overflow-hidden mb-3 ring-1 ring-gray-200">
                                @if (!string.IsNullOrEmpty(Model.SignaturePath))
                                {
                                    <img src="@Model.SignaturePath" id="signaturePreview" alt="Signature" class="w-full h-full object-contain" />
                                }
                                else
                                {
                                    <div id="signaturePreviewPlaceholder" class="flex flex-col items-center justify-center text-gray-300">
                                        <i class="fas fa-pen text-3xl"></i>
                                        <span class="text-[10px] mt-1 font-medium">No Signature</span>
                                    </div>
                                }
                                <img src="" id="signaturePreviewImg" class="w-full h-full object-contain hidden" alt="Preview" />
                            </div>
                            <p class="text-sm font-medium text-gray-700">Signature</p>
                            <p class="text-xs text-gray-400 mt-0.5">PNG, JPG. Max 2 MB</p>
                            <label class="mt-3 inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-400 cursor-pointer transition-colors shadow-sm">
                                <i class="fas fa-upload"></i>
                                Choose File
                                <input type="file" name="signature" accept="image/*" class="hidden" onchange="previewFile(this, 'signaturePreviewImg', 'signaturePreviewPlaceholder')" />
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex justify-end">
                    <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm font-medium rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all shadow-sm hover:shadow-md">
                        <i class="fas fa-save"></i>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function previewFile(input, imgId, placeholderId) {
        const preview = document.getElementById(imgId);
        const placeholder = document.getElementById(placeholderId);
        if (input.files && input.files[0]) {
            preview.src = URL.createObjectURL(input.files[0]);
            preview.classList.remove('hidden');
            if (placeholder) placeholder.classList.add('hidden');
        }
    }
</script>
