@model FWU.Exam.Management.Web.ViewModels.StudentProfileViewModel

@{
    ViewData["Title"] = "Student Profile";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-user-graduate text-blue-600"></i>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Student Profile</h1>
            <p class="text-sm text-gray-500 mt-0.5">View your personal and academic information</p>
        </div>
    </div>

    <!-- Personal Info Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200 flex items-center gap-4">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" alt="Photo" class="w-full h-full object-cover" />
                }
                else
                {
                    <i class="fas fa-user text-2xl text-blue-600"></i>
                }
            </div>
            <div class="flex-1">
                <h2 class="text-lg font-semibold text-gray-800">@Model.FullName</h2>
                <p class="text-sm text-gray-500">@Model.RegistrationNumber</p>
            </div>
            <div class="text-right text-sm text-gray-500">
                <p class="text-xs">Max Size: 2 MB</p>
            </div>
        </div>

        <div class="p-6">
            <!-- Fee Row -->
            <div class="flex items-center gap-2 mb-6 p-3 bg-green-50 rounded-lg border border-green-200">
                <i class="fas fa-check-circle text-green-600"></i>
                <span class="text-sm text-green-700 font-medium">Fee: <span class="text-green-800">Cleared</span></span>
            </div>

            <!-- Personal Information -->
            <h3 class="text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wider">Personal Information</h3>
            <div class="border-t border-gray-100 mb-4"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div>
                    <span class="text-xs text-gray-500">Full Name</span>
                    <p class="text-sm font-medium text-gray-800">@Model.FullName</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Gender</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Gender</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Date Of Birth</span>
                    <p class="text-sm font-medium text-gray-800">@Model.DateOfBirthBS / @Model.DateOfBirthAD (AD)</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Ethnicity</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Ethnicity</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Category</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Category</p>
                </div>
            </div>

            <!-- Contact -->
            <h3 class="text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wider">Contact</h3>
            <div class="border-t border-gray-100 mb-4"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div>
                    <span class="text-xs text-gray-500">Contact Number</span>
                    <p class="text-sm font-medium text-gray-800">@Model.ContactNumber</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Email</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Email</p>
                </div>
            </div>

            <!-- Photo Upload Section -->
            <h3 class="text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wider">Photo</h3>
            <div class="border-t border-gray-100 mb-4"></div>
            <div class="mb-6">
                <div class="flex items-center gap-4">
                    <div class="w-20 h-20 bg-gray-100 rounded-lg border-2 border-dashed border-gray-300 flex items-center justify-center">
                        <i class="fas fa-camera text-gray-400 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Upload Photo</p>
                        <p class="text-xs text-gray-400">Max Size: 2 MB</p>
                        <button class="mt-2 px-4 py-1.5 text-xs bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                            <i class="fas fa-upload mr-1"></i>Choose File
                        </button>
                    </div>
                </div>
            </div>

            <!-- Other Information -->
            <h3 class="text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wider">Other Information</h3>
            <div class="border-t border-gray-100 mb-4"></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div>
                    <span class="text-xs text-gray-500">Address</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Address</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Blood Group</span>
                    <p class="text-sm font-medium text-gray-800">@Model.BloodGroup</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Nationality</span>
                    <p class="text-sm font-medium text-gray-800">@(string.IsNullOrEmpty(Model.Nationality) ? "1" : Model.Nationality)</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Religion</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Religion</p>
                </div>
            </div>

            <!-- Academic Information -->
            <h3 class="text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wider">Academic Information</h3>
            <div class="border-t border-gray-100 mb-4"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <span class="text-xs text-gray-500">Academic Year</span>
                    <p class="text-sm font-medium text-gray-800">@Model.AcademicYear</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Registration No</span>
                    <p class="text-sm font-medium text-gray-800">@Model.RegistrationNumber</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Level</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Level</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">Faculty</span>
                    <p class="text-sm font-medium text-gray-800">@Model.Faculty</p>
                </div>
                <div>
                    <span class="text-xs text-gray-500">College</span>
                    <p class="text-sm font-medium text-gray-800">@Model.College</p>
                </div>
            </div>
        </div>
    </div>
</div>
