@model FWU.Exam.Management.Web.ViewModels.StudentProfileViewModel

@{
    ViewData["Title"] = "Student Profile";
}

<div class="min-h-screen space-y-5 sm:space-y-6">
    @await Html.PartialAsync("_AlertMessages")
    <!-- <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-br from-blue-600 via-blue-700 to-blue-800">
        <div class="absolute inset-0 bg-grid-white/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
        <div class="absolute top-0 right-0 w-72 h-72 bg-blue-400/10 rounded-full blur-3xl"></div>
        <div class="relative px-5 py-8 sm:px-10 sm:py-10">
            <div class="flex items-center gap-4">
                <div class="h-14 w-14 sm:h-16 sm:w-16 bg-white/10 backdrop-blur-xl rounded-2xl flex items-center justify-center shadow-2xl border border-white/20 shrink-0">
                    <svg class="h-7 w-7 sm:h-8 sm:w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Student Profile</h1>
                    <p class="mt-1 text-blue-200/80 text-sm sm:text-base">Manage your personal information and documents</p>
                </div>
            </div>
        </div>
    </div> -->

    <form method="post" asp-action="UpdateProfile" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="permanentAddressId" value="@Model.PermanentAddressId" />

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-600 via-blue-500 to-blue-700 px-5 sm:px-8 py-6 sm:py-8">
                <div class="flex items-center gap-4 sm:gap-6">
                    <div class="relative shrink-0">
                        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl sm:rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center overflow-hidden ring-4 ring-white/30 shadow-lg">
                            @if (!string.IsNullOrEmpty(Model.PhotoPath))
                            {
                                <img src="@Model.PhotoPath" alt="Photo" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <i class="fas fa-user text-2xl sm:text-3xl text-white"></i>
                            }
                        </div>
                        <span class="absolute -bottom-1 -right-1 w-5 h-5 sm:w-6 sm:h-6 bg-emerald-400 border-2 border-white rounded-full flex items-center justify-center">
                            <i class="fas fa-check text-white text-[10px]"></i>
                        </span>
                    </div>
                    <div class="min-w-0 text-white">
                        <h2 class="text-lg sm:text-xl font-bold truncate">@Model.FullName</h2>
                        <p class="text-blue-100 text-xs sm:text-sm flex items-center gap-1.5 mt-0.5">
                            <i class="fas fa-id-card text-[10px] sm:text-xs"></i> @Model.RegistrationNumber
                        </p>
                        @if (!string.IsNullOrEmpty(Model.College))
                        {
                            <p class="text-blue-100 text-[10px] sm:text-xs mt-1 flex items-center gap-1.5">
                                <i class="fas fa-university text-[10px] sm:text-xs"></i> @Model.College
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="p-4 sm:p-8 space-y-5 sm:space-y-7">
                <div>
                    <div class="flex items-center gap-2 mb-3 sm:mb-4">
                        <div class="w-7 h-7 sm:w-8 sm:h-8 bg-blue-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-user-circle text-blue-600 text-xs sm:text-sm"></i>
                        </div>
                        <h3 class="text-[11px] sm:text-sm font-semibold text-gray-800 uppercase tracking-wider">Personal Information</h3>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-5">
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Full Name</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1 truncate">@Model.FullName</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Gender</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1">@Model.Gender</p>
                        </div>
                        <div class="col-span-2 sm:col-span-1 bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Date Of Birth</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1 truncate">@Model.DateOfBirthBS / @Model.DateOfBirthAD (AD)</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Ethnicity</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1">@Model.Ethnicity</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Category</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1">@Model.Category</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Nepali Name</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1 truncate">@(string.IsNullOrEmpty(Model.NepaliName) ? "—" : Model.NepaliName)</p>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center gap-2 mb-3 sm:mb-4">
                        <div class="w-7 h-7 sm:w-8 sm:h-8 bg-emerald-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-phone-alt text-emerald-600 text-xs sm:text-sm"></i>
                        </div>
                        <h3 class="text-[11px] sm:text-sm font-semibold text-gray-800 uppercase tracking-wider">Contact</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-1 gap-2 sm:gap-5">
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Contact Number</span>
                            <input type="text" name="contactNumber" value="@Model.ContactNumber" class="mt-0.5 sm:mt-1 w-full text-xs sm:text-sm font-semibold text-gray-800 bg-transparent border-0 border-b border-gray-300 focus:border-blue-500 focus:outline-none focus:ring-0 p-0" />
                        </div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center gap-2 mb-3 sm:mb-4">
                        <div class="w-7 h-7 sm:w-8 sm:h-8 bg-amber-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-info-circle text-amber-600 text-xs sm:text-sm"></i>
                        </div>
                        <h3 class="text-[11px] sm:text-sm font-semibold text-gray-800 uppercase tracking-wider">Other Information</h3>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-5">
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Address</span>
                            <input type="text" name="address" value="@Model.Address" class="mt-0.5 sm:mt-1 w-full text-xs sm:text-sm font-semibold text-gray-800 bg-transparent border-0 border-b border-gray-300 focus:border-blue-500 focus:outline-none focus:ring-0 p-0" />
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Blood Group</span>
                            <input type="text" name="bloodGroup" value="@Model.BloodGroup" class="mt-0.5 sm:mt-1 w-full text-xs sm:text-sm font-semibold text-gray-800 bg-transparent border-0 border-b border-gray-300 focus:border-blue-500 focus:outline-none focus:ring-0 p-0" />
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Nationality</span>
                            <input type="text" name="nationality" value="@(string.IsNullOrEmpty(Model.Nationality) ? "" : Model.Nationality)" class="mt-0.5 sm:mt-1 w-full text-xs sm:text-sm font-semibold text-gray-800 bg-transparent border-0 border-b border-gray-300 focus:border-blue-500 focus:outline-none focus:ring-0 p-0" />
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Religion</span>
                            <input type="text" name="religion" value="@Model.Religion" class="mt-0.5 sm:mt-1 w-full text-xs sm:text-sm font-semibold text-gray-800 bg-transparent border-0 border-b border-gray-300 focus:border-blue-500 focus:outline-none focus:ring-0 p-0" />
                        </div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center gap-2 mb-3 sm:mb-4">
                        <div class="w-7 h-7 sm:w-8 sm:h-8 bg-purple-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-graduation-cap text-purple-600 text-xs sm:text-sm"></i>
                        </div>
                        <h3 class="text-[11px] sm:text-sm font-semibold text-gray-800 uppercase tracking-wider">Academic Information</h3>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-5">
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Academic Year</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1">@Model.AcademicYear</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Registration No</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1 truncate">@Model.RegistrationNumber</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">Level</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1">@Model.Level</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2.5 sm:p-4 border border-gray-100">
                            <span class="text-[10px] sm:text-[11px] font-medium text-gray-400 uppercase tracking-wider">College</span>
                            <p class="text-xs sm:text-sm font-semibold text-gray-800 mt-0.5 sm:mt-1 truncate">@Model.College</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-4 sm:px-6 py-4 border-b border-gray-100">
                <div class="flex items-center gap-2 sm:gap-3">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 bg-rose-50 rounded-lg flex items-center justify-center">
                        <i class="fas fa-cloud-upload-alt text-rose-600 text-xs sm:text-sm"></i>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-sm sm:text-base font-semibold text-gray-800">Upload Documents</h3>
                        <p class="text-[10px] sm:text-xs text-gray-400">Update your profile photo and signature</p>
                    </div>
                </div>
            </div>
            <div class="p-4 sm:p-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <div class="bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 hover:border-blue-400 transition-colors p-4 sm:p-5">
                        <div class="flex flex-col items-center text-center">
                            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl bg-white shadow-sm flex items-center justify-center overflow-hidden mb-3 ring-1 ring-gray-200">
                                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                                {
                                    <img src="@Model.PhotoPath" id="photoPreview" alt="Photo" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div id="photoPreviewPlaceholder" class="flex flex-col items-center justify-center text-gray-300">
                                        <i class="fas fa-camera text-2xl sm:text-3xl"></i>
                                        <span class="text-[10px] mt-1 font-medium">No Photo</span>
                                    </div>
                                }
                                <img src="" id="photoPreviewImg" class="w-full h-full object-cover hidden" alt="Preview" />
                            </div>
                            <p class="text-xs sm:text-sm font-medium text-gray-700">Profile Photo</p>
                            <p class="text-[10px] sm:text-xs text-gray-400 mt-0.5">PNG, JPG. Max 2 MB</p>
                            <label class="mt-3 inline-flex items-center gap-2 px-4 py-2.5 sm:py-2 bg-white border border-gray-300 rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-400 cursor-pointer transition-colors shadow-sm active:scale-[0.98]">
                                <i class="fas fa-upload"></i>
                                Choose File
                                <input type="file" name="photo" accept="image/*" class="hidden" onchange="previewFile(this, 'photoPreviewImg', 'photoPreviewPlaceholder')" />
                            </label>
                        </div>
                    </div>

                    <div class="bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 hover:border-blue-400 transition-colors p-4 sm:p-5">
                        <div class="flex flex-col items-center text-center">
                            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl bg-white shadow-sm flex items-center justify-center overflow-hidden mb-3 ring-1 ring-gray-200">
                                @if (!string.IsNullOrEmpty(Model.SignaturePath))
                                {
                                    <img src="@Model.SignaturePath" id="signaturePreview" alt="Signature" class="w-full h-full object-contain" />
                                }
                                else
                                {
                                    <div id="signaturePreviewPlaceholder" class="flex flex-col items-center justify-center text-gray-300">
                                        <i class="fas fa-pen text-2xl sm:text-3xl"></i>
                                        <span class="text-[10px] mt-1 font-medium">No Signature</span>
                                    </div>
                                }
                                <img src="" id="signaturePreviewImg" class="w-full h-full object-contain hidden" alt="Preview" />
                            </div>
                            <p class="text-xs sm:text-sm font-medium text-gray-700">Signature</p>
                            <p class="text-[10px] sm:text-xs text-gray-400 mt-0.5">PNG, JPG. Max 2 MB</p>
                            <label class="mt-3 inline-flex items-center gap-2 px-4 py-2.5 sm:py-2 bg-white border border-gray-300 rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-400 cursor-pointer transition-colors shadow-sm active:scale-[0.98]">
                                <i class="fas fa-upload"></i>
                                Choose File
                                <input type="file" name="signature" accept="image/*" class="hidden" onchange="previewFile(this, 'signaturePreviewImg', 'signaturePreviewPlaceholder')" />
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 sm:mt-6 flex justify-end">
                    <button type="submit" class="inline-flex items-center gap-2 px-5 sm:px-6 py-2.5 sm:py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 text-white text-sm font-medium rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all shadow-sm hover:shadow-md active:scale-[0.97] w-full sm:w-auto justify-center">
                        <i class="fas fa-save"></i>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </form>


</div>

<script>
    function previewFile(input, imgId, placeholderId) {
        const preview = document.getElementById(imgId);
        const placeholder = document.getElementById(placeholderId);
        if (input.files && input.files[0]) {
            preview.src = URL.createObjectURL(input.files[0]);
            preview.classList.remove('hidden');
            if (placeholder) placeholder.classList.add('hidden');
        }
    }
</script>
