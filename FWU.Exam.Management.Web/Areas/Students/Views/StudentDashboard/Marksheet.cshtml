@model List<FWU.Exam.Management.Web.ViewModels.MarksheetViewModel>

@{
    ViewData["Title"] = "Marksheet";
    var totalCount = Model.Count;
    var registration = ViewBag.StudentRegistration as FWU.Exam.Management.Domain.Entities.Students.StudentRegistration;
}

<div x-data="{ expandedMarksheet: null, printScheduleId: null }">

<!-- ═══ SCREEN LAYOUT ═══ -->
<div class="space-y-6 screen-only">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Marksheet</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> record@(totalCount != 1 ? "s" : "")
                </p>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-layer-group text-4xl mb-3 opacity-50"></i>
                <p>No marksheets found.</p>
            </div>
        </div>
    }

    @{ var msIdx = 0; }
    @foreach (var marksheet in Model)
    {
        var allPassed = marksheet.Subjects.All(s => s.Status == "Pass");
        var anyFailed = marksheet.Subjects.Any(s => s.Status == "Fail");
        var anyPending = marksheet.Subjects.Any(s => s.Status == "Pending");

        string resultBadgeClass = "bg-gray-100 text-gray-600";
        string resultIcon = "fa-clock";
        if (marksheet.Result == "Pass") { resultBadgeClass = "bg-emerald-100 text-emerald-700"; resultIcon = "fa-check-circle"; }
        else if (marksheet.Result == "Fail") { resultBadgeClass = "bg-red-100 text-red-700"; resultIcon = "fa-times-circle"; }

        var msId = "ms" + msIdx;
        msIdx++;

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="flex items-center justify-between gap-3 px-5 py-4 bg-gradient-to-r from-indigo-50 to-white hover:from-indigo-100 transition-colors">
                <button @@click="expandedMarksheet = expandedMarksheet === '@msId' ? null : '@msId'"
                        class="flex items-center gap-3 min-w-0 text-left flex-1">
                    <div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                        <i class="fas fa-graduation-cap text-indigo-600 text-sm"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="text-base font-bold text-gray-800">@marksheet.ExamSchedule</h2>
                            @if (!string.IsNullOrEmpty(marksheet.Result))
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold @resultBadgeClass">
                                    <i class="fas @resultIcon text-[10px]"></i> @marksheet.Result
                                </span>
                            }
                        </div>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-0.5 mt-0.5 text-xs text-gray-500">
                            <span><i class="far fa-calendar-alt text-gray-400 mr-1"></i>@marksheet.AcademicYear</span>
                            @if (!string.IsNullOrEmpty(marksheet.Semester))
                            {
                                <span><i class="fas fa-layer-group text-gray-400 mr-1"></i>@marksheet.Semester</span>
                            }
                            @if (!string.IsNullOrEmpty(marksheet.Level))
                            {
                                <span><i class="fas fa-graduation-cap text-gray-400 mr-1"></i>@marksheet.Level</span>
                            }
                            @if (!string.IsNullOrEmpty(marksheet.ExamType))
                            {
                                <span><i class="fas fa-clipboard-list text-gray-400 mr-1"></i>@marksheet.ExamType</span>
                            }
                            <span><i class="far fa-building text-gray-400 mr-1"></i>@marksheet.Program</span>
                            @if (!string.IsNullOrEmpty(marksheet.Faculty))
                            {
                                <span><i class="fas fa-book-open text-gray-400 mr-1"></i>@marksheet.Faculty</span>
                            }
                            @if (!string.IsNullOrEmpty(marksheet.College))
                            {
                                <span><i class="fas fa-university text-gray-400 mr-1"></i>@marksheet.College</span>
                            }
                            <span class="text-gray-400">@marksheet.Subjects.Count() subject@(marksheet.Subjects.Count() != 1 ? "s" : "")</span>
                        </div>
                    </div>
                </button>
                <div class="flex items-center gap-2 shrink-0">
                    <button @@click="printScheduleId=@marksheet.ExamScheduleId; setTimeout(()=>window.print(),100);"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                        <i class="fas fa-download text-xs"></i> Download
                    </button>
                    <button @@click="expandedMarksheet = expandedMarksheet === '@msId' ? null : '@msId'"
                            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                        <i class="fas fa-chevron-down text-xs transition-transform"
                           :class="{ 'rotate-180': expandedMarksheet === '@msId' }"></i>
                    </button>
                </div>
            </div>

            <div x-show="expandedMarksheet === '@msId'"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-2"
                 x-transition:enter-end="opacity-100 translate-y-0">

                @if (marksheet.Subjects.Count > 0)
                {
                    <div class="hidden sm:block">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-gray-100">
                                    <th class="px-5 py-2 text-xs font-medium text-gray-400 uppercase w-8">#</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-left">Subject</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Grade</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">TH</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">PR</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Status</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                @{ int rowIdx = 0; }
                                @foreach (var subject in marksheet.Subjects)
                                {
                                    var borderClass = subject.Status == "Fail" ? "border-l-4 border-l-red-400" :
                                                       subject.Status == "Pending" ? "border-l-4 border-l-amber-400" : "";
                                    var gradeColor = subject.Grade switch
                                    {
                                        "A+" or "A" => "bg-emerald-100 text-emerald-700",
                                        "B+" or "B" => "bg-blue-100 text-blue-700",
                                        "C+" or "C" => "bg-yellow-100 text-yellow-700",
                                        "D" => "bg-orange-100 text-orange-700",
                                        "F" => "bg-red-100 text-red-700",
                                        _ => "bg-gray-100 text-gray-600"
                                    };
                                    var statusClass = subject.Status == "Pass" ? "bg-emerald-100 text-emerald-700" :
                                                       subject.Status == "Fail" ? "bg-red-100 text-red-700" :
                                                       "bg-amber-100 text-amber-700";
                                    rowIdx++;
                                    <tr class="hover:bg-gray-50/50 transition-colors @borderClass">
                                        <td class="px-5 py-2.5 text-xs text-gray-400">@rowIdx</td>
                                        <td class="px-4 py-2.5">
                                            <div class="text-xs sm:text-sm font-medium text-gray-800">@subject.SubjectName</div>
                                            <div class="text-xs text-gray-400 font-mono">@subject.SubjectCode</div>
                                        </td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.Status == "Pending")
                                            {
                                                <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-500 rounded-full">-</span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 text-xs font-semibold rounded-full @gradeColor">@subject.Grade</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 text-center text-xs text-gray-700">
                                            @if (subject.TheoryGradePoint.HasValue)
                                            {
                                                <span>@(subject.TheoryGradePoint?.ToString("0.##"))</span>
                                                if (!string.IsNullOrEmpty(subject.TheoryGrade))
                                                {
                                                    <span class="text-[10px] text-gray-400 ml-0.5">(@subject.TheoryGrade)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 text-center text-xs text-gray-700">
                                            @if (subject.PracticalGradePoint.HasValue)
                                            {
                                                <span>@(subject.PracticalGradePoint?.ToString("0.##"))</span>
                                                if (!string.IsNullOrEmpty(subject.PracticalGrade))
                                                {
                                                    <span class="text-[10px] text-gray-400 ml-0.5">(@subject.PracticalGrade)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 text-center">
                                            <span class="px-2 py-0.5 text-xs font-semibold rounded-full @statusClass">@subject.Status</span>
                                        </td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.Status == "Fail" && subject.ExamSubjectResultId > 0)
                                            {
                                                <a asp-action="RequestRetotal" asp-area="Students" asp-route-examSubjectResultId="@subject.ExamSubjectResultId"
                                                   class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 rounded-md hover:bg-amber-100 border border-amber-200/50 transition-colors">
                                                    <i class="fas fa-redo-alt text-[10px]"></i> Retotal
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="sm:hidden divide-y divide-gray-100">
                        @{ int mobileIdx = 0; }
                        @foreach (var subject in marksheet.Subjects)
                        {
                            mobileIdx++;
                            var borderClass = subject.Status == "Fail" ? "border-l-4 border-l-red-400" :
                                               subject.Status == "Pending" ? "border-l-4 border-l-amber-400" : "";
                            var gradeColor = subject.Grade == "F" ? "text-red-700" : "text-gray-800";
                            var statusClass = subject.Status == "Pass" ? "bg-emerald-100 text-emerald-700" :
                                               subject.Status == "Fail" ? "bg-red-100 text-red-700" :
                                               "bg-amber-100 text-amber-700";
                            <div class="px-4 py-3 @borderClass">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="flex-shrink-0 w-6 h-6 rounded bg-gray-100 flex items-center justify-center text-[10px] font-bold text-gray-400">@mobileIdx</span>
                                        <p class="text-sm font-semibold text-gray-900 truncate">@subject.SubjectName</p>
                                    </div>
                                    <div class="flex items-center gap-1.5 shrink-0 ml-2">
                                        @if (subject.Status != "Pending")
                                        {
                                            <span class="text-xs font-bold @gradeColor">@subject.Grade</span>
                                        }
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold @statusClass">@subject.Status</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 ml-8 text-xs text-gray-500">
                                    @if (subject.Status == "Fail" && subject.ExamSubjectResultId > 0)
                                    {
                                        <a asp-action="RequestRetotal" asp-area="Students" asp-route-examSubjectResultId="@subject.ExamSubjectResultId"
                                           class="ml-auto inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-medium text-amber-700 bg-amber-50 rounded border border-amber-200/50">
                                            <i class="fas fa-redo-alt text-[8px]"></i> Retotal
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="px-5 py-8 text-center text-gray-400 text-sm">
                        <i class="fas fa-inbox text-2xl mb-2 block text-gray-300"></i>
                        No subject records for this exam.
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ═══ PRINT LAYOUT (hidden on screen, shown on print) ═══ -->
<div class="print-only">
    @foreach (var marksheet in Model)
    {
        <div class="print-page" x-show="printScheduleId === @marksheet.ExamScheduleId">
            <!-- Header -->
            <div class="header-top">
                <div class="header-logo">
                    <div class="logo-box">
                        <img src="~/images/download.png" alt="Far Western University Logo" />
                    </div>
                </div>
                <div class="header-center">
                    <div class="univ-name">Far Western University</div>
                    <div class="office">Office of the Controller of Examinations</div>
                    <div class="address">Mahendranagar, Kanchanpur</div>
                    <div class="doc-title">Academic Record</div>
                </div>
                <div class="header-logo">
                    <div class="logo-box">
                        <img src="~/images/download.png" alt="Far Western University Logo" />
                    </div>
                </div>
            </div>

            <!-- Student Info -->
            <div class="student-info">
                <div class="info-row">
                    <span class="info-label">Name:</span>
                    <span class="info-value">@(marksheet.StudentName ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">RollNo:</span>
                    <span class="info-value">@(marksheet.SymbolNumber ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">College:</span>
                    <span class="info-value">@(marksheet.College ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Regd No:</span>
                    <span class="info-value">@(marksheet.RegistrationNumber ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Program:</span>
                    <span class="info-value">@(marksheet.Program ?? "-")</span>
                </div>
                @if (!string.IsNullOrEmpty(marksheet.Faculty))
                {
                    <div class="info-row">
                        <span class="info-label">Faculty:</span>
                        <span class="info-value">@(marksheet.Faculty)</span>
                    </div>
                }
                <div class="info-row">
                    <span class="info-label">Exam Schedule:</span>
                    <span class="info-value">@(marksheet.ExamSchedule ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Semester:</span>
                    <span class="info-value">@(marksheet.Semester ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Academic Year:</span>
                    <span class="info-value">@(marksheet.AcademicYear ?? "-")</span>
                </div>
            </div>

            @if (marksheet.Subjects.Count > 0)
            {
                var totalCredits = marksheet.Subjects.Sum(s => s.CreditHours ?? 0f);
                var totalGradePoints = marksheet.Subjects.Sum(s => s.GradePoint ?? 0m);

                <table class="marks-table">
                    <thead>
                        <tr>
                            <th rowspan="2">Course Code</th>
                            <th rowspan="2">Course Title</th>
                            <th rowspan="2">Credit Hrs</th>
                            <th colspan="2">Grade Letter</th>
                            <th rowspan="2">Final Grade</th>
                            <th rowspan="2">Grade Value</th>
                            <th rowspan="2">Grade Point</th>
                            <th rowspan="2">Remarks</th>
                        </tr>
                        <tr>
                            <th>TH</th>
                            <th>PR</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in marksheet.Subjects)
                        {
                            <tr>
                                <td>@(subject.SubjectCode ?? "-")</td>
                                <td>@(subject.SubjectName ?? "-")</td>
                                <td>@(subject.CreditHours?.ToString("0.#") ?? "-")</td>
                                <td>@(subject.TheoryGrade ?? "-")</td>
                                <td>@(subject.PracticalGrade ?? "-")</td>
                                <td>@(subject.Grade ?? "")</td>
                                <td>@(subject.GradeValue?.ToString("0.00") ?? "-")</td>
                                <td>@(subject.GradePoint?.ToString("0.00") ?? "-")</td>
                                <td>@subject.Status</td>
                            </tr>
                        }
                        <tr class="total-row">
                            <td></td>
                            <td style="text-align:right;">Total</td>
                            <td>@totalCredits.ToString("0.#")</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td>@totalGradePoints.ToString("0.00")</td>
                            <td></td>
                        </tr>
                        <tr class="gpa-row">
                            <td colspan="2" style="text-align:right;">GPA (Grade Point Average)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td>@(string.IsNullOrEmpty(marksheet.TotalGpa) ? "-" : marksheet.TotalGpa)</td>
                            <td></td>
                        </tr>
                        <tr class="result-row @(marksheet.Result == "Fail" ? "fail" : "")">
                            <td colspan="8" style="text-align:right;">Result:</td>
                            <td>
                                @if (marksheet.Result == "Pass")
                                {
                                    <span class="result-pass">Pass</span>
                                }
                                else if (marksheet.Result == "Fail")
                                {
                                    <span class="result-fail">Fail</span>
                                }
                                else
                                {
                                    <span class="result-pending">Pending</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            }
            else
            {
                <div style="text-align:center; padding:20px; color:#9ca3af; font-size:13px;">
                    No subject records for this exam.
                </div>
            }

            <!-- Footer -->
            <div class="footer">
                <div>Date: @DateTime.Now.ToString("MMMM dd, yyyy")</div>
                <div class="note">Note: This Mark Sheet is for general idea of mark(s) you secured. This is not for official use. If any mistakes appear; record at Administration ledger will be referred.</div>
            </div>
        </div>
    }
</div>

</div>

<style>
    /* ═══ Screen-only & print-only toggling ═══ */
    .print-only {
        display: none;
    }

    /* ═══ PRINT PAGE ═══ */
    .print-page {
        width: 210mm;
        min-height: auto;
        margin: 0 auto;
        padding: 6mm 8mm;
        background: #fff;
        font-family: 'Segoe UI', 'Nirmala UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #111827;
    }

    /* ═══ HEADER ═══ */
    .header-top {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        border-bottom: 3px double #1a2a4a;
        padding-bottom: 6px;
        margin-bottom: 8px;
    }

    .header-logo {
        flex-shrink: 0;
    }

    .logo-box {
        width: 70px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .logo-box img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .header-center {
        flex: 1;
        text-align: center;
    }

    .header-center .univ-name {
        font-size: 20px;
        font-weight: 700;
        color: #1a2a4a;
        letter-spacing: 1px;
        text-transform: uppercase;
        line-height: 1.2;
    }

    .header-center .office {
        font-size: 12px;
        font-weight: 600;
        color: #2c3e6b;
        margin-top: 1px;
    }

    .header-center .address {
        font-size: 11px;
        color: #555;
        margin-top: 0px;
    }

    .header-center .doc-title {
        font-size: 16px;
        font-weight: 700;
        color: #1a2a4a;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-top: 4px;
        border-top: 1px solid #ccc;
        padding-top: 4px;
        display: inline-block;
        padding-left: 14px;
        padding-right: 14px;
    }

    /* ═══ STUDENT INFO ═══ */
    .student-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px 20px;
        border: 1px solid #d1d5db;
        border-radius: 3px;
        padding: 6px 10px;
        margin-bottom: 8px;
        font-size: 11px;
    }

    .info-row {
        display: flex;
        gap: 4px;
    }

    .info-label {
        font-weight: 600;
        color: #374151;
        min-width: 90px;
    }

    .info-value {
        color: #111827;
        font-weight: 500;
    }

    /* ═══ MARKS TABLE ═══ */
    .marks-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
        table-layout: fixed;
        margin-bottom: 8px;
    }

    .marks-table th,
    .marks-table td {
        border: 1px solid #d1d5db;
        padding: 3px 4px;
        line-height: 1.2;
    }

    .marks-table thead th {
        background: #f3f4f6;
        font-weight: 600;
        color: #374151;
        text-align: center;
        font-size: 10.5px;
        padding: 4px 3px;
    }

    .marks-table thead th:first-child,
    .marks-table thead th:nth-child(2) {
        text-align: left;
    }

    .marks-table tbody td {
        color: #111827;
    }

    .marks-table tbody td:first-child {
        text-align: left;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 10.5px;
    }

    .marks-table tbody td:nth-child(2) {
        text-align: left;
    }

    .marks-table tbody td:not(:first-child):not(:nth-child(2)) {
        text-align: center;
    }

    .marks-table tbody tr:nth-child(even) {
        background: #fafafa;
    }

    .total-row {
        font-weight: 700;
        background: #f9fafb !important;
    }

    .gpa-row {
        font-weight: 700;
        background: #eef2ff !important;
    }

    .result-row {
        font-weight: 700;
        background: #f0fdf4 !important;
    }

    .result-row.fail {
        background: #fef2f2 !important;
    }

    .result-pass { color: #16a34a; }
    .result-fail { color: #dc2626; }
    .result-pending { color: #d97706; }

    /* ═══ FOOTER ═══ */
    .footer {
        margin-top: 6px;
        font-size: 10px;
        color: #6b7280;
        border-top: 1px solid #e5e7eb;
        padding-top: 4px;
    }

    .footer .note {
        font-style: italic;
        margin-top: 2px;
        line-height: 1.2;
    }

    /* ═══ PRINT MEDIA ═══ */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 8mm;
        }

        body {
            margin: 0;
            padding: 0;
            background: #fff;
        }

        .screen-only,
        .no-print,
        header,
        nav,
