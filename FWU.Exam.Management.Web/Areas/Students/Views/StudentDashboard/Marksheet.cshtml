@model List<FWU.Exam.Management.Web.ViewModels.MarksheetViewModel>

@{
    ViewData["Title"] = "Marksheet";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-file-alt text-blue-600"></i>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Marksheet</h1>
            <p class="text-sm text-gray-500 mt-0.5">View your academic results</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-file-alt text-3xl text-gray-300"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-700 mb-2">No Marksheets Available</h3>
            <p class="text-sm text-gray-500">Your marksheets will appear here once results are published.</p>
        </div>
    }

    @foreach (var marksheet in Model)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800">@marksheet.ExamSchedule</h3>
                        <p class="text-sm text-gray-500 mt-1">@marksheet.Program</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-gray-500">@marksheet.AcademicYear</p>
                        <p class="text-xs text-gray-500">@marksheet.College</p>
                    </div>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Subject</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Theory</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Practical</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Total</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Grade</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Grade Point</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var subject in marksheet.Subjects)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-gray-800 font-medium">@subject.SubjectName</td>
                                <td class="px-4 py-3 text-center text-gray-800">@subject.TheoryMarks</td>
                                <td class="px-4 py-3 text-center text-gray-800">@subject.PracticalMarks</td>
                                <td class="px-4 py-3 text-center text-gray-800 font-medium">@subject.TotalMarks</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-semibold
                                        @(subject.Grade == "A+" ? "bg-green-100 text-green-700" :
                                          subject.Grade == "A" ? "bg-green-100 text-green-700" :
                                          subject.Grade == "B+" ? "bg-blue-100 text-blue-700" :
                                          subject.Grade == "B" ? "bg-blue-100 text-blue-700" :
                                          subject.Grade == "C+" ? "bg-yellow-100 text-yellow-700" :
                                          subject.Grade == "C" ? "bg-yellow-100 text-yellow-700" :
                                          subject.Grade == "D" ? "bg-orange-100 text-orange-700" :
                                          "bg-red-100 text-red-700")">
                                        @subject.Grade
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-center text-gray-800">@subject.GradePoint</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-50 border-t-2 border-gray-200">
                        <tr>
                            <td colspan="3" class="px-4 py-3 text-right font-semibold text-gray-700">SGPA:</td>
                            <td class="px-4 py-3 text-center font-bold text-gray-800">@marksheet.TotalGpa</td>
                            <td class="px-4 py-3 text-center" colspan="2">
                                <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold
                                    @(marksheet.Result == "Pass" ? "bg-green-100 text-green-700" :
                                      marksheet.Result == "Fail" ? "bg-red-100 text-red-700" : "bg-gray-100 text-gray-700")">
                                    @marksheet.Result
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>
