@model List<FWU.Exam.Management.Web.ViewModels.MarksheetViewModel>

@{
    ViewData["Title"] = "Marksheet";
    var totalCount = Model.Count;
}

<div class="space-y-6" x-data="{ expandedMarksheet: null, printPreview: false, printUrl: '' }">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-layer-group text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Marksheet</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> record@(totalCount != 1 ? "s" : "")
                </p>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-layer-group text-4xl mb-3 opacity-50"></i>
                <p>No marksheets found.</p>
            </div>
        </div>
    }

    @{ var msIdx = 0; }
    @foreach (var marksheet in Model)
    {
        var allPassed = marksheet.Subjects.All(s => s.Status == "Pass");
        var anyFailed = marksheet.Subjects.Any(s => s.Status == "Fail");
        var anyPending = marksheet.Subjects.Any(s => s.Status == "Pending");

        string resultBadgeClass = "bg-gray-100 text-gray-600";
        string resultIcon = "fa-clock";
        if (marksheet.Result == "Pass") { resultBadgeClass = "bg-emerald-100 text-emerald-700"; resultIcon = "fa-check-circle"; }
        else if (marksheet.Result == "Fail") { resultBadgeClass = "bg-red-100 text-red-700"; resultIcon = "fa-times-circle"; }

        var msId = "ms" + msIdx;
        msIdx++;

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="flex items-center justify-between gap-3 px-5 py-4 bg-gradient-to-r from-indigo-50 to-white hover:from-indigo-100 transition-colors">
                <button @@click="expandedMarksheet = expandedMarksheet === '@msId' ? null : '@msId'"
                        class="flex items-center gap-3 min-w-0 text-left flex-1">
                    <div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                        <i class="fas fa-graduation-cap text-indigo-600 text-sm"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="text-base font-bold text-gray-800">@marksheet.ExamSchedule</h2>
                            @if (!string.IsNullOrEmpty(marksheet.Result))
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold @resultBadgeClass">
                                    <i class="fas @resultIcon text-[10px]"></i> @marksheet.Result
                                </span>
                            }
                        </div>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-0.5 mt-0.5 text-xs text-gray-500">
                            <span><i class="far fa-calendar-alt text-gray-400 mr-1"></i>@marksheet.AcademicYear</span>
                            <span><i class="far fa-building text-gray-400 mr-1"></i>@marksheet.Program</span>
                            @if (!string.IsNullOrEmpty(marksheet.College))
                            {
                                <span><i class="fas fa-university text-gray-400 mr-1"></i>@marksheet.College</span>
                            }
                            @if (!string.IsNullOrEmpty(marksheet.TotalGpa))
                            {
                                <span class="font-semibold text-indigo-600">SGPA: @marksheet.TotalGpa</span>
                            }
                            <span class="text-gray-400">@marksheet.Subjects.Count() subject@(marksheet.Subjects.Count() != 1 ? "s" : "")</span>
                        </div>
                    </div>
                </button>
                <div class="flex items-center gap-2 shrink-0">
                    <button @@click="printUrl = '@Url.Action("MarksheetPrint", new { examScheduleId = marksheet.ExamScheduleId })'; printPreview = true"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                        <i class="fas fa-print text-xs"></i> Print
                    </button>
                    <button @@click="expandedMarksheet = expandedMarksheet === '@msId' ? null : '@msId'"
                            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                        <i class="fas fa-chevron-down text-xs transition-transform"
                           :class="{ 'rotate-180': expandedMarksheet === '@msId' }"></i>
                    </button>
                </div>
            </div>

            <div x-show="expandedMarksheet === '@msId'"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-2"
                 x-transition:enter-end="opacity-100 translate-y-0">

                @if (marksheet.Subjects.Count > 0)
                {
                    <div class="hidden sm:block">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-gray-100">
                                    <th class="px-5 py-2 text-xs font-medium text-gray-400 uppercase w-8">#</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-left">Subject</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Theory</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Practical</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Total</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Grade</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Status</th>
                                    <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                @{ int rowIdx = 0; }
                                @foreach (var subject in marksheet.Subjects)
                                {
                                    var borderClass = subject.Status == "Fail" ? "border-l-4 border-l-red-400" :
                                                       subject.Status == "Pending" ? "border-l-4 border-l-amber-400" : "";
                                    var gradeColor = subject.Grade switch
                                    {
                                        "A+" or "A" => "bg-emerald-100 text-emerald-700",
                                        "B+" or "B" => "bg-blue-100 text-blue-700",
                                        "C+" or "C" => "bg-yellow-100 text-yellow-700",
                                        "D" => "bg-orange-100 text-orange-700",
                                        "F" => "bg-red-100 text-red-700",
                                        _ => "bg-gray-100 text-gray-600"
                                    };
                                    var statusClass = subject.Status == "Pass" ? "bg-emerald-100 text-emerald-700" :
                                                       subject.Status == "Fail" ? "bg-red-100 text-red-700" :
                                                       "bg-amber-100 text-amber-700";
                                    rowIdx++;
                                    <tr class="hover:bg-gray-50/50 transition-colors @borderClass">
                                        <td class="px-5 py-2.5 text-xs text-gray-400">@rowIdx</td>
                                        <td class="px-4 py-2.5">
                                            <div class="text-sm font-medium text-gray-800">@subject.SubjectName</div>
                                            <div class="text-xs text-gray-400 font-mono">@subject.SubjectCode</div>
                                        </td>
                                        <td class="px-4 py-2.5 text-center text-sm text-gray-700">@(subject.TheoryMarks?.ToString("N2") ?? "-")</td>
                                        <td class="px-4 py-2.5 text-center text-sm text-gray-700">@(subject.PracticalMarks?.ToString("N2") ?? "-")</td>
                                        <td class="px-4 py-2.5 text-center text-sm font-semibold text-gray-800">@(subject.TotalMarks?.ToString("N2") ?? "-")</td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.Status == "Pending")
                                            {
                                                <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-500 rounded-full">-</span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 text-xs font-semibold rounded-full @gradeColor">@subject.Grade</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 text-center">
                                            <span class="px-2 py-0.5 text-xs font-semibold rounded-full @statusClass">@subject.Status</span>
                                        </td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.Status == "Fail" && subject.ExamSubjectResultId > 0)
                                            {
                                                <a asp-action="RequestRetotal" asp-area="Students" asp-route-examSubjectResultId="@subject.ExamSubjectResultId"
                                                   class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 rounded-md hover:bg-amber-100 border border-amber-200/50 transition-colors">
                                                    <i class="fas fa-redo-alt text-[10px]"></i> Retotal
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="bg-gray-50 border-t-2 border-gray-200">
                                    <td colspan="4" class="px-5 py-2.5 text-right text-sm font-semibold text-gray-600">Total Marks</td>
                                    <td class="px-4 py-2.5 text-center text-sm font-bold text-gray-800">@marksheet.Subjects.Sum(s => s.TotalMarks ?? 0).ToString("N2")</td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="sm:hidden divide-y divide-gray-100">
                        @{ int mobileIdx = 0; }
                        @foreach (var subject in marksheet.Subjects)
                        {
                            mobileIdx++;
                            var borderClass = subject.Status == "Fail" ? "border-l-4 border-l-red-400" :
                                               subject.Status == "Pending" ? "border-l-4 border-l-amber-400" : "";
                            var gradeColor = subject.Grade == "F" ? "text-red-700" : "text-gray-800";
                            var statusClass = subject.Status == "Pass" ? "bg-emerald-100 text-emerald-700" :
                                               subject.Status == "Fail" ? "bg-red-100 text-red-700" :
                                               "bg-amber-100 text-amber-700";
                            <div class="px-4 py-3 @borderClass">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="flex-shrink-0 w-6 h-6 rounded bg-gray-100 flex items-center justify-center text-[10px] font-bold text-gray-400">@mobileIdx</span>
                                        <p class="text-sm font-semibold text-gray-900 truncate">@subject.SubjectName</p>
                                    </div>
                                    <div class="flex items-center gap-1.5 shrink-0 ml-2">
                                        @if (subject.Status != "Pending")
                                        {
                                            <span class="text-xs font-bold @gradeColor">@subject.Grade</span>
                                        }
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold @statusClass">@subject.Status</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 ml-8 text-xs text-gray-500">
                                    <span>TH: <span class="font-medium text-gray-700">@(subject.TheoryMarks?.ToString("N2") ?? "-")</span></span>
                                    <span>PR: <span class="font-medium text-gray-700">@(subject.PracticalMarks?.ToString("N2") ?? "-")</span></span>
                                    <span class="font-semibold text-gray-800">= @(subject.TotalMarks?.ToString("N2") ?? "-")</span>
                                    @if (subject.Status == "Fail" && subject.ExamSubjectResultId > 0)
                                    {
                                        <a asp-action="RequestRetotal" asp-area="Students" asp-route-examSubjectResultId="@subject.ExamSubjectResultId"
                                           class="ml-auto inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-medium text-amber-700 bg-amber-50 rounded border border-amber-200/50">
                                            <i class="fas fa-redo-alt text-[8px]"></i> Retotal
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        <div class="px-4 py-2.5 bg-gray-50 flex items-center justify-between text-sm">
                            <span class="font-semibold text-gray-600">Total Marks</span>
                            <span class="font-bold text-gray-800">@marksheet.Subjects.Sum(s => s.TotalMarks ?? 0).ToString("N2")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="px-5 py-8 text-center text-gray-400 text-sm">
                        <i class="fas fa-inbox text-2xl mb-2 block text-gray-300"></i>
                        No subject records for this exam.
                    </div>
                }
            </div>
        </div>
    }

    <!-- Print Preview Overlay -->
    <div x-show="printPreview" x-cloak
         class="fixed inset-0 z-50 bg-black/50 flex flex-col"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0">
        <div class="flex items-center justify-between px-4 py-3 bg-white border-b border-gray-200 shrink-0">
            <h3 class="text-sm font-semibold text-gray-700">Marksheet Preview</h3>
            <div class="flex items-center gap-2">
                <button @@click="$refs.printIframe.contentWindow.print()"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-print text-xs"></i> Print
                </button>
                <button @@click="printPreview = false; printUrl = ''"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
                    <i class="fas fa-times text-xs"></i> Close
                </button>
            </div>
        </div>
        <div class="flex-1 bg-white">
            <iframe x-ref="printIframe" :src="printUrl" class="w-full h-full border-0"></iframe>
        </div>
    </div>
</div>
