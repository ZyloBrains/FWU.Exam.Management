@model List<FWU.Exam.Management.Web.ViewModels.MarksheetViewModel>

@{
    ViewData["Title"] = "Marksheet";
}

<div class="min-h-screen space-y-5 sm:space-y-6">
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-br from-emerald-700 via-teal-800 to-slate-900">
        <div class="absolute inset-0 bg-grid-white/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
        <div class="absolute top-0 right-0 w-72 h-72 bg-emerald-400/10 rounded-full blur-3xl"></div>
        <div class="relative px-5 py-8 sm:px-10 sm:py-10">
            <div class="flex items-center gap-4">
                <div class="h-14 w-14 sm:h-16 sm:w-16 bg-white/10 backdrop-blur-xl rounded-2xl flex items-center justify-center shadow-2xl border border-white/20 shrink-0">
                    <svg class="h-7 w-7 sm:h-8 sm:w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Marksheet</h1>
                    <p class="mt-1 text-emerald-200/80 text-sm sm:text-base">View your academic results</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="text-center py-16 sm:py-20 px-6">
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-50 rounded-3xl flex items-center justify-center mx-auto mb-6">
                    <svg class="h-10 w-10 sm:h-12 sm:w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">No Marksheets Available</h3>
                <p class="text-gray-500 max-w-sm mx-auto text-sm">Your marksheets will appear here once results are published.</p>
            </div>
        </div>
    }

    @foreach (var marksheet in Model)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-4 sm:px-6 py-4 border-b border-gray-100">
                <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0">
                        <h3 class="text-sm sm:text-lg font-bold text-gray-900 truncate">@marksheet.ExamSchedule</h3>
                        <p class="text-xs sm:text-sm text-gray-500 mt-0.5 truncate">@marksheet.Program</p>
                    </div>
                    <div class="shrink-0 text-right">
                        <p class="text-[10px] sm:text-xs text-gray-500">@marksheet.AcademicYear</p>
                        <p class="text-[10px] sm:text-xs text-gray-500 truncate max-w-[120px] sm:max-w-none">@marksheet.College</p>
                    </div>
                </div>
            </div>

            <!-- Desktop table -->
            <div class="hidden sm:block overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Subject</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Theory</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Practical</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Total</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Grade</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Grade Point</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var subject in marksheet.Subjects)
                        {
                            var gradeColor = subject.Grade == "A+" || subject.Grade == "A" ? "bg-emerald-100 text-emerald-700" :
                            subject.Grade == "B+" || subject.Grade == "B" ? "bg-blue-100 text-blue-700" :
                            subject.Grade == "C+" || subject.Grade == "C" ? "bg-yellow-100 text-yellow-700" :
                            subject.Grade == "D" ? "bg-orange-100 text-orange-700" : "bg-red-100 text-red-700";
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-gray-800 font-medium">@subject.SubjectName</td>
                                <td class="px-4 py-3 text-center text-gray-800">@subject.TheoryMarks</td>
                                <td class="px-4 py-3 text-center text-gray-800">@subject.PracticalMarks</td>
                                <td class="px-4 py-3 text-center text-gray-800 font-medium">@subject.TotalMarks</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-semibold @gradeColor">@subject.Grade</span>
                                </td>
                                <td class="px-4 py-3 text-center text-gray-800">@subject.GradePoint</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-50 border-t-2 border-gray-200">
                        <tr>
                            <td colspan="3" class="px-4 py-3 text-right font-semibold text-gray-700">SGPA:</td>
                            <td class="px-4 py-3 text-center font-bold text-gray-800">@marksheet.TotalGpa</td>
                            <td class="px-4 py-3 text-center" colspan="2">
                                <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold @(marksheet.Result == "Pass" ? "bg-emerald-100 text-emerald-700" : marksheet.Result == "Fail" ? "bg-red-100 text-red-700" : "bg-gray-100 text-gray-700")">
                                    @marksheet.Result
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Mobile card list -->
            <div class="sm:hidden divide-y divide-gray-50">
                @foreach (var subject in marksheet.Subjects)
                {
                    var gradeColor = subject.Grade == "A+" || subject.Grade == "A" ? "bg-emerald-100 text-emerald-700" :
                    subject.Grade == "B+" || subject.Grade == "B" ? "bg-blue-100 text-blue-700" :
                    subject.Grade == "C+" || subject.Grade == "C" ? "bg-yellow-100 text-yellow-700" :
                    subject.Grade == "D" ? "bg-orange-100 text-orange-700" : "bg-red-100 text-red-700";
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between mb-2">
                            <p class="text-sm font-semibold text-gray-900 truncate flex-1">@subject.SubjectName</p>
                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-semibold @gradeColor shrink-0 ml-2">@subject.Grade</span>
                        </div>
                        <div class="flex items-center gap-4 text-xs text-gray-500">
                            <span class="flex items-center gap-1">
                                <span class="font-medium text-gray-700">T:</span> @subject.TheoryMarks
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="font-medium text-gray-700">P:</span> @subject.PracticalMarks
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="font-medium text-gray-700">Total:</span> @subject.TotalMarks
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="font-medium text-gray-700">GP:</span> @subject.GradePoint
                            </span>
                        </div>
                    </div>
                }
                <div class="px-4 py-3 bg-gray-50/80 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold text-gray-700">SGPA: <span class="text-gray-900">@marksheet.TotalGpa</span></span>
                        <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-semibold @(marksheet.Result == "Pass" ? "bg-emerald-100 text-emerald-700" : marksheet.Result == "Fail" ? "bg-red-100 text-red-700" : "bg-gray-100 text-gray-700")">
                            @marksheet.Result
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
