@{
    ViewData["Title"] = "Payment Failed";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 max-w-md w-full text-center">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-times-circle text-3xl text-red-600"></i>
        </div>
        <h2 class="text-xl font-bold text-gray-800 mb-2">Payment Failed</h2>
        <p class="text-sm text-gray-500 mb-6">
            @(TempData["ErrorMessage"] as string ?? "We were unable to process your payment. Please try again.")
        </p>

        <div class="flex gap-3 justify-center">
            <a asp-action="PayExamFee" asp-route-examScheduleId="@Context.Request.Query["examScheduleId"]"
               class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
                <i class="fas fa-redo"></i> Try Again
            </a>
            <a asp-action="ExamForms"
               class="inline-flex items-center gap-2 px-6 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium">
                Back to Exam Forms
            </a>
        </div>
    </div>
</div>
