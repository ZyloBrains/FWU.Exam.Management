@{
    ViewData["Title"] = "Payment Failed";
    var errorMessage = TempData["ErrorMessage"] as string ?? "We were unable to process your payment. Please try again.";
    var queryString = Context.Request.QueryString.ToString();
}

<div class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 sm:p-10 max-w-md w-full text-center">
        <div class="w-16 h-16 sm:w-20 sm:h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-5 sm:mb-6">
            <i class="fas fa-times-circle text-3xl sm:text-4xl text-red-600"></i>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">Payment Failed</h2>
        <p class="text-sm sm:text-base text-gray-500 mb-4">
            @errorMessage
        </p>

        @if (!string.IsNullOrEmpty(queryString))
        {
            <div class="mb-6 text-left bg-gray-50 rounded-xl p-3 border border-gray-200">
                <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Diagnostic Info</p>
                <code class="text-[11px] text-gray-600 break-all">@queryString</code>
            </div>
        }

        <div class="flex flex-col sm:flex-row gap-3">
            <a asp-action="PayExamFee" asp-route-examScheduleId="@(TempData["ExamScheduleId"] ?? Context.Request.Query["examScheduleId"])"
               class="inline-flex items-center justify-center gap-2 flex-1 px-6 py-3 sm:py-3.5 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl hover:from-blue-700 hover:to-blue-800 active:scale-[0.97] transition-all font-semibold shadow-lg shadow-blue-600/20 text-sm sm:text-base">
                <i class="fas fa-redo"></i>
                Try Again
            </a>
            <a asp-action="ExamForms"
               class="inline-flex items-center justify-center gap-2 flex-1 px-6 py-3 sm:py-3.5 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 active:scale-[0.97] transition-all font-semibold text-sm sm:text-base">
                Back to Exam Forms
            </a>
        </div>
    </div>
</div>
