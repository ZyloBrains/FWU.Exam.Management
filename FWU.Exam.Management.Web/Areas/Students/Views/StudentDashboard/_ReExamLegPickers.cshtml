@model FWU.Exam.Management.Web.ViewModels.SubjectFeeDetail
@* Per-paper (theory/practical) selection for re-exam forms. Emits tokens
   consumed by collectSelection() in PayExamFee/ApplyAgain scripts. *@
<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
    @if (Model.HasTheory)
    {
        <label class="inline-flex items-center gap-1.5 text-xs font-medium cursor-pointer select-none @(Model.FailedTheory ? "text-red-600" : "text-gray-600")">
            <input type="checkbox" class="leg-checkbox rounded border-gray-300 h-4 w-4"
                   data-offering="@Model.SubjectOfferingId" data-leg="T"
                   onchange="updateTotals()"
                   checked="@(Model.SelectedTheory ? "checked" : null)" />
            Theory
            @if (Model.FailedTheory)
            {
                <span class="px-1 py-0.5 rounded bg-red-100 text-[10px] font-semibold text-red-600">Failed</span>
            }
        </label>
    }
    @if (Model.HasPractical)
    {
        <label class="inline-flex items-center gap-1.5 text-xs font-medium cursor-pointer select-none @(Model.FailedPractical ? "text-red-600" : "text-gray-600")">
            <input type="checkbox" class="leg-checkbox rounded border-gray-300 h-4 w-4"
                   data-offering="@Model.SubjectOfferingId" data-leg="P"
                   data-practical-fee="@Model.PracticalFee"
                   onchange="updateTotals()"
                   checked="@(Model.SelectedPractical ? "checked" : null)" />
            Practical
            <span class="font-normal text-gray-400">(Rs @Model.PracticalFee.ToString("N0"))</span>
            @if (Model.FailedPractical)
            {
                <span class="px-1 py-0.5 rounded bg-red-100 text-[10px] font-semibold text-red-600">Failed</span>
            }
        </label>
    }
</div>
