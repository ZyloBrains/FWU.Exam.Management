@model FWU.Exam.Management.Web.ViewModels.ExamFormsListViewModel

@{
    ViewData["Title"] = "Exam Forms";
}

<div class="min-h-screen">

    @await Html.PartialAsync("_AlertMessages")

    @if (Model.ExamForms.Count == 0)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="text-center py-16 sm:py-20 px-6">
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-50 rounded-3xl flex items-center justify-center mx-auto mb-6">
                    <svg class="h-10 w-10 sm:h-12 sm:w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">No Exam Schedules Available</h3>
                <p class="text-gray-500 max-w-sm mx-auto text-sm">Exam schedules for your program have not been published yet. Please check back later.</p>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @for (int i = 0; i < Model.ExamForms.Count; i++)
            {
                var form = Model.ExamForms[i];
                var semesterNum = form.Semester?.Contains('/') == true ? form.Semester.Split('/')[1].Trim() : form.Semester;
                var hasDeadline = !string.IsNullOrWhiteSpace(form.EndDateBs);

                <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-xl hover:border-blue-100 transition-all duration-300 group">
                    <div class="flex flex-col sm:flex-row">
                        @* Left accent + number *@
                        <div class="hidden sm:flex w-20 shrink-0 flex-col items-center justify-center @(form.HasPaid ? "bg-gradient-to-b from-emerald-50 to-emerald-100" : "bg-gradient-to-b from-blue-50 to-indigo-100")">
                            <span class="text-3xl font-extrabold @(form.HasPaid ? "text-emerald-500" : "text-blue-500")">@(i + 1)</span>
                        </div>

                        @* Content *@
                        <div class="flex-1 p-5 sm:p-6">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <h3 class="text-lg sm:text-xl font-bold text-gray-900 group-hover:text-blue-700 transition-colors">@form.ExamScheduleName</h3>
                                    <div class="mt-1 inline-flex items-center gap-1.5 text-sm text-gray-500">
                                        <i class="fas fa-graduation-cap text-blue-400 text-xs"></i>
                                        Semester @semesterNum
                                    </div>
                                </div>

                                <div class="shrink-0">
                                    @if (!form.HasPaid)
                                    {
                                        <a asp-action="PayExamFee" asp-route-examScheduleId="@form.ExamScheduleId"
                                           class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl text-sm font-semibold hover:from-blue-700 hover:to-indigo-700 active:scale-[0.97] transition-all shadow-md shadow-blue-600/20">
                                            <i class="fas fa-arrow-right text-xs"></i>
                                            Pay Now
                                        </a>
                                    }
                                    else if (form.HasAdmitCard && form.AdmitCardId.HasValue)
                                    {
                                        <a asp-area="Exams" asp-controller="AdmitCards" asp-action="Download" asp-route-id="@form.AdmitCardId"
                                           target="_blank"
                                           class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-emerald-700 text-white rounded-xl text-sm font-semibold hover:from-emerald-700 hover:to-emerald-800 active:scale-[0.97] transition-all shadow-md shadow-emerald-600/20">
                                            <i class="fas fa-download text-xs"></i>
                                            Download Admit Card
                                        </a>
                                    }
                                    else if (form.HasPaid)
                                    {
                                        <span class="inline-flex items-center gap-2 px-4 py-2.5 bg-amber-50 text-amber-700 rounded-xl text-sm font-semibold border border-amber-200">
                                            <span class="relative flex h-2.5 w-2.5">
                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
                                            </span>
                                            Admit Card Pending
                                        </span>
                                    }
                                </div>
                            </div>

                            @* Deadline *@
                            @if (hasDeadline)
                            {
                                <div class="mt-3 pt-3 border-t border-dashed border-gray-200">
                                    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-xs font-semibold">
                                        <i class="fas fa-clock"></i>
                                        Submission Deadline: @form.EndDateBs BS
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
