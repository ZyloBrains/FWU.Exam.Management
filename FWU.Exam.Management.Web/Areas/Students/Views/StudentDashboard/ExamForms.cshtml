@model FWU.Exam.Management.Web.ViewModels.ExamFormsListViewModel

@{
    ViewData["Title"] = "Exam Forms";
}

<div class="min-h-screen">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-600 via-blue-700 to-blue-800 mb-6 sm:mb-8">
        <div class="absolute inset-0 bg-grid-white/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
        <div class="absolute top-0 right-0 w-72 h-72 bg-blue-400/10 rounded-full blur-3xl"></div>
        <div class="relative px-5 py-8 sm:px-10 sm:py-10">
            <div class="flex items-center gap-4">
                <div class="h-14 w-14 sm:h-16 sm:w-16 bg-white/10 backdrop-blur-xl rounded-2xl flex items-center justify-center shadow-2xl border border-white/20 shrink-0">
                    <svg class="h-7 w-7 sm:h-8 sm:w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Exam Forms</h1>
                    <p class="mt-1 text-blue-200/80 text-sm sm:text-base">Register and pay for upcoming examinations</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.ExamForms.Count == 0)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="text-center py-16 sm:py-20 px-6">
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-50 rounded-3xl flex items-center justify-center mx-auto mb-6">
                    <svg class="h-10 w-10 sm:h-12 sm:w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">No Exam Schedules Available</h3>
                <p class="text-gray-500 max-w-sm mx-auto text-sm">Exam schedules for your program have not been published yet. Please check back later.</p>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-4 sm:space-y-0">
            @for (int i = 0; i < Model.ExamForms.Count; i++)
            {
                var form = Model.ExamForms[i];
                var statusColors = form.HasPaid
                    ? "bg-emerald-50 border-emerald-200 text-emerald-700"
                    : "bg-amber-50 border-amber-200 text-amber-700";
                var statusIcon = form.HasPaid ? "fa-check-circle" : "fa-clock";
                var statusLabel = form.HasPaid ? "Paid" : "Pending";

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all duration-200 sm:border-b-0 sm:rounded-none sm:shadow-none sm:hover:shadow-none">
                    <div class="p-4 sm:p-6">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-start gap-3 sm:gap-4 min-w-0 flex-1">
                                <div class="hidden sm:flex w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 items-center justify-center shadow-md shadow-blue-500/20 shrink-0">
                                    <span class="text-white font-bold text-sm">@(i + 1)</span>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="text-base sm:text-lg font-bold text-gray-900">@form.ExamScheduleName</h3>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold @statusColors border">
                                            <i class="fas @statusIcon text-[10px]"></i>
                                            @statusLabel
                                        </span>
                                    </div>
                                    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
                                        <span class="inline-flex items-center gap-1.5">
                                            <i class="fas fa-layer-group text-gray-400 text-xs"></i>
                                            @form.Level · @form.Program
                                        </span>
                                        <span class="inline-flex items-center gap-1.5">
                                            <i class="fas fa-book-open text-gray-400 text-xs"></i>
                                            @form.Semester
                                        </span>
                                        @if (form.Amount > 0)
                                        {
                                            <span class="inline-flex items-center gap-1.5 font-semibold text-gray-700">
                                                <i class="fas fa-tag text-gray-400 text-xs"></i>
                                                Rs @form.Amount.ToString("N0")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="sm:hidden">
                                @if (!form.HasPaid && form.Amount > 0)
                                {
                                    <a asp-action="PayExamFee" asp-route-examScheduleId="@form.ExamScheduleId"
                                       class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-semibold hover:bg-blue-700 active:bg-blue-800 transition-all shadow-sm shadow-blue-600/20">
                                        <i class="fas fa-arrow-right text-xs"></i>
                                        Pay
                                    </a>
                                }
                                else if (form.HasPaid)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-2 bg-emerald-50 text-emerald-700 rounded-xl text-sm font-semibold">
                                        <i class="fas fa-check-circle"></i>
                                        Done
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Desktop: hidden on mobile -->
                    <div class="hidden sm:block border-t border-gray-100">
                        <div class="px-6 py-3 flex items-center justify-between">
                            <div class="flex items-center gap-6 text-sm">
                                <span class="text-gray-500">
                                    <span class="font-medium text-gray-700">Level:</span> @form.Level
                                </span>
                                <span class="text-gray-500">
                                    <span class="font-medium text-gray-700">Program:</span> @form.Program
                                </span>
                                <span class="text-gray-500">
                                    <span class="font-medium text-gray-700">Semester:</span> @form.Semester
                                </span>
                            </div>
                            <div class="flex items-center gap-3">
                                @if (form.Amount > 0)
                                {
                                    <span class="text-sm font-bold text-gray-800">Rs @form.Amount.ToString("N0")</span>
                                }
                                @if (!form.HasPaid && form.Amount > 0)
                                {
                                    <a asp-action="PayExamFee" asp-route-examScheduleId="@form.ExamScheduleId"
                                       class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl text-sm font-semibold hover:from-blue-700 hover:to-blue-800 active:scale-[0.97] transition-all shadow-md shadow-blue-600/20">
                                        <i class="fas fa-credit-card"></i>
                                        Pay Now
                                    </a>
                                }
                                else if (form.HasPaid)
                                {
                                    <span class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 text-emerald-700 rounded-xl text-sm font-semibold border border-emerald-200">
                                        <i class="fas fa-check-circle"></i>
                                        Completed
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Mobile: fee row -->
                    <div class="sm:hidden border-t border-gray-100 px-4 py-3 flex items-center justify-between">
                        <div>
                            <span class="text-xs text-gray-500">Exam Fee</span>
                            <p class="text-base font-bold text-gray-900">
                                @if (form.Amount > 0)
                                {
                                    <span>Rs @form.Amount.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">Free</span>
                                }
                            </p>
                        </div>
                        @if (!form.HasPaid && form.Amount > 0)
                        {
                            <a asp-action="PayExamFee" asp-route-examScheduleId="@form.ExamScheduleId"
                               class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl text-sm font-semibold hover:from-blue-700 hover:to-blue-800 active:scale-[0.97] transition-all shadow-md shadow-blue-600/20">
                                <i class="fas fa-credit-card"></i>
                                Pay Rs @form.Amount.ToString("N0")
                            </a>
                        }
                        else if (form.HasPaid)
                        {
                            <span class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 text-emerald-700 rounded-xl text-sm font-semibold border border-emerald-200">
                                <i class="fas fa-check-circle"></i>
                                Completed
                            </span>
                        }
                    </div>
                </div>

                @if (i < Model.ExamForms.Count - 1)
                {
                    <div class="sm:hidden h-px bg-gray-100 mx-4"></div>
                }
            }
        </div>
    }
</div>
