@model FWU.Exam.Management.Web.ViewModels.ExamFormsListViewModel

@{
    ViewData["Title"] = "Exam Forms";
    var showMandatoryPopup = ViewBag.ShowMandatoryProfilePopup as bool? ?? false;
    var missingMandatoryFields = (ViewBag.MissingMandatoryFields as List<string>) ?? new List<string>();
}

<div x-data="{ mandatoryPopupOpen: @(showMandatoryPopup ? "true" : "false") }" class="min-h-screen">

    @await Html.PartialAsync("_AlertMessages")

    @if (showMandatoryPopup)
    {
        <div x-show="mandatoryPopupOpen" x-cloak
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-[110] flex items-center justify-center p-4"
             x-on:keydown.escape.window="mandatoryPopupOpen = false">
            <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" x-on:click="mandatoryPopupOpen = false"></div>
            <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden"
                 x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="transform opacity-0 scale-95"
                 x-transition:enter-end="transform opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-100"
                 x-transition:leave-start="transform opacity-100 scale-100"
                 x-transition:leave-end="transform opacity-0 scale-95">
                <div class="bg-gradient-to-r from-admin-blue to-admin-blue-dark px-6 py-5 relative overflow-hidden">
                    <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-white/10"></div>
                    <div class="absolute right-6 -bottom-8 w-16 h-16 rounded-full bg-white/10"></div>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0">
                            <i class="fas fa-clipboard-check text-white text-lg"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-white font-semibold text-lg">Complete Your Profile</h3>
                            <p class="text-blue-100 text-xs mt-0.5">@missingMandatoryFields.Count required field(s) missing</p>
                        </div>
                    </div>
                </div>
                <div class="p-6">
                    <p class="text-sm text-gray-600">Please fill in the following mandatory details in your profile before filling an exam form:</p>
                    <ul class="mt-4 space-y-2 max-h-56 overflow-y-auto pr-1">
                        @foreach (var field in missingMandatoryFields)
                        {
                            <li class="flex items-center gap-2 text-sm text-gray-700">
                                <span class="w-5 h-5 rounded-full bg-red-100 text-red-600 flex items-center justify-center shrink-0">
                                    <i class="fas fa-times text-[10px]"></i>
                                </span>
                                @field
                            </li>
                        }
                    </ul>
                    <div class="mt-6 flex flex-col-reverse sm:flex-row gap-3">
                        <button type="button" x-on:click="mandatoryPopupOpen = false"
                                class="px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                            Close
                        </button>
                        <a asp-area="" asp-controller="Profile" asp-action="Edit"
                           class="flex-1 px-5 py-2 rounded-lg bg-gradient-to-r from-admin-blue to-admin-blue-dark text-white text-sm font-medium text-center hover:opacity-95 transition-opacity shadow-sm">
                            <i class="fas fa-user-edit mr-1"></i> Complete Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.ExamForms.Count == 0)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="text-center py-16 sm:py-20 px-6">
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-50 rounded-3xl flex items-center justify-center mx-auto mb-6">
                    <svg class="h-10 w-10 sm:h-12 sm:w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">No Exam Schedules Available</h3>
                <p class="text-gray-500 max-w-sm mx-auto text-sm">Exam schedules for your program have not been published yet. Please check back later.</p>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @for (int i = 0; i < Model.ExamForms.Count; i++)
            {
                var form = Model.ExamForms[i];
                var semesterRaw = form.Semester?.Contains('/') == true ? form.Semester.Split('/')[1].Trim() : form.Semester;
                if (!string.IsNullOrWhiteSpace(semesterRaw) && semesterRaw.StartsWith("Semester", StringComparison.OrdinalIgnoreCase))
                    semesterRaw = semesterRaw["Semester".Length..].Trim();
                var semesterNum = semesterRaw;
                var hasDeadline = !string.IsNullOrWhiteSpace(form.EndDateBs);

                <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-xl hover:border-blue-100 transition-all duration-300 group">
                    <div class="flex flex-col sm:flex-row">
                        @* Left accent + number *@
                        <div class="hidden sm:flex w-20 shrink-0 flex-col items-center justify-center @(form.IsRejected ? "bg-gradient-to-b from-red-50 to-red-100" : form.HasPaid ? "bg-gradient-to-b from-emerald-50 to-emerald-100" : "bg-gradient-to-b from-blue-50 to-indigo-100")">
                            <span class="text-3xl font-extrabold @(form.IsRejected ? "text-red-500" : form.HasPaid ? "text-emerald-500" : "text-blue-500")">@(i + 1)</span>
                        </div>

                        @* Content *@
                        <div class="flex-1 p-5 sm:p-6">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <h3 class="text-lg sm:text-xl font-bold text-gray-900 group-hover:text-blue-700 transition-colors">@form.ExamScheduleName</h3>
                                    <div class="mt-1 inline-flex items-center gap-1.5 text-sm text-gray-500">
                                        <i class="fas fa-graduation-cap text-blue-400 text-xs"></i>
                                        <span>Semester @(string.IsNullOrWhiteSpace(semesterNum) ? "-" : semesterNum)</span>
                                    </div>
                                </div>

                                <div class="shrink-0">
                                    @if (form.IsRejected)
                                    {
                                        <a asp-action="ApplyAgain" asp-route-examScheduleId="@form.ExamScheduleId"
                                           class="inline-flex items-center gap-2 px-5 py-2.5 bg-red-600 text-white rounded-lg text-sm font-semibold hover:bg-red-700 active:scale-[0.97] transition-all shadow-sm shadow-red-600/25">
                                            <i class="fas fa-rotate-right text-xs"></i>
                                            Apply Again
                                        </a>
                                    }
                                    else if (!form.HasPaid)
                                    {
                                        <a asp-action="PayExamFee" asp-route-examScheduleId="@form.ExamScheduleId"
                                           class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 active:scale-[0.97] transition-all shadow-sm shadow-blue-600/25">
                                            <i class="fas fa-arrow-right text-xs"></i>
                                            Pay Now
                                        </a>
                                    }
                                    else if (form.HasAdmitCard && form.AdmitCardId.HasValue)
                                    {
                                        <a asp-area="Students" asp-controller="StudentDashboard" asp-action="Download" asp-route-id="@form.AdmitCardId"
                                           target="_blank"
                                           class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-600 text-white rounded-lg text-sm font-semibold hover:bg-emerald-700 active:scale-[0.97] transition-all shadow-sm shadow-emerald-600/25">
                                            <i class="fas fa-download text-xs"></i>
                                            Download Admit Card
                                        </a>
                                    }
                                    else if (form.HasPaid)
                                    {
                                        <span class="inline-flex items-center gap-2 px-4 py-2.5 bg-amber-50 text-amber-700 rounded-lg text-sm font-semibold border border-amber-200">
                                            <span class="relative flex h-2.5 w-2.5">
                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
                                            </span>
                                            Admit Card Pending
                                        </span>
                                    }
                                </div>
                            </div>

                            @* Rejection notice *@
                            @if (form.IsRejected)
                            {
                                <div class="mt-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3">
                                    <p class="text-sm font-semibold text-red-700 flex items-center gap-2">
                                        <i class="fas fa-ban"></i>
                                        Your previous exam form was rejected
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(form.RejectionReason))
                                    {
                                        <p class="text-sm text-red-600 mt-1.5 leading-relaxed">
                                            <span class="font-semibold">Reason:</span> @form.RejectionReason
                                        </p>
                                    }
                                    <p class="text-xs text-red-500 mt-1.5">Please review your details and apply again before the submission deadline.</p>
                                </div>
                            }

                            @* Deadline *@
                            @if (hasDeadline)
                            {
                                <div class="mt-3 pt-3 border-t border-dashed border-gray-200">
                                    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-xs font-semibold">
                                        <i class="fas fa-clock"></i>
                                        Submission Deadline: @form.EndDateBs BS
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
