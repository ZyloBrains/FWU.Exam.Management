@model List<FWU.Exam.Management.Domain.Entities.Exams.AdmitCard>

@{
    ViewData["Title"] = "Admit Cards";
}

<div class="min-h-screen">

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="text-center py-16 sm:py-20 px-6">
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-50 rounded-3xl flex items-center justify-center mx-auto mb-6">
                    <svg class="h-10 w-10 sm:h-12 sm:w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">No Admit Cards Available</h3>
                <p class="text-gray-500 max-w-sm mx-auto text-sm">Your admit cards will appear here after your exam registration is verified and approved by the administration.</p>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var card in Model)
            {
                var examName = card.ExamSchedule?.ExamScheduleName ?? "Exam";
                var semesterName = card.ExamSchedule?.Semester?.Name ?? "";

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all duration-200">
                    <div class="p-4 sm:p-6">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-start gap-3 sm:gap-4 min-w-0 flex-1">
                                <div class="hidden sm:flex w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 items-center justify-center shadow-md shadow-indigo-500/20 shrink-0">
                                    <i class="fas fa-ticket-alt text-white text-sm"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="text-base sm:text-lg font-bold text-gray-900">@examName</h3>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 border border-indigo-200 text-indigo-700">
                                            <i class="fas fa-check-circle text-[10px]"></i>
                                            Generated
                                        </span>
                                    </div>
                                    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
                                        @if (!string.IsNullOrEmpty(semesterName))
                                        {
                                            <span class="inline-flex items-center gap-1.5">
                                                <i class="fas fa-book-open text-gray-400 text-xs"></i>
                                                @semesterName
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(card.ExamRollNo))
                                        {
                                            <span class="inline-flex items-center gap-1.5">
                                                <i class="fas fa-hashtag text-gray-400 text-xs"></i>
                                                Roll No: @card.ExamRollNo
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(card.AdmitCardNumber))
                                        {
                                            <span class="inline-flex items-center gap-1.5">
                                                <i class="fas fa-barcode text-gray-400 text-xs"></i>
                                                @card.AdmitCardNumber
                                            </span>
                                        }
                                        <span class="inline-flex items-center gap-1.5">
                                            <i class="fas fa-calendar text-gray-400 text-xs"></i>
                                            @card.GeneratedDate.ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="shrink-0">
                                <a asp-area="Exams" asp-controller="AdmitCards" asp-action="Download" asp-route-id="@card.Id"
                                   target="_blank"
                                   class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-700 active:scale-[0.97] transition-all shadow-sm shadow-indigo-600/25">
                                    <i class="fas fa-download"></i>
                                    Download
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="sm:hidden border-t border-gray-100 px-4 py-3">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-gray-500">Roll No</span>
                            <span class="font-semibold text-gray-900">@(card.ExamRollNo ?? "N/A")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
