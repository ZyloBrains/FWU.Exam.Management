@model FWU.Exam.Management.Web.ViewModels.ExamPaymentViewModel

@{
    ViewData["Title"] = "Pay Exam Fee";
    var compulsorySubjects = Model.Subjects.Where(s => s.IsCompulsory).ToList();
    var electiveSubjects = Model.Subjects.Where(s => !s.IsCompulsory).ToList();
}

<div class="min-h-screen pb-24 sm:pb-6">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-700 via-indigo-800 to-slate-900 mb-6 sm:mb-8">
        <div class="absolute inset-0 bg-grid-white/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
        <div class="absolute top-0 right-0 w-72 h-72 bg-indigo-400/10 rounded-full blur-3xl"></div>
        <div class="relative px-5 py-8 sm:px-10 sm:py-10">
            <div class="flex items-center gap-4">
                <div class="h-14 w-14 sm:h-16 sm:w-16 bg-white/10 backdrop-blur-xl rounded-2xl flex items-center justify-center shadow-2xl border border-white/20 shrink-0">
                    <svg class="h-7 w-7 sm:h-8 sm:w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                </div>
                <div class="min-w-0">
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Pay Exam Fee</h1>
                    <p class="mt-1 text-blue-200/80 text-sm sm:text-base truncate">@Model.ExamScheduleName</p>
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-5 sm:space-y-6">
        <!-- Status Banner -->
        <div class="rounded-2xl border-2 p-4 sm:p-5 flex items-start gap-3 @(Model.IsRegular ? "bg-emerald-50 border-emerald-200" : "bg-amber-50 border-amber-200")">
            <div class="shrink-0 w-9 h-9 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center @(Model.IsRegular ? "bg-emerald-100 text-emerald-600" : "bg-amber-100 text-amber-600")">
                <i class="fas @(Model.IsRegular ? "fa-check-circle" : "fa-exclamation-triangle")"></i>
            </div>
            <div class="text-sm sm:text-base @(Model.IsRegular ? "text-emerald-800" : "text-amber-800")">
                <span class="font-semibold">@(Model.IsRegular ? "Regular Student" : "Non-Regular Student")</span>
                <p class="mt-0.5 text-xs sm:text-sm opacity-80">
                    @if (Model.IsRegular)
                    {
                        <text>Compulsory subjects are auto-selected. Tick elective subjects below to include them.</text>
                    }
                    else
                    {
                        <text>Subjects you previously failed are pre-selected. You may adjust your selection.</text>
                    }
                </p>
            </div>
        </div>

        <!-- Subject Selection -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-4 sm:px-6 py-4 border-b border-gray-100">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-md shadow-blue-500/20">
                            <i class="fas fa-book text-white text-sm"></i>
                        </div>
                        <div>
                            <h2 class="text-base sm:text-lg font-bold text-gray-900">Subject Selection</h2>
                            <p class="text-xs sm:text-sm text-gray-500">@Model.ProgramName - @Model.SemesterName</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold @(Model.IsRegular ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">
                        <i class="fas @(Model.IsRegular ? "fa-user-graduate" : "fa-user-edit")"></i>
                        @(Model.IsRegular ? "Regular" : "Non-Regular")
                    </span>
                </div>
            </div>

            @if (compulsorySubjects.Any())
            {
                <div class="px-4 sm:px-6 py-3 bg-gradient-to-r from-blue-50 to-indigo-50 border-b border-gray-100">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs sm:text-sm font-bold text-blue-700 uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-star-of-life text-[10px]"></i>
                            Compulsory Subjects
                        </h4>
                        <span class="text-xs text-blue-500 font-medium">@compulsorySubjects.Count subject@(compulsorySubjects.Count != 1 ? "s" : "")</span>
                    </div>
                </div>
                <div class="divide-y divide-gray-50">
                    @for (int i = 0; i < compulsorySubjects.Count; i++)
                    {
                        var subj = compulsorySubjects[i];
                        var isAutoSelected = Model.IsRegular || subj.IsFailed;
                        var isDisabled = Model.IsRegular; // Regular students can't unselect compulsory
                        <div class="subject-card px-4 sm:px-6 py-3 sm:py-4 transition-colors @(subj.IsSelected ? "bg-blue-50/40" : "") @(subj.IsFailed ? "bg-red-50/20" : "")" data-subject-id="@subj.SubjectOfferingId" data-exam-fee="@subj.ExamFee" data-practical-fee="@subj.PracticalFee" data-is-selected="@(subj.IsSelected ? "true" : "false")">
                            <div class="flex items-start gap-3 sm:gap-4">
                                @if (!Model.IsRegular)
                                {
                                    <div class="mt-0.5">
                                        <input type="checkbox" value="@subj.SubjectOfferingId" data-exam-fee="@subj.ExamFee" data-practical-fee="@subj.PracticalFee" class="subject-checkbox w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                                        checked="@(subj.IsSelected ? "checked" : null)" onchange="updateTotals()" />
                                    </div>
                                }
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-xs sm:text-sm font-semibold text-gray-900">@subj.SubjectName</span>
                                        @if (subj.IsFailed)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-medium bg-red-100 text-red-700 border border-red-200">
                                                <i class="fas fa-exclamation-circle"></i>
                                                Previously Failed
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
                                        <span class="font-mono">@subj.SubjectCode</span>
                                        <span class="flex items-center gap-1 @(subj.HasTheory ? "text-blue-600" : "text-gray-300")">
                                            <i class="fas @(subj.HasTheory ? "fa-check-circle" : "fa-times-circle") text-[10px]"></i>
                                            Theory
                                        </span>
                                        <span class="flex items-center gap-1 @(subj.HasPractical ? "text-amber-600" : "text-gray-300")">
                                            <i class="fas @(subj.HasPractical ? "fa-check-circle" : "fa-times-circle") text-[10px]"></i>
                                            Practical
                                        </span>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    @if (subj.ExamFee > 0 && subj.PracticalFee > 0)
                                    {
                                        <p class="text-xs font-semibold text-gray-900">Rs @((subj.ExamFee + subj.PracticalFee).ToString("N0"))</p>
                                        <p class="text-[10px] text-gray-400">E: @subj.ExamFee.ToString("N0") + P: @subj.PracticalFee.ToString("N0")</p>
                                    }
                                    else if (subj.ExamFee > 0)
                                    {
                                        <p class="text-xs font-semibold text-gray-900">Rs @subj.ExamFee.ToString("N0")</p>
                                    }
                                    else
                                    {
                                        <p class="text-xs font-semibold text-gray-900">Rs @subj.PracticalFee.ToString("N0")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (electiveSubjects.Any())
            {
                <div class="px-4 sm:px-6 py-3 bg-gradient-to-r from-purple-50 to-pink-50 border-b border-gray-100">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs sm:text-sm font-bold text-purple-700 uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-bookmark text-[10px]"></i>
                            Elective Subjects
                        </h4>
                        <label class="flex items-center gap-2 text-xs text-purple-600 cursor-pointer select-none">
                            <input type="checkbox" id="selectAll" onchange="toggleAllElec(this)" class="w-4 h-4 rounded border-gray-300 text-purple-600 focus:ring-purple-500" />
                            <span class="font-medium">Select All</span>
                        </label>
                    </div>
                </div>
                <div class="divide-y divide-gray-50">
                    @for (int i = 0; i < electiveSubjects.Count; i++)
                    {
                        var subj = electiveSubjects[i];
                        <div class="subject-card px-4 sm:px-6 py-3 sm:py-4 transition-colors @(subj.IsSelected ? "bg-purple-50/40" : "") @(subj.IsFailed ? "bg-red-50/20" : "")" data-subject-id="@subj.SubjectOfferingId" data-exam-fee="@subj.ExamFee" data-practical-fee="@subj.PracticalFee" data-is-selected="@(subj.IsSelected ? "true" : "false")">
                            <div class="flex items-start gap-3 sm:gap-4">
                                <div class="mt-0.5">
                                    <input type="checkbox" value="@subj.SubjectOfferingId" data-exam-fee="@subj.ExamFee" data-practical-fee="@subj.PracticalFee"
                                    class="subject-checkbox elective-checkbox w-5 h-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500 cursor-pointer"
                                    checked="@(subj.IsSelected ? "checked" : null)" onchange="updateTotals()" />
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-xs sm:text-sm font-semibold text-gray-900">@subj.SubjectName</span>
                                        @if (subj.IsFailed)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-medium bg-red-100 text-red-700 border border-red-200">
                                                <i class="fas fa-exclamation-circle"></i>
                                                Previously Failed
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
                                        <span class="font-mono">@subj.SubjectCode</span>
                                        <span class="flex items-center gap-1 @(subj.HasTheory ? "text-blue-600" : "text-gray-300")">
                                            <i class="fas @(subj.HasTheory ? "fa-check-circle" : "fa-times-circle") text-[10px]"></i>
                                            Theory
                                        </span>
                                        <span class="flex items-center gap-1 @(subj.HasPractical ? "text-amber-600" : "text-gray-300")">
                                            <i class="fas @(subj.HasPractical ? "fa-check-circle" : "fa-times-circle") text-[10px]"></i>
                                            Practical
                                        </span>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    @if (subj.ExamFee > 0 && subj.PracticalFee > 0)
                                    {
                                        <p class="text-xs font-semibold text-gray-900">Rs @((subj.ExamFee + subj.PracticalFee).ToString("N0"))</p>
                                        <p class="text-[10px] text-gray-400">E: @subj.ExamFee.ToString("N0") + P: @subj.PracticalFee.ToString("N0")</p>
                                    }
                                    else if (subj.ExamFee > 0)
                                    {
                                        <p class="text-xs font-semibold text-gray-900">Rs @subj.ExamFee.ToString("N0")</p>
                                    }
                                    else
                                    {
                                        <p class="text-xs font-semibold text-gray-900">Rs @subj.PracticalFee.ToString("N0")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Fee Breakdown Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-2">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-blue-50 flex items-center justify-center">
                        <i class="fas fa-file-invoice text-blue-600 text-xs sm:text-sm"></i>
                    </div>
                    <span class="text-[10px] sm:text-xs text-gray-500 uppercase tracking-wider font-medium">Exam Fee</span>
                </div>
                <p class="text-lg sm:text-xl font-bold text-gray-800" id="breakupExamFee">Rs @Model.TotalExamFee.ToString("N0")</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-2">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-amber-50 flex items-center justify-center">
                        <i class="fas fa-flask text-amber-600 text-xs sm:text-sm"></i>
                    </div>
                    <span class="text-[10px] sm:text-xs text-gray-500 uppercase tracking-wider font-medium">Practical Fee</span>
                </div>
                <p class="text-lg sm:text-xl font-bold text-gray-800" id="breakupPracticalFee">Rs @Model.TotalPracticalFee.ToString("N0")</p>
            </div>
            <div class="col-span-2 sm:col-span-1 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-2xl shadow-lg shadow-blue-600/20 p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-2">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-white/20 flex items-center justify-center">
                        <i class="fas fa-calculator text-white text-xs sm:text-sm"></i>
                    </div>
                    <span class="text-[10px] sm:text-xs text-blue-200 uppercase tracking-wider font-medium">Total Amount</span>
                </div>
                <p class="text-lg sm:text-xl font-bold text-white" id="breakupGrandTotal">Rs @Model.GrandTotal.ToString("N0")</p>
                <p class="text-[10px] sm:text-xs text-blue-200 mt-0.5" id="selectedCount">@Model.Subjects.Count(s => s.IsSelected) subject(s) selected</p>
            </div>
        </div>

        <!-- Payment Method -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-4 sm:px-6 py-4 border-b border-gray-100">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-md shadow-emerald-500/20">
                        <i class="fas fa-credit-card text-white text-sm"></i>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-gray-900">Payment Method</h2>
                        <p class="text-xs sm:text-sm text-gray-500">Choose a payment gateway to complete your transaction</p>
                    </div>
                </div>
            </div>
            <div class="px-4 sm:px-6 py-4 sm:py-6">
                @if (Model.PaymentTypes.Count > 0)
                {
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
                        @foreach (var pt in Model.PaymentTypes)
                        {
                            var key = pt.Name?.ToLowerInvariant() ?? "";
                            var (bg, border, text, hoverBorder) = key switch
                            {
                                "esewa" => ("bg-green-50", "border-green-200", "text-green-700", "hover:border-green-400"),
                                "khalti" => ("bg-purple-50", "border-purple-200", "text-purple-700", "hover:border-purple-400"),
                                "connectips" => ("bg-blue-50", "border-blue-200", "text-blue-700", "hover:border-blue-400"),
                                _ => ("bg-gray-50", "border-gray-200", "text-gray-700", "hover:border-gray-400")
                            };

                            <button type="button" onclick="processPayment('@key')"
                                    class="group flex items-center sm:flex-col gap-4 sm:gap-3 p-4 sm:p-6 @bg border-2 @border rounded-xl @hoverBorder transition-all duration-200 active:scale-[0.98] text-left">
                                <div class="w-12 h-12 sm:w-16 sm:h-16 shrink-0 rounded-xl flex items-center justify-center @bg @border">
                                    @if (!string.IsNullOrEmpty(pt.LogoUrl))
                                    {
                                        <img src="@pt.LogoUrl" alt="@pt.Name" class="w-8 h-8 sm:w-10 sm:h-10 object-contain" onerror="this.parentElement.innerHTML='<i class=\'fas fa-credit-card text-xl sm:text-2xl @text\'></i>'" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-credit-card text-xl sm:text-2xl @text"></i>
                                    }
                                </div>
                                <div class="flex-1 sm:text-center">
                                    <p class="text-sm sm:text-base font-bold @text">@pt.Name</p>
                                    <p class="text-xs @(text.Replace("700", "500")) mt-0.5">Pay with @pt.Name</p>
                                </div>
                                <i class="fas fa-chevron-right @text sm:hidden text-sm"></i>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8 sm:py-10 text-gray-400">
                        <i class="fas fa-credit-card text-3xl sm:text-4xl mb-3 block"></i>
                        <p class="text-sm sm:text-base font-medium text-gray-500">No payment gateways configured</p>
                        <p class="text-xs sm:text-sm text-gray-400 mt-1">Please contact your administrator.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sticky Bottom Bar (Mobile) -->
    <div id="mobileBottomBar" class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-2xl shadow-black/20 p-3 sm:p-4 z-50 block md:hidden safe-area-bottom">
        <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
                <p class="text-xs text-gray-500">Total Amount</p>
                <p class="text-lg font-extrabold text-gray-900" id="stickyTotal">Rs @Model.GrandTotal.ToString("N0")</p>
                <p class="text-[10px] text-gray-400" id="stickyCount">@Model.Subjects.Count(s => s.IsSelected) selected</p>
            </div>
            <button type="button" onclick="scrollToPayment()"
                    class="shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl text-sm font-bold hover:from-blue-700 hover:to-indigo-700 active:scale-[0.97] transition-all shadow-lg shadow-blue-600/30">
                <i class="fas fa-arrow-right"></i>
                Continue
            </button>
        </div>
    </div>
</div>

<form id="paymentForm" method="post" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="examScheduleId" id="hfExamScheduleId" value="@Model.ExamScheduleId" />
    <input type="hidden" name="paymentMethod" id="hfPaymentMethod" />
    <input type="hidden" name="amount" id="hfAmount" />
    <input type="hidden" name="selectedSubjectIds" id="hfSelectedSubjectIds" />
</form>

@section Scripts {
    <script>
        var flatExamFee = @Model.TotalExamFee;
        var isRegular = @Model.IsRegular.ToString().ToLower();

        function updateTotals() {
            var totalPractical = 0;
            var selectedIds = [];

            if (!isRegular) {
                document.querySelectorAll('.subject-checkbox:checked').forEach(function(cb) {
                    totalPractical += parseFloat(cb.getAttribute('data-practical-fee'));
                    selectedIds.push(cb.value);
                });
            } else {
                document.querySelectorAll('[data-is-selected="true"]').forEach(function(row) {
                    if (row.classList.contains('subject-card')) {
                        var cb = row.querySelector('.subject-checkbox');
                        if (cb && cb.checked) {
                            selectedIds.push(cb.value);
                            totalPractical += parseFloat(cb.getAttribute('data-practical-fee'));
                        } else if (!cb) {
                            selectedIds.push(row.getAttribute('data-subject-id'));
                            totalPractical += parseFloat(row.getAttribute('data-practical-fee'));
                        }
                    }
                });
                document.querySelectorAll('.elective-checkbox:checked').forEach(function(cb) {
                    selectedIds.push(cb.value);
                    totalPractical += parseFloat(cb.getAttribute('data-practical-fee'));
                });
            }

            var grandTotal = flatExamFee + totalPractical;
            var formatted = grandTotal.toLocaleString();
            var count = selectedIds.length;

            document.getElementById('totalExamFee').innerText = 'Rs ' + flatExamFee.toLocaleString();
            document.getElementById('totalPracticalFee').innerText = 'Rs ' + totalPractical.toLocaleString();
            document.getElementById('grandTotal').innerText = 'Rs ' + formatted;
            document.getElementById('breakupExamFee').innerText = 'Rs ' + flatExamFee.toLocaleString();
            document.getElementById('breakupPracticalFee').innerText = 'Rs ' + totalPractical.toLocaleString();
            document.getElementById('breakupGrandTotal').innerText = 'Rs ' + formatted;
            document.getElementById('selectedCount').innerText = count + ' subject' + (count !== 1 ? 's' : '') + ' selected';
            document.getElementById('stickyTotal').innerText = 'Rs ' + formatted;
            document.getElementById('stickyCount').innerText = count + ' selected';
            document.getElementById('hfSelectedSubjectIds').value = selectedIds.join(',');
            document.getElementById('hfAmount').value = grandTotal;

            document.querySelectorAll('#mobileBottomBar .inline-flex').forEach(function(btn) {
                btn.innerHTML = '<i class="fas fa-arrow-right"></i> Pay Rs ' + formatted;
            });
        }

        function toggleAllElec(source) {
            document.querySelectorAll('.elective-checkbox').forEach(function(cb) {
                cb.checked = source.checked;
            });
            updateTotals();
        }

        function scrollToPayment() {
            var paymentSection = document.querySelector('.bg-white.rounded-2xl.shadow-sm.border.border-gray-100.overflow-hidden');
            if (paymentSection) {
                paymentSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                setTimeout(function() {
                    paymentSection.querySelector('button')?.focus();
                }, 500);
            }
        }

        function processPayment(method) {
            updateTotals();
            var amount = document.getElementById('hfAmount').value;
            if (amount == 0 || amount === '0') {
                alert('Please select at least one subject to proceed with payment.');
                return;
            }
            if (confirm('Pay Rs ' + parseFloat(amount).toLocaleString() + ' via ' + method.charAt(0).toUpperCase() + method.slice(1) + '?')) {
                var form = document.getElementById('paymentForm');
                document.getElementById('hfPaymentMethod').value = method;
                if (method === 'esewa') {
                    form.action = '@Url.Action("ESewaPayment", "StudentDashboard", new { area = "Students" })';
                } else if (method === 'khalti') {
                    form.action = '@Url.Action("KhaltiPayment", "StudentDashboard", new { area = "Students" })';
                } else {
                    form.action = '@Url.Action("ProcessPayment", "StudentDashboard", new { area = "Students" })';
                }
                form.submit();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateTotals();

            document.querySelectorAll('.subject-card').forEach(function(card) {
                card.addEventListener('click', function(e) {
                    if (e.target.closest('input[type="checkbox"]')) return;
                    var cb = this.querySelector('.subject-checkbox');
                    if (cb && !cb.disabled) {
                        cb.checked = !cb.checked;
                        cb.dispatchEvent(new Event('change'));
                    }
                });
            });
        });
    </script>
}
