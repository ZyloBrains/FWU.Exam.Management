@model FWU.Exam.Management.Web.ViewModels.ExamPaymentViewModel

@{
    ViewData["Title"] = "Pay Exam Fee";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-credit-card text-blue-600"></i>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Pay Exam Fee</h1>
            <p class="text-sm text-gray-500 mt-0.5">@Model.ExamScheduleName</p>
        </div>
    </div>

    <!-- Status Banner -->
    <div class="@(Model.IsRegular ? "bg-green-50 border-green-200" : "bg-orange-50 border-orange-200") rounded-xl border p-4 flex items-center gap-3">
        @if (Model.IsRegular)
        {
            <i class="fas fa-check-circle text-green-600"></i>
            <span class="text-sm font-medium text-green-700">Regular Student — All subjects are auto-selected for this semester</span>
        }
        else
        {
            <i class="fas fa-exclamation-triangle text-orange-600"></i>
            <span class="text-sm font-medium text-orange-700">Non-Regular Student — Subjects you previously failed are pre-selected. You may adjust your selection.</span>
        }
    </div>

    <!-- Subjects & Fee Details -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200 flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold text-gray-800">Subject & Fee Details</h3>
                <p class="text-sm text-gray-500 mt-1">@Model.ProgramName - @Model.SemesterName</p>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium @(Model.IsRegular ? "bg-green-100 text-green-700" : "bg-orange-100 text-orange-700")">
                <i class="fas @(Model.IsRegular ? "fa-check-circle" : "fa-user-edit")"></i>
                @(Model.IsRegular ? "Regular" : "Non-Regular")
            </span>
        </div>

        @{
            var compulsorySubjects = Model.Subjects.Where(s => s.IsCompulsory).ToList();
            var electiveSubjects = Model.Subjects.Where(s => !s.IsCompulsory).ToList();
        }

        @if (compulsorySubjects.Any())
        {
            <div class="px-6 py-3 bg-blue-50 border-b border-gray-200">
                <h4 class="text-sm font-semibold text-blue-700 uppercase tracking-wider">Compulsory Subjects</h4>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            @if (!Model.IsRegular)
                            {
                                <th class="text-left px-4 py-3 font-semibold text-gray-600 w-10"></th>
                            }
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">SN</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Subject</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Code</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Theory</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Practical</th>
                            <th class="text-right px-4 py-3 font-semibold text-gray-600">Exam Fee</th>
                            <th class="text-right px-4 py-3 font-semibold text-gray-600">Practical Fee</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @for (int i = 0; i < compulsorySubjects.Count; i++)
                        {
                            var subj = compulsorySubjects[i];
                            <tr class="subject-row hover:bg-gray-50 transition-colors @(subj.IsSelected ? (subj.IsFailed ? "bg-red-50/30" : "bg-blue-50/30") : "")">
                                @if (!Model.IsRegular)
                                {
                                    <td class="px-4 py-3">
                                        <input type="checkbox" name="subjectCheckbox" value="@subj.SubjectOfferingId"
                                               data-exam-fee="@subj.ExamFee" data-practical-fee="@subj.PracticalFee"
                                               class="subject-checkbox rounded border-gray-300"
                                               onchange="updateTotals()" checked="@(subj.IsSelected ? "checked" : null)" />
                                    </td>
                                }
                                <td class="px-4 py-3 text-gray-800">@(i + 1)</td>
                                <td class="px-4 py-3 text-gray-800 font-medium">@subj.SubjectName</td>
                                <td class="px-4 py-3 text-gray-600">@subj.SubjectCode</td>
                                <td class="px-4 py-3 text-center">
                                    @if (subj.HasTheory) { <i class="fas fa-check text-green-500"></i> }
                                    else { <i class="fas fa-times text-gray-300"></i> }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (subj.HasPractical) { <i class="fas fa-check text-green-500"></i> }
                                    else { <i class="fas fa-times text-gray-300"></i> }
                                </td>
                                <td class="px-4 py-3 text-right text-gray-800">Rs @subj.ExamFee.ToString("N0")</td>
                                <td class="px-4 py-3 text-right text-gray-800">Rs @subj.PracticalFee.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-50 border-t border-gray-200">
                        <tr class="text-sm font-semibold text-gray-700">
                            <td colspan="@(Model.IsRegular ? 5 : 6)" class="px-4 py-3 text-right">Compulsory Subtotal:</td>
                            <td class="px-4 py-3 text-right" id="compExamFee">Rs @compulsorySubjects.Sum(s => s.ExamFee).ToString("N0")</td>
                            <td class="px-4 py-3 text-right" id="compPracticalFee">Rs @compulsorySubjects.Sum(s => s.PracticalFee).ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

        @if (electiveSubjects.Any())
        {
            <div class="px-6 py-3 bg-purple-50 border-b border-gray-200">
                <h4 class="text-sm font-semibold text-purple-700 uppercase tracking-wider">Elective Subjects</h4>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            @if (!Model.IsRegular)
                            {
                                <th class="text-left px-4 py-3 font-semibold text-gray-600 w-10">
                                    <input type="checkbox" id="selectAll" onchange="toggleAll(this)" class="rounded border-gray-300" />
                                </th>
                            }
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">SN</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Subject</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Code</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Theory</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Practical</th>
                            <th class="text-right px-4 py-3 font-semibold text-gray-600">Exam Fee</th>
                            <th class="text-right px-4 py-3 font-semibold text-gray-600">Practical Fee</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @for (int i = 0; i < electiveSubjects.Count; i++)
                        {
                            var subj = electiveSubjects[i];
                            <tr class="subject-row hover:bg-gray-50 transition-colors @(subj.IsSelected ? (subj.IsFailed ? "bg-red-50/30" : "bg-purple-50/30") : "")">
                                @if (!Model.IsRegular)
                                {
                                    <td class="px-4 py-3">
                                        <input type="checkbox" name="subjectCheckbox" value="@subj.SubjectOfferingId"
                                               data-exam-fee="@subj.ExamFee" data-practical-fee="@subj.PracticalFee"
                                               class="subject-checkbox rounded border-gray-300"
                                               onchange="updateTotals()" checked="@(subj.IsSelected ? "checked" : null)" />
                                    </td>
                                }
                                <td class="px-4 py-3 text-gray-800">@(i + 1)</td>
                                <td class="px-4 py-3 text-gray-800 font-medium">
                                    @subj.SubjectName
                                    @if (!Model.IsRegular && subj.IsFailed)
                                    {
                                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700">
                                            <i class="fas fa-exclamation-circle mr-1"></i>Previously Failed
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-600">@subj.SubjectCode</td>
                                <td class="px-4 py-3 text-center">
                                    @if (subj.HasTheory) { <i class="fas fa-check text-green-500"></i> }
                                    else { <i class="fas fa-times text-gray-300"></i> }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (subj.HasPractical) { <i class="fas fa-check text-green-500"></i> }
                                    else { <i class="fas fa-times text-gray-300"></i> }
                                </td>
                                <td class="px-4 py-3 text-right text-gray-800">Rs @subj.ExamFee.ToString("N0")</td>
                                <td class="px-4 py-3 text-right text-gray-800">Rs @subj.PracticalFee.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-50 border-t border-gray-200">
                        <tr class="text-sm font-semibold text-gray-700">
                            <td colspan="@(Model.IsRegular ? 5 : 6)" class="px-4 py-3 text-right">Elective Subtotal:</td>
                            <td class="px-4 py-3 text-right" id="elecExamFee">Rs @electiveSubjects.Sum(s => s.ExamFee).ToString("N0")</td>
                            <td class="px-4 py-3 text-right" id="elecPracticalFee">Rs @electiveSubjects.Sum(s => s.PracticalFee).ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

        <div class="border-t-2 border-gray-200 bg-gray-50">
            <table class="w-full text-sm">
                <tfoot>
                    <tr class="font-semibold text-gray-800">
                        <td colspan="@(Model.IsRegular ? 5 : 6)" class="px-4 py-3 text-right">Total:</td>
                        <td class="px-4 py-3 text-right" id="totalExamFee">Rs @Model.TotalExamFee.ToString("N0")</td>
                        <td class="px-4 py-3 text-right" id="totalPracticalFee">Rs @Model.TotalPracticalFee.ToString("N0")</td>
                    </tr>
                    <tr class="bg-blue-50 font-bold">
                        <td colspan="@(Model.IsRegular ? 6 : 7)" class="px-4 py-3 text-right text-gray-800">Grand Total:</td>
                        <td class="px-4 py-3 text-right text-blue-700 text-base" id="grandTotal">Rs @Model.GrandTotal.ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Fee Breakup -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <p class="text-xs text-gray-500 uppercase tracking-wider">Exam Fee</p>
            <p class="text-xl font-bold text-gray-800 mt-1" id="breakupExamFee">Rs @Model.TotalExamFee.ToString("N0")</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <p class="text-xs text-gray-500 uppercase tracking-wider">Practical Fee</p>
            <p class="text-xl font-bold text-gray-800 mt-1" id="breakupPracticalFee">Rs @Model.TotalPracticalFee.ToString("N0")</p>
        </div>
        <div class="bg-blue-600 rounded-xl shadow-sm p-5 text-white">
            <p class="text-xs text-blue-200 uppercase tracking-wider">Total Amount</p>
            <p class="text-xl font-bold mt-1" id="breakupGrandTotal">Rs @Model.GrandTotal.ToString("N0")</p>
        </div>
    </div>

    <!-- Payment Method -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-800">Payment Method</h3>
            <p class="text-sm text-gray-500 mt-1">Select a payment gateway to complete your transaction</p>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                @if (Model.HasESewa)
                {
                    <button type="button" onclick="processPayment('esewa')"
                            class="group flex flex-col items-center p-6 bg-green-50 border-2 border-green-200 rounded-xl hover:bg-green-100 hover:border-green-400 transition-all duration-200">
                        <div class="w-16 h-16 mb-3">
                            <img src="~/images/payments/esewa.svg" alt="eSewa" class="w-full h-full" />
                        </div>
                        <span class="text-sm font-semibold text-green-700">eSewa</span>
                        <span class="text-xs text-green-500 mt-1">Pay with eSewa</span>
                    </button>
                }

                @if (Model.HasKhalti)
                {
                    <button type="button" onclick="processPayment('khalti')"
                            class="group flex flex-col items-center p-6 bg-purple-50 border-2 border-purple-200 rounded-xl hover:bg-purple-100 hover:border-purple-400 transition-all duration-200">
                        <div class="w-16 h-16 mb-3">
                            <img src="~/images/payments/khalti.svg" alt="Khalti" class="w-full h-full" />
                        </div>
                        <span class="text-sm font-semibold text-purple-700">Khalti</span>
                        <span class="text-xs text-purple-500 mt-1">Pay with Khalti</span>
                    </button>
                }

                @if (Model.HasConnectIPS)
                {
                    <button type="button" onclick="processPayment('connectips')"
                            class="group flex flex-col items-center p-6 bg-blue-50 border-2 border-blue-200 rounded-xl hover:bg-blue-100 hover:border-blue-400 transition-all duration-200">
                        <div class="w-16 h-16 mb-3">
                            <img src="~/images/payments/connectips.svg" alt="Connect IPS" class="w-full h-full" />
                        </div>
                        <span class="text-sm font-semibold text-blue-700">Connect IPS</span>
                        <span class="text-xs text-blue-500 mt-1">Pay via Internet Banking</span>
                    </button>
                }

                @if (!Model.HasESewa && !Model.HasKhalti && !Model.HasConnectIPS)
                {
                    <div class="col-span-full text-center py-8 text-gray-400">
                        <i class="fas fa-credit-card text-3xl mb-2 block"></i>
                        <p>No payment gateways are currently configured</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<form id="paymentForm" method="post" style="display:none">
    <input type="hidden" name="examScheduleId" id="hfExamScheduleId" value="@Model.ExamScheduleId" />
    <input type="hidden" name="paymentMethod" id="hfPaymentMethod" />
    <input type="hidden" name="amount" id="hfAmount" />
    <input type="hidden" name="selectedSubjectIds" id="hfSelectedSubjectIds" />
</form>

@section Scripts {
    <script>
        function updateTotals() {
            @if (!Model.IsRegular)
            {
                <text>
                var totalExam = 0;
                var totalPractical = 0;
                var selectedIds = [];
                document.querySelectorAll('.subject-checkbox:checked').forEach(function(cb) {
                    totalExam += parseFloat(cb.getAttribute('data-exam-fee'));
                    totalPractical += parseFloat(cb.getAttribute('data-practical-fee'));
                    selectedIds.push(cb.value);
                });
                var grandTotal = totalExam + totalPractical;
                document.getElementById('totalExamFee').innerText = 'Rs ' + totalExam.toLocaleString();
                document.getElementById('totalPracticalFee').innerText = 'Rs ' + totalPractical.toLocaleString();
                document.getElementById('grandTotal').innerText = 'Rs ' + grandTotal.toLocaleString();
                document.getElementById('breakupExamFee').innerText = 'Rs ' + totalExam.toLocaleString();
                document.getElementById('breakupPracticalFee').innerText = 'Rs ' + totalPractical.toLocaleString();
                document.getElementById('breakupGrandTotal').innerText = 'Rs ' + grandTotal.toLocaleString();
                document.getElementById('hfSelectedSubjectIds').value = selectedIds.join(',');
                document.getElementById('hfAmount').value = grandTotal;
                </text>
            }
            else
            {
                <text>
                document.getElementById('hfAmount').value = @Model.GrandTotal;
                document.getElementById('hfSelectedSubjectIds').value = '';
                </text>
            }
        }

        function toggleAll(source) {
            document.querySelectorAll('.subject-checkbox').forEach(function(cb) {
                cb.checked = source.checked;
            });
            updateTotals();
        }

        function processPayment(method) {
            updateTotals();
            var amount = document.getElementById('hfAmount').value;
            if (amount == 0 || amount === '0') {
                alert('Please select at least one subject to proceed with payment.');
                return;
            }
            if (confirm('Pay Rs ' + parseFloat(amount).toLocaleString() + ' via ' + method.charAt(0).toUpperCase() + method.slice(1) + '?')) {
                var form = document.getElementById('paymentForm');
                document.getElementById('hfPaymentMethod').value = method;
                if (method === 'esewa') {
                    form.action = '@Url.Action("ESewaPayment", "StudentDashboard", new { area = "Students" })';
                } else if (method === 'khalti') {
                    form.action = '@Url.Action("KhaltiPayment", "StudentDashboard", new { area = "Students" })';
                } else {
                    form.action = '@Url.Action("ProcessPayment", "StudentDashboard", new { area = "Students" })';
                }
                form.submit();
            }
        }

        // Init on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateTotals();
        });
    </script>
}
