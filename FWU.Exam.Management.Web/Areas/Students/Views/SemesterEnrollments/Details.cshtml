@model FWU.Exam.Management.Domain.Entities.Semesters.SemesterEnrollment

@{
    ViewData["Title"] = "Semester Enrollment Details";
}

<div class="space-y-6">
    <div class="md:flex md:items-center md:justify-between mb-8 pb-5 border-b border-gray-200">
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl font-bold leading-tight text-gray-900 tracking-tight">Semester Enrollment Details</h1>
        </div>
        <div class="mt-4 flex md:ml-4 md:mt-0 gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 transition-all">Edit</a>
            <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-all">Back to List</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="mb-6 rounded-lg bg-emerald-50 p-4 border border-emerald-200 flex items-start shadow-sm">
            <svg class="h-5 w-5 text-emerald-400 mr-3 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-sm font-medium text-emerald-800">@successMessage</div>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-6 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Admission</h3>
                    <p class="text-sm text-gray-900 font-medium">@(Model.StudentAdmission?.CollegeRollNumber ?? "N/A")</p>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Semester</h3>
                    <p class="text-sm text-gray-900 font-medium">@(Model.Semester?.Name ?? "N/A")</p>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Enrollment Status</h3>
                    <span class="inline-flex px-2 py-1 text-xs font-medium rounded-full @(Model.EnrollmentStatus switch {
                        FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Active => "bg-green-100 text-green-700",
                        FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Inactive => "bg-gray-100 text-gray-700",
                        FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Dropped => "bg-red-100 text-red-700",
                        _ => "bg-yellow-100 text-yellow-700"
                    })">@Model.EnrollmentStatus</span>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Enrollment Type</h3>
                    <p class="text-sm text-gray-900 font-medium">@Model.EnrollmentType</p>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Payment Status</h3>
                    <span class="inline-flex px-2 py-1 text-xs font-medium rounded-full @(Model.PaymentStatus switch {
                        FWU.Exam.Management.Domain.Enums.PaymentStatus.Paid => "bg-green-100 text-green-700",
                        FWU.Exam.Management.Domain.Enums.PaymentStatus.Pending => "bg-yellow-100 text-yellow-700",
                        _ => "bg-gray-100 text-gray-700"
                    })">@Model.PaymentStatus</span>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Result Status</h3>
                    <span class="inline-flex px-2 py-1 text-xs font-medium rounded-full @(Model.ResultStatus switch {
                        FWU.Exam.Management.Domain.Enums.ResultStatus.Passed => "bg-green-100 text-green-700",
                        FWU.Exam.Management.Domain.Enums.ResultStatus.Failed => "bg-red-100 text-red-700",
                        FWU.Exam.Management.Domain.Enums.ResultStatus.Incomplete => "bg-yellow-100 text-yellow-700",
                        FWU.Exam.Management.Domain.Enums.ResultStatus.Absent => "bg-gray-100 text-gray-700",
                        FWU.Exam.Management.Domain.Enums.ResultStatus.Withdrawn => "bg-orange-100 text-orange-700",
                        _ => "bg-gray-100 text-gray-700"
                    })">@Model.ResultStatus</span>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Fee</h3>
                    <p class="text-sm text-gray-900 font-medium">@Model.TotalFee.ToString("N0")</p>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Paid Amount</h3>
                    <p class="text-sm text-gray-900 font-medium">@Model.PaidAmount.ToString("N0")</p>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Credits</h3>
                    <p class="text-sm text-gray-900 font-medium">@Model.TotalCredits</p>
                </div>
            </div>
        </div>
    </div>
</div>