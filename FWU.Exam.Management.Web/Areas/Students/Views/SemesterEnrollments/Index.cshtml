@model IEnumerable<FWU.Exam.Management.Domain.Entities.Semesters.SemesterEnrollment>

@{
    ViewData["Title"] = "Semester Enrollments";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var admissionId = ViewBag.AdmissionId as int?;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-book-open text-teal-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Semester Enrollments</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage semester enrollments, track status and results.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> New Enrollment
            </a>
            <a asp-action="ExportToCsv" asp-route-search="@currentSearch" asp-route-admissionId="@admissionId"
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors shadow-sm">
                <i class="fas fa-file-csv text-xs text-gray-400"></i> CSV
            </a>
            <a asp-action="ExportToExcel" asp-route-search="@currentSearch" asp-route-admissionId="@admissionId"
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors shadow-sm">
                <i class="fas fa-file-excel text-xs text-green-500"></i> Excel
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="rounded-lg bg-emerald-50 p-4 border border-emerald-200 flex items-start gap-3 shadow-sm">
            <i class="fas fa-check-circle text-emerald-400 mt-0.5"></i>
            <div class="text-sm font-medium text-emerald-800">@successMessage</div>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="rounded-lg bg-red-50 p-4 border border-red-200 flex items-start gap-3 shadow-sm">
            <i class="fas fa-exclamation-circle text-red-400 mt-0.5"></i>
            <div class="text-sm font-medium text-red-800 whitespace-pre-line">@errorMessage</div>
        </div>
    }

    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Admission</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Semester</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Type</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Payment</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Fee</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Credits</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Result</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{
                    int serial = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize;
                }
                @foreach (var item in Model)
                {
                    serial++;
                    <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                        <td class="px-4 py-3 text-gray-500 text-sm">@serial</td>
                        <td class="px-4 py-3 font-medium text-gray-800">@item.StudentAdmission?.CollegeRollNumber</td>
                        <td class="px-4 py-3 text-gray-600">@item.Semester?.Name</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.EnrollmentStatus switch {
                                FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Active => "bg-green-100 text-green-700",
                                FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Inactive => "bg-gray-100 text-gray-700",
                                FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Dropped => "bg-red-100 text-red-700",
                                _ => "bg-yellow-100 text-yellow-700"
                            })">@item.EnrollmentStatus</span>
                        </td>
                        <td class="px-4 py-3 text-gray-600">@item.EnrollmentType</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.PaymentStatus switch {
                                FWU.Exam.Management.Domain.Enums.PaymentStatus.Paid => "bg-green-100 text-green-700",
                                FWU.Exam.Management.Domain.Enums.PaymentStatus.Pending => "bg-yellow-100 text-yellow-700",
                                _ => "bg-gray-100 text-gray-700"
                            })">@item.PaymentStatus</span>
                        </td>
                        <td class="px-4 py-3 text-gray-600">@item.TotalFee.ToString("N0")</td>
                        <td class="px-4 py-3 text-gray-600">@item.TotalCredits</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.ResultStatus switch {
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Passed => "bg-green-100 text-green-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Failed => "bg-red-100 text-red-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Incomplete => "bg-yellow-100 text-yellow-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Absent => "bg-gray-100 text-gray-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Withdrawn => "bg-orange-100 text-orange-700",
                                _ => "bg-gray-100 text-gray-700"
                            })">@item.ResultStatus</span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a asp-action="Details" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit">
                                    <i class="fas fa-edit text-xs"></i>
                                </a>
                                <a href="javascript:void(0)" onclick="deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete">
                                    <i class="fas fa-trash text-xs"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No semester enrollments found.</p>
            </div>
        }
    </div>

    <div class="lg:hidden space-y-3">
        @if (Model.Any())
        {
            int serialM = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize;
            @foreach (var item in Model)
            {
                serialM++;
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-book-open text-teal-600 text-sm"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] font-bold text-teal-600 bg-teal-100 rounded px-1.5 py-0.5">#@serialM</span>
                                    <h3 class="font-semibold text-gray-800 text-sm">@(item.StudentAdmission?.CollegeRollNumber ?? "-")</h3>
                                </div>
                                <p class="text-xs text-gray-500">@(item.Semester?.Name ?? "-")</p>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-1">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.EnrollmentStatus switch {
                                FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Active => "bg-green-100 text-green-700",
                                FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Inactive => "bg-gray-100 text-gray-700",
                                FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Dropped => "bg-red-100 text-red-700",
                                _ => "bg-yellow-100 text-yellow-700"
                            })">@item.EnrollmentStatus</span>
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.PaymentStatus switch {
                                FWU.Exam.Management.Domain.Enums.PaymentStatus.Paid => "bg-green-100 text-green-700",
                                FWU.Exam.Management.Domain.Enums.PaymentStatus.Pending => "bg-yellow-100 text-yellow-700",
                                _ => "bg-gray-100 text-gray-700"
                            })">@item.PaymentStatus</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                        <div class="text-gray-500">Type</div>
                        <div class="text-gray-800">@(item.EnrollmentType)</div>
                        <div class="text-gray-500">Fee</div>
                        <div class="text-gray-800">@item.TotalFee.ToString("N0")</div>
                        <div class="text-gray-500">Credits</div>
                        <div class="text-gray-800">@item.TotalCredits</div>
                        <div class="text-gray-500">Result</div>
                        <div class="text-gray-800">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(item.ResultStatus switch {
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Passed => "bg-green-100 text-green-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Failed => "bg-red-100 text-red-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Incomplete => "bg-yellow-100 text-yellow-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Absent => "bg-gray-100 text-gray-700",
                                FWU.Exam.Management.Domain.Enums.ResultStatus.Withdrawn => "bg-orange-100 text-orange-700",
                                _ => "bg-gray-100 text-gray-700"
                            })">@item.ResultStatus</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 pt-3 mt-2 border-t border-gray-100">
                        <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                            <i class="fas fa-eye mr-1"></i> Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            <i class="fas fa-edit mr-1"></i> Edit
                        </a>
                        <a href="javascript:void(0)" onclick="deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            <i class="fas fa-trash mr-1"></i> Delete
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No semester enrollments found.</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
            <div class="text-sm text-gray-500 font-medium">
                Showing <span class="font-semibold text-gray-900">@(((currentPage - 1) * pageSize) + 1)</span>
                to <span class="font-semibold text-gray-900">@(Math.Min(currentPage * pageSize, totalCount))</span>
                of <span class="font-semibold text-gray-900">@totalCount</span> entries
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-2">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-admissionId="@admissionId"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        <i class="fas fa-chevron-left text-xs"></i> Previous
                    </a>
                }
                <span class="text-sm font-semibold text-gray-700 min-w-[4rem] text-center">@currentPage / @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-admissionId="@admissionId"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        Next <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "SemesterEnrollments")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}
