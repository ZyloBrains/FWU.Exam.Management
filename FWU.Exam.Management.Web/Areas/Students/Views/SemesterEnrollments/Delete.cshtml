@model FWU.Exam.Management.Domain.Entities.Semesters.SemesterEnrollment

@{
    ViewData["Title"] = "Delete Semester Enrollment";
}

<div class="max-w-xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="md:flex md:items-center md:justify-between mb-8 pb-5 border-b border-gray-200">
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl font-bold leading-tight text-gray-900 tracking-tight">Delete Enrollment</h1>
        </div>
    </div>

    <div class="bg-red-50 border border-red-200 rounded-xl p-6 mb-6">
        <div class="flex items-start gap-3">
            <svg class="h-6 w-6 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
            <div>
                <p class="text-sm font-medium text-red-800">Are you sure you want to delete this enrollment? This action cannot be undone.</p>
                <p class="mt-1 text-sm text-red-600">Admission: <strong>@(Model.StudentAdmission?.CollegeRollNumber)</strong> — Semester: <strong>@(Model.Semester?.Name)</strong></p>
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="flex items-center gap-3">
            <button type="submit" class="inline-flex items-center px-6 py-2.5 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition shadow-sm">Delete</button>
            <a asp-action="Index" class="inline-flex items-center px-4 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50 transition">Cancel</a>
        </div>
    </form>
</div>