@using FWU.Exam.Management.Application.DTOs
@model IEnumerable<SemesterEnrollmentCandidateDto>

@{
    ViewData["Title"] = "Bulk Enroll Students";
    var currentSearch = ViewBag.Search as string ?? "";
    var currentAcademicYearId = ViewBag.AcademicYearId as int?;
    var currentCollegeId = ViewBag.CollegeId as int?;
    var currentProgramId = ViewBag.ProgramId as int?;
    var currentSemesterId = ViewBag.SemesterId as int?;
    var hasSemester = currentSemesterId.HasValue;
    var candidateCount = Model.Count();
    var alreadyEnrolledCount = Model.Count(c => c.IsEnrolled);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 25);
    var startRecord = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var endRecord = Math.Min(currentPage * pageSize, totalCount);
    var windowStart = Math.Max(1, currentPage - 2);
    var windowEnd = Math.Min(totalPages, currentPage + 2);
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-users text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Bulk Enroll Students</h1>
                <p class="text-sm text-gray-500 mt-0.5">Find students and enroll them all in a semester at once.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors shadow-sm">
                <i class="fas fa-arrow-left text-xs"></i> Back to List
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="BatchCreate" class="flex flex-col md:flex-row md:items-center gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by student name, registration no, roll number..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <select name="academicYearId" class="border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white min-w-[10rem]" onchange="this.form.submit()">
                <option value="">All Years</option>
                @if (ViewData["AcademicYearFilter"] is SelectList academicYearList)
                {
                    foreach (var item in academicYearList.Items)
                    {
                        var value = ((dynamic)item).Id.ToString();
                        <option value="@value" selected="@(value == currentAcademicYearId?.ToString())">@(((dynamic)item).AcademicYearCode)</option>
                    }
                }
            </select>
            <select name="collegeId" class="border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white min-w-[10rem]" onchange="this.form.submit()">
                <option value="">All Colleges</option>
                @if (ViewData["CollegeFilter"] is SelectList collegeList)
                {
                    foreach (var item in collegeList.Items)
                    {
                        var value = ((dynamic)item).Id.ToString();
                        <option value="@value" selected="@(value == currentCollegeId?.ToString())">@(((dynamic)item).Name)</option>
                    }
                }
            </select>
            <select name="programId" class="border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white min-w-[10rem]" onchange="this.form.submit()">
                <option value="">All Programs</option>
                @if (ViewData["ProgramFilter"] is SelectList programList)
                {
                    foreach (var item in programList.Items)
                    {
                        var value = ((dynamic)item).Id.ToString();
                        <option value="@value" selected="@(value == currentProgramId?.ToString())">@(((dynamic)item).ProgramName)</option>
                    }
                }
            </select>
            <select name="semesterId" class="border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white min-w-[10rem]" onchange="this.form.submit()">
                <option value="">Select Semester</option>
                @if (ViewData["SemesterFilter"] is SelectList semesterList)
                {
                    foreach (var item in semesterList.Items)
                    {
                        var value = ((dynamic)item).Id.ToString();
                        <option value="@value" selected="@(value == currentSemesterId?.ToString())">@(((dynamic)item).Name)</option>
                    }
                }
            </select>
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors">Search</button>
                <a asp-action="BatchCreate"
                   class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                    <i class="fas fa-times text-xs"></i> Clear
                </a>
            </div>
        </form>
    </div>

    @if (!hasSemester)
    {
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
            <i class="fas fa-info-circle mr-1"></i>
            Pick students below, choose the <strong>target semester</strong> in the bar, then click <strong>Enroll Selected</strong> for the checked students or <strong>Enroll All</strong> for every matching student.
        </div>
    }
    else if (totalCount > 0)
    {
        <div class="flex items-center justify-between gap-3 text-sm">
            <span class="text-gray-600">
                <strong class="text-gray-900">@totalCount</strong> student(s) found
                @if (alreadyEnrolledCount > 0)
                {
                    <text>, <span class="text-gray-900 font-semibold">@alreadyEnrolledCount</span> already enrolled on this page</text>
                }
            </span>
            <span class="text-gray-500">Showing @startRecord–@endRecord</span>
        </div>
    }

    <form method="post" asp-action="BatchCreate" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="search" value="@currentSearch" />
        <input type="hidden" name="academicYearId" value="@currentAcademicYearId" />
        <input type="hidden" name="collegeId" value="@currentCollegeId" />
        <input type="hidden" name="programId" value="@currentProgramId" />

        @if (candidateCount > 0)
        {
            <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 w-10">
                                <input type="checkbox" id="selectAll" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" title="Select all eligible" />
                            </th>
                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Student</th>
                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Reg No</th>
                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Roll No</th>
                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Program</th>
                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">College</th>
                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Year</th>
                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors @(item.IsEnrolled ? "bg-green-50/40" : "")">
                                <td class="px-4 py-3">
                                    <input type="checkbox" name="admissionIds" value="@item.AdmissionId" @(item.IsEnrolled ? "disabled" : "")
                                           class="row-check h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                                </td>
                                <td class="px-4 py-3 font-medium text-gray-800">@(item.StudentName ?? "-")</td>
                                <td class="px-4 py-3 text-gray-600">@(item.RegistrationNumber ?? "-")</td>
                                <td class="px-4 py-3 text-gray-600">@(item.CollegeRollNumber ?? "-")</td>
                                <td class="px-4 py-3 text-gray-600">@(item.ProgramName ?? "-")</td>
                                <td class="px-4 py-3 text-gray-600">@(item.CollegeName ?? "-")</td>
                                <td class="px-4 py-3 text-gray-600">@(item.AcademicYearName ?? "-")</td>
                                <td class="px-4 py-3">
                                    @if (item.IsEnrolled)
                                    {
                                        <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-700">Already enrolled</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600">Not enrolled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="lg:hidden space-y-3">
                @foreach (var item in Model)
                {
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 @(item.IsEnrolled ? "border-green-200" : "")">
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" name="admissionIds" value="@item.AdmissionId" @(item.IsEnrolled ? "disabled" : "")
                                       class="row-check h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                                <div>
                                    <h3 class="font-semibold text-gray-800 text-sm">@(item.StudentName ?? "-")</h3>
                                    <p class="text-xs text-gray-500">@(item.CollegeRollNumber ?? "-")</p>
                                </div>
                            </div>
                            @if (item.IsEnrolled)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-700">Already enrolled</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600">Not enrolled</span>
                            }
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                            <div class="text-gray-500">Reg No</div>
                            <div class="text-gray-800">@(item.RegistrationNumber ?? "-")</div>
                            <div class="text-gray-500">Program</div>
                            <div class="text-gray-800">@(item.ProgramName ?? "-")</div>
                            <div class="text-gray-500">College</div>
                            <div class="text-gray-800">@(item.CollegeName ?? "-")</div>
                            <div class="text-gray-500">Year</div>
                            <div class="text-gray-800">@(item.AcademicYearName ?? "-")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
                <div class="text-sm text-gray-600">
                    <strong id="selectedCount" class="text-gray-900">0</strong> student(s) selected
                    @if (alreadyEnrolledCount > 0)
                    {
                        <text> · <span class="text-gray-900 font-semibold">@alreadyEnrolledCount</span> already enrolled (excluded)</text>
                    }
                </div>
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                        <label for="enrollSemesterId" class="text-sm font-medium text-gray-700 shrink-0">Enroll into semester</label>
                        <select id="enrollSemesterId" name="semesterId"
                                class="border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white min-w-[12rem] focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <option value="">Select semester...</option>
                            @if (ViewBag.EnrollSemesterList is SelectList enrollSemesterList)
                            {
                                foreach (var item in enrollSemesterList.Items)
                                {
                                    var value = ((dynamic)item).Id.ToString();
                                    <option value="@value" selected="@(value == currentSemesterId?.ToString())">@(((dynamic)item).Name)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                        <button type="submit" name="enrollAction" value="selected"
                                onclick="return confirm('Enroll the selected students into the selected semester?')"
                                class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                            <i class="fas fa-user-plus text-xs"></i> Enroll Selected
                        </button>
                        <button type="submit" name="enrollAction" value="all"
                                onclick="return confirm('Enroll ALL matching students into the selected semester?')"
                                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-white text-indigo-700 text-sm font-medium rounded-lg border border-indigo-300 hover:bg-indigo-50 transition-colors shadow-sm">
                            <i class="fas fa-users text-xs"></i> Enroll All
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-users-slash text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No students found</h3>
                <p class="text-sm text-gray-500">Try adjusting the filters to find students to enroll.</p>
            </div>
        }
    </form>

    @if (totalPages > 1)
    {
        <nav class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <p class="text-sm text-gray-600">
                Page <strong class="text-gray-900">@currentPage</strong> of <strong class="text-gray-900">@totalPages</strong>
            </p>
            <div class="flex items-center gap-1">
                @if (currentPage > 1)
                {
                    <a asp-action="BatchCreate" asp-route-page="@(currentPage - 1)"
                       asp-route-search="@currentSearch" asp-route-academicYearId="@currentAcademicYearId"
                       asp-route-collegeId="@currentCollegeId" asp-route-programId="@currentProgramId"
                       asp-route-semesterId="@currentSemesterId"
                       class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors">Previous</a>
                }
                @if (windowStart > 1)
                {
                    <a asp-action="BatchCreate" asp-route-page="1"
                       asp-route-search="@currentSearch" asp-route-academicYearId="@currentAcademicYearId"
                       asp-route-collegeId="@currentCollegeId" asp-route-programId="@currentProgramId"
                       asp-route-semesterId="@currentSemesterId"
                       class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors">1</a>
                    @if (windowStart > 2)
                    {
                        <span class="px-1.5 text-gray-400">…</span>
                    }
                }
                @for (var i = windowStart; i <= windowEnd; i++)
                {
                    <a asp-action="BatchCreate" asp-route-page="@i"
                       asp-route-search="@currentSearch" asp-route-academicYearId="@currentAcademicYearId"
                       asp-route-collegeId="@currentCollegeId" asp-route-programId="@currentProgramId"
                       asp-route-semesterId="@currentSemesterId"
                       class="px-3 py-1.5 text-sm rounded-lg @(i == currentPage ? "bg-indigo-600 text-white" : "border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors")">@i</a>
                }
                @if (windowEnd < totalPages)
                {
                    @if (windowEnd < totalPages - 1)
                    {
                        <span class="px-1.5 text-gray-400">…</span>
                    }
                    <a asp-action="BatchCreate" asp-route-page="@totalPages"
                       asp-route-search="@currentSearch" asp-route-academicYearId="@currentAcademicYearId"
                       asp-route-collegeId="@currentCollegeId" asp-route-programId="@currentProgramId"
                       asp-route-semesterId="@currentSemesterId"
                       class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors">@totalPages</a>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="BatchCreate" asp-route-page="@(currentPage + 1)"
                       asp-route-search="@currentSearch" asp-route-academicYearId="@currentAcademicYearId"
                       asp-route-collegeId="@currentCollegeId" asp-route-programId="@currentProgramId"
                       asp-route-semesterId="@currentSemesterId"
                       class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors">Next</a>
                }
            </div>
        </nav>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            function updateSelectionCount() {
                var n = $('input[name="admissionIds"]:checked:not(:disabled)').length;
                $('#selectedCount').text(n);
            }

            $('#selectAll').change(function () {
                $('input[name="admissionIds"]:not(:disabled)').prop('checked', this.checked);
                updateSelectionCount();
            });

            $('input[name="admissionIds"]').change(updateSelectionCount);
            updateSelectionCount();
        });
    </script>
}
