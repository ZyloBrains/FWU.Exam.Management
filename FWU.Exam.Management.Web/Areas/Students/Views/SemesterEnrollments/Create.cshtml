@model FWU.Exam.Management.Domain.Entities.Semesters.SemesterEnrollment

@{
    ViewData["Title"] = "Create Semester Enrollment";
}

<div class="space-y-6">
    <div class="md:flex md:items-center md:justify-between mb-8 pb-5 border-b border-gray-200">
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl font-bold leading-tight text-gray-900 tracking-tight">Create Semester Enrollment</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-6">
            <form asp-action="Create" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <div>
                    <label asp-for="StudentAdmissionId" class="block text-sm font-medium text-gray-700 mb-1">Student Admission *</label>
                    <select asp-for="StudentAdmissionId" asp-items="ViewBag.StudentAdmissionId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                        <option value="">Select Admission</option>
                    </select>
                    <span asp-validation-for="StudentAdmissionId" class="text-red-600 text-xs"></span>
                </div>

                <div>
                    <label asp-for="SemesterId" class="block text-sm font-medium text-gray-700 mb-1">Semester *</label>
                    <select asp-for="SemesterId" asp-items="ViewBag.SemesterId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                        <option value="">Select Semester</option>
                    </select>
                    <span asp-validation-for="SemesterId" class="text-red-600 text-xs"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="EnrollmentType" class="block text-sm font-medium text-gray-700 mb-1">Enrollment Type *</label>
                        <select asp-for="EnrollmentType" asp-items="ViewBag.EnrollmentTypeList" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500"></select>
                        <span asp-validation-for="EnrollmentType" class="text-red-600 text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="TotalFee" class="block text-sm font-medium text-gray-700 mb-1">Total Fee</label>
                        <input asp-for="TotalFee" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                    </div>
                    <div>
                        <label asp-for="TotalCredits" class="block text-sm font-medium text-gray-700 mb-1">Total Credits</label>
                        <input asp-for="TotalCredits" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                    </div>
                    <div>
                        <label asp-for="PaidAmount" class="block text-sm font-medium text-gray-700 mb-1">Paid Amount</label>
                        <input asp-for="PaidAmount" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-4">
                    <button type="submit" class="inline-flex items-center px-6 py-2.5 bg-teal-600 text-white rounded-lg text-sm font-medium hover:bg-teal-700 transition shadow-sm">
                        Create Enrollment
                    </button>
                    <a asp-action="Index" class="inline-flex items-center px-4 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50 transition">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #14b8a6;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(20,184,166,0.2);
        }
    </style>

    <script>
        $(document).ready(function () {
            $('.select2:not(#StudentAdmissionId):not(#SemesterId)').select2();
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $("#StudentAdmissionId").change(function () {
                var admissionId = $(this).val();
                if (admissionId) {
                    $.get(tenantUrl("/Students/SemesterEnrollments/GetSemestersByAdmission"),
                        { admissionId: admissionId },
                        function (data) {
                            let semesterDropdown = $("#SemesterId");
                            semesterDropdown.empty();
                            semesterDropdown.append('<option value="">Select Semester</option>');
                            $.each(data, function (index, item) {
                                semesterDropdown.append('<option value="' + item.id + '">' + item.name + '</option>');
                            });
                        });
                } else {
                    $("#SemesterId").empty().append('<option value="">Select Semester</option>');
                }
            });
        });
    </script>
}