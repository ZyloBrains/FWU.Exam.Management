@model StudentRegistration
@{
    ViewData["Title"] = "Transfer Student";

    var currentLevel = Model.Level?.LevelName ?? "—";
    var currentCollege = Model.College?.Name ?? "—";
    var currentFaculty = Model.Faculty?.Name ?? "—";
    var currentProgram = Model.Program?.ProgramName ?? "—";
    var currentAcademicYear = Model.AcademicYear?.AcademicYearName ?? "—";

    var enrollments = ViewBag.Enrollments as List<FWU.Exam.Management.Domain.Entities.Semesters.SemesterEnrollment> ?? new();
    var affectedExamCount = (int)(ViewBag.AffectedExamCount ?? 0);

    // The tenant the student is on today. The target tenant is derived from the selected
    // faculty in the browser, because a faculty is the only thing that carries a tenant.
    var currentTenantName = ViewBag.CurrentTenantName as string ?? "Central (default)";
    var historyEnrollmentCount = enrollments.Count(e =>
        e.EnrollmentStatus != FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Active);
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center shrink-0 hover:bg-gray-200 transition-colors">
                <i class="fas fa-arrow-left text-gray-600"></i>
            </a>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Transfer Student</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span class="font-medium text-gray-700">@(Model.FirstName) @(Model.LastName)</span>
                    &mdash; Reg No: <span class="font-mono text-indigo-600">@(Model.RegistrationNumber ?? "—")</span>
                </p>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <!-- Side by Side Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- LEFT: Current Details -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
                        <i class="fas fa-id-card text-gray-500 text-sm"></i>
                    </div>
                    <h2 class="text-base font-bold text-gray-700">Current Enrollment</h2>
                </div>
            </div>
            <div class="px-6 py-5 space-y-4">
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <span class="text-sm text-gray-500">Registration No</span>
                    <span class="text-sm font-semibold text-gray-800 font-mono">@(Model.RegistrationNumber ?? "—")</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <span class="text-sm text-gray-500">Student Name</span>
                    <span class="text-sm font-semibold text-gray-800">@(Model.FirstName) @(Model.MiddleName) @(Model.LastName)</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <span class="text-sm text-gray-500">Level</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">@currentLevel</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <span class="text-sm text-gray-500">College</span>
                    <span class="text-sm font-medium text-gray-800 text-right max-w-[60%]">@currentCollege</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <span class="text-sm text-gray-500">Faculty</span>
                    <span class="text-sm font-medium text-gray-800 text-right max-w-[60%]">@currentFaculty</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <span class="text-sm text-gray-500">Program</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700">@currentProgram</span>
                </div>
                <div class="flex items-center justify-between py-2">
                    <span class="text-sm text-gray-500">Academic Year</span>
                    <span class="text-sm font-medium text-gray-800">@currentAcademicYear</span>
                </div>
            </div>
        </div>

        <!-- RIGHT: New Details + Form -->
        <div class="bg-white rounded-xl shadow-sm border border-indigo-200 overflow-hidden">
            <div class="bg-gradient-to-r from-indigo-500 to-purple-600 px-6 py-4">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
                        <i class="fas fa-exchange-alt text-white text-sm"></i>
                    </div>
                    <h2 class="text-base font-bold text-white">New Enrollment</h2>
                </div>
            </div>
            <div class="px-6 py-5">
                <form asp-action="Transfer" asp-route-id="@Model.Id" method="post" id="transferForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <!-- Level -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Level</label>
                            <select name="levelId" id="LevelId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" required>
                                <option value="">Select Level</option>
                                @if (ViewBag.Levels is SelectList levelList)
                                {
                                    foreach (var item in levelList)
                                    {
                                        if (item.Value == Model.LevelId.ToString())
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- Faculty -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                                Faculty <span class="text-red-600">*</span>
                            </label>
                            <select name="facultyId" id="FacultyId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" required>
                                <option value="">Select Faculty</option>
                            </select>
                        </div>

                        <!-- College -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">College</label>
                            <select name="collegeId" id="CollegeId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" required>
                                <option value="">Select College</option>
                            </select>
                        </div>

                        <!-- Program -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Program</label>
                            <select name="programId" id="ProgramId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" required>
                                <option value="">Select Program</option>
                            </select>
                        </div>

                        <!-- Target Semester -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                                Target Semester <span class="text-red-600">*</span>
                            </label>
                            <select name="semesterId" id="SemesterId" required
                                    class="select2 w-full px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                                <option value="">Select target semester</option>
                            </select>
                            <p class="text-xs text-gray-500 mt-1">
                                The semester the student is enrolled into after the transfer. Prior enrollments are
                                closed and kept as history; this is a required choice and is never inferred.
                            </p>
                        </div>

                        <!-- Academic Year -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Academic Year</label>
                            <select name="academicYearId" id="AcademicYearId" class="select2 w-full px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" required>
                                <option value="">Select Academic Year</option>
                                @if (ViewBag.AcademicYears is SelectList ayList)
                                {
                                    foreach (var item in ayList)
                                    {
                                        if (item.Value == Model.AcademicYearId.ToString())
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Resolved tenant (read-only: the faculty decides it) -->
                    <div class="mt-5">
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Tenant</label>
                        <input type="text" id="ResolvedTenant" readonly disabled
                               class="w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 text-sm text-gray-600 cursor-not-allowed"
                               value="Select a faculty to resolve the tenant" />
                        <p class="text-xs text-gray-500 mt-1">
                            A program has no tenant of its own; it belongs to the tenant of its faculty. A faculty with no
                            tenant of its own falls back to the central tenant. This value is derived, not editable.
                        </p>
                    </div>

                    <!-- Transfer reason (mandatory) -->
                    <div class="mt-5">
                        <label for="TransferReason" class="block text-sm font-medium text-gray-700 mb-1">
                            Reason for transfer <span class="text-red-500">*</span>
                        </label>
                        <textarea name="transferReason" id="TransferReason" rows="3" required maxlength="500"
                                  class="w-full px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                  placeholder="e.g. Student cleared the semester but the program was closed, so they were moved to the equivalent running program.">@(ViewBag.TransferReason as string)</textarea>
                        <p class="mt-1 text-xs text-gray-500">
                            Required. Stored with the closed semester enrollments as the record of why this transfer happened.
                        </p>
                    </div>

                    <!-- Confirmation -->
                    <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-lg">
                        <div class="flex items-start gap-3">
                            <div class="w-5 h-5 mt-0.5 shrink-0">
                                <input type="checkbox" id="confirmTransfer" required
                                       class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" />
                            </div>
                            <div>
                                <label for="confirmTransfer" class="text-sm font-medium text-amber-800 cursor-pointer">
                                    I confirm this transfer
                                </label>
                                <p id="confirmText" class="text-xs text-amber-600 mt-1">
                                    This will update the student's program, college, and faculty. Prior semester enrollments are closed and kept as history (credits, fees and results are preserved), and the student is enrolled into the target semester you select.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="mt-6 flex items-center justify-between">
                        <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                            <i class="fas fa-times text-xs"></i> Cancel
                        </a>
                        <button type="submit" id="btnTransfer" disabled
                                class="inline-flex items-center gap-2 px-6 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-exchange-alt text-xs"></i> Execute Transfer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Transfer Impact Diagram -->
    <div id="diagramSection" class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-exchange-alt text-indigo-600 text-sm"></i>
                </div>
                <h2 class="text-base font-bold text-gray-700">Transfer Impact</h2>
            </div>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-1 lg:grid-cols-[1fr,auto,1fr] gap-6 items-start">
                <!-- BEFORE -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center">
                            <i class="fas fa-id-card text-gray-500 text-xs"></i>
                        </div>
                        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wide">Current</h3>
                    </div>
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100">
                            <span class="text-sm text-gray-500">Level</span>
                            <span class="text-sm font-semibold text-gray-800" id="dCurrentLevel">@currentLevel</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100">
                            <span class="text-sm text-gray-500">College</span>
                            <span class="text-sm font-semibold text-gray-800 text-right max-w-[60%]" id="dCurrentCollege">@currentCollege</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100">
                            <span class="text-sm text-gray-500">Faculty</span>
                            <span class="text-sm font-semibold text-gray-800 text-right max-w-[60%]" id="dCurrentFaculty">@currentFaculty</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100">
                            <span class="text-sm text-gray-500">Program</span>
                            <span class="text-sm font-semibold text-indigo-700" id="dCurrentProgram">@currentProgram</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100">
                            <span class="text-sm text-gray-500">Academic Year</span>
                            <span class="text-sm font-semibold text-gray-800" id="dCurrentYear">@currentAcademicYear</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100">
                            <span class="text-sm text-gray-500 flex items-center gap-1">
                                Tenant
                                <i class="fas fa-circle-info text-gray-300 text-[10px]" title="The exam office that administers this student. Derived from the faculty, never chosen directly."></i>
                            </span>
                            <span class="text-sm font-semibold text-gray-800 text-right max-w-[60%]" id="dCurrentTenant">@currentTenantName</span>
                        </div>
                    </div>
                </div>

                <!-- ARROWS -->
                <div class="hidden lg:flex flex-col items-center gap-2.5 pt-8" id="arrowsCol">
                    <div class="h-[34px] flex items-center" id="arrowLevel"><i class="fas fa-minus text-gray-300 text-sm"></i></div>
                    <div class="h-[34px] flex items-center" id="arrowCollege"><i class="fas fa-minus text-gray-300 text-sm"></i></div>
                    <div class="h-[34px] flex items-center" id="arrowFaculty"><i class="fas fa-minus text-gray-300 text-sm"></i></div>
                    <div class="h-[34px] flex items-center" id="arrowProgram"><i class="fas fa-minus text-gray-300 text-sm"></i></div>
                    <div class="h-[34px] flex items-center" id="arrowYear"><i class="fas fa-minus text-gray-300 text-sm"></i></div>
                    <div class="h-[34px] flex items-center" id="arrowTenant"><i class="fas fa-minus text-gray-300 text-sm"></i></div>
                </div>

                <!-- AFTER -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-6 h-6 bg-indigo-600 rounded-full flex items-center justify-center">
                            <i class="fas fa-arrow-right text-white text-xs"></i>
                        </div>
                        <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wide">New</h3>
                    </div>
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100" id="dRowLevel">
                            <span class="text-sm text-gray-500">Level</span>
                            <span class="text-sm font-semibold text-gray-800" id="dNewLevel">—</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100" id="dRowCollege">
                            <span class="text-sm text-gray-500">College</span>
                            <span class="text-sm font-semibold text-gray-800 text-right max-w-[60%]" id="dNewCollege">—</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100" id="dRowFaculty">
                            <span class="text-sm text-gray-500">Faculty</span>
                            <span class="text-sm font-semibold text-gray-800 text-right max-w-[60%]" id="dNewFaculty">—</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100" id="dRowProgram">
                            <span class="text-sm text-gray-500">Program</span>
                            <span class="text-sm font-semibold text-indigo-700" id="dNewProgram">—</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100" id="dRowYear">
                            <span class="text-sm text-gray-500">Academic Year</span>
                            <span class="text-sm font-semibold text-gray-800" id="dNewYear">—</span>
                        </div>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 border border-gray-100" id="dRowTenant">
                            <span class="text-sm text-gray-500">Tenant</span>
                            <span class="text-sm font-semibold text-gray-800 text-right max-w-[60%]" id="dNewTenant">—</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enrollment Impact (only shown when program changes) -->
            <div id="enrollmentImpact" class="hidden mt-8 pt-6 border-t border-gray-200">
                <div class="grid grid-cols-1 lg:grid-cols-[1fr,auto,1fr] gap-6 items-start">
                    <!-- WILL BE CLOSED -->
                    <div>
                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-6 h-6 bg-red-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-lock text-red-500 text-xs"></i>
                            </div>
                            <h3 class="text-sm font-bold text-red-600 uppercase tracking-wide">Will Be Closed (kept as history)</h3>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">@enrollments.Count</span>
                        </div>

                        @if (enrollments.Count == 0)
                        {
                            <div class="py-6 text-center bg-gray-50 rounded-lg border border-gray-100">
                                <i class="fas fa-inbox text-gray-300 text-2xl mb-2"></i>
                                <p class="text-sm text-gray-400">No existing semester enrollments</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var enrollment in enrollments)
                            {
                                var statusClass = enrollment.EnrollmentStatus switch
                                {
                                    FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Active => "bg-green-100 text-green-700",
                                    FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Inactive => "bg-yellow-100 text-yellow-700",
                                    FWU.Exam.Management.Domain.Enums.StudentEnrollmentStatus.Dropped => "bg-red-100 text-red-700",
                                    _ => "bg-gray-100 text-gray-600"
                                };
                                var resultClass = enrollment.ResultStatus switch
                                {
                                    FWU.Exam.Management.Domain.Enums.ResultStatus.Passed => "bg-green-100 text-green-700",
                                    FWU.Exam.Management.Domain.Enums.ResultStatus.Failed => "bg-red-100 text-red-700",
                                    FWU.Exam.Management.Domain.Enums.ResultStatus.Incomplete => "bg-yellow-100 text-yellow-700",
                                    _ => "bg-gray-100 text-gray-600"
                                };
                                <div class="bg-red-50 border border-red-200 rounded-lg p-4 space-y-2 mb-3">
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm font-bold text-gray-800">@(enrollment.SemesterInstance?.Semester?.Name ?? "Semester")</span>
                                        <span class="text-xs text-gray-500">@(enrollment.SemesterInstance?.AcademicYear?.AcademicYearName ?? "")</span>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @statusClass">@enrollment.EnrollmentStatus</span>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @resultClass">@enrollment.ResultStatus</span>
                                    </div>
                                    <div class="flex items-center justify-between text-xs text-gray-600">
                                        <span>Credits: @enrollment.TotalCredits | GPA: @enrollment.GradePoints</span>
                                        <span>@enrollment.PaymentStatus — $@enrollment.PaidAmount / $@enrollment.TotalFee</span>
                                    </div>
                                    @if (enrollment.ExamRegistrations?.Any() == true)
                                    {
                                        <div class="mt-2 pt-2 border-t border-red-200">
                                            <button type="button" onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('i').classList.toggle('fa-chevron-down'); this.querySelector('i').classList.toggle('fa-chevron-right')"
                                                    class="flex items-center gap-1.5 text-xs font-medium text-amber-700 hover:text-amber-800">
                                                <i class="fas fa-chevron-right text-[10px]"></i>
                                                <i class="fas fa-link-slash text-[10px]"></i>
                                                <span>@enrollment.ExamRegistrations.Count exam registration(s) — will be unlinked</span>
                                            </button>
                                            <div class="hidden mt-2 space-y-1.5">
                                                @foreach (var examReg in enrollment.ExamRegistrations)
                                                {
                                                    <div class="flex items-center justify-between text-xs bg-white rounded px-2.5 py-1.5 border border-amber-200">
                                                        <span class="text-gray-700">@(examReg.ExamSchedule?.ExamScheduleName ?? "Exam")</span>
                                                        <span class="text-gray-500 font-mono">@(examReg.ExamRollNumber ?? "—")</span>
                                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium
                                                            @(examReg.Status == FWU.Exam.Management.Domain.Enums.RegistrationStatus.Registered ? "bg-green-100 text-green-700" :
                                                              examReg.Status == FWU.Exam.Management.Domain.Enums.RegistrationStatus.Rejected ? "bg-red-100 text-red-700" : "bg-gray-100 text-gray-600")">
                                                            @examReg.Status
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- ARROW -->
                    <div class="hidden lg:flex flex-col items-center justify-center pt-8 gap-2">
                        <i class="fas fa-arrow-right text-amber-500 text-xl"></i>
                        <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wide">Closed</span>
                    </div>

                    <!-- WILL BE CREATED -->
                    <div>
                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-plus-circle text-green-500 text-xs"></i>
                            </div>
                            <h3 class="text-sm font-bold text-green-600 uppercase tracking-wide">Will Be Created</h3>
                        </div>
                        <div class="bg-green-50 border border-green-200 rounded-lg p-4 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-bold text-gray-800" id="dNewEnrollSemester">Not selected</span>
                                <span class="text-xs text-gray-500" id="dNewEnrollYear">@currentAcademicYear</span>
                            </div>
                            <div class="flex flex-wrap gap-1.5">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">Active</span>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">FullTime</span>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-700">Incomplete</span>
                            </div>
                            <div class="flex items-center justify-between text-xs text-gray-600">
                                <span>Credits: 0 | GPA: 0</span>
                                <span class="text-amber-600">Pending — $0 / $0</span>
                            </div>
                            <div class="mt-2 pt-2 border-t border-green-200">
                                <p class="text-xs text-green-600">
                                    <i class="fas fa-info-circle mr-1"></i>
                                    Enrolled in the target semester you select, in <span class="font-semibold" id="dNewEnrollProgram">@currentProgram</span>, upon transfer completion. The reason you enter is stored against the closed enrollments.
                                </p>
                            </div>
                        </div>

                        @if (affectedExamCount > 0)
                        {
                            <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mt-3">
                                <div class="flex items-start gap-2">
                                    <i class="fas fa-exclamation-triangle text-amber-500 text-sm mt-0.5"></i>
                                    <div>
                                        <p class="text-xs font-medium text-amber-800">@affectedExamCount exam registration(s) will be re-pointed</p>
                                        <p class="text-xs text-amber-600 mt-1">Their college and program columns are updated. The enrollment link is kept, and exam data (grades, hall tickets) is preserved.</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Tenant Impact: only when the selected faculty resolves to a different tenant -->
            <div id="tenantImpact" class="hidden mt-8 pt-6 border-t border-gray-200">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-6 h-6 bg-purple-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-building text-purple-500 text-xs"></i>
                    </div>
                    <h3 class="text-sm font-bold text-purple-600 uppercase tracking-wide">Tenant Impact</h3>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-700">
                        <i class="fas fa-arrow-right-arrow-left mr-1"></i>
                        Cross-exam-office
                    </span>
                </div>

                <div class="bg-purple-50 border border-purple-200 rounded-lg p-4 mb-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="text-xs font-semibold text-purple-700 uppercase tracking-wide shrink-0">Moves to</span>
                            <span class="text-sm font-bold text-purple-900 truncate" id="dTenantTargetName">—</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-purple-600">
                            <span>from</span>
                            <span class="font-medium" id="dTenantSourceName">@currentTenantName</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    <!-- MOVES -->
                    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                        <div class="flex items-center gap-2 mb-3">
                            <i class="fas fa-arrow-right text-green-500 text-xs"></i>
                            <h4 class="text-xs font-bold text-green-700 uppercase tracking-wide">Moves to the new tenant</h4>
                        </div>
                        <ul class="space-y-2 text-xs text-green-800">
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-0.5 text-[10px]"></i>
                                <span>
                                    <span class="font-semibold">Student record</span> &mdash; level, college, faculty,
                                    program and academic year are re-pointed, and its tenant is restamped.
                                </span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-0.5 text-[10px]"></i>
                                <span>
                                    <span class="font-semibold">Admission record</span> &mdash; college, program and
                                    academic year follow the student.
                                </span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-0.5 text-[10px]"></i>
                                <span>
                                    <span class="font-semibold">New semester enrollment</span> &mdash; created in the
                                    new tenant, so the new exam office sees the student immediately.
                                </span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-0.5 text-[10px]"></i>
                                <span>
                                    <span class="font-semibold">Portal login</span> &mdash; the linked user account's
                                    college and faculty are updated to match.
                                </span>
                            </li>
                        </ul>
                    </div>

                    <!-- STAYS -->
                    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                        <div class="flex items-center gap-2 mb-3">
                            <i class="fas fa-lock text-amber-500 text-xs"></i>
                            <h4 class="text-xs font-bold text-amber-700 uppercase tracking-wide">Stays in the old tenant</h4>
                        </div>
                        @if (historyEnrollmentCount == 0)
                        {
                            <p class="text-xs text-amber-700">
                                No closed semesters to leave behind &mdash; the student has no completed history on
                                this program, so nothing is stranded in the previous tenant.
                            </p>
                        }
                        else
                        {
                            <ul class="space-y-2 text-xs text-amber-800">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-exclamation-triangle text-amber-500 mt-0.5 text-[10px]"></i>
                                    <span>
                                        <span class="font-semibold">@historyEnrollmentCount closed semester enrollment(s)</span>
                                        remain in <span class="font-semibold">@currentTenantName</span> with their
                                        credits, fees, GPA and results intact &mdash; they are never deleted.
                                    </span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-exclamation-triangle text-amber-500 mt-0.5 text-[10px]"></i>
                                    <span>
                                        <span class="font-semibold">Historical exam registrations</span> on those closed
                                        semesters are deactivated, not deleted, so the student drops out of the old
                                        program's exam lists.
                                    </span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-circle-info text-amber-500 mt-0.5 text-[10px]"></i>
                                    <span>
                                        <span class="font-semibold">Marks are safe</span> &mdash; result records are
                                        keyed by registration number and are not touched by this transfer.
                                    </span>
                                </li>
                            </ul>
                        }
                    </div>
                </div>

                <div class="mt-4 bg-amber-50 border border-amber-200 rounded-lg p-3">
                    <div class="flex items-start gap-2">
                        <i class="fas fa-exclamation-triangle text-amber-500 text-sm mt-0.5"></i>
                        <div>
                            <p class="text-xs font-medium text-amber-800">This split is visible to both exam offices</p>
                            <p class="text-xs text-amber-700 mt-1">
                                The student's live record lives in <span class="font-semibold" id="dTenantWarnTarget">the new tenant</span>
                                and their completed semesters stay in <span class="font-semibold" id="dTenantWarnSource">@currentTenantName</span>.
                                Each tenant's reports only see its own data, so the old exam office keeps the credit and
                                result history while the new one sees only the current enrollment. If this student needs
                                their full transcript in one place, request a transcript from
                                <span class="font-semibold" id="dTenantWarnSource2">@currentTenantName</span> before the transfer.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- No Change Message -->
            <div id="noChangeMsg" class="hidden mt-6 text-center py-6">
                <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-minus-circle text-gray-400 text-xl"></i>
                </div>
                <p class="text-sm text-gray-400">No changes detected — all values are the same as current.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 48px;
            padding: 8px 12px;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 46px;
        }
    </style>

    <script>
        var _current = {
            level: @Model.LevelId,
            faculty: @(Model.FacultyId?.ToString() ?? "0"),
            college: @Model.CollegeId,
            program: @(Model.ProgramId?.ToString() ?? "0"),
            year: @Model.AcademicYearId,
            levelName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentLevel)),
            collegeName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentCollege)),
            facultyName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentFaculty)),
            programName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentProgram)),
            yearName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentAcademicYear)),
            tenantId: @(ViewBag.CurrentTenantId ?? 1),
            tenantName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CurrentTenantName as string ?? "Central (default)"))
        };

        function setArrow(id, changed) {
            var el = document.getElementById(id);
            if (!el) return;
            el.innerHTML = changed
                ? '<div class="flex items-center gap-1"><i class="fas fa-arrow-right text-green-500 text-sm"></i><span class="text-[10px] font-bold text-green-600 uppercase">Changed</span></div>'
                : '<i class="fas fa-minus text-gray-300 text-sm"></div>';
        }

        function setRowColor(rowId, changed) {
            var el = document.getElementById(rowId);
            if (!el) return;
            if (changed) {
                el.className = el.className.replace('bg-gray-50 border-gray-100', 'bg-green-50 border-green-200');
            } else {
                el.className = el.className.replace('bg-green-50 border-green-200', 'bg-gray-50 border-gray-100');
            }
        }

        function setNameColor(textId, changed, isProgram) {
            var el = document.getElementById(textId);
            if (!el) return;
            el.className = el.className.replace(/text-(green|gray|indigo)-\d+/g, '');
            if (changed) {
                el.classList.add('text-green-700');
            } else if (isProgram) {
                el.classList.add('text-indigo-700');
            } else {
                el.classList.add('text-gray-800');
            }
        }

        function updateDiagram() {
            var newLevelId = parseInt($("#LevelId").val()) || 0;
            var newFacultyId = parseInt($("#FacultyId").val()) || 0;
            var newCollegeId = parseInt($("#CollegeId").val()) || 0;
            var newProgramId = parseInt($("#ProgramId").val()) || 0;
            var newYearId = parseInt($("#AcademicYearId").val()) || 0;

            var levelChanged = newLevelId > 0 && newLevelId !== _current.level;
            var facultyChanged = newFacultyId > 0 && newFacultyId !== _current.faculty;
            var collegeChanged = newCollegeId > 0 && newCollegeId !== _current.college;
            var programChanged = newProgramId > 0 && newProgramId !== _current.program;
            var yearChanged = newYearId > 0 && newYearId !== _current.year;
            var anyChange = levelChanged || facultyChanged || collegeChanged || programChanged || yearChanged;

            var newLevelName = getSelectedText("LevelId");
            var newFacultyName = getSelectedText("FacultyId");
            var newCollegeName = getSelectedText("CollegeId");
            var newProgramName = getSelectedText("ProgramId");
            var newYearName = getSelectedText("AcademicYearId");

            document.getElementById("dNewLevel").textContent = newLevelName || "—";
            document.getElementById("dNewFaculty").textContent = newFacultyName || "—";
            document.getElementById("dNewCollege").textContent = newCollegeName || "—";
            document.getElementById("dNewProgram").textContent = newProgramName || "—";
            document.getElementById("dNewYear").textContent = newYearName || "—";
            document.getElementById("dNewEnrollYear").textContent = newYearName || "—";
            document.getElementById("dNewEnrollProgram").textContent = newProgramName || "—";

            var semesterName = $("#SemesterId").val() ? getSelectedText("SemesterId") : "";
            document.getElementById("dNewEnrollSemester").textContent = semesterName || "Not selected";

            // The faculty carries the tenant, so a tenant change is detectable as soon as a
            // faculty is picked - it does not wait for the program. Compared by id, because a
            // faculty with no tenant of its own resolves to the central one and must not be
            // reported as a move just because it has no name.
            var targetTenantId = newFacultyId > 0 ? _facultyTenantIds[newFacultyId] : null;
            var targetTenantName = newFacultyId > 0
                ? (_facultyTenants[newFacultyId] || "Central (default)")
                : "";
            var tenantChanged = targetTenantId != null && targetTenantId !== _current.tenantId;
            // A tenant can only differ when the faculty differs, but folding it in keeps the
            // "no changes detected" message honest if the faculty/tenant rules ever change.
            anyChange = anyChange || tenantChanged;

            document.getElementById("dNewTenant").textContent = targetTenantName || "—";
            if (tenantChanged) {
                document.getElementById("dTenantTargetName").textContent = targetTenantName;
                document.getElementById("dTenantWarnTarget").textContent = targetTenantName;
                document.getElementById("dTenantWarnSource").textContent = _current.tenantName;
                document.getElementById("dTenantWarnSource2").textContent = _current.tenantName;
            }
            document.getElementById("tenantImpact").classList.toggle("hidden", !tenantChanged);

            setArrow("arrowLevel", levelChanged);
            setArrow("arrowCollege", collegeChanged);
            setArrow("arrowFaculty", facultyChanged);
            setArrow("arrowProgram", programChanged);
            setArrow("arrowYear", yearChanged);
            setArrow("arrowTenant", tenantChanged);

            setRowColor("dRowLevel", levelChanged);
            setRowColor("dRowCollege", collegeChanged);
            setRowColor("dRowFaculty", facultyChanged);
            setRowColor("dRowProgram", programChanged);
            setRowColor("dRowYear", yearChanged);
            setRowColor("dRowTenant", tenantChanged);

            setNameColor("dNewLevel", levelChanged, false);
            setNameColor("dNewCollege", collegeChanged, false);
            setNameColor("dNewFaculty", facultyChanged, false);
            setNameColor("dNewProgram", programChanged, true);
            setNameColor("dNewYear", yearChanged, false);
            setNameColor("dNewTenant", tenantChanged, false);

            var impact = document.getElementById("enrollmentImpact");
            var noChange = document.getElementById("noChangeMsg");
            if (programChanged) {
                impact.classList.remove("hidden");
                noChange.classList.add("hidden");
            } else {
                impact.classList.add("hidden");
                noChange.classList.toggle("hidden", anyChange);
            }

            var confirmText = document.getElementById("confirmText");
            if (tenantChanged) {
                confirmText.textContent = "This will change the student's program and faculty, and move them to the " +
                    "tenant '" + targetTenantName + "'. The student's record, admission and new enrollment move to " +
                    "that tenant; their closed semesters stay in '" + _current.tenantName + "' as history. " +
                    "See the Tenant Impact panel below.";
            } else if (programChanged) {
                confirmText.textContent = "This will change the student's program and faculty. Prior semester enrollments are closed and kept as history (credits, fees and results preserved), and the student is enrolled into the target semester you select. The tenant stays '" + _current.tenantName + "'.";
            } else if (facultyChanged) {
                confirmText.textContent = "This will change the student's faculty. The student keeps their current program, which must belong to the new faculty. Semester enrollments and results are preserved. The tenant stays '" + _current.tenantName + "'.";
            } else if (collegeChanged) {
                confirmText.textContent = "This will update the student's college. Semester enrollments and exam registrations are preserved. The tenant stays '" + _current.tenantName + "'.";
            } else {
                confirmText.textContent = "This will update the student's details. Semester enrollments are not affected. The tenant stays '" + _current.tenantName + "'.";
            }
        }

        function getSelectedText(selectId) {
            var el = document.getElementById(selectId);
            if (!el || el.selectedIndex < 0) return "";
            return el.options[el.selectedIndex].text;
        }

        var _facultySeq = 0, _collegeSeq = 0, _programSeq = 0, _cascadeBusy = false;
        var _facultyTenants = {};
        var _facultyTenantIds = {};

        function resetSelect(id, placeholder) {
            var el = $("#" + id);
            el.select2('destroy');
            el.empty().append('<option value="">' + placeholder + '</option>');
            el.select2({ width: 'resolve' });
        }

        // The faculty is the second step of the cascade and it is also what resolves the
        // tenant, so its options carry the tenant name through to the read-only display.
        function loadFaculties(levelId, selectedFacultyId, callback) {
            var seq = ++_facultySeq;
            if (!levelId) {
                resetSelect("FacultyId", "Select Faculty");
                updateTenantDisplay(null);
                if (callback) callback();
                return;
            }
            $.get(tenantUrl("/Students/StudentTransfers/GetFacultiesByLevel"),
                { levelId: levelId },
                function (data) {
                    if (seq !== _facultySeq) return;
                    var dropdown = $("#FacultyId");
                    dropdown.select2('destroy');
                    dropdown.empty();
                    dropdown.append('<option value="">Select Faculty</option>');
                    $.each(data, function (index, item) {
                        var sel = selectedFacultyId && item.id == selectedFacultyId ? ' selected' : '';
                        dropdown.append(`<option value="${item.id}"${sel}>${item.name}</option>`);
                        _facultyTenants[item.id] = item.tenantName;
                        _facultyTenantIds[item.id] = item.tenantId;
                    });
                    dropdown.select2({ width: 'resolve' });
                    if (callback) callback();
                });
        }

        function updateTenantDisplay(facultyId) {
            var name = facultyId ? (_facultyTenants[facultyId] || "Central (default)") : "";
            document.getElementById("ResolvedTenant").value =
                name || "Select a faculty to resolve the tenant";
        }

        // Colleges are keyed off the faculty's CollegeFaculty affiliations, not off the
        // level any more, so the list is every college the faculty is affiliated with.
        function loadColleges(facultyId, selectedCollegeId, callback) {
            var seq = ++_collegeSeq;
            if (!facultyId) {
                resetSelect("CollegeId", "Select College");
                if (callback) callback();
                return;
            }
            $.get(tenantUrl("/Students/StudentTransfers/GetCollegesByFaculty"),
                { facultyId: facultyId },
                function (data) {
                    if (seq !== _collegeSeq) return;
                    var dropdown = $("#CollegeId");
                    dropdown.select2('destroy');
                    dropdown.empty();
                    dropdown.append('<option value="">Select College</option>');
                    $.each(data, function (index, item) {
                        var sel = selectedCollegeId && item.id == selectedCollegeId ? ' selected' : '';
                        dropdown.append(`<option value="${item.id}"${sel}>${item.name}</option>`);
                    });
                    dropdown.select2({ width: 'resolve' });
                    if (callback) callback();
                });
        }

        function loadPrograms(collegeId, selectedProgramId, callback) {
            var seq = ++_programSeq;
            var levelId = $("#LevelId").val();
            var facultyId = $("#FacultyId").val();
            if (!collegeId) {
                resetSelect("ProgramId", "Select Program");
                if (callback) callback();
                return;
            }
            $.get(tenantUrl("/Students/StudentTransfers/GetProgramsByCollege"),
                { collegeId: collegeId, levelId: levelId || null, facultyId: facultyId || null },
                function (data) {
                    if (seq !== _programSeq) return;
                    var dropdown = $("#ProgramId");
                    dropdown.select2('destroy');
                    dropdown.empty();
                    dropdown.append('<option value="">Select Program</option>');
                    $.each(data, function (i, item) {
                        var sel = selectedProgramId && item.id == selectedProgramId ? ' selected' : '';
                        dropdown.append(`<option value="${item.id}"${sel}>${item.name}</option>`);
                    });
                    dropdown.select2({ width: 'resolve' });
                    if (callback) callback();
                });
        }

        var _semesterSeq = 0;
        function loadSemesters(programId, academicYearId, callback) {
            var seq = ++_semesterSeq;
            var dropdown = $("#SemesterId");
            var reset = function () {
                dropdown.select2('destroy');
                dropdown.empty();
                dropdown.append('<option value="">Select target semester</option>');
                dropdown.select2({ width: 'resolve' });
            };
            reset();
            if (!programId || !academicYearId) { if (callback) callback(); return; }
            // The academic year is passed so the endpoint only returns semesters that really
            // have a SemesterInstance for this program + year. No default is pre-selected:
            // the target semester is a required, explicit choice.
            $.get(tenantUrl("/Students/StudentTransfers/GetSemestersForProgram"),
                { programId: programId, academicYearId: academicYearId },
                function (data) {
                    if (seq !== _semesterSeq) return;
                    reset();
                    $.each(data, function (i, item) {
                        dropdown.append(`<option value="${item.id}">${item.name}</option>`);
                    });
                    dropdown.select2({ width: 'resolve' });
                    if (callback) callback();
                });
        }

        $(function () {
            $('.select2').select2({ width: 'resolve' });

            var initLevelId = @Model.LevelId;
            var initFacultyId = @(Model.FacultyId?.ToString() ?? "0");
            var initCollegeId = @Model.CollegeId;
            var initProgramId = @(Model.ProgramId?.ToString() ?? "0");

            _cascadeBusy = true;
            loadFaculties(initLevelId, initFacultyId, function () {
                updateTenantDisplay(initFacultyId || null);
                loadColleges(initFacultyId, initCollegeId, function () {
                    loadPrograms(initCollegeId, initProgramId, function () {
                        loadSemesters(initProgramId, $("#AcademicYearId").val(), function () {
                            _cascadeBusy = false;
                            updateDiagram();
                        });
                    });
                });
            });

            $("#LevelId").change(function () {
                if (_cascadeBusy) return;
                var levelId = $(this).val();
                resetSelect("FacultyId", "Select Faculty");
                resetSelect("CollegeId", "Select College");
                resetSelect("ProgramId", "Select Program");
                resetSelect("SemesterId", "Select target semester");
                updateTenantDisplay(null);
                loadFaculties(levelId, null);
                updateDiagram();
            });

            $("#FacultyId").change(function () {
                if (_cascadeBusy) return;
                var facultyId = $(this).val();
                resetSelect("CollegeId", "Select College");
                resetSelect("ProgramId", "Select Program");
                resetSelect("SemesterId", "Select target semester");
                updateTenantDisplay(facultyId || null);
                loadColleges(facultyId, null);
                updateDiagram();
            });

            $("#CollegeId").change(function () {
                if (_cascadeBusy) return;
                var collegeId = $(this).val();
                resetSelect("ProgramId", "Select Program");
                resetSelect("SemesterId", "Select target semester");
                loadPrograms(collegeId, null);
                updateDiagram();
            });

            $("#ProgramId").change(function () {
                if (_cascadeBusy) return;
                var programId = $(this).val();
                loadSemesters(programId, $("#AcademicYearId").val(), function () {
                    updateDiagram();
                });
            });

            $("#AcademicYearId").change(function () {
                // The available semesters depend on the academic year, so reload them.
                var programId = $("#ProgramId").val();
                if (programId) {
                    loadSemesters(programId, $(this).val(), function () {
                        updateDiagram();
                    });
                } else {
                    updateDiagram();
                }
            });

            $("#SemesterId").change(function () {
                updateDiagram();
            });

            // The submit button is gated on BOTH the confirmation box and a non-empty
            // reason, so an empty reason can never be posted.
            function refreshSubmitState() {
                var confirmed = $("#confirmTransfer").is(":checked");
                var reason = ($("#TransferReason").val() || "").trim();
                $("#btnTransfer").prop("disabled", !confirmed || reason.length === 0);
            }

            $("#confirmTransfer").change(refreshSubmitState);
            $("#TransferReason").on("input", refreshSubmitState);
            refreshSubmitState();

            $("#transferForm").on("submit", function (e) {
                var level = $("#LevelId").val();
                var faculty = $("#FacultyId").val();
                var college = $("#CollegeId").val();
                var program = $("#ProgramId").val();
                var ay = $("#AcademicYearId").val();
                var semester = $("#SemesterId").val();
                var reason = ($("#TransferReason").val() || "").trim();
                if (!level || !faculty || !college || !program || !ay || !semester) {
                    e.preventDefault();
                    alert("Please fill in all transfer fields, including the faculty and the target semester.");
                    return false;
                }
                if (!reason) {
                    e.preventDefault();
                    alert("Please enter a reason for this transfer. It is required.");
                    return false;
                }
                var newProgramId = parseInt(program);
                var newFacultyId = parseInt(faculty);
                var targetSemester = getSelectedText("SemesterId");
                var msg;
                if (newProgramId !== _current.program) {
                    msg = "This will transfer the student to a NEW PROGRAM. Prior semester enrollments are closed and kept as history (credits, fees and results preserved), and the student is enrolled into " + targetSemester + ". Continue?";
                } else if (newFacultyId !== _current.faculty) {
                    msg = "This will change the student's FACULTY. Their program, semester enrollments and results are preserved. Continue?";
                } else {
                    msg = "This will update the student's college. Semester enrollments will be preserved. Continue?";
                }
                // The faculty decides the tenant. When it differs from the student's current
                // tenant the student record moves and their closed history stays behind, so
                // say so up front rather than only in the success message. Compared by id,
                // not name, so a faculty without a tenant is not reported as a change.
                var newTenantId = _facultyTenantIds[faculty];
                if (newTenantId && newTenantId !== _current.tenantId) {
                    msg += "\n\nTENANT CHANGE\n" +
                           "The selected faculty is administered by tenant '" +
                           (_facultyTenants[faculty] || _current.tenantName) +
                           "', not '" + _current.tenantName + "'.\n\n" +
                           "Moves to the new tenant:\n" +
                           "  - Student record, admission record and portal login\n" +
                           "  - The new semester enrollment you selected\n\n" +
                           "Stays in '" + _current.tenantName + "':\n" +
                           "  - @enrollments.Count closed semester enrollment(s), with credits, fees and results\n" +
                           "  - Their exam registrations are deactivated, not deleted\n\n" +
                           "Each tenant only sees its own data, so a full transcript has to be requested\n" +
                           "from '" + _current.tenantName + "' before the transfer.\n\nContinue?";
                }
                if (!confirm(msg)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}