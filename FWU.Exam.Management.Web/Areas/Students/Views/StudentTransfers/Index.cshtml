@{
    ViewData["Title"] = "Transfer Student";
    var isSuperAdmin = ViewBag.IsSuperAdmin is true;
}

<div class="space-y-6" x-data="transferApp()">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-exchange-alt text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Transfer Student</h1>
                <p class="text-sm text-gray-500 mt-0.5">Search a student by name or registration number to transfer to a different program.</p>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <!-- Search Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input id="searchBox" type="search" x-model="searchTerm" x-on:input.debounce.400ms="doSearch()"
                       placeholder="Search by name, registration number..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                <div x-show="searching" x-cloak class="absolute right-3 top-1/2 -translate-y-1/2">
                    <i class="fas fa-spinner fa-spin text-gray-400 text-sm"></i>
                </div>
            </div>
            <button type="button" x-on:click="showFilters = !showFilters"
                    :class="showFilters ? 'bg-indigo-50 text-indigo-700 border-indigo-200' : 'bg-white text-gray-700 border-gray-200'"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium border rounded-lg hover:bg-gray-50 transition-colors shrink-0">
                <i class="fas fa-filter text-xs"></i> Filters
                <span x-show="activeFilterCount > 0" x-text="activeFilterCount" x-cloak
                      class="ml-1 inline-flex items-center justify-center w-5 h-5 text-xs font-bold text-white bg-indigo-500 rounded-full"></span>
            </button>
        </div>

        <!-- Filter Dropdowns (Collapsible) -->
        <div x-show="showFilters" x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 -translate-y-2"
             class="mt-4 pt-4 border-t border-gray-200">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Level</label>
                    <select id="filterLevel" x-model="filterLevel" x-on:change="onFilterChange()"
                            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                        <option value="">All Levels</option>
                        @if (ViewBag.Levels is SelectList levelList)
                        {
                            foreach (var item in levelList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">College</label>
                    <select id="filterCollege" x-model="filterCollege" x-on:change="onFilterChange()"
                            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                        <option value="">All Colleges</option>
                        @if (ViewBag.Colleges is SelectList collegeList)
                        {
                            foreach (var item in collegeList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Program</label>
                    <select id="filterProgram" x-model="filterProgram" x-on:change="onFilterChange()"
                            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                        <option value="">All Programs</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Academic Year</label>
                    <select id="filterAcademicYear" x-model="filterAcademicYear" x-on:change="onFilterChange()"
                            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                        <option value="">All Years</option>
                        @if (ViewBag.AcademicYears is SelectList ayList)
                        {
                            foreach (var item in ayList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="mt-3 flex justify-end" x-show="activeFilterCount > 0">
                <button type="button" x-on:click="clearFilters()" class="text-xs text-gray-500 hover:text-gray-700 underline">
                    Clear all filters
                </button>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div x-show="searching && searchTerm.length >= 2" x-cloak class="bg-white rounded-xl shadow-sm border border-gray-200 p-12">
        <div class="text-center">
            <i class="fas fa-spinner fa-pulse text-2xl text-indigo-500 mb-3"></i>
            <p class="text-sm text-gray-500">Searching students...</p>
        </div>
    </div>

    <!-- No Results -->
    <div x-show="searched && students.length === 0 && !searching" x-cloak class="bg-white rounded-xl shadow-sm border border-gray-200 p-12">
        <div class="text-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-user-slash text-gray-400 text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-700 mb-1">No Students Found</h3>
            <p class="text-sm text-gray-500">No students match your search or filters. Try different criteria.</p>
        </div>
    </div>

    <!-- Results Desktop Table -->
    <div x-show="students.length > 0" x-cloak class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Reg No</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Student Name</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Level</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">College</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Faculty</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Program</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <template x-for="(s, idx) in students" :key="s.id">
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-gray-500" x-text="idx + 1"></td>
                        <td class="px-4 py-3 font-mono text-xs font-semibold text-indigo-600" x-text="s.registrationNumber"></td>
                        <td class="px-4 py-3 font-medium text-gray-800" x-text="s.fullName"></td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700" x-text="s.currentLevel || '—'"></span>
                        </td>
                        <td class="px-4 py-3 text-gray-600 max-w-[180px] truncate" x-text="s.currentCollege || '—'" :title="s.currentCollege"></td>
                        <td class="px-4 py-3 text-gray-600" x-text="s.currentFaculty || '—'"></td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700" x-text="s.currentProgram || '—'"></span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <a x-bind:href="'@Url.Action("Transfer", "StudentTransfers", new { area = "Students" })/' + s.id"
                               class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-600 text-white text-xs font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                                <i class="fas fa-exchange-alt text-[10px]"></i> Transfer
                            </a>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>

    <!-- Results Mobile Cards -->
    <div x-show="students.length > 0" x-cloak class="lg:hidden space-y-3">
        <template x-for="(s, idx) in students" :key="s.id">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="flex items-center justify-between px-4 py-3 bg-gradient-to-r from-indigo-500 to-purple-600">
                    <div class="flex items-center gap-2 min-w-0">
                        <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center shrink-0">
                            <i class="fas fa-user text-white text-xs"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-bold text-white truncate" x-text="s.fullName"></p>
                            <p class="text-[11px] text-indigo-100 font-mono truncate" x-text="s.registrationNumber"></p>
                        </div>
                    </div>
                    <a x-bind:href="'@Url.Action("Transfer", "StudentTransfers", new { area = "Students" })/' + s.id"
                       class="shrink-0 ml-2 inline-flex items-center gap-1 px-3 py-1.5 bg-white/20 text-white text-xs font-medium rounded-lg hover:bg-white/30 transition-colors">
                        <i class="fas fa-exchange-alt text-[10px]"></i> Transfer
                    </a>
                </div>
                <div class="px-4 py-3 grid grid-cols-2 gap-3">
                    <div>
                        <p class="text-[11px] text-gray-400 uppercase font-medium">Level</p>
                        <p class="text-xs font-semibold text-gray-700" x-text="s.currentLevel || '—'"></p>
                    </div>
                    <div>
                        <p class="text-[11px] text-gray-400 uppercase font-medium">Faculty</p>
                        <p class="text-xs font-semibold text-gray-700" x-text="s.currentFaculty || '—'"></p>
                    </div>
                    <div class="col-span-2">
                        <p class="text-[11px] text-gray-400 uppercase font-medium">College</p>
                        <p class="text-xs font-semibold text-gray-700" x-text="s.currentCollege || '—'"></p>
                    </div>
                    <div class="col-span-2">
                        <p class="text-[11px] text-gray-400 uppercase font-medium">Program</p>
                        <p class="text-xs font-semibold text-indigo-700 bg-indigo-50 inline-block px-2 py-0.5 rounded" x-text="s.currentProgram || '—'"></p>
                    </div>
                </div>
            </div>
        </template>
    </div>

    <!-- Empty State (no search yet) -->
    <div x-show="!searched && !searching" x-cloak class="bg-white rounded-xl shadow-sm border border-gray-200 p-12">
        <div class="text-center">
            <div class="w-16 h-16 bg-indigo-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-exchange-alt text-indigo-400 text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-700 mb-1">Search for a Student</h3>
            <p class="text-sm text-gray-500">Type a registration number or student name above to find the student you want to transfer.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function transferApp() {
            return {
                searchTerm: '',
                searching: false,
                searched: false,
                students: [],
                showFilters: false,
                filterLevel: '',
                filterCollege: '',
                filterProgram: '',
                filterAcademicYear: '',
                activeFilterCount: 0,

                updateFilterCount() {
                    let count = 0;
                    if (this.filterLevel) count++;
                    if (this.filterCollege) count++;
                    if (this.filterProgram) count++;
                    if (this.filterAcademicYear) count++;
                    this.activeFilterCount = count;
                },

                clearFilters() {
                    this.filterLevel = '';
                    this.filterCollege = '';
                    this.filterProgram = '';
                    this.filterAcademicYear = '';
                    this.updateFilterCount();
                    this.loadPrograms(null);
                    this.doSearch();
                },

                onFilterChange() {
                    this.updateFilterCount();
                    if (this.filterLevel) {
                        this.loadProgramsForFilter(this.filterLevel);
                    }
                    if (this.searchTerm.trim().length >= 2) {
                        this.doSearch();
                    }
                },

                async loadProgramsForFilter(levelId) {
                    const programSelect = document.getElementById('filterProgram');
                    if (!levelId) {
                        programSelect.innerHTML = '<option value="">All Programs</option>';
                        this.filterProgram = '';
                        return;
                    }
                    try {
                        const base = window.location.pathname.replace(/\/Students\/StudentTransfers.*/, '');
                        const response = await fetch(`${base}/Students/StudentTransfers/GetProgramsByLevel?levelId=${levelId}`);
                        const data = await response.json();
                        let html = '<option value="">All Programs</option>';
                        data.forEach(function(item) {
                            html += '<option value="' + item.id + '">' + item.name + '</option>';
                        });
                        programSelect.innerHTML = html;
                        this.filterProgram = '';
                    } catch (e) {
                        programSelect.innerHTML = '<option value="">All Programs</option>';
                    }
                },

                loadPrograms(levelId) {
                    const programSelect = document.getElementById('filterProgram');
                    if (!levelId) {
                        programSelect.innerHTML = '<option value="">All Programs</option>';
                        this.filterProgram = '';
                        return;
                    }
                    const base = window.location.pathname.replace(/\/Students\/StudentTransfers.*/, '');
                    fetch(`${base}/Students/StudentTransfers/GetProgramsByLevel?levelId=${levelId}`)
                        .then(r => r.json())
                        .then(data => {
                            let html = '<option value="">All Programs</option>';
                            data.forEach(function(item) {
                                html += '<option value="' + item.id + '">' + item.name + '</option>';
                            });
                            programSelect.innerHTML = html;
                        });
                },

                async doSearch() {
                    if (this.searchTerm.trim().length < 2 && !this.filterLevel && !this.filterCollege && !this.filterProgram && !this.filterAcademicYear) {
                        this.students = [];
                        this.searched = false;
                        return;
                    }
                    if (this.searchTerm.trim().length < 2) return;

                    this.searching = true;
                    try {
                        const base = window.location.pathname.replace(/\/Students\/StudentTransfers.*/, '');
                        const params = new URLSearchParams();
                        params.append('searchTerm', this.searchTerm.trim());
                        if (this.filterLevel) params.append('levelId', this.filterLevel);
                        if (this.filterCollege) params.append('collegeId', this.filterCollege);
                        if (this.filterProgram) params.append('programId', this.filterProgram);
                        if (this.filterAcademicYear) params.append('academicYearId', this.filterAcademicYear);

                        const response = await fetch(`${base}/Students/StudentTransfers/Search?${params.toString()}`);
                        const data = await response.json();
                        this.students = Array.isArray(data) ? data : [];
                    } catch (e) {
                        console.error('Search error:', e);
                        this.students = [];
                    }
                    this.searching = false;
                    this.searched = true;
                }
            };
        }
    </script>
}
