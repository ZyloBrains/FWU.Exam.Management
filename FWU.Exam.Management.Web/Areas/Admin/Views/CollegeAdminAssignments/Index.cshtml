@model IEnumerable<CollegeAdminSubjectAssignment>

@{
    ViewData["Title"] = "College Admin Assignments";
    var collegeAdminNames = ViewBag.CollegeAdminNames as Dictionary<string, string> ?? new();
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-user-tie text-purple-600"></i>
            </div>
            <div>
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mb-6 rounded-lg bg-red-50 p-4 border border-red-200 flex items-start shadow-sm">
            <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-sm font-medium text-red-800 whitespace-pre-line">@errorMessage</div>
        </div>
    }
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">College Admin Assignments</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage college admin-subject-exam assignments.</p>
            </div>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
            <i class="fas fa-plus text-xs"></i> New Assignment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rounded-lg bg-green-50 p-4 border border-green-200 flex items-start gap-3 shadow-sm">
            <i class="fas fa-check-circle text-green-400 mt-0.5"></i>
            <div class="text-sm font-medium text-green-800">@TempData["Success"]</div>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">College Admin</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Subject</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Program</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Semester</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Exam Schedule</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Active</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-800">@(collegeAdminNames.ContainsKey(item.CollegeAdminUserId) ? collegeAdminNames[item.CollegeAdminUserId] : item.CollegeAdminUserId)</td>
                        <td class="px-4 py-3 text-gray-600">@item.SubjectOffering?.SubjectCatalog?.SubjectName</td>
                        <td class="px-4 py-3 text-gray-600">@item.SubjectOffering?.Program?.ProgramName</td>
                        <td class="px-4 py-3 text-gray-600">@item.SubjectOffering?.Semester?.Name</td>
                        <td class="px-4 py-3 text-gray-600">@(item.ExamSchedule?.ExamScheduleName ?? "All")</td>
                        <td class="px-4 py-3">
                            @if (item.IsActive)
                            {
                                <span class="text-green-600"><i class="fas fa-check-circle"></i></span>
                            }
                            else
                            {
                                <span class="text-red-400"><i class="fas fa-times-circle"></i></span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit">
                                    <i class="fas fa-edit text-xs"></i>
                                </a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Delete this assignment?')" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <i class="fas fa-user-tie text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No assignments found</h3>
                <p class="text-sm text-gray-500">Create a new college admin assignment to get started.</p>
            </div>
        }
    </div>
</div>