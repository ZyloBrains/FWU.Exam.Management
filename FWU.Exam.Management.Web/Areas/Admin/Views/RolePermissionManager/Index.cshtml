@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Manage Role Permissions";
    var permCounts = ViewBag.RolePermCounts as Dictionary<string, int> ?? new();
}

<div class="space-y-6">
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mb-6 rounded-lg bg-red-50 p-4 border border-red-200 flex items-start shadow-sm">
            <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-sm font-medium text-red-800 whitespace-pre-line">@errorMessage</div>
        </div>
    }
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-shield-alt text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Role Permissions Manager</h1>
                <p class="text-sm text-gray-500 mt-0.5">Assign and manage permissions for each role</p>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">
            <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Role</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Permissions Assigned</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var role in Model)
                {
                    var count = permCounts.GetValueOrDefault(role.Id, 0);
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-800">@role.Name</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(count > 0 ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                @count permission(s)
                            </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <a asp-action="Edit" asp-route-id="@role.Id"
                               class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition-colors">
                                <i class="fas fa-edit"></i> Manage
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-shield-alt text-4xl mb-3 opacity-50"></i>
                <p>No roles found.</p>
            </div>
        }
    </div>

    <!-- Mobile card layout -->
    <div class="lg:hidden space-y-3">
        @foreach (var role in Model)
        {
            var count = permCounts.GetValueOrDefault(role.Id, 0);
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-shield-alt text-indigo-600 text-sm"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 text-sm">@role.Name</h3>
                        </div>
                    </div>
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full @(count > 0 ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                        @count permission(s)
                    </span>
                </div>
                <a asp-action="Edit" asp-route-id="@role.Id"
                   class="block w-full text-center py-2 text-xs font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition-colors">
                    <i class="fas fa-edit mr-1"></i> Manage Permissions
                </a>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-500">
                <i class="fas fa-shield-alt text-4xl mb-3 opacity-50"></i>
                <p>No roles found.</p>
            </div>
        }
    </div>
</div>