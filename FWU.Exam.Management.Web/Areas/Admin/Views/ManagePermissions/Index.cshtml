@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Manage Permissions";
    var permCounts = ViewBag.RolePermCounts as Dictionary<string, int> ?? new();
}

<div class="container mx-auto px-4 py-6">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold"><i class="fas fa-shield-alt mr-2"></i>Manage Permissions</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            @TempData["Success"]
        </div>
    }

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Permissions Assigned</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var role in Model)
                {
                    var count = permCounts.GetValueOrDefault(role.Id, 0);
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="font-medium">@role.Name</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @(count > 0 ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                @count permission(s)
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <a asp-action="Edit" asp-route-id="@role.Id"
                               class="text-indigo-600 hover:text-indigo-900">
                                <i class="fas fa-edit mr-1"></i>Manage Permissions
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
