@using Microsoft.AspNetCore.Identity
@using FWU.Exam.Management.Application.Interfaces
@model IEnumerable<IdentityRole>
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Manage Role Permissions";
    var permCounts = ViewBag.RolePermCounts as Dictionary<string, int> ?? new();
    var isSuperAdmin = ViewBag.IsSuperAdmin as bool? ?? false;
    var userPermSet = ViewBag.UserPermSet as HashSet<string> ?? new();
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-shield-alt text-indigo-600"></i>
            </div>
            <div>
    @await Html.PartialAsync("_AlertMessages")
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Manage Role Permissions</h1>
                <p class="text-sm text-gray-500 mt-0.5">Configure role-based permissions for the college area.</p>
            </div>
        </div>
    </div>

    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Role</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Permissions You Can Manage</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var role in Model)
                {
                    var count = permCounts.GetValueOrDefault(role.Id, 0);
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-800">@role.Name</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full @(count > 0 ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                @count / @userPermSet.Count permissions
                            </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <a asp-action="Edit" asp-route-id="@role.Id"
                               class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition-colors">
                                <i class="fas fa-edit text-xs"></i> Manage Permissions
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No roles found</h3>
                <p class="text-sm text-gray-500">No roles have been created yet.</p>
            </div>
        }
    </div>

    <div class="lg:hidden space-y-3">
        @if (Model.Any())
        {
            @foreach (var role in Model)
            {
                var count = permCounts.GetValueOrDefault(role.Id, 0);
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-shield-alt text-indigo-600 text-sm"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-800 text-sm">@role.Name</h3>
                                <p class="text-xs text-gray-500">
                                    <span class="px-2 py-0.5 text-xs font-medium rounded-full @(count > 0 ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                        @count / @userPermSet.Count permissions
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <a asp-action="Edit" asp-route-id="@role.Id"
                       class="flex items-center justify-center gap-2 py-2.5 text-sm font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition-colors">
                        <i class="fas fa-edit text-xs"></i> Manage Permissions
                    </a>
                </div>
            }
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No roles found</h3>
                <p class="text-sm text-gray-500">No roles have been created yet.</p>
            </div>
        }
    </div>

    @if (!isSuperAdmin)
    {
        <div class="rounded-lg bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 text-sm">
            <i class="fas fa-info-circle mr-1"></i>
            You can only grant permissions that you yourself possess. Only roles below you in the hierarchy are shown.
        </div>
    }
</div>