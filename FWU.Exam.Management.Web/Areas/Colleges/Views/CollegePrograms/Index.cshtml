@model IEnumerable<FWU.Exam.Management.Domain.Entities.Colleges.CollegeProgram>
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "College Programs";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "collegename";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6" x-data="{ openExport: false }">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-graduation-cap text-purple-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">College Programs</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> records
                </p>
                <p class="text-xs text-gray-400 mt-1 max-w-xl">
                    Manages programs affiliated to each college with affiliation details and status.
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative">
                <button x-on:click="openExport = !openExport"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-purple-600 text-white text-sm font-medium rounded-lg hover:bg-purple-700 transition-colors shadow-sm">
                    <i class="fas fa-download text-xs"></i> Export
                </button>
                <div x-show="openExport"
                     x-on:click.away="openExport = false"
                     x-transition
                     class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                    <a asp-action="ExportToCsv"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-csv text-blue-600"></i> Export CSV
                    </a>
                    <a asp-action="ExportToPdf"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-pdf text-red-600"></i> Export PDF
                    </a>
                    <a asp-action="ExportToExcel"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-excel text-green-600"></i> Export Excel
                    </a>
                </div>
            </div>
            @if (HasPerm("collegeprograms.create"))
            {
                <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-purple-600 text-white text-sm font-medium rounded-lg hover:bg-purple-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm flex items-center gap-2">
            <i class="fas fa-check-circle text-green-500"></i>
            @successMsg
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by college name, program name, code..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500" />
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-purple-600 text-white text-sm font-medium rounded-lg hover:bg-purple-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    @{
        var grouped = Model
            .GroupBy(cp => new { cp.College?.Id, cp.College?.Name, cp.College?.Code })
            .OrderBy(g => g.Key.Name)
            .Select(g => new
            {
                CollegeName = g.Key.Name,
                CollegeCode = g.Key.Code,
                CollegeId = g.Key.Id,
                Programs = g.OrderBy(cp => cp.Program?.ProgramName)
            });
    }

    @{ var collegeIdx = 0; }
    <div class="hidden lg:block space-y-6" x-data="{ expandedCollege: null }">
        @foreach (var collegeGroup in grouped)
        {
            var collegeId = "c" + collegeIdx;
            collegeIdx++;
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <button @@click="expandedCollege = expandedCollege === '@collegeId' ? null : '@collegeId'"
                        class="w-full flex items-center justify-between px-5 py-4 bg-gradient-to-r from-purple-50 to-white hover:from-purple-100 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 bg-purple-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-school text-purple-600 text-sm"></i>
                        </div>
                        <div class="text-left">
                            <h2 class="text-base font-bold text-gray-800">@collegeGroup.CollegeName</h2>
                            <p class="text-xs text-gray-500">Code: @collegeGroup.CollegeCode · @collegeGroup.Programs.Count() program(s)</p>
                        </div>
                    </div>
                    <i class="fas fa-chevron-down text-gray-400 transition-transform"
                       :class="{ 'rotate-180': expandedCollege === '@collegeId' }"></i>
                </button>

                <div x-show="expandedCollege === '@collegeId'"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 -translate-y-2"
                     x-transition:enter-end="opacity-100 translate-y-0"
                     class="divide-y divide-gray-100">
                    <table class="w-full text-sm text-left">
                        <thead>
                            <tr class="border-b border-gray-100 bg-gray-50/50">
                                <th class="px-5 py-2 text-xs font-medium text-gray-400 uppercase">#</th>
                                <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase">Program</th>
                                <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase">Affiliation Date</th>
                                <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-right">Students</th>
                                <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase">Remarks</th>
                                <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase">Status</th>
                                <th class="px-4 py-2 text-xs font-medium text-gray-400 uppercase text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            @{ var idx = 0; }
                            @foreach (var item in collegeGroup.Programs)
                            {
                                idx++;
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-5 py-2.5 text-xs text-gray-400">@idx</td>
                                    <td class="px-4 py-2.5">
                                        <div class="text-sm font-medium text-gray-800">@(item.Program?.ProgramName ?? "-")</div>
                                        <div class="text-xs text-gray-400">@(item.Program?.ProgramCode ?? "-")</div>
                                    </td>
                                    <td class="px-4 py-2.5 text-gray-600">@(item.AffiliationDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td class="px-4 py-2.5 text-right font-medium text-gray-800">@item.NumberOfStudents.ToString("N0")</td>
                                    <td class="px-4 py-2.5 text-gray-600 truncate max-w-[200px]">@(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)</td>
                                    <td class="px-4 py-2.5">
                                        @if (item.IsActive)
                                        {
                                            <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">Inactive</span>
                                        }
                                    </td>
                                    <td class="px-4 py-2.5 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md" title="Details">
                                                <i class="fas fa-eye text-xs"></i>
                                            </a>
                                            @if (HasPerm("collegeprograms.edit"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md" title="Edit">
                                                    <i class="fas fa-edit text-xs"></i>
                                                </a>
                                            }
                                            @if (HasPerm("collegeprograms.delete"))
                                            {
                                                <a href="javascript:void(0)" onclick="deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md" title="Delete">
                                                    <i class="fas fa-trash text-xs"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-500 bg-white rounded-xl shadow-sm border border-gray-200">
                <i class="fas fa-graduation-cap text-4xl mb-3 opacity-50"></i>
                <p>No college programs found.</p>
            </div>
        }
    </div>

    @{ var collegeIdxMobile = 0; }
    <div class="lg:hidden space-y-4" x-data="{ expandedCollegeMobile: null }">
        @foreach (var collegeGroup in grouped)
        {
            var collegeIdMobile = "cm" + collegeIdxMobile;
            collegeIdxMobile++;
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <button @@click="expandedCollegeMobile = expandedCollegeMobile === '@collegeIdMobile' ? null : '@collegeIdMobile'"
                        class="w-full flex items-center justify-between px-4 py-3 bg-gradient-to-r from-purple-50 to-white hover:from-purple-100 transition-colors">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-school text-purple-500 text-sm"></i>
                        <div class="text-left">
                            <h2 class="text-sm font-bold text-gray-800">@collegeGroup.CollegeName</h2>
                            <p class="text-xs text-gray-400">@collegeGroup.Programs.Count() program(s)</p>
                        </div>
                    </div>
                    <i class="fas fa-chevron-down text-gray-400 transition-transform text-xs"
                       :class="{ 'rotate-180': expandedCollegeMobile === '@collegeIdMobile' }"></i>
                </button>

                <div x-show="expandedCollegeMobile === '@collegeIdMobile'"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 -translate-y-2"
                     x-transition:enter-end="opacity-100 translate-y-0"
                     class="divide-y divide-gray-100">
                    @foreach (var item in collegeGroup.Programs)
                    {
                        <div class="px-4 py-3 hover:bg-gray-50 transition-colors">
                            <div class="flex items-start justify-between gap-2">
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-medium text-gray-800 truncate">@(item.Program?.ProgramName ?? "-")</h4>
                                    <p class="text-xs text-gray-400 mt-0.5">@(item.Program?.ProgramCode ?? "-")</p>
                                </div>
                                @if (item.IsActive)
                                {
                                    <span class="shrink-0 px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                                }
                                else
                                {
                                    <span class="shrink-0 px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">Inactive</span>
                                }
                            </div>
                            <div class="grid grid-cols-3 gap-2 mt-2 text-xs border-t border-gray-50 pt-2">
                                <div>
                                    <span class="text-gray-400">Affiliation</span>
                                    <div class="text-gray-700 font-medium">@(item.AffiliationDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                                </div>
                                <div>
                                    <span class="text-gray-400">Students</span>
                                    <div class="text-gray-700 font-medium">@item.NumberOfStudents.ToString("N0")</div>
                                </div>
                                <div>
                                    <span class="text-gray-400">Remarks</span>
                                    <div class="text-gray-700 font-medium truncate">@(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 mt-2 pt-2 border-t border-gray-50">
                                <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-1.5 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                                    Details
                                </a>
                                @if (HasPerm("collegeprograms.edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-1.5 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                                        Edit
                                    </a>
                                }
                                @if (HasPerm("collegeprograms.delete"))
                                {
                                    <a href="javascript:void(0)" onclick="deleteRecord('@item.Id')" class="flex-1 text-center py-1.5 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                                        Delete
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-500">
                <i class="fas fa-graduation-cap text-4xl mb-3 opacity-50"></i>
                <p>No college programs found.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "CollegePrograms")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}
