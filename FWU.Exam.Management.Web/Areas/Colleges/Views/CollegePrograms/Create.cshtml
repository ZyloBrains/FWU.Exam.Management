@model FWU.Exam.Management.Web.ViewModels.CollegeProgramBulkCreateViewModel

@{
    ViewData["Title"] = "Create College Programs";
}

<div class="space-y-6"
     x-data="collegeProgramForm()"
     x-init="init()">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-graduation-cap text-purple-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Create College Programs</h1>
        </div>
    </div>

    <form asp-action="Create" method="post" @@submit.prevent="submitForm()">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2 mb-4"></div>

        <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-6 mb-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="CollegeId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">College</label>
                    <select asp-for="CollegeId" asp-items="ViewBag.CollegeId"
                            x-on:change="initExistingPrograms()"
                            class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                        <option value="">-- Select College --</option>
                    </select>
                    <span asp-validation-for="CollegeId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-6 mb-4">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-gray-700">Programs</h3>
                <span class="text-xs bg-purple-100 text-purple-700 font-medium px-2.5 py-1 rounded-full"
                      x-show="selectedPrograms.length > 0"
                      x-text="selectedPrograms.length + ' selected'"></span>
            </div>

            <div class="relative mb-4" @@click.away="showDropdown = false">
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text"
                           x-model="search"
                           @@focus="showDropdown = true"
                           @@input="showDropdown = true"
                           placeholder="Search and add programs by code or name..."
                           class="w-full border border-gray-300 rounded-lg pl-9 pr-10 py-2.5 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" />
                    <button type="button"
                            x-show="search.length > 0"
                            @@click="search = ''; showDropdown = false"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div x-show="showDropdown && filteredPrograms.length > 0"
                     class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl max-h-60 overflow-y-auto">
                    <template x-for="program in filteredPrograms" :key="program.id">
                        <div class="flex items-center justify-between px-4 py-2.5 hover:bg-purple-50 cursor-pointer border-b border-gray-100 last:border-b-0 transition"
                             @@click="addProgram(program)">
                            <div>
                                <p class="text-sm font-medium text-gray-800">
                                    <span class="font-mono text-purple-600" x-text="program.code"></span>
                                    <span class="text-gray-400 mx-1">-</span>
                                    <span x-text="program.name"></span>
                                </p>
                                <p class="text-xs text-gray-400" x-text="program.shortName"></p>
                            </div>
                            <i class="fas fa-plus text-xs text-purple-400"></i>
                        </div>
                    </template>
                </div>

                <div x-show="showDropdown && search.length > 0 && filteredPrograms.length === 0"
                     class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl p-4 text-center text-sm text-gray-400">
                    No programs match "<span x-text="search"></span>"
                </div>
            </div>

            <template x-if="selectedPrograms.length === 0">
                <div class="text-center py-8 text-gray-400 text-sm border-2 border-dashed border-gray-200 rounded-lg">
                    <i class="fas fa-search text-2xl mb-2 block text-gray-300"></i>
                    <p>Search and add programs above</p>
                </div>
            </template>

            <div class="space-y-3">
                <template x-for="(program, index) in selectedPrograms" :key="program.id">
                    <div class="border border-gray-200 rounded-lg overflow-hidden shadow-sm program-card">
                        <div class="flex items-center justify-between px-4 py-3 bg-gradient-to-r from-gray-50 to-white border-b border-gray-100">
                            <div class="flex items-center gap-3">
                                <span class="text-xs text-gray-400 font-mono bg-gray-100 px-1.5 py-0.5 rounded shrink-0"
                                      x-text="'#' + (index + 1)"></span>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">
                                        <span class="font-mono text-purple-600" x-text="program.code"></span>
                                        <span class="text-gray-400 mx-1">-</span>
                                        <span x-text="program.name"></span>
                                    </p>
                                </div>
                            </div>
                            <button type="button"
                                    class="w-7 h-7 bg-red-50 text-red-400 rounded-full flex items-center justify-center hover:bg-red-100 hover:text-red-600 transition shrink-0"
                                    @@click="removeProgram(index)">
                                <i class="fas fa-times text-xs"></i>
                            </button>
                        </div>

                        <div class="p-4 space-y-3">
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 min-w-0">
                                <div>
                                    <label class="text-xs text-gray-500 block mb-0.5">Affiliation Date</label>
                                    <input type="date"
                                           :name="'Programs[' + index + '].AffiliationDate'"
                                           x-model="program.affiliationDate"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-purple-500" />
                                </div>
                                <div>
                                    <label class="text-xs text-gray-500 block mb-0.5">Number of Students</label>
                                    <input type="number" min="0"
                                           :name="'Programs[' + index + '].NumberOfStudents'"
                                           x-model="program.numberOfStudents"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-purple-500" />
                                </div>
                                <div>
                                    <label class="text-xs text-gray-500 block mb-0.5">Remarks</label>
                                    <input type="text"
                                           :name="'Programs[' + index + '].Remarks'"
                                           x-model="program.remarks"
                                           placeholder="Optional remarks"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-purple-500" />
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="hidden" :name="'Programs[' + index + '].IsActive'" :value="program.isActive" />
                                <button type="button"
                                        @@click="program.isActive = !program.isActive"
                                        :class="program.isActive ? 'bg-purple-600 border-purple-600' : 'bg-white border-gray-300'"
                                        class="w-4 h-4 rounded border-2 flex items-center justify-center transition shrink-0">
                                    <i x-show="program.isActive" class="fas fa-check text-white text-[8px]"></i>
                                </button>
                                <span class="text-sm text-gray-600">Active</span>
                            </div>
                        </div>

                        <input type="hidden" :name="'Programs[' + index + '].ProgramId'" :value="program.id" />
                    </div>
                </template>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <button type="submit"
                    class="px-6 py-2.5 bg-purple-600 text-white text-sm font-semibold rounded-lg hover:bg-purple-700 transition shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
                    x-bind:disabled="selectedPrograms.length === 0">
                <i class="fas fa-save mr-1.5"></i>
                Save <span x-text="selectedPrograms.length"></span> Program(s)
            </button>
            <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #8b5cf6;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(139,92,246,0.2);
        }
        .select2-container {
            width: 100% !important;
        }
        .program-card {
            min-width: 0;
        }
        .program-card input,
        .program-card select {
            min-width: 0;
            max-width: 100%;
        }
    </style>

    <script>
        document.addEventListener('alpine:init', function () {
            document.querySelectorAll('.select2').forEach(function (el) {
                $(el).select2({ width: 'resolve' });
            });
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
    <script>
        function collegeProgramForm() {
            return {
                allPrograms: [],
                search: '',
                showDropdown: false,
                selectedPrograms: [],
                existingProgramIds: [],

                init() {
                    this.allPrograms = @Html.Raw(ViewBag.ProgramsJson ?? "[]");
                },

                async initExistingPrograms() {
                    const collegeId = document.getElementById('CollegeId').value;
                    if (collegeId) {
                        const resp = await fetch(`/Colleges/CollegePrograms/GetExistingPrograms?collegeId=${collegeId}`);
                        this.existingProgramIds = await resp.json();
                    } else {
                        this.existingProgramIds = [];
                    }
                },

                get filteredPrograms() {
                    if (!this.search.trim()) return [];
                    const q = this.search.toLowerCase().trim();
                    const selectedIds = new Set(this.selectedPrograms.map(p => p.id));
                    const existingIdsSet = new Set(this.existingProgramIds);
                    return this.allPrograms.filter(p =>
                        !selectedIds.has(p.id) &&
                        !existingIdsSet.has(p.id) && (
                            (p.code && p.code.toLowerCase().includes(q)) ||
                            (p.name && p.name.toLowerCase().includes(q)) ||
                            (p.shortName && p.shortName.toLowerCase().includes(q))
                        )
                    );
                },

                addProgram(program) {
                    if (this.selectedPrograms.some(p => p.id === program.id)) return;
                    if (this.existingProgramIds.includes(program.id)) {
                        alert(`Already exists: "${program.code} - ${program.name}" is already associated with this college.`);
                        this.search = '';
                        this.showDropdown = false;
                        return;
                    }
                    this.selectedPrograms.push({
                        id: program.id,
                        code: program.code,
                        name: program.name,
                        affiliationDate: '',
                        numberOfStudents: 0,
                        remarks: '',
                        isActive: true
                    });
                    this.search = '';
                    this.showDropdown = false;
                },

                removeProgram(index) {
                    this.selectedPrograms.splice(index, 1);
                },

                submitForm() {
                    if (this.selectedPrograms.length === 0) {
                        alert('Please add at least one program.');
                        return;
                    }
                    this.$el.submit();
                }
            };
        }
    </script>
}
