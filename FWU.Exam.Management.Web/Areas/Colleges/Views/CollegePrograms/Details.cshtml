@model FWU.Exam.Management.Domain.Entities.Colleges.CollegeProgram
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);

    ViewData["Title"] = "College Program Details";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-graduation-cap text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">College Program Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <!-- College & Program Section -->
        <div class="mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">College & Program Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">College</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.College.Name)</p>
                    <p class="text-xs text-gray-500">Code: @Html.DisplayFor(model => model.College.Code)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Program</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.Program.ProgramName)</p>
                    <p class="text-xs text-gray-500">Code: @Html.DisplayFor(model => model.Program.ProgramCode)</p>
                </div>
            </div>
        </div>

        <!-- Affiliation Details Section -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Affiliation Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Affiliation Date</p>
                    <p class="mt-1 text-gray-800">@(Model.AffiliationDate?.ToString("yyyy-MM-dd") ?? "�")</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Number of Students</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Model.NumberOfStudents.ToString("N0")</p>
                </div>
            </div>
        </div>

        <!-- Additional Information Section -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Additional Information</h2>
            <div class="grid grid-cols-1 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Remarks</p>
                    <p class="mt-1 text-gray-800">@(string.IsNullOrEmpty(Model.Remarks) ? "�" : Model.Remarks)</p>
                </div>
            </div>
        </div>

        <!-- Status Section -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Status</h2>
            <div class="grid grid-cols-1 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Status</p>
                    <div class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Active</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (HasPerm("collegeprograms.edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
