@model FWU.Exam.Management.Domain.Entities.Colleges.CollegeProgram

@{
    ViewData["Title"] = "Delete College Program";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-graduation-cap text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete College Program</h1>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <!-- Warning Alert -->
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this college program affiliation? This action cannot be undone.
                </p>
            </div>
        </div>

        <!-- Details Section - Two Column Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 mb-8">
            <!-- College -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">College</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.College.Name)</p>
                <p class="text-xs text-gray-500">Code: @Html.DisplayFor(model => model.College.Code)</p>
            </div>
            <!-- Program -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Program</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Program.ProgramName)</p>
                <p class="text-xs text-gray-500">Code: @Html.DisplayFor(model => model.Program.ProgramCode)</p>
            </div>
            <!-- Affiliation Date -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Affiliation Date</p>
                <p class="text-gray-800 font-medium">@(Model.AffiliationDate?.ToString("yyyy-MM-dd") ?? "—")</p>
            </div>
            <!-- Number of Students -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Number of Students</p>
                <p class="text-gray-800 font-medium">@Model.NumberOfStudents.ToString("N0")</p>
            </div>
            <!-- Remarks -->
            <div class="md:col-span-2">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Remarks</p>
                <p class="text-gray-800 font-medium">@(string.IsNullOrEmpty(Model.Remarks) ? "—" : Model.Remarks)</p>
            </div>
            <!-- Status -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</p>
                <div class="flex items-center gap-1">
                    @if (Model.IsActive)
                    {
                        <i class="fas fa-check-circle text-green-600"></i>
                        <span class="text-gray-800 font-medium">Active</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-gray-400"></i>
                        <span class="text-gray-800 font-medium">Inactive</span>
                    }
                </div>
            </div>
        </div>

        <!-- Delete Form -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this college program affiliation? This action cannot be undone.');"
                        class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
