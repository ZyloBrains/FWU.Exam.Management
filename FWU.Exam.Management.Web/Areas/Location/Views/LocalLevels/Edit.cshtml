@using FWU.Exam.Management.Domain.Entities.Location
@using FWU.Exam.Management.Domain.Enums
@model FWU.Exam.Management.Domain.Entities.Location.LocalLevel

@{
    ViewData["Title"] = "Edit Local Level";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-city text-amber-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit Local Level</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="DistrictId" class="text-sm font-medium text-gray-700 block mb-1">District</label>
                    <select asp-for="DistrictId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" asp-items="ViewBag.DistrictId">
                        <option value="">-- Select District --</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LocalLevelType" class="text-sm font-medium text-gray-700 block mb-1">Local Level Type <span class="text-red-500">*</span></label>
                    <select asp-for="LocalLevelType" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
                            asp-items="Html.GetEnumSelectList<LocalLevelType>()">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="LocalLevelType" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label for="LocalLevelName" class="text-sm font-medium text-gray-700 block mb-1">LocalLevelName <span class="text-red-500">*</span></label>
                    <input asp-for="LocalLevelName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Enter local level name" />
                    <span asp-validation-for="LocalLevelName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
