@using FWU.Exam.Management.Domain.Entities.Location
@using FWU.Exam.Management.Domain.Enums
@model IEnumerable<FWU.Exam.Management.Domain.Entities.Location.LocalLevel>
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Local Levels";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "LocalLevelName";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
}

<div class="space-y-6" x-data="{ openExport: false }">
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mb-6 rounded-lg bg-red-50 p-4 border border-red-200 flex items-start shadow-sm">
            <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-xs sm:text-sm font-medium text-red-800 whitespace-pre-line">@errorMessage</div>
        </div>
    }
    <!-- Header and action buttons -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-city text-teal-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Local Levels</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> total records
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
                <label class="text-xs sm:text-sm text-gray-700 whitespace-nowrap">Rows:</label>
                <select class="border border-gray-300 rounded-md px-2 py-1.5 text-sm focus:ring-teal-500 focus:border-teal-500"
                        onchange="window.location.href='@Url.Action("Index", new { search = currentSearch, sort = currentSort, sortDir = currentSortDir, pageSize = "__val__" })'.replace('__val__', this.value)">
                    <option value="10" selected="@(pageSize == 10)">10</option>
                    <option value="25" selected="@(pageSize == 25)">25</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                    <option value="100" selected="@(pageSize == 100)">100</option>
                    <option value="9999" selected="@(pageSize >= 9999)">All</option>
                </select>
            </div>
            <!-- Export dropdown -->
            <div class="relative">
                <button x-on:click="openExport = !openExport"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-sm">
                    <i class="fas fa-download text-xs"></i> Export
                </button>
                <div x-show="openExport"
                     x-on:click.away="openExport = false"
                     x-transition
                     class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                    <a asp-action="ExportToCsv"
                           asp-route-page="@currentPage"
                           asp-route-pageSize="@pageSize"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-csv text-blue-600"></i> CSV (Current Page)
                    </a>
                    <a asp-action="ExportToPdf"
                           asp-route-page="@currentPage"
                           asp-route-pageSize="@pageSize"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           target="_blank"
                           class="flex items-center gap-2 px-4 py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-pdf text-red-600"></i> PDF (Current Page)
                    </a>
                    <a asp-action="ExportToExcel"
                           asp-route-page="@currentPage"
                           asp-route-pageSize="@pageSize"
                           asp-route-search="@currentSearch"
                           asp-route-sort="@currentSort"
                           asp-route-sortDir="@currentSortDir"
                           class="flex items-center gap-2 px-4 py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-excel text-green-600"></i> Excel (Current Page)
                    </a>
                </div>
            </div>
            @if (HasPerm("locallevels.create"))
            {
                <a asp-action="Create" asp-area="Location" class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    <!-- Search form -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by local level name or district..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-teal-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs sm:text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Sorting Controls -->
    <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="text-gray-500">Sort by:</span>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="locallevelname" asp-route-sortDir="@(currentSort == "locallevelname" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "locallevelname" ? "bg-teal-100 text-teal-700" : "bg-gray-100 text-gray-600") hover:bg-teal-50">
            Local Level Name @(currentSort == "locallevelname" ? (currentSortDir == "asc" ? "↑" : "↓") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="localleveltype" asp-route-sortDir="@(currentSort == "localleveltype" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "localleveltype" ? "bg-teal-100 text-teal-700" : "bg-gray-100 text-gray-600") hover:bg-teal-50">
            Type @(currentSort == "localleveltype" ? (currentSortDir == "asc" ? "↑" : "↓") : "")
        </a>
        <a asp-action="Index" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="districtname" asp-route-sortDir="@(currentSort == "districtname" && currentSortDir == "asc" ? "desc" : "asc")"
               class="px-3 py-1.5 rounded-full @(currentSort == "districtname" ? "bg-teal-100 text-teal-700" : "bg-gray-100 text-gray-600") hover:bg-teal-50">
            District @(currentSort == "districtname" ? (currentSortDir == "asc" ? "↑" : "↓") : "")
        </a>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Local Level Name</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Type</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">District</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{
                    int serial = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize;
                }
                @foreach (var item in Model)
                {
                    serial++;
                    <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                        <td class="px-4 py-3 text-gray-500 text-sm">@serial</td>
                        <td class="px-4 py-3 font-medium text-gray-800">@item.LocalLevelName</td>
                        <td class="px-4 py-3 text-gray-600">
                            <span class="px-2 py-1 text-xs rounded-full @(item.LocalLevelType == LocalLevelType.RuralMunicipality ? "bg-green-100 text-green-700" : item.LocalLevelType == LocalLevelType.Municipality ? "bg-blue-100 text-blue-700" : item.LocalLevelType == LocalLevelType.SubMetropolitan ? "bg-purple-100 text-purple-700" : "bg-yellow-100 text-yellow-700")">
                                @(item.LocalLevelType switch
                                {
                                    LocalLevelType.RuralMunicipality => "Rural Municipality",
                                    LocalLevelType.Municipality => "Municipality",
                                    LocalLevelType.SubMetropolitan => "Sub-Metropolitan",
                                    LocalLevelType.Metropolitan => "Metropolitan",
                                    _ => item.LocalLevelType.ToString()
                                })
                            </span>
                        </td>
                        <td class="px-4 py-3 text-gray-600">@(item.District?.DistrictName ?? "-")</td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md" title="Details">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                @if (HasPerm("locallevels.edit"))
                                {
                                    <a asp-action="Edit" asp-area="Location" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md" title="Edit">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                }
                                @if (HasPerm("locallevels.delete"))
                                {
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-city text-4xl mb-3 opacity-50"></i>
                <p>No local levels found.</p>
            </div>
        }
    </div>

    <!-- Mobile card layout -->
    <div class="lg:hidden space-y-3">
        @{
            int serialM = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize;
        }
        @foreach (var item in Model)
        {
            serialM++;
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-city text-teal-600 text-sm"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-bold text-teal-600 bg-teal-100 rounded px-1.5 py-0.5">#@serialM</span>
                                <h3 class="font-semibold text-gray-800 text-sm">@item.LocalLevelName</h3>
                            </div>
                            <p class="text-xs text-gray-500">@(item.District?.DistrictName ?? "-")</p>
                        </div>
                    </div>
                    <span class="px-2 py-1 text-xs rounded-full @(item.LocalLevelType == LocalLevelType.RuralMunicipality ? "bg-green-100 text-green-700" : item.LocalLevelType == LocalLevelType.Municipality ? "bg-blue-100 text-blue-700" : item.LocalLevelType == LocalLevelType.SubMetropolitan ? "bg-purple-100 text-purple-700" : "bg-yellow-100 text-yellow-700")">
                        @(item.LocalLevelType switch
                        {
                            LocalLevelType.RuralMunicipality => "Rural Municipality",
                            LocalLevelType.Municipality => "Municipality",
                            LocalLevelType.SubMetropolitan => "Sub-Metropolitan",
                            LocalLevelType.Metropolitan => "Metropolitan",
                            _ => item.LocalLevelType.ToString()
                        })
                    </span>
                </div>
                <div class="flex items-center gap-2 pt-4 border-t border-gray-100 mt-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                        Details
                    </a>
                    @if (HasPerm("locallevels.edit"))
                    {
                        <a asp-action="Edit" asp-area="Location" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            Edit
                        </a>
                    }
                    @if (HasPerm("locallevels.delete"))
                    {
                        <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            Delete
                        </a>
                    }
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-500">
                <i class="fas fa-city text-4xl mb-3 opacity-50"></i>
                <p>No local levels found.</p>
            </div>
        }
    </div>

    <!-- Pagination + Page Size Selector -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Previous
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Previous</span>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Next
                    </a>
                }
                else
                {
                    <span class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Next</span>
                }
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-xs sm:text-sm text-gray-700">
                        Showing <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>
                        to <span class="font-medium">@(Math.Min(currentPage * pageSize, totalCount))</span>
                        of <span class="font-medium">@totalCount</span> results
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                               class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == 1 ? "pointer-events-none opacity-50" : "")">
                            <i class="fas fa-chevron-left text-xs"></i>
                        </a>
                        @{
                            var startPage = Math.Max(1, currentPage - 2);
                            var endPage = Math.Min(totalPages, currentPage + 2);
                            if (startPage > 1)
                            {
                                <a asp-action="Index" asp-route-page="1" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                                if (startPage > 2)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                                }
                            }
                            for (int i = startPage; i <= endPage; i++)
                            {
                                <a asp-action="Index" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold @(i == currentPage ? "bg-teal-600 text-white" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50")">@i</a>
                            }
                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                                }
                                <a asp-action="Index" asp-route-page="@totalPages" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">@totalPages</a>
                            }
                        }
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                               class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == totalPages ? "pointer-events-none opacity-50" : "")">
                            <i class="fas fa-chevron-right text-xs"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 34px; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; padding: 0.125rem 0; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding-left: 0.5rem; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 32px; }
    </style>
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;

            $.ajax({
                url: '@Url.Action("DeleteAjax", "LocalLevels")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('An error occurred while deleting.');
                }
            });
        }
    </script>
    <script>
        $(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: 'resolve' }); });
    </script>
}