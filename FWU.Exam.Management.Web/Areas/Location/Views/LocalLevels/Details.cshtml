@using FWU.Exam.Management.Domain.Entities.Location
@using FWU.Exam.Management.Domain.Enums
@model FWU.Exam.Management.Domain.Entities.Location.LocalLevel

@{
    ViewData["Title"] = "Local Level Details";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-city text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Local Level Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <p class="text-sm font-medium text-gray-600">Local Level Name</p>
                <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.LocalLevelName)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Type</p>
                <p class="mt-1 text-gray-800">
                    <span class="px-2 py-1 text-xs rounded-full @(Model.LocalLevelType == LocalLevelType.RuralMunicipality ? "bg-green-100 text-green-700" : Model.LocalLevelType == LocalLevelType.Municipality ? "bg-blue-100 text-blue-700" : Model.LocalLevelType == LocalLevelType.SubMetropolitan ? "bg-purple-100 text-purple-700" : "bg-yellow-100 text-yellow-700")">
                        @(Model.LocalLevelType switch
                        {
                            LocalLevelType.RuralMunicipality => "Rural Municipality",
                            LocalLevelType.Municipality => "Municipality",
                            LocalLevelType.SubMetropolitan => "Sub-Metropolitan",
                            LocalLevelType.Metropolitan => "Metropolitan",
                            _ => Model.LocalLevelType.ToString()
                        })
                    </span>
                </p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">District</p>
                <p class="mt-1 text-gray-800">@(Model.District?.DistrictName ?? "-")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Province</p>
                <p class="mt-1 text-gray-800">@(Model.District?.Province?.ProvinceName ?? "-")</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("CollegeAdmin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
