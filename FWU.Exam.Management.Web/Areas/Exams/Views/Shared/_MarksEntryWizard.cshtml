@model MarksEntryWizardViewModel

@{
    var mode = Model.Mode;

    var isInternal = mode == MarksEntryMode.Internal;
    var isPractical = mode == MarksEntryMode.Practical;

    var accentPrimary = isInternal ? "bg-teal-600 hover:bg-teal-700 focus:ring-teal-500" : isPractical ? "bg-amber-600 hover:bg-amber-700 focus:ring-amber-500" : "bg-blue-600 hover:bg-blue-700 focus:ring-blue-500";
    var accentInput = isInternal ? "focus:ring-teal-500" : isPractical ? "focus:ring-amber-500" : "focus:ring-blue-500";
    var accentCircle = isInternal ? "bg-teal-600" : isPractical ? "bg-amber-600" : "bg-blue-600";
    var accentBadge = isInternal ? "bg-teal-100 text-teal-700" : isPractical ? "bg-amber-100 text-amber-700" : "bg-blue-100 text-blue-700";
    var accentText = isInternal ? "text-teal-600" : isPractical ? "text-amber-600" : "text-blue-600";
    var accentIconBg = isInternal ? "bg-teal-100" : isPractical ? "bg-amber-100" : "bg-blue-100";
    var accentCheckbox = isInternal ? "text-teal-600 focus:ring-teal-500" : isPractical ? "text-amber-600 focus:ring-amber-500" : "text-blue-600 focus:ring-blue-500";
    var cardSelected = "border-indigo-600 bg-indigo-50";
    var cardCheck = "text-indigo-600";
    var modeKey = isInternal ? "internal" : isPractical ? "practical" : "theory";
    var modeLabel = isInternal ? "Internal" : isPractical ? "Practical" : "Theory";

    var config = new
    {
        mode = modeKey,
        baseUrl = "/Exams/" + Model.ControllerBase,
        saveAction = Model.SaveAction,
        isSuperAdmin = Model.IsSuperAdmin,
        isFacultyAdmin = Model.IsFacultyAdmin,
        isCollegeAdmin = Model.IsCollegeAdmin,
        colleges = Model.Colleges.Select(c => new { id = c.Id, name = c.Name }).ToList(),
        accent = new
        {
            primary = accentPrimary,
            input = accentInput,
            circle = accentCircle,
            badge = accentBadge,
            text = accentText,
            checkbox = accentCheckbox,
            cardSelected,
            cardCheck
        }
    };
}

<div id="marksEntryWizard" class="space-y-6" data-mode="@modeKey">
    @Html.AntiForgeryToken()

    <!-- Header -->
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 @accentIconBg rounded-lg flex items-center justify-center shrink-0">
            <i class="fas fa-@Model.Icon @accentText"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">@Model.Title</h1>
            <p class="text-xs text-gray-500 mt-0.5">@Model.Subtitle</p>
        </div>
    </div>

    <!-- Stepper -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
        <ol class="flex items-center w-full">
            <li class="flex flex-1 items-center" data-step-node="1">
                <button type="button" data-goto="1" class="flex items-center gap-2 sm:gap-3 group cursor-pointer text-left">
                    <span class="step-circle w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-teal-600 text-white">1</span>
                    <span class="hidden sm:block">
                        <span data-label class="block text-sm font-semibold text-gray-800">Exam Schedule</span>
                        <span class="block text-[11px] text-gray-400">Faculty, college, level</span>
                    </span>
                </button>
                <div class="mx-2 sm:mx-3 h-0.5 flex-1 bg-gray-200" data-connector="1"></div>
            </li>
            <li class="flex flex-1 items-center" data-step-node="2">
                <button type="button" data-goto="2" class="flex items-center gap-2 sm:gap-3 group cursor-pointer text-left">
                    <span class="step-circle w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 text-gray-400">2</span>
                    <span class="hidden sm:block">
                        <span data-label class="block text-sm font-semibold text-gray-400">Subject</span>
                        <span class="block text-[11px] text-gray-400">Pick the subject</span>
                    </span>
                </button>
                <div class="mx-2 sm:mx-3 h-0.5 flex-1 bg-gray-200" data-connector="2"></div>
            </li>
            <li class="flex flex-1 items-center" data-step-node="3">
                <button type="button" data-goto="3" class="flex items-center gap-2 sm:gap-3 group cursor-pointer text-left">
                    <span class="step-circle w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 text-gray-400">3</span>
                    <span class="hidden sm:block">
                        <span data-label class="block text-sm font-semibold text-gray-400">Enter Marks</span>
                        <span class="block text-[11px] text-gray-400">Enter and save marks</span>
                    </span>
                </button>
            </li>
        </ol>
    </div>

    <!-- Step 1 : Exam Schedule -->
    <section class="wizard-step space-y-4" id="wizardStep1">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div>
                    <h2 class="text-base font-bold text-gray-900">Choose Exam Schedule</h2>
                    <p class="text-xs text-gray-500 mt-0.5">Select the faculty, college and schedule for the marks you want to enter.</p>
                </div>
                <span class="text-[11px] font-semibold text-gray-500 bg-gray-100 px-2 py-1 rounded-full">Step 1 of 3</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
                <div id="facultyFilterGroup" class="@(Model.IsSuperAdmin ? "" : "hidden")">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Faculty</label>
                    <select id="FacultyId" class="select2 w-full">
                        <option value="">-- Select Faculty --</option>
                        @foreach (var item in Model.Faculties)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>

                <div id="collegeFilterGroup">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">College</label>
                    <select id="CollegeId" class="select2 w-full" disabled>
                        <option value="">-- Select College --</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Academic Year</label>
                    <select id="AcademicYearId" class="select2 w-full" disabled>
                        <option value="">-- Select Academic Year --</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Level</label>
                    <select id="LevelId" class="select2 w-full" disabled>
                        <option value="">-- Select Level --</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Exam Schedule</label>
                    <select id="ExamScheduleId" class="select2 w-full" disabled>
                        <option value="">-- Select Exam Schedule --</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
                <button type="button" id="btnNext1" disabled
                        class="inline-flex items-center gap-2 px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors opacity-50 cursor-not-allowed @accentPrimary">
                    Continue <i class="fas fa-arrow-right text-xs"></i>
                </button>
            </div>
        </div>

        <div id="scheduleDetailCard" class="hidden">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <h3 class="text-sm font-semibold text-gray-900 mb-3">Exam Schedule Details</h3>
                <dl class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 text-sm">
                    <div>
                        <dt class="text-xs text-gray-500">Academic Year</dt>
                        <dd id="schAcademicYear" class="font-medium text-gray-800">-</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500">Level</dt>
                        <dd id="schLevel" class="font-medium text-gray-800">-</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500">Program</dt>
                        <dd id="schProgram" class="font-medium text-gray-800">-</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500">Semester</dt>
                        <dd id="schSemester" class="font-medium text-gray-800">-</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500">Exam Type</dt>
                        <dd id="schExamType" class="font-medium text-gray-800">-</dd>
                    </div>
                </dl>
            </div>
        </div>
    </section>

    <!-- Step 2 : Subject -->
    <section class="wizard-step hidden space-y-4" id="wizardStep2">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div>
                    <h2 class="text-base font-bold text-gray-900">Choose Subject</h2>
                    <p id="step2Context" class="text-xs text-gray-500 mt-0.5"></p>
                </div>
                <span class="text-[11px] font-semibold text-gray-500 bg-gray-100 px-2 py-1 rounded-full">Step 2 of 3</span>
            </div>

            <div id="subjectCardsContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-h-64 overflow-y-auto"></div>

            <div class="flex items-center justify-between mt-5 pt-4 border-t border-gray-100">
                <button type="button" id="btnBack2"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-left text-xs"></i> Back
                </button>
                <button type="button" id="btnNext2" disabled
                        class="inline-flex items-center gap-2 px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors opacity-50 cursor-not-allowed @accentPrimary">
                    Continue <i class="fas fa-arrow-right text-xs"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Step 3 : Enter Marks -->
    <section class="wizard-step hidden space-y-4" id="wizardStep3">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="p-5 border-b border-gray-100">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h2 class="text-base font-bold text-gray-900" id="subjName">-</h2>
                        <p id="step3Context" class="text-xs text-gray-500 mt-0.5"></p>
                    </div>
                    <div class="flex flex-wrap gap-2" id="subjInfoBadges"></div>
                </div>
                <p id="subjectInfoLine" class="text-xs text-gray-500 mt-2"></p>
            </div>

            <div class="px-5 py-3 flex flex-wrap items-center justify-between gap-3 bg-gray-50 border-b border-gray-100">
                <p class="text-xs font-medium text-gray-600">
                    <i class="fas fa-users text-gray-400 mr-1"></i><span id="wizardStudentCount">0 students</span>
                </p>
                <div class="flex gap-2">
                    <button type="button" id="btnBack3"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-left text-xs"></i> Back
                    </button>
                    <button type="button" id="btnSave"
                            class="inline-flex items-center gap-2 px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors @accentPrimary">
                        <i class="fas fa-save"></i> Save @modeLabel Marks
                    </button>
                    <button type="button" id="btnSubmitAll"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition-colors">
                        <i class="fas fa-check-double"></i> Submit All
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">S.N</th>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Registration Number</th>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Symbol No.</th>
                            <th id="wizardMarksHeader" class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Marks</th>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Submit</th>
                        </tr>
                    </thead>
                    <tbody id="wizardStudentsBody" class="divide-y divide-gray-100"></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<script type="application/json" id="marksWizardConfig">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(config))</script>

<script>
    window.MarksEntryWizard = window.MarksEntryWizard || {};
    window.MarksEntryWizard.boot = function () {
        if (window.__marksEntryWizardBooted) return;
        window.__marksEntryWizardBooted = true;

        var config = JSON.parse(document.getElementById('marksWizardConfig').textContent);
        var state = {
            step: 1,
            scheduleId: null,
            schedule: null,
            subjectId: null,
            subject: null,
            studentsLoaded: false
        };

        function tenant(path) {
            return (typeof window.tenantUrl === 'function') ? tenantUrl(path) : path;
        }

        function fmt(v) {
            return (v === null || v === undefined || v === '') ? '-' : v;
        }

        function populateSelect(sel, options, placeholder, enabled) {
            if (sel.data('select2')) sel.select2('destroy');
            sel.empty().append('<option value="">' + placeholder + '</option>');
            $.each(options, function (i, o) {
                sel.append('<option value="' + o.id + '">' + o.name + '</option>');
            });
            sel.prop('disabled', !enabled);
            sel.select2({ width: 'resolve' });
        }

        function clearSelect(sel, placeholder) {
            populateSelect(sel, [], placeholder, false);
        }

        function getCollegeId() { return $('#CollegeId').val(); }

        function setNextEnabled(step, enabled) {
            var btn = step === 1 ? $('#btnNext1') : $('#btnNext2');
            if (enabled) {
                btn.prop('disabled', false).removeClass('opacity-50 cursor-not-allowed');
            } else {
                btn.prop('disabled', true).addClass('opacity-50 cursor-not-allowed');
            }
        }

        function resetStudentsArea() {
            state.studentsLoaded = false;
            $('#wizardStudentsBody').empty();
            $('#wizardStudentCount').text('0 students');
            $('#subjName').text('-');
            $('#step3Context').empty();
            $('#subjInfoBadges').empty();
            $('#subjectInfoLine').empty();
        }

        function resetSubjectsAndStudents() {
            state.subjectId = null;
            state.subject = null;
            $('#subjectCardsContainer').empty();
            resetStudentsArea();
            setNextEnabled(2, false);
        }

        function resetScheduleAndBelow() {
            clearSelect($('#ExamScheduleId'), '-- Select Exam Schedule --');
            $('#scheduleDetailCard').addClass('hidden');
            state.scheduleId = null;
            state.schedule = null;
            setNextEnabled(1, false);
            resetSubjectsAndStudents();
        }

        function loadColleges(facultyId) {
            var sel = $('#CollegeId');
            if (!facultyId) { clearSelect(sel, '-- Select College --'); return; }
            $.get(tenant(config.baseUrl + '/GetColleges'), { facultyId: facultyId }, function (data) {
                populateSelect(sel, data, '-- Select College --', true);
            });
        }

        function loadAcademicYears(collegeId) {
            var sel = $('#AcademicYearId');
            if (!collegeId) { clearSelect(sel, '-- Select Academic Year --'); return; }
            $.get(tenant(config.baseUrl + '/GetAcademicYears'), { collegeId: collegeId }, function (data) {
                populateSelect(sel, data, '-- Select Academic Year --', true);
            });
        }

        function loadLevels(collegeId, academicYearId) {
            var sel = $('#LevelId');
            if (!collegeId || !academicYearId) { clearSelect(sel, '-- Select Level --'); return; }
            $.get(tenant(config.baseUrl + '/GetLevels'), { collegeId: collegeId, academicYearId: academicYearId }, function (data) {
                populateSelect(sel, data, '-- Select Level --', true);
            });
        }

        function loadSchedules(collegeId, academicYearId, levelId) {
            var sel = $('#ExamScheduleId');
            if (!collegeId || !academicYearId || !levelId) { clearSelect(sel, '-- Select Exam Schedule --'); return; }
            $.get(tenant(config.baseUrl + '/GetExamSchedules'), { collegeId: collegeId, academicYearId: academicYearId, levelId: levelId }, function (data) {
                populateSelect(sel, data, '-- Select Exam Schedule --', true);
            });
        }

        function loadScheduleDetail(scheduleId) {
            $.get(tenant(config.baseUrl + '/GetScheduleDetail'), { examScheduleId: scheduleId, collegeId: getCollegeId() }, function (data) {
                if (!data) return;
                $('#schAcademicYear').text(data.academicYearName || '-');
                $('#schLevel').text(data.levelName || '-');
                $('#schProgram').text(data.programName || '-');
                $('#schSemester').text(data.semesterName || '-');
                $('#schExamType').text(data.examTypeName || '-');
                if (state.schedule) {
                    state.schedule.academicYearName = data.academicYearName;
                    state.schedule.levelName = data.levelName;
                    state.schedule.programName = data.programName;
                    state.schedule.semesterName = data.semesterName;
                    state.schedule.examTypeName = data.examTypeName;
                }
                $('#scheduleDetailCard').removeClass('hidden');
                renderStep2Context();
            });
        }

        function renderStep2Context() {
            var s = state.schedule;
            if (!s) { $('#step2Context').empty(); return; }
            var parts = [];
            if (s.name) parts.push('<span class="font-semibold text-gray-700">' + s.name + '</span>');
            if (s.academicYearName) parts.push(s.academicYearName);
            if (s.programName) parts.push(s.programName);
            if (s.levelName) parts.push(s.levelName);
            if (s.semesterName) parts.push(s.semesterName);
            $('#step2Context').html(parts.length ? 'Selected: ' + parts.join(' &middot; ') : '');
        }

        function loadSubjects(scheduleId) {
            $.get(tenant(config.baseUrl + '/GetSubjects'), { examScheduleId: scheduleId, collegeId: getCollegeId() }, function (data) {
                renderSubjectCards(data || []);
            });
        }

        function renderSubjectCards(data) {
            var container = $('#subjectCardsContainer').empty();
            if (!data.length) {
                container.append('<p class="text-sm text-gray-500">No subjects found for this exam schedule.</p>');
                setNextEnabled(2, false);
                return;
            }
            state.subjectId = null;
            state.subject = null;
            setNextEnabled(2, false);

            $.each(data, function (i, s) {
                var card = $('<button type="button"></button>');
                card.addClass('subject-card text-left bg-white border border-gray-200 rounded-xl p-4 transition-colors');
                card.attr('data-id', s.id);
                card.attr('data-code', s.code || '');
                card.attr('data-theoryfull', s.theoryFullMarks != null ? s.theoryFullMarks : '');
                card.attr('data-internaltheoryfull', s.internalTheoryFullMarks != null ? s.internalTheoryFullMarks : '');

                var head = $('<div class="flex items-start justify-between gap-2"></div>');
                head.append('<span class="font-semibold text-gray-800 text-sm leading-tight">' + s.name + '</span>');
                var check = $('<i class="fas fa-check-circle subject-check text-indigo-600 shrink-0"></i>').hide();
                head.append(check);
                card.append(head);

                if (s.code) card.append('<p class="text-xs text-gray-400 mt-0.5">' + s.code + '</p>');

                var badgeRow = $('<div class="flex flex-wrap gap-1.5 mt-3"></div>');
                if (config.mode === 'internal') {
                    badgeRow.append('<span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-teal-100 text-teal-700">Internal Theory / ' + fmt(s.internalTheoryFullMarks) + '</span>');
                } else if (config.mode === 'practical') {
                    badgeRow.append('<span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">Practical / ' + fmt(s.practicalFullMarks) + '</span>');
                } else {
                    badgeRow.append('<span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-blue-100 text-blue-700">Theory / ' + fmt(s.theoryFullMarks) + '</span>');
                }
                card.append(badgeRow);

                container.append(card);
            });
        }

        function loadSubjectDetail(subjectId) {
            $.get(tenant(config.baseUrl + '/GetSubjectDetail'), { subjectOfferingId: subjectId, collegeId: getCollegeId() }, function (data) {
                if (!data) return;
                $('#subjName').text(data.name + (data.code ? ' (' + data.code + ')' : ''));
                var badges = $('#subjInfoBadges').empty();
                var line = $('#subjectInfoLine').empty();
                if (config.mode === 'internal') {
                    badges.append('<span class="text-[10px] font-medium px-2 py-1 rounded-full bg-teal-100 text-teal-700">Internal Theory / ' + fmt(data.internalTheoryFullMarks) + '</span>');
                    line.text('Enter internal marks for each student. Values must not exceed the full marks shown under each input.');
                } else if (config.mode === 'practical') {
                    badges.append('<span class="text-[10px] font-medium px-2 py-1 rounded-full bg-amber-100 text-amber-700">Practical / ' + fmt(data.practicalFullMarks) + '</span>');
                    badges.append('<span class="text-[10px] font-medium px-2 py-1 rounded-full bg-amber-100 text-amber-700">Pass / ' + fmt(data.practicalPassMarks) + '</span>');
                    line.text('Enter practical marks for each student. Values must not exceed the full marks shown under each input.');
                } else {
                    badges.append('<span class="text-[10px] font-medium px-2 py-1 rounded-full bg-blue-100 text-blue-700">Theory / ' + fmt(data.theoryFullMarks) + '</span>');
                    badges.append('<span class="text-[10px] font-medium px-2 py-1 rounded-full bg-blue-100 text-blue-700">Pass / ' + fmt(data.theoryPassMarks) + '</span>');
                    line.text('Enter theory marks for each student. Values must not exceed the full marks shown under each input.');
                }
                renderStep3Context();
            });
        }

        function renderStep3Context() {
            var s = state.schedule;
            var subj = state.subject;
            var html = 'Selected: ';
            if (s && s.name) html += '<span class="font-semibold text-gray-700">' + s.name + '</span>';
            if (subj) {
                html += ' <span class="text-gray-400">&rsaquo;</span> <span class="font-semibold text-gray-700">' + subj.name + '</span>';
                if (subj.code) html += ' <span class="text-gray-400">(' + subj.code + ')</span>';
            }
            $('#step3Context').html(html);
        }

        function loadStudents(subjectId) {
            $.get(tenant(config.baseUrl + '/GetStudents'), {
                examScheduleId: state.scheduleId,
                subjectOfferingId: subjectId,
                collegeId: getCollegeId()
            }, function (data) {
                if (!data) return;
                state.studentsLoaded = true;
                renderStudents(data);
            });
        }

        function buildField(label, value, max, col) {
            var box = $('<div></div>');
            box.append('<span class="block text-[10px] font-medium text-gray-400 mb-0.5">' + label + '</span>');
            var input = $('<input type="number" step="0.5" min="0" class="w-24 px-2 py-1.5 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 ' + config.accent.input + ' marks-input">');
            input.attr('data-max', max != null ? max : '');
            input.attr('data-col', col);
            if (max != null) input.attr('max', max);
            if (value != null) input.val(value);
            box.append(input);
            if (max != null) box.append('<span class="block text-[10px] text-gray-400 mt-0.5">/ ' + max + '</span>');
            return box;
        }

        function renderStudents(data) {
            var tbody = $('#wizardStudentsBody').empty();
            var theoryMax = config.mode === 'internal' ? data.internalTheoryFullMarks : data.theoryFullMarks;
            var practicalMax = data.practicalFullMarks;

            $('#wizardMarksHeader').text(config.mode === 'internal'
                ? 'Internal Marks'
                : config.mode === 'practical' ? 'Practical Marks' : 'Theory Marks');
            $('#wizardStudentCount').text(data.students.length + ' student(s)');

            $.each(data.students, function (i, s) {
                var tr = $('<tr class="hover:bg-gray-50"></tr>');
                tr.data('examRegistrationId', s.examRegistrationId);
                tr.data('examSubjectResultId', s.examSubjectResultId || null);
                tr.append('<td class="px-4 py-2.5 text-gray-500">' + (i + 1) + '</td>');
                tr.append('<td class="px-4 py-2.5 font-medium text-gray-800">' + (s.registrationNumber || '-') + '</td>');
                tr.append('<td class="px-4 py-2.5 text-gray-700">' + (s.symbolNumber || '-') + '</td>');

                var td = $('<td class="px-4 py-2.5"></td>');
                var wrap = $('<div class="flex items-start gap-3"></div>');
                if (config.mode === 'practical') {
                    wrap.append(buildField('Practical', s.practical, practicalMax, 'practical'));
                } else {
                    wrap.append(buildField('Theory', config.mode === 'internal' ? s.theoryInternal : s.theory, theoryMax, 'theory'));
                }
                td.append(wrap);
                tr.append(td);

                var submitTd = $('<td class="px-4 py-2.5"></td>');
                if (s.isSubmitted) {
                    submitTd.append('<span class="inline-flex items-center gap-1 text-[10px] font-medium px-2 py-1 rounded-full bg-green-100 text-green-700"><i class="fas fa-check-circle"></i> Submitted</span>');
                } else {
                    var box = $('<label class="inline-flex items-center gap-1.5 cursor-pointer"></label>');
                    box.append('<input type="checkbox" class="submit-check rounded border-gray-300 ' + config.accent.checkbox + '">');
                    box.append('<span class="text-[11px] text-gray-500">Submit</span>');
                    submitTd.append(box);
                }
                tr.append(submitTd);

                tbody.append(tr);
            });
        }

        function nextMarksField(current) {
            var $row = $(current).closest('tr');
            var $inputs = $row.find('.marks-input');
            var idx = $inputs.index(current);
            if (idx < $inputs.length - 1) return $inputs.eq(idx + 1);
            var $nextRow = $row.next('tr');
            if ($nextRow.length) return $nextRow.find('.marks-input').first();
            return null;
        }

        function validateInput(el) {
            var max = parseFloat($(el).attr('data-max'));
            var val = parseFloat(el.value);
            if (max && !isNaN(val) && val > max) {
                $(el).removeClass('border-gray-300').addClass('border-red-500');
                $(el).attr('data-invalid', 'true');
            } else {
                $(el).removeClass('border-red-500').addClass('border-gray-300');
                $(el).attr('data-invalid', 'false');
            }
        }

        function collectRows() {
            var rows = [];
            $('#wizardStudentsBody tr').each(function () {
                var $row = $(this);
                var theoryVal = $row.find('.marks-input[data-col="theory"]').val();
                var practicalVal = $row.find('.marks-input[data-col="practical"]').val();
                var row = {
                    ExamRegistrationId: $row.data('examRegistrationId'),
                    ExamSubjectResultId: $row.data('examSubjectResultId') || null,
                    IsSubmitted: $row.find('.submit-check').is(':checked')
                };
                if (config.mode === 'internal') {
                    row.TheoryInternal = theoryVal !== '' ? parseFloat(theoryVal) : null;
                } else if (config.mode === 'practical') {
                    row.Practical = practicalVal !== '' ? parseFloat(practicalVal) : null;
                } else {
                    row.Theory = theoryVal !== '' ? parseFloat(theoryVal) : null;
                }
                rows.push(row);
            });
            return rows;
        }

        function submitSave(submitAll) {
            var payload = {
                CollegeId: parseInt(getCollegeId(), 10),
                ExamScheduleId: parseInt(state.scheduleId, 10),
                SubjectOfferingId: parseInt(state.subjectId, 10),
                SubmitAll: submitAll,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                Students: collectRows()
            };

            if (!payload.CollegeId || !payload.ExamScheduleId || !payload.SubjectOfferingId) {
                alert('Please select the exam schedule and subject first.');
                return;
            }

            if ($('#wizardStudentsBody .marks-input[data-invalid="true"]').length > 0) {
                alert('Some marks exceed the full marks. Please correct them before saving.');
                return;
            }

            $.post(tenant(config.baseUrl + '/' + config.saveAction), payload, function (res) {
                if (res.success) {
                    alert(res.message);
                    loadStudents(state.subjectId);
                } else {
                    alert(res.message);
                }
            }).fail(function () {
                alert('Save failed. Please try again.');
            });
        }

        function showStep(n) {
            $('.wizard-step').addClass('hidden');
            $('#wizardStep' + n).removeClass('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderStepper() {
            var circleBase = 'step-circle w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold';
            $('[data-step-node]').each(function () {
                var node = $(this);
                var n = parseInt(node.attr('data-step'), 10);
                var circle = node.find('.step-circle');
                var connector = node.find('[data-connector]');
                var label = node.find('[data-label]');

                if (n < state.step) {
                    circle.attr('class', circleBase + ' bg-green-500 text-white').html('<i class="fas fa-check text-xs"></i>');
                    connector.removeClass('bg-gray-200').addClass('bg-green-500');
                    label.removeClass('text-gray-400').addClass('text-gray-800');
                } else if (n === state.step) {
                    circle.attr('class', circleBase + ' text-white ' + config.accent.circle).text(n);
                    connector.removeClass('bg-green-500').addClass('bg-gray-200');
                    label.removeClass('text-gray-400').addClass('text-gray-800');
                } else {
                    circle.attr('class', circleBase + ' bg-gray-200 text-gray-400').text(n);
                    connector.removeClass('bg-green-500').addClass('bg-gray-200');
                    label.removeClass('text-gray-800').addClass('text-gray-400');
                }
            });
        }

        function gotoStep(n) {
            if (n === 2 && !state.scheduleId) return;
            if (n === 3) {
                if (!state.subjectId) return;
                if (!state.studentsLoaded) {
                    loadSubjectDetail(state.subjectId);
                    loadStudents(state.subjectId);
                }
            }
            state.step = n;
            showStep(n);
            renderStepper();
        }

        function init() {
            var collegeSel = $('#CollegeId');

            if (config.colleges && config.colleges.length) {
                populateSelect(collegeSel, config.colleges, '-- Select College --', !config.isSuperAdmin);
            } else {
                clearSelect(collegeSel, '-- Select College --');
            }

            if (config.isSuperAdmin && collegeSel.data('select2')) {
                collegeSel.select2('disable');
            }

            $('.select2').select2({ width: 'resolve' });

            if (config.isCollegeAdmin) {
                var first = collegeSel.find('option:not(:first)').first().val();
                if (first) {
                    collegeSel.val(first);
                    loadAcademicYears(first);
                }
            }

            $('#FacultyId').on('change', function () {
                loadColleges($(this).val());
                clearSelect($('#AcademicYearId'), '-- Select Academic Year --');
                clearSelect($('#LevelId'), '-- Select Level --');
                resetScheduleAndBelow();
            });

            $('#CollegeId').on('change', function () {
                loadAcademicYears($(this).val());
                clearSelect($('#LevelId'), '-- Select Level --');
                resetScheduleAndBelow();
            });

            $('#AcademicYearId').on('change', function () {
                loadLevels(getCollegeId(), $(this).val());
                resetScheduleAndBelow();
            });

            $('#LevelId').on('change', function () {
                loadSchedules(getCollegeId(), $('#AcademicYearId').val(), $(this).val());
                resetScheduleAndBelow();
            });

            $('#ExamScheduleId').on('change', function () {
                var id = $(this).val();
                $('#scheduleDetailCard').addClass('hidden');
                state.scheduleId = id ? parseInt(id, 10) : null;
                state.schedule = id ? { name: $(this).find('option:selected').text() } : null;
                setNextEnabled(1, !!id);
                resetSubjectsAndStudents();
                renderStepper();
                if (!id) return;
                loadScheduleDetail(id);
                loadSubjects(id);
            });

            $('[data-goto]').on('click', function () {
                gotoStep(parseInt($(this).attr('data-goto'), 10));
            });

            $('#btnNext1').on('click', function () { gotoStep(2); });
            $('#btnBack2').on('click', function () { gotoStep(1); });
            $('#btnNext2').on('click', function () { gotoStep(3); });
            $('#btnBack3').on('click', function () { gotoStep(2); });

            $(document).on('click', '.subject-card', function () {
                var card = $(this);
                var id = parseInt(card.attr('data-id'), 10);
                $('.subject-card').removeClass(config.accent.cardSelected);
                $('.subject-card .subject-check').hide();

                if (state.subjectId === id) {
                    state.subjectId = null;
                    state.subject = null;
                    resetStudentsArea();
                    setNextEnabled(2, false);
                    return;
                }

                state.subjectId = id;
                state.subject = {
                    name: card.find('.font-semibold').text().trim(),
                    code: card.attr('data-code')
                };
                resetStudentsArea();
                card.addClass(config.accent.cardSelected);
                card.find('.subject-check').show();
                setNextEnabled(2, true);
            });

            $(document).on('input', '.marks-input', function () {
                validateInput(this);
                if (this.value.length >= 2) {
                    var n = nextMarksField(this);
                    if (n) n.focus();
                }
            });

            $(document).on('keydown', '.marks-input', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var n = nextMarksField(this);
                    if (n) n.focus();
                }
            });

            $(document).on('change', '.marks-input', function () { validateInput(this); });

            $('#btnSave').on('click', function () { submitSave(false); });
            $('#btnSubmitAll').on('click', function () { submitSave(true); });

            renderStepper();
            showStep(1);
        }

        init();
    };
</script>
