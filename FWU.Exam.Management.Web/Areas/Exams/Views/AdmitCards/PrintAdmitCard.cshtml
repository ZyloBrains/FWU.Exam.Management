@model AdmitCard

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admit Card - @Model.AdmitCardNumber</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 40px;
            color: #333;
        }
        .ticket {
            max-width: 800px;
            margin: 0 auto;
            border: 2px solid #333;
            padding: 30px;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            text-transform: uppercase;
        }
        .header h2 {
            margin: 5px 0;
            font-size: 18px;
        }
        .header p {
            margin: 5px 0;
            font-size: 14px;
        }
        .info-table {
            width: 100%;
            border-collapse: collapse;
        }
        .info-table td {
            padding: 8px 12px;
            font-size: 14px;
            border: 1px solid #ddd;
        }
        .info-table td:first-child {
            font-weight: 600;
            width: 180px;
            background: #f9f9f9;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 2px solid #333;
            font-size: 12px;
        }
        .ticket-number {
            text-align: center;
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 20px;
            padding: 10px;
            background: #f0f0f0;
            border: 1px dashed #666;
        }
        @@media print {
            body { padding: 0; }
            .ticket { border: none; }
        }
    </style>
</head>
<body>
    <div class="ticket">
        <div class="header">
            <h1>Far Western University</h1>
            <h2>Admit Card</h2>
            <p>Exam Management System</p>
        </div>

        <div class="ticket-number">
            Card No: @Model.AdmitCardNumber
        </div>

        <table class="info-table">
            <tr>
                <td>Exam Schedule</td>
                <td>@Model.ExamSchedule?.ExamScheduleName</td>
            </tr>
            @if (Model.ExamRegistration != null)
            {
                <tr>
                    <td>Roll Number</td>
                    <td>@(Model.ExamRegistration.ExamRollNumber ?? "-")</td>
                </tr>
                <tr>
                    <td>Program</td>
                    <td>@(Model.ExamRegistration.Program?.ProgramName ?? "-")</td>
                </tr>
                <tr>
                    <td>College</td>
                    <td>@(Model.ExamRegistration.College?.Name ?? "-")</td>
                </tr>
            }
            <tr>
                <td>Student Name</td>
                <td>@(Model.StudentRegistration != null ? $"{Model.StudentRegistration.FirstName} {Model.StudentRegistration.LastName}" : "-")</td>
            </tr>
            <tr>
                <td>Generated Date</td>
                <td>@Model.GeneratedDate.ToString("yyyy-MM-dd")</td>
            </tr>
        </table>

        <div class="footer">
            <p>This is a computer-generated admit card. Signature not required.</p>
            <p>Generated by FWU Exam Management System</p>
        </div>
    </div>

    <script>
        window.print();
    </script>
</body>
</html>
