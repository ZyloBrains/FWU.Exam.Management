@model IEnumerable<AdmitCard>
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Admit Cards";
    var currentUser = await UserManager.GetUserAsync(User);
    var userPerms = currentUser != null
        ? await PermissionService.GetUserPermissionsAsync(currentUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => userPerms.Contains(permission);
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "Id";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
    var currentScheduleId = (ViewData["ExamScheduleId"] is SelectList scheduleSelectList && scheduleSelectList.SelectedValue != null)
        ? scheduleSelectList.SelectedValue.ToString() ?? ""
        : "";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-ticket-alt text-indigo-600"></i>
            </div>
            <div>
    @await Html.PartialAsync("_AlertMessages")
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Admit Cards</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage admit cards for exams.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            @await Html.PartialAsync("_ExportDropdown", new ExportDropdownModel
            {
                RouteValues = new Dictionary<string, string>
                {
                    ["search"] = currentSearch,
                    ["examScheduleId"] = currentScheduleId
                },
                ButtonClass = "bg-green-600 hover:bg-green-700",
                ScopeLabel = " (All)"
            })
            @if (HasPerm("admitcards.generate"))
            {
                <a asp-action="Generate" asp-area="Exams"
                   class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Generate Cards
                </a>
            }
            @if (HasPerm("admitcards.download"))
            {
                <a asp-action="PrintAll" asp-area="Exams" asp-route-examScheduleId="@currentScheduleId"
                   class="inline-flex items-center gap-2 px-4 py-2.5 bg-purple-600 text-white text-sm font-medium rounded-lg hover:bg-purple-700 transition-colors shadow-sm">
                    <i class="fas fa-print text-xs"></i> Download All (PDF)
                </a>
            }
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" asp-area="Exams" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by card number, schedule..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="relative w-full sm:w-48">
                <select name="examScheduleId" class="select2 w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        onchange="this.form.submit()">
                    <option value="">All Schedules</option>
                    @if (ViewData["ExamScheduleId"] is SelectList scheduleList)
                    {
                        @foreach (var item in scheduleList)
                        {
                            <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-area="Exams" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                       class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Card #</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Exam Schedule</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Student</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Generated Date</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{ var serial = (currentPage - 1) * pageSize; }
                @foreach (var item in Model)
                {
                    serial++;
                    <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                        <td class="px-4 py-3 text-gray-500">@serial</td>
                        <td class="px-4 py-3">
                            <div class="font-medium text-gray-800">@item.AdmitCardNumber</div>
                        </td>
                        <td class="px-4 py-3 text-gray-600">@item.ExamSchedule?.ExamScheduleName</td>
                        <td class="px-4 py-3 text-gray-600">
                            @(item.StudentRegistration != null ? $"{item.StudentRegistration.FirstName} {item.StudentRegistration.LastName}" : "-")
                        </td>
                        <td class="px-4 py-3 text-gray-600 text-xs">@item.GeneratedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="px-4 py-3">
                            @if (item.IsActive)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded-full">Inactive</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a asp-action="Details" asp-area="Exams" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                <a asp-action="Download" asp-area="Exams" asp-route-id="@item.Id" class="p-1.5 text-green-600 hover:bg-green-50 rounded-md transition-colors" title="Download">
                                    <i class="fas fa-download text-xs"></i>
                                </a>
                                @if (HasPerm("admitcards.delete"))
                                {
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <i class="fas fa-ticket-alt text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No admit cards found.</p>
            </div>
        }
    </div>

    <div class="lg:hidden space-y-3">
        @{ var serialMobile = (currentPage - 1) * pageSize; }
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                serialMobile++;
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                                <span class="text-xs font-bold text-indigo-700">@serialMobile</span>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-800 text-sm">@item.AdmitCardNumber</h3>
                                <p class="text-xs text-gray-500">@item.ExamSchedule?.ExamScheduleName</p>
                            </div>
                        </div>
                        <div>
                            @if (item.IsActive)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded-full">Inactive</span>
                            }
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                        <div class="text-gray-500">Student</div>
                        <div class="text-gray-800">@(item.StudentRegistration != null ? $"{item.StudentRegistration.FirstName} {item.StudentRegistration.LastName}" : "-")</div>
                        <div class="text-gray-500">Generated</div>
                        <div class="text-gray-800">@item.GeneratedDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="flex items-center gap-2 pt-3 mt-2 border-t border-gray-100">
                        <a asp-action="Details" asp-area="Exams" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                            <i class="fas fa-eye mr-1"></i> Details
                        </a>
                        <a asp-action="Download" asp-area="Exams" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-green-600 bg-green-50 rounded-lg hover:bg-green-100">
                            <i class="fas fa-download mr-1"></i> Download
                        </a>
                        @if (HasPerm("admitcards.delete"))
                        {
                            <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                                <i class="fas fa-trash mr-1"></i> Delete
                            </a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-ticket-alt text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No admit cards found.</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
            <div class="text-sm text-gray-500 font-medium">
                Showing <span class="font-semibold text-gray-900">@(((currentPage - 1) * pageSize) + 1)</span>
                to <span class="font-semibold text-gray-900">@(Math.Min(currentPage * pageSize, totalCount))</span>
                of <span class="font-semibold text-gray-900">@totalCount</span> entries
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-2">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir" asp-route-pageSize="@pageSize"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        <i class="fas fa-chevron-left text-xs"></i> Previous
                    </a>
                }
                <span class="text-sm font-semibold text-gray-700 min-w-[4rem] text-center">@currentPage / @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir" asp-route-pageSize="@pageSize"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        Next <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
    </style>
    <script>
        $(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: 'resolve' }); });
    </script>
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this admit card?')) return;

            $.ajax({
                url: '@Url.Action("DeleteAjax", "AdmitCards")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('An error occurred while deleting.');
                }
            });
        }
    </script>
}