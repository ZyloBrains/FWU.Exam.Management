@{
    ViewData["Title"] = "Import Marks from Excel";
    var subjectOfferingId = ViewBag.SubjectOfferingId as int? ?? 0;
    var examScheduleId = ViewBag.ExamScheduleId as int? ?? 0;
    var source = ViewBag.Source as string ?? "standard";
    var returnAction = source == "excel" ? "MarksEntryExcel" : "MarksEntry";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="@returnAction" asp-route-subjectOfferingId="@subjectOfferingId" asp-route-examScheduleId="@examScheduleId"
           class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-file-excel text-green-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Import Marks from Excel</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-2">Instructions</h2>
            <ul class="list-disc list-inside text-sm text-gray-600 space-y-1">
                <li>Download the Excel template from the Marks Entry page first.</li>
                <li>Fill in the marks for each student in the template.</li>
                <li>The Symbol Number column must match the student&apos;s symbol number exactly.</li>
                <li>Marks must be numeric and not exceed the full marks for each subject.</li>
                <li>Upload the filled Excel file below.</li>
            </ul>
        </div>

        <form method="post" asp-action="Import" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="subjectOfferingId" value="@subjectOfferingId" />
            <input type="hidden" name="examScheduleId" value="@examScheduleId" />
            <input type="hidden" name="source" value="@source" />

            <div class="mb-4">
                <label class="text-sm font-medium text-gray-700 block mb-1">Excel File <span class="text-red-500">*</span></label>
                <input type="file" name="excelFile" accept=".xlsx,.xls"
                       class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
            </div>

            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3 mb-4"></div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition shadow-md">
                    <i class="fas fa-upload mr-1"></i> Import
                </button>
                <a asp-action="@returnAction" asp-route-subjectOfferingId="@subjectOfferingId" asp-route-examScheduleId="@examScheduleId"
                   class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
