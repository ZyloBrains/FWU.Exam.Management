@model IEnumerable<FWU.Exam.Management.Application.DTOs.PaymentVerificationListDto>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Payment Verification Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; color: #374151; }
        .exam-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .exam-table th, .exam-table td { border: 1px solid #d1d5db; padding: 8px; font-size: 12px; vertical-align: top; }
        .exam-table th { background: #f3f4f6; }
        .footer { margin-top: 30px; font-size: 11px; color: #6b7280; text-align: center; }
    </style>
</head>
<body>
    <div>
        <h2 style="margin: 0 0 10px 0;">Payment Verification Report</h2>
        <p style="font-size: 12px; color: #6b7280;">Generated on @DateTime.Now.ToString("yyyy-MM-dd hh:mm:ss tt") &mdash; @Model.Count() record(s)</p>
        <table class="exam-table">
            <thead>
                <tr>
                    <th>#</th><th>Voucher Number</th><th>Student Name</th><th>Amount</th><th>Transaction Code</th><th>Payment Gateway</th><th>Voucher Date</th><th>Contact</th><th>College</th><th>Program</th>
                </tr>
            </thead>
            <tbody>
                @{ var counter = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center;">@counter</td>
                        <td>@item.VoucherNumber</td>
                        <td><strong>@item.StudentName</strong></td>
                        <td style="text-align: right;">Rs. @item.Amount.ToString("N2")</td>
                        <td>@(string.IsNullOrEmpty(item.TransactionCode) ? "-" : item.TransactionCode)</td>
                        <td>@(item.PaymentGateway ?? "-")</td>
                        <td>@item.VoucherDate?.ToString("yyyy-MM-dd")</td>
                        <td>@item.ContactNumber</td>
                        <td>@item.College</td>
                        <td>@item.Program</td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: #9ca3af;">
                <p>No payment records found.</p>
            </div>
        }
    </div>

    <script>
        window.onload = function () { window.print(); };
    </script>
</body>
</html>
