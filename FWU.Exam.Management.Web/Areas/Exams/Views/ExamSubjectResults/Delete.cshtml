@model FWU.Exam.Management.Domain.Entities.Exams.ExamSubjectResult

@{
    ViewData["Title"] = "Delete Subject Result";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-check-double text-red-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Delete Subject Result</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">Are you sure you want to delete this subject result?</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Registration</p><p class="text-gray-800 font-medium">Reg #@Model.ExamRegistrationId</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</p><p class="text-gray-800 font-medium">@Model.SubjectOffering?.SubjectCatalog?.SubjectName</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Theory</p><p class="text-gray-800 font-medium">@(Model.ObtainedMarksTheory?.ToString("N2") ?? "-")</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Practical</p><p class="text-gray-800 font-medium">@(Model.ObtainedMarksPractical?.ToString("N2") ?? "-")</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Grade</p><p class="text-gray-800 font-medium">@(Model.GradeLetter ?? "-")</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted</p><p class="text-gray-800 font-medium">@(Model.IsSubmitted ? "Yes" : "No")</p></div>
        </div>

        <form asp-action="Delete" asp-area="Exams" method="post" class="mt-8">
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit" onclick="return confirm('Are you sure?');" class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" asp-area="Exams" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">Cancel</a>
            </div>
        </form>
    </div>
</div>
