@model IEnumerable<FWU.Exam.Management.Domain.Entities.Exams.ExamSubjectResult>

@{
    ViewData["Title"] = "Subject Results";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "Id";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-check-double text-teal-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Subject Results</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage subject-wise exam results.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" asp-area="Exams" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> Create New
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" asp-area="Exams" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by grade, subject, remarks..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
            </div>
            <div>
                <select name="examScheduleId" class="select2 border border-gray-300 rounded-md px-3 py-2.5 text-sm" onchange="this.form.submit()">
                    <option value="">All Schedules</option>
                    @if (ViewData["ExamScheduleId"] is SelectList sl)
                    {
                        foreach (var item in sl.Items as IEnumerable<dynamic>)
                        {
                            <option value="@item.Id" selected="@(item.Id.ToString() == ViewBag.ExamScheduleId?.ToString())">@item.ExamScheduleName</option>
                        }
                    }
                </select>
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors">Search</button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-area="Exams" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                       class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Registration</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Subject</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Exam Type</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Theory</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Practical</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Grade</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Submitted</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-center">Excel</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-800">Reg #@item.ExamRegistrationId</td>
                        <td class="px-4 py-3 text-gray-600">@item.SubjectOffering?.SubjectCatalog?.SubjectName</td>
                        <td class="px-4 py-3 text-gray-600">@item.ExamType?.Name</td>
                        <td class="px-4 py-3 text-gray-600">@(item.ObtainedMarksTheory?.ToString("N2") ?? "-")</td>
                        <td class="px-4 py-3 text-gray-600">@(item.ObtainedMarksPractical?.ToString("N2") ?? "-")</td>
                        <td class="px-4 py-3 font-semibold">@(item.GradeLetter ?? "-")</td>
                        <td class="px-4 py-3">
                            @if (item.IsSubmitted)
                            {
                                <span class="text-green-600"><i class="fas fa-check-circle"></i></span>
                            }
                            else
                            {
                                <span class="text-gray-400"><i class="fas fa-clock"></i></span>
                            }
                        </td>
                        <td class="px-4 py-3 text-center">
                            <a asp-action="MarksEntryExcel" asp-controller="TeacherMarks" asp-area="Exams"
                               asp-route-subjectOfferingId="@item.SubjectOfferingId"
                               asp-route-examScheduleId="@item.ExamScheduleId"
                               class="inline-block p-1.5 text-green-600 hover:bg-green-50 rounded-md transition-colors" title="Open spreadsheet view for this subject">
                                <i class="fas fa-table"></i>
                            </a>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a asp-action="Details" asp-area="Exams" asp-route-id="@item.Id" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                <a asp-action="Edit" asp-area="Exams" asp-route-id="@item.Id" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit">
                                    <i class="fas fa-edit text-xs"></i>
                                </a>
                                <a href="javascript:void(0)" onclick="deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete">
                                    <i class="fas fa-trash text-xs"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <i class="fas fa-check-double text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No subject results found.</p>
            </div>
        }
    </div>

    <div class="lg:hidden space-y-3">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="font-semibold text-gray-800 text-sm">Reg #@item.ExamRegistrationId</h3>
                        <p class="text-xs text-gray-500">@item.SubjectOffering?.SubjectCatalog?.SubjectName</p>
                    </div>
                    <div>@item.ExamType?.Name</div>
                </div>
                <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                    <div class="text-gray-500">Grade</div><div class="text-gray-800 font-semibold">@(item.GradeLetter ?? "-")</div>
                    <div class="text-gray-500">Theory</div><div class="text-gray-800">@(item.ObtainedMarksTheory?.ToString("N2") ?? "-")</div>
                    <div class="text-gray-500">Practical</div><div class="text-gray-800">@(item.ObtainedMarksPractical?.ToString("N2") ?? "-")</div>
                </div>
                <div class="flex items-center gap-2 pt-3 mt-2 border-t border-gray-100">
                    <a asp-action="MarksEntryExcel" asp-controller="TeacherMarks" asp-area="Exams"
                       asp-route-subjectOfferingId="@item.SubjectOfferingId"
                       asp-route-examScheduleId="@item.ExamScheduleId"
                       class="flex-1 text-center py-2 text-xs font-medium text-green-600 bg-green-50 rounded-lg hover:bg-green-100"><i class="fas fa-table mr-1"></i> Excel</a>
                    <a asp-action="Details" asp-area="Exams" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100"><i class="fas fa-eye mr-1"></i> Details</a>
                    <a asp-action="Edit" asp-area="Exams" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100"><i class="fas fa-edit mr-1"></i> Edit</a>
                    <a href="javascript:void(0)" onclick="deleteRecord('@item.Id')" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100"><i class="fas fa-trash mr-1"></i> Delete</a>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-check-double text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No subject results found.</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
            <div class="text-sm text-gray-500 font-medium">
                Showing <span class="font-semibold text-gray-900">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="font-semibold text-gray-900">@(Math.Min(currentPage * pageSize, totalCount))</span> of <span class="font-semibold text-gray-900">@totalCount</span> entries
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-2">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir" asp-route-pageSize="@pageSize" asp-route-examScheduleId="@ViewBag.ExamScheduleId"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        <i class="fas fa-chevron-left text-xs"></i> Previous
                    </a>
                }
                <span class="text-sm font-semibold text-gray-700 min-w-[4rem] text-center">@currentPage / @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir" asp-route-pageSize="@pageSize" asp-route-examScheduleId="@ViewBag.ExamScheduleId"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        Next <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
    </style>
    <script>
        $(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: 'resolve' }); });
    </script>
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "ExamSubjectResults")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}
