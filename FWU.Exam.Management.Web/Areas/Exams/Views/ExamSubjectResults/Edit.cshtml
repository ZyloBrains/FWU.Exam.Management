@model FWU.Exam.Management.Domain.Entities.Exams.ExamSubjectResult

@{
    ViewData["Title"] = "Edit Subject Result";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-check-double text-teal-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Edit Subject Result</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" asp-area="Exams" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="ExamRegistrationId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Registration <span class="text-red-500">*</span></label>
                    <select asp-for="ExamRegistrationId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.ExamRegistrationId"><option value="">-- Select --</option></select>
                </div>
                <div>
                    <label asp-for="SubjectOfferingId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Subject <span class="text-red-500">*</span></label>
                    <select asp-for="SubjectOfferingId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.SubjectOfferingId"><option value="">-- Select --</option></select>
                </div>
                <div>
                    <label asp-for="ExamTypeId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Exam Type <span class="text-red-500">*</span></label>
                    <select asp-for="ExamTypeId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.ExamTypeId"><option value="">-- Select --</option></select>
                </div>
                <div>
                    <label asp-for="ExamScheduleId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Exam Schedule</label>
                    <select asp-for="ExamScheduleId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.ExamScheduleId"><option value="">-- Select --</option></select>
                </div>
                <div>
                    <label asp-for="ObtainedMarksTheory" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Theory Marks</label>
                    <input asp-for="ObtainedMarksTheory" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div>
                    <label asp-for="ObtainedMarksTheoryConfirm" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Theory Marks (Confirm)</label>
                    <input asp-for="ObtainedMarksTheoryConfirm" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div>
                    <label asp-for="ObtainedMarksPractical" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Practical Marks</label>
                    <input asp-for="ObtainedMarksPractical" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div>
                    <label asp-for="ObtainedMarksPracticalConfirm" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Practical Marks (Confirm)</label>
                    <input asp-for="ObtainedMarksPracticalConfirm" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div>
                    <label asp-for="ObtainedMarksTheoryInternal" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Theory Internal</label>
                    <input asp-for="ObtainedMarksTheoryInternal" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div>
                    <label asp-for="ObtainedMarksPracticalInternal" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Practical Internal</label>
                    <input asp-for="ObtainedMarksPracticalInternal" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div>
                    <label asp-for="ObtainedMarks" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Total Marks</label>
                    <input asp-for="ObtainedMarks" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div>
                    <label asp-for="GradeLetter" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Grade Letter</label>
                    <input asp-for="GradeLetter" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Remarks" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Remarks</label>
                    <textarea asp-for="Remarks" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500"></textarea>
                </div>
                <div class="flex items-center gap-3 pt-4">
                    <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-teal-600 rounded focus:ring-teal-500" />
                    <label asp-for="IsActive" class="text-xs sm:text-sm font-medium text-gray-700">Active</label>
                </div>
                <div class="flex items-center gap-3 pt-4">
                    <input asp-for="IsSubmitted" type="checkbox" class="w-4 h-4 text-teal-600 rounded focus:ring-teal-500" />
                    <label asp-for="IsSubmitted" class="text-xs sm:text-sm font-medium text-gray-700">Submitted</label>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-teal-600 text-white text-sm font-semibold rounded-lg hover:bg-teal-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" asp-area="Exams" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="~/lib/select2/css/select2.min.css" asp-append-version="true" rel="stylesheet" />
    <script src="~/lib/select2/js/select2.min.js" asp-append-version="true"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #14b8a6;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(20,184,166,0.2);
        }
    </style>

    <script>
        $(document).ready(function () {
            $('.select2').select2({ width: 'resolve' });
        });
    </script>

    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
