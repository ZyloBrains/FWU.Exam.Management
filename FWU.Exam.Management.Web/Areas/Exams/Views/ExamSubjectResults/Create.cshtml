@model FWU.Exam.Management.Domain.Entities.Exams.ExamSubjectResult

@{
    ViewData["Title"] = "Create Subject Result";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-check-double text-teal-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Subject Result</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" asp-area="Exams" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>

            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Result Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ExamRegistrationId" class="text-sm font-medium text-gray-700 block mb-1">Registration <span class="text-red-500">*</span></label>
                        <select asp-for="ExamRegistrationId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.ExamRegistrationId">
                            <option value="">-- Select Registration --</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="SubjectOfferingId" class="text-sm font-medium text-gray-700 block mb-1">Subject <span class="text-red-500">*</span></label>
                        <select asp-for="SubjectOfferingId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.SubjectOfferingId">
                            <option value="">-- Select Subject --</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ExamTypeId" class="text-sm font-medium text-gray-700 block mb-1">Exam Type <span class="text-red-500">*</span></label>
                        <select asp-for="ExamTypeId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.ExamTypeId">
                            <option value="">-- Select Exam Type --</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ExamScheduleId" class="text-sm font-medium text-gray-700 block mb-1">Exam Schedule</label>
                        <select asp-for="ExamScheduleId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" asp-items="ViewBag.ExamScheduleId">
                            <option value="">-- Select Schedule --</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ObtainedMarksTheory" class="text-sm font-medium text-gray-700 block mb-1">Theory Marks</label>
                        <input asp-for="ObtainedMarksTheory" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div>
                        <label asp-for="ObtainedMarksTheoryConfirm" class="text-sm font-medium text-gray-700 block mb-1">Theory Marks (Confirm)</label>
                        <input asp-for="ObtainedMarksTheoryConfirm" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div>
                        <label asp-for="ObtainedMarksPractical" class="text-sm font-medium text-gray-700 block mb-1">Practical Marks</label>
                        <input asp-for="ObtainedMarksPractical" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div>
                        <label asp-for="ObtainedMarksPracticalConfirm" class="text-sm font-medium text-gray-700 block mb-1">Practical Marks (Confirm)</label>
                        <input asp-for="ObtainedMarksPracticalConfirm" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div>
                        <label asp-for="ObtainedMarksTheoryInternal" class="text-sm font-medium text-gray-700 block mb-1">Theory Internal</label>
                        <input asp-for="ObtainedMarksTheoryInternal" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div>
                        <label asp-for="ObtainedMarksPracticalInternal" class="text-sm font-medium text-gray-700 block mb-1">Practical Internal</label>
                        <input asp-for="ObtainedMarksPracticalInternal" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div>
                        <label asp-for="ObtainedMarks" class="text-sm font-medium text-gray-700 block mb-1">Total Marks</label>
                        <input asp-for="ObtainedMarks" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div>
                        <label asp-for="GradeLetter" class="text-sm font-medium text-gray-700 block mb-1">Grade Letter</label>
                        <input asp-for="GradeLetter" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" />
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="Remarks" class="text-sm font-medium text-gray-700 block mb-1">Remarks</label>
                        <textarea asp-for="Remarks" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500"></textarea>
                    </div>
                    <div class="flex items-center gap-3 pt-4">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-teal-600 rounded focus:ring-teal-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                    <div class="flex items-center gap-3 pt-4">
                        <input asp-for="IsSubmitted" type="checkbox" class="w-4 h-4 text-teal-600 rounded focus:ring-teal-500" />
                        <label asp-for="IsSubmitted" class="text-sm font-medium text-gray-700">Submitted</label>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-teal-600 text-white text-sm font-semibold rounded-lg hover:bg-teal-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" asp-area="Exams" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
