@model IEnumerable<FWU.Exam.Management.Domain.Entities.ResultRecord>

@{
    ViewData["Title"] = "Result Records";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "Id";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-clipboard-check text-emerald-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Result Records</h1>
                <p class="text-sm text-gray-500 mt-0.5">View published result records. (Read-only)</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="ExportToCsv" asp-area="Exams" asp-route-search="@currentSearch" asp-route-collegeId="@ViewBag.CollegeId" asp-route-facultyId="@ViewBag.FacultyId"
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                <i class="fas fa-file-csv text-xs"></i> Export CSV
            </a>
            <a asp-action="ExportToPdf" asp-area="Exams" asp-route-search="@currentSearch" asp-route-collegeId="@ViewBag.CollegeId" asp-route-facultyId="@ViewBag.FacultyId"
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                <i class="fas fa-file-pdf text-xs"></i> Export PDF
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" asp-area="Exams" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by name, symbol no, registration no..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
            <div>
                <select name="collegeId" class="select2 border border-gray-300 rounded-md px-3 py-2.5 text-sm" onchange="this.form.submit()">
                    <option value="">All Colleges</option>
                    @if (ViewData["CollegeId"] is SelectList sl)
                    {
                        foreach (var item in sl.Items as IEnumerable<dynamic>)
                        {
                            <option value="@item.Id" selected="@(item.Id.ToString() == ViewBag.CollegeId?.ToString())">@item.Name</option>
                        }
                    }
                </select>
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors">Search</button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-area="Exams" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                       class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Student</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Symbol No</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Reg No</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">College</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Year/Part</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Total Marks</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">GPA</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Result</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{ var serial = (currentPage - 1) * pageSize; }
                @foreach (var item in Model)
                {
                    serial++;
                    <tr class="hover:bg-gray-50 transition-colors" style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                        <td class="px-4 py-3 text-gray-500">@serial</td>
                        <td class="px-4 py-3 font-medium text-gray-800">@item.StudentName</td>
                        <td class="px-4 py-3 text-gray-600">@item.SymbolNumber</td>
                        <td class="px-4 py-3 text-gray-600">@item.RegistrationNumber</td>
                        <td class="px-4 py-3 text-gray-600">@item.College?.Name</td>
                        <td class="px-4 py-3 text-gray-600">@item.Year / @item.Part</td>
                        <td class="px-4 py-3 text-gray-600">@item.TotalObtainedMarks</td>
                        <td class="px-4 py-3 font-semibold">@item.Gpa</td>
                        <td class="px-4 py-3">@item.Result</td>
                        <td class="px-4 py-3 text-right">
                            <a asp-action="Details" asp-area="Exams" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details">
                                <i class="fas fa-eye text-xs"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <i class="fas fa-clipboard-check text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No result records match your criteria.</p>
            </div>
        }
    </div>

    <div class="lg:hidden space-y-3">
        @{ var serialMobile = (currentPage - 1) * pageSize; }
        @foreach (var item in Model)
        {
            serialMobile++;
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="font-semibold text-gray-800 text-sm">@item.StudentName</h3>
                        <p class="text-xs text-gray-500">@item.SymbolNumber</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-semibold">@item.Gpa</p>
                        <p class="text-xs text-gray-500">@item.Result</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                    <div class="text-gray-500">College</div><div class="text-gray-800">@item.College?.Name</div>
                    <div class="text-gray-500">Year/Part</div><div class="text-gray-800">@item.Year / @item.Part</div>
                    <div class="text-gray-500">Total</div><div class="text-gray-800">@item.TotalObtainedMarks</div>
                </div>
                <a asp-action="Details" asp-area="Exams" asp-route-id="@item.Id"
                   class="block mt-3 py-2 text-center text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                    <i class="fas fa-eye mr-1"></i> Details
                </a>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-clipboard-check text-4xl text-gray-300 mb-4"></i>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">No records found</h3>
                <p class="text-sm text-gray-500">No result records match your criteria.</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
            <div class="text-sm text-gray-500 font-medium">
                Showing <span class="font-semibold text-gray-900">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="font-semibold text-gray-900">@(Math.Min(currentPage * pageSize, totalCount))</span> of <span class="font-semibold text-gray-900">@totalCount</span> entries
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-2">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir" asp-route-pageSize="@pageSize" asp-route-collegeId="@ViewBag.CollegeId" asp-route-facultyId="@ViewBag.FacultyId"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        <i class="fas fa-chevron-left text-xs"></i> Previous
                    </a>
                }
                <span class="text-sm font-semibold text-gray-700 min-w-[4rem] text-center">@currentPage / @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir" asp-route-pageSize="@pageSize" asp-route-collegeId="@ViewBag.CollegeId" asp-route-facultyId="@ViewBag.FacultyId"
                       class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        Next <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
    </style>
    <script>
        $(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: 'resolve' }); });
    </script>
}
