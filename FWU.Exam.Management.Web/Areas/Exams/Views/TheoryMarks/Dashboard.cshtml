@model TheoryMarksPageViewModel

@{
    ViewData["Title"] = "Theory Marks Entry";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-pen-alt text-teal-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Theory Marks Entry</h1>
            <p class="text-xs text-gray-500 mt-0.5">Select the exam schedule and subject to enter theory marks.</p>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
            <div id="facultyFilterGroup" class="@(Model.IsSuperAdmin ? "" : "hidden")">
                <label class="block text-xs font-semibold text-gray-600 mb-1">Faculty</label>
                <select id="FacultyId" class="select2 w-full">
                    <option value="">-- Select Faculty --</option>
                    @foreach (var item in Model.Faculties)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>

            <div id="collegeFilterGroup" class="@(Model.IsSuperAdmin || Model.IsFacultyAdmin ? "" : "hidden")">
                <label class="block text-xs font-semibold text-gray-600 mb-1">College</label>
                <select id="CollegeId" class="select2 w-full" @(Model.IsSuperAdmin ? "disabled" : "")>
                    <option value="">-- Select College --</option>
                    @foreach (var item in Model.Colleges)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Academic Year</label>
                <select id="AcademicYearId" class="select2 w-full" disabled>
                    <option value="">-- Select Academic Year --</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Level</label>
                <select id="LevelId" class="select2 w-full" disabled>
                    <option value="">-- Select Level --</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Exam Schedule</label>
                <select id="ExamScheduleId" class="select2 w-full" disabled>
                    <option value="">-- Select Exam Schedule --</option>
                </select>
            </div>
        </div>
    </div>

    <div id="scheduleDetailSection" class="hidden">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900 mb-3">Exam Schedule Details</h3>
            <dl class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 text-sm">
                <div>
                    <dt class="text-xs text-gray-500">Academic Year</dt>
                    <dd id="schAcademicYear" class="font-medium text-gray-800">-</dd>
                </div>
                <div>
                    <dt class="text-xs text-gray-500">Level</dt>
                    <dd id="schLevel" class="font-medium text-gray-800">-</dd>
                </div>
                <div>
                    <dt class="text-xs text-gray-500">Program</dt>
                    <dd id="schProgram" class="font-medium text-gray-800">-</dd>
                </div>
                <div>
                    <dt class="text-xs text-gray-500">Semester</dt>
                    <dd id="schSemester" class="font-medium text-gray-800">-</dd>
                </div>
                <div>
                    <dt class="text-xs text-gray-500">Exam Type</dt>
                    <dd id="schExamType" class="font-medium text-gray-800">-</dd>
                </div>
            </dl>
        </div>
    </div>

    <div id="subjectSection" class="hidden">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <label class="block text-xs font-semibold text-gray-600 mb-1">Subject</label>
            <select id="SubjectOfferingId" class="select2 w-full" disabled>
                <option value="">-- Select Subject --</option>
            </select>
        </div>
    </div>

    <div id="subjectDetailSection" class="hidden">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-start justify-between">
                <div>
                    <h3 id="subjName" class="font-semibold text-gray-900">-</h3>
                    <p id="subjCode" class="text-xs text-gray-500 mt-0.5">-</p>
                </div>
                <span id="subjTheory" class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full font-medium">-</span>
            </div>
            <p class="text-xs text-gray-500 mt-3">
                Theory Full Marks: <span id="subjTheoryFull" class="font-semibold text-gray-700">-</span>
                <span class="mx-1">|</span> Theory Pass Marks: <span id="subjTheoryPass" class="font-semibold text-gray-700">-</span>
            </p>
        </div>
    </div>

    <div id="studentsSection" class="hidden">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="p-5 flex flex-wrap items-center justify-between gap-3 border-b border-gray-100">
                <div>
                    <h3 class="font-semibold text-gray-900">Students</h3>
                    <p class="text-xs text-gray-500" id="studentCount">0 students</p>
                </div>
                <div class="flex gap-2">
                    <button type="button" id="btnSave"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors">
                        <i class="fas fa-save"></i> Save Theory Marks
                    </button>
                    <button type="button" id="btnSubmitAll"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-check-double"></i> Submit All
                    </button>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">S.N</th>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Registration Number</th>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Symbol No.</th>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Theory Marks</th>
                            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Submit</th>
                        </tr>
                    </thead>
                    <tbody id="studentsTableBody" class="divide-y divide-gray-100"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var isSuperAdmin = @(Model.IsSuperAdmin ? "true" : "false");
        var isFacultyAdmin = @(Model.IsFacultyAdmin ? "true" : "false");

        function populateSelect(sel, options, placeholder, enabled) {
            if (sel.data('select2')) sel.select2('destroy');
            sel.empty().append('<option value="">' + placeholder + '</option>');
            $.each(options, function (i, o) {
                sel.append('<option value="' + o.id + '">' + o.name + '</option>');
            });
            sel.prop('disabled', !enabled);
            sel.select2({ width: 'resolve' });
        }

        function clearSelect(sel, placeholder) {
            populateSelect(sel, [], placeholder, false);
        }

        function getCollegeId() { return $('#CollegeId').val(); }

        function resetSubjectAndStudents() {
            $('#subjectDetailSection').addClass('hidden');
            $('#studentsSection').addClass('hidden');
            $('#studentsTableBody').empty();
            $('#subjectSection').addClass('hidden');
            clearSelect($('#SubjectOfferingId'), '-- Select Subject --');
        }

        function resetLevelsAndBelow() {
            $('#scheduleDetailSection').addClass('hidden');
            resetSubjectAndStudents();
            clearSelect($('#LevelId'), '-- Select Level --');
            clearSelect($('#ExamScheduleId'), '-- Select Exam Schedule --');
        }

        function loadColleges(facultyId) {
            var sel = $('#CollegeId');
            if (!facultyId) { clearSelect(sel, '-- Select College --'); return; }
            $.get(tenantUrl('/Exams/TheoryMarks/GetColleges'), { facultyId: facultyId }, function (data) {
                populateSelect(sel, data, '-- Select College --', true);
            });
        }

        function loadAcademicYears(collegeId) {
            var sel = $('#AcademicYearId');
            if (!collegeId) { clearSelect(sel, '-- Select Academic Year --'); return; }
            $.get(tenantUrl('/Exams/TheoryMarks/GetAcademicYears'), { collegeId: collegeId }, function (data) {
                populateSelect(sel, data, '-- Select Academic Year --', true);
            });
        }

        function loadLevels(collegeId, academicYearId) {
            var sel = $('#LevelId');
            if (!collegeId || !academicYearId) { clearSelect(sel, '-- Select Level --'); return; }
            $.get(tenantUrl('/Exams/TheoryMarks/GetLevels'), { collegeId: collegeId, academicYearId: academicYearId }, function (data) {
                populateSelect(sel, data, '-- Select Level --', true);
            });
        }

        function loadSchedules(collegeId, academicYearId, levelId) {
            var sel = $('#ExamScheduleId');
            if (!collegeId || !academicYearId || !levelId) { clearSelect(sel, '-- Select Exam Schedule --'); return; }
            $.get(tenantUrl('/Exams/TheoryMarks/GetExamSchedules'), { collegeId: collegeId, academicYearId: academicYearId, levelId: levelId }, function (data) {
                populateSelect(sel, data, '-- Select Exam Schedule --', true);
            });
        }

        function loadScheduleDetail(scheduleId) {
            $.get(tenantUrl('/Exams/TheoryMarks/GetScheduleDetail'), { examScheduleId: scheduleId, collegeId: getCollegeId() }, function (data) {
                if (!data) return;
                $('#schAcademicYear').text(data.academicYearName);
                $('#schLevel').text(data.levelName);
                $('#schProgram').text(data.programName);
                $('#schSemester').text(data.semesterName);
                $('#schExamType').text(data.examTypeName);
                $('#scheduleDetailSection').removeClass('hidden');
            });
        }

        function loadSubjects(scheduleId) {
            $.get(tenantUrl('/Exams/TheoryMarks/GetSubjects'), { examScheduleId: scheduleId, collegeId: getCollegeId() }, function (data) {
                var sel = $('#SubjectOfferingId');
                var mapped = $.map(data, function (s) {
                    return { id: s.id, name: s.name + (s.code ? ' (' + s.code + ')' : '') };
                });
                if (mapped.length === 0) {
                    alert('No subjects found for this exam schedule.');
                    return;
                }
                populateSelect(sel, mapped, '-- Select Subject --', true);
                $('#subjectSection').removeClass('hidden');
            });
        }

        function loadSubjectDetail(subjectId) {
            $.get(tenantUrl('/Exams/TheoryMarks/GetSubjectDetail'), { subjectOfferingId: subjectId, collegeId: getCollegeId() }, function (data) {
                if (!data) return;
                $('#subjName').text(data.name);
                $('#subjCode').text('Subject Code: ' + data.code);
                $('#subjTheory').text(data.hasTheory ? 'Has Theory: Yes' : 'Has Theory: No');
                $('#subjTheoryFull').text(data.theoryFullMarks != null ? data.theoryFullMarks : '-');
                $('#subjTheoryPass').text(data.theoryPassMarks != null ? data.theoryPassMarks : '-');
                $('#subjectDetailSection').removeClass('hidden');
            });
        }

        function loadStudents(subjectId) {
            $.get(tenantUrl('/Exams/TheoryMarks/GetStudents'), {
                examScheduleId: $('#ExamScheduleId').val(),
                subjectOfferingId: subjectId,
                collegeId: getCollegeId()
            }, function (data) {
                if (!data) return;
                renderStudents(data);
                $('#studentsSection').removeClass('hidden');
            });
        }

        function renderStudents(data) {
            var theoryMax = data.theoryFullMarks;
            var tbody = $('#studentsTableBody');
            tbody.empty();

            $.each(data.students, function (i, s) {
                var tr = $('<tr></tr>');
                tr.append('<td class="px-4 py-2.5 text-gray-500">' + (i + 1) + '</td>');
                tr.append('<td class="px-4 py-2.5 font-medium text-gray-800">' + (s.registrationNumber || '-') + '</td>');
                tr.append('<td class="px-4 py-2.5 text-gray-700">' + (s.symbolNumber || '-') + '</td>');

                var td = $('<td class="px-4 py-2.5"></td>');
                var wrap = $('<div class="flex items-start gap-3"></div>');
                wrap.append(buildTheoryField('Theory', s.theory, theoryMax));
                td.append(wrap);
                tr.append(td);

                var submitTd = $('<td class="px-4 py-2.5"></td>');
                var checkbox = $('<input type="checkbox" class="submit-check rounded border-gray-300 text-teal-600 focus:ring-teal-500">');
                if (s.isSubmitted) {
                    checkbox.prop('checked', true);
                    checkbox.prop('disabled', true);
                }
                submitTd.append(checkbox);
                tr.append(submitTd);

                tr.data('examRegistrationId', s.examRegistrationId);
                tr.data('examSubjectResultId', s.examSubjectResultId || null);
                tbody.append(tr);
            });

            $('#studentCount').text(data.students.length + ' student(s)');
        }

        function buildTheoryField(label, value, max) {
            var box = $('<div></div>');
            box.append('<span class="block text-[10px] text-gray-400 mb-0.5">' + label + '</span>');
            var input = $('<input type="number" step="0.5" min="0" class="w-24 px-2 py-1.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 theory-input">');
            input.attr('data-max', max != null ? max : '');
            input.attr('data-col', label.toLowerCase());
            if (max != null) input.attr('max', max);
            if (value != null) input.val(value);
            box.append(input);
            return box;
        }

        function nextTheoryField(current) {
            var $row = $(current).closest('tr');
            var $inputs = $row.find('.theory-input');
            var idx = $inputs.index(current);
            if (idx < $inputs.length - 1) return $inputs.eq(idx + 1);
            var $nextRow = $row.next('tr');
            if ($nextRow.length) return $nextRow.find('.theory-input').first();
            return null;
        }

        function validateInput(el) {
            var max = parseFloat($(el).attr('data-max'));
            var val = parseFloat(el.value);
            if (max && !isNaN(val) && val > max) {
                $(el).removeClass('border-gray-300').addClass('border-red-500');
                $(el).attr('data-invalid', 'true');
            } else {
                $(el).removeClass('border-red-500').addClass('border-gray-300');
                $(el).attr('data-invalid', 'false');
            }
        }

        function collectRows() {
            var rows = [];
            $('#studentsTableBody tr').each(function () {
                var $row = $(this);
                var theoryVal = $row.find('.theory-input[data-col="theory"]').val();
                rows.push({
                    ExamRegistrationId: $row.data('examRegistrationId'),
                    ExamSubjectResultId: $row.data('examSubjectResultId'),
                    Theory: theoryVal !== '' ? theoryVal : null,
                    IsSubmitted: $row.find('.submit-check').is(':checked')
                });
            });
            return rows;
        }

        function submitSave(submitAll) {
            var payload = {
                CollegeId: parseInt(getCollegeId()),
                ExamScheduleId: parseInt($('#ExamScheduleId').val()),
                SubjectOfferingId: parseInt($('#SubjectOfferingId').val()),
                SubmitAll: submitAll,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                Students: collectRows()
            };

            if (!payload.CollegeId || !payload.ExamScheduleId || !payload.SubjectOfferingId) {
                alert('Please select the exam schedule and subject first.');
                return;
            }

            if ($('#studentsTableBody .theory-input[data-invalid="true"]').length > 0) {
                alert('Some theory marks exceed the full marks. Please correct them before saving.');
                return;
            }

            $.post(tenantUrl('/Exams/TheoryMarks/SaveTheoryMarks'), payload, function (res) {
                if (res.success) {
                    alert(res.message);
                    loadStudents($('#SubjectOfferingId').val());
                } else {
                    alert(res.message);
                }
            }).fail(function () {
                alert('Save failed. Please try again.');
            });
        }

        $(function () {
            if (isFacultyAdmin) {
                $('#CollegeId').prop('disabled', false);
            }

            $('.select2').select2({ width: 'resolve' });

            $('#FacultyId').on('change', function () {
                loadColleges($(this).val());
                clearSelect($('#AcademicYearId'), '-- Select Academic Year --');
                resetLevelsAndBelow();
            });

            $('#CollegeId').on('change', function () {
                loadAcademicYears($(this).val());
                resetLevelsAndBelow();
            });

            $('#AcademicYearId').on('change', function () {
                loadLevels(getCollegeId(), $(this).val());
                resetLevelsAndBelow();
            });

            $('#LevelId').on('change', function () {
                loadSchedules(getCollegeId(), $('#AcademicYearId').val(), $(this).val());
                resetLevelsAndBelow();
            });

            $('#ExamScheduleId').on('change', function () {
                var scheduleId = $(this).val();
                resetSubjectAndStudents();
                if (!scheduleId) {
                    $('#scheduleDetailSection').addClass('hidden');
                    return;
                }
                loadScheduleDetail(scheduleId);
                loadSubjects(scheduleId);
            });

            $('#SubjectOfferingId').on('change', function () {
                var subjectId = $(this).val();
                $('#subjectDetailSection').addClass('hidden');
                $('#studentsSection').addClass('hidden');
                if (!subjectId) return;
                loadSubjectDetail(subjectId);
                loadStudents(subjectId);
            });

            $(document).on('input', '.theory-input', function () {
                validateInput(this);
                if (this.value.length >= 2) {
                    var next = nextTheoryField(this);
                    if (next) next.focus();
                }
            });

            $(document).on('keydown', '.theory-input', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var next = nextTheoryField(this);
                    if (next) next.focus();
                }
            });

            $(document).on('change', '.theory-input', function () { validateInput(this); });

            $('#btnSave').on('click', function () { submitSave(false); });
            $('#btnSubmitAll').on('click', function () { submitSave(true); });
        });
    </script>
}
