@model InternalMarksSearchResultDto

@{
    ViewData["Title"] = "Internal Marks";
    var isSearchResult = Model?.Students != null && Model.Students.Any();
}

<div class="space-y-6">
    @await Html.PartialAsync("_AlertMessages")

    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-clipboard-check text-teal-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Internal Marks</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form method="post" asp-action="Search" id="internalMarksForm">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">Academic Year</label>
                    <input type="text" readonly
                           value="@(isSearchResult ? Model!.AcademicYearDisplay : $"{ViewBag.AcademicYearCode} ( {ViewBag.AcademicYearName} )")"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-gray-50 text-gray-600 cursor-not-allowed" />
                    <input type="hidden" name="AcademicYearId" id="AcademicYearId" value="@(isSearchResult ? Model!.AcademicYearId : ViewBag.CurrentAcademicYearId)" />
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">Exam Schedule</label>
                    <input type="text" readonly id="examScheduleDisplay"
                           value="@(isSearchResult ? Model!.ExamScheduleDisplay : "")"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-gray-50 text-gray-600 cursor-not-allowed" />
                    <input type="hidden" name="ExamScheduleId" id="ExamScheduleId" value="@(isSearchResult ? Model!.ExamScheduleId : 0)" />
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">College</label>
                    <input type="text" readonly
                           value="@(ViewBag.CollegeName) ( @ViewBag.CollegeCode )"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-gray-50 text-gray-600 cursor-not-allowed" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-5 gap-5 mb-6">
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">Level</label>
                    <select name="LevelId" id="LevelId" class="select2 w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm">
                        <option value="">Select Level</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">Program</label>
                    <select name="ProgramId" id="ProgramId" class="select2 w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm" disabled>
                        <option value="">Select Program</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">Year Part</label>
                    <select name="SemesterId" id="SemesterId" class="select2 w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm" disabled>
                        <option value="">Select Year Part</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">Exam Type</label>
                    <select name="ExamTypeId" id="ExamTypeId" class="select2 w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm" disabled>
                        <option value="">Select Exam Type</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-1">Subject</label>
                    <select name="SubjectOfferingId" id="SubjectOfferingId" class="select2 w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm" disabled>
                        <option value="">Select Subject</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-center">
                <button type="submit" id="searchBtn"
                        class="px-8 py-2.5 bg-teal-600 text-white text-sm font-semibold rounded-lg hover:bg-teal-700 transition shadow-md"
                        disabled>
                    <i class="fas fa-search mr-1.5"></i> Search
                </button>
            </div>
        </form>
    </div>

    @if (isSearchResult)
    {
        <form method="post" asp-action="Save" id="saveForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SubjectOfferingId" value="@Model!.SubjectOfferingId" />
            <input type="hidden" name="ExamScheduleId" value="@Model.ExamScheduleId" />

            <div class="flex flex-col lg:flex-row gap-6">
                <div class="flex-1">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">S.No.</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Registration No</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Name</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Roll No</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-32">Internal Marks</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @for (int i = 0; i < Model.Students.Count; i++)
                                {
                                    var s = Model.Students[i];
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-3 text-gray-500">@(i + 1)</td>
                                        <td class="px-4 py-3 text-gray-600 text-xs">@s.RegistrationNumber</td>
                                        <td class="px-4 py-3 font-medium text-gray-800 text-sm">@s.StudentName</td>
                                        <td class="px-4 py-3 text-gray-600 text-xs">@s.SymbolNumber</td>
                                        <td class="px-4 py-3">
                                            <input type="hidden" name="Students[@i].ExamRegistrationId" value="@s.ExamRegistrationId" />
                                            <input type="hidden" name="Students[@i].ExamSubjectResultId" value="@(s.ExamSubjectResultId ?? 0)" />
                                            <input type="number" name="Students[@i].TheoryInternal" value="@s.TheoryInternal?.ToString("F1")" step="0.1"
                                                   class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-teal-500" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="flex items-center justify-between gap-4 pt-4 mt-4 border-t border-gray-200">
                        <div class="text-sm text-gray-500">
                            <span class="font-semibold text-gray-800">@Model.Students.Count</span> students
                        </div>
                        <div class="flex items-center gap-3">
                            <button type="button" onclick="document.getElementById('saveForm').querySelector('input[name=SubmitAll]').value='false'; document.getElementById('saveForm').submit();"
                                    class="px-6 py-2.5 bg-gray-600 text-white text-sm font-semibold rounded-lg hover:bg-gray-700 transition shadow-md">
                                <i class="fas fa-save mr-1"></i> Save Draft
                            </button>
                            <button type="button" onclick="if(confirm('Submit marks for ALL students? This will finalize the entries.')){ document.getElementById('saveForm').querySelector('input[name=SubmitAll]').value='true'; document.getElementById('saveForm').submit(); }"
                                    class="px-6 py-2.5 bg-teal-600 text-white text-sm font-semibold rounded-lg hover:bg-teal-700 transition shadow-md">
                                <i class="fas fa-check-double mr-1"></i> Submit All
                            </button>
                        </div>
                    </div>
                    <input type="hidden" name="SubmitAll" value="false" />
                </div>

                <div class="w-full lg:w-72 shrink-0">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                        <h3 class="text-sm font-semibold text-gray-800 mb-3 border-b border-gray-100 pb-2">Subject Information</h3>
                        <div class="space-y-2.5 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Subject Name:</span>
                                <span class="text-gray-800 font-medium text-right max-w-[150px]">@Model.SubjectName</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Subject Code:</span>
                                <span class="text-gray-800 font-medium">@Model.SubjectCode</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Has Practical:</span>
                                <span class="text-gray-800 font-medium">@Model.HasPractical.ToString().ToLower()</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Internal Theory Full Mar...</span>
                                <span class="text-gray-800 font-medium">@Model.InternalTheoryFullMarks</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Internal Theory Pass Ma...</span>
                                <span class="text-gray-800 font-medium">@Model.InternalTheoryPassMarks</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Internal Practical Full Ma...</span>
                                <span class="text-gray-800 font-medium">@Model.InternalPracticalFullMarks</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Internal Practical Pass M...</span>
                                <span class="text-gray-800 font-medium">@Model.InternalPracticalPassMarks</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.5rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
    </style>

    <script>
        var currentAcademicYearId = '@ViewBag.CurrentAcademicYearId';

        $(function () {
            loadLevels();
            $('.select2').select2({ width: 'resolve', minimumResultsForSearch: 0 });
        });

        function loadLevels() {
            $.get(tenantUrl('/Exams/InternalMarks/GetLevels'), function (data) {
                var ddl = $('#LevelId');
                ddl.empty().append('<option value="">Select Level</option>');
                $.each(data, function (i, item) {
                    ddl.append('<option value="' + item.id + '">' + item.levelName + '</option>');
                });
                ddl.select2('destroy').select2({ width: 'resolve', minimumResultsForSearch: 0 });
                @if (isSearchResult)
                {
                    <text>
                    ddl.val('@Model!.LevelId').trigger('change');
                    </text>
                }
            });
        }

        function resetDropdown(selector, placeholder) {
            $(selector).select2('destroy');
            $(selector).empty().append('<option value="">' + placeholder + '</option>');
            $(selector).prop('disabled', true);
            $(selector).select2({ width: 'resolve', minimumResultsForSearch: 0 });
        }

        function enableDropdown(selector) {
            $(selector).prop('disabled', false);
            $(selector).select2('destroy');
            $(selector).select2({ width: 'resolve', minimumResultsForSearch: 0 });
        }

        function checkSearchReady() {
            var level = $('#LevelId').val();
            var program = $('#ProgramId').val();
            var semester = $('#SemesterId').val();
            var examType = $('#ExamTypeId').val();
            var subject = $('#SubjectOfferingId').val();
            var scheduleId = $('#ExamScheduleId').val();

            if (level && program && semester && examType && subject && scheduleId && scheduleId !== '0') {
                $('#searchBtn').prop('disabled', false);
            } else {
                $('#searchBtn').prop('disabled', true);
            }
        }

        $('#LevelId').on('change', function () {
            var levelId = $(this).val();
            resetDropdown('#ProgramId', 'Select Program');
            resetDropdown('#SemesterId', 'Select Year Part');
            resetDropdown('#ExamTypeId', 'Select Exam Type');
            resetDropdown('#SubjectOfferingId', 'Select Subject');
            $('#examScheduleDisplay').val('');
            $('#ExamScheduleId').val(0);
            checkSearchReady();

            if (!levelId) return;

            $.get(tenantUrl('/Exams/InternalMarks/GetPrograms'), { levelId: levelId }, function (data) {
                var ddl = $('#ProgramId');
                ddl.empty().append('<option value="">Select Program</option>');
                $.each(data, function (i, item) {
                    ddl.append('<option value="' + item.id + '">' + item.name + '</option>');
                });
                enableDropdown('#ProgramId');
                @if (isSearchResult)
                {
                    <text>
                    ddl.val('@Model!.ProgramId').trigger('change');
                    </text>
                }
            });
        });

        $('#ProgramId').on('change', function () {
            var programId = $(this).val();
            resetDropdown('#SemesterId', 'Select Year Part');
            resetDropdown('#ExamTypeId', 'Select Exam Type');
            resetDropdown('#SubjectOfferingId', 'Select Subject');
            $('#examScheduleDisplay').val('');
            $('#ExamScheduleId').val(0);
            checkSearchReady();

            if (!programId) return;

            $.get(tenantUrl('/Exams/InternalMarks/GetSemesters'), { programId: programId }, function (data) {
                var ddl = $('#SemesterId');
                ddl.empty().append('<option value="">Select Year Part</option>');
                $.each(data, function (i, item) {
                    ddl.append('<option value="' + item.id + '">' + item.name + '</option>');
                });
                enableDropdown('#SemesterId');
                @if (isSearchResult)
                {
                    <text>
                    ddl.val('@Model!.SemesterId').trigger('change');
                    </text>
                }
            });
        });

        $('#SemesterId').on('change', function () {
            var programId = $('#ProgramId').val();
            var semesterId = $(this).val();
            resetDropdown('#ExamTypeId', 'Select Exam Type');
            resetDropdown('#SubjectOfferingId', 'Select Subject');
            $('#examScheduleDisplay').val('');
            $('#ExamScheduleId').val(0);
            checkSearchReady();

            if (!programId || !semesterId) return;

            $.get(tenantUrl('/Exams/InternalMarks/GetExamTypes'), { programId: programId, semesterId: semesterId }, function (data) {
                var ddl = $('#ExamTypeId');
                ddl.empty().append('<option value="">Select Exam Type</option>');
                $.each(data, function (i, item) {
                    ddl.append('<option value="' + item.id + '">' + item.name + '</option>');
                });
                enableDropdown('#ExamTypeId');
                @if (isSearchResult)
                {
                    <text>
                    ddl.val('@Model!.ExamTypeId').trigger('change');
                    </text>
                }
            });
        });

        $('#ExamTypeId').on('change', function () {
            var programId = $('#ProgramId').val();
            var semesterId = $('#SemesterId').val();
            var examTypeId = $(this).val();
            resetDropdown('#SubjectOfferingId', 'Select Subject');
            $('#examScheduleDisplay').val('');
            $('#ExamScheduleId').val(0);
            checkSearchReady();

            if (!programId || !semesterId) return;

            $.get(tenantUrl('/Exams/InternalMarks/GetSubjects'), { programId: programId, semesterId: semesterId }, function (data) {
                var ddl = $('#SubjectOfferingId');
                ddl.empty().append('<option value="">Select Subject</option>');
                $.each(data, function (i, item) {
                    ddl.append('<option value="' + item.id + '">' + item.code + ' - ' + item.name + '</option>');
                });
                enableDropdown('#SubjectOfferingId');
                @if (isSearchResult)
                {
                    <text>
                    ddl.val('@Model!.SubjectOfferingId').trigger('change');
                    </text>
                }
            });

            $.get(tenantUrl('/Exams/InternalMarks/GetExamSchedule'), { programId: programId, semesterId: semesterId, examTypeId: examTypeId }, function (data) {
                if (data.found) {
                    $('#examScheduleDisplay').val(data.scheduleName);
                    $('#ExamScheduleId').val(data.scheduleId);
                    $('#AcademicYearId').val(data.academicYearId);
                } else {
                    $('#examScheduleDisplay').val('No schedule found');
                    $('#ExamScheduleId').val(0);
                }
                checkSearchReady();
            });
        });

        $('#SubjectOfferingId').on('change', function () {
            checkSearchReady();
        });
    </script>
}
