@model ExamCenter
@using FWU.Exam.Management.Domain.Entities.Colleges

@{
    ViewData["Title"] = "Create Exam Center";
    var venueCollegeList = ViewData["VenueCollegeList"] as List<College> ?? [];
    var sourceCollegeList = ViewData["SourceCollegeList"] as List<College> ?? [];
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors shrink-0">
                <i class="fas fa-arrow-left text-gray-600"></i>
            </a>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center shrink-0">
                    <i class="fas fa-map-marker-alt text-orange-600"></i>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Create Exam Center</h1>
                    <p class="text-sm text-gray-500 mt-0.5">Assign colleges as exam venues for a schedule.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6 lg:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
                <div>
                    <label asp-for="Code" class="text-sm font-medium text-gray-700">Code <span class="text-red-500">*</span></label>
                    <input asp-for="Code" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" placeholder="Enter center code" />
                    <span asp-validation-for="Code" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ExamScheduleId" class="text-sm font-medium text-gray-700">Exam Schedule <span class="text-red-500">*</span></label>
                    <select asp-for="ExamScheduleId" asp-items="@ViewData["ExamScheduleId"] as SelectList" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
                        <option value="">-- Select Schedule --</option>
                    </select>
                    <span asp-validation-for="ExamScheduleId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Remark" class="text-sm font-medium text-gray-700">Remark</label>
                    <input asp-for="Remark" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" placeholder="Optional remark" />
                    <span asp-validation-for="Remark" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="flex items-center gap-3 pt-6">
                    <input asp-for="IsActive" class="w-4 h-4 text-orange-600 border-gray-300 rounded focus:ring-orange-500" />
                    <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Is Active</label>
                </div>
            </div>

            <div class="border-t border-gray-200 pt-4">
                <label class="text-sm font-medium text-gray-700 block mb-2">
                    Venue Colleges <span class="text-red-500">*</span>
                </label>
                <p class="text-xs text-gray-500 mb-3">Select the colleges where exams will be conducted. Only colleges marked as exam centers are shown.</p>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 max-h-60 overflow-y-auto p-3 border border-gray-200 rounded-lg bg-gray-50">
                    @if (venueCollegeList.Count == 0)
                    {
                        <p class="text-sm text-gray-400 col-span-full">No exam-center colleges found. Mark a college as "Is Exam Center Only" first.</p>
                    }
                    @foreach (var college in venueCollegeList)
                    {
                        <label class="flex items-center gap-2 p-2 rounded hover:bg-white cursor-pointer">
                            <input type="checkbox" name="venueColleges" value="@college.Id"
                                   class="w-4 h-4 text-orange-600 border-gray-300 rounded focus:ring-orange-500" />
                            <span class="text-sm text-gray-700">@college.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div class="border-t border-gray-200 pt-4">
                <label class="text-sm font-medium text-gray-700 block mb-2">
                    Serves Students From Colleges
                </label>
                <p class="text-xs text-gray-500 mb-3">Select which colleges' students will take exams at this center. If none selected, all colleges are eligible.</p>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 max-h-60 overflow-y-auto p-3 border border-gray-200 rounded-lg bg-gray-50">
                    @foreach (var college in sourceCollegeList)
                    {
                        <label class="flex items-center gap-2 p-2 rounded hover:bg-white cursor-pointer">
                            <input type="checkbox" name="sourceColleges" value="@college.Id"
                                   class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                            <span class="text-sm text-gray-700">@college.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center gap-3 pt-4 border-t border-gray-200">
                <a asp-action="Index" class="flex-1 sm:flex-none text-center px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-sm">
                    Cancel
                </a>
                <button type="submit" class="flex-1 sm:flex-none text-center px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-sm">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #f97316;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(249,115,22,0.2);
        }
    </style>

    <script>
        $(document).ready(function () {
            $('.select2').select2();
        });
    </script>

    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
