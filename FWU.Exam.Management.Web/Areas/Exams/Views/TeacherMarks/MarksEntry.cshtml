@model MarksEntryViewModel
@{
    ViewData["Title"] = "Marks Entry - " + Model.SubjectName;
    var passMarkStyle = "color: #059669; font-weight: 600;";
    var failMarkStyle = "color: #dc2626; font-weight: 600;";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <a asp-action="Dashboard" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
                <i class="fas fa-arrow-left text-gray-600"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">@Model.SubjectName</h1>
                <p class="text-sm text-gray-500">
                    Theory: @Model.TheoryFullMarks marks | Pass: @Model.TheoryPassMarks
                    @if (Model.HasPractical) {
                        <span class="ml-2">Practical: @Model.PracticalFullMarks marks | Pass: @Model.PracticalPassMarks</span>
                    }
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="MarksEntryExcel" asp-route-subjectOfferingId="@Model.SubjectOfferingId" asp-route-examScheduleId="@Model.ExamScheduleId"
               class="px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors">
                <i class="fas fa-table mr-1"></i> Excel View
            </a>
            <a asp-action="ExportTemplate" asp-route-subjectOfferingId="@Model.SubjectOfferingId" asp-route-examScheduleId="@Model.ExamScheduleId"
               class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                <i class="fas fa-download mr-1"></i> Download Template
            </a>
            <a asp-action="Import" asp-route-subjectOfferingId="@Model.SubjectOfferingId" asp-route-examScheduleId="@Model.ExamScheduleId"
               class="px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors">
                <i class="fas fa-upload mr-1"></i> Import Excel
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">@TempData["Error"]</div>
    }

    <form method="post" asp-action="MarksEntry" x-data="marksEntry()" @@submit.prevent="submitForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SubjectOfferingId" value="@Model.SubjectOfferingId" />
        <input type="hidden" name="ExamScheduleId" value="@Model.ExamScheduleId" />

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-10">#</th>
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase min-w-[160px]">Student</th>
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-24">Symbol No.</th>
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-28">Reg No.</th>
                        @if (Model.HasTheory)
                        {
                            <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-20">Theory (@Model.TheoryFullMarks)</th>
                            <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-20">Theory (Confirm)</th>
                        }
                        @if (Model.HasPractical)
                        {
                            <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-20">Practical (@Model.PracticalFullMarks)</th>
                            <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-20">Practical (Confirm)</th>
                        }
                        @if (Model.HasInternal)
                        {
                            <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-20">Theory Internal</th>
                            <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-20">Practical Internal</th>
                        }
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-16">Total</th>
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-16">Grade</th>
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-16">Status</th>
                        <th class="px-3 py-3 text-xs font-semibold text-gray-500 uppercase w-16">Submit</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @for (int i = 0; i < Model.Students.Count; i++)
                    {
                        var s = Model.Students[i];
                        <tr class="hover:bg-gray-50 transition-colors" :class="{ 'bg-green-50': isPass(@i) }">
                            <td class="px-3 py-2 text-gray-500">@(i + 1)</td>
                            <td class="px-3 py-2 font-medium text-gray-800">@s.StudentName</td>
                            <td class="px-3 py-2 text-gray-600 text-xs">@s.SymbolNumber</td>
                            <td class="px-3 py-2 text-gray-500 text-xs">@s.RegistrationNumber</td>
                            <input type="hidden" name="Students[@i].ExamRegistrationId" value="@s.ExamRegistrationId" />
                            <input type="hidden" name="Students[@i].ExamSubjectResultId" value="@(s.ExamSubjectResultId ?? 0)" />
                            <input type="hidden" name="Students[@i].StudentName" value="@s.StudentName" />
                            <input type="hidden" name="Students[@i].SymbolNumber" value="@s.SymbolNumber" />
                            @if (Model.HasTheory)
                            {
                                <td class="px-3 py-2">
                                    <input type="text" name="Students[@i].TheoryMarks" value="@s.TheoryMarks" maxlength="3"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-teal-500"
                                           @@input="calculate(@i)" />
                                </td>
                                <td class="px-3 py-2">
                                    <input type="text" name="Students[@i].TheoryConfirm" value="@s.TheoryConfirm" maxlength="3"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-teal-500" />
                                </td>
                            }
                            else
                            {
                                <input type="hidden" name="Students[@i].TheoryMarks" value="" />
                                <input type="hidden" name="Students[@i].TheoryConfirm" value="" />
                            }
                            @if (Model.HasPractical)
                            {
                                <td class="px-3 py-2">
                                    <input type="text" name="Students[@i].PracticalMarks" value="@s.PracticalMarks" maxlength="3"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-teal-500"
                                           @@input="calculate(@i)" />
                                </td>
                                <td class="px-3 py-2">
                                    <input type="text" name="Students[@i].PracticalConfirm" value="@s.PracticalConfirm" maxlength="3"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-teal-500" />
                                </td>
                            }
                            else
                            {
                                <input type="hidden" name="Students[@i].PracticalMarks" value="" />
                                <input type="hidden" name="Students[@i].PracticalConfirm" value="" />
                            }
                            @if (Model.HasInternal)
                            {
                                <td class="px-3 py-2">
                                    <input type="number" name="Students[@i].TheoryInternal" value="@s.TheoryInternal" step="0.01"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-teal-500"
                                           @@input="calculate(@i)" />
                                </td>
                                <td class="px-3 py-2">
                                    <input type="number" name="Students[@i].PracticalInternal" value="@s.PracticalInternal" step="0.01"
                                           class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-teal-500"
                                           @@input="calculate(@i)" />
                                </td>
                            }
                            else
                            {
                                <input type="hidden" name="Students[@i].TheoryInternal" value="" />
                                <input type="hidden" name="Students[@i].PracticalInternal" value="" />
                            }
                            <td class="px-3 py-2 text-center font-semibold" x-text="totals[@i] || '0'" :style="isPass(@i) ? '@passMarkStyle' : '@failMarkStyle'"></td>
                            <td class="px-3 py-2 text-center" x-text="grades[@i] || '-'"></td>
                            <td class="px-3 py-2 text-center">
                                <span x-show="isPass(@i)" style="color: #059669;"><i class="fas fa-check-circle"></i> Pass</span>
                                <span x-show="!isPass(@i)" style="color: #dc2626;"><i class="fas fa-times-circle"></i> Fail</span>
                            </td>
                            <td class="px-3 py-2 text-center">
                                <input type="checkbox" name="Students[@i].IsSubmitted" value="true" @(s.IsSubmitted ? "checked" : "")
                                       class="w-4 h-4 text-teal-600 rounded focus:ring-teal-500" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between gap-4 pt-4 border-t border-gray-200 mt-6">
            <div class="text-sm text-gray-500">
                <span class="font-semibold text-gray-800">@Model.Students.Count</span> students
            </div>
            <div class="flex items-center gap-3">
                <button type="submit" name="SubmitAll" value="false"
                        class="px-6 py-2.5 bg-gray-600 text-white text-sm font-semibold rounded-lg hover:bg-gray-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Save Draft
                </button>
                <button type="submit" name="SubmitAll" value="true"
                        class="px-6 py-2.5 bg-teal-600 text-white text-sm font-semibold rounded-lg hover:bg-teal-700 transition shadow-md"
                        onclick="return confirm('Submit marks for ALL students? This will finalize the entries.')">
                    <i class="fas fa-check-double mr-1"></i> Submit All
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function marksEntry() {
            var theoryFull = @Model.TheoryFullMarks;
            var theoryPass = @Model.TheoryPassMarks;
            var practicalFull = @(Model.PracticalFullMarks ?? 0);
            var practicalPass = @(Model.PracticalPassMarks ?? 0);
            var hasPractical = @Model.HasPractical.ToString().ToLower();
            var hasInternal = @Model.HasInternal.ToString().ToLower();
            var studentCount = @Model.Students.Count;
            var grades = new Array(studentCount).fill('-');
            var totals = new Array(studentCount).fill(0);

            return {
                grades: grades,
                totals: totals,
                _refresh: 0,
                init() {
                    for (var i = 0; i < studentCount; i++) {
                        this.calculate(i);
                    }
                },
                calculate(index) {
                    var row = document.querySelectorAll('tbody tr')[index];
                    if (!row) return;

                    var inputs = row.querySelectorAll('input[type="text"], input[type="number"]');
                    var theory = parseFloat(inputs[0]?.value) || 0;
                    var theoryConfirm = parseFloat(inputs[1]?.value) || 0;
                    var offset = 2;
                    var practical = 0, practicalConfirm = 0;
                    if (hasPractical) {
                        practical = parseFloat(inputs[offset]?.value) || 0;
                        practicalConfirm = parseFloat(inputs[offset + 1]?.value) || 0;
                        offset += 2;
                    }
                    var theoryInternal = 0, practicalInternal = 0;
                    if (hasInternal) {
                        theoryInternal = parseFloat(inputs[offset]?.value) || 0;
                        practicalInternal = parseFloat(inputs[offset + 1]?.value) || 0;
                    }

                    var total = theory + practical + theoryInternal + practicalInternal;
                    this.totals[index] = total.toFixed(2);

                    var theoryPassCheck = theory >= theoryPass;
                    var practicalPassCheck = !hasPractical || practical >= practicalPass;
                    var isPass = theoryPassCheck && practicalPassCheck;

                    var grade = '-';
                    if (total > 0) {
                        var totalFull = theoryFull + practicalFull;
                        var pct = totalFull > 0 ? (total / totalFull) * 100 : 0;
                        if (pct >= 90) grade = 'A';
                        else if (pct >= 80) grade = 'B+';
                        else if (pct >= 70) grade = 'B';
                        else if (pct >= 60) grade = 'C+';
                        else if (pct >= 50) grade = 'C';
                        else if (pct >= 40) grade = 'D';
                        else grade = 'F';
                    }
                    this.grades[index] = grade;
                    this._refresh++;
                },
                isPass(index) {
                    void(this._refresh);
                    var theoryPassCheck = true;
                    var practicalPassCheck = true;
                    var row = document.querySelectorAll('tbody tr')[index];
                    if (!row) return false;

                    var inputs = row.querySelectorAll('input[type="text"], input[type="number"]');
                    var theory = parseFloat(inputs[0]?.value) || 0;
                    theoryPassCheck = theory >= theoryPass;
                    var offset = 2;
                    if (hasPractical) {
                        var practical = parseFloat(inputs[offset]?.value) || 0;
                        practicalPassCheck = practical >= practicalPass;
                    }
                    return theoryPassCheck && practicalPassCheck;
                },
                submitForm() {
                    this.$el.submit();
                }
            };
        }
    </script>
}
