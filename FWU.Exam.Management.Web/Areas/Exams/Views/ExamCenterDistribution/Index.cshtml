@model ExamCenterDistributionDto

@{
    ViewData["Title"] = "Exam Center Distribution";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-people-arrows text-purple-600"></i>
            </div>
            <div>
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mb-6 rounded-lg bg-red-50 p-4 border border-red-200 flex items-start shadow-sm">
            <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-xs sm:text-sm font-medium text-red-800 whitespace-pre-line">@errorMessage</div>
        </div>
    }
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Exam Center Distribution</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Assign students to exam centers by symbol number ranges.</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form method="get" asp-action="Index" asp-area="Exams" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Select Exam Schedule</label>
                <select name="examScheduleId" class="select2 w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Select Schedule --</option>
                    @if (ViewData["ExamScheduleId"] is SelectList scheduleList)
                    {
                        @foreach (var item in scheduleList)
                        {
                            <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-search mr-1"></i> Load
            </button>
        </form>
    </div>

    @if (Model != null)
    {
        <div class="grid grid-cols-1 sm:grid-cols-5 gap-4">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold text-gray-800">@Model.TotalRegistrations</div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Total Registrations</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold text-green-600">@Model.AssignedCount</div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Assigned to Centers</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold text-amber-600">@Model.UnassignedCount</div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Not Yet Assigned</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold @(Model.SymbolNumbersAssigned ? "text-green-600" : "text-red-600")">
                    @(Model.SymbolNumbersAssigned ? "Yes" : "No")
                </div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Symbol Numbers Assigned</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold @(Model.RollNumbersAssigned ? "text-green-600" : "text-red-600")">
                    @(Model.RollNumbersAssigned ? Model.RollNumberCount.ToString() : "No")
                </div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Roll Numbers</div>
            </div>
        </div>

        @if (!Model.SymbolNumbersAssigned)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
                <i class="fas fa-hashtag text-4xl text-blue-300 mb-4"></i>
                <h3 class="text-base sm:text-lg font-semibold text-gray-800 mb-2">Assign Symbol Numbers</h3>
                <p class="text-xs sm:text-sm text-gray-500 mb-4">
                    Generate symbol numbers for all @Model.TotalRegistrations registered students based on their faculty and registration number.
                </p>
                <form method="post" asp-action="AssignSymbolNumbers" asp-area="Exams">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examScheduleId" value="@Model.ExamScheduleId" />
                    <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                        <i class="fas fa-hashtag"></i> Assign Symbol Numbers
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-base sm:text-lg font-semibold text-gray-800">Configure Symbol Number Ranges</h3>
                    <div class="flex gap-2">
                        <form method="post" asp-action="DistributeStudents" asp-area="Exams" class="inline" onsubmit="return confirm('Distribute students to centers based on the defined ranges?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="examScheduleId" value="@Model.ExamScheduleId" />
                            <button type="submit" class="px-4 py-2 bg-green-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-green-700 transition-colors">
                                <i class="fas fa-share-alt mr-1"></i> Distribute Students
                            </button>
                        </form>
                        <form method="post" asp-action="ResetDistribution" asp-area="Exams" class="inline" onsubmit="return confirm('Reset all student-to-center assignments?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="examScheduleId" value="@Model.ExamScheduleId" />
                            <button type="submit" class="px-4 py-2 bg-red-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-red-700 transition-colors">
                                <i class="fas fa-undo mr-1"></i> Reset
                            </button>
                        </form>
                    </div>
                </div>

                <form method="post" asp-action="SaveRanges" asp-area="Exams">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examScheduleId" value="@Model.ExamScheduleId" />

                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Center Code</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Venue College</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Serves Colleges</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">From Symbol #</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">To Symbol #</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Students</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @for (int i = 0; i < Model.Centers.Count; i++)
                                {
                                    var center = Model.Centers[i];
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-3 font-medium text-gray-800">@center.CenterCode</td>
                                        <td class="px-4 py-3 text-gray-600">
                                            @if (center.VenueColleges.Count > 0)
                                            {
                                                @string.Join(", ", center.VenueColleges)
                                            }
                                            else
                                            {
                                                <span class="text-gray-400">-</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-gray-600">
                                            @if (center.SourceColleges.Count > 0)
                                            {
                                                <span class="text-xs">@string.Join(", ", center.SourceColleges)</span>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-gray-400">All colleges</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3">
                                            <input type="hidden" name="examCenterIds" value="@center.ExamCenterId" />
                                            <input type="number" name="fromSymbols" value="@(center.FromSymbolNumber ?? 0)"
                                                   class="w-24 px-2 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                                   min="0" />
                                        </td>
                                        <td class="px-4 py-3">
                                            <input type="number" name="toSymbols" value="@(center.ToSymbolNumber ?? 0)"
                                                   class="w-24 px-2 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                                   min="0" />
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium @(center.StudentCount > 0 ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                                <i class="fas fa-user-graduate"></i> @center.StudentCount
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (Model.Centers.Count == 0)
                        {
                            <div class="text-center py-8">
                                <i class="fas fa-map-marker-alt text-3xl text-gray-300 mb-3"></i>
                                <p class="text-xs sm:text-sm text-gray-500">No exam centers found for this schedule. Create exam centers first.</p>
                                <a asp-action="Create" asp-controller="ExamCenters" asp-area="Exams" class="inline-flex items-center gap-1 mt-2 text-sm text-blue-600 hover:text-blue-700">
                                    <i class="fas fa-plus"></i> Create Exam Center
                                </a>
                            </div>
                        }
                    </div>

                    @if (Model.Centers.Count > 0)
                    {
                        <div class="flex justify-end mt-4 pt-4 border-t border-gray-200">
                            <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-sm">
                                <i class="fas fa-save mr-1"></i> Save Ranges
                            </button>
                        </div>
                    }
                </form>
            </div>
        }

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="text-base sm:text-lg font-semibold text-gray-800">Exam Roll Numbers</h3>
                    <p class="text-xs sm:text-sm text-gray-500 mt-1">Generate roll numbers in format: AcademicYear + Sequence (e.g., 20820001)</p>
                </div>
                <div class="flex gap-2">
                    @if (!Model.RollNumbersAssigned)
                    {
                        <form method="post" asp-action="GenerateRollNumbers" asp-area="Exams" class="inline" onsubmit="return confirm('Generate roll numbers for all registered students?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="examScheduleId" value="@Model.ExamScheduleId" />
                            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors">
                                <i class="fas fa-hashtag mr-1"></i> Generate Roll Numbers
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-action="ClearRollNumbers" asp-area="Exams" class="inline" onsubmit="return confirm('Clear all roll numbers? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="examScheduleId" value="@Model.ExamScheduleId" />
                            <button type="submit" class="px-4 py-2 bg-red-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-red-700 transition-colors">
                                <i class="fas fa-undo mr-1"></i> Clear Roll Numbers
                            </button>
                        </form>
                    }
                </div>
            </div>

            @if (Model.RollNumbersAssigned)
            {
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-check text-green-600"></i>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm font-medium text-green-800">Roll numbers have been generated for @Model.RollNumberCount students.</p>
                            <p class="text-xs text-green-600 mt-0.5">Format: Academic Year (BS) + Sequential Number (e.g., 20820001)</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-exclamation-triangle text-amber-600"></i>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm font-medium text-amber-800">Roll numbers have not been generated yet.</p>
                            <p class="text-xs text-amber-600 mt-0.5">Click "Generate Roll Numbers" to assign roll numbers to all @Model.TotalRegistrations registered students.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
    </style>
    <script>
        $(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: 'resolve' }); });
    </script>
}