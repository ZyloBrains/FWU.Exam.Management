@model ExamCenterDistributionDto

@{
    ViewData["Title"] = "Exam Center Distribution";
    var isDone = Model?.AssignedCount > 0 && Model?.UnassignedCount == 0;
    var hasData = Model != null && Model.TotalRegistrations > 0 && Model.Centers.Count > 0;
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-people-arrows text-purple-600"></i>
        </div>
        <div>
            @await Html.PartialAsync("_AlertMessages")
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Exam Center Distribution</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Assign symbol numbers and distribute students to exam centers.</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form method="get" asp-action="Index" asp-area="Exams" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1.5">Select Exam Schedule</label>
                <select name="examScheduleId" class="select2 w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Select Schedule --</option>
                    @if (ViewData["ExamScheduleId"] is SelectList scheduleList)
                    {
                        foreach (var item in scheduleList)
                        {
                            if (item.Selected)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    }
                </select>
            </div>
            <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-search mr-1"></i> Load
            </button>
        </form>
    </div>

    @if (Model != null && Model.TotalRegistrations == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
            <i class="fas fa-info-circle text-3xl text-gray-300 mb-3"></i>
            <p class="text-sm text-gray-500">No registered students found for this schedule.</p>
        </div>
    }

    @if (Model != null && Model.TotalRegistrations > 0 && Model.Centers.Count == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
            <i class="fas fa-map-marker-alt text-3xl text-gray-300 mb-3"></i>
            <p class="text-sm text-gray-500">No exam centers found. Create exam centers first.</p>
            <a asp-action="Create" asp-controller="ExamCenters" asp-area="Exams" class="inline-flex items-center gap-1 mt-2 text-sm text-blue-600 hover:text-blue-700">
                <i class="fas fa-plus"></i> Create Exam Center
            </a>
        </div>
    }

    @if (hasData)
    {
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold text-gray-800">@Model!.TotalRegistrations</div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Students</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold @(isDone ? "text-green-600" : "text-amber-600")">@Model!.AssignedCount</div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Assigned</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="text-xl sm:text-2xl font-bold text-purple-600">@Model!.Centers.Count</div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1">Exam Centers</div>
            </div>
        </div>
    }
</div>

@if (hasData && isDone)
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-check text-green-600"></i>
                </div>
                <div>
                    <div class="text-sm font-semibold text-green-800">Distribution Complete</div>
                    <div class="text-xs text-green-600">@Model!.AssignedCount students distributed across @Model!.Centers.Count centers.</div>
                </div>
            </div>
            <div class="flex gap-2">
                <form method="post" asp-action="AssignAndDistribute" asp-area="Exams" onsubmit="return confirm('Re-distribute students?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examScheduleId" value="@Model!.ExamScheduleId" />
                    <button type="submit" class="px-3 py-2 bg-amber-600 text-white text-xs font-semibold rounded-lg hover:bg-amber-700 transition-colors">
                        <i class="fas fa-sync-alt mr-1"></i> Re-distribute
                    </button>
                </form>
                <form method="post" asp-action="ResetDistribution" asp-area="Exams" onsubmit="return confirm('Reset all assignments?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examScheduleId" value="@Model!.ExamScheduleId" />
                    <button type="submit" class="px-3 py-2 bg-red-600 text-white text-xs font-semibold rounded-lg hover:bg-red-700 transition-colors">
                        <i class="fas fa-undo mr-1"></i> Reset
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@if (hasData && !isDone)
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
        <i class="fas fa-share-alt text-4xl text-blue-300 mb-3"></i>
        <h3 class="text-base font-semibold text-gray-800 mb-1">Ready to Distribute</h3>
        <p class="text-xs text-gray-500 mb-4">This will assign symbol numbers and distribute @Model!.TotalRegistrations students evenly across @Model!.Centers.Count centers.</p>
        <form method="post" asp-action="AssignAndDistribute" asp-area="Exams">
            @Html.AntiForgeryToken()
            <input type="hidden" name="examScheduleId" value="@Model!.ExamScheduleId" />
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-magic"></i> Assign &amp; Distribute
            </button>
        </form>
    </div>
}

@if (hasData && isDone)
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Centers</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            @foreach (var center in Model!.Centers)
            {
                <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-map-marker-alt text-purple-600 text-xs"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-xs font-semibold text-gray-800 truncate">@center.CenterCode</div>
                        @if (center.VenueColleges.Count > 0)
                        {
                            <div class="text-xs text-gray-500 truncate">@string.Join(", ", center.VenueColleges)</div>
                        }
                    </div>
                    <span class="flex-shrink-0 text-xs font-medium text-green-700 bg-green-100 px-2 py-1 rounded-full">
                        @center.StudentCount
                    </span>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: 'resolve' }); });
    </script>
}
