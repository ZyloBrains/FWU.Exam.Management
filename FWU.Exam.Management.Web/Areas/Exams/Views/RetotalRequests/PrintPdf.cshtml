@using FWU.Exam.Management.Domain.Extensions
@model IEnumerable<FWU.Exam.Management.Domain.Entities.Exams.RetotalRequest>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Retotaling Requests Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; color: #374151; }
        .exam-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .exam-table th, .exam-table td { border: 1px solid #d1d5db; padding: 8px; font-size: 12px; vertical-align: top; }
        .exam-table th { background: #f3f4f6; }
        .footer { margin-top: 30px; font-size: 11px; color: #6b7280; text-align: center; }
    </style>
</head>
<body>
    <div>
        <h2 style="margin: 0 0 10px 0;">Retotaling / Re-evaluation Requests Report</h2>
        <table class="exam-table">
            <thead>
                <tr>
                    <th>#</th><th>Student</th><th>Subject</th><th>Status</th><th>Requested Date</th><th>Reason</th><th>Fee Paid</th><th>Reviewed By</th><th>Reviewed Date</th>
                </tr>
            </thead>
            <tbody>
                @{ var counter = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center;">@counter</td>
                        <td>
                            @if (item.StudentRegistration != null)
                            {
                                <strong>@item.StudentRegistration.FirstName.GetFullName(item.StudentRegistration.LastName)</strong>
                            }
                        </td>
                        <td>@item.ExamSubjectResult?.SubjectOffering?.SubjectCatalog?.SubjectName</td>
                        <td>@item.Status</td>
                        <td style="font-size: 11px;">@item.RequestedDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.Reason</td>
                        <td>@(item.FeePaid ? "Yes" : "No")</td>
                        <td>@item.ReviewedByUsername</td>
                        <td style="font-size: 11px;">@item.ReviewedDate?.ToString("yyyy-MM-dd")</td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: #9ca3af;">
                <p>No retotaling requests found.</p>
            </div>
        }
    </div>

    <script>
        window.onload = function () { window.print(); };
    </script>
</body>
</html>
