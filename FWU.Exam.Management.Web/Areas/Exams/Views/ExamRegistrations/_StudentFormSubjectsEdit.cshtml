@model FWU.Exam.Management.Application.DTOs.ExamFormEditableSubjectsDto

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 edit-subjects-backdrop">
    <div class="absolute inset-0 bg-gray-900/60" data-close-subjects-modal></div>
    <div class="relative bg-white rounded-xl shadow-2xl border border-gray-200 w-full max-w-2xl max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between gap-3 bg-amber-500 border-b-4 border-amber-400 px-5 py-4 rounded-t-xl">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-white/20 rounded-lg flex items-center justify-center">
                    <i class="fas fa-pen text-white"></i>
                </div>
                <div>
                    <h2 class="text-white font-bold text-base">Edit Registered Subjects</h2>
                    <p class="text-amber-50 text-xs">@(Model.StudentName ?? "N/A") &middot; @(Model.RegistrationNumber ?? "-") &middot; @(Model.ExamScheduleName ?? "-")@(string.IsNullOrEmpty(Model.AcademicYearName) ? null : $" · {Model.AcademicYearName}")</p>
                </div>
            </div>
            <button type="button" class="w-8 h-8 inline-flex items-center justify-center rounded-lg bg-white/20 hover:bg-white/30 text-white transition-colors" data-close-subjects-modal title="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>

        @if (!Model.CanEdit)
        {
            <div class="p-6 text-center">
                <div class="mx-auto w-12 h-12 rounded-full bg-red-50 flex items-center justify-center mb-3">
                    <i class="fas fa-lock text-red-400 text-xl"></i>
                </div>
                <p class="text-sm font-semibold text-gray-800 mb-1">This form cannot be edited</p>
                <p class="text-sm text-gray-500">@Model.NotEditableReason</p>
            </div>
        }
        else
        {
            <form class="edit-subjects-form" asp-action="UpdateStudentFormSubjects" asp-area="Exams" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ExamRegistrationId" />

                <div class="px-5 py-4 overflow-y-auto">
                    <div class="edit-subjects-error hidden mb-3 rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-600"></div>
                    <p class="text-xs text-gray-500 mb-3">
                        Tick the subjects the student should be registered for. Unticked subjects will be removed from this exam form.
                        @(string.Equals(Model.ExamTypeName, "Partial", StringComparison.OrdinalIgnoreCase) || string.Equals(Model.ExamTypeName, "Supplementary", StringComparison.OrdinalIgnoreCase)
                            ? "Newly added subjects for this re-exam will carry forward previous practical/internal marks where available."
                            : null)
                        @if (Model.IsReExamForm)
                        {
                            <text>You can also choose which papers (theory/practical) each subject registers for.</text>
                        }
                    </p>
                    <div class="overflow-x-auto rounded-lg border border-gray-200">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase w-12 text-center">&nbsp;</th>
                                    <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Code</th>
                                    <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Name</th>
                                    <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Theory</th>
                                    <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Practical</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @if (Model.AvailableSubjects.Any())
                                {
                                    foreach (var subject in Model.AvailableSubjects)
                                    {
                                        <tr class="hover:bg-amber-50/40 cursor-pointer subject-row" data-offering-id="@subject.SubjectOfferingId">
                                            <td class="px-4 py-2.5 text-center">
                                                <input type="checkbox" name="subjectOfferingIds" value="@subject.SubjectOfferingId"
                                                       class="w-4 h-4 accent-amber-600 subject-checkbox" checked="@subject.IsSelected" />
                                            </td>
                                            <td class="px-4 py-2.5 text-gray-700">@(subject.Code ?? "-")</td>
                                            <td class="px-4 py-2.5 text-gray-800">@(subject.Name ?? "-")</td>
                                            <td class="px-4 py-2.5 text-center">
                                                @if (Model.IsReExamForm)
                                                {
                                                    <input type="checkbox" name="legTheory" value="@subject.SubjectOfferingId"
                                                           class="w-4 h-4 accent-emerald-600 leg-checkbox"
                                                           checked="@subject.SelectedTheory" disabled="@(!subject.Theory)" />
                                                }
                                                else if (subject.SelectedTheory)
                                                {
                                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-blue-600"><i class="fas fa-check text-[10px]"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="text-gray-300">-</span>
                                                }
                                            </td>
                                            <td class="px-4 py-2.5 text-center">
                                                @if (Model.IsReExamForm)
                                                {
                                                    <input type="checkbox" name="legPractical" value="@subject.SubjectOfferingId"
                                                           class="w-4 h-4 accent-amber-600 leg-checkbox"
                                                           checked="@subject.SelectedPractical" disabled="@(!subject.Practical)" />
                                                }
                                                else if (subject.SelectedPractical)
                                                {
                                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-600"><i class="fas fa-check text-[10px]"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="text-gray-300">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="px-4 py-8 text-center text-gray-400 text-sm">No subjects are offered for this exam schedule.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-gray-100 bg-gray-50 rounded-b-xl">
                    <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors" data-close-subjects-modal>
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 bg-amber-500 hover:bg-amber-400 text-white text-sm font-semibold rounded-lg shadow transition-colors">
                        <i class="fas fa-save text-xs"></i> Save Subjects
                    </button>
                </div>
            </form>
        }
    </div>
</div>
