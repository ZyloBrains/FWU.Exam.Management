@model FWU.Exam.Management.Domain.Entities.Exams.ExamRegistration

@{
    ViewData["Title"] = "Delete Exam Registration";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-clipboard-list text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete Exam Registration</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">Are you sure you want to delete this exam registration? This will soft-delete the record.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Schedule</p><p class="text-gray-800 font-medium">@Model.ExamSchedule?.ExamScheduleName</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">College</p><p class="text-gray-800 font-medium">@Model.College?.Name</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Roll Number</p><p class="text-gray-800 font-medium">@(Model.ExamRollNumber ?? "-")</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</p><p class="text-gray-800 font-medium">@Model.Status</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Fee</p><p class="text-gray-800 font-medium">@Model.FeeEnclosed?.ToString("N2")</p></div>
            <div><p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Date</p><p class="text-gray-800 font-medium">@Model.RegistrationDate?.ToString("yyyy-MM-dd")</p></div>
        </div>

        <form asp-action="Delete" asp-area="Exams" method="post" class="mt-8">
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit" onclick="return confirm('Are you sure?');" class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" asp-area="Exams" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">Cancel</a>
            </div>
        </form>
    </div>
</div>
