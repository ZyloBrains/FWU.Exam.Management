@model FWU.Exam.Management.Domain.Entities.Exams.ExamRegistration

@{
    ViewData["Title"] = "Exam Registration Details";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-clipboard-list text-cyan-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Exam Registration Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8 space-y-6">
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Registration Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Schedule</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Model.ExamSchedule?.ExamScheduleName</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">College</p>
                    <p class="mt-1 text-gray-800">@Model.College?.Name</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Academic Year</p>
                    <p class="mt-1 text-gray-800">@Model.AcademicYear?.AcademicYearName</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Program</p>
                    <p class="mt-1 text-gray-800">@Model.Program?.ProgramName</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Center</p>
                    <p class="mt-1 text-gray-800">@(Model.ExamCenter != null ? "Center " + Model.ExamCenter.Code.ToString() : "-")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Roll Number</p>
                    <p class="mt-1 text-gray-800">@(Model.ExamRollNumber ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Fee Enclosed</p>
                    <p class="mt-1 text-gray-800">@Model.FeeEnclosed?.ToString("N2")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Attendance %</p>
                    <p class="mt-1 text-gray-800">@Model.AttendancePercentage?.ToString("N2")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Registration Date</p>
                    <p class="mt-1 text-gray-800">@Model.RegistrationDate?.ToString("yyyy-MM-dd")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">SGPA</p>
                    <p class="mt-1 text-gray-800">@(Model.Sgpa ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Status</p>
                    <p class="mt-1">@switch (Model.Status) { case FWU.Exam.Management.Domain.Enums.RegistrationStatus.Pending: <span class="px-2.5 py-1 text-xs font-semibold bg-yellow-100 text-yellow-700 rounded-full">Pending</span> break; case FWU.Exam.Management.Domain.Enums.RegistrationStatus.CollegeVerified: <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Approved</span> break; case FWU.Exam.Management.Domain.Enums.RegistrationStatus.AdminVerified: <span class="px-2.5 py-1 text-xs font-semibold bg-indigo-100 text-indigo-700 rounded-full">Admin Verified</span> break; case FWU.Exam.Management.Domain.Enums.RegistrationStatus.Registered: <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Registered</span> break; case FWU.Exam.Management.Domain.Enums.RegistrationStatus.Withheld: <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Withheld</span> break; case FWU.Exam.Management.Domain.Enums.RegistrationStatus.Rejected: <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-full">Rejected</span> break; }</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Verified By</p>
                    <p class="mt-1 text-gray-800">@(Model.VerifiedByUsername ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Verified Date</p>
                    <p class="mt-1 text-gray-800">@(Model.VerifiedDate?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Remarks</p>
                    <p class="mt-1 text-gray-800">@(Model.Remarks ?? "-")</p>
                </div>
            </div>
        </div>

        <div>
            <div class="flex items-center justify-between mb-3 pb-1 border-b">
                <h2 class="text-base sm:text-lg font-semibold text-gray-700">
                    Selected Subjects
                </h2>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-semibold">
                    <i class="fas fa-layer-group text-[10px]"></i> @Model.ExamSubjectResults.Count subject(s)
                </span>
            </div>

            @if (Model.IsSupplementary)
            {
                <div class="mb-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-xs font-medium">
                    <i class="fas fa-redo-alt text-[10px]"></i> Supplementary / Partial (re-exam) form
                </div>
            }

            @if (Model.ExamSubjectResults.Any())
            {
                <div class="overflow-x-auto rounded-lg border border-gray-200">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase w-12">S.N</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Code</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Name</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Theory</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Practical</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @{
                                var sn = 0;
                                var offering = default(FWU.Exam.Management.Domain.Entities.Subjects.SubjectOffering);
                            }
                            @foreach (var esr in Model.ExamSubjectResults)
                            {
                                sn++;
                                offering = esr.SubjectOffering;
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-2.5 text-gray-500">@sn</td>
                                    <td class="px-4 py-2.5 text-gray-700">@(offering?.SubjectCatalog?.SubjectCode ?? "-")</td>
                                    <td class="px-4 py-2.5 text-gray-800">@(offering?.SubjectCatalog?.SubjectName ?? "Subject #" + esr.SubjectOfferingId)</td>
                                    <td class="px-4 py-2.5 text-center">
                                        @if (esr.IsTheoryRegistered ?? offering?.HasTheory ?? false)
                                        {
                                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-blue-600"><i class="fas fa-check text-[10px]"></i></span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-300">-</span>
                                        }
                                    </td>
                                    <td class="px-4 py-2.5 text-center">
                                        @if (esr.IsPracticalRegistered ?? offering?.HasPractical ?? false)
                                        {
                                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-600"><i class="fas fa-check text-[10px]"></i></span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-300">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="rounded-lg border border-dashed border-gray-200 bg-gray-50 py-8 text-center text-gray-400 text-sm">
                    No subjects selected for this registration.
                </div>
            }
        </div>

        <div class="flex items-center gap-4 pt-6 mt-8 border-t border-gray-200">
            <a asp-action="Edit" asp-area="Exams" asp-route-id="@Model.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <a asp-action="Index" asp-area="Exams" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
