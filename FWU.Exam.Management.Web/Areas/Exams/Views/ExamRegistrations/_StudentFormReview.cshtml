@model FWU.Exam.Management.Application.DTOs.ExamFormAdminDto

@{
    var showActions = ViewBag.ShowActions as bool? ?? true;
    var canAdminApprove = ViewBag.CanAdminApprove as bool? ?? false;
    var canEditSubjects = (ViewBag.CanEditSubjects as bool? ?? false) && Model.CanEditSubjects;
    var canReject = ViewBag.CanReject as bool? ?? false;
    var academicYearId = ViewBag.AcademicYearId as int?;
    var levelId = ViewBag.LevelId as int?;
    var examScheduleId = ViewBag.ExamScheduleId as int?;
    var search = ViewBag.Search as string ?? "";
    var page = ViewBag.Page as int? ?? 1;
    var isPending = Model.Status == FWU.Exam.Management.Domain.Enums.RegistrationStatus.Pending;
    var isCollegeVerified = Model.Status == FWU.Exam.Management.Domain.Enums.RegistrationStatus.CollegeVerified;
}

<div class="bg-white rounded-xl shadow-lg border border-blue-200 overflow-hidden">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-blue-600 border-b-4 border-blue-400 px-5 py-4">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-white/20 rounded-lg flex items-center justify-center">
                <i class="fas fa-clipboard-check text-white"></i>
            </div>
            <div>
                <h2 class="text-white font-bold text-base">Review Exam Form</h2>
                <p class="text-blue-100 text-xs">@(Model.StudentName ?? "N/A") &middot; @(Model.RegistrationNumber ?? "-")</p>
            </div>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
            @if (showActions && isPending)
            {
                <form asp-action="Verify" asp-area="Exams" method="post" class="flex-1 sm:flex-none" onsubmit="return confirm('Approve this student exam form?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ExamRegistrationId" />
                    <input type="hidden" name="academicYearId" value="@academicYearId" />
                    <input type="hidden" name="levelId" value="@levelId" />
                    <input type="hidden" name="examScheduleId" value="@examScheduleId" />
                    <input type="hidden" name="search" value="@search" />
                    <input type="hidden" name="page" value="@(page)" />
                    <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-lg shadow transition-colors">
                        <i class="fas fa-check text-xs"></i> Approve
                    </button>
                </form>
            }
            @if (showActions && isCollegeVerified && canAdminApprove)
            {
                <form asp-action="Approve" asp-area="Exams" method="post" class="flex-1 sm:flex-none" onsubmit="return confirm('Final approve this student exam form?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ExamRegistrationId" />
                    <input type="hidden" name="academicYearId" value="@academicYearId" />
                    <input type="hidden" name="levelId" value="@levelId" />
                    <input type="hidden" name="examScheduleId" value="@examScheduleId" />
                    <input type="hidden" name="search" value="@search" />
                    <input type="hidden" name="page" value="@(page)" />
                    <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-lg shadow transition-colors">
                        <i class="fas fa-check-double text-xs"></i> Final Approve
                    </button>
                </form>
            }
            @if (showActions && canReject && (isPending || isCollegeVerified))
            {
                <button type="button" class="reject-btn w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-semibold rounded-lg shadow transition-colors"
                        data-id="@Model.ExamRegistrationId" title="Reject this exam form">
                    <i class="fas fa-ban text-xs"></i> Reject
                </button>
            }
            <button type="button" class="close-review-panel w-8 h-8 inline-flex items-center justify-center rounded-lg bg-white/20 hover:bg-white/30 text-white transition-colors" title="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 p-6">
        <div class="lg:col-span-2 space-y-8">
            <div>
                <h3 class="text-sm font-bold text-gray-800 mb-4 border-b border-gray-100 pb-2.5">
                    <i class="fas fa-id-card text-blue-600 mr-2"></i>Student Registration Details
                </h3>
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Academic Year</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.AcademicYearName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Registration No</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.RegistrationNumber ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">College</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.CollegeName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Name</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.StudentName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Program</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.ProgramName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Date of Birth</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.DateOfBirthAD ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Semester</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.SemesterName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Contact No</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.ContactNumber ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Exam Type</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.ExamTypeName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Paid Amount</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.PaidAmount?.ToString("N2") ?? "-")</dd>
                    </div>
                </dl>
            </div>

            <div>
                <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-2.5">
                    <h3 class="text-sm font-bold text-gray-800">
                        <i class="fas fa-book text-blue-600 mr-2"></i>Subject Details
                    </h3>
                    @if (showActions && canEditSubjects)
                    {
                        <button type="button" class="edit-subjects-btn inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors"
                                data-id="@Model.ExamRegistrationId" title="Correct the registered subjects for this form">
                            <i class="fas fa-pen text-[10px]"></i> Edit Subjects
                        </button>
                    }
                </div>
                <div class="overflow-x-auto rounded-lg border border-gray-200">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase w-12">S.N</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Code</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Name</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Theory</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Practical</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @if (Model.Subjects.Any())
                            {
                                var sn = 0;
                                foreach (var subject in Model.Subjects)
                                {
                                    sn++;
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-2.5 text-gray-500">@sn</td>
                                        <td class="px-4 py-2.5 text-gray-700">@(subject.Code ?? "-")</td>
                                        <td class="px-4 py-2.5 text-gray-800">@(subject.Name ?? "-")</td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.RegisteredTheory)
                                            {
                                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-blue-600"><i class="fas fa-check text-[10px]"></i></span>
                                            }
                                            else
                                            {
                                                <span class="text-gray-300">-</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.RegisteredPractical)
                                            {
                                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-600"><i class="fas fa-check text-[10px]"></i></span>
                                            }
                                            else
                                            {
                                                <span class="text-gray-300">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="px-4 py-8 text-center text-gray-400 text-sm">No subjects selected for this form.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div>
            <h3 class="text-sm font-bold text-gray-800 mb-3 border-b border-gray-100 pb-2">
                <i class="fas fa-folder text-blue-600 mr-2"></i>Document
            </h3>
            <div class="space-y-5">
                <div class="rounded-lg border border-gray-200 p-4">
                    <p class="text-xs font-semibold text-gray-500 mb-2">Student Photo</p>
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="@Model.PhotoPath" alt="Student Photo" class="w-full h-48 object-cover object-top rounded-lg border border-gray-100" />
                    }
                    else
                    {
                        <div class="w-full h-48 flex flex-col items-center justify-center rounded-lg bg-gray-50 border border-dashed border-gray-200 text-gray-400">
                            <i class="fas fa-user text-3xl mb-2"></i>
                            <span class="text-xs">No photo</span>
                        </div>
                    }
                </div>
                <div class="rounded-lg border border-gray-200 p-4">
                    <p class="text-xs font-semibold text-gray-500 mb-2">Student Signature</p>
                    @if (!string.IsNullOrEmpty(Model.SignaturePath))
                    {
                        <img src="@Model.SignaturePath" alt="Student Signature" class="w-full h-24 object-contain rounded-lg border border-gray-100 bg-white" />
                    }
                    else
                    {
                        <div class="w-full h-24 flex flex-col items-center justify-center rounded-lg bg-gray-50 border border-dashed border-gray-200 text-gray-400">
                            <i class="fas fa-pen-nib text-xl mb-2"></i>
                            <span class="text-xs">No signature</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (showActions && canReject && (isPending || isCollegeVerified))
{
    <div id="rejectFormModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-gray-900/60" data-close-reject-modal></div>
        <div class="relative bg-white rounded-xl shadow-2xl border border-gray-200 w-full max-w-md">
            <div class="flex items-center justify-between gap-3 bg-red-600 border-b-4 border-red-400 px-5 py-4 rounded-t-xl">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-white/20 rounded-lg flex items-center justify-center">
                        <i class="fas fa-ban text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-white font-bold text-base">Reject Exam Form</h2>
                        <p class="text-red-100 text-xs">@(Model.StudentName ?? "N/A") &middot; @(Model.RegistrationNumber ?? "-")</p>
                    </div>
                </div>
                <button type="button" class="w-8 h-8 inline-flex items-center justify-center rounded-lg bg-white/20 hover:bg-white/30 text-white transition-colors" data-close-reject-modal title="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form class="reject-form" asp-action="Reject" asp-area="Exams" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ExamRegistrationId" />
                <div class="px-5 py-4">
                    <div class="reject-error hidden mb-3 rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-600"></div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Rejection reason <span class="text-red-500">*</span></label>
                    <textarea name="reason" rows="3" required
                              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-800 focus:border-red-400 focus:ring-2 focus:ring-red-100 outline-none"
                              placeholder="e.g. Invalid documents, wrong student details, payment issue..."></textarea>
                    <p class="text-xs text-gray-500 mt-2">The student will be able to apply again for this schedule after rejection.</p>
                </div>
                <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-gray-100 bg-gray-50 rounded-b-xl">
                    <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors" data-close-reject-modal>
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-semibold rounded-lg shadow transition-colors">
                        <i class="fas fa-ban text-xs"></i> Reject Form
                    </button>
                </div>
            </form>
        </div>
    </div>
}
