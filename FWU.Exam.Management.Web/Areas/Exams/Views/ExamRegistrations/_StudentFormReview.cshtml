@model FWU.Exam.Management.Application.DTOs.ExamFormAdminDto

@{
    var showActions = ViewBag.ShowActions as bool? ?? true;
    var academicYearId = ViewBag.AcademicYearId as int?;
    var levelId = ViewBag.LevelId as int?;
    var examScheduleId = ViewBag.ExamScheduleId as int?;
    var search = ViewBag.Search as string ?? "";
    var page = ViewBag.Page as int? ?? 1;
    var isPending = Model.Status == FWU.Exam.Management.Domain.Enums.RegistrationStatus.Pending;
}

<div class="bg-white rounded-xl shadow-lg border border-indigo-200 overflow-hidden">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-gradient-to-r from-indigo-600 to-purple-600 px-5 py-4">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-white/20 rounded-lg flex items-center justify-center">
                <i class="fas fa-clipboard-check text-white"></i>
            </div>
            <div>
                <h2 class="text-white font-bold text-base">Review Exam Form</h2>
                <p class="text-indigo-100 text-xs">@(Model.StudentName ?? "N/A") &middot; @(Model.RegistrationNumber ?? "-")</p>
            </div>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
            @if (showActions && isPending)
            {
                <form asp-action="Verify" asp-area="Exams" method="post" class="flex-1 sm:flex-none" onsubmit="return confirm('Approve this student exam form?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ExamRegistrationId" />
                    <input type="hidden" name="academicYearId" value="@academicYearId" />
                    <input type="hidden" name="levelId" value="@levelId" />
                    <input type="hidden" name="examScheduleId" value="@examScheduleId" />
                    <input type="hidden" name="search" value="@search" />
                    <input type="hidden" name="page" value="@(page)" />
                    <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-white text-sm font-semibold rounded-lg shadow transition-colors">
                        <i class="fas fa-check text-xs"></i> Approve
                    </button>
                </form>
                <button type="button" data-reject-id="@Model.ExamRegistrationId"
                        data-reject-academic-year-id="@academicYearId"
                        data-reject-level-id="@levelId"
                        data-reject-exam-schedule-id="@examScheduleId"
                        data-reject-search="@search"
                        data-reject-page="@(page)"
                        class="inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-red-500 hover:bg-red-400 text-white text-sm font-semibold rounded-lg shadow transition-colors">
                    <i class="fas fa-times text-xs"></i> Reject
                </button>
            }
            <button type="button" class="close-review-panel w-8 h-8 inline-flex items-center justify-center rounded-lg bg-white/20 hover:bg-white/30 text-white transition-colors" title="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 p-6">
        <div class="lg:col-span-2 space-y-8">
            <div>
                <h3 class="text-sm font-bold text-gray-800 mb-4 border-b border-gray-100 pb-2.5">
                    <i class="fas fa-id-card text-indigo-500 mr-2"></i>Student Registration Details
                </h3>
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Academic Year</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.AcademicYearName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Registration No</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.RegistrationNumber ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">College</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.CollegeName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Name</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.StudentName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Program</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.ProgramName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Date of Birth</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.DateOfBirthAD ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Semester</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.SemesterName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Contact No</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.ContactNumber ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Exam Type</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.ExamTypeName ?? "-")</dd>
                    </div>
                    <div class="flex justify-between gap-3 border-b border-gray-50 pb-2.5">
                        <dt class="text-gray-500">Paid Amount</dt>
                        <dd class="text-gray-800 font-medium text-right">@(Model.PaidAmount?.ToString("N2") ?? "-")</dd>
                    </div>
                </dl>
            </div>

            <div>
                <h3 class="text-sm font-bold text-gray-800 mb-4 border-b border-gray-100 pb-2.5">
                    <i class="fas fa-book text-indigo-500 mr-2"></i>Subject Details
                </h3>
                <div class="overflow-x-auto rounded-lg border border-gray-200">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase w-12">S.N</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Code</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Subject Name</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Theory</th>
                                <th class="px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase text-center">Practical</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @if (Model.Subjects.Any())
                            {
                                var sn = 0;
                                foreach (var subject in Model.Subjects)
                                {
                                    sn++;
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-2.5 text-gray-500">@sn</td>
                                        <td class="px-4 py-2.5 text-gray-700">@(subject.Code ?? "-")</td>
                                        <td class="px-4 py-2.5 text-gray-800">@(subject.Name ?? "-")</td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.Theory)
                                            {
                                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-emerald-600"><i class="fas fa-check text-[10px]"></i></span>
                                            }
                                            else
                                            {
                                                <span class="text-gray-300">-</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 text-center">
                                            @if (subject.Practical)
                                            {
                                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-600"><i class="fas fa-check text-[10px]"></i></span>
                                            }
                                            else
                                            {
                                                <span class="text-gray-300">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="px-4 py-8 text-center text-gray-400 text-sm">No subjects found for this schedule.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div>
            <h3 class="text-sm font-bold text-gray-800 mb-3 border-b border-gray-100 pb-2">
                <i class="fas fa-folder text-indigo-500 mr-2"></i>Document
            </h3>
            <div class="space-y-5">
                <div class="rounded-lg border border-gray-200 p-4">
                    <p class="text-xs font-semibold text-gray-500 mb-2">Student Photo</p>
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="@Model.PhotoPath" alt="Student Photo" class="w-full h-48 object-cover object-top rounded-lg border border-gray-100" />
                    }
                    else
                    {
                        <div class="w-full h-48 flex flex-col items-center justify-center rounded-lg bg-gray-50 border border-dashed border-gray-200 text-gray-400">
                            <i class="fas fa-user text-3xl mb-2"></i>
                            <span class="text-xs">No photo</span>
                        </div>
                    }
                </div>
                <div class="rounded-lg border border-gray-200 p-4">
                    <p class="text-xs font-semibold text-gray-500 mb-2">Student Signature</p>
                    @if (!string.IsNullOrEmpty(Model.SignaturePath))
                    {
                        <img src="@Model.SignaturePath" alt="Student Signature" class="w-full h-24 object-contain rounded-lg border border-gray-100 bg-white" />
                    }
                    else
                    {
                        <div class="w-full h-24 flex flex-col items-center justify-center rounded-lg bg-gray-50 border border-dashed border-gray-200 text-gray-400">
                            <i class="fas fa-pen-nib text-xl mb-2"></i>
                            <span class="text-xs">No signature</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
