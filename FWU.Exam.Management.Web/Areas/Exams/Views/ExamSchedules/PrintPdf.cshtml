@model IEnumerable<FWU.Exam.Management.Domain.Entities.Exams.ExamSchedule>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Exam Schedules Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; color: #374151; }
        .exam-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .exam-table th, .exam-table td { border: 1px solid #d1d5db; padding: 8px; font-size: 12px; vertical-align: top; }
        .exam-table th { background: #f3f4f6; }
        .status-active { color: #047857; font-weight: bold; }
        .status-inactive { color: #6b7280; font-weight: bold; }
        .footer { margin-top: 30px; font-size: 11px; color: #6b7280; text-align: center; }
    </style>
</head>
<body>
    <div>
        <h2 style="margin: 0 0 10px 0;">Exam Schedules Report</h2>
        <table class="exam-table">
            <thead>
                <tr>
                    <th>#</th><th>Name</th><th>Code</th><th>Academic Year</th><th>Level</th><th>Exam Type</th><th>Start</th><th>End</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{ var counter = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center;">@counter</td>
                        <td>
                            <strong>@item.ExamScheduleName</strong>
                            @if (!string.IsNullOrEmpty(item.Remarks))
                            {
                                <div style="font-size: 10px; color: #6b7280; margin-top: 2px;">@item.Remarks</div>
                            }
                        </td>
                        <td>@item.ExamScheduleCode</td>
                        <td>@item.AcademicYear?.AcademicYearName</td>
                        <td>@item.Program?.ProgramName</td>
                        <td>@item.ExamType?.Name</td>
                        <td style="font-size: 11px;">@item.StartDateBs</td>
                        <td style="font-size: 11px;">@item.EndDateBs</td>
                        <td>@(item.IsActive ? "Active" : "Inactive")</td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: #9ca3af;">
                <p>No exam schedules found.</p>
            </div>
        }
    </div>

    <script>
        window.onload = function () { window.print(); };
    </script>
</body>
</html>
