@model FWU.Exam.Management.Domain.Entities.Exams.ExamSchedule
@using FWU.Exam.Management.Application.DTOs
@using FWU.Exam.Management.Domain.Enums

@{
    ViewData["Title"] = "Exam Schedule Details";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-indigo-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Exam Schedule Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8 space-y-6">
        <!-- Basic Information -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Schedule Name</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.ExamScheduleName)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Schedule Code</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.ExamScheduleCode)</p>
                </div>
            </div>
        </div>

        <!-- Academic Details -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Academic Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Academic Year</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.AcademicYear!.AcademicYearName)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Program</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Program!.ProgramName)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Semester</p>
                    <p class="mt-1 text-gray-800">@(Model.Semester?.Name ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Type</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExamType!.Name)</p>
                </div>
            </div>
        </div>

        <!-- Date & Time -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Date & Time</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Start Date (BS)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.StartDateBs)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">End Date (BS)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.EndDateBs)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Start Date (AD)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.StartDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">End Date (AD)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.EndDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Start Time</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.StartTime)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">End Time</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.EndTime)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Published Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.PublishedDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Extended Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExtendedDate)</p>
                </div>
            </div>
        </div>

        <!-- Other Details -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Other Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">College Approval Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.CollegeApprovalDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Admission Card Release Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.AdmissionCardReleaseDate)</p>
                </div>                
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Extended Date Charge</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExtendedDateCharge)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Fee (Flat)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExamFee)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Practical Fee (Per Subject)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.PracticalSubjectFee)</p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Remarks</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Remarks)</p>
                </div>
            </div>
        </div>

        <!-- College Approval Status -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                <i class="fas fa-check-double mr-2 text-amber-500"></i>College Approval Status
            </h2>

            @{
                var approvals = ViewBag.ScheduleApprovals as List<ScheduleApprovalStatusDto> ?? new();
                var hasApprovals = ViewBag.HasApprovals is bool ha && ha;
                var hasRejected = ViewBag.HasRejectedApprovals is bool hr && hr;
            }

            @if (!hasApprovals)
            {
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                    <p class="text-sm text-amber-800">
                        <i class="fas fa-info-circle mr-1"></i>
                        No college approval has been requested for this schedule. Set a
                        <strong>College Approval Date</strong> when editing to open approvals
                        for the colleges offering this program.
                    </p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 border-b">
                                <th class="px-3 py-2 text-left font-semibold text-gray-600">College</th>
                                <th class="px-3 py-2 text-left font-semibold text-gray-600">Requested Date</th>
                                <th class="px-3 py-2 text-left font-semibold text-gray-600">Status</th>
                                <th class="px-3 py-2 text-left font-semibold text-gray-600">Acted On / By</th>
                                <th class="px-3 py-2 text-left font-semibold text-gray-600">Proposed Date</th>
                                <th class="px-3 py-2 text-left font-semibold text-gray-600">Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var a in approvals)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-3 py-2 font-medium text-gray-800">@a.CollegeName</td>
                                    <td class="px-3 py-2 text-gray-700">@(a.RequestedApprovalDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td class="px-3 py-2">
                                        @switch (a.Status)
                                        {
                                            case ExamScheduleApprovalStatus.Pending:
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">Pending</span>
                                                break;
                                            case ExamScheduleApprovalStatus.Approved:
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Approved</span>
                                                break;
                                            case ExamScheduleApprovalStatus.Rejected:
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">Rejected</span>
                                                break;
                                        }
                                    </td>
                                    <td class="px-3 py-2 text-gray-700">
                                        @if (a.ApprovedDate.HasValue)
                                        {
                                            <span>@a.ApprovedDate.Value.ToString("yyyy-MM-dd")</span>
                                        }
                                        else if (a.RejectedDate.HasValue)
                                        {
                                            <span>@a.RejectedDate.Value.ToString("yyyy-MM-dd")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                        @if (!string.IsNullOrEmpty(a.ApprovedByName))
                                        {
                                            <div class="text-xs text-gray-500">by @a.ApprovedByName</div>
                                        }
                                    </td>
                                    <td class="px-3 py-2 text-gray-700">@(a.ProposedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td class="px-3 py-2 text-gray-700">@(string.IsNullOrEmpty(a.Remarks) ? "-" : a.Remarks)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (hasRejected)
                {
                    <form method="post" asp-action="Resubmit" asp-route-id="@Model.Id" class="mt-3"
                          onsubmit="return confirm('Change the College Approval Date (and optionally the exam dates) in Edit, then resubmit. Colleges that rejected will be asked again. Continue?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 text-white text-sm font-medium rounded-lg hover:bg-amber-600 transition-colors shadow-sm">
                            <i class="fas fa-redo text-xs"></i> Resubmit for College Approval
                        </button>
                    </form>
                    <p class="text-xs text-gray-500 mt-2">
                        Edit the schedule first to adjust the date based on the college's remarks/proposed date, then resubmit.
                    </p>
                }
            }
        </div>

        <!-- Student Enrollment Summary -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                <i class="fas fa-users mr-2 text-indigo-500"></i>Student Enrollment Summary
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-indigo-50 rounded-lg p-4 text-center border border-indigo-100">
                    <p class="text-2xl font-bold text-indigo-700">@ViewBag.TotalRegistrations</p>
                    <p class="text-xs font-medium text-indigo-600 mt-1">Total Registrations</p>
                </div>
                <div class="bg-green-50 rounded-lg p-4 text-center border border-green-100">
                    <p class="text-2xl font-bold text-green-700">@ViewBag.PaidCount</p>
                    <p class="text-xs font-medium text-green-600 mt-1">Payment Done</p>
                </div>
                <div class="bg-amber-50 rounded-lg p-4 text-center border border-amber-100">
                    <p class="text-2xl font-bold text-amber-700">@ViewBag.PendingCount</p>
                    <p class="text-xs font-medium text-amber-600 mt-1">Payment Pending</p>
                </div>
                <div class="bg-blue-50 rounded-lg p-4 text-center border border-blue-100">
                    <p class="text-2xl font-bold text-blue-700">@ViewBag.RegisteredCount</p>
                    <p class="text-xs font-medium text-blue-600 mt-1">Fully Registered</p>
                </div>
            </div>
            <div class="mt-4">
                <a asp-controller="ExamRegistrations" asp-action="Index" asp-area="Exams" asp-route-examScheduleId="@Model?.Id"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-list text-xs"></i> View All Registered Students
                </a>
            </div>
        </div>

        <!-- Status -->
        <div>
            <p class="text-xs sm:text-sm font-medium text-gray-600">Status</p>
            <div class="mt-1">
                @if (Model!.IsActive)
                {
                    <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">
                        <i class="fas fa-check-circle mr-1"></i> Active
                    </span>
                }
                else
                {
                    <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-500 rounded-full">
                        <i class="fas fa-circle mr-1"></i> Inactive
                    </span>
                }
            </div>
        </div>

        <!-- Exam Subjects -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                <i class="fas fa-book mr-2 text-indigo-500"></i>Exam Subjects
            </h2>

            @{
                var slots = ViewBag.ExamSlots as List<FWU.Exam.Management.Domain.Entities.Exams.ExamSlot> ?? new();
                var offerings = ViewBag.SubjectOfferings as List<FWU.Exam.Management.Domain.Entities.Subjects.SubjectOffering> ?? new();
                var slotsByOfferingId = ViewBag.ExistingSlotsByOfferingId as Dictionary<int, FWU.Exam.Management.Domain.Entities.Exams.ExamSlot> ?? new();
                var examCenters = ViewBag.ExamCenters as List<SelectListItem> ?? new();
                var batches = ViewBag.Batches as List<SelectListItem> ?? new();
            }

            @if (offerings.Any())
            {
                <form asp-action="SaveExamSlots" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examScheduleId" value="@Model.Id" />

                    <div class="flex flex-wrap items-center gap-3 mb-3">
                        <label class="text-xs font-medium text-gray-600">Batch (applies to all subjects)</label>
                        <select name="batchId" class="w-48 text-sm border border-gray-300 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <option value="0">-- Select Batch --</option>
                            @foreach (var item in batches)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm">
                            <thead>
                                <tr class="bg-gray-50 border-b">
                                    <th class="px-3 py-2 text-left font-semibold text-gray-600">S.N.</th>
                                    <th class="px-3 py-2 text-left font-semibold text-gray-600">Subject</th>
                                    <th class="px-3 py-2 text-left font-semibold text-gray-600">Exam Center</th>
                                    <th class="px-3 py-2 text-left font-semibold text-gray-600">Exam Date (BS)</th>
                                    <th class="px-3 py-2 text-center font-semibold text-gray-600">Start</th>
                                    <th class="px-3 py-2 text-center font-semibold text-gray-600">End</th>
                                    <th class="px-3 py-2 text-left font-semibold text-gray-600">Remarks</th>
                                    <th class="px-3 py-2 text-center font-semibold text-gray-600">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @for (int i = 0; i < offerings.Count; i++)
                                {
                                    var offering = offerings[i];
                                    var slot = slotsByOfferingId.TryGetValue(offering.Id, out var existingSlot) ? existingSlot : null;
                                    <tr class="hover:bg-gray-50 align-top">
                                        <td class="px-3 py-2 font-medium text-gray-700 whitespace-nowrap">@(i + 1)</td>
                                        <td class="px-3 py-2">
                                            <input type="hidden" name="subjectOfferingId" value="@offering.Id" />
                                            <div class="font-semibold text-gray-800">@(offering.SubjectCatalog?.SubjectCode ?? "-") - @(offering.SubjectCatalog?.SubjectName ?? "-")</div>
                                            <div class="text-xs text-gray-500 mt-0.5">
                                                @if (offering.HasTheory) { <span class="mr-2"><i class="fas fa-book-open mr-1 text-indigo-400"></i>Theory</span> }
                                                @if (offering.HasPractical) { <span><i class="fas fa-flask mr-1 text-green-500"></i>Practical</span> }
                                            </div>
                                        </td>
                                        <td class="px-3 py-2">
                                            <select name="examCenterId" class="w-36 text-sm border border-gray-300 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                                                <option value="0">-- Select --</option>
                                                @foreach (var item in examCenters)
                                                {
                                                    if (slot?.ExamCenterId.ToString() == item.Value)
                                                    {
                                                        <option value="@item.Value" selected>@item.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td class="px-3 py-2">
                                            <input type="text" name="examDate" value="@(slot?.ExamDate)" placeholder="YYYY-MM-DD" class="w-28 text-sm border border-gray-300 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input type="time" name="startTime" value="@(slot?.StartTime.ToString("HH:mm") ?? Model.StartTime.ToString("HH:mm"))" class="w-28 text-sm border border-gray-300 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input type="time" name="endTime" value="@(slot?.EndTime.ToString("HH:mm") ?? Model.EndTime.ToString("HH:mm"))" class="w-28 text-sm border border-gray-300 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input type="text" name="remarks" value="@(slot?.Remarks)" placeholder="Remarks" class="w-28 text-sm border border-gray-300 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                                        </td>
                                        <td class="px-3 py-2 text-center whitespace-nowrap">
                                            @if (slot != null)
                                            {
                                                <button type="submit" form="deleteExamSlot-@slot.Id" onclick="return confirm('Remove this subject from the schedule?')" class="text-red-500 hover:text-red-700 hover:bg-red-50 rounded p-1 transition" title="Remove subject">
                                                    <i class="fas fa-trash-alt text-xs"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-gray-300">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 flex items-center justify-between gap-3">
                        <p class="text-xs text-gray-500">
                            Pick the batch above (applies to all subjects) and an exam center per subject to schedule it; subjects without a center are left unscheduled. Times default to the schedule's start/end.
                        </p>
                        <button type="submit" class="px-6 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition shadow-md">
                            <i class="fas fa-save mr-1"></i> Save All Subjects
                        </button>
                    </div>
                </form>

                @foreach (var slot in slots)
                {
                    <form id="deleteExamSlot-@slot.Id" asp-action="DeleteExamSlot" method="post" class="hidden">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@slot.Id" />
                        <input type="hidden" name="examScheduleId" value="@Model.Id" />
                    </form>
                }
            }
            else
            {
                <p class="text-gray-400 text-sm italic py-4 text-center">No subjects found for this program, semester and curriculum version.</p>
            }
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-8 border-t border-gray-200">
            <a asp-action="Edit" asp-area="Exams" asp-route-id="@Model?.Id"
               class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <a asp-action="Index" asp-area="Exams"
               class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
