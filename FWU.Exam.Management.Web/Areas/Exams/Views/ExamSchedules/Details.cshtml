@model FWU.Exam.Management.Domain.Entities.Exams.ExamSchedule

@{
    ViewData["Title"] = "Exam Schedule Details";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-indigo-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Exam Schedule Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8 space-y-6">
        <!-- Basic Information -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Schedule Name</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.ExamScheduleName)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Schedule Code</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.ExamScheduleCode)</p>
                </div>
            </div>
        </div>

        <!-- Academic Details -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Academic Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Academic Year</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.AcademicYear.AcademicYearName)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Program</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Program.ProgramName)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Type</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExamType.Name)</p>
                </div>
            </div>
        </div>

        <!-- Date & Time -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Date & Time</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Start Date (BS)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.StartDateBs)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">End Date (BS)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.EndDateBs)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Start Date (AD)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.StartDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">End Date (AD)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.EndDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Start Time</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.StartTime)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">End Time</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.EndTime)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Published Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.PublishedDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Extended Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExtendedDate)</p>
                </div>
            </div>
        </div>

        <!-- Other Details -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Other Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">College Approval Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.CollegeApprovalDate)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Admission Card Release Date</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.AdmissionCardReleaseDate)</p>
                </div>                
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Extended Date Charge</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExtendedDateCharge)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Exam Fee (Flat)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ExamFee)</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Practical Fee (Per Subject)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.PracticalSubjectFee)</p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Remarks</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Remarks)</p>
                </div>
            </div>
        </div>

        <!-- Student Enrollment Summary -->
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                <i class="fas fa-users mr-2 text-indigo-500"></i>Student Enrollment Summary
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-indigo-50 rounded-lg p-4 text-center border border-indigo-100">
                    <p class="text-2xl font-bold text-indigo-700">@ViewBag.TotalRegistrations</p>
                    <p class="text-xs font-medium text-indigo-600 mt-1">Total Registrations</p>
                </div>
                <div class="bg-green-50 rounded-lg p-4 text-center border border-green-100">
                    <p class="text-2xl font-bold text-green-700">@ViewBag.PaidCount</p>
                    <p class="text-xs font-medium text-green-600 mt-1">Payment Done</p>
                </div>
                <div class="bg-amber-50 rounded-lg p-4 text-center border border-amber-100">
                    <p class="text-2xl font-bold text-amber-700">@ViewBag.PendingCount</p>
                    <p class="text-xs font-medium text-amber-600 mt-1">Payment Pending</p>
                </div>
                <div class="bg-blue-50 rounded-lg p-4 text-center border border-blue-100">
                    <p class="text-2xl font-bold text-blue-700">@ViewBag.RegisteredCount</p>
                    <p class="text-xs font-medium text-blue-600 mt-1">Fully Registered</p>
                </div>
            </div>
            <div class="mt-4">
                <a asp-controller="ExamRegistrations" asp-action="Index" asp-area="Exams" asp-route-examScheduleId="@Model?.Id"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fas fa-list text-xs"></i> View All Registered Students
                </a>
            </div>
        </div>

        <!-- Status -->
        <div>
            <p class="text-xs sm:text-sm font-medium text-gray-600">Status</p>
            <div class="mt-1">
                @if (Model.IsActive)
                {
                    <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">
                        <i class="fas fa-check-circle mr-1"></i> Active
                    </span>
                }
                else
                {
                    <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-500 rounded-full">
                        <i class="fas fa-circle mr-1"></i> Inactive
                    </span>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-8 border-t border-gray-200">
            <a asp-action="Edit" asp-area="Exams" asp-route-id="@Model?.Id"
               class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <a asp-action="Index" asp-area="Exams"
               class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
