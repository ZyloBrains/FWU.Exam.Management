@model FWU.Exam.Management.Domain.Entities.Exams.ExamSchedule

@{
    ViewData["Title"] = "Create Exam Schedule";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-indigo-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Create Exam Schedule</h1>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" asp-area="Exams" method="post" id="examScheduleForm" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>

            <!-- Section: Basic Information -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="ExamScheduleName" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Exam Schedule Name <span class="text-red-500">*</span></label>
                        <input asp-for="ExamScheduleName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., Final Examination 2024" />
                        <span asp-validation-for="ExamScheduleName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ExamScheduleCode" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ExamScheduleCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., EXAM-2024-001" />
                        <span asp-validation-for="ExamScheduleCode" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Academic Details -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Academic Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Batch Year <span class="text-red-500">*</span></label>
                        <select id="AcademicYearId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <option value="">-- Select Batch Year --</option>
                            @if (ViewBag.AcademicYearId is SelectList academicYears)
                            {
                                foreach (var ay in academicYears)
                                {
                                    <option value="@ay.Value">@ay.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="ProgramId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="ProgramId" id="ProgramId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.ProgramId">
                            <option value="">-- Select Program --</option>
                        </select>
                        <span asp-validation-for="ProgramId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ExamTypeId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="ExamTypeId" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.ExamTypeId">
                            <option value="">-- Select Exam Type --</option>
                        </select>
                        <span asp-validation-for="ExamTypeId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SemesterInstanceId" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="SemesterInstanceId" id="SemesterInstanceId" disabled="disabled" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <option value="">-- Select Semester --</option>
                        </select>
                        <span asp-validation-for="SemesterInstanceId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Date & Time -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Date & Time</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="PublishedDate" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="PublishedDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="PublishedDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <input type="hidden" asp-for="StartDateBs" />
                    <input type="hidden" asp-for="EndDateBs" />
                    <div>
                        <label asp-for="StartDate" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Start Date (AD)</label>
                        <input asp-for="StartDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="StartDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="EndDate" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">End Date (AD)</label>
                        <input asp-for="EndDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="EndDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="StartTime" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="StartTime" type="time" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="StartTime" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="EndTime" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="EndTime" type="time" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="EndTime" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Fee Configuration -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Fee Configuration</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ExamFee" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Exam Fee (Flat)</label>
                        <input asp-for="ExamFee" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., 2400" />
                        <span asp-validation-for="ExamFee" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="PracticalSubjectFee" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Practical Fee (Per Subject)</label>
                        <input asp-for="PracticalSubjectFee" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., 200" />
                        <span asp-validation-for="PracticalSubjectFee" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Remarks & Status -->
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Remarks & Status</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Remarks" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1"></label>
                        <textarea asp-for="Remarks" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
                        <span asp-validation-for="Remarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="flex items-center gap-3">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-indigo-600 rounded focus:ring-indigo-500" />
                        <label asp-for="IsActive" class="text-xs sm:text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" asp-area="Exams" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #6366f1;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
        }
    </style>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function resetSelect(selectId, placeholder) {
            var el = $(selectId);
            if (el.data('select2')) el.select2('destroy');
            el.empty().append('<option value="">' + placeholder + '</option>');
            el.prop('disabled', true).select2({ width: 'resolve' });
        }

        function loadSemesters(academicYearId, programId) {
            resetSelect('#SemesterInstanceId', '-- Select Semester --');

            if (!academicYearId || !programId) return;

            $.getJSON(tenantUrl("/Exams/ExamSchedules/GetSemestersByAcademicYear"), { academicYearId: academicYearId, programId: programId }, function (data) {
                var el = $('#SemesterInstanceId');
                $.each(data, function (i, s) {
                    el.append('<option value="' + s.id + '">' + s.name + '</option>');
                });
                el.prop('disabled', false).select2({ width: 'resolve' });
            });
        }

        $(function () {
            $('#AcademicYearId').select2({ width: 'resolve' });
            $('#ProgramId').select2({ width: 'resolve' });

            $('#AcademicYearId').on('change', function () {
                var pid = $('#ProgramId').val();
                if (pid) {
                    loadSemesters($(this).val(), pid);
                }
            });

            $('#ProgramId').on('change', function () {
                var pid = $(this).val();
                if (pid) {
                    loadSemesters($('#AcademicYearId').val(), pid);
                } else {
                    resetSelect('#SemesterInstanceId', '-- Select Semester --');
                }
            });
        });

        var startDateTimer;
        var endDateTimer;
        $("#StartDate").on("input", function () {
            var ad = $(this).val().trim();
            if (ad.length >= 8) {
                clearTimeout(startDateTimer);
                startDateTimer = setTimeout(function () {
                    $.get(tenantUrl("/Exams/ExamSchedules/ConvertAdToBs"), { adDate: ad }, function (data) {
                        if (data.bsDate) $("#StartDateBs").val(data.bsDate);
                    });
                }, 300);
            }
        });
        $("#EndDate").on("input", function () {
            var ad = $(this).val().trim();
            if (ad.length >= 8) {
                clearTimeout(endDateTimer);
                endDateTimer = setTimeout(function () {
                    $.get(tenantUrl("/Exams/ExamSchedules/ConvertAdToBs"), { adDate: ad }, function (data) {
                        if (data.bsDate) $("#EndDateBs").val(data.bsDate);
                    });
                }, 300);
            }
        });
    </script>
}
