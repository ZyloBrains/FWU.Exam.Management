@model FWU.Exam.Management.Domain.Entities.GradingScheme

@{
    ViewData["Title"] = "Grading Scheme Details";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-star text-purple-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Grading Scheme Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8 space-y-6">
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Scheme Name</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Model.Name</p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Programs</p>
                    <p class="mt-1 text-gray-800">
                        @{
                            var dPrograms = Model.ProgramAssignments?.Select(gsp => gsp.Program?.ProgramName ?? "") ?? Enumerable.Empty<string>();
                            var dProgramList = string.Join(", ", dPrograms.Where(p => !string.IsNullOrEmpty(p)));
                        }
                        @(string.IsNullOrEmpty(dProgramList) ? "-" : dProgramList)
                    </p>
                </div>
                <div>
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Status</p>
                    <p class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full"><i class="fas fa-check-circle mr-1"></i> Active</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-500 rounded-full"><i class="fas fa-circle mr-1"></i> Inactive</span>
                        }
                    </p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Description</p>
                    <p class="mt-1 text-gray-800">@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</p>
                </div>
            </div>
        </div>

        <div>
            <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Grade Definitions</h2>
            @if (Model.GradeDefinitions != null && Model.GradeDefinitions.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 border-b">
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Grade</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Min %</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Max %</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Grade Point</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Pass</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Order</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Remark</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var gd in Model.GradeDefinitions.OrderBy(g => g.DisplayOrder))
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-3 py-2 font-semibold text-gray-800">@gd.GradeLetter</td>
                                    <td class="px-3 py-2 text-gray-600">@gd.MinPercentage</td>
                                    <td class="px-3 py-2 text-gray-600">@gd.MaxPercentage</td>
                                    <td class="px-3 py-2 text-gray-600">@gd.GradePoint</td>
                                    <td class="px-3 py-2">
                                        @if (gd.IsPass)
                                        {
                                            <span class="text-green-600"><i class="fas fa-check"></i></span>
                                        }
                                        else
                                        {
                                            <span class="text-red-600"><i class="fas fa-times"></i></span>
                                        }
                                    </td>
                                    <td class="px-3 py-2 text-gray-600">@gd.DisplayOrder</td>
                                    <td class="px-3 py-2 text-gray-600">@(gd.Remark ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-sm text-gray-500 italic">No grade definitions defined.</p>
            }
        </div>

        <div class="flex items-center gap-4 pt-6 mt-8 border-t border-gray-200">
            <a asp-action="Edit" asp-area="Exams" asp-route-id="@Model.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <a asp-action="Index" asp-area="Exams" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
