@model FWU.Exam.Management.Domain.Entities.GradingScheme

@{
    ViewData["Title"] = "Create Grading Scheme";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-star text-purple-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Grading Scheme</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" asp-area="Exams" method="post" class="space-y-6" id="gradingForm">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>

            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Scheme Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="Name" class="text-sm font-medium text-gray-700 block mb-1">Scheme Name <span class="text-red-500">*</span></label>
                        <input asp-for="Name" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., Bachelor Grading 2024" />
                        <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ProgramId" class="text-sm font-medium text-gray-700 block mb-1">Program <span class="text-red-500">*</span></label>
                        <select asp-for="ProgramId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.ProgramId">
                            <option value="">-- Select Program --</option>
                        </select>
                        <span asp-validation-for="ProgramId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="AcademicYearId" class="text-sm font-medium text-gray-700 block mb-1">Academic Year</label>
                        <select asp-for="AcademicYearId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.AcademicYearId">
                            <option value="">-- Select Academic Year --</option>
                        </select>
                        <span asp-validation-for="AcademicYearId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Description" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <textarea asp-for="Description" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Optional description"></textarea>
                        <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="flex items-center gap-3 pt-4">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-indigo-600 rounded focus:ring-indigo-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Grade Definitions</h2>
                <p class="text-sm text-gray-500 mb-3">Define the grade letters, percentage ranges, and grade points.</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border-collapse" id="gradeTable">
                        <thead>
                            <tr class="bg-gray-50 border-b">
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Grade</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Min %</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Max %</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Grade Point</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Pass</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Order</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Remark</th>
                                <th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase"></th>
                            </tr>
                        </thead>
                        <tbody id="gradeBody">
                            @if (Model.GradeDefinitions != null)
                            {
                                for (int i = 0; i < Model.GradeDefinitions.Count; i++)
                                {
                                    <tr class="grade-row border-b hover:bg-gray-50">
                                        <td class="px-3 py-2">
                                            <input name="gd_letter" value="@Model.GradeDefinitions.ElementAt(i).GradeLetter" class="w-16 border border-gray-300 rounded px-2 py-1 text-sm" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input name="gd_min" value="@Model.GradeDefinitions.ElementAt(i).MinPercentage" type="number" step="0.01" class="w-20 border border-gray-300 rounded px-2 py-1 text-sm" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input name="gd_max" value="@Model.GradeDefinitions.ElementAt(i).MaxPercentage" type="number" step="0.01" class="w-20 border border-gray-300 rounded px-2 py-1 text-sm" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input name="gd_point" value="@Model.GradeDefinitions.ElementAt(i).GradePoint" type="number" step="0.1" class="w-20 border border-gray-300 rounded px-2 py-1 text-sm" />
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <input name="gd_pass" type="checkbox" checked="@Model.GradeDefinitions.ElementAt(i).IsPass" class="w-4 h-4" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input name="gd_order" value="@(i + 1)" type="number" class="w-16 border border-gray-300 rounded px-2 py-1 text-sm" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <input name="gd_remark" value="@Model.GradeDefinitions.ElementAt(i).Remark" class="w-28 border border-gray-300 rounded px-2 py-1 text-sm" />
                                        </td>
                                        <td class="px-3 py-2">
                                            <button type="button" onclick="this.closest('tr').remove()" class="text-red-500 hover:text-red-700 text-xs">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <button type="button" onclick="addGradeRow()" class="mt-3 px-3 py-1.5 text-sm text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100">
                    <i class="fas fa-plus mr-1"></i> Add Grade
                </button>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" asp-area="Exams" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        function collectGradeData() {
            var letters = [], mins = [], maxs = [], points = [], remarks = [], passes = [], orders = [];
            var rows = document.querySelectorAll('.grade-row');
            rows.forEach(function(row) {
                var inputs = row.querySelectorAll('input');
                letters.push(inputs[0].value);
                mins.push(inputs[1].value || '0');
                maxs.push(inputs[2].value || '0');
                points.push(inputs[3].value || '0');
                passes.push(inputs[4].checked ? 'true' : 'false');
                orders.push(inputs[5].value || '0');
                remarks.push(inputs[6].value || '');
            });
            var form = document.getElementById('gradingForm');
            appendHidden(form, 'gradeLetters', letters.join(','));
            appendHidden(form, 'minPercentages', mins.join(','));
            appendHidden(form, 'maxPercentages', maxs.join(','));
            appendHidden(form, 'gradePoints', points.join(','));
            appendHidden(form, 'isPasses', passes.join(','));
            appendHidden(form, 'displayOrders', orders.join(','));
            appendHidden(form, 'remarks', remarks.join(','));
        }

        function appendHidden(form, name, value) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        }

        document.getElementById('gradingForm').addEventListener('submit', function(e) {
            collectGradeData();
        });

        function addGradeRow() {
            var tbody = document.getElementById('gradeBody');
            var row = document.createElement('tr');
            row.className = 'grade-row border-b hover:bg-gray-50';
            row.innerHTML = `
                <td class="px-3 py-2"><input name="gd_letter" value="" class="w-16 border border-gray-300 rounded px-2 py-1 text-sm" /></td>
                <td class="px-3 py-2"><input name="gd_min" value="" type="number" step="0.01" class="w-20 border border-gray-300 rounded px-2 py-1 text-sm" /></td>
                <td class="px-3 py-2"><input name="gd_max" value="" type="number" step="0.01" class="w-20 border border-gray-300 rounded px-2 py-1 text-sm" /></td>
                <td class="px-3 py-2"><input name="gd_point" value="" type="number" step="0.1" class="w-20 border border-gray-300 rounded px-2 py-1 text-sm" /></td>
                <td class="px-3 py-2 text-center"><input name="gd_pass" type="checkbox" class="w-4 h-4" /></td>
                <td class="px-3 py-2"><input name="gd_order" value="" type="number" class="w-16 border border-gray-300 rounded px-2 py-1 text-sm" /></td>
                <td class="px-3 py-2"><input name="gd_remark" value="" class="w-28 border border-gray-300 rounded px-2 py-1 text-sm" /></td>
                <td class="px-3 py-2"><button type="button" onclick="this.closest('tr').remove()" class="text-red-500 hover:text-red-700 text-xs"><i class="fas fa-times"></i></button></td>
            `;
            tbody.appendChild(row);
        }
    </script>
}
