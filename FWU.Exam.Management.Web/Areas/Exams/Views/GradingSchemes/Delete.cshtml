@model FWU.Exam.Management.Domain.Entities.GradingScheme

@{
    ViewData["Title"] = "Delete Grading Scheme";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Exams" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-star text-red-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Delete Grading Scheme</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this grading scheme? This action cannot be undone.
                </p>
            </div>
        </div>

        <div class="space-y-6">
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Scheme Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Name</p>
                        <p class="text-gray-800 font-medium">@Model.Name</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Program</p>
                        <p class="text-gray-800 font-medium">@Model.Program?.ProgramName</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Academic Year</p>
                        <p class="text-gray-800 font-medium">@Model.AcademicYear?.AcademicYearName</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</p>
                        <p class="text-gray-800 font-medium">@(Model.IsActive ? "Active" : "Inactive")</p>
                    </div>
                </div>
            </div>

            @if (Model.GradeDefinitions != null && Model.GradeDefinitions.Any())
            {
                <div>
                    <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Grade Definitions (@Model.GradeDefinitions.Count)</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left border-collapse">
                            <thead><tr class="bg-gray-50 border-b"><th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Grade</th><th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Range</th><th class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Grade Point</th></tr></thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var gd in Model.GradeDefinitions.OrderBy(g => g.DisplayOrder))
                                {
                                    <tr><td class="px-3 py-2 font-semibold">@gd.GradeLetter</td><td class="px-3 py-2">@gd.MinPercentage% - @gd.MaxPercentage%</td><td class="px-3 py-2">@gd.GradePoint</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <form asp-action="Delete" asp-area="Exams" method="post" class="mt-8">
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this grading scheme? This action cannot be undone.');"
                        class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" asp-area="Exams" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">Cancel</a>
            </div>
        </form>
    </div>
</div>
