@model IEnumerable<FWU.Exam.Management.Domain.Entities.GradingScheme>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Grading Schemes Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; color: #374151; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { border: 1px solid #d1d5db; padding: 8px; font-size: 12px; vertical-align: top; }
        th { background: #f3f4f6; }
        .footer { margin-top: 30px; font-size: 11px; color: #6b7280; text-align: center; }
    </style>
</head>
<body>
    <div>
        <h2 style="margin: 0 0 10px 0;">Grading Schemes Report</h2>
        <table>
            <thead>
                <tr>
                    <th>#</th><th>Name</th><th>Programs</th><th>Grades</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{ var counter = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center;">@counter</td>
                        <td><strong>@item.Name</strong></td>
                        <td>
                            @{
                                var pdfPrograms = item.ProgramAssignments?.Select(gsp => gsp.Program?.ProgramName ?? "") ?? Enumerable.Empty<string>();
                                var pdfProgramList = string.Join(", ", pdfPrograms.Where(p => !string.IsNullOrEmpty(p)));
                            }
                            @(string.IsNullOrEmpty(pdfProgramList) ? "-" : pdfProgramList)
                        </td>
                        <td>@(item.GradeDefinitions?.Count ?? 0)</td>
                        <td>@(item.IsActive ? "Active" : "Inactive")</td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: #9ca3af;"><p>No grading schemes found.</p></div>
        }
    </div>
    <script>window.onload = function () { window.print(); };</script>
</body>
</html>
