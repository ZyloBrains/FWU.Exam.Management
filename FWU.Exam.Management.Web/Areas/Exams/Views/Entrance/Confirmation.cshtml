@model EntranceExamApplication

@{
    ViewData["Title"] = "Application Submitted";
}

<div class="min-h-[60vh] flex items-center justify-center">
    <div class="max-w-lg w-full mx-auto text-center">
        <div class="bg-white rounded-xl shadow-lg p-8">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-check-circle text-3xl text-green-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Application Submitted!</h1>
            <p class="text-gray-500 mb-6">
                Your entrance exam application has been received successfully.
            </p>
            <div class="bg-gray-50 rounded-lg p-4 text-left space-y-2 mb-6">
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Application ID</span>
                    <span class="font-semibold text-gray-800">@Model.Id</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Full Name</span>
                    <span class="font-semibold text-gray-800">@(Model.FirstName + " " + Model.LastName)</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Program</span>
                    <span class="font-semibold text-gray-800">@Model.Program?.ProgramName</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">College</span>
                    <span class="font-semibold text-gray-800">@Model.College?.Name</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Status</span>
                    <span class="px-2 py-0.5 text-xs font-medium bg-yellow-100 text-yellow-700 rounded-full">Submitted</span>
                </div>
            </div>
            <p class="text-sm text-gray-400 mb-6">Please save your Application ID for future reference. The admin will review your application and you will be notified of the decision.</p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-6 py-2.5 bg-cyan-600 text-white text-sm font-medium rounded-lg hover:bg-cyan-700 transition-colors">
                <i class="fas fa-home text-xs"></i> Back to Home
            </a>
        </div>
    </div>
</div>
