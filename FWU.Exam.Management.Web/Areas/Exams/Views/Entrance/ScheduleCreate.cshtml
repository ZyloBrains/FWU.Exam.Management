@model EntranceSchedule

@{
    ViewData["Title"] = "Create Entrance Schedule";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-plus text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-xl font-semibold text-gray-800">Create Entrance Schedule</h1>
                <p class="text-sm text-gray-500 mt-0.5">Set the open and close dates for the entrance application form</p>
            </div>
        </div>

        <div class="px-6 py-6">
            <form asp-action="ScheduleCreate" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="AcademicYearId" class="block text-sm font-medium text-gray-700 mb-1">Academic Year *</label>
                        <select asp-for="AcademicYearId" asp-items="ViewBag.AcademicYearId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                            <option value="">Select Academic Year</option>
                        </select>
                        <span asp-validation-for="AcademicYearId" class="text-red-600 text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="ProgramId" class="block text-sm font-medium text-gray-700 mb-1">Program *</label>
                        <select asp-for="ProgramId" asp-items="ViewBag.ProgramId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                            <option value="">Select Program</option>
                        </select>
                        <span asp-validation-for="ProgramId" class="text-red-600 text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College *</label>
                        <select asp-for="CollegeId" asp-items="ViewBag.CollegeId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                            <option value="">Select College</option>
                        </select>
                        <span asp-validation-for="CollegeId" class="text-red-600 text-xs"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FormOpenDate" class="block text-sm font-medium text-gray-700 mb-1">Form Open Date *</label>
                        <input asp-for="FormOpenDate" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                        <span asp-validation-for="FormOpenDate" class="text-red-600 text-xs"></span>
                        <p class="text-xs text-gray-400 mt-1">Applications open at this date/time</p>
                    </div>
                    <div>
                        <label asp-for="FormCloseDate" class="block text-sm font-medium text-gray-700 mb-1">Form Close Date *</label>
                        <input asp-for="FormCloseDate" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                        <span asp-validation-for="FormCloseDate" class="text-red-600 text-xs"></span>
                        <p class="text-xs text-gray-400 mt-1">Applications close at this date/time</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="IsActive" class="rounded border-gray-300 text-teal-600 focus:ring-teal-500" />
                    <label asp-for="IsActive" class="text-sm text-gray-700">Active (form is open immediately if dates include current time)</label>
                </div>

                <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                    <button type="submit" class="inline-flex items-center px-6 py-2.5 bg-teal-600 text-white rounded-lg text-sm font-medium hover:bg-teal-700 transition shadow-sm">
                        <i class="fas fa-save text-xs mr-2"></i> Create Schedule
                    </button>
                    <a asp-action="Schedules" class="inline-flex items-center px-4 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50 transition">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
