                        </button>
                    </div>
                    <div class="flex items-center gap-3">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-sm text-gray-500 hover:text-gray-700 transition">Cancel</a>
                        <button type="button" id="nextBtn" class="inline-flex items-center gap-2 px-5 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition shadow-sm">
                            Next <i class="fas fa-arrow-right text-xs"></i>
                        </button>
                        <button type="submit" id="submitBtn" class="hidden inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-teal-600 to-cyan-600 text-white text-sm font-semibold rounded-lg hover:from-teal-700 hover:to-cyan-700 transition shadow-md">
                            <i class="fas fa-paper-plane text-xs"></i> @(isEditing ? "Update Application" : "Submit Application")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
