@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            var currentStep = 1;
            var totalSteps = 5;

            // Get existing address data for pre-population
            var addrData = $('#existingAddressData');
            var existingProvinceId = addrData.length ? parseInt(addrData.data('province-id')) : 0;
            var existingDistrictId = addrData.length ? parseInt(addrData.data('district-id')) : 0;
            var existingLocalLevelId = addrData.length ? parseInt(addrData.data('local-level-id')) : 0;

            function updateStep(step) {
                currentStep = step;
                var $next = $('#step' + step);
                $next.removeClass('hidden');
                // Re-init Select2 in the now-visible step (was hidden when Select2 first initialized)
                $next.find('.select2').each(function () {
                    var $el = $(this);
                    $el.select2('destroy');
                    $el.select2({
                        width: '100%',
                        placeholder: function () { return $(this).find('option:first').text(); },
                        allowClear: false
                    }).on('change', function () {
                        if (typeof validateSingleField === 'function') validateSingleField($(this));
                    });
                });
                setTimeout(function () { $next.addClass('fade-in'); }, 10);

                $('.step-indicator').each(function () {
                    var s = parseInt($(this).data('step'));
                    var circle = $(this).find('div:first');
                    var label = $(this).find('span');
                    if (s < step) {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-teal-600');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-teal-600');
                    } else if (s === step) {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-teal-600');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-teal-600');
                    } else {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-gray-200');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-gray-400');
                    }
                });

                $('.step-line').each(function () {
                    var s = parseInt($(this).data('step'));
                    if (s < step) {
                        $(this).removeClass('bg-gray-200').addClass('bg-teal-500');
                    } else {
                        $(this).removeClass('bg-teal-500').addClass('bg-gray-200');
                    }
                });

                $('#prevBtn').toggleClass('hidden', step === 1);
                $('#nextBtn').toggleClass('hidden', step === totalSteps);
                $('#submitBtn').toggleClass('hidden', step !== totalSteps);
            }

            function validateStep(step) {
                if (step === 2) {
                    var fn = $('#FirstName').val();
                    var ln = $('#LastName').val();
                    var g = $('#GenderId').val();
                    var dob = $('#DateOfBirthBS').val();
                    var em = $('#Email').val();
                    var mob = $('#ContactNumber').val();
                    if (!fn || !ln || !g || !dob || !em || !mob) {
                        alert('Please fill in all required fields (First Name, Last Name, Gender, Date of Birth, Email, Mobile No).');
                        return false;
                    }
                }
                if (step === 3) {
                    if (!$('#WardNumber').val()) {
                        alert('Please enter Ward Number.');
                        return false;
                    }
                }
                return true;
            }

            function updateReviewSummary() {
                var progText = $('.program-display-text').length
                    ? $('.program-display-text').text()
                    : ($('input[name="ProgramId"]').val() || '-');
                var html = '<table class="w-full text-sm">';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Name:</td><td class="py-1 text-gray-800">' +
                    ($('#FirstName').val() || '') + ' ' + ($('#MiddleName').val() || '') + ' ' + ($('#LastName').val() || '') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Email:</td><td class="py-1 text-gray-800">' + ($('#Email').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Mobile:</td><td class="py-1 text-gray-800">' + ($('#ContactNumber').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Gender:</td><td class="py-1 text-gray-800">' + ($('#GenderId option:selected').text() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Date of Birth (BS):</td><td class="py-1 text-gray-800">' + ($('#DateOfBirthBS').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Father\'s Name:</td><td class="py-1 text-gray-800">' + ($('#FatherName').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Program:</td><td class="py-1 text-gray-800">' + progText + '</td></tr>';
                html += '</table>';
                $('#reviewSummary').html(html);
            }

            // File validation
            function validateFile(input, allowedExts, maxBytes, sizeLabel, errorEl) {
                if (!input.files.length) return true;
                var file = input.files[0];
                var ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
                if (allowedExts.indexOf(ext) === -1) {
                    $(errorEl).text('Invalid file type. Allowed: ' + allowedExts.join(', ')).removeClass('hidden');
                    return false;
                }
                if (file.size > maxBytes) {
                    $(errorEl).text('File must be less than ' + sizeLabel + '.').removeClass('hidden');
                    return false;
                }
                $(errorEl).addClass('hidden');
                return true;
            }

            $('#PhotoFile').change(function () {
                validateFile(this, ['.jpg', '.jpeg', '.png'], 500 * 1024, '500 KB', '#PhotoFileError');
            });
            $('#DocumentsFile').change(function () {
                validateFile(this, ['.pdf', '.jpg', '.jpeg', '.png', '.doc', '.docx'], 2 * 1024 * 1024, '2 MB', '#DocumentsFileError');
            });
            $('#VoucherFile').change(function () {
                validateFile(this, ['.pdf', '.jpg', '.jpeg', '.doc', '.docx'], 2 * 1024 * 1024, '2 MB', '#VoucherFileError');
            });

            $('#nextBtn').click(function () {
                if (!validateStep(currentStep)) return;
                if (currentStep === 4) updateReviewSummary();
                if (currentStep < totalSteps) updateStep(currentStep + 1);
            });

            $('#prevBtn').click(function () {
                if (currentStep > 1) updateStep(currentStep - 1);
            });

            $('#submitBtn').click(function (e) {
                if (!$('#agreeCheck').is(':checked')) {
                    e.preventDefault();
                    alert('Please agree to the declaration before submitting.');
                    return;
                }
                // Validate files before submit
                var ok = true;
                if ($('#PhotoFile')[0].files.length) {
                    ok = validateFile($('#PhotoFile')[0], ['.jpg', '.jpeg', '.png'], 500 * 1024, '500 KB', '#PhotoFileError') && ok;
                }
                if ($('#DocumentsFile')[0].files.length) {
                    ok = validateFile($('#DocumentsFile')[0], ['.pdf', '.jpg', '.jpeg', '.png', '.doc', '.docx'], 2 * 1024 * 1024, '2 MB', '#DocumentsFileError') && ok;
                }
                if ($('#VoucherFile')[0].files.length) {
                    ok = validateFile($('#VoucherFile')[0], ['.pdf', '.jpg', '.jpeg', '.doc', '.docx'], 2 * 1024 * 1024, '2 MB', '#VoucherFileError') && ok;
                }
                if (!ok) {
                    e.preventDefault();
                    alert('Please fix file upload errors before submitting.');
                }
            });

            // Province/District/LocalLevel cascading
            function loadProvinces(callback) {
                $.get(tenantUrl("/Exams/Entrance/GetProvinces"), function (data) {
                    var ps = $("#ProvinceId");
                    ps.empty();
                    ps.append('<option value="">Select Province</option>');
                    $.each(data, function (i, item) {
                        ps.append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                    ps.select2({width:'resolve'});
                    if (callback) callback();
                });
            }

            function loadDistricts(provinceId, callback) {
                $('#DistrictId').select2('destroy');
                $('#LocalLevelId').select2('destroy');

                if (!provinceId) {
                    $("#DistrictId").empty().append('<option value="">Select District</option>');
                    $('#DistrictId').select2({width:'resolve'});
                    if (callback) callback();
                    return;
                }

                $.get(tenantUrl("/Exams/Entrance/GetDistrictsByProvince"),
                    { provinceId: provinceId },
                    function (data) {
                        var dd = $("#DistrictId");
                        dd.empty().append('<option value="">Select District</option>');
                        $.each(data, function (i, item) {
                            dd.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                        dd.select2({width:'resolve'});
                        if (callback) callback();
                    });
            }

            function loadLocalLevels(districtId, callback) {
                $('#LocalLevelId').select2('destroy');

                if (!districtId) {
                    $("#LocalLevelId").empty().append('<option value="">Select Local Level</option>');
                    $('#LocalLevelId').select2({width:'resolve'});
                    if (callback) callback();
                    return;
                }

                $.get(tenantUrl("/Exams/Entrance/GetLocalLevelsByDistrict"),
                    { districtId: districtId },
                    function (data) {
                        var ll = $("#LocalLevelId");
                        ll.empty().append('<option value="">Select Local Level</option>');
                        $.each(data, function (i, item) {
                            ll.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                        ll.select2({width:'resolve'});
                        if (callback) callback();
                    });
            }

            // Pre-populate address cascading if editing
            function initAddressCascading() {
                loadProvinces(function () {
                    if (existingProvinceId) {
                        loadDistricts(existingProvinceId, function () {
                            if (existingDistrictId) {
                                loadLocalLevels(existingDistrictId, function () {
                                    if (existingLocalLevelId) {
                                        $("#LocalLevelId").val(existingLocalLevelId);
                                    }
                                });
                            }
                        });
                    }
                    // Init Select2 for visible non-cascade selects only
                    // (hidden step selects get initialized when their step is shown via updateStep)
                    $('.select2:visible').each(function () {
                        var $el = $(this);
                        if (!$el.data('select2')) {
                            $el.select2({
                                width: '100%',
                                placeholder: function () { return $(this).find('option:first').text(); },
                                allowClear: false
                            }).on('change', function () {
                                validateSingleField($(this));
                            });
                        }
                    });
                });
            }

            $("#ProvinceId").change(function () {
                var provinceId = $(this).val();
                if (provinceId) {
                    loadDistricts(provinceId);
                } else {
                    $('#DistrictId').select2('destroy');
                    $('#LocalLevelId').select2('destroy');
                    $("#DistrictId").empty().append('<option value="">Select District</option>');
                    $("#LocalLevelId").empty().append('<option value="">Select Local Level</option>');
                    $('#DistrictId').select2({width:'resolve'});
                    $('#LocalLevelId').select2({width:'resolve'});
                }
            });

            $("#DistrictId").change(function () {
                var districtId = $(this).val();
                if (districtId) {
                    loadLocalLevels(districtId);
                } else {
                    $('#LocalLevelId').select2('destroy');
                    $("#LocalLevelId").empty().append('<option value="">Select Local Level</option>');
                    $('#LocalLevelId').select2({width:'resolve'});
                }
            });

            // Check schedule status on page load using hidden input values
            function checkFormStatus() {
                var programId = $('input[name="ProgramId"]').val();
                var collegeId = $('input[name="CollegeId"]').val();
                var academicYearId = $('input[name="AcademicYearId"]').val();

                if (programId && collegeId && academicYearId) {
                    $.get(tenantUrl("/Exams/Entrance/CheckFormStatus"),
                        {
                            programId: programId,
                            collegeId: collegeId,
                            academicYearId: academicYearId
                        },
                        function (result) {
                            if (result.isOpen) {
                                $("#scheduleWarning").addClass("hidden");
                                if (result.fee) {
                                    $("#feeAmount").text(parseFloat(result.fee).toFixed(2));
                                    $("#feeInfo").removeClass("hidden");
                                }
                            } else {
                                $("#scheduleWarningText").text("The entrance application form is not currently open for this program.");
                                $("#scheduleWarning").removeClass("hidden");
                                $("#feeInfo").addClass("hidden");
                            }
                        });
                } else {
                    $("#scheduleWarning").addClass("hidden");
                    $("#feeInfo").addClass("hidden");
                }
            }

            // Init
            checkFormStatus();
            initAddressCascading();
        });
    </script>
}
