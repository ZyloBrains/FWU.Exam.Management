                                        <option value="">Select Level</option>
                                    </select>
                                </div>
                                <div>
                                    <label asp-for="PreviousSchoolCollege2" class="block text-sm font-medium text-gray-700 mb-1">Institution / Board</label>
                                    <input asp-for="PreviousSchoolCollege2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
                                <div>
                                    <label asp-for="PreviousBoard2" class="block text-sm font-medium text-gray-700 mb-1">Board / University</label>
                                    <input asp-for="PreviousBoard2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PreviousSymbolNumber2" class="block text-sm font-medium text-gray-700 mb-1">Symbol No</label>
                                    <input asp-for="PreviousSymbolNumber2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-3">
                                <div>
                                    <label asp-for="PreviousPassedYear2" class="block text-sm font-medium text-gray-700 mb-1">Passed Year</label>
                                    <input asp-for="PreviousPassedYear2" placeholder="e.g. 2080" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PreviousGPA2" class="block text-sm font-medium text-gray-700 mb-1">Percentage / CGPA</label>
                                    <input asp-for="PreviousGPA2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PreviousDivision2" class="block text-sm font-medium text-gray-700 mb-1">Division</label>
                                    <select asp-for="PreviousDivision2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                        <option value="">Select</option>
                                        <option value="Distinction">Distinction</option>
                                        <option value="First">First Division</option>
                                        <option value="Second">Second Division</option>
                                        <option value="Third">Third Division</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Qualification 3 -->
                        <div class="bg-gray-50 rounded-lg p-4">
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Additional Qualification (if any)</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="PreviousLevel3Id" class="block text-sm font-medium text-gray-700 mb-1">Level / Examination</label>
                                    <select asp-for="PreviousLevel3Id" asp-items="ViewBag.PreviousLevelId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                        <option value="">Select Level</option>
                                    </select>
                                </div>
                                <div>
                                    <label asp-for="PreviousSchoolCollege3" class="block text-sm font-medium text-gray-700 mb-1">Institution / Board</label>
                                    <input asp-for="PreviousSchoolCollege3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
                                <div>
                                    <label asp-for="PreviousBoard3" class="block text-sm font-medium text-gray-700 mb-1">Board / University</label>
                                    <input asp-for="PreviousBoard3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PreviousSymbolNumber3" class="block text-sm font-medium text-gray-700 mb-1">Symbol No</label>
                                    <input asp-for="PreviousSymbolNumber3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-3">
                                <div>
                                    <label asp-for="PreviousPassedYear3" class="block text-sm font-medium text-gray-700 mb-1">Passed Year</label>
                                    <input asp-for="PreviousPassedYear3" placeholder="e.g. 2080" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PreviousGPA3" class="block text-sm font-medium text-gray-700 mb-1">Percentage / CGPA</label>
                                    <input asp-for="PreviousGPA3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PreviousDivision3" class="block text-sm font-medium text-gray-700 mb-1">Division</label>
                                    <select asp-for="PreviousDivision3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                        <option value="">Select</option>
                                        <option value="Distinction">Distinction</option>
                                        <option value="First">First Division</option>
                                        <option value="Second">Second Division</option>
                                        <option value="Third">Third Division</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== STEP 5: Documents & Submit ===== -->
                <div class="step-content hidden" id="step5">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-teal-600 to-cyan-600">
                        <h2 class="text-lg font-semibold text-white">Step 5: Documents & Review</h2>
                        <p class="text-teal-100 text-sm">Upload required documents and review your application</p>
                    </div>
                    <div class="px-6 py-6 space-y-5">

                        <!-- Documents Section -->
                        <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 text-sm text-amber-700">
                            <i class="fas fa-info-circle mr-1"></i>
                            Documents: Applicants should make a single copy of self-attested documents like Transcript, Character Certificate, Transfer Certificate (Bachelors and Masters) and Citizenship.
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Upload Passport Size Photo</label>
                                <input type="file" name="PhotoFile" accept=".jpg,.jpeg,.png"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100" />
                                <p class="text-xs text-gray-400 mt-1">Format: .jpg, .jpeg, .png</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Upload Documents (Transcript, Character, TC, Citizenship)</label>
                                <input type="file" name="DocumentsFile" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" multiple
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100" />
                                <p class="text-xs text-gray-400 mt-1">Format: .pdf, .jpg, .doc</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Upload Bank Voucher</label>
                                <input type="file" name="VoucherFile" accept=".pdf,.jpg,.jpeg,.doc,.docx"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100" />
                                <p class="text-xs text-gray-400 mt-1">File name should be Student Name with Symbol No. Format: .pdf, .jpg, .doc</p>
                            </div>
                        </div>

                        <!-- Review Summary -->
                        <div class="border-t border-gray-100 pt-4">
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Review Your Application</h3>
                            <div class="bg-gray-50 rounded-lg p-4 text-sm space-y-2" id="reviewSummary">
                                <p class="text-gray-400 italic">Fill in your details in previous steps to see the summary here.</p>
                            </div>
                        </div>

                        <div class="bg-teal-50 border border-teal-200 rounded-lg px-4 py-3">
                            <label class="flex items-start gap-3">
                                <input type="checkbox" id="agreeCheck" class="mt-0.5 rounded border-gray-300 text-teal-600 focus:ring-teal-500">
                                <span class="text-sm text-gray-600">
                                    I hereby declare that all the information provided above is true and correct to the best of my knowledge. I understand that any false information may lead to disqualification.
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
                    <div>
                        <button type="button" id="prevBtn" class="hidden inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-100 transition">
                            <i class="fas fa-arrow-left text-xs"></i> Previous
                        </button>
                    </div>
                    <div class="flex items-center gap-3">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-sm text-gray-500 hover:text-gray-700 transition">Cancel</a>
                        <button type="button" id="nextBtn" class="inline-flex items-center gap-2 px-5 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition shadow-sm">
                            Next <i class="fas fa-arrow-right text-xs"></i>
                        </button>
                        <button type="submit" id="submitBtn" class="hidden inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-teal-600 to-cyan-600 text-white text-sm font-semibold rounded-lg hover:from-teal-700 hover:to-cyan-700 transition shadow-md">
                            <i class="fas fa-paper-plane text-xs"></i> Submit Application
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            var currentStep = 1;
            var totalSteps = 5;

            function updateStep(step) {
                currentStep = step;
                $('.step-content').addClass('hidden');
                $('#step' + step).removeClass('hidden');

                $('.step-indicator').each(function () {
                    var s = parseInt($(this).data('step'));
                    var circle = $(this).find('div:first');
                    var label = $(this).find('span');
                    if (s < step) {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-teal-600');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-teal-600');
                    } else if (s === step) {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-teal-600');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-teal-600');
                    } else {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-gray-200');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-gray-400');
                    }
                });

                $('.step-line').each(function () {
                    var s = parseInt($(this).data('step'));
                    if (s < step) {
                        $(this).removeClass('bg-gray-200').addClass('bg-teal-500');
                    } else {
                        $(this).removeClass('bg-teal-500').addClass('bg-gray-200');
                    }
                });

                $('#prevBtn').toggleClass('hidden', step === 1);
                $('#nextBtn').toggleClass('hidden', step === totalSteps);
                $('#submitBtn').toggleClass('hidden', step !== totalSteps);
            }

            function validateStep(step) {
                if (step === 1) {
                    var ay = $('#AcademicYearId').val();
                    var col = $('#CollegeId').val();
                    var prog = $('#ProgramId').val();
                    if (!ay || !col || !prog) {
                        alert('Please select Academic Year, College, and Program.');
                        return false;
                    }
                }
                if (step === 2) {
                    var fn = $('#FirstName').val();
                    var ln = $('#LastName').val();
                    var g = $('#GenderId').val();
                    var dob = $('#DateOfBirthBS').val();
                    var em = $('#Email').val();
                    var mob = $('#ContactNumber').val();
                    if (!fn || !ln || !g || !dob || !em || !mob) {
                        alert('Please fill in all required fields (First Name, Last Name, Gender, Date of Birth, Email, Mobile No).');
                        return false;
                    }
                }
                if (step === 3) {
                    if (!$('#WardNumber').val()) {
                        alert('Please enter Ward Number.');
                        return false;
                    }
                }
                return true;
            }

            function updateReviewSummary() {
                var html = '<table class="w-full text-sm">';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Name:</td><td class="py-1 text-gray-800">' +
                    ($('#FirstName').val() || '') + ' ' + ($('#MiddleName').val() || '') + ' ' + ($('#LastName').val() || '') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Email:</td><td class="py-1 text-gray-800">' + ($('#Email').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Mobile:</td><td class="py-1 text-gray-800">' + ($('#ContactNumber').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Gender:</td><td class="py-1 text-gray-800">' + ($('#GenderId option:selected').text() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Date of Birth (BS):</td><td class="py-1 text-gray-800">' + ($('#DateOfBirthBS').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Father\'s Name:</td><td class="py-1 text-gray-800">' + ($('#FatherName').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Program:</td><td class="py-1 text-gray-800">' + ($('#ProgramId option:selected').text() || '-') + '</td></tr>';
                html += '</table>';
                $('#reviewSummary').html(html);
            }

            $('#nextBtn').click(function () {
                if (!validateStep(currentStep)) return;
                if (currentStep === 4) updateReviewSummary();
                if (currentStep < totalSteps) updateStep(currentStep + 1);
            });

            $('#prevBtn').click(function () {
                if (currentStep > 1) updateStep(currentStep - 1);
            });

            $('#submitBtn').click(function (e) {
                if (!$('#agreeCheck').is(':checked')) {
                    e.preventDefault();
                    alert('Please agree to the declaration before submitting.');
                    return;
                }
            });

            // Province/District cascading
            $("#ProvinceId").change(function () {
                var provinceId = $(this).val();
                $("#DistrictId").html('<option>Loading...</option>');
                $("#LocalLevelId").html('<option>Select Local Level</option>');
                $.get(tenantUrl("/Exams/Entrance/GetDistrictsByProvince"),
                    { provinceId: provinceId },
                    function (data) {
                        let dd = $("#DistrictId");
                        dd.empty();
                        dd.append('<option value="">Select District</option>');
                        $.each(data, function (i, item) {
                            dd.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                    });
            });

            $("#DistrictId").change(function () {
                var districtId = $(this).val();
                $("#LocalLevelId").html('<option>Loading...</option>');
                $.get(tenantUrl("/Exams/Entrance/GetLocalLevelsByDistrict"),
                    { districtId: districtId },
                    function (data) {
                        let ll = $("#LocalLevelId");
                        ll.empty();
                        ll.append('<option value="">Select Local Level</option>');
                        $.each(data, function (i, item) {
                            ll.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                    });
            });

            // Check schedule status on program/college/year change
            function checkFormStatus() {
                var programId = $("#ProgramId").val();
                var collegeId = $("#CollegeId").val();
                var academicYearId = $("#AcademicYearId").val();

                if (programId && collegeId && academicYearId) {
                    $.get(tenantUrl("/Exams/Entrance/CheckFormStatus"),
                        {
                            programId: programId,
                            collegeId: collegeId,
                            academicYearId: academicYearId
                        },
                        function (result) {
                            if (result.isOpen) {
                                $("#scheduleWarning").addClass("hidden");
                                if (result.fee) {
                                    $("#feeAmount").text(parseFloat(result.fee).toFixed(2));
                                    $("#feeInfo").removeClass("hidden");
                                }
                            } else {
                                $("#scheduleWarningText").text("The entrance application form is not currently open for this program.");
                                $("#scheduleWarning").removeClass("hidden");
                                $("#feeInfo").addClass("hidden");
                            }
                        });
                } else {
                    $("#scheduleWarning").addClass("hidden");
                    $("#feeInfo").addClass("hidden");
                }
            }

            $(".schedule-select").change(checkFormStatus);

            // Load provinces via AJAX
            $.get(tenantUrl("/Exams/Entrance/GetProvinces"), function (data) {
                var ps = $("#ProvinceId");
                ps.empty();
                ps.append('<option value="">Select Province</option>');
                $.each(data, function (i, item) {
                    ps.append('<option value="' + item.id + '">' + item.name + '</option>');
                });
            });
        });
    </script>
}
