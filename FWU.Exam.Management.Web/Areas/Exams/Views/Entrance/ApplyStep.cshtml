@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            var currentStep = 1;
            var totalSteps = 4;
            var form = $('#entranceForm');
            var storageKey = 'applystep_' + $('input[name="voucherId"]').val();

            // Get existing address data for pre-population
            var addrData = $('#existingAddressData');
            var existingProvinceId = addrData.length ? parseInt(addrData.data('province-id')) : 0;
            var existingDistrictId = addrData.length ? parseInt(addrData.data('district-id')) : 0;
            var existingLocalLevelId = addrData.length ? parseInt(addrData.data('local-level-id')) : 0;

            // ===== STEP TRANSITIONS =====
            function updateStep(step) {
                $('.step-content').addClass('hidden').removeClass('fade-in');
                currentStep = step;
                var $next = $('#step' + step);
                $next.removeClass('hidden');
                setTimeout(function () { $next.addClass('fade-in'); }, 10);

                $('.step-indicator').each(function () {
                    var s = parseInt($(this).data('step'));
                    var circle = $(this).find('div:first');
                    var label = $(this).find('span');
                    if (s <= step) {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-teal-600');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-teal-600');
                    } else {
                        circle.removeClass('bg-teal-600 bg-gray-200').addClass('bg-gray-200');
                        label.removeClass('text-teal-600 text-gray-400').addClass('text-gray-400');
                    }
                });

                $('.step-line').each(function () {
                    var s = parseInt($(this).data('step'));
                    if (s < step) {
                        $(this).removeClass('bg-gray-200').addClass('bg-teal-500');
                    } else {
                        $(this).removeClass('bg-teal-500').addClass('bg-gray-200');
                    }
                });

                $('#prevBtn').toggleClass('hidden', step === 1);
                $('#nextBtn').toggleClass('hidden', step === totalSteps);
                $('#submitBtn').toggleClass('hidden', step !== totalSteps);

                if (step === totalSteps) updateReviewSummary();
            }

            // ===== AUTO-FILL FROM VOUCHER DATA =====
            (function autoFill() {
                var name = form.data('voucher-name') || '';
                var contact = form.data('voucher-contact') || '';
                if (name) {
                    var parts = name.trim().split(/\s+/);
                    if (parts.length >= 1) $('#FirstName').val(parts[0].toUpperCase());
                    if (parts.length === 2) $('#LastName').val(parts[1].toUpperCase());
                    else if (parts.length >= 3) {
                        $('#MiddleName').val(parts.slice(1, -1).join(' ').toUpperCase());
                        $('#LastName').val(parts[parts.length - 1].toUpperCase());
                    }
                }
                if (contact) $('#ContactNumber').val(contact);
            })();

            // ===== BS↔AD DATE CONVERSION (via NepaliCalendarHelper on server) =====
            var convertTimer;
            $('.bs-date').on('input', function () {
                var bs = $(this).val().trim();
                var targetId = $(this).data('target');
                if (bs.length === 10) {
                    clearTimeout(convertTimer);
                    convertTimer = setTimeout(function () {
                        $.get(tenantUrl("/Exams/Entrance/ConvertBsToAd"), { bsDate: bs }, function (data) {
                            if (data.adDate) $('#' + targetId).val(data.adDate);
                        });
                    }, 300);
                }
            });

            // ===== INLINE FIELD VALIDATION =====
            function validateSingleField($el) {
                var val = $el.val() ? $el.val().toString().trim() : '';
                var required = $el.data('required') === true || $el.data('required') === 'true';
                var type = $el.data('type') || '';
                var valid = true;

                $el.removeClass('field-valid field-invalid');

                if (required && !val) valid = false;
                else if (type === 'email' && val && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(val)) valid = false;
                else if (type === 'phone' && val && !/^(\+?\d{7,15})$/.test(val.replace(/[\s-]/g, ''))) valid = false;

                if (val || !valid) {
                    $el.addClass(valid ? 'field-valid' : 'field-invalid');
                }
                // Sync validation state with Select2 container (if applicable)
                var $s2 = $el.next('.select2-container').find('.select2-selection');
                if ($s2.length) {
                    $s2.removeClass('field-valid field-invalid');
                    if ($el.hasClass('field-invalid')) $s2.addClass('field-invalid');
                    else if ($el.hasClass('field-valid')) $s2.addClass('field-valid');
                }
                return valid;
            }

            $('.validate-field').on('blur', function () {
                validateSingleField($(this));
            });

            function validateStep(step) {
                var $step = $('#step' + step);
                var $reqFields = $step.find('.validate-field');
                var allOk = true;
                var firstInvalid = null;

                $reqFields.each(function () {
                    var $el = $(this);
                    validateSingleField($el);
                    if ($el.hasClass('field-invalid')) {
                        allOk = false;
                        if (!firstInvalid) firstInvalid = $el;
                    }
                });

                if (!allOk && firstInvalid) {
                    firstInvalid.focus();
                    return false;
                }
                return true;
            }

            // ===== localStorage AUTO-SAVE =====
            function saveToStorage() {
                var data = {};
                form.find('input, select, textarea').not('[type="file"], [type="hidden"], [type="submit"]').each(function () {
                    var $el = $(this);
                    if ($el.attr('name')) data[$el.attr('name')] = $el.val();
                });
                try { localStorage.setItem(storageKey, JSON.stringify(data)); } catch (e) {}
            }

            function restoreFromStorage() {
                try {
                    var raw = localStorage.getItem(storageKey);
                    if (!raw) return;
                    var data = JSON.parse(raw);
                    $.each(data, function (name, val) {
                        var $el = form.find('[name="' + name + '"]');
                        if ($el.length && !$el.val()) $el.val(val);
                    });
                } catch (e) {}
            }

            form.on('change input', 'input, select, textarea', saveToStorage);
            restoreFromStorage();

            // Clear storage on successful form submit
            form.on('submit', function () {
                try { localStorage.removeItem(storageKey); } catch (e) {}
            });

            // ===== FILE VALIDATION =====
            function validateFile(input, allowedExts, maxSizeMB, errorEl) {
                if (!input.files.length) return true;
                var file = input.files[0];
                var ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
                if (allowedExts.indexOf(ext) === -1) {
                    $(errorEl).text('Invalid file type. Allowed: ' + allowedExts.join(', ')).removeClass('hidden');
                    return false;
                }
                if (file.size > maxSizeMB * 1024 * 1024) {
                    $(errorEl).text('File must be less than ' + maxSizeMB + 'MB.').removeClass('hidden');
                    return false;
                }
                $(errorEl).addClass('hidden');
                return true;
            }

            $('#PhotoFile').change(function () {
                validateFile(this, ['.jpg', '.jpeg', '.png'], 5, '#PhotoFileError');
            });
            $('#DocumentsFile').change(function () {
                validateFile(this, ['.pdf', '.jpg', '.jpeg', '.png', '.doc', '.docx'], 5, '#DocumentsFileError');
            });
            // ===== NAVIGATION =====
            $('#nextBtn').click(function () {
                if (!validateStep(currentStep)) return;
                if (currentStep < totalSteps) updateStep(currentStep + 1);
            });

            $('#prevBtn').click(function () {
                if (currentStep > 1) updateStep(currentStep - 1);
            });

            $('#submitBtn').click(function (e) {
                if (!$('#agreeCheck').is(':checked')) {
                    e.preventDefault();
                    alert('Please agree to the declaration before submitting.');
                    return;
                }
                // Validate all steps before submitting
                for (var s = 1; s <= totalSteps; s++) {
                    if (!validateStep(s)) {
                        e.preventDefault();
                        updateStep(s);
                        return;
                    }
                }
                var ok = true;
                if ($('#PhotoFile')[0].files.length) {
                    ok = validateFile($('#PhotoFile')[0], ['.jpg', '.jpeg', '.png'], 5, '#PhotoFileError') && ok;
                }
                if ($('#DocumentsFile')[0].files.length) {
                    ok = validateFile($('#DocumentsFile')[0], ['.pdf', '.jpg', '.jpeg', '.png', '.doc', '.docx'], 5, '#DocumentsFileError') && ok;
                }
                if (!ok) {
                    e.preventDefault();
                    alert('Please fix file upload errors before submitting.');
                }
            });

            // On page load after a failed POST, navigate to the step with the first error
            var $firstError = $('.field-validation-error, .text-red-600').first();
            if ($firstError.length) {
                var $errorStep = $firstError.closest('.step-content');
                if ($errorStep.length) {
                    var stepNum = parseInt($errorStep.attr('id').replace('step', ''));
                    if (stepNum) updateStep(stepNum);
                }
                $('html, body').animate({ scrollTop: $firstError.offset().top - 100 }, 300);
            }

            // ===== REVIEW SUMMARY =====
            function updateReviewSummary() {
                var html = '<table class="w-full text-sm">';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Name:</td><td class="py-1 text-gray-800">' +
                    ($('#FirstName').val() || '') + ' ' + ($('#MiddleName').val() || '') + ' ' + ($('#LastName').val() || '') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Email:</td><td class="py-1 text-gray-800">' + ($('#Email').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Mobile:</td><td class="py-1 text-gray-800">' + ($('#ContactNumber').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Gender:</td><td class="py-1 text-gray-800">' + ($('#GenderId option:selected').text() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">DOB (BS):</td><td class="py-1 text-gray-800">' + ($('#DateOfBirthBS').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Father\'s Name:</td><td class="py-1 text-gray-800">' + ($('#FatherName').val() || '-') + '</td></tr>';
                html += '<tr><td class="py-1 pr-4 text-gray-500 font-medium">Program:</td><td class="py-1 text-gray-800">' + ($('.program-display-text').length ? $('.program-display-text').text() : ($('input[name="ProgramId"]').val() || '-')) + '</td></tr>';
                html += '</table>';
                $('#reviewSummary').html(html);
            }

            // ===== PROVINCE/DISTRICT/LOCALLEVEL CASCADING (Select2) =====
            function loadProvinces(callback) {
                $.get(tenantUrl("/Exams/Entrance/GetProvinces"), function (data) {
                    var ps = $("#ProvinceId");
                    ps.empty();
                    ps.append('<option value="">Select Province</option>');
                    $.each(data, function (i, item) {
                        ps.append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                    if (callback) callback();
                });
            }

            function loadDistricts(provinceId, callback) {
                $("#DistrictId").html('<option>Loading...</option>');
                $("#LocalLevelId").html('<option>Select Local Level</option>');
                $.get(tenantUrl("/Exams/Entrance/GetDistrictsByProvince"),
                    { provinceId: provinceId },
                    function (data) {
                        var dd = $("#DistrictId");
                        dd.empty();
                        dd.append('<option value="">Select District</option>');
                        $.each(data, function (i, item) {
                            dd.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                        if (callback) callback();
                    });
            }

            function loadLocalLevels(districtId, callback) {
                $("#LocalLevelId").html('<option>Loading...</option>');
                $.get(tenantUrl("/Exams/Entrance/GetLocalLevelsByDistrict"),
                    { districtId: districtId },
                    function (data) {
                        var ll = $("#LocalLevelId");
                        ll.empty();
                        ll.append('<option value="">Select Local Level</option>');
                        $.each(data, function (i, item) {
                            ll.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                        if (callback) callback();
                    });
            }

            // Pre-populate address cascading if editing
            function initAddressCascading() {
                loadProvinces(function () {
                    if (existingProvinceId) {
                        $("#ProvinceId").val(existingProvinceId).trigger('change');
                        loadDistricts(existingProvinceId, function () {
                            if (existingDistrictId) {
                                $("#DistrictId").val(existingDistrictId).trigger('change');
                                loadLocalLevels(existingDistrictId, function () {
                                    if (existingLocalLevelId) {
                                        $("#LocalLevelId").val(existingLocalLevelId).trigger('change');
                                    }
                                });
                            }
                        });
                    }
                    // Init Select2 after data loaded
                    $('#ProvinceId, #DistrictId, #LocalLevelId, #CitizenshipDistrictId').select2({
                        width: '100%',
                        placeholder: function () { return $(this).find('option:first').text(); },
                        allowClear: false
                    }).on('change', function () {
                        validateSingleField($(this));
                    });
                });
            }

            $("#ProvinceId").on('change', function () {
                var provinceId = $(this).val();
                if (provinceId) {
                    loadDistricts(provinceId);
                } else {
                    $("#DistrictId").html('<option value="">Select District</option>');
                    $("#LocalLevelId").html('<option value="">Select Local Level</option>');
                }
            });

            $("#DistrictId").on('change', function () {
                var districtId = $(this).val();
                if (districtId) {
                    loadLocalLevels(districtId);
                } else {
                    $("#LocalLevelId").html('<option value="">Select Local Level</option>');
                }
            });

            // ===== INIT =====
            initAddressCascading();
            // Only default to step 1 if no server-side validation errors (e.g. initial GET)
            if ($('.field-validation-error, .text-red-600').length === 0) {
                updateStep(1);
            }
        });
    </script>
}
