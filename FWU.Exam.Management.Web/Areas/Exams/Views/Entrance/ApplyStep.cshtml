                                    <label asp-for="PreviousDivision" class="block text-sm font-medium text-gray-700 mb-1">Division</label>
                                    <select asp-for="PreviousDivision" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                        <option value="">Select</option>
                                        <option value="Distinction">Distinction</option>
                                        <option value="First">First Division</option>
