@model EntranceExamApplication

@{
    ViewData["Title"] = "Entrance Application Form";
    var voucherId = ViewBag.VoucherId as int? ?? 0;
    var voucherNumber = ViewBag.VoucherNumber as string ?? "";
    var entranceFee = ViewBag.EntranceFee as decimal? ?? 0;
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-teal-50 py-8">
    <div class="max-w-4xl mx-auto px-4">

        <!-- Header with Progress -->
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Entrance Application Form</h1>
            <p class="text-gray-500 text-sm mt-1">Fill in your details to apply for the entrance examination</p>
        </div>

        <!-- Voucher Info Banner -->
        <div class="bg-gradient-to-r from-teal-600 to-cyan-600 rounded-xl px-5 py-3 mb-6 text-white shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
                <i class="fas fa-check-circle text-xl"></i>
                <div>
                    <p class="text-sm font-medium">Payment Verified</p>
                    <p class="text-xs text-teal-100">Voucher: @voucherNumber | Fee: रू @entranceFee.ToString("N2")</p>
                </div>
            </div>
            <span class="bg-white/20 text-white text-xs font-medium px-3 py-1 rounded-full">Verified</span>
        </div>

        <!-- Step Progress Indicator -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-6 py-4 mb-6">
            <div class="flex items-center justify-between" id="stepProgress">
                <div class="flex items-center">
                    <div class="step-indicator active" data-step="1">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white bg-teal-600">1</div>
                        <span class="text-xs mt-1 font-medium text-teal-600">Program</span>
                    </div>
                    <div class="w-12 h-0.5 mx-2 bg-gray-200 step-line" data-step="1"></div>
                </div>
                <div class="flex items-center">
                    <div class="step-indicator" data-step="2">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-gray-400 bg-gray-200">2</div>
                        <span class="text-xs mt-1 font-medium text-gray-400">Personal</span>
                    </div>
                    <div class="w-12 h-0.5 mx-2 bg-gray-200 step-line" data-step="2"></div>
                </div>
                <div class="flex items-center">
                    <div class="step-indicator" data-step="3">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-gray-400 bg-gray-200">3</div>
                        <span class="text-xs mt-1 font-medium text-gray-400">Address & Guardian</span>
                    </div>
                    <div class="w-12 h-0.5 mx-2 bg-gray-200 step-line" data-step="3"></div>
                </div>
                <div class="flex items-center">
                    <div class="step-indicator" data-step="4">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-gray-400 bg-gray-200">4</div>
                        <span class="text-xs mt-1 font-medium text-gray-400">Qualification</span>
                    </div>
                    <div class="w-12 h-0.5 mx-2 bg-gray-200 step-line" data-step="4"></div>
                </div>
                <div class="flex items-center">
                    <div class="step-indicator" data-step="5">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-gray-400 bg-gray-200">5</div>
                        <span class="text-xs mt-1 font-medium text-gray-400">Documents & Submit</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <form asp-action="ApplyStep" method="post" enctype="multipart/form-data" id="entranceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="voucherId" value="@voucherId" />
                <div asp-validation-summary="ModelOnly" class="hidden"></div>

                <!-- ===== STEP 1: Program Selection ===== -->
                <div class="step-content" id="step1">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-teal-600 to-cyan-600">
                        <h2 class="text-lg font-semibold text-white">Step 1: Program Selection</h2>
                        <p class="text-teal-100 text-sm">Select the program you wish to apply for</p>
                    </div>
                    <div class="px-6 py-6 space-y-5">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label asp-for="AcademicYearId" class="block text-sm font-medium text-gray-700 mb-1">Academic Year *</label>
                                <select asp-for="AcademicYearId" asp-items="ViewBag.AcademicYearId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 schedule-select">
                                    <option value="">Select Academic Year</option>
                                </select>
                                <span asp-validation-for="AcademicYearId" class="text-red-600 text-xs"></span>
                            </div>
                            <div>
                                <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College *</label>
                                <select asp-for="CollegeId" asp-items="ViewBag.CollegeId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 schedule-select">
                                    <option value="">Select College</option>
                                </select>
                                <span asp-validation-for="CollegeId" class="text-red-600 text-xs"></span>
                            </div>
                            <div>
                                <label asp-for="ProgramId" class="block text-sm font-medium text-gray-700 mb-1">Program *</label>
                                <select asp-for="ProgramId" asp-items="ViewBag.ProgramId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 schedule-select">
                                    <option value="">Select Program</option>
                                </select>
                                <span asp-validation-for="ProgramId" class="text-red-600 text-xs"></span>
                            </div>
                        </div>
                        <div id="scheduleWarning" class="hidden text-sm text-orange-700 bg-orange-50 border border-orange-200 rounded-lg px-4 py-3">
                            <i class="fas fa-exclamation-triangle mr-1"></i>
                            <span id="scheduleWarningText">The entrance application form is not currently open for this program.</span>
                        </div>
                        <div id="feeInfo" class="hidden text-sm text-teal-700 bg-teal-50 border border-teal-200 rounded-lg px-4 py-3">
                            <i class="fas fa-info-circle mr-1"></i>
                            Entrance Fee: रू <span id="feeAmount">0</span>
                        </div>
                    </div>
                </div>

                <!-- ===== STEP 2: Personal Information ===== -->
                <div class="step-content hidden" id="step2">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-teal-600 to-cyan-600">
                        <h2 class="text-lg font-semibold text-white">Step 2: Personal Information</h2>
                        <p class="text-teal-100 text-sm">Your personal details as per citizenship</p>
                    </div>
                    <div class="px-6 py-6 space-y-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Full Name (In BLOCK LETTER) *</label>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                <div>
                                    <input asp-for="FirstName" placeholder="First Name" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 uppercase" />
                                    <span asp-validation-for="FirstName" class="text-red-600 text-xs"></span>
                                </div>
                                <div>
                                    <input asp-for="MiddleName" placeholder="Middle Name" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 uppercase" />
                                </div>
                                <div>
                                    <input asp-for="LastName" placeholder="Last Name" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 uppercase" />
                                    <span asp-validation-for="LastName" class="text-red-600 text-xs"></span>
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="NepaliName" class="block text-sm font-medium text-gray-700 mb-1">Name (Nepali)</label>
                                <input asp-for="NepaliName" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>
                            <div>
                                <label asp-for="GenderId" class="block text-sm font-medium text-gray-700 mb-1">Gender *</label>
                                <select asp-for="GenderId" asp-items="ViewBag.GenderId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                    <option value="">Select Gender</option>
                                </select>
                                <span asp-validation-for="GenderId" class="text-red-600 text-xs"></span>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="DateOfBirthBS" class="block text-sm font-medium text-gray-700 mb-1">Date of Birth (BS) *</label>
                                <input asp-for="DateOfBirthBS" placeholder="YYYY-MM-DD" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="DateOfBirthBS" class="text-red-600 text-xs"></span>
                            </div>
                            <div>
                                <label asp-for="DateOfBirthAD" class="block text-sm font-medium text-gray-700 mb-1">Date of Birth (AD)</label>
                                <input asp-for="DateOfBirthAD" placeholder="YYYY-MM-DD" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="BloodGroup" class="block text-sm font-medium text-gray-700 mb-1">Blood Group</label>
                                <select asp-for="BloodGroup" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                    <option value="">Select Blood Group</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                            </div>
                            <div>
                                <label asp-for="BirthPlace" class="block text-sm font-medium text-gray-700 mb-1">Birth Place</label>
                                <input asp-for="BirthPlace" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>
                        </div>
                        <div class="border-t border-gray-100 pt-4">
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Citizenship Details</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="CitizenshipNo" class="block text-sm font-medium text-gray-700 mb-1">Citizenship No</label>
                                    <input asp-for="CitizenshipNo" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="CitizenshipDistrictId" class="block text-sm font-medium text-gray-700 mb-1">Citizenship Issued District</label>
                                    <select asp-for="CitizenshipDistrictId" asp-items="ViewBag.CitizenshipDistrictId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                        <option value="">Select District</option>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
                                <div>
                                    <label asp-for="CitizenshipIssueDateBs" class="block text-sm font-medium text-gray-700 mb-1">Issue Date (BS)</label>
                                    <input asp-for="CitizenshipIssueDateBs" placeholder="YYYY-MM-DD" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="CitizenshipIssueDateAd" class="block text-sm font-medium text-gray-700 mb-1">Issue Date (AD)</label>
                                    <input asp-for="CitizenshipIssueDateAd" placeholder="YYYY-MM-DD" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                                <input asp-for="Email" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                            </div>
                            <div>
                                <label asp-for="ContactNumber" class="block text-sm font-medium text-gray-700 mb-1">Mobile No *</label>
                                <input asp-for="ContactNumber" placeholder="98XXXXXXXX" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="ContactNumber" class="text-red-600 text-xs"></span>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="Phone" class="block text-sm font-medium text-gray-700 mb-1">Phone (Landline)</label>
                                <input asp-for="Phone" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== STEP 3: Address & Guardian ===== -->
                <div class="step-content hidden" id="step3">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-teal-600 to-cyan-600">
                        <h2 class="text-lg font-semibold text-white">Step 3: Address & Guardian Information</h2>
                        <p class="text-teal-100 text-sm">Your permanent address and guardian details</p>
                    </div>
                    <div class="px-6 py-6 space-y-5">

                        <!-- Permanent Address -->
                        <div>
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Permanent Address</h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Province *</label>
                                    <select id="ProvinceId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                                        <option value="">Select Province</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">District *</label>
                                    <select id="DistrictId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                                        <option value="">Select District</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Local Level / Municipality *</label>
                                    <select id="LocalLevelId" name="LocalLevelId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                                        <option value="">Select Local Level</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Ward No *</label>
                                    <input id="WardNumber" name="WardNumber" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Tole / Street</label>
                                    <input id="ToleStreet" name="ToleStreet" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">House Number</label>
                                    <input id="HouseNumber" name="HouseNumber" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-3">
                                <div>
                                    <label asp-for="Country" class="block text-sm font-medium text-gray-700 mb-1">Country *</label>
                                    <input asp-for="Country" value="Nepal" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PostalCode" class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
                                    <input asp-for="PostalCode" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                        </div>

                        <div class="border-t border-gray-100 pt-4">
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Guardian Information</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="FatherName" class="block text-sm font-medium text-gray-700 mb-1">Father's Name *</label>
                                    <input asp-for="FatherName" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                    <span asp-validation-for="FatherName" class="text-red-600 text-xs"></span>
                                </div>
                                <div>
                                    <label asp-for="FatherContact" class="block text-sm font-medium text-gray-700 mb-1">Father's Phone *</label>
                                    <input asp-for="FatherContact" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
                                <div>
                                    <label asp-for="FatherProfession" class="block text-sm font-medium text-gray-700 mb-1">Father's Profession</label>
                                    <input asp-for="FatherProfession" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="MotherName" class="block text-sm font-medium text-gray-700 mb-1">Mother's Name</label>
                                    <input asp-for="MotherName" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
                                <div>
                                    <label asp-for="MotherContact" class="block text-sm font-medium text-gray-700 mb-1">Mother's Phone</label>
                                    <input asp-for="MotherContact" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="MotherProfession" class="block text-sm font-medium text-gray-700 mb-1">Mother's Profession</label>
                                    <input asp-for="MotherProfession" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="mt-3">
                                <label asp-for="GuardianEmail" class="block text-sm font-medium text-gray-700 mb-1">Guardian Email</label>
                                <input asp-for="GuardianEmail" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== STEP 4: Academic Qualification ===== -->
                <div class="step-content hidden" id="step4">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-teal-600 to-cyan-600">
                        <h2 class="text-lg font-semibold text-white">Step 4: Academic Qualifications</h2>
                        <p class="text-teal-100 text-sm">Your previous academic records</p>
                    </div>
                    <div class="px-6 py-6 space-y-6">

                        <!-- Qualification 1 -->
                        <div class="bg-gray-50 rounded-lg p-4">
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Highest Qualification</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="PreviousLevelId" class="block text-sm font-medium text-gray-700 mb-1">Level / Examination *</label>
                                    <select asp-for="PreviousLevelId" asp-items="ViewBag.PreviousLevelId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                        <option value="">Select Level</option>
                                    </select>
                                </div>
                                <div>
                                    <label asp-for="PreviousSchoolCollege" class="block text-sm font-medium text-gray-700 mb-1">Institution / Board *</label>
                                    <input asp-for="PreviousSchoolCollege" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-3">
                                <div>
                                    <label asp-for="PreviousSymbolNumber" class="block text-sm font-medium text-gray-700 mb-1">Symbol No</label>
                                    <input asp-for="PreviousSymbolNumber" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                                <div>
                                    <label asp-for="PreviousPassedYear" class="block text-sm font-medium text-gray-700 mb-1">Passed Year *</label>
                                    <input asp-for="PreviousPassedYear" placeholder="e.g. 2080" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
