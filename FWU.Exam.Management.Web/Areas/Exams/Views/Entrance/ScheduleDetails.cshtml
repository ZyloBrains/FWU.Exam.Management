@model ExamSchedule
@{
    ViewData["Title"] = "Entrance Schedule Details";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="ManageSchedule" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition shrink-0">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-graduation-cap text-teal-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Entrance Schedule Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-4 sm:p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            <div class="md:col-span-2">
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                    <i class="fas fa-info-circle text-teal-600 mr-1.5"></i>Schedule Details
                </h2>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Schedule Name</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.ExamScheduleName</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Schedule Code</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.ExamScheduleCode</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Program</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.Program?.ProgramName</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Academic Year</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.AcademicYear?.AcademicYearName</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Exam Type</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.ExamType?.Name</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Status</label>
                <p class="mt-1">
                    @if (Model.IsActive)
                    {
                        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded-full">Inactive</span>
                    }
                </p>
            </div>

            <div class="md:col-span-2">
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                    <i class="fas fa-calendar text-teal-600 mr-1.5"></i>Application Period
                </h2>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Start Date (BS)</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.StartDateBs</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">End Date (BS)</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.EndDateBs</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Start Date (AD)</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.StartDate?.ToString("yyyy-MM-dd")</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">End Date (AD)</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.EndDate?.ToString("yyyy-MM-dd")</p>
            </div>

            <div class="md:col-span-2">
                <h2 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b pb-1">
                    <i class="fas fa-money-bill-wave text-teal-600 mr-1.5"></i>Fee & Time
                </h2>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Entrance Fee (Rs.)</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.ExamFee?.ToString("N2")</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Practical Subject Fee</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.PracticalSubjectFee?.ToString("N2")</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Start Time</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.StartTime.ToString()</p>
            </div>
            <div>
                <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">End Time</label>
                <p class="text-sm font-medium text-gray-800 mt-1">@Model.EndTime.ToString()</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="md:col-span-2">
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Remarks</label>
                    <p class="text-sm font-medium text-gray-800 mt-1">@Model.Remarks</p>
                </div>
            }
        </div>

        <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-3 sm:gap-4 pt-6 mt-6 border-t border-gray-200">
            <a asp-action="ManageSchedule" class="w-full sm:w-auto px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition text-center">
                <i class="fas fa-arrow-left mr-1.5"></i> Back to List
            </a>
            <a asp-action="EditSchedule" asp-route-id="@Model.Id" class="w-full sm:w-auto px-6 py-2.5 bg-gradient-to-r from-teal-600 to-cyan-600 text-white text-sm font-semibold rounded-lg hover:from-teal-700 hover:to-cyan-700 transition shadow-md text-center">
                <i class="fas fa-edit mr-1.5"></i> Edit
            </a>
        </div>
    </div>
</div>
