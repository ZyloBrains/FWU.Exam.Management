@model IEnumerable<EntranceExamApplicationListDto>

@{
    ViewData["Title"] = "Entrance Applications";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var currentStatus = ViewBag.Status as string ?? "";
}

<div class="space-y-6" x-data="{ openExport: false }">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-file-alt text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Entrance Applications</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> total records
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative">
                <button x-on:click="openExport = !openExport"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                    <i class="fas fa-download text-xs"></i> Export
                </button>
                <div x-show="openExport"
                     x-on:click.away="openExport = false"
                     x-transition
                     class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                    <a asp-action="ExportToExcel"
                           asp-route-search="@currentSearch"
                           asp-route-status="@currentStatus"
                           asp-route-programId="@ViewBag.ProgramId"
                           asp-route-academicYearId="@ViewBag.AcademicYearId"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-excel text-green-600"></i> Excel (All)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="AdminList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <div class="relative">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search name, email, phone..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <select name="status" class="select2 px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <option value="">All Status</option>
                <option value="Submitted" selected="@(currentStatus == "Submitted")">Submitted</option>
                <option value="UnderReview" selected="@(currentStatus == "UnderReview")">Under Review</option>
                <option value="Approved" selected="@(currentStatus == "Approved")">Approved</option>
                <option value="Rejected" selected="@(currentStatus == "Rejected")">Rejected</option>
            </select>
            <select name="programId" asp-items="ViewBag.ProgramIdList" class="select2 px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <option value="">All Programs</option>
            </select>
            <select name="academicYearId" asp-items="ViewBag.AcademicYearIdList" class="select2 px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <option value="">All Academic Years</option>
            </select>
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors">
                    Filter
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentStatus) || ViewBag.ProgramId != null || ViewBag.AcademicYearId != null)
                {
                    <a asp-action="AdminList" class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">ID</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Applicant</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Contact</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Academic Year</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">College</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Program</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Date</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-800">@item.Id</td>
                        <td class="px-4 py-3">
                            <div class="font-medium text-gray-800">@item.FullName</div>
                            <div class="text-xs text-gray-500">@item.Email</div>
                        </td>
                        <td class="px-4 py-3 text-gray-600">@item.ContactNumber</td>
                        <td class="px-4 py-3 text-gray-600">@item.AcademicYear</td>
                        <td class="px-4 py-3 text-gray-600">@item.College</td>
                        <td class="px-4 py-3 text-gray-600">@item.Program</td>
                        <td class="px-4 py-3">
                            @{
                                var statusColor = item.Status switch
                                {
                                    "Submitted" => "bg-yellow-100 text-yellow-700",
                                    "UnderReview" => "bg-blue-100 text-blue-700",
                                    "Approved" => "bg-green-100 text-green-700",
                                    "Rejected" => "bg-red-100 text-red-700",
                                    _ => "bg-gray-100 text-gray-700"
                                };
                            }
                            <span class="px-2 py-0.5 text-xs font-medium @statusColor rounded-full">@item.Status</span>
                        </td>
                        <td class="px-4 py-3 text-gray-500 text-xs">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="px-4 py-3 text-right">
                            <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-indigo-600 hover:bg-indigo-50 rounded-md" title="Details">
                                <i class="fas fa-eye text-xs"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-file-alt text-4xl mb-3 opacity-50"></i>
                <p>No applications found.</p>
            </div>
        }
    </div>

    <!-- Mobile card layout -->
    <div class="lg:hidden space-y-3">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="font-semibold text-gray-800 text-sm">@item.FullName</h3>
                        <p class="text-xs text-gray-500">@item.Email | @item.ContactNumber</p>
                    </div>
                    @{
                        var mStatusColor = item.Status switch
                        {
                            "Submitted" => "bg-yellow-100 text-yellow-700",
                            "UnderReview" => "bg-blue-100 text-blue-700",
                            "Approved" => "bg-green-100 text-green-700",
                            "Rejected" => "bg-red-100 text-red-700",
                            _ => "bg-gray-100 text-gray-700"
                        };
                    }
                    <span class="px-2 py-0.5 text-xs font-medium @mStatusColor rounded-full">@item.Status</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                    <div class="text-gray-500">Academic Year</div>
                    <div class="text-gray-800">@item.AcademicYear</div>
                    <div class="text-gray-500">College</div>
                    <div class="text-gray-800">@item.College</div>
                    <div class="text-gray-500">Program</div>
                    <div class="text-gray-800">@item.Program</div>
                    <div class="text-gray-500">Submitted</div>
                    <div class="text-gray-800">@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="pt-3">
                    <a asp-action="Details" asp-route-id="@item.Id" class="w-full block text-center py-2 text-xs font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100">
                        View Details
                    </a>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-500">
                <i class="fas fa-file-alt text-4xl mb-3 opacity-50"></i>
                <p>No applications found.</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                @if (currentPage > 1)
                {
                    <a asp-action="AdminList" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus" asp-route-programId="@ViewBag.ProgramId" asp-route-academicYearId="@ViewBag.AcademicYearId" asp-route-pageSize="@pageSize"
                           class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Previous</a>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="AdminList" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus" asp-route-programId="@ViewBag.ProgramId" asp-route-academicYearId="@ViewBag.AcademicYearId" asp-route-pageSize="@pageSize"
                           class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Next</a>
                }
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Showing <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>
                        to <span class="font-medium">@(Math.Min(currentPage * pageSize, totalCount))</span>
                        of <span class="font-medium">@totalCount</span> results
                    </p>
                </div>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                    <a asp-action="AdminList" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus" asp-route-programId="@ViewBag.ProgramId" asp-route-academicYearId="@ViewBag.AcademicYearId" asp-route-pageSize="@pageSize"
                           class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == 1 ? "pointer-events-none opacity-50" : "")">
                        <i class="fas fa-chevron-left text-xs"></i>
                    </a>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-action="AdminList" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-status="@currentStatus" asp-route-programId="@ViewBag.ProgramId" asp-route-academicYearId="@ViewBag.AcademicYearId" asp-route-pageSize="@pageSize"
                               class="relative inline-flex items-center px-4 py-2 text-sm font-semibold @(i == currentPage ? "bg-indigo-600 text-white" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50")">@i</a>
                    }
                    <a asp-action="AdminList" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus" asp-route-programId="@ViewBag.ProgramId" asp-route-academicYearId="@ViewBag.AcademicYearId" asp-route-pageSize="@pageSize"
                           class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == totalPages ? "pointer-events-none opacity-50" : "")">
                            <i class="fas fa-chevron-right text-xs"></i>
                        </a>
                </nav>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.25rem;
            padding: 0;
            color: #374151;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #6366f1;
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
        }
    </style>

    <script>$(function () { $('.select2').select2({ minimumResultsForSearch: -1, width: '100%' }); });</script>
}
