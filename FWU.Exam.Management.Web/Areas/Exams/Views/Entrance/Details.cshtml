@model EntranceExamApplication

@{
    ViewData["Title"] = "Application Details";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <a asp-action="AdminList" class="p-2 text-gray-500 hover:bg-gray-100 rounded-lg">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Application #@Model.Id</h1>
                <p class="text-sm text-gray-500">Submitted on @Model.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
            </div>
        </div>
        <div>
            @{
                var detailStatusColor = Model.Status switch
                {
                    ApplicationStatus.Submitted => "bg-yellow-100 text-yellow-700",
                    ApplicationStatus.UnderReview => "bg-blue-100 text-blue-700",
                    ApplicationStatus.Approved => "bg-green-100 text-green-700",
                    ApplicationStatus.Rejected => "bg-red-100 text-red-700",
                    _ => "bg-gray-100 text-gray-700"
                };
            }
            <span class="px-3 py-1 text-sm font-medium @detailStatusColor rounded-full">@Model.Status</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Payment Info -->
    @if (Model.PaymentVerified && Model.ApplicationVoucher != null)
    {
        <div class="bg-green-50 border border-green-200 rounded-xl p-4">
            <div class="flex items-center gap-2 text-green-700 mb-2">
                <i class="fas fa-check-circle"></i>
                <span class="font-medium text-sm">Payment Verified</span>
            </div>
            <p class="text-sm text-green-600">Voucher: @Model.ApplicationVoucher.VoucherNumber | Amount: रू @Model.ApplicationVoucher.Amount.ToString("N2")</p>
        </div>
    }

    <!-- Program Selection -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-800">Program Selection</h2>
        </div>
        <div class="px-6 py-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Academic Year</label>
                    <p class="text-gray-800">@Model.AcademicYear?.AcademicYearName</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">College</label>
                    <p class="text-gray-800">@Model.College?.Name</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Program</label>
                    <p class="text-gray-800 font-medium">@Model.Program?.ProgramName</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Applicant Information -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-800">Personal Information</h2>
        </div>
        <div class="px-6 py-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Full Name</label>
                    <p class="text-gray-800">@(Model.FirstName + " " + (Model.MiddleName ?? "") + " " + Model.LastName)</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Name (Nepali)</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.NepaliName) ? Model.NepaliName : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Gender</label>
                    <p class="text-gray-800">@Model.Gender?.GenderName</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Date of Birth (BS)</label>
                    <p class="text-gray-800">@Model.DateOfBirthBS</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Date of Birth (AD)</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.DateOfBirthAD) ? Model.DateOfBirthAD : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Blood Group</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.BloodGroup) ? Model.BloodGroup : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Birth Place</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.BirthPlace) ? Model.BirthPlace : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Email</label>
                    <p class="text-gray-800">@Model.Email</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Contact Number</label>
                    <p class="text-gray-800">@Model.ContactNumber</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Phone (Landline)</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.Phone) ? Model.Phone : "-")</p>
                </div>
            </div>

            <!-- Citizenship -->
            @if (!string.IsNullOrEmpty(Model.CitizenshipNo))
            {
                <div class="border-t border-gray-100 mt-4 pt-4">
                    <h3 class="text-xs font-semibold text-gray-500 uppercase mb-3">Citizenship Details</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Citizenship No</label>
                            <p class="text-gray-800">@Model.CitizenshipNo</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Issued District</label>
                            <p class="text-gray-800">@(Model.CitizenshipDistrict?.DistrictName ?? "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Issue Date</label>
                            <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.CitizenshipIssueDateBs) ? Model.CitizenshipIssueDateBs : "-")</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Address -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-800">Permanent Address</h2>
        </div>
        <div class="px-6 py-4">
            @if (Model.PermanentAddress != null)
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Province</label>
                        <p class="text-gray-800">@Model.PermanentAddress.LocalLevel?.District?.Province?.ProvinceName</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">District</label>
                        <p class="text-gray-800">@Model.PermanentAddress.LocalLevel?.District?.DistrictName</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Local Level</label>
                        <p class="text-gray-800">@Model.PermanentAddress.LocalLevel?.LocalLevelName</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Ward Number</label>
                        <p class="text-gray-800">@(Model.PermanentAddress.WardNumber?.ToString() ?? "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Tole/Street</label>
                        <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.PermanentAddress.ToleStreet) ? Model.PermanentAddress.ToleStreet : "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">House Number</label>
                        <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.PermanentAddress.HouseNumber) ? Model.PermanentAddress.HouseNumber : "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Country</label>
                        <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.Country) ? Model.Country : "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Postal Code</label>
                        <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.PostalCode) ? Model.PostalCode : "-")</p>
                    </div>
                </div>
            }
            else
            {
                <p class="text-gray-500 text-sm">No address provided.</p>
            }
        </div>
    </div>

    <!-- Guardian Information -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-800">Guardian Information</h2>
        </div>
        <div class="px-6 py-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Father's Name</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.FatherName) ? Model.FatherName : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Father's Contact</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.FatherContact) ? Model.FatherContact : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Father's Profession</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.FatherProfession) ? Model.FatherProfession : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Mother's Name</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.MotherName) ? Model.MotherName : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Mother's Contact</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.MotherContact) ? Model.MotherContact : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Mother's Profession</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.MotherProfession) ? Model.MotherProfession : "-")</p>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Guardian Email</label>
                    <p class="text-gray-800">@(!string.IsNullOrEmpty(Model.GuardianEmail) ? Model.GuardianEmail : "-")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Previous Qualifications -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-800">Academic Qualifications</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
            <!-- Qualification 1 -->
            <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="text-sm font-semibold text-gray-700 mb-2">Highest Qualification</h3>
                <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Level</label>
                        <p class="text-gray-800 text-sm">@(Model.PreviousLevel?.PreviousLevelName ?? "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Institution</label>
                        <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousSchoolCollege) ? Model.PreviousSchoolCollege : "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Symbol No</label>
                        <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousSymbolNumber) ? Model.PreviousSymbolNumber : "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Year / GPA</label>
                        <p class="text-gray-800 text-sm">@Model.PreviousPassedYear / @(Model.PreviousGPA?.ToString("N2") ?? "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Division</label>
                        <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousDivision) ? Model.PreviousDivision : "-")</p>
                    </div>
                </div>
            </div>

            @if (Model.PreviousLevel2Id.HasValue)
            {
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-sm font-semibold text-gray-700 mb-2">Previous Qualification</h3>
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Level</label>
                            <p class="text-gray-800 text-sm">@(Model.PreviousLevel2?.PreviousLevelName ?? "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Institution</label>
                            <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousSchoolCollege2) ? Model.PreviousSchoolCollege2 : "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Board</label>
                            <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousBoard2) ? Model.PreviousBoard2 : "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Year / GPA</label>
                            <p class="text-gray-800 text-sm">@Model.PreviousPassedYear2 / @(Model.PreviousGPA2?.ToString("N2") ?? "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Division</label>
                            <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousDivision2) ? Model.PreviousDivision2 : "-")</p>
                        </div>
                    </div>
                </div>
            }

            @if (Model.PreviousLevel3Id.HasValue)
            {
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-sm font-semibold text-gray-700 mb-2">Additional Qualification</h3>
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Level</label>
                            <p class="text-gray-800 text-sm">@(Model.PreviousLevel3?.PreviousLevelName ?? "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Institution</label>
                            <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousSchoolCollege3) ? Model.PreviousSchoolCollege3 : "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Board</label>
                            <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousBoard3) ? Model.PreviousBoard3 : "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Year / GPA</label>
                            <p class="text-gray-800 text-sm">@Model.PreviousPassedYear3 / @(Model.PreviousGPA3?.ToString("N2") ?? "-")</p>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-1">Division</label>
                            <p class="text-gray-800 text-sm">@(!string.IsNullOrEmpty(Model.PreviousDivision3) ? Model.PreviousDivision3 : "-")</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Documents -->
    @if (!string.IsNullOrEmpty(Model.PhotoPath) || !string.IsNullOrEmpty(Model.DocumentsPath) || !string.IsNullOrEmpty(Model.VoucherPath))
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-800">Documents</h2>
            </div>
            <div class="px-6 py-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-2">Photo</label>
                            <a href="@Model.PhotoPath" target="_blank">
                                <img src="@Model.PhotoPath" alt="Applicant Photo" class="w-full max-w-[200px] h-auto rounded-lg border border-gray-200 shadow-sm hover:opacity-90 transition-opacity" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-sm text-gray-400\'>(image not available)</span>'">
                            </a>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.DocumentsPath))
                    {
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-2">Documents</label>
                            <div class="flex flex-col gap-2">
                                @{
                                    var docExt = System.IO.Path.GetExtension(Model.DocumentsPath)?.ToLowerInvariant();
                                }
                                @if (docExt == ".pdf")
                                {
                                    <embed src="@Model.DocumentsPath" type="application/pdf" class="w-full max-w-[300px] h-40 rounded-lg border border-gray-200" />
                                }
                                else
                                {
                                    <a href="@Model.DocumentsPath" target="_blank">
                                        <img src="@Model.DocumentsPath" alt="Documents" class="w-full max-w-[300px] h-auto rounded-lg border border-gray-200 shadow-sm hover:opacity-90 transition-opacity" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-sm text-gray-400\'>(document not available)</span>'">
                                    </a>
                                }
                                <a href="@Model.DocumentsPath" target="_blank" class="text-sm text-teal-600 hover:underline"><i class="fas fa-download mr-1"></i>Download</a>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.VoucherPath))
                    {
                        <div>
                            <label class="block text-xs text-gray-500 uppercase font-semibold mb-2">Bank Voucher</label>
                            <div class="flex flex-col gap-2">
                                @{
                                    var voucherExt = System.IO.Path.GetExtension(Model.VoucherPath)?.ToLowerInvariant();
                                }
                                @if (voucherExt == ".pdf")
                                {
                                    <embed src="@Model.VoucherPath" type="application/pdf" class="w-full max-w-[300px] h-40 rounded-lg border border-gray-200" />
                                }
                                else
                                {
                                    <a href="@Model.VoucherPath" target="_blank">
                                        <img src="@Model.VoucherPath" alt="Bank Voucher" class="w-full max-w-[300px] h-auto rounded-lg border border-gray-200 shadow-sm hover:opacity-90 transition-opacity" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-sm text-gray-400\'>(image not available)</span>'">
                                    </a>
                                }
                                <a href="@Model.VoucherPath" target="_blank" class="text-sm text-teal-600 hover:underline"><i class="fas fa-download mr-1"></i>Download</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Review Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-800">Review Actions</h2>
        </div>
        <div class="px-6 py-4">
            @if (Model.Status == ApplicationStatus.Submitted || Model.Status == ApplicationStatus.UnderReview)
            {
                <div class="flex flex-wrap gap-3">
                    <form asp-action="MarkUnderReview" method="post" class="inline" onsubmit="return confirm('Mark this application as under review?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                            <i class="fas fa-search text-xs"></i> Mark Under Review
                        </button>
                    </form>
                    <form asp-action="Approve" method="post" class="inline" onsubmit="return confirm('Approve this application?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                            <i class="fas fa-check text-xs"></i> Approve
                        </button>
                    </form>
                    <form asp-action="Reject" method="post" class="inline" onsubmit="return confirm('Reject this application?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="flex items-center gap-2">
                            <input type="text" name="remarks" placeholder="Rejection reason..." class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-400" required />
                            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                                <i class="fas fa-times text-xs"></i> Reject
                            </button>
                        </div>
                    </form>
                </div>
            }
            else if (Model.Status == ApplicationStatus.Approved)
            {
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 text-green-700">
                        <i class="fas fa-check-circle"></i>
                        <span class="font-medium">Approved</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ReviewRemarks))
                    {
                        <p class="text-sm text-green-600 mt-1">Remarks: @Model.ReviewRemarks</p>
                    }
                    @if (Model.ReviewDate.HasValue)
                    {
                        <p class="text-xs text-green-500 mt-1">Reviewed on @Model.ReviewDate.Value.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
                    }
                    <div class="mt-3">
                        <form asp-action="ConvertToAdmission" method="post" class="inline" onsubmit="return confirm('Create student admission from this application?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                                <i class="fas fa-user-graduate text-xs"></i> Create Student Admission
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Status == ApplicationStatus.Rejected)
            {
                <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 text-red-700">
                        <i class="fas fa-times-circle"></i>
                        <span class="font-medium">Rejected</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ReviewRemarks))
                    {
                        <p class="text-sm text-red-600 mt-1">Reason: @Model.ReviewRemarks</p>
                    }
                    @if (Model.ReviewDate.HasValue)
                    {
                        <p class="text-xs text-red-500 mt-1">Reviewed on @Model.ReviewDate.Value.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
                    }
                </div>
            }
        </div>
    </div>

    <div class="flex items-center gap-3 pb-8">
        <a asp-action="AdminList" class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50 transition">
            <i class="fas fa-arrow-left text-xs"></i> Back to List
        </a>
    </div>
</div>
