@model AvailableScheduleDto
@{
    Layout = "~/Areas/Exams/Views/Shared/_PaymentLayout.cshtml";
    ViewData["Title"] = "Pay Entrance Fee";
    var schedule = ViewBag.Schedule as AvailableScheduleDto;
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-teal-50 py-12">
    <div class="max-w-lg mx-auto px-4">

        <div class="text-center mb-8">
            <div class="w-20 h-20 bg-gradient-to-br from-orange-400 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                <i class="fas fa-credit-card text-3xl text-white"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Pay Entrance Fee</h1>
            <p class="text-gray-500 mt-1">Complete your payment to access the entrance application form</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm mb-6 flex items-center gap-2">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <!-- Summary Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 mb-6">
            <h3 class="text-sm font-semibold text-gray-700 mb-3">Program Summary</h3>
            <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">Program</span>
                    <span class="font-medium text-gray-800">@(schedule?.ProgramName ?? schedule?.ExamScheduleName)</span>
                </div>
                @if (!string.IsNullOrEmpty(schedule?.CollegeName))
                {
                    <div class="flex justify-between">
                        <span class="text-gray-500">College</span>
                        <span class="font-medium text-gray-800">@schedule.CollegeName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(schedule?.AcademicYearName))
                {
                    <div class="flex justify-between">
                        <span class="text-gray-500">Academic Year</span>
                        <span class="font-medium text-gray-800">@schedule.AcademicYearName</span>
                    </div>
                }
                <hr class="my-2" />
                <div class="flex justify-between text-base">
                    <span class="text-gray-600 font-medium">Total Fee</span>
                    <span class="font-bold text-teal-700">Rs. @(schedule?.ExamFee?.ToString("N0") ?? "-")</span>
                </div>
            </div>
        </div>

        <!-- Payment Form -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-teal-600 to-cyan-600">
                <h2 class="text-base sm:text-lg font-semibold text-white">Your Details</h2>
                <p class="text-teal-100 text-sm mt-0.5">Fill in your name and phone number to proceed with payment</p>
            </div>

            <div class="px-6 py-6">
                <form asp-action="InitiatePayment" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="scheduleId" value="@schedule?.Id" />

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Full Name *</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-user text-gray-400"></i>
                            </div>
                            <input type="text" name="studentName" required maxlength="200"
                                   placeholder="Enter your full name"
                                   class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 transition" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Phone Number *</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-phone text-gray-400"></i>
                            </div>
                            <input type="tel" name="contactNumber" required maxlength="20"
                                   placeholder="e.g. 98XXXXXXXX"
                                   class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 transition" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Payment Method *</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-credit-card text-gray-400"></i>
                            </div>
                            <select name="paymentTypeId" required
                                    class="select2 w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 transition appearance-none bg-white">
                                <option value="">-- Select Payment Method --</option>
                                @if (ViewBag.PaymentTypes is SelectList pts)
                                {
                                    foreach (var pt in pts)
                                    {
                                        <option value="@pt.Value">@pt.Text</option>
                                    }
                                }
                            </select>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-gray-400 text-xs"></i>
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-teal-600 to-cyan-600 text-white text-sm font-semibold rounded-xl hover:from-teal-700 hover:to-cyan-700 transition shadow-md">
                        <i class="fas fa-check-circle"></i> Proceed to Payment
                    </button>
                </form>
            </div>
        </div>

        <div class="text-center mt-6">
            <a asp-action="AvailableSchedules" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition">
                <i class="fas fa-arrow-left text-xs"></i> Back to Programs
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .select2-container--default .select2-selection--single { height: 48px; border: 1px solid #d1d5db; border-radius: 0.75rem; padding: 0.75rem 1rem 0.75rem 2.5rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 46px; }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #14b8a6;
            outline: 2px solid transparent; outline-offset: 2px;
        }
    </style>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(function () { $('.select2').select2({width:'resolve'}); });
    </script>
}
