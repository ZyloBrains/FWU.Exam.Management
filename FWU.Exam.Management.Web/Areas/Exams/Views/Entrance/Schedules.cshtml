@model IEnumerable<EntranceSchedule>

@{
    ViewData["Title"] = "Entrance Schedules";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-indigo-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Entrance Schedules</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage when the entrance application form is open for each program</p>
            </div>
        </div>
        <a asp-action="ScheduleCreate" class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-sm">
            <i class="fas fa-plus text-xs"></i> New Schedule
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4 text-sm text-green-700 flex items-center gap-2">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Schedules Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Academic Year</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Program</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">College</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Form Open</th>
                            <th class="text-left px-4 py-3 font-semibold text-gray-600">Form Close</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Status</th>
                            <th class="text-center px-4 py-3 font-semibold text-gray-600">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model)
                        {
                            var now = DateTime.UtcNow;
                            var isOpen = item.IsActive && item.FormOpenDate <= now && item.FormCloseDate >= now;
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-gray-800">@item.AcademicYear?.AcademicYearName</td>
                                <td class="px-4 py-3 text-gray-800 font-medium">@item.Program?.ProgramName</td>
                                <td class="px-4 py-3 text-gray-600">@item.College?.Name</td>
                                <td class="px-4 py-3 text-gray-600">@item.FormOpenDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-4 py-3 text-gray-600">@item.FormCloseDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-4 py-3 text-center">
                                    @if (isOpen)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                                            <i class="fas fa-check-circle text-xs"></i> Open
                                        </span>
                                    }
                                    else if (item.IsActive && item.FormCloseDate < now)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                            <i class="fas fa-clock text-xs"></i> Expired
                                        </span>
                                    }
                                    else if (!item.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                                            <i class="fas fa-pause-circle text-xs"></i> Inactive
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700">
                                            <i class="fas fa-clock text-xs"></i> Upcoming
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <form asp-action="ScheduleToggle" method="post" class="inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="inline-flex items-center px-2.5 py-1.5 rounded text-xs font-medium @(item.IsActive ? "bg-red-50 text-red-600 hover:bg-red-100" : "bg-green-50 text-green-600 hover:bg-green-100") transition-colors"
                                                    onclick="return confirm('@(item.IsActive ? "Deactivate" : "Activate") this schedule?')">
                                                <i class="fas @(item.IsActive ? "fa-pause" : "fa-play") mr-1"></i>
                                                @(item.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                        <form asp-action="ScheduleDelete" method="post" class="inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="inline-flex items-center px-2.5 py-1.5 rounded text-xs font-medium bg-red-50 text-red-600 hover:bg-red-100 transition-colors"
                                                    onclick="return confirm('Delete this schedule?')">
                                                <i class="fas fa-trash mr-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12 text-gray-400">
                <i class="fas fa-calendar-times text-4xl mb-3 block"></i>
                <p class="text-gray-500">No entrance schedules configured yet.</p>
                <p class="text-sm mt-1">Create a schedule to open the entrance application form for applicants.</p>
                <a asp-action="ScheduleCreate" class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-teal-600 text-white text-sm rounded-lg hover:bg-teal-700 transition-colors">
                    <i class="fas fa-plus text-xs"></i> Create Schedule
                </a>
            </div>
        }
    </div>
</div>
