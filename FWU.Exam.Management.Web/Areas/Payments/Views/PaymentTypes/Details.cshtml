@model FWU.Exam.Management.Domain.Entities.Payments.PaymentType

@{
    ViewData["Title"] = "Payment Type Details";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Payments" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-credit-card text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Payment Type Details</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <p class="text-sm font-medium text-gray-600">Payment Type Name</p>
                <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.PaymentTypeName)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Logo</p>
                <p class="mt-1">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" alt="@Model.PaymentTypeName" class="h-10 object-contain" onerror="this.style.display='none'" />
                    }
                    else
                    {
                        <span class="text-gray-400 italic">No logo configured</span>
                    }
                </p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Logo URL</p>
                <p class="mt-1 text-gray-800 font-semibold text-sm break-all">@Html.DisplayFor(model => model.LogoUrl)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Status</p>
                <p class="mt-1">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("CollegeAdmin"))
            {
                <a asp-action="Edit" asp-area="Payments" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" asp-area="Payments" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
