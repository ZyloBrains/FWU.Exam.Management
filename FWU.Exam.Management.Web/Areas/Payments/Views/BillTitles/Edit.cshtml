@model FWU.Exam.Management.Domain.Entities.Payments.BillTitle

@{
    ViewData["Title"] = "Edit Bill Title";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <div class="flex items-center gap-3">
        <a asp-action="Index" asp-area="Payments" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-file-invoice-dollar text-amber-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit Bill Title</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" asp-area="Payments" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="BillTitleName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="BillTitleName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Enter bill title name" />
                    <span asp-validation-for="BillTitleName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="FeeType" class="text-sm font-medium text-gray-700 block mb-1">Fee Type</label>
                    <select asp-for="FeeType" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" onchange="toggleFeeType(this.value)">
                        <option value="Theory" selected="@(Model.FeeType == "Theory")">Theory</option>
                        <option value="Practical" selected="@(Model.FeeType == "Practical")">Practical</option>
                    </select>
                    <span asp-validation-for="FeeType" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Category" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="Category" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Enter category" />
                    <span asp-validation-for="Category" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Amount" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="Amount" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="0.00" />
                    <span asp-validation-for="Amount" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="IsActive" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <select asp-for="IsActive" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                        <option value="true" selected="@(Model.IsActive)">Active</option>
                        <option value="false" selected="@(!Model.IsActive)">Inactive</option>
                    </select>
                    <span asp-validation-for="IsActive" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ApplicableDate" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="ApplicableDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" />
                    <span asp-validation-for="ApplicableDate" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ThroughDate" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="ThroughDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" />
                    <span asp-validation-for="ThroughDate" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div id="examScheduleField">
                    <label asp-for="ExamScheduleId" class="text-sm font-medium text-gray-700 block mb-1">Exam Schedule</label>
                    <select asp-for="ExamScheduleId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" asp-items="ViewBag.ExamScheduleId">
                        <option value="">-- Select Exam Schedule --</option>
                    </select>
                    <span asp-validation-for="ExamScheduleId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div id="programField" style="display:@(Model.FeeType == "Practical" ? "" : "none")">
                    <label asp-for="ProgramsId" class="text-sm font-medium text-gray-700 block mb-1">Program</label>
                    <select asp-for="ProgramsId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" asp-items="ViewBag.ProgramsId">
                        <option value="">-- Select Program --</option>
                    </select>
                    <span asp-validation-for="ProgramsId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" asp-area="Payments" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleFeeType(val) {
            document.getElementById('examScheduleField').style.display = val === 'Practical' ? 'none' : '';
            document.getElementById('programField').style.display = val === 'Practical' ? '' : 'none';
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
