@model IEnumerable<FWU.Exam.Management.Application.DTOs.PaymentHistoryListDto>
@{
    ViewData["Title"] = "Payment History";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 20;
    var search = ViewBag.Search as string ?? "";
    var status = ViewBag.Status as string ?? "";
    var gateway = ViewBag.Gateway as string ?? "";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
}

@functions {
    string PaymentStatusBadge(int? status)
    {
        if (status == 3)
            return "<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800\" title=\"Payment made but needs exam office verification\"><i class=\"fas fa-hourglass-half mr-1\"></i>Under Verification</span>";
        if (status == 1)
            return "<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800\" title=\"Payment confirmed / PAID\"><i class=\"fas fa-check-circle mr-1\"></i>Paid</span>";
        if (status == 2)
            return "<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-200 text-gray-700\" title=\"Closed terminal / superseded / cancelled\"><i class=\"fas fa-ban mr-1\"></i>Closed</span>";
        if (status == 0)
            return "<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800\" title=\"Marked as failed\"><i class=\"fas fa-times-circle mr-1\"></i>Failed</span>";
        return "<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600\" title=\"Initiated but not yet confirmed\"><i class=\"fas fa-clock mr-1\"></i>Pending</span>";
    }
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-clock-rotate-left text-blue-600"></i>
        </div>
        <div>
            @await Html.PartialAsync("_AlertMessages")
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Payment History</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                Search all payment records regardless of status
            </p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" asp-area="Payments" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-[1fr_auto_auto_auto_auto_auto] gap-3 items-end">
            <div>
                <label for="search" class="block text-xs font-medium text-gray-500 uppercase mb-1">Search</label>
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
                    <input type="text" id="search" name="search" value="@search"
                           placeholder="Name, phone, invoice, ref code..."
                           class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
            </div>
            <div>
                <label for="status" class="block text-xs font-medium text-gray-500 uppercase mb-1">Status</label>
                <select id="status" name="status" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                    <option value="">All</option>
                    <option value="paid" selected="@(status == "paid")">Paid</option>
                    <option value="failed" selected="@(status == "failed")">Failed</option>
                    <option value="pending" selected="@(status == "pending")">Pending</option>
                    <option value="underverification" selected="@(status == "underverification")">Under Verification</option>
                    <option value="terminal" selected="@(status == "terminal")">Closed</option>
                </select>
            </div>
            <div>
                <label for="gateway" class="block text-xs font-medium text-gray-500 uppercase mb-1">Gateway</label>
                <select id="gateway" name="gateway" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                    <option value="">All</option>
                    <option value="esewa" selected="@(gateway == "esewa")">eSewa</option>
                    <option value="khalti" selected="@(gateway == "khalti")">Khalti</option>
                </select>
            </div>
            <div>
                <label for="fromDate" class="block text-xs font-medium text-gray-500 uppercase mb-1">From</label>
                <input type="date" id="fromDate" name="fromDate" value="@fromDate"
                       class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label for="toDate" class="block text-xs font-medium text-gray-500 uppercase mb-1">To</label>
                <input type="date" id="toDate" name="toDate" value="@toDate"
                       class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status) || !string.IsNullOrEmpty(gateway) || !string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
                {
                    <a asp-action="Index" asp-area="Payments" asp-route-pageSize="@pageSize"
                       class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs sm:text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
                <input type="hidden" name="pageSize" value="@pageSize" />
            </div>
        </form>
    </div>

    <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase w-12">#</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Student Name</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Invoice No.</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Amount (Rs.)</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Gateway</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Transaction</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Exam</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Time</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @{
                    int serial = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize;
                }
                @foreach (var item in Model)
                {
                    serial++;
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-gray-500 text-sm">@serial</td>
                        <td class="px-4 py-3 font-medium text-gray-800">@item.StudentName</td>
                        <td class="px-4 py-3 text-gray-700 font-mono text-xs">@item.InvoiceNumber</td>
                        <td class="px-4 py-3 text-gray-700">Rs. @item.Amount.ToString("N0")</td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                @item.Gateway
                            </span>
                        </td>
                        <td class="px-4 py-3 text-gray-600 font-mono text-xs" title="@(item.ProviderReferenceId ?? "")">@(item.TransactionId ?? "—")</td>
                        <td class="px-4 py-3 text-gray-700 text-xs">@item.ExamName</td>
                        <td class="px-4 py-3">@Html.Raw(PaymentStatusBadge(item.PaymentRequestLogStatus))</td>
                        <td class="px-4 py-3 text-gray-700 text-xs">@item.ForwardedTime.ToString("MMM dd, HH:mm")</td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                            <a asp-action="Details" asp-area="Payments" asp-route-id="@item.Id"
                               class="inline-flex items-center gap-1 px-2 py-1 text-blue-600 hover:bg-blue-50 rounded-md text-xs font-medium" title="View Full Details">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-check-circle text-4xl mb-3 text-gray-300"></i>
                <p>No payment records match your filters.</p>
            </div>
        }
    </div>

    <div class="lg:hidden space-y-3">
        @{
            int serialM = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize;
        }
        @foreach (var item in Model)
        {
            serialM++;
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-money-bill-wave text-blue-600 text-sm"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-bold text-blue-600 bg-blue-100 rounded px-1.5 py-0.5">#@serialM</span>
                                <h3 class="font-semibold text-gray-800 text-sm">@item.StudentName</h3>
                            </div>
                            <p class="text-xs text-gray-500 font-mono">@item.InvoiceNumber</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-semibold text-gray-800">Rs. @item.Amount.ToString("N0")</p>
                        <div class="flex items-center justify-end gap-1.5 mt-1">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-blue-100 text-blue-800">@item.Gateway</span>
                            @Html.Raw(PaymentStatusBadge(item.PaymentRequestLogStatus))
                        </div>
                    </div>
                </div>
                <div class="text-xs text-gray-500 mb-3">
                    <span>Exam: @item.ExamName</span> &middot; <span>Contact: @item.ContactNumber</span> &middot; <span>@item.ForwardedTime.ToString("MMM dd, HH:mm")</span>
                </div>
                <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
                    <a asp-action="Details" asp-area="Payments" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                        View Details
                    </a>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-500">
                <p>No payment records match your filters.</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-area="Payments" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-status="@status" asp-route-gateway="@gateway" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-pageSize="@pageSize"
                       class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">Previous</a>
                }
                else
                {
                    <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Previous</span>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-area="Payments" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-status="@status" asp-route-gateway="@gateway" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-pageSize="@pageSize"
                       class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">Next</a>
                }
                else
                {
                    <span class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Next</span>
                }
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-xs sm:text-sm text-gray-700">
                        Showing <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>
                        to <span class="font-medium">@(Math.Min(currentPage * pageSize, totalCount))</span>
                        of <span class="font-medium">@totalCount</span> results
                    </p>
                </div>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                    <a asp-action="Index" asp-area="Payments" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-status="@status" asp-route-gateway="@gateway" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-pageSize="@pageSize"
                       class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == 1 ? "pointer-events-none opacity-50" : "")">
                        <i class="fas fa-chevron-left text-xs"></i>
                    </a>
                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <a asp-action="Index" asp-area="Payments" asp-route-page="@i" asp-route-search="@search" asp-route-status="@status" asp-route-gateway="@gateway" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-pageSize="@pageSize"
                               class="relative inline-flex items-center px-4 py-2 text-sm font-semibold @(i == currentPage ? "bg-blue-600 text-white" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50")">@i</a>
                        }
                    }
                    <a asp-action="Index" asp-area="Payments" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-status="@status" asp-route-gateway="@gateway" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-pageSize="@pageSize"
                       class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == totalPages ? "pointer-events-none opacity-50" : "")">
                        <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                </nav>
            </div>
        </div>
    }
</div>