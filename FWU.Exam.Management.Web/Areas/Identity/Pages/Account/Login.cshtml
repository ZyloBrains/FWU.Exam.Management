@page
@model LoginModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Sign In";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 px-4 py-8">
    <div class="w-full max-w-lg">
        <div class="text-center mb-8">
            <div class="w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                <i class="fas fa-graduation-cap text-3xl text-white"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-800">FWU Examination System</h1>
            <p class="text-gray-500 mt-2">Sign in to your account</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-700">
                    <i class="fas fa-sign-in-alt mr-2 text-blue-500"></i>Sign In
                </h2>
            </div>
            <div class="p-6">
                @if (TempData["StatusMessage"] != null)
                {
                    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">@TempData["StatusMessage"]</div>
                }

                <div asp-validation-summary="ModelOnly" class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm"></div>

                <form id="account" method="post">
                    @Html.AntiForgeryToken()

                    <div class="space-y-4">
                        <div>
                            <label asp-for="Input.SelectedFacultyId" class="block text-sm font-medium text-gray-700 mb-1">Organization</label>
                            <select asp-for="Input.SelectedFacultyId"
                                    asp-items="@Model.FacultyOptions"
                                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
                                <option value="">— Select your organization —</option>
                            </select>
                            <span asp-validation-for="Input.SelectedFacultyId" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input asp-for="Input.Email" type="email" required
                                   class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
                                   placeholder="your@email.com" autocomplete="username">
                            <span asp-validation-for="Input.Email" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                            <input asp-for="Input.Password" type="password" required
                                   class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
                                   placeholder="Enter your password" autocomplete="current-password">
                            <span asp-validation-for="Input.Password" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <input asp-for="Input.RememberMe" type="checkbox"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <label asp-for="Input.RememberMe" class="text-sm text-gray-600"></label>
                            </div>
                            <a asp-page="./ForgotPassword" class="text-sm text-blue-600 hover:underline">Forgot password?</a>
                        </div>

                        <button type="submit"
                                class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors duration-200">
                            <i class="fas fa-sign-in-alt mr-1"></i> Log in
                        </button>

                        <div class="mt-4 text-center text-sm text-gray-500 space-x-2">
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-blue-600 hover:underline">Register as a new user</a>
                            <span>|</span>
                            <a asp-page="./ResendEmailConfirmation" class="text-blue-600 hover:underline">Resend email confirmation</a>
                        </div>
                    </div>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <hr class="my-6 border-gray-200" />
                    <p class="text-sm text-gray-500 text-center mb-3">Or sign in with</p>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="flex flex-wrap gap-2 justify-center">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" name="provider" value="@provider.Name"
                                    class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50 transition-colors"
                                    title="Log in using your @provider.DisplayName account">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
