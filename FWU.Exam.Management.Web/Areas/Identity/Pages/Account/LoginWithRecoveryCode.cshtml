@page
@model LoginWithRecoveryCodeModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Recovery code verification";
}

<div class="max-w-lg mx-auto mt-10">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-key text-amber-600"></i>
            </div>
            <h1 class="text-xl font-bold text-gray-800">@ViewData["Title"]</h1>
        </div>
        <div class="bg-amber-50 border border-amber-200 text-amber-700 rounded-lg p-4 mb-5 text-sm">
            <i class="fas fa-info-circle mr-1"></i>
            You have requested to log in with a recovery code. This login will not be remembered until you provide
            an authenticator app code at log in or disable 2FA and log in again.
        </div>
        <form method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>
            <div>
                <label asp-for="Input.RecoveryCode" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="Input.RecoveryCode" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="off" placeholder="Recovery code" />
                <span asp-validation-for="Input.RecoveryCode" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <button type="submit" class="w-full px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-sign-in-alt mr-1"></i> Log in
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
