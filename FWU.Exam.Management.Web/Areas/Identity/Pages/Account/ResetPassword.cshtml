@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-lock-open text-blue-600"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold text-gray-800">@ViewData["Title"]</h1>
                <p class="text-sm text-gray-500">Reset your password.</p>
            </div>
        </div>
        <form method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div>
                <label asp-for="Input.Email" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="Input.Email" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Input.Password" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="Input.Password" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
                <span asp-validation-for="Input.Password" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="Input.ConfirmPassword" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
                <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <button type="submit" class="w-full px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-key mr-1"></i> Reset
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
