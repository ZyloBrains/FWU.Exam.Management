@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="max-w-xl mx-auto mt-10">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-5">
            <i class="fas fa-envelope text-2xl text-blue-600"></i>
        </div>
        <h1 class="text-2xl font-bold text-gray-800 mb-4">@ViewData["Title"]</h1>
        <p class="text-gray-600">Please check your email to reset your password.</p>
    </div>
</div>
