@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "FWU - EMIS";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FWU - EMIS</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-image: url('@Url.Content("~/images/college.jpg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.40);
                z-index: 0;
            }

        .login-wrapper {
            position: relative;
            z-index: 1;
        }

        .card {
            border-radius: 1rem;
            overflow: hidden;
        }

        .right-panel {
            background: linear-gradient(135deg, #2563eb, #38bdf8);
        }

        .logo-circle {
            width: 9rem;
            height: 9rem;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>

<body class="d-flex align-items-center justify-content-center p-4">

    <div class="login-wrapper w-100" style="max-width: 900px;">
        <div class="card shadow-lg">
            <div class="row g-0">

                <!-- LEFT SECTION -->
                <div class="col-12 col-md-6 px-4 px-md-5 py-5 d-flex flex-column justify-content-center text-center">

                    <div class="mb-4">
                        <div class="bg-success bg-opacity-10 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 5rem; height: 5rem;">
                            <i class="bi bi-envelope-check text-success" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>

                    <h1 class="fs-4 fw-bold text-dark mb-2">Check your email</h1>
                    <p class="text-muted small mb-4">
                        We've sent a password reset link to your email address. Please check your inbox and follow the instructions.
                    </p>

                    <a asp-page="./Login"
                       class="btn btn-login btn-primary w-100 py-2 text-white"
                       style="background: linear-gradient(to right, #2563eb, #38bdf8); border: none; font-weight: 600;">
                        Back to login
                    </a>

                </div>

                <!-- RIGHT SECTION -->
                <div class="col-12 col-md-6 right-panel px-4 py-5 text-white d-none d-md-flex flex-column align-items-center justify-content-center text-center">

                    <img src="~/images/fwu-logo.jpg"
                         class="logo-circle mb-4"
                         alt="FWU Logo" />

                    <h2 class="fw-bold fs-4">FAR WESTERN UNIVERSITY</h2>

                    <p class="small mt-3 lh-base">
                        Secure examination management platform designed for modern university operations.
                    </p>

                    <div class="mt-4 small">
                        &copy; 2025 Far Western University. All rights reserved.
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
