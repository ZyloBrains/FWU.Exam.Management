@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-key text-amber-600 text-sm"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-800">@ViewData["Title"]</h3>
    </div>
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="bg-amber-50 border border-amber-200 text-amber-700 rounded-lg p-4 mb-6 text-sm" role="alert">
        <p class="font-semibold"><i class="fas fa-exclamation-triangle mr-1"></i> Put these codes in a safe place.</p>
        <p class="mt-1">If you lose your device and don't have the recovery codes you will lose access to your account.</p>
    </div>

    <div class="grid grid-cols-2 gap-2 max-w-md">
        @for (var row = 0; row < Model.RecoveryCodes.Length; row += 2)
        {
            <code class="px-3 py-2 bg-gray-100 border border-gray-200 rounded text-sm font-mono text-center">@Model.RecoveryCodes[row]</code>
            <code class="px-3 py-2 bg-gray-100 border border-gray-200 rounded text-sm font-mono text-center">@Model.RecoveryCodes[row + 1]</code>
        }
    </div>
</div>
