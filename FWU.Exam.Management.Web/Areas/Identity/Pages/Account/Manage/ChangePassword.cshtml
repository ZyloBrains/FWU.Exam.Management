@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    var loginUrl = Url.Page("/Account/Login", values: new { area = "Identity", returnUrl = Model.ReturnUrl });
}

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-lock text-blue-600 text-sm"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-800">@ViewData["Title"]</h3>
    </div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="change-password-form" method="post" class="space-y-5 max-w-lg">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>
        <div>
            <label asp-for="Input.OldPassword" class="block text-sm font-semibold text-gray-700 mb-2"></label>
            <input asp-for="Input.OldPassword" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
            <span asp-validation-for="Input.OldPassword" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="Input.NewPassword" class="block text-sm font-semibold text-gray-700 mb-2"></label>
            <input asp-for="Input.NewPassword" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
            <span asp-validation-for="Input.NewPassword" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-2"></label>
            <input asp-for="Input.ConfirmPassword" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
            <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div class="pt-4 border-t border-gray-200">
            <button type="submit" class="px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-key mr-1"></i> Update password
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.PasswordChanged)
    {
        <script>
            alert('Password changed successfully. Please log in again with your new password.');
            window.location.href = '@loginUrl';
        </script>
    }
}
