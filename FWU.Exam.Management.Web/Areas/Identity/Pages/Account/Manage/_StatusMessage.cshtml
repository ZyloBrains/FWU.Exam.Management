@model string

@if (!string.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    <div class="fixed top-4 right-4 z-[100] max-w-sm" id="manage-status-toast">
        <div class="toast-item flex items-start gap-3 rounded-lg @(isError ? "bg-red-50 border-red-200 text-red-700" : "bg-green-50 border-green-200 text-green-700") border px-4 py-3 shadow-lg text-sm" data-toast-type="@(isError ? "error" : "success")">
            <i class="fas @(isError ? "fa-circle-exclamation" : "fa-circle-check") mt-0.5 shrink-0"></i>
            <span class="flex-1 font-medium">@Model</span>
            <button type="button" class="toast-close shrink-0 @(isError ? "text-red-400 hover:text-red-600" : "text-green-400 hover:text-green-600")"><i class="fas fa-times"></i></button>
        </div>
    </div>
}

<style>
    .toast-item {
        transform: translateX(110%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
        opacity: 0;
    }
    .toast-item.toast-visible {
        transform: translateX(0);
        opacity: 1;
    }
    .toast-item.toast-hiding {
        transform: translateX(110%);
        opacity: 0;
    }
</style>

<script>
    (function () {
        var el = document.querySelector('#manage-status-toast .toast-item');
        if (!el) return;
        setTimeout(function () { el.classList.add('toast-visible'); }, 30);
        var btn = el.querySelector('.toast-close');
        function dismiss() {
            el.classList.add('toast-hiding');
            el.classList.remove('toast-visible');
            setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 300);
        }
        if (btn) btn.addEventListener('click', dismiss);
        var isError = el.getAttribute('data-toast-type') === 'error';
        setTimeout(dismiss, isError ? 6000 : 4000);
    })();
</script>
