@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    <div class="@(isError ? "bg-red-50 border border-red-200 text-red-700" : "bg-green-50 border border-green-200 text-green-700") rounded-lg p-4 mb-4 flex items-center justify-between" role="alert">
        <div class="flex items-center gap-2">
            <i class="fas @(isError ? "fa-exclamation-circle" : "fa-check-circle")"></i>
            <span class="text-sm font-medium">@Model</span>
        </div>
    </div>
}
