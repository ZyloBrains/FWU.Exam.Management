@page
@model LoginWith2faModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Two-factor authentication";
}

<div class="max-w-lg mx-auto mt-10">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-shield-alt text-blue-600"></i>
            </div>
            <h1 class="text-xl font-bold text-gray-800">@ViewData["Title"]</h1>
        </div>
        <p class="text-sm text-gray-600 mb-5">Your login is protected with an authenticator app. Enter your authenticator code below.</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="space-y-5">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>
            <div>
                <label asp-for="Input.TwoFactorCode" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="Input.TwoFactorCode" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="off" />
                <span asp-validation-for="Input.TwoFactorCode" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <div class="flex items-center gap-2">
                <input asp-for="Input.RememberMachine" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                <label asp-for="Input.RememberMachine" class="text-sm text-gray-600">
                    @Html.DisplayNameFor(m => m.Input.RememberMachine)
                </label>
            </div>
            <button type="submit" class="w-full px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-sign-in-alt mr-1"></i> Log in
            </button>
        </form>
        <p class="mt-5 text-sm text-gray-500">
            Don't have access to your authenticator device? You can
            <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-blue-600 hover:underline font-medium">log in with a recovery code</a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
