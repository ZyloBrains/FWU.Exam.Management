@page
@model ConfirmEmailModel
@{
    Layout = "/Areas/Identity/Pages/_AuthLayout.cshtml";
    ViewData["Title"] = "Confirm email";
}

<div class="max-w-xl mx-auto mt-10">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-5">
            <i class="fas fa-envelope-circle-check text-2xl text-green-600"></i>
        </div>
        <h1 class="text-2xl font-bold text-gray-800 mb-4">@ViewData["Title"]</h1>
        @if (!String.IsNullOrEmpty(Model.StatusMessage))
        {
            var isError = Model.StatusMessage.StartsWith("Error");
            <div class="@(isError ? "bg-red-50 border border-red-200 text-red-700" : "bg-green-50 border border-green-200 text-green-700") rounded-lg p-4 text-sm">
                <i class="fas @(isError ? "fa-exclamation-circle" : "fa-check-circle") mr-1"></i>
                @Model.StatusMessage
            </div>
        }
    </div>
</div>
