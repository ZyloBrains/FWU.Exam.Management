@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    var loginUrl = "/Identity/Account/Login";
}

<div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-5">
                <i class="fas fa-sign-out-alt text-2xl text-amber-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800 mb-4">@ViewData["Title"]</h1>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login" method="post">
                <button type="submit" class="px-6 py-3 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                    <i class="fas fa-sign-out-alt mr-1"></i> Click here to Logout
                </button>
            </form>
        }
        else
        {
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-5">
                <i class="fas fa-check-circle text-2xl text-green-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800 mb-4">@ViewData["Title"]</h1>
            <p class="text-gray-600">You have successfully logged out of the application.</p>
        }
    </div>
</div>
