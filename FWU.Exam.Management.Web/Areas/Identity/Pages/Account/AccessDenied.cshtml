@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    var tenantCode = HttpContext.Items["TenantCode"] as string;
    var returnUrl = Request.Query["ReturnUrl"].FirstOrDefault();
}

<div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-5">
            <i class="fas fa-ban text-2xl text-red-600"></i>
        </div>
        <h1 class="text-2xl font-bold text-red-600 mb-3">@ViewData["Title"]</h1>
        <p class="text-gray-600 mb-2">You do not have access to this resource.</p>
        @if (Model.CurrentRoles.Count > 0)
        {
            <div class="mb-4">
                <p class="text-sm text-gray-500">Your current role(s): <span class="font-medium text-gray-700">@string.Join(", ", Model.CurrentRoles)</span></p>
            </div>
        }
        @if (!string.IsNullOrEmpty(returnUrl))
        {
            <p class="text-xs text-gray-400 mb-4 break-all">Attempted: @returnUrl</p>
        }
        <div class="flex items-center justify-center gap-3">
            @if (!string.IsNullOrEmpty(tenantCode))
            {
                <a href="/tenant/@tenantCode/Dashboard/Index" class="inline-flex items-center gap-1.5 px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-home mr-1"></i> Back to Dashboard
                </a>
            }
            else
            {
                <a asp-controller="Dashboard" asp-action="Index" class="inline-flex items-center gap-1.5 px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-home mr-1"></i> Back to Dashboard
                </a>
            }
        </div>
    </div>
</div>
