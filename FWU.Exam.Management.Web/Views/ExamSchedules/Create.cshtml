@model fwu_examination_management_system.Data.Models.Exams.ExamSchedule

@{
    ViewData["Title"] = "Create Exam Schedule";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-indigo-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Exam Schedule</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>

            <!-- Section: Basic Information -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ExamScheduleName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ExamScheduleName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., Final Examination 2024" />
                        <span asp-validation-for="ExamScheduleName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ExamScheduleCode" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ExamScheduleCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., EXAM-2024-001" />
                        <span asp-validation-for="ExamScheduleCode" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Academic Details -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Academic Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="AcademicYearId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="AcademicYearId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.AcademicYearId">
                            <option value="">-- Select Academic Year --</option>
                        </select>
                        <span asp-validation-for="AcademicYearId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="LevelId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="LevelId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.LevelId">
                            <option value="">-- Select Level --</option>
                        </select>
                        <span asp-validation-for="LevelId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="YearPartId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="YearPartId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.YearPartId">
                            <option value="">-- Select Year Part --</option>
                        </select>
                        <span asp-validation-for="YearPartId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ExamTypeId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="ExamTypeId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.ExamTypeId">
                            <option value="">-- Select Exam Type --</option>
                        </select>
                        <span asp-validation-for="ExamTypeId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    @* <div>
                        <label asp-for="ExamScheduleParentId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="ExamScheduleParentId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.ExamScheduleParentId">
                            <option value="">-- Select Parent Schedule --</option>
                        </select>
                        <span asp-validation-for="ExamScheduleParentId" class="text-xs text-red-500 mt-1 block"></span>
                    </div> *@
                </div>
            </div>

            <!-- Section: Date Information (AD) -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Date Information (AD)</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="StartDateAd" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="StartDateAd" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="StartDateAd" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="EndDateAd" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="EndDateAd" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="EndDateAd" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Date Information (BS) -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Date Information (BS)</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="StartDateBs" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="StartDateBs" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., 2080/01/15" />
                        <span asp-validation-for="StartDateBs" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="EndDateBs" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="EndDateBs" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., 2080/02/15" />
                        <span asp-validation-for="EndDateBs" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Time Information -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Time Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="StartTime" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="StartTime" type="time" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="StartTime" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="EndTime" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="EndTime" type="time" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="EndTime" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Important Dates -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Important Dates</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="PublishedDate" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="PublishedDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="PublishedDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="CollegeApprovalDate" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="CollegeApprovalDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="CollegeApprovalDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="AdmissionCardReleaseDate" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="AdmissionCardReleaseDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="AdmissionCardReleaseDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ExtendedDate" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ExtendedDate" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="ExtendedDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Batch & Program Information -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Batch & Program Information</h2>
                <div class="grid grid-cols-1 gap-5">
                    <div>
                        <label asp-for="ProgramIds" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ProgramIds" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Comma-separated program IDs (e.g., 1,2,3)" />
                        <span asp-validation-for="ProgramIds" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="RegularBatchIds" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="RegularBatchIds" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Comma-separated regular batch IDs" />
                        <span asp-validation-for="RegularBatchIds" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="PartialBatchIds" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="PartialBatchIds" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Comma-separated partial batch IDs" />
                        <span asp-validation-for="PartialBatchIds" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Marks & Charges -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Marks & Charges</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="NegativeMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="NegativeMarks" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="0" />
                        <span asp-validation-for="NegativeMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ExtendedDateCharge" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ExtendedDateCharge" type="number" step="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="0" />
                        <span asp-validation-for="ExtendedDateCharge" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Remarks & Status -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Remarks & Status</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Remarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <textarea asp-for="Remarks" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Additional remarks..."></textarea>
                        <span asp-validation-for="Remarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div class="flex items-center gap-3">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-indigo-600 rounded focus:ring-indigo-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}