@model fwu_examination_management_system.Data.Models.Exams.ExamSchedule

@{
    ViewData["Title"] = "Delete Exam Schedule";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-times text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete Exam Schedule</h1>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <!-- Warning Alert -->
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this exam schedule? This action cannot be undone.
                </p>
            </div>
        </div>

        <!-- Details Section -->
        <div class="space-y-6">
            <!-- Basic Information -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Exam Schedule Name</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.ExamScheduleName)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Exam Schedule Code</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.ExamScheduleCode)</p>
                    </div>
                </div>
            </div>

            <!-- Academic Details -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Academic Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Academic Year</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.AcademicYear.AcademicYearName)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Level</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Level.LevelName)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Year Part</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.YearPart.YearPartName)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Exam Type</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.ExamType.Name)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Parent Schedule</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.ExamScheduleParent.ExamScheduleParentName)</p>
                    </div>
                </div>
            </div>

            <!-- Date Information (AD) -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Date Information (AD)</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Start Date (AD)</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.StartDateAd)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">End Date (AD)</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.EndDateAd)</p>
                    </div>
                </div>
            </div>

            <!-- Date Information (BS) -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Date Information (BS)</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Start Date (BS)</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.StartDateBs)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">End Date (BS)</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.EndDateBs)</p>
                    </div>
                </div>
            </div>

            <!-- Time Information -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Time Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Start Time</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.StartTime)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">End Time</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.EndTime)</p>
                    </div>
                </div>
            </div>

            <!-- Important Dates -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Important Dates</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Published Date</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.PublishedDate)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">College Approval Date</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.CollegeApprovalDate)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Admission Card Release Date</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.AdmissionCardReleaseDate)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Extended Date</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.ExtendedDate)</p>
                    </div>
                </div>
            </div>

            <!-- Batch & Program Information -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Batch & Program Information</h2>
                <div class="grid grid-cols-1 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Program IDs</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.ProgramIds)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Regular Batch IDs</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.RegularBatchIds)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Partial Batch IDs</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.PartialBatchIds)</p>
                    </div>
                </div>
            </div>

            <!-- Marks & Charges -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Marks & Charges</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Negative Marks</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.NegativeMarks)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Extended Date Charge</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.ExtendedDateCharge)</p>
                    </div>
                </div>
            </div>

            <!-- Remarks & Status -->
            <div>
                <h2 class="text-md font-semibold text-gray-700 mb-3 border-b pb-1">Remarks & Status</h2>
                <div class="grid grid-cols-1 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Remarks</p>
                        <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Remarks)</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</p>
                        <p class="text-gray-800 font-medium">
                            @if (Model.IsActive)
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">
                                    <i class="fas fa-check-circle text-xs"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded-full">
                                    <i class="fas fa-circle text-xs"></i> Inactive
                                </span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Form -->
        <form asp-action="Delete" method="post" class="mt-8">
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this exam schedule? This action cannot be undone.');"
                        class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}