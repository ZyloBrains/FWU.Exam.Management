@model IEnumerable<fwu_examination_management_system.Data.Models.Exams.ExamSchedule>

@{
    Layout = null;
    var generatedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exam Schedules Export</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: white;
            padding: 20px;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Header Styles */
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 3px solid #4f46e5;
        }

        .header h1 {
            font-size: 28px;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .header .subtitle {
            color: #6b7280;
            font-size: 14px;
        }

        .header .date {
            color: #9ca3af;
            font-size: 12px;
            margin-top: 8px;
        }

        /* Summary Cards */
        .summary {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .summary-card {
            background: #f3f4f6;
            border-radius: 12px;
            padding: 15px 25px;
            flex: 1;
            min-width: 150px;
        }

        .summary-card .label {
            font-size: 12px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .summary-card .value {
            font-size: 28px;
            font-weight: bold;
            color: #1f2937;
            margin-top: 5px;
        }

        /* Table Styles */
        .exam-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            margin-top: 20px;
        }

        .exam-table th {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            padding: 12px 10px;
            text-align: left;
            font-weight: 600;
            color: #374151;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .exam-table td {
            border: 1px solid #e5e7eb;
            padding: 10px;
            vertical-align: top;
        }

        .exam-table tr:nth-child(even) {
            background-color: #f9fafb;
        }

        /* Status Badge */
        .status-active {
            display: inline-block;
            padding: 2px 8px;
            background: #d1fae5;
            color: #065f46;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
        }

        .status-inactive {
            display: inline-block;
            padding: 2px 8px;
            background: #f3f4f6;
            color: #4b5563;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
        }

        /* Footer */
        .footer {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            font-size: 11px;
            color: #9ca3af;
        }

        /* Page break for printing */
         print {
            body {
                padding: 0;
                margin: 0;
            }
            .page-break {
                page-break-before: always;
            }
            .no-break {
                page-break-inside: avoid;
            }
            .summary-card {
                background: #f3f4f6;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .status-active, .status-inactive {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>📋 Exam Schedules Report</h1>
            <div class="subtitle">Complete list of examination schedules</div>
            <div class="date">Generated on: @generatedDate</div>
        </div>

        <!-- Summary Cards -->
        <div class="summary">
            <div class="summary-card">
                <div class="label">Total Schedules</div>
                <div class="value">@Model.Count()</div>
            </div>
            <div class="summary-card">
                <div class="label">Active Schedules</div>
                <div class="value">@Model.Count(x => x.IsActive)</div>
            </div>
            <div class="summary-card">
                <div class="label">Inactive Schedules</div>
                <div class="value">@Model.Count(x => !x.IsActive)</div>
            </div>
        </div>

        <!-- Exam Schedules Table -->
        <table class="exam-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Schedule Name</th>
                    <th>Code</th>
                    <th>Academic Year</th>
                    <th>Level / Part</th>
                    <th>Exam Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center;">@counter</td>
                        <td>
                            <strong>@item.ExamScheduleName</strong>
                            @if (!string.IsNullOrEmpty(item.Remarks))
                            {
                                <div style="font-size: 10px; color: #6b7280; margin-top: 2px;">@item.Remarks</div>
                            }
                        </td>
                        <td>@item.ExamScheduleCode</td>
                        <td>@item.AcademicYear?.AcademicYearName</td>
                        <td>
                            @item.Level?.LevelName <br />
                            <span style="font-size: 10px; color: #6b7280;">@item.YearPart?.YearPartName</span>
                        </td>
                        <td>@item.ExamType?.Name</td>
                        <td style="font-size: 11px;">@(item.StartDateAd?.ToString("yyyy-MM-dd") ?? "-")<br />@item.StartDateBs</td>
                        <td style="font-size: 11px;">@(item.EndDateAd?.ToString("yyyy-MM-dd") ?? "-")<br />@item.EndDateBs</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-inactive">Inactive</span>
                            }
                        </td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: #9ca3af;">
                <p>No exam schedules found.</p>
            </div>
        }

        <!-- Additional Details Section (for schedules with extended info) -->
        @if (Model.Any(x => !string.IsNullOrEmpty(x.ProgramIds) || !string.IsNullOrEmpty(x.RegularBatchIds) || x.NegativeMarks > 0))
        {
            <div style="margin-top: 30px; page-break-inside: avoid;">
                <h3 style="font-size: 16px; color: #374151; margin-bottom: 15px; padding-bottom: 8px; border-bottom: 2px solid #e5e7eb;">
                    Additional Details
                </h3>
                <table class="exam-table">
                    <thead>
                        <tr>
                            <th>Schedule Name</th>
                            <th>Negative Marks</th>
                            <th>Program IDs</th>
                            <th>Regular Batch IDs</th>
                            <th>Extended Date</th>
                            <th>Extended Charge</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Where(x => !string.IsNullOrEmpty(x.ProgramIds) || !string.IsNullOrEmpty(x.RegularBatchIds) || x.NegativeMarks > 0))
                        {
                            <tr>
                                <td>@item.ExamScheduleName</td>
                                <td>@(item.NegativeMarks > 0 ? item.NegativeMarks.ToString() : "-")</td>
                                <td style="font-size: 11px;">@item.ProgramIds</td>
                                <td style="font-size: 11px;">@item.RegularBatchIds</td>
                                <td style="font-size: 11px;">@(item.ExtendedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@(item.ExtendedDateCharge?.ToString() ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Footer -->
        <div class="footer">
            <p>This is a system-generated report from Examination Management System.</p>
            <p>© @DateTime.Now.Year - All Rights Reserved</p>
        </div>
    </div>

    <script>
        // Auto-trigger print dialog when page loads
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>