@model fwu_examination_management_system.Models.ExamSchedule
@{
    ViewData["Title"] = "Exam Schedule Details";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-clock text-orange-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Exam Schedule Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <p class="text-sm font-medium text-gray-600">Schedule Name</p>
                <p class="mt-1 text-gray-800 font-semibold">@Model.ExamScheduleName</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Schedule Code</p>
                <p class="mt-1 text-gray-800">@(Model.ExamScheduleCode ?? "—")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Academic Year ID</p>
                <p class="mt-1 text-gray-800">@Model.AcademicYearID</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Level ID</p>
                <p class="mt-1 text-gray-800">@Model.LevelID</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Year Part ID</p>
                <p class="mt-1 text-gray-800">@Model.YearPartID</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Exam Type ID</p>
                <p class="mt-1 text-gray-800">@Model.ExamTypeID</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Start Date (AD)</p>
                <p class="mt-1 text-gray-800">@(Model.StartFromAD?.ToString("yyyy-MM-dd") ?? "—")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">End Date (AD)</p>
                <p class="mt-1 text-gray-800">@(Model.EndToAD?.ToString("yyyy-MM-dd") ?? "—")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Start Date (BS)</p>
                <p class="mt-1 text-gray-800">@(Model.StartFromBS ?? "—")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">End Date (BS)</p>
                <p class="mt-1 text-gray-800">@(Model.EndToBS ?? "—")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Start Time</p>
                <p class="mt-1 text-gray-800">@Model.StartTime.ToString("hh\\:mm")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">End Time</p>
                <p class="mt-1 text-gray-800">@Model.EndTime.ToString("hh\\:mm")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Remarks</p>
                <p class="mt-1 text-gray-800">@(Model.Remarks ?? "—")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Status</p>
                <p class="mt-1">
                    @if (Model.Active)
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Active</span>
                    }
                    else
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Inactive</span>
                    }
                </p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-8 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.ExamScheduleID"
                   class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index"
               class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>
