@model fwu_examination_management_system.Models.ExamSchedule
@{
    ViewData["Title"] = "Create Exam Schedule";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-clock text-orange-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Exam Schedule</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <!-- Section: Basic Info -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="md:col-span-2">
                        <label asp-for="ExamScheduleName" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="ExamScheduleName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="Enter schedule name" />
                        <span asp-validation-for="ExamScheduleName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ExamScheduleCode" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="ExamScheduleCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="Enter schedule code" />
                    </div>
                    <div>
                        <label asp-for="AcademicYearId" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="AcademicYearId" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="Enter academic year ID" />
                    </div>
                    <div>
                        <label asp-for="LevelId" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="LevelId" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="Enter level ID" />
                    </div>
                    <div>
                        <label asp-for="YearPartId" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="YearPartId" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="Enter year part ID" />
                    </div>
                    <div>
                        <label asp-for="ExamTypeId" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="ExamTypeId" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="Enter exam type ID" />
                    </div>
                </div>
            </div>

            <!-- Section: Dates -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Schedule Dates</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="StartDateAd" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="StartDateAd" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" />
                    </div>
                    <div>
                        <label asp-for="EndDateAd" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="EndDateAd" type="date" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" />
                    </div>
                    <div>
                        <label asp-for="StartDateBs" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="StartDateBs" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="e.g. 2081-01-01" />
                    </div>
                    <div>
                        <label asp-for="EndDateBs" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="EndDateBs" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="e.g. 2081-03-30" />
                    </div>
                </div>
            </div>

            <!-- Section: Time -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Exam Time</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="StartTime" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="StartTime" type="time" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" />
                    </div>
                    <div>
                        <label asp-for="EndTime" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="EndTime" type="time" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" />
                    </div>
                </div>
            </div>

            <!-- Section: Remarks -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Remarks</h2>
                <textarea asp-for="Remarks" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="Enter remarks"></textarea>
            </div>

            <!-- Section: Options -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Options</h2>
                <div class="flex items-center gap-3">
                    <input asp-for="IsActive" type="checkbox" class="text-orange-600 rounded" />
                    <label asp-for="IsActive" class="text-sm font-medium text-gray-700"></label>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
