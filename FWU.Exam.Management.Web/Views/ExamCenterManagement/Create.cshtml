@model fwu_examination_management_system.ViewModels.CreateExamCenterViewModel

@{
    ViewData["Title"] = "Add Exam Center";
}

<div class="space-y-4">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h1 class="text-2xl font-semibold text-gray-800">Add Exam Center</h1>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <form asp-action="Create" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="ExamScheduleId" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <select asp-for="ExamScheduleId" asp-items="Model.ExamSchedules" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg"></select>
                <span asp-validation-for="ExamScheduleId" class="text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="CollegeId" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <select asp-for="CollegeId" asp-items="Model.Colleges" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg"></select>
                <span asp-validation-for="CollegeId" class="text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Remarks" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <textarea asp-for="Remarks" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg"></textarea>
                <span asp-validation-for="Remarks" class="text-sm text-red-600"></span>
            </div>

            <div class="flex items-center gap-2">
                <input asp-for="IsActive" type="checkbox" class="h-4 w-4" />
                <label asp-for="IsActive" class="text-sm text-gray-700"></label>
            </div>

            <div class="flex gap-2 pt-2">
                <button type="submit" class="px-5 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">Save</button>
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}