@using FWU.Exam.Management.Domain.Entities.Students
@model StudentRegistration

@{
    ViewData["Title"] = "Admission Form Details";
    var guardian = Model.StudentGuardians?.FirstOrDefault();
    var qualifications = Model.StudentQualifications?.ToList() ?? [];
}

<div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-5xl mx-auto">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h1 class="text-xl font-semibold text-gray-800">Admission Form Details</h1>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="text-sm text-indigo-600 hover:text-indigo-800 mr-4">Edit</a>
                <a asp-action="Index" class="text-sm text-teal-600 hover:text-teal-800">Back to List</a>
            </div>

            <div class="px-6 py-6 space-y-6">
                <!-- Personal Details -->
                <div>
                    <h2 class="text-sm font-semibold text-gray-700 mb-3">Personal Details</h2>
                    <div class="border-t border-gray-100 mb-4"></div>
                    <dl class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div><dt class="text-xs text-gray-500">Name</dt><dd class="text-sm font-medium text-gray-900">@($"{Model.FirstName} {Model.MiddleName} {Model.LastName}")</dd></div>
                        <div><dt class="text-xs text-gray-500">Birth Date BS</dt><dd class="text-sm text-gray-900">@Model.DateOfBirthBS</dd></div>
                        <div><dt class="text-xs text-gray-500">Birth Date AD</dt><dd class="text-sm text-gray-900">@Model.DateOfBirthAD</dd></div>
                        <div><dt class="text-xs text-gray-500">Gender</dt><dd class="text-sm text-gray-900">@Model.Gender?.GenderName</dd></div>
                        <div><dt class="text-xs text-gray-500">Citizenship No</dt><dd class="text-sm text-gray-900">@Model.CitizenshipNo</dd></div>
                        <div><dt class="text-xs text-gray-500">National ID</dt><dd class="text-sm text-gray-900">@Model.NationalId</dd></div>
                        <div><dt class="text-xs text-gray-500">Citizenship District</dt><dd class="text-sm text-gray-900">@Model.CitizenshipDistrict</dd></div>
                        <div><dt class="text-xs text-gray-500">Date of Issue</dt><dd class="text-sm text-gray-900">@Model.CitizenshipIssueDate?.ToString("yyyy-MM-dd")</dd></div>
                        <div><dt class="text-xs text-gray-500">Blood Group</dt><dd class="text-sm text-gray-900">@Model.BloodGroup</dd></div>
                        <div><dt class="text-xs text-gray-500">Birth Place</dt><dd class="text-sm text-gray-900">@Model.BirthPlace</dd></div>
                        <div><dt class="text-xs text-gray-500">Mobile</dt><dd class="text-sm text-gray-900">@Model.ContactNumber</dd></div>
                        <div><dt class="text-xs text-gray-500">Email</dt><dd class="text-sm text-gray-900">@Model.Email</dd></div>
                    </dl>
                </div>

                <!-- Address -->
                <div>
                    <h2 class="text-sm font-semibold text-gray-700 mb-3">Permanent Address</h2>
                    <div class="border-t border-gray-100 mb-4"></div>
                    <p class="text-sm text-gray-900">@Model.PermanentAddress?.FullAddress</p>
                </div>

                <!-- Guardian -->
                @if (guardian != null)
                {
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Guardian Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>
                        <dl class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div><dt class="text-xs text-gray-500">Father Name</dt><dd class="text-sm font-medium text-gray-900">@guardian.FatherName</dd></div>
                            <div><dt class="text-xs text-gray-500">Father Phone</dt><dd class="text-sm text-gray-900">@guardian.FatherContactNumber</dd></div>
                            <div><dt class="text-xs text-gray-500">Father Profession</dt><dd class="text-sm text-gray-900">@guardian.FatherProfession</dd></div>
                            <div><dt class="text-xs text-gray-500">Mother Name</dt><dd class="text-sm text-gray-900">@guardian.MotherName</dd></div>
                            <div><dt class="text-xs text-gray-500">Mother Phone</dt><dd class="text-sm text-gray-900">@guardian.MotherContactNumber</dd></div>
                            <div><dt class="text-xs text-gray-500">Guardian Email</dt><dd class="text-sm text-gray-900">@guardian.GuardianEmail</dd></div>
                        </dl>
                    </div>
                }

                <!-- Qualifications -->
                @if (qualifications.Count != 0)
                {
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Academic Qualifications</h2>
                        <div class="border-t border-gray-100 mb-4"></div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200 border border-gray-200 rounded-lg">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Level</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Institute</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Symbol No.</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Year</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Percentage</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Division</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    @foreach (var q in qualifications)
                                    {
                                        <tr>
                                            <td class="px-4 py-2 text-sm text-gray-900">@q.ProgramName</td>
                                            <td class="px-4 py-2 text-sm text-gray-600">@q.InstituteName</td>
                                            <td class="px-4 py-2 text-sm text-gray-600">@q.ExamRollNumber</td>
                                            <td class="px-4 py-2 text-sm text-gray-600">@q.PassedYear</td>
                                            <td class="px-4 py-2 text-sm text-gray-600">@q.Percentage</td>
                                            <td class="px-4 py-2 text-sm text-gray-600">@q.Division</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Status -->
                <div>
                    <h2 class="text-sm font-semibold text-gray-700 mb-3">Status</h2>
                    <div class="border-t border-gray-100 mb-4"></div>
                    <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
