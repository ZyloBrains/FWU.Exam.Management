@model IEnumerable<UserListItemViewModel>

@{
    var faculty = ViewBag.Faculty as Faculty;
    ViewData["Title"] = $"{faculty!.Name} Users";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500">
        <li><a asp-controller="Home" asp-action="Index" class="hover:text-blue-600">Home</a></li>
        <li><span class="mx-1">/</span></li>
        <li>
            <a asp-controller="FacultyDashboard" asp-action="Index" asp-route-officeCode="@faculty.OfficeCode" class="hover:text-blue-600">@faculty.Name</a>
        </li>
        <li><span class="mx-1">/</span></li>
        <li class="text-gray-800 font-medium">Users</li>
    </ol>
</nav>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
    <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Users — @faculty.Name</h1>
    <a asp-controller="FacultyDashboard" asp-action="CreateUser"
       asp-route-officeCode="@faculty.OfficeCode"
       class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
        <i class="fas fa-plus text-xs"></i> Add User
    </a>
</div>

@* Desktop Table (hidden on mobile) *@
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto hidden sm:block">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Email</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Roles</th>
                    <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-gray-800 font-medium">@item.Email</td>
                        <td class="px-4 py-3 text-gray-600">
                            @if (item.Roles.Count > 0)
                            {
                                @string.Join(", ", item.Roles)
                            }
                            else
                            {
                                <span class="text-gray-400">No roles</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <a asp-controller="FacultyDashboard" asp-action="EditUser"
                               asp-route-officeCode="@faculty.OfficeCode" asp-route-userId="@item.Id"
                               class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Edit</a>
                            <a asp-controller="FacultyDashboard" asp-action="AssignRoles"
                               asp-route-officeCode="@faculty.OfficeCode" asp-route-userId="@item.Id"
                               class="px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors">Roles</a>
                            <a href="javascript:void(0)" onclick="deleteUser('@item.Id')"
                               class="px-3 py-1.5 text-xs font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 transition-colors">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Mobile Card Layout (hidden on sm+) *@
    <div class="sm:hidden divide-y divide-gray-100">
        @foreach (var item in Model)
        {
            <div class="p-4 space-y-2">
                <p class="text-sm font-medium text-gray-900 truncate">@item.Email</p>
                <p class="text-xs text-gray-500">
                    @if (item.Roles.Count > 0)
                    {
                        @string.Join(", ", item.Roles)
                    }
                    else
                    {
                        <span class="text-gray-400">No roles</span>
                    }
                </p>
                <div class="flex items-center gap-2 pt-1">
                    <a asp-controller="FacultyDashboard" asp-action="EditUser"
                       asp-route-officeCode="@faculty.OfficeCode" asp-route-userId="@item.Id"
                       class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Edit</a>
                    <a asp-controller="FacultyDashboard" asp-action="AssignRoles"
                       asp-route-officeCode="@faculty.OfficeCode" asp-route-userId="@item.Id"
                       class="px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors">Roles</a>
                    <a href="javascript:void(0)" onclick="deleteUser('@item.Id')"
                       class="px-3 py-1.5 text-xs font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 transition-colors">Delete</a>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16">
            <i class="fas fa-users text-4xl text-gray-300 mb-4"></i>
            <h3 class="text-sm font-semibold text-gray-900 mb-1">No users found</h3>
            <p class="text-sm text-gray-500">No users are assigned to this faculty yet.</p>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function deleteUser(id) {
            if (!confirm('Are you sure you want to delete this user?')) return;
            $.ajax({
                url: '@Url.Action("DeleteAjax", "FacultyDashboard", new { officeCode = ViewBag.Faculty.OfficeCode })',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) { alert(response.message); location.reload(); }
                    else { alert('Error: ' + response.message); }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }
    </script>
}
