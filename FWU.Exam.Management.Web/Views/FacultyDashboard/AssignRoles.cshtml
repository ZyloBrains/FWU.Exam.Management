@model AssignRolesViewModel

@{
    var faculty = ViewBag.Faculty as Faculty;
    ViewData["Title"] = $"Assign Roles — {faculty!.Name}";FWU.Exam.Management.Web/Views/TenantDashboard/AssignRoles.cshtml
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="FacultyDashboard" asp-action="Index" asp-route-officeCode="@faculty.OfficeCode">@faculty.Name</a></li>
        <li class="breadcrumb-item"><a asp-controller="FacultyDashboard" asp-action="Users" asp-route-officeCode="@faculty.OfficeCode">Users</a></li>FWU.Exam.Management.Web/Views/TenantDashboard/AssignRoles.cshtml
        <li class="breadcrumb-item active">Assign Roles</li>
    </ol>
</nav>

<h1 class="h3 mb-1">Assign Roles</h1>
<h5 class="text-muted mb-4">@Model.UserEmail</h5>

<div class="row">
    <div class="col-md-4">
        <form asp-controller="FacultyDashboard" asp-action="AssignRoles"
              asp-route-officeCode="@faculty.OfficeCode" asp-route-userId="@Model.UserId"FWU.Exam.Management.Web/Views/TenantDashboard/AssignRoles.cshtml
              method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserEmail" />

            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <div class="form-check mb-2">
                    <input type="hidden" name="Roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                    <input type="checkbox" name="Roles[@i].IsAssigned" value="true"
                           id="role_@i" class="form-check-input"
                           @(Model.Roles[i].IsAssigned ? "checked" : "") />
                    <input type="hidden" name="Roles[@i].IsAssigned" value="false" />
                    <label class="form-check-label" for="role_@i">@Model.Roles[i].RoleName</label>
                </div>
            }

            <div class="mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-controller="FacultyDashboard" asp-action="Users"
                   asp-route-officeCode="@faculty.OfficeCode"FWU.Exam.Management.Web/Views/TenantDashboard/AssignRoles.cshtml
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
