@model CreateUserViewModel

@{
    var faculty = ViewBag.Faculty as Faculty;
    ViewData["Title"] = $"Add User — {faculty!.Name}";FWU.Exam.Management.Web/Views/TenantDashboard/CreateUser.cshtml
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="FacultyDashboard" asp-action="Index" asp-route-officeCode="@faculty.OfficeCode">@faculty.Name</a></li>
        <li class="breadcrumb-item"><a asp-controller="FacultyDashboard" asp-action="Users" asp-route-officeCode="@faculty.OfficeCode">Users</a></li>FWU.Exam.Management.Web/Views/TenantDashboard/CreateUser.cshtml
        <li class="breadcrumb-item active">Add User</li>
    </ol>
</nav>

<h1 class="h3 mb-4">Add User — @faculty.Name</h1>

<div class="row">
    <div class="col-md-5">
        <form asp-controller="FacultyDashboard" asp-action="CreateUser" asp-route-officeCode="@faculty.OfficeCode" method="post">FWU.Exam.Management.Web/Views/TenantDashboard/CreateUser.cshtml
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div>
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-controller="FacultyDashboard" asp-action="Users"
                   asp-route-officeCode="@faculty.OfficeCode"FWU.Exam.Management.Web/Views/TenantDashboard/CreateUser.cshtml
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
