@model CreateUserViewModel

@{
    var faculty = ViewBag.Faculty as Faculty;
    ViewData["Title"] = $"Add User — {faculty!.Name}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500">
        <li><a asp-controller="FacultyDashboard" asp-action="Index" asp-route-officeCode="@faculty.OfficeCode" class="hover:text-blue-600">@faculty.Name</a></li>
        <li><span class="mx-1">/</span></li>
        <li><a asp-controller="FacultyDashboard" asp-action="Users" asp-route-officeCode="@faculty.OfficeCode" class="hover:text-blue-600">Users</a></li>
        <li><span class="mx-1">/</span></li>
        <li class="text-gray-800 font-medium">Add User</li>
    </ol>
</nav>

<h1 class="text-xl sm:text-2xl font-bold text-gray-800 mb-4">Add User — @faculty.Name</h1>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6 max-w-lg">
    <form asp-controller="FacultyDashboard" asp-action="CreateUser" asp-route-officeCode="@faculty.OfficeCode" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg p-3"></div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Email" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Password" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="ConfirmPassword" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <select asp-for="CollegeId" asp-items="ViewBag.Colleges" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                <option value="">-- Select College --</option>
            </select>
            <span asp-validation-for="CollegeId" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                Create
            </button>
            <a asp-controller="FacultyDashboard" asp-action="Users"
               asp-route-officeCode="@faculty.OfficeCode"
               class="px-6 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
