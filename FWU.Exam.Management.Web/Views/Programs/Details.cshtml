@model fwu_examination_management_system.Data.Models.Program

@{
    ViewData["Title"] = "Program Details";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-book-open text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Program Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <!-- Basic Information Section -->
        <div class="mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Program Code</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.ProgramCode)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Short Name</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.ShortName)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Program Name</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.ProgramName)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Roll Number Prefix</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.RollNumberPrefix)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Status</p>
                    <div class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">Active</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Classification Section -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Classification</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Level</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Level.LevelName)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Faculty</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Faculty.FacultyCode)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Board</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Board.BoardName)</p>
                </div>
            </div>
        </div>

        <!-- Academic Details Section -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Academic Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Duration (Years)</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Duration)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Grand Total Marks</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.GrandTotalMarks)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Has Multiple Intakes</p>
                    <p class="mt-1 text-gray-800">@(Model.HasMultipleIntakes ? "Yes" : "No")</p>
                </div>
            </div>
        </div>

        <!-- Seat Information Section -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Seat Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Number of Seats</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.NumberOfSeats)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Scholarship Seats</p>
                    <p class="mt-1 text-gray-800 text-green-600 font-semibold">@Html.DisplayFor(model => model.ScholarshipSeats)</p>
                </div>
            </div>
        </div>

        <!-- Additional Information Section -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Additional Information</h2>
            <div class="grid grid-cols-1 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Remarks</p>
                    <p class="mt-1 text-gray-800">@(string.IsNullOrEmpty(Model.Remarks) ? "—" : Model.Remarks)</p>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>