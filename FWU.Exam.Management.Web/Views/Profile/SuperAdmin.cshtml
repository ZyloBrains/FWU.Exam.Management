@model FWU.Exam.Management.Web.ViewModels.SuperAdminProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div x-data="{ editProfileOpen: false }" class="max-w-6xl mx-auto space-y-6">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm" x-data="{ show: true }" x-show="show">
            <i class="fas fa-circle-check"></i>
            <span class="flex-1">@successMsg</span>
            <button type="button" x-on:click="show = false" class="text-green-500 hover:text-green-700"><i class="fas fa-times"></i></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm" x-data="{ show: true }" x-show="show">
            <i class="fas fa-circle-exclamation"></i>
            <span class="flex-1">@errorMsg</span>
            <button type="button" x-on:click="show = false" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
        </div>
    }

    @await Html.PartialAsync("_ProfileHeader", Model)

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3 sm:gap-4">
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-admin-blue flex items-center justify-center mb-2"><i class="fas fa-globe"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.TotalTenants</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Tenants</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-2"><i class="fas fa-users"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.TotalUsers</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Users</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2"><i class="fas fa-school"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.TotalColleges</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Colleges</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center mb-2"><i class="fas fa-user-graduate"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.TotalStudents</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Students</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 text-cyan-600 flex items-center justify-center mb-2"><i class="fas fa-stream"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.TotalPrograms</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Programs</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center mb-2"><i class="fas fa-calendar-check"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.ActiveExamSchedules</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Active Exam Schedules</span>
        </div>
    </div>

    <!-- Details -->
    <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="fas fa-user text-admin-blue"></i>
                <h2 class="font-semibold text-gray-900">Personal Information</h2>
            </div>
            <dl class="divide-y divide-gray-50">
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Full Name</dt>
                    <dd class="text-sm text-gray-900 font-medium">@Model.FullName</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Designation</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Designation) ? "—" : Model.Designation)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Phone</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Organization</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.OrganizationName) ? "—" : Model.OrganizationName)</dd>
                </div>
            </dl>
        </div>

        <div class="rounded-xl bg-white border border-gray-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="fas fa-shield-halved text-admin-blue"></i>
                <h2 class="font-semibold text-gray-900">Account Information</h2>
            </div>
            <dl class="divide-y divide-gray-50">
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Username</dt>
                    <dd class="text-sm text-gray-900 font-medium">@Model.UserName</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Email</dt>
                    <dd class="text-sm text-gray-900">@Model.Email</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Role</dt>
                    <dd class="text-sm text-gray-900">@Model.RoleLabel</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-32 text-sm text-gray-500 shrink-0">Validity</dt>
                    <dd class="text-sm text-gray-900">@(Model.ValidFrom?.ToString("yyyy-MM-dd") ?? "—") to @(Model.ValidTo?.ToString("yyyy-MM-dd") ?? "—")</dd>
                </div>
            </dl>
        </div>
    </div>
</div>
