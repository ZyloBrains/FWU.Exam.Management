@model FWU.Exam.Management.Web.ViewModels.SuperAdminProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div x-data="{ editProfileOpen: false }" class="space-y-6">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm" x-data="{ show: true }" x-show="show">
            <i class="fas fa-circle-check"></i>
            <span class="flex-1">@successMsg</span>
            <button type="button" x-on:click="show = false" class="text-green-500 hover:text-green-700"><i class="fas fa-times"></i></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm" x-data="{ show: true }" x-show="show">
            <i class="fas fa-circle-exclamation"></i>
            <span class="flex-1">@errorMsg</span>
            <button type="button" x-on:click="show = false" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
        </div>
    }

    @await Html.PartialAsync("_ProfileHeader", Model)

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Tenants</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalTenants</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-globe text-blue-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-building mr-1"></i>Active organizations</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Users</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalUsers</p>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-users text-green-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-green-600 font-medium"><i class="fas fa-user-check mr-1"></i>Registered accounts</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Colleges</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalColleges</p>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-school text-purple-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-building-columns mr-1"></i>Affiliated colleges</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Students</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalStudents</p>
                    </div>
                    <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-graduation-cap text-amber-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-user-graduate mr-1"></i>Registered students</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Programs</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalPrograms</p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-book text-red-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-stream mr-1"></i>Academic programs</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Exam Schedules</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.ActiveExamSchedules</p>
                    </div>
                    <div class="w-12 h-12 bg-cyan-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-clipboard-list text-cyan-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-calendar-check mr-1"></i>Active schedules</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6 border-b border-gray-200">
                <h3 class="text-base sm:text-lg font-semibold text-gray-800">Personal Information</h3>
                <p class="text-xs sm:text-sm text-gray-500 mt-1">Basic personal details</p>
            </div>
            <div class="p-6">
                <dl class="grid grid-cols-1 gap-x-8 gap-y-5">
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Full Name</dt>
                        <dd class="text-sm font-semibold text-gray-800 mt-1">@Model.FullName</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Designation</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Designation) ? "—" : Model.Designation)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Phone</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Organization</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.OrganizationName) ? "—" : Model.OrganizationName)</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6 border-b border-gray-200">
                <h3 class="text-base sm:text-lg font-semibold text-gray-800">Account Information</h3>
                <p class="text-xs sm:text-sm text-gray-500 mt-1">Login and security details</p>
            </div>
            <div class="p-6">
                <dl class="grid grid-cols-1 gap-x-8 gap-y-5">
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Username</dt>
                        <dd class="text-sm font-semibold text-gray-800 mt-1">@Model.UserName</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Email</dt>
                        <dd class="text-sm text-gray-800 mt-1">@Model.Email</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Role</dt>
                        <dd class="text-sm text-gray-800 mt-1">@Model.RoleLabel</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Validity</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(Model.ValidFrom?.ToString("yyyy-MM-dd") ?? "—") to @(Model.ValidTo?.ToString("yyyy-MM-dd") ?? "—")</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
</div>
