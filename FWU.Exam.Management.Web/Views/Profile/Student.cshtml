@model FWU.Exam.Management.Web.ViewModels.StudentProfileDetailViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div x-data="{ profilePromptOpen: @(Model.ShowProfileCompletionPopup ? "true" : "false") }" class="space-y-6">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm" x-data="{ show: true }" x-show="show" x-transition x-init="setTimeout(() => show = false, 5000)">
            <i class="fas fa-circle-check"></i>
            <span class="flex-1">@successMsg</span>
            <button type="button" x-on:click="show = false" class="text-green-500 hover:text-green-700"><i class="fas fa-times"></i></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm" x-data="{ show: true }" x-show="show" x-transition x-init="setTimeout(() => show = false, 5000)">
            <i class="fas fa-circle-exclamation"></i>
            <span class="flex-1">@errorMsg</span>
            <button type="button" x-on:click="show = false" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
        </div>
    }

    @await Html.PartialAsync("_ProfileHeader", Model)

    @if (Model.ShowProfileCompletionPopup)
    {
        <div x-show="profilePromptOpen" x-cloak
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-[110] flex items-center justify-center p-4"
             x-on:keydown.escape.window="profilePromptOpen = false">
            <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" x-on:click="profilePromptOpen = false"></div>
            <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden"
                 x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="transform opacity-0 scale-95"
                 x-transition:enter-end="transform opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-100"
                 x-transition:leave-start="transform opacity-100 scale-100"
                 x-transition:leave-end="transform opacity-0 scale-95">
                <div class="bg-gradient-to-r from-admin-blue to-admin-blue-dark px-6 py-5 relative overflow-hidden">
                    <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-white/10"></div>
                    <div class="absolute right-6 -bottom-8 w-16 h-16 rounded-full bg-white/10"></div>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0">
                            <i class="fas fa-clipboard-check text-white text-lg"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-white font-semibold text-lg">Complete Your Profile</h3>
                            <p class="text-blue-100 text-xs mt-0.5">@Model.MissingMandatoryFields.Count required field(s) missing</p>
                        </div>
                    </div>
                </div>
                <div class="p-6">
                    <p class="text-sm text-gray-600">Please fill in the following mandatory details to continue using exam forms and admit cards:</p>
                    <ul class="mt-4 space-y-2 max-h-56 overflow-y-auto pr-1">
                        @foreach (var field in Model.MissingMandatoryFields)
                        {
                            <li class="flex items-center gap-2 text-sm text-gray-700">
                                <span class="w-5 h-5 rounded-full bg-red-100 text-red-600 flex items-center justify-center shrink-0">
                                    <i class="fas fa-times text-[10px]"></i>
                                </span>
                                @field
                            </li>
                        }
                    </ul>
                    <div class="mt-6 flex flex-col-reverse sm:flex-row gap-3">
                        <button type="button" x-on:click="profilePromptOpen = false"
                                class="px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                            Close
                        </button>
                        <a asp-controller="Profile" asp-action="Edit"
                           class="flex-1 px-5 py-2 rounded-lg bg-gradient-to-r from-admin-blue to-admin-blue-dark text-white text-sm font-medium hover:opacity-95 transition-opacity shadow-sm text-center">
                            <i class="fas fa-user-edit mr-1"></i> Complete Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Statistics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-4 sm:p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Exam Registrations</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.ExamRegistrationCount</p>
                    </div>
                    <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-blue-100 to-blue-200 rounded-xl flex items-center justify-center">
                        <i class="fas fa-clipboard-list text-admin-blue text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-file-invoice mr-1"></i>Exam forms submitted</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-4 sm:p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Admit Cards</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.AdmitCardCount</p>
                    </div>
                    <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-green-100 to-green-200 rounded-xl flex items-center justify-center">
                        <i class="fas fa-ticket-alt text-green-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-green-600 font-medium"><i class="fas fa-check-circle mr-1"></i>Downloaded &amp; issued</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-4 sm:p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Payments</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.PaymentCount</p>
                    </div>
                    <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-amber-100 to-amber-200 rounded-xl flex items-center justify-center">
                        <i class="fas fa-credit-card text-amber-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-wallet mr-1"></i>Payments made</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-4 sm:p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Current Semester</p>
                        <p class="text-sm sm:text-base font-bold text-gray-800 mt-1 leading-tight">@(string.IsNullOrEmpty(Model.CurrentSemester) ? "—" : Model.CurrentSemester)</p>
                    </div>
                    <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-purple-100 to-purple-200 rounded-xl flex items-center justify-center">
                        <i class="fas fa-layer-group text-purple-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3 flex items-center">
                    <span class="text-xs text-gray-500 font-medium"><i class="fas fa-calendar-alt mr-1"></i>Active enrollment</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Academic Information -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-5 sm:px-6 py-4 bg-gradient-to-r from-admin-blue to-admin-blue-dark">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
                        <i class="fas fa-graduation-cap text-white"></i>
                    </span>
                    <div>
                        <h3 class="text-white font-semibold">Academic Information</h3>
                        <p class="text-blue-100 text-xs mt-0.5">Enrollment and program details</p>
                    </div>
                </div>
                <span class="shrink-0 inline-flex items-center gap-1.5 text-xs font-medium text-white bg-white/15 backdrop-blur px-2.5 py-1 rounded-full">
                    <i class="fas fa-calendar-check"></i>@(string.IsNullOrEmpty(Model.AcademicYear) ? "—" : Model.AcademicYear)
                </span>
            </div>
        </div>
        <div class="p-4 sm:p-6">
            <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6">
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Registration No.</dt>
                    <dd class="text-sm font-semibold text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.RegistrationNumber) ? "—" : Model.RegistrationNumber)</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">College Roll No.</dt>
                    <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.CollegeRollNumber) ? "—" : Model.CollegeRollNumber)</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Level</dt>
                    <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Level) ? "—" : Model.Level)</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Program</dt>
                    <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Program) ? "—" : Model.Program)</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">College</dt>
                    <dd class="text-sm text-gray-800 mt-1 break-words">@(string.IsNullOrEmpty(Model.College) ? "—" : Model.College)</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Admission Date</dt>
                    <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.AdmissionDate) ? "—" : Model.AdmissionDate)</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- Personal Details -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-5 sm:px-6 py-4 bg-gradient-to-r from-admin-blue to-admin-blue-dark">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
                        <i class="fas fa-user text-white"></i>
                    </span>
                    <div>
                        <h3 class="text-white font-semibold">Personal Information</h3>
                        <p class="text-blue-100 text-xs mt-0.5">Basic personal details</p>
                    </div>
                </div>
            </div>
            <div class="p-4 sm:p-6">
                <dl class="grid grid-cols-1 gap-x-8 gap-y-5">
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Full Name</dt>
                        <dd class="text-sm font-semibold text-gray-800 mt-1">@Model.FullName</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Name (Nepali)</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.NepaliName) ? "—" : Model.NepaliName)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Gender</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Gender) ? "—" : Model.Gender)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Date of Birth (AD)</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.DateOfBirthAD) ? "—" : Model.DateOfBirthAD)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Date of Birth (BS)</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.DateOfBirthBS) ? "—" : Model.DateOfBirthBS)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Blood Group</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.BloodGroup) ? "—" : Model.BloodGroup)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Nationality</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Nationality) ? "—" : Model.Nationality)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Religion</dt>
                        <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Religion) ? "—" : Model.Religion)</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-5 sm:px-6 py-4 bg-gradient-to-r from-admin-blue to-admin-blue-dark">
                    <div class="flex items-center gap-3">
                        <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
                            <i class="fas fa-address-card text-white"></i>
                        </span>
                        <div>
                            <h3 class="text-white font-semibold">Contact & Location</h3>
                            <p class="text-blue-100 text-xs mt-0.5">Contact and demographic information</p>
                        </div>
                    </div>
                </div>
                <div class="p-4 sm:p-6">
                    <dl class="grid grid-cols-1 gap-x-8 gap-y-5">
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Email</dt>
                            <dd class="text-sm text-gray-800 mt-1 break-words">@Model.Email</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Phone</dt>
                            <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Province</dt>
                            <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.PermanentProvinceName) ? "—" : Model.PermanentProvinceName)</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">District</dt>
                            <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.PermanentDistrictName) ? "—" : Model.PermanentDistrictName)</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Local Level</dt>
                            <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.PermanentLocalLevelName) ? "—" : Model.PermanentLocalLevelName)</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Address</dt>
                            @{
                                var addressParts = new[] { Model.PermanentLocalLevelName, Model.PermanentDistrictName, Model.PermanentProvinceName }
                                    .Where(a => !string.IsNullOrEmpty(a));
                                var displayAddress = !string.IsNullOrEmpty(Model.Address)
                                    ? Model.Address
                                    : (addressParts.Any() ? string.Join(", ", addressParts) : null);
                            }
                            <dd class="text-sm text-gray-800 mt-1 break-words">@(string.IsNullOrEmpty(displayAddress) ? "—" : displayAddress)</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Ethnicity</dt>
                            <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Ethnicity) ? "—" : Model.Ethnicity)</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Category</dt>
                            <dd class="text-sm text-gray-800 mt-1">@(string.IsNullOrEmpty(Model.Category) ? "—" : Model.Category)</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Signature -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-5 sm:px-6 py-4 bg-gradient-to-r from-admin-blue to-admin-blue-dark">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
                    <i class="fas fa-pen-nib text-white"></i>
                </span>
                <div>
                    <h3 class="text-white font-semibold">Signature</h3>
                    <p class="text-blue-100 text-xs mt-0.5">Your signature used on admit cards</p>
                </div>
            </div>
        </div>
        <div class="p-4 sm:p-6 flex items-center justify-center">
            <div class="h-24 w-full max-w-xs border border-gray-200 rounded-xl bg-gray-50 flex items-center justify-center overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.SignaturePath))
                {
                    <img src="@Model.SignaturePath" alt="Signature" class="max-h-full max-w-full object-contain" />
                }
                else
                {
                    <span class="text-gray-400 text-sm">No signature</span>
                }
            </div>
        </div>
    </div>

    <!-- Guardians -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-5 sm:px-6 py-4 bg-gradient-to-r from-admin-blue to-admin-blue-dark">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
                        <i class="fas fa-users text-white"></i>
                    </span>
                    <div>
                        <h3 class="text-white font-semibold">Guardian Information</h3>
                        <p class="text-blue-100 text-xs mt-0.5">Parents and guardian contact details</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="p-4 sm:p-6">
            @if (Model.Guardians.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var guardian in Model.Guardians)
                    {
                        <div class="rounded-xl border border-gray-200 bg-gradient-to-br from-gray-50 to-gray-100/60 p-4">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-admin-blue to-admin-blue-dark text-white">
                                    <i class="fas fa-user text-sm"></i>
                                </span>
                                <span class="text-sm font-semibold text-gray-800">@guardian.Relation</span>
                            </div>
                            <p class="text-sm font-medium text-gray-900">@(string.IsNullOrEmpty(guardian.Name) ? "—" : guardian.Name)</p>
                            <p class="text-xs text-gray-500 mt-1">
                                @if (!string.IsNullOrEmpty(guardian.ContactNumber))
                                {
                                    <span class="inline-flex items-center gap-1"><i class="fas fa-phone w-3"></i>@guardian.ContactNumber</span>
                                }
                                @if (!string.IsNullOrEmpty(guardian.Occupation))
                                {
                                    <span class="inline-flex items-center gap-1 ml-3"><i class="fas fa-briefcase w-3"></i>@guardian.Occupation</span>
                                }
                            </p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-10">
                    <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-user-times text-3xl text-gray-300"></i>
                    </div>
                    <p class="text-gray-500 font-medium">No guardian information available</p>
                </div>
            }
        </div>
    </div>

    <!-- Qualifications -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-5 sm:px-6 py-4 bg-gradient-to-r from-admin-blue to-admin-blue-dark">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
                        <i class="fas fa-school-circle-check text-white"></i>
                    </span>
                    <div>
                        <h3 class="text-white font-semibold">Academic Qualifications</h3>
                        <p class="text-blue-100 text-xs mt-0.5">Previous education records</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="p-4 sm:p-6">
            @if (Model.Qualifications.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase tracking-wide text-gray-500 border-b border-gray-200 bg-blue-50/60">
                                <th class="px-4 py-3 font-semibold">Institute</th>
                                <th class="px-4 py-3 font-semibold">Program</th>
                                <th class="px-4 py-3 font-semibold">Passed Year</th>
                                <th class="px-4 py-3 font-semibold">Percentage</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var q in Model.Qualifications)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 text-gray-900 font-medium">@q.InstituteName</td>
                                    <td class="px-4 py-3 text-gray-700">@(string.IsNullOrEmpty(q.ProgramName) ? "—" : q.ProgramName)</td>
                                    <td class="px-4 py-3 text-gray-700">@(string.IsNullOrEmpty(q.PassedYear) ? "—" : q.PassedYear)</td>
                                    <td class="px-4 py-3">
                                        @if (!string.IsNullOrEmpty(q.Percentage))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">@q.Percentage%</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-10">
                    <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-book text-3xl text-admin-blue"></i>
                    </div>
                    <p class="text-gray-500 font-medium">No qualification records available</p>
                </div>
            }
        </div>
    </div>
</div>
