@model FWU.Exam.Management.Web.ViewModels.StudentProfileDetailViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div x-data="{ editProfileOpen: false }" class="max-w-6xl mx-auto space-y-6">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm" x-data="{ show: true }" x-show="show">
            <i class="fas fa-circle-check"></i>
            <span class="flex-1">@successMsg</span>
            <button type="button" x-on:click="show = false" class="text-green-500 hover:text-green-700"><i class="fas fa-times"></i></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm" x-data="{ show: true }" x-show="show">
            <i class="fas fa-circle-exclamation"></i>
            <span class="flex-1">@errorMsg</span>
            <button type="button" x-on:click="show = false" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
        </div>
    }

    @await Html.PartialAsync("_ProfileHeader", Model)

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-admin-blue flex items-center justify-center mb-2"><i class="fas fa-clipboard-list"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.ExamRegistrationCount</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Exam Registrations</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2"><i class="fas fa-ticket-alt"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.AdmitCardCount</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Admit Cards</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center mb-2"><i class="fas fa-credit-card"></i></div>
            <span class="text-xl font-bold text-gray-900">@Model.PaymentCount</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Payments Made</span>
        </div>
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm p-4 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-2"><i class="fas fa-layer-group"></i></div>
            <span class="text-base font-bold text-gray-900 px-1 text-center break-words leading-tight">@(string.IsNullOrEmpty(Model.CurrentSemester) ? "—" : Model.CurrentSemester)</span>
            <span class="text-xs text-gray-500 font-medium mt-0.5">Current Semester</span>
        </div>
    </div>

    <!-- Academic Information -->
    <div class="rounded-xl bg-white border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
            <i class="fas fa-graduation-cap text-admin-blue"></i>
            <h2 class="font-semibold text-gray-900">Academic Information</h2>
            @if (!string.IsNullOrEmpty(Model.AcademicYear))
            {
                <span class="ml-auto text-xs font-medium text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full">@Model.AcademicYear</span>
            }
        </div>
        <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8">
            <div class="flex items-start gap-4 px-5 py-3">
                <dt class="w-36 text-sm text-gray-500 shrink-0">Registration No.</dt>
                <dd class="text-sm text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.RegistrationNumber) ? "—" : Model.RegistrationNumber)</dd>
            </div>
            <div class="flex items-start gap-4 px-5 py-3">
                <dt class="w-36 text-sm text-gray-500 shrink-0">College Roll No.</dt>
                <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.CollegeRollNumber) ? "—" : Model.CollegeRollNumber)</dd>
            </div>
            <div class="flex items-start gap-4 px-5 py-3">
                <dt class="w-36 text-sm text-gray-500 shrink-0">Level</dt>
                <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Level) ? "—" : Model.Level)</dd>
            </div>
            <div class="flex items-start gap-4 px-5 py-3">
                <dt class="w-36 text-sm text-gray-500 shrink-0">Program</dt>
                <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Program) ? "—" : Model.Program)</dd>
            </div>
            <div class="flex items-start gap-4 px-5 py-3">
                <dt class="w-36 text-sm text-gray-500 shrink-0">College</dt>
                <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.College) ? "—" : Model.College)</dd>
            </div>
            <div class="flex items-start gap-4 px-5 py-3">
                <dt class="w-36 text-sm text-gray-500 shrink-0">Admission Date</dt>
                <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.AdmissionDate) ? "—" : Model.AdmissionDate)</dd>
            </div>
            <div class="flex items-start gap-4 px-5 py-3">
                <dt class="w-36 text-sm text-gray-500 shrink-0">Program Code</dt>
                <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.ProgramCode) ? "—" : Model.ProgramCode)</dd>
            </div>
        </dl>
    </div>

    <!-- Personal Details -->
    <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
        <div class="rounded-xl bg-white border border-gray-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="fas fa-user text-admin-blue"></i>
                <h2 class="font-semibold text-gray-900">Personal Information</h2>
            </div>
            <dl class="divide-y divide-gray-50">
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Full Name</dt>
                    <dd class="text-sm text-gray-900 font-medium">@Model.FullName</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Name (Nepali)</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.NepaliName) ? "—" : Model.NepaliName)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Gender</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Gender) ? "—" : Model.Gender)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Date of Birth (AD)</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.DateOfBirthAD) ? "—" : Model.DateOfBirthAD)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Date of Birth (BS)</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.DateOfBirthBS) ? "—" : Model.DateOfBirthBS)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Blood Group</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.BloodGroup) ? "—" : Model.BloodGroup)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Nationality</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Nationality) ? "—" : Model.Nationality)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Religion</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Religion) ? "—" : Model.Religion)</dd>
                </div>
            </dl>
        </div>

        <div class="rounded-xl bg-white border border-gray-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="fas fa-id-card text-admin-blue"></i>
                <h2 class="font-semibold text-gray-900">Other Details</h2>
            </div>
            <dl class="divide-y divide-gray-50">
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Email</dt>
                    <dd class="text-sm text-gray-900">@Model.Email</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Phone</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Address</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Ethnicity</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Ethnicity) ? "—" : Model.Ethnicity)</dd>
                </div>
                <div class="flex items-start gap-4 px-5 py-3">
                    <dt class="w-36 text-sm text-gray-500 shrink-0">Category</dt>
                    <dd class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.Category) ? "—" : Model.Category)</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- Guardians -->
    <div class="rounded-xl bg-white border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
            <i class="fas fa-people-roof text-admin-blue"></i>
            <h2 class="font-semibold text-gray-900">Guardian Information</h2>
        </div>
        @if (Model.Guardians.Any())
        {
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 p-5">
                @foreach (var guardian in Model.Guardians)
                {
                    <div class="rounded-xl border border-gray-100 bg-gray-50/50 p-4">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-admin-blue/10 text-admin-blue">
                                <i class="fas fa-user"></i>
                            </span>
                            <span class="text-sm font-semibold text-gray-800">@guardian.Relation</span>
                        </div>
                        <p class="text-sm text-gray-900 font-medium">@(string.IsNullOrEmpty(guardian.Name) ? "—" : guardian.Name)</p>
                        <p class="text-xs text-gray-500 mt-1">
                            @if (!string.IsNullOrEmpty(guardian.ContactNumber))
                            {
                                <span class="inline-flex items-center gap-1"><i class="fas fa-phone w-3"></i>@guardian.ContactNumber</span>
                            }
                            @if (!string.IsNullOrEmpty(guardian.Occupation))
                            {
                                <span class="inline-flex items-center gap-1 ml-3"><i class="fas fa-briefcase w-3"></i>@guardian.Occupation</span>
                            }
                        </p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="px-5 py-6 text-sm text-gray-500">No guardian information available.</p>
        }
    </div>

    <!-- Qualifications -->
    <div class="rounded-xl bg-white border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
            <i class="fas fa-school-circle-check text-admin-blue"></i>
            <h2 class="font-semibold text-gray-900">Academic Qualifications</h2>
        </div>
        @if (Model.Qualifications.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wide text-gray-500 border-b border-gray-100 bg-gray-50/50">
                            <th class="px-5 py-3 font-semibold">Institute</th>
                            <th class="px-5 py-3 font-semibold">Program</th>
                            <th class="px-5 py-3 font-semibold">Passed Year</th>
                            <th class="px-5 py-3 font-semibold">Percentage</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var q in Model.Qualifications)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="px-5 py-3 text-gray-900 font-medium">@q.InstituteName</td>
                                <td class="px-5 py-3 text-gray-700">@(string.IsNullOrEmpty(q.ProgramName) ? "—" : q.ProgramName)</td>
                                <td class="px-5 py-3 text-gray-700">@(string.IsNullOrEmpty(q.PassedYear) ? "—" : q.PassedYear)</td>
                                <td class="px-5 py-3">
                                    @if (!string.IsNullOrEmpty(q.Percentage))
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">@q.Percentage%</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="px-5 py-6 text-sm text-gray-500">No qualification records available.</p>
        }
    </div>
</div>
