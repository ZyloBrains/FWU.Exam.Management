@model FWU.Exam.Management.Web.ViewModels.ProfileBaseViewModel
@using FWU.Exam.Management.Domain.Extensions
@using FWU.Exam.Management.Domain.Entities.Location

@{
    var initials = Model.FullName.GetInitials();
    var fallbackColor = "bg-gradient-to-br from-admin-blue-light to-admin-blue-dark";
    var studentVm = Model as FWU.Exam.Management.Web.ViewModels.StudentProfileDetailViewModel;
    var isStudentView = studentVm != null;
    var selProvinceId = studentVm?.PermanentProvinceId ?? 0;
    var selDistrictId = studentVm?.PermanentDistrictId ?? 0;
    var selLocalLevelId = studentVm?.PermanentLocalLevelId ?? 0;
    var selGenderId = studentVm?.RegistrationGenderId ?? 0;
    var selEthnicityId = studentVm?.RegistrationEthnicityId ?? 0;
    var provinces = ((List<Province>?)ViewData["Provinces"] ?? []).Select(p => new { id = p.Id, name = p.ProvinceName }).ToList();
    var districts = ((List<District>?)ViewData["Districts"] ?? []).Select(d => new { id = d.Id, name = d.DistrictName, provinceId = d.ProvinceId }).ToList();
    var localLevels = ((List<LocalLevel>?)ViewData["LocalLevels"] ?? []).Select(l => new { id = l.Id, name = l.LocalLevelName, districtId = l.DistrictId }).ToList();
    var genders = ((List<Gender>?)ViewData["Genders"] ?? []).Select(g => new { id = g.Id, name = g.GenderName }).ToList();
    var ethnicities = ((List<Ethnicity>?)ViewData["Ethnicities"] ?? []).Select(e => new { id = e.Id, name = e.EthnicityName }).ToList();
    var profileDataJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        provinces,
        districts,
        localLevels,
        genders,
        ethnicities,
        provinceId = selProvinceId,
        districtId = selDistrictId,
        localLevelId = selLocalLevelId,
        genderId = selGenderId,
        ethnicityId = selEthnicityId
    });
}

<!-- Profile Header Card -->
<div class="relative overflow-hidden rounded-2xl bg-white shadow-sm border border-gray-100">
    <!-- Cover Banner -->
    <div class="h-36 sm:h-44 relative">
        <img src="@Model.CoverImagePath" alt="@Model.OrganizationName" class="absolute inset-0 w-full h-full object-contain" />
        <div class="absolute inset-0 bg-black/10"></div>
        <div class="absolute bottom-4 right-5 hidden sm:flex items-center gap-2">
            @if (!string.IsNullOrEmpty(Model.OrganizationLogo))
            {
                <img src="@Model.OrganizationLogo" alt="@Model.OrganizationName" class="h-10 w-10 object-contain rounded-lg bg-white/90 p-1 shadow" />
            }
            @if (!string.IsNullOrEmpty(Model.OrganizationName))
            {
                <span class="text-white/90 text-sm font-medium drop-shadow px-2 py-1 rounded-lg bg-black/10 backdrop-blur-sm">@Model.OrganizationName</span>
            }
        </div>
    </div>

    <div class="px-5 sm:px-8 pb-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-4 -mt-12">
            <!-- Avatar -->
            <div class="relative shrink-0">
                <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-2xl border-4 border-white shadow-xl ring-4 ring-admin-blue/20 overflow-hidden @(string.IsNullOrEmpty(Model.ProfilePath) ? fallbackColor : "bg-white") flex items-center justify-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePath))
                    {
                        <img src="@Model.ProfilePath" alt="@Model.FullName" class="w-full h-full object-contain" />
                    }
                    else
                    {
                        <span class="text-white text-3xl font-bold">@initials</span>
                    }
                </div>
                <div class="absolute bottom-1 right-1 w-6 h-6 rounded-full bg-white shadow flex items-center justify-center">
                    <i class="fas fa-circle-check text-green-500 text-sm"></i>
                </div>
            </div>

            <!-- Identity -->
            <div class="flex-1 min-w-0 sm:pb-1">
                @if (Model.Roles.Contains("Student"))
                {
                    <p class="text-xl sm:text-2xl font-bold text-gray-900 mt-0.5">@Model.FullName</p>
                }
                else if (!string.IsNullOrEmpty(Model.Designation))
                {
                    <p class="text-sm text-gray-600 mt-0.5">@Model.Designation</p>
                }

                <!-- Meta row -->
                <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 mt-3 text-sm text-gray-600">
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <span class="inline-flex items-center gap-1.5 min-w-0">
                            <i class="fas fa-envelope text-gray-400 w-4 shrink-0"></i>
                            <span class="truncate">@Model.Email</span>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <span class="inline-flex items-center gap-1.5">
                            <i class="fas fa-phone text-gray-400 w-4 shrink-0"></i>
                            <span>@Model.PhoneNumber</span>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.TenantName))
                    {
                        <span class="inline-flex items-center gap-1.5">
                            <i class="fas fa-building text-gray-400 w-4 shrink-0"></i>
                            <span>@Model.TenantName</span>
                        </span>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center sm:pb-1">
                <a asp-controller="Profile" asp-action="Edit"
                   class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-admin-blue to-admin-blue-dark text-white text-sm font-semibold hover:opacity-95 transition-opacity shadow-md">
                    <i class="fas fa-user-edit"></i> Edit Profile
                </a>
            </div>
        </div>

        <!-- Account status badges -->
        <div class="flex flex-wrap gap-2 mt-5 pt-4 border-t border-gray-100">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium @(Model.EmailConfirmed ? "bg-green-50 text-green-700 border border-green-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                <i class="fas fa-envelope-circle-check"></i> Email @(Model.EmailConfirmed ? "Verified" : "Not Verified")
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium @(Model.TwoFactorEnabled ? "bg-green-50 text-green-700 border border-green-200" : "bg-gray-50 text-gray-600 border border-gray-200")">
                <i class="fas fa-shield-halved"></i> Two-Factor @(Model.TwoFactorEnabled ? "On" : "Off")
            </span>
            @if (Model.Roles.Count > 1)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200">
                    <i class="fas fa-users-gear"></i> Roles: @string.Join(", ", Model.Roles)
                </span>
            }
        </div>
    </div>
</div>
