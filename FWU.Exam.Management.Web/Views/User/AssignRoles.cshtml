@model AssignRolesViewModel

@{
    ViewData["Title"] = "Assign Roles";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-user-shield text-purple-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Assign Roles</h1>
                <p class="text-sm text-gray-500 mt-0.5">@Model.UserEmail</p>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="AssignRoles" class="space-y-5">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserEmail" />

            <!-- Section: Roles -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Available Roles</h2>
                <div class="space-y-3">
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-300 hover:bg-gray-50 cursor-pointer transition">
                            <input type="hidden" name="Roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                            <input type="checkbox" name="Roles[@i].IsAssigned" value="true"
                                   id="role_@i"
                                   class="w-4 h-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500"
                                   @(Model.Roles[i].IsAssigned ? "checked" : "") />
                            <input type="hidden" name="Roles[@i].IsAssigned" value="false" />
                            <div class="flex items-center gap-2">
                                <i class="fas fa-user-shield text-purple-600"></i>
                                <span class="text-sm font-medium text-gray-700">@Model.Roles[i].RoleName</span>
                            </div>
                        </label>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Save
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
