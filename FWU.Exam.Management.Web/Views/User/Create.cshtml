@model CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors shrink-0">
                <i class="fas fa-arrow-left text-gray-600"></i>
            </a>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center shrink-0">
                    <i class="fas fa-user-plus text-blue-600"></i>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Create User</h1>
                    <p class="text-sm text-gray-500 mt-0.5">Fill in the details below to create a new user</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6 lg:p-8" x-data="{ role: '@Model.SelectedRole' }">
        <form asp-action="Create" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-3"></div>

            <!-- Section: Basic Info -->
            <div>
                <h3 class="text-base sm:text-lg font-semibold text-gray-700 mb-3 border-b border-gray-200 pb-2">User Information</h3>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Email" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="Email" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
                        <div>
                            <label asp-for="Password" class="text-sm font-medium text-gray-700"></label>
                            <input asp-for="Password" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" placeholder="Enter password" />
                            <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="ConfirmPassword" class="text-sm font-medium text-gray-700"></label>
                            <input asp-for="ConfirmPassword" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" placeholder="Confirm password" />
                            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="SelectedRole" class="text-sm font-medium text-gray-700"></label>
                        <select asp-for="SelectedRole"
                                class="select2 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-white">
                            <option value="">-- Select Role --</option>
                            @foreach (var r in ViewBag.RolesList)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <span asp-validation-for="SelectedRole" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <!-- Faculty dropdown (FacultyAdmin) -->
                    <div x-show="role === '@Role.FacultyAdmin'" x-transition>
                        <label asp-for="FacultyId" class="text-sm font-medium text-gray-700"></label>
                        <select asp-for="FacultyId" asp-items="ViewBag.Faculties"
                                class="select2 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-white">
                            <option value="">-- Select Faculty --</option>
                        </select>
                        <span asp-validation-for="FacultyId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <!-- College dropdown (CollegeAdmin & Student) -->
                    <div x-show="role === '@Role.CollegeAdmin' || role === '@Role.Student'" x-transition>
                        <label asp-for="CollegeId" class="text-sm font-medium text-gray-700"></label>
                        <select asp-for="CollegeId" asp-items="ViewBag.Colleges"
                                class="select2 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-white">
                            <option value="">-- Select College --</option>
                        </select>
                        <span asp-validation-for="CollegeId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center gap-3 pt-4 border-t border-gray-200">
                <a asp-action="Index" class="flex-1 sm:flex-none text-center px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-sm">
                    Cancel
                </a>
                <button type="submit" class="flex-1 sm:flex-none text-center px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-sm">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
            </div>
        </form>
    </div>

    <!-- Batch Create Users from Existing Registrations -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6 lg:p-8" x-data="batchCreate()">
        <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center shrink-0">
                <i class="fas fa-users-cog text-amber-600"></i>
            </div>
            <div>
                <h2 class="text-lg sm:text-xl font-bold text-gray-800">Create Users from Existing Registrations</h2>
                <p class="text-sm text-gray-500 mt-0.5">Select registered students who don't have a login account yet</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-5">
            <select x-model="filterCollegeId" class="flex-1 border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                <option value="">All Colleges</option>
                @foreach (var c in ViewBag.Colleges)
                {
                    <option value="@c.Value">@c.Text</option>
                }
            </select>
            <select x-model="filterFacultyId" class="flex-1 border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                <option value="">All Faculties</option>
                @foreach (var f in ViewBag.Faculties)
                {
                    <option value="@f.Value">@f.Text</option>
                }
            </select>
            <button x-on:click="loadStudents()" :disabled="loading"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-sm disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap">
                <i class="fas" :class="loading ? 'fa-spinner fa-spin' : 'fa-search'"></i>
                <span x-text="loading ? 'Loading...' : 'Load Students'"></span>
            </button>
        </div>

        <!-- Alert Messages -->
        <template x-if="alertMessage">
            <div :class="alertType === 'success' ? 'bg-green-50 text-green-700 border-green-200' : alertType === 'error' ? 'bg-red-50 text-red-700 border-red-200' : alertType === 'warning' ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-blue-50 text-blue-700 border-blue-200'"
                 class="border rounded-lg p-3 mb-4 text-sm flex items-center gap-2">
                <i class="fas" :class="alertType === 'success' ? 'fa-check-circle' : alertType === 'error' ? 'fa-exclamation-circle' : alertType === 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle'"></i>
                <span x-text="alertMessage"></span>
                <button x-on:click="alertMessage = ''" class="ml-auto text-current opacity-50 hover:opacity-100">&times;</button>
            </div>
        </template>

        <!-- Progress Bar (shown during job processing) -->
        <template x-if="activeJobId !== null">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-5 mb-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <i class="fas" :class="jobStatus === 'Completed' ? 'fa-check-circle text-green-600' : jobStatus === 'Failed' ? 'fa-exclamation-circle text-red-600' : 'fa-spinner fa-spin text-blue-600'"></i>
                        <span class="text-sm font-semibold text-gray-800" x-text="jobStatus === 'Completed' ? 'Completed' : jobStatus === 'Failed' ? 'Failed' : 'Processing...'"></span>
                    </div>
                    <span class="text-sm text-gray-600" x-text="processed + ' / ' + totalStudents"></span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-3 mb-3">
                    <div class="h-3 rounded-full transition-all duration-300"
                         :class="jobStatus === 'Completed' ? 'bg-green-500' : jobStatus === 'Failed' ? 'bg-red-500' : 'bg-blue-600'"
                         :style="'width: ' + progress + '%'"></div>
                </div>
                <div class="flex items-center gap-4 text-sm">
                    <span class="text-green-600"><i class="fas fa-check mr-1"></i> <span x-text="successCount"></span> created</span>
                    <span class="text-red-600" x-show="failedCount > 0"><i class="fas fa-times mr-1"></i> <span x-text="failedCount"></span> failed</span>
                </div>
                <template x-if="jobStatus === 'Completed' || jobStatus === 'Failed'">
                    <div class="mt-3 pt-3 border-t border-blue-200">
                        <button x-on:click="dismissJob()" class="text-sm font-medium text-blue-600 hover:text-blue-800">
                            <i class="fas fa-times mr-1"></i> Dismiss
                        </button>
                    </div>
                </template>
            </div>
        </template>

        <!-- Results Table -->
        <template x-if="students.length > 0 && activeJobId === null">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <p class="text-sm text-gray-600">
                        <span x-text="totalCount"></span> students found without login accounts
                    </p>
                    <div class="flex items-center gap-3">
                        <span x-show="selectedIds.length > 0" class="text-sm font-medium text-blue-600" x-text="selectedIds.length + ' selected'"></span>
                        <button x-show="selectedIds.length > 0" x-on:click="createUsers()"
                                :disabled="creating"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition shadow-sm disabled:opacity-50">
                            <i class="fas" :class="creating ? 'fa-spinner fa-spin' : 'fa-user-plus'"></i>
                            <span x-text="creating ? 'Starting...' : 'Create Selected Users'"></span>
                        </button>
                        <button x-show="totalCount > 0" x-on:click="createAllMatching()"
                                :disabled="creating"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600 text-white text-sm font-semibold rounded-lg hover:bg-purple-700 transition shadow-sm disabled:opacity-50">
                            <i class="fas" :class="creating ? 'fa-spinner fa-spin' : 'fa-users'"></i>
                            <span x-text="creating ? 'Starting...' : 'Create All Matching (' + totalCount + ')'"></span>
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto border border-gray-200 rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left">
                                    <div class="flex items-center gap-2">
                                        <input type="checkbox" x-on:change="togglePage($event)"
                                               :checked="isPageSelected()"
                                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                                        <span class="text-[10px] text-gray-400" x-show="totalCount > pageSize">page</span>
                                    </div>
                                </th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Name</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Login ID</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Reg. No</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">College</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Faculty</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 bg-white">
                            <template x-for="s in students" :key="s.id">
                                <tr class="hover:bg-blue-50 transition-colors" :class="selectedIds.includes(s.id) ? 'bg-blue-50' : ''">
                                    <td class="px-4 py-3">
                                        <input type="checkbox" :value="s.id"
                                               x-on:change="toggleSelect(s.id)"
                                               :checked="selectedIds.includes(s.id)"
                                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                                    </td>
                                    <td class="px-4 py-3 text-sm font-medium text-gray-800" x-text="s.fullName"></td>
                                    <td class="px-4 py-3 text-sm">
                                        <span x-show="s.hasEmail" class="text-gray-700" x-text="s.email"></span>
                                        <span x-show="!s.hasEmail" class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-100 text-amber-700 text-xs font-medium rounded-full">
                                            <i class="fas fa-key text-[10px]"></i>
                                            <span x-text="s.registrationNumber"></span>
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-600" x-text="s.registrationNumber || '-'"></td>
                                    <td class="px-4 py-3 text-sm text-gray-600" x-text="s.collegeName"></td>
                                    <td class="px-4 py-3 text-sm text-gray-600" x-text="s.facultyName || '-'"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="flex items-center justify-between mt-4">
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                        <span>Showing</span>
                        <span class="font-medium" x-text="((page - 1) * pageSize) + 1"></span>
                        <span>to</span>
                        <span class="font-medium" x-text="Math.min(page * pageSize, totalCount)"></span>
                        <span>of</span>
                        <span class="font-medium" x-text="totalCount"></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <select x-model="pageSize" x-on:change="page = 1; loadStudents()"
                                class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm bg-white">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <button x-on:click="changePage(page - 1)" :disabled="page <= 1"
                                class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <template x-for="p in pageNumbers" :key="p">
                            <button x-on:click="changePage(p)"
                                    :class="p === page ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-50'"
                                    class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg"
                                    x-text="p"></button>
                        </template>
                        <button x-on:click="changePage(page + 1)" :disabled="page >= totalPages"
                                class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </template>

        <!-- Empty State -->
        <template x-if="loaded && students.length === 0 && activeJobId === null">
            <div class="text-center py-10">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-check-circle text-green-500 text-2xl"></i>
                </div>
                <p class="text-gray-600 font-medium">All registered students already have login accounts.</p>
                <p class="text-sm text-gray-400 mt-1">No action needed.</p>
            </div>
        </template>

        <!-- Not Loaded State -->
        <template x-if="!loaded && !loading && activeJobId === null">
            <div class="text-center py-10">
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-user-clock text-gray-400 text-2xl"></i>
                </div>
                <p class="text-gray-500 font-medium">Click "Load Students" to find registered students without login accounts.</p>
                <p class="text-sm text-gray-400 mt-1">Login ID will be the student's email (or registration number if no email). Password = date of birth (BS).</p>
            </div>
        </template>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            outline: 2px solid transparent; outline-offset: 2px;
        }
    </style>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function initSelect2() {
            document.querySelectorAll('.select2').forEach(function (el) {
                var isVisible = el.offsetParent !== null;
                if (isVisible) {
                    if (!$(el).data('select2')) {
                        $(el).select2({width:'resolve'});
                    }
                } else {
                    if ($(el).data('select2')) {
                        $(el).select2('destroy');
                    }
                }
            });
        }
        document.addEventListener('DOMContentLoaded', function () {
            initSelect2();
            document.getElementById('SelectedRole').addEventListener('change', function () {
                var el = document.querySelector('[x-data]');
                if (el && window.Alpine) {
                    Alpine.$data(el).role = this.value;
                }
                setTimeout(initSelect2, 500);
            });
        });

        function batchCreate() {
            return {
                filterCollegeId: '',
                filterFacultyId: '',
                students: [],
                selectedIds: [],
                loading: false,
                loaded: false,
                creating: false,
                alertMessage: '',
                alertType: 'info',

                // Pagination
                page: 1,
                pageSize: 50,
                totalCount: 0,
                totalPages: 0,
                pageNumbers: [],

                // Background job
                activeJobId: null,
                jobStatus: '',
                progress: 0,
                processed: 0,
                totalStudents: 0,
                successCount: 0,
                failedCount: 0,
                pollInterval: null,

                async loadStudents() {
                    this.loading = true;
                    this.alertMessage = '';
                    this.selectedIds = [];
                    try {
                        var params = new URLSearchParams();
                        if (this.filterCollegeId) params.append('collegeId', this.filterCollegeId);
                        if (this.filterFacultyId) params.append('facultyId', this.filterFacultyId);
                        params.append('page', this.page);
                        params.append('pageSize', this.pageSize);

                        var response = await fetch('@Url.Action("GetStudentsWithoutUsers", "User")?' + params.toString());
                        var result = await response.json();
                        this.students = result.data || [];
                        this.totalCount = result.totalCount || 0;
                        this.totalPages = Math.ceil(this.totalCount / this.pageSize);
                        this.updatePageNumbers();
                        this.loaded = true;
                        if (this.students.length === 0) {
                            this.alertMessage = 'All registered students already have login accounts.';
                            this.alertType = 'success';
                        }
                    } catch (e) {
                        this.alertMessage = 'Failed to load students. Please try again.';
                        this.alertType = 'error';
                    } finally {
                        this.loading = false;
                    }
                },

                updatePageNumbers() {
                    var pages = [];
                    var start = Math.max(1, this.page - 2);
                    var end = Math.min(this.totalPages, this.page + 2);
                    for (var i = start; i <= end; i++) {
                        pages.push(i);
                    }
                    this.pageNumbers = pages;
                },

                changePage(p) {
                    if (p < 1 || p > this.totalPages) return;
                    this.page = p;
                    this.loadStudents();
                },

                togglePage(event) {
                    if (event.target.checked) {
                        this.selectedIds = this.students.map(s => s.id);
                    } else {
                        this.selectedIds = [];
                    }
                },

                isPageSelected() {
                    return this.students.length > 0 && this.students.every(s => this.selectedIds.includes(s.id));
                },

                toggleSelect(id) {
                    var idx = this.selectedIds.indexOf(id);
                    if (idx === -1) {
                        this.selectedIds.push(id);
                    } else {
                        this.selectedIds.splice(idx, 1);
                    }
                },

                async createUsers() {
                    if (this.selectedIds.length === 0) return;
                    this.creating = true;
                    this.alertMessage = '';

                    try {
                        var headers = {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        };

                        var response = await fetch('@Url.Action("CreateUsersFromRegistrations", "User")', {
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify(this.selectedIds)
                        });

                        var data = await response.json();

                        if (data.success && data.jobId) {
                            this.activeJobId = data.jobId;
                            this.totalStudents = data.totalStudents;
                            this.jobStatus = 'Running';
                            this.progress = 0;
                            this.processed = 0;
                            this.successCount = 0;
                            this.failedCount = 0;
                            this.pollJobStatus();
                        } else {
                            this.alertMessage = data.message || 'Failed to start background job.';
                            this.alertType = 'error';
                            this.creating = false;
                        }
                    } catch (e) {
                        this.alertMessage = 'An error occurred. Please try again.';
                        this.alertType = 'error';
                        this.creating = false;
                    }
                },

                async createAllMatching() {
                    if (this.creating) return;
                    this.creating = true;
                    this.alertMessage = '';

                    try {
                        var response = await fetch('@Url.Action("CreateUsersFromFilters", "User")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                            body: JSON.stringify({
                                collegeId: this.filterCollegeId ? parseInt(this.filterCollegeId) : null,
                                facultyId: this.filterFacultyId ? parseInt(this.filterFacultyId) : null
                            })
                        });

                        var data = await response.json();

                        if (data.success && data.jobId) {
                            this.activeJobId = data.jobId;
                            this.totalStudents = data.totalStudents;
                            this.jobStatus = 'Running';
                            this.progress = 0;
                            this.processed = 0;
                            this.successCount = 0;
                            this.failedCount = 0;
                            this.pollJobStatus();
                        } else {
                            this.alertMessage = data.message || 'Failed to start background job.';
                            this.alertType = 'error';
                            this.creating = false;
                        }
                    } catch (e) {
                        this.alertMessage = 'An error occurred. Please try again.';
                        this.alertType = 'error';
                        this.creating = false;
                    }
                },

                pollJobStatus() {
                    this.pollInterval = setInterval(async () => {
                        try {
                            var response = await fetch('@Url.Action("GetBulkJobStatus", "User")?jobId=' + this.activeJobId);
                            if (!response.ok) {
                                clearInterval(this.pollInterval);
                                this.creating = false;
                                return;
                            }
                            var job = await response.json();
                            this.jobStatus = job.status;
                            this.progress = job.percentage;
                            this.processed = job.processedCount;
                            this.totalStudents = job.totalStudents;
                            this.successCount = job.successCount;
                            this.failedCount = job.failedCount;

                            if (job.status === 'Completed' || job.status === 'Failed') {
                                clearInterval(this.pollInterval);
                                this.creating = false;
                                if (job.status === 'Completed') {
                                    this.alertMessage = job.successCount + ' user(s) created successfully.' + (job.failedCount > 0 ? ' ' + job.failedCount + ' failed.' : '');
                                    this.alertType = job.failedCount > 0 ? 'warning' : 'success';
                                } else {
                                    this.alertMessage = 'Job failed: ' + (job.errorMessage || 'Unknown error');
                                    this.alertType = 'error';
                                }
                                this.selectedIds = [];
                                await this.loadStudents();
                            }
                        } catch (e) {
                            console.error('Poll error:', e);
                        }
                    }, 3000);
                },

                dismissJob() {
                    this.activeJobId = null;
                    this.jobStatus = '';
                    this.progress = 0;
                    this.processed = 0;
                    this.totalStudents = 0;
                    this.successCount = 0;
                    this.failedCount = 0;
                }
            };
        }
    </script>
}
