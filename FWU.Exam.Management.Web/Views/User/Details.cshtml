@model AppUser

@{
    ViewData["Title"] = "User Details";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-user text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">User Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8 space-y-5">
        <div class="flex flex-col sm:flex-row gap-2">
            <span class="text-sm font-medium text-gray-600 sm:w-40 shrink-0">Email</span>
            <span class="text-sm text-gray-800 font-medium">@Model.Email</span>
        </div>

        <div class="flex flex-col sm:flex-row gap-2">
            <span class="text-sm font-medium text-gray-600 sm:w-40 shrink-0">Tenant</span>
            <span class="text-sm text-gray-800">@(Model.Tenant?.Name ?? "—")</span>
        </div>

        <div class="flex flex-col sm:flex-row gap-2">
            <span class="text-sm font-medium text-gray-600 sm:w-40 shrink-0">Email Confirmed</span>
            @if (Model.EmailConfirmed)
            {
                <span class="inline-flex items-center gap-1 text-xs font-medium text-green-700 bg-green-100 px-2 py-0.5 rounded w-fit">
                    <i class="fas fa-check-circle text-xs"></i> Confirmed
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1 text-xs font-medium text-amber-700 bg-amber-100 px-2 py-0.5 rounded w-fit">
                    <i class="fas fa-clock text-xs"></i> Pending
                </span>
            }
        </div>

        <div class="flex flex-col sm:flex-row gap-2">
            <span class="text-sm font-medium text-gray-600 sm:w-40 shrink-0">Roles</span>
            <div>
                @{
                    var roles = ViewBag.Roles as IList<string>;
                }
                @if (roles != null && roles.Count > 0)
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var role in roles)
                        {
                            <span class="inline-block px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">@role</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-xs text-gray-400">No roles assigned</span>
                }
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
            <i class="fas fa-edit mr-1"></i> Edit
        </a>
        <a asp-action="AssignRoles" asp-route-id="@Model.Id"
           class="px-6 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition shadow-md">
            <i class="fas fa-user-shield mr-1"></i> Assign Roles
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id"
           class="px-6 py-2 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md">
            <i class="fas fa-trash mr-1"></i> Delete
        </a>
    </div>
</div>
