@model UserResetPasswordPageViewModel

@{
    ViewData["Title"] = "Reset Password";
    var totalCount = ViewBag.TotalCount ?? 0;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-key text-red-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Reset Password</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Search for a user and set a new password</p>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    @if (Model.SelectedUser != null)
    {
        <!-- Reset Password Form -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
            <form asp-action="ResetPassword" method="post" class="space-y-6">
                <input type="hidden" asp-for="SelectedUser.UserId" />
                <input type="hidden" asp-for="SelectedUser.UserEmail" />
                <input type="hidden" asp-for="SelectedUser.FullName" />
                <input type="hidden" asp-for="SelectedUser.FacultyName" />
                <input type="hidden" asp-for="SelectedUser.CollegeName" />
                <input type="hidden" asp-for="Search" />
                <input type="hidden" asp-for="Page" />
                <input type="hidden" asp-for="PageSize" />

                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

                <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-user text-red-600"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-gray-800 truncate">@(Model.SelectedUser.FullName ?? Model.SelectedUser.UserEmail)</p>
                            <p class="text-xs text-gray-500 truncate">@Model.SelectedUser.UserEmail</p>
                            @if (Model.SelectedUser.FacultyName != null || Model.SelectedUser.CollegeName != null)
                            {
                                <p class="text-xs text-gray-400 mt-0.5 truncate">
                                    @if (Model.SelectedUser.FacultyName != null)
                                    {
                                        <span><i class="fas fa-building mr-0.5 text-gray-400"></i>@Model.SelectedUser.FacultyName</span>
                                    }
                                    @if (Model.SelectedUser.CollegeName != null)
                                    {
                                        <span class="ml-2"><i class="fas fa-school mr-0.5 text-gray-400"></i>@Model.SelectedUser.CollegeName</span>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="SelectedUser.NewPassword" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">New Password</label>
                        <div class="relative flex">
                            <input asp-for="SelectedUser.NewPassword" id="NewPasswordInput" type="password"
                                   class="w-full border border-gray-300 rounded-l-md px-3 py-2 text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500" />
                            <button type="button" id="toggleNewPassword"
                                    class="px-2.5 bg-gray-100 border border-l-0 border-gray-300 text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition text-sm">
                                <i class="fas fa-eye" id="toggleNewPasswordIcon"></i>
                            </button>
                            <button type="button" id="copyNewPassword"
                                    class="px-2.5 bg-gray-100 border border-l-0 border-gray-300 text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition text-sm" title="Copy password">
                                <i class="fas fa-copy" id="copyNewPasswordIcon"></i>
                            </button>
                            <button type="button" id="generatePasswordBtn"
                                    class="px-3 bg-indigo-100 text-indigo-700 text-xs font-semibold border border-l-0 border-gray-300 rounded-r-md hover:bg-indigo-200 transition flex items-center gap-1">
                                <i class="fas fa-dice"></i> Generate
                            </button>
                        </div>
                        <span asp-validation-for="SelectedUser.NewPassword" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SelectedUser.ConfirmPassword" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Confirm Password</label>
                        <div class="relative flex">
                            <input asp-for="SelectedUser.ConfirmPassword" id="ConfirmPasswordInput" type="password"
                                   class="w-full border border-gray-300 rounded-l-md px-3 py-2 text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500" />
                            <button type="button" id="toggleConfirmPassword"
                                    class="px-2.5 bg-gray-100 border border-l-0 border-gray-300 text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition text-sm">
                                <i class="fas fa-eye" id="toggleConfirmPasswordIcon"></i>
                            </button>
                            <button type="button" id="copyConfirmPassword"
                                    class="px-2.5 bg-gray-100 border border-l-0 border-gray-300 rounded-r-md text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition text-sm" title="Copy password">
                                <i class="fas fa-copy" id="copyConfirmPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="SelectedUser.ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>

                <div class="bg-amber-50 border border-amber-200 rounded-lg p-3">
                    <div class="flex items-start gap-2">
                        <i class="fas fa-exclamation-triangle text-amber-500 mt-0.5"></i>
                        <p class="text-xs sm:text-sm text-amber-700">The user will be required to use this new password on their next login.</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                    <button type="submit" class="px-6 py-2 bg-red-500 text-white text-sm font-semibold rounded-lg hover:bg-red-600 transition shadow-md">
                        <i class="fas fa-key mr-1"></i> Reset Password
                    </button>
                    <a asp-action="ResetPassword" asp-route-search="@currentSearch" asp-route-page="@currentPage" asp-route-pageSize="@pageSize"
                       class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    }

    <!-- Search -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="ResetPassword" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by name, email, faculty, or college..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" />
            </div>
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="ResetPassword" asp-route-pageSize="@pageSize"
                       class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs sm:text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Results -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Faculty / College</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model.Users)
                    {
                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-user text-blue-600 text-xs"></i>
                                    </div>
                                    <div>
                                        <div class="font-medium text-gray-800">@(item.FullName ?? item.Email)</div>
                                        @if (item.FullName != null)
                                        {
                                            <div class="text-xs text-gray-400">@item.Email</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">
                                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">
                                        <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span> Inactive
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (item.Roles.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var role in item.Roles)
                                        {
                                            var badgeClass = role switch
                                            {
                                                "SuperAdmin" => "bg-purple-100 text-purple-700",
                                                "FacultyAdmin" => "bg-blue-100 text-blue-700",
                                                "CollegeAdmin" => "bg-amber-100 text-amber-700",
                                                "Student" => "bg-green-100 text-green-700",
                                                _ => "bg-gray-100 text-gray-700"
                                            };
                                            <span class="inline-block px-2 py-0.5 text-xs font-medium @badgeClass rounded">@role</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">No roles</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-gray-600 text-sm">
                                @if (item.FacultyName != null)
                                {
                                    <div><i class="fas fa-building mr-1 text-gray-400"></i>@item.FacultyName</div>
                                }
                                @if (item.CollegeName != null)
                                {
                                    <div><i class="fas fa-school mr-1 text-gray-400"></i>@item.CollegeName</div>
                                }
                                @if (item.FacultyName == null && item.CollegeName == null)
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a asp-action="ResetPassword"
                                   asp-route-userId="@item.Id"
                                   asp-route-search="@currentSearch"
                                   asp-route-page="@currentPage"
                                   asp-route-pageSize="@pageSize"
                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 rounded-md hover:bg-red-100 transition-colors"
                                   title="Reset password">
                                    <i class="fas fa-key text-xs"></i> Reset
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Users.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-user text-4xl text-gray-300"></i>
                </div>
                <h3 class="text-base sm:text-lg font-semibold text-gray-700 mb-2">No users found</h3>
                <p class="text-xs sm:text-sm text-gray-500">Try adjusting your search criteria</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-lg">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <label class="text-xs sm:text-sm text-gray-700">Rows:</label>
                    <select class="border border-gray-300 rounded-md px-2 py-1 text-sm focus:ring-blue-500 focus:border-blue-500"
                            onchange="window.location.href='@Url.Action("ResetPassword", new { search = currentSearch, pageSize = "__val__" })'.replace('__val__', this.value)">
                        <option value="10" selected="@(pageSize == 10)">10</option>
                        <option value="25" selected="@(pageSize == 25)">25</option>
                        <option value="50" selected="@(pageSize == 50)">50</option>
                        <option value="100" selected="@(pageSize == 100)">100</option>
                    </select>
                </div>
                <p class="text-xs sm:text-sm text-gray-700">
                    Showing <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>
                    to <span class="font-medium">@(Math.Min(currentPage * pageSize, totalCount))</span>
                    of <span class="font-medium">@totalCount</span> results
                </p>
            </div>
            <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                <a asp-action="ResetPassword" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                   class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == 1 ? "pointer-events-none opacity-50" : "")">
                    <i class="fas fa-chevron-left text-xs"></i>
                </a>
                @{
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = Math.Min(totalPages, currentPage + 2);
                    if (startPage > 1)
                    {
                        <a asp-action="ResetPassword" asp-route-page="1" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                           class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                        if (startPage > 2)
                        {
                            <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                        }
                    }
                    for (int i = startPage; i <= endPage; i++)
                    {
                        <a asp-action="ResetPassword" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                           class="relative inline-flex items-center px-4 py-2 text-sm font-semibold @(i == currentPage ? "bg-blue-600 text-white" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50")">@i</a>
                    }
                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                        }
                        <a asp-action="ResetPassword" asp-route-page="@totalPages" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                           class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">@totalPages</a>
                    }
                }
                <a asp-action="ResetPassword" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                   class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == totalPages ? "pointer-events-none opacity-50" : "")">
                    <i class="fas fa-chevron-right text-xs"></i>
                </a>
            </nav>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            function togglePassword(inputId, iconId) {
                var $input = $(inputId);
                var $icon = $(iconId);
                if ($input.attr('type') === 'password') {
                    $input.attr('type', 'text');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    $input.attr('type', 'password');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            }

            $('#toggleNewPassword').on('click', function () {
                togglePassword('#NewPasswordInput', '#toggleNewPasswordIcon');
            });

            $('#toggleConfirmPassword').on('click', function () {
                togglePassword('#ConfirmPasswordInput', '#toggleConfirmPasswordIcon');
            });

            function copyPassword(inputId, iconId) {
                var $input = $(inputId);
                var value = $input.val();
                if (!value) return;

                function showFeedback() {
                    var $icon = $(iconId);
                    $icon.removeClass('fa-copy').addClass('fa-check');
                    setTimeout(function () {
                        $icon.removeClass('fa-check').addClass('fa-copy');
                    }, 1500);
                }

                function legacyCopy() {
                    var $temp = $('<textarea>').val(value).attr('readonly', true)
                        .css({ position: 'absolute', left: '-9999px' }).appendTo('body');
                    $temp.select();
                    var ok = false;
                    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
                    $temp.remove();
                    if (ok) showFeedback();
                    return ok;
                }

                if (legacyCopy()) {
                    return;
                }

                if (navigator.clipboard) {
                    navigator.clipboard.writeText(value).then(showFeedback).catch(function () { });
                }
            }

            $('#copyNewPassword').on('click', function () {
                copyPassword('#NewPasswordInput', '#copyNewPasswordIcon');
            });

            $('#copyConfirmPassword').on('click', function () {
                copyPassword('#ConfirmPasswordInput', '#copyConfirmPasswordIcon');
            });

            $('#generatePasswordBtn').on('click', function () {
                var length = 14;
                var lower = 'abcdefghijklmnopqrstuvwxyz';
                var upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                var digits = '0123456789';
                var special = '@@#$!%*?&';
                var all = lower + upper + digits + special;

                function getRandomChar(str) {
                    var array = new Uint32Array(1);
                    window.crypto.getRandomValues(array);
                    return str[array[0] % str.length];
                }

                function shuffle(arr) {
                    for (var i = arr.length - 1; i > 0; i--) {
                        var array = new Uint32Array(1);
                        window.crypto.getRandomValues(array);
                        var j = array[0] % (i + 1);
                        var tmp = arr[i];
                        arr[i] = arr[j];
                        arr[j] = tmp;
                    }
                }

                var pw = [];
                pw.push(getRandomChar(lower));
                pw.push(getRandomChar(upper));
                pw.push(getRandomChar(digits));
                pw.push(getRandomChar(special));

                for (var i = 4; i < length; i++) {
                    pw.push(getRandomChar(all));
                }

                shuffle(pw);
                var password = pw.join('');

                $('#NewPasswordInput').val(password).attr('type', 'text');
                $('#toggleNewPasswordIcon').removeClass('fa-eye').addClass('fa-eye-slash');
                $('#ConfirmPasswordInput').val(password).attr('type', 'text');
                $('#toggleConfirmPasswordIcon').removeClass('fa-eye').addClass('fa-eye-slash');
            });
        });
    </script>
}
