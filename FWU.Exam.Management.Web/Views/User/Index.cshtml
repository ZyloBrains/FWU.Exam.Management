@model IEnumerable<UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
    var totalCount = Model.Count();
}

<div class="space-y-6" x-data="{ search: '', get filtered() { return this.search.toLowerCase(); } }">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-users text-blue-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Users</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span class="inline-flex items-center gap-1">
                        <span class="font-semibold text-gray-700">@totalCount</span> total records
                    </span>
                </p>
            </div>
        </div>
        <a asp-action="Create"
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200 shadow-sm">
            <i class="fas fa-plus text-xs"></i> Create New
        </a>
    </div>

    <!-- Search & Filter Bar -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" x-model="search" placeholder="Search by name, email, organization, college, or role..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" />
            </div>
            <div class="flex items-center gap-2">
                <button x-show="search.length > 0" x-on:click="search = ''"
                        class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                    <i class="fas fa-times text-xs"></i> Clear
                </button>
            </div>
        </div>
    </div>

    <!-- Desktop Table -->
    <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Organization / College</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        var searchText = $"{(item.FullName ?? item.Email)?.ToLower()} {item.OrganizationName?.ToLower()} {item.CollegeName?.ToLower()} {string.Join(" ", item.Roles).ToLower()}";
                        <tr class="hover:bg-gray-50 transition-colors duration-150"
                            x-show="search === '' || '@searchText'.includes(filtered)"
                            x-transition>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-user text-blue-600 text-xs"></i>
                                    </div>
                                    <div>
                                        <div class="font-medium text-gray-800">@(item.FullName ?? item.Email)</div>
                                        @if (item.FullName != null)
                                        {
                                            <div class="text-xs text-gray-400">@item.Email</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @if (item.Roles.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var role in item.Roles)
                                        {
                                            var badgeClass = role switch
                                            {
                                                "SuperAdmin" => "bg-purple-100 text-purple-700",
                                                "FacultyAdmin" => "bg-blue-100 text-blue-700",
                                                "CollegeAdmin" => "bg-amber-100 text-amber-700",
                                                "Student" => "bg-green-100 text-green-700",
                                                _ => "bg-gray-100 text-gray-700"
                                            };
                                            <span class="inline-block px-2 py-0.5 text-xs font-medium @badgeClass rounded">@role</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">No roles</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-gray-600 text-sm">
                                @if (item.OrganizationName != null)
                                {
                                    <div><i class="fas fa-building mr-1 text-gray-400"></i>@item.OrganizationName</div>
                                }
                                @if (item.CollegeName != null)
                                {
                                    <div><i class="fas fa-school mr-1 text-gray-400"></i>@item.CollegeName</div>
                                }
                                @if (item.OrganizationName == null && item.CollegeName == null)
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details"><i class="fas fa-eye text-xs"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit"><i class="fas fa-edit text-xs"></i></a>
                                    <a asp-action="AssignRoles" asp-route-id="@item.Id" class="p-1.5 text-purple-600 hover:bg-purple-50 rounded-md transition-colors" title="Assign Roles"><i class="fas fa-user-shield text-xs"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete"><i class="fas fa-trash text-xs"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-4">
        @foreach (var item in Model)
        {
            var searchText = $"{(item.FullName ?? item.Email)?.ToLower()} {item.OrganizationName?.ToLower()} {item.CollegeName?.ToLower()} {string.Join(" ", item.Roles).ToLower()}";
            <div class="user-card bg-white rounded-xl shadow-sm border border-gray-200 p-4"
                 x-show="search === '' || '@searchText'.includes(filtered)"
                 x-transition>
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-user text-blue-600 text-sm"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="font-semibold text-gray-800 text-sm truncate">@(item.FullName ?? item.Email)</h3>
                        @if (item.FullName != null)
                        {
                            <p class="text-xs text-gray-400">@item.Email</p>
                        }
                        @if (item.OrganizationName != null)
                        {
                            <p class="text-xs text-gray-500"><i class="fas fa-building mr-1"></i>@item.OrganizationName</p>
                        }
                        @if (item.CollegeName != null)
                        {
                            <p class="text-xs text-gray-500"><i class="fas fa-school mr-1"></i>@item.CollegeName</p>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    @if (item.Roles.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var role in item.Roles)
                            {
                                var badgeClass = role switch
                                {
                                    "SuperAdmin" => "bg-purple-100 text-purple-700",
                                    "FacultyAdmin" => "bg-blue-100 text-blue-700",
                                    "CollegeAdmin" => "bg-amber-100 text-amber-700",
                                    "Student" => "bg-green-100 text-green-700",
                                    _ => "bg-gray-100 text-gray-700"
                                };
                                <span class="inline-block px-2 py-0.5 text-xs font-medium @badgeClass rounded">@role</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-xs text-gray-400">No roles assigned</span>
                    }
                </div>
                <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
                    <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors">Edit</a>
                    <a asp-action="AssignRoles" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-purple-600 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors">Roles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors">Delete</a>
                </div>
            </div>
        }
    </div>

    @if (totalCount == 0)
    {
        <!-- Empty State -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
            <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-users text-4xl text-green-300"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-700 mb-2">No users yet</h3>
            <p class="text-sm text-gray-500 mb-6">Get started by creating your first user</p>
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> Create User
            </a>
        </div>
    }
</div>
