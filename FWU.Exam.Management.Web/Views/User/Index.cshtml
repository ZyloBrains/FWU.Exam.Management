@model IEnumerable<UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSort = ViewBag.Sort as string ?? "email";
    var currentSortDir = ViewBag.SortDir as string ?? "asc";
    var currentRole = ViewBag.RoleFilter as string ?? "";
    var filterRoles = ViewBag.RolesList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var currentIsActive = ViewBag.IsActive as bool?;
    var hasActiveFilters = !string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentRole) || currentIsActive.HasValue;
}

<div class="space-y-6">
    @await Html.PartialAsync("_AlertMessages")
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-users text-blue-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Users</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    <span class="inline-flex items-center gap-1">
                        <span class="font-semibold text-gray-700">@totalCount</span> total records
                    </span>
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            @await Html.PartialAsync("_ExportDropdown", new ExportDropdownModel
            {
                ButtonClass = "bg-gray-800 hover:bg-gray-900",
                ScopeLabel = " (Current Page)",
                RouteValues = new Dictionary<string, string>
                {
                    ["page"] = currentPage.ToString(),
                    ["pageSize"] = pageSize.ToString(),
                    ["search"] = currentSearch,
                    ["role"] = currentRole,
                    ["isActive"] = currentIsActive?.ToString() ?? "",
                    ["sort"] = currentSort,
                    ["sortDir"] = currentSortDir
                }
            })
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200 shadow-sm">
                <i class="fas fa-plus text-xs"></i> Create New
            </a>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <label class="sr-only" for="searchInput">Search users</label>
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input id="searchInput" type="text" name="search" value="@currentSearch"
                       placeholder="Search by name, email, registration number, faculty, or college..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" />
            </div>
            <div class="relative">
                <label class="sr-only" for="roleFilter">Filter by role</label>
                <i class="fas fa-user-shield absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <select id="roleFilter" name="role"
                        class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white">
                    <option value="">All roles</option>
                    @foreach (var filterRole in filterRoles)
                    {
                        <option value="@filterRole" selected="@(filterRole == currentRole)">@filterRole</option>
                    }
                </select>
            </div>
            <div class="relative">
                <label class="sr-only" for="statusFilter">Filter by status</label>
                <i class="fas fa-circle absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <select id="statusFilter" name="isActive"
                        class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white">
                    <option value="">All statuses</option>
                    <option value="true" selected="@(currentIsActive == true)">Active</option>
                    <option value="false" selected="@(currentIsActive == false)">Inactive</option>
                </select>
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="sortDir" value="@currentSortDir" />
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Search
                </button>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs sm:text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Desktop Table -->
    <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider w-12">#</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            <a asp-action="Index" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="email" asp-route-sortDir="@(currentSort == "email" && currentSortDir == "asc" ? "desc" : "asc")"
                               class="inline-flex items-center gap-1 hover:text-blue-600">
                                User
                                @if (currentSort == "email")
                                {
                                    <i class="fas fa-sort-@(currentSortDir == "asc" ? "up" : "down") text-[10px]"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort text-[10px] text-gray-300"></i>
                                }
                            </a>
                        </th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            <a asp-action="Index" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="isactive" asp-route-sortDir="@(currentSort == "isactive" && currentSortDir == "asc" ? "desc" : "asc")"
                               class="inline-flex items-center gap-1 hover:text-blue-600">
                                Status
                                @if (currentSort == "isactive")
                                {
                                    <i class="fas fa-sort-@(currentSortDir == "asc" ? "up" : "down") text-[10px]"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort text-[10px] text-gray-300"></i>
                                }
                            </a>
                        </th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            <a asp-action="Index" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="faculty" asp-route-sortDir="@(currentSort == "faculty" && currentSortDir == "asc" ? "desc" : "asc")"
                               class="inline-flex items-center gap-1 hover:text-blue-600">
                                Faculty / College
                                @if (currentSort == "faculty")
                                {
                                    <i class="fas fa-sort-@(currentSortDir == "asc" ? "up" : "down") text-[10px]"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort text-[10px] text-gray-300"></i>
                                }
                            </a>
                        </th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @{ int serial = 0; }
                    @foreach (var item in Model)
                    {
                        serial++;
                    <tr class="hover:bg-gray-50 transition-colors duration-150"
                        style="cursor: pointer" onclick="window.location.href='@Url.Action("Details", new { id = item.Id })'">
                            <td class="px-6 py-4 text-gray-500 text-sm">@serial</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-user text-blue-600 text-xs"></i>
                                    </div>
                                    <div>
                                        <div class="font-medium text-gray-800">@(item.FullName ?? item.Email)</div>
                                        @if (item.FullName != null)
                                        {
                                            <div class="text-xs text-gray-400">@item.Email</div>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">
                                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">
                                        <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span> Inactive
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (item.Roles.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var role in item.Roles)
                                        {
                                            var badgeClass = role switch
                                            {
                                                Role.SuperAdmin => "bg-purple-100 text-purple-700",
                                                Role.FacultyAdmin => "bg-blue-100 text-blue-700",
                                                Role.CollegeAdmin => "bg-amber-100 text-amber-700",
                                                Role.Student => "bg-green-100 text-green-700",
                                                _ => "bg-gray-100 text-gray-700"
                                            };
                                            <span class="inline-block px-2 py-0.5 text-xs font-medium @badgeClass rounded">@role</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">No roles</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-gray-600 text-sm">
                                @if (item.FacultyName != null)
                                {
                                    <div><i class="fas fa-building mr-1 text-gray-400"></i>@item.FacultyName</div>
                                }
                                @if (item.CollegeName != null)
                                {
                                    <div><i class="fas fa-school mr-1 text-gray-400"></i>@item.CollegeName</div>
                                }
                                @if (item.FacultyName == null && item.CollegeName == null)
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details"><i class="fas fa-eye text-xs"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" onclick="event.stopPropagation()" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit"><i class="fas fa-edit text-xs"></i></a>
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="inline" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1.5 @(item.IsActive ? "text-red-600 hover:bg-red-50" : "text-green-600 hover:bg-green-50") rounded-md transition-colors" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas @(item.IsActive ? "fa-toggle-on" : "fa-toggle-off") text-sm"></i>
                                        </button>
                                    </form>
                                    <a asp-action="AssignRoles" asp-route-id="@item.Id" class="p-1.5 text-purple-600 hover:bg-purple-50 rounded-md transition-colors" title="Assign Roles"><i class="fas fa-user-shield text-xs"></i></a>
                                    <a href="javascript:void(0)" onclick="event.stopPropagation(); deleteRecord('@item.Id')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete"><i class="fas fa-trash text-xs"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-4">
        @foreach (var item in Model)
        {
            <div class="user-card bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-user text-blue-600 text-sm"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="font-semibold text-gray-800 text-sm truncate">@(item.FullName ?? item.Email)</h3>
                        @if (item.FullName != null)
                        {
                            <p class="text-xs text-gray-400">@item.Email</p>
                        }
                        <div class="mt-1">
                            @if (item.IsActive)
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">
                                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span> Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded-full">
                                    <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span> Inactive
                                </span>
                            }
                        </div>
                        @if (item.FacultyName != null)
                        {
                            <p class="text-xs text-gray-500"><i class="fas fa-building mr-1"></i>@item.FacultyName</p>
                        }
                        @if (item.CollegeName != null)
                        {
                            <p class="text-xs text-gray-500"><i class="fas fa-school mr-1"></i>@item.CollegeName</p>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    @if (item.Roles.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var role in item.Roles)
                            {
                                var badgeClass = role switch
                                {
                                    Role.SuperAdmin => "bg-purple-100 text-purple-700",
                                    Role.FacultyAdmin => "bg-blue-100 text-blue-700",
                                    Role.CollegeAdmin => "bg-amber-100 text-amber-700",
                                    Role.Student => "bg-green-100 text-green-700",
                                    _ => "bg-gray-100 text-gray-700"
                                };
                                <span class="inline-block px-2 py-0.5 text-xs font-medium @badgeClass rounded">@role</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-xs text-gray-400">No roles assigned</span>
                    }
                </div>
                <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
                    <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors">Edit</a>
                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="flex-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full text-center py-2 text-xs font-medium @(item.IsActive ? "text-red-600 bg-red-50 hover:bg-red-100" : "text-green-600 bg-green-50 hover:bg-green-100") rounded-lg transition-colors">
                            @(item.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                    <a asp-action="AssignRoles" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-purple-600 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors">Roles</a>
                    
                </div>
            </div>
        }
    </div>

    @if (totalCount == 0)
    {
        <!-- Empty State -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
            <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-users text-4xl text-green-300"></i>
            </div>
            <h3 class="text-base sm:text-lg font-semibold text-gray-700 mb-2">No users yet</h3>
            <p class="text-xs sm:text-sm text-gray-500 mb-6">Get started by creating your first user</p>
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> Create User
            </a>
        </div>
    }

    <!-- Pagination + Page Size Selector -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Previous
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Previous</span>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                           class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Next
                    </a>
                }
                else
                {
                    <span class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-xs sm:text-sm font-medium text-gray-300 cursor-not-allowed">Next</span>
                }
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-xs sm:text-sm text-gray-700">
                        Showing <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>
                        to <span class="font-medium">@(Math.Min(currentPage * pageSize, totalCount))</span>
                        of <span class="font-medium">@totalCount</span> results
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <label class="text-xs sm:text-sm text-gray-700">Rows:</label>
                        <select class="border border-gray-300 rounded-md px-2 py-1 text-sm focus:ring-blue-500 focus:border-blue-500"
                                onchange="window.location.href='@Url.Action("Index", new { search = currentSearch, role = currentRole, isActive = currentIsActive, sort = currentSort, sortDir = currentSortDir, pageSize = "__val__" })'.replace('__val__', this.value)">
                            <option value="10" selected="@(pageSize == 10)">10</option>
                            <option value="25" selected="@(pageSize == 25)">25</option>
                            <option value="50" selected="@(pageSize == 50)">50</option>
                            <option value="100" selected="@(pageSize == 100)">100</option>
                        </select>
                    </div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                               class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == 1 ? "pointer-events-none opacity-50" : "")">
                            <i class="fas fa-chevron-left text-xs"></i>
                        </a>
                        @{
                            var startPage = Math.Max(1, currentPage - 2);
                            var endPage = Math.Min(totalPages, currentPage + 2);
                            if (startPage > 1)
                            {
                                <a asp-action="Index" asp-route-page="1" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                                if (startPage > 2)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                                }
                            }
                            for (int i = startPage; i <= endPage; i++)
                            {
                                <a asp-action="Index" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold @(i == currentPage ? "bg-blue-600 text-white" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50")">@i</a>
                            }
                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 text-xs sm:text-sm text-gray-400 ring-1 ring-inset ring-gray-300">...</span>
                                }
                                <a asp-action="Index" asp-route-page="@totalPages" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">@totalPages</a>
                            }
                        }
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-role="@currentRole" asp-route-isActive="@currentIsActive" asp-route-pageSize="@pageSize" asp-route-sort="@currentSort" asp-route-sortDir="@currentSortDir"
                               class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 @(currentPage == totalPages ? "pointer-events-none opacity-50" : "")">
                            <i class="fas fa-chevron-right text-xs"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function deleteRecord(id) {
            if (!confirm('Are you sure you want to delete this record?')) return;

            $.ajax({
                url: '@Url.Action("DeleteAjax", "User")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('An error occurred while deleting.');
                }
            });
        }
    </script>
}