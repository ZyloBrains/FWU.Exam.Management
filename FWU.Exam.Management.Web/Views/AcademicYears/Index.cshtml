@model IEnumerable<AcademicYear>

@{
    ViewData["Title"] = "Academic Years";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.Search as string ?? "";
}

<div class="space-y-6" x-data="{ search: '@currentSearch', openExport: false, get filtered() { return this.search.toLowerCase(); } }">
    <!-- Header and action buttons -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-pink-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar text-pink-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Academic Years</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span class="font-semibold text-gray-700">@totalCount</span> total records
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <!-- Export dropdown -->
            <div class="relative">
                <button x-on:click="openExport = !openExport"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                    <i class="fas fa-download text-xs"></i> Export
                </button>
                <div x-show="openExport"
                     x-on:click.away="openExport = false"
                     x-transition
                     class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                    <a asp-action="ExportToCsv"
                        @* asp-route-search="@currentSearch" *@
                           asp-route-page="@currentPage"
                           asp-route-pageSize="@pageSize"
                           asp-route-search="@currentSearch"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-csv text-blue-600"></i> CSV
                    </a>
                    <a asp-action="ExportToPdf"
                        @* asp-route-search="@currentSearch" *@
                           asp-route-page="@currentPage"
                           asp-route-pageSize="@pageSize"
                           asp-route-search="@currentSearch"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-file-pdf text-red-600"></i> PDF
                    </a>
                </div>
            </div>
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="fas fa-plus text-xs"></i> Create New
                </a>
            }
        </div>
    </div>

    <!-- Search form (includes page size selector) -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Search by name, code, remark..."
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-route-pageSize="@pageSize" class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    @* <!-- Live search input (client‑side) -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="text" x-model="search"
                   placeholder="Live search on current page..."
                   class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
    </div> *@

    <!-- Desktop table (visible on md and up) -->
    <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Code</th>
                    @* <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Code (Nepali)</th> *@
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Name</th>
                    @* <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Name (Nepali)</th> *@
                    @* <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Remark</th> *@
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Running</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    var showCondition = "search === '' || " +
                        $"'{item.AcademicYearName?.ToLower()}'.includes(filtered) || " +
                        $"'{item.AcademicYearNameNepali?.ToLower()}'.includes(filtered) || " +
                        $"'{item.AcademicYearCode}'.includes(filtered) || " +
                        $"'{item.AcademicYearCodeNepali?.ToLower()}'.includes(filtered) || " +
                        $"'{item.Remark?.ToLower()}'.includes(filtered)";
                    <tr class="hover:bg-gray-50" x-show="@showCondition" x-transition>
                        <td class="px-6 py-4 font-medium text-gray-800">@item.AcademicYearCode</td>
                        @* <td class="px-6 py-4 text-gray-600">@item.AcademicYearCodeNepali</td> *@
                        <td class="px-6 py-4 text-gray-800">@item.AcademicYearName</td>
                        @* <td class="px-6 py-4 text-gray-600">@item.AcademicYearNameNepali</td> *@
                        @* <td class="px-6 py-4 text-gray-500 max-w-xs truncate">@(string.IsNullOrEmpty(item.Remark) ? "—" : item.Remark)</td> *@
                        <td class="px-6 py-4">
                            @if (item.IsRunning)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-700 rounded">Running</span>
                            }
                            else
                            {
                                <span class="text-xs text-gray-400">No</span>
                            }
                        </td>
                        <td class="px-6 py-4">
                            @if (item.IsActive)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md" title="Details">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md" title="Edit">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md" title="Delete">
                                        <i class="fas fa-trash text-xs"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile card layout (visible below md) -->
    <div class="md:hidden space-y-3">
        @foreach (var item in Model)
        {
            var showCondition = "search === '' || " +
                $"'{item.AcademicYearName?.ToLower()}'.includes(filtered) || " +
                $"'{item.AcademicYearNameNepali?.ToLower()}'.includes(filtered) || " +
                $"'{item.AcademicYearCode}'.includes(filtered) || " +
                $"'{item.AcademicYearCodeNepali?.ToLower()}'.includes(filtered) || " +
                $"'{item.Remark?.ToLower()}'.includes(filtered)";
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4" x-show="@showCondition" x-transition>
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-pink-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-calendar text-pink-600 text-sm"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 text-sm">@item.AcademicYearName</h3>
                            <p class="text-xs text-gray-500">Code: @item.AcademicYearCode</p>
                        </div>
                    </div>
                    <div>
                        @if (item.IsActive)
                        {
                            <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span>
                        }
                        else
                        {
                            <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 text-sm border-t border-gray-100 pt-3">
                    <div class="text-gray-500">Code (Nepali)</div>
                    <div class="text-gray-800">@item.AcademicYearCodeNepali</div>
                    <div class="text-gray-500">Name (Nepali)</div>
                    <div class="text-gray-800">@item.AcademicYearNameNepali</div>
                    <div class="text-gray-500">Remark</div>
                    <div class="text-gray-800 truncate">@(string.IsNullOrEmpty(item.Remark) ? "—" : item.Remark)</div>
                    <div class="text-gray-500">Running</div>
                    <div class="text-gray-800">@(item.IsRunning ? "Yes" : "No")</div>
                </div>

                <div class="flex items-center gap-2 pt-4 border-t border-gray-100 mt-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100">
                        Details
                    </a>
                    @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100">
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                            Delete
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Pagination + Page Size Selector -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                           class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Previous
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-300 cursor-not-allowed">Previous</span>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                           class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                        Next
                    </a>
                }
                else
                {
                    <span class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-300 cursor-not-allowed">Next</span>
                }
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Showing
                        <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>
                        to
                        <span class="font-medium">@(Math.Min(currentPage * pageSize, totalCount))</span>
                        of
                        <span class="font-medium">@totalCount</span>
                        results
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <label class="text-sm text-gray-700">Rows per page:</label>
                        <select class="border border-gray-300 rounded-md px-2 py-1 text-sm focus:ring-blue-500 focus:border-blue-500"
                                onchange="window.location.href='@Url.Action("Index", new { search = currentSearch, pageSize = "__val__" })'.replace('__val__', this.value)">
                            <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                            <option value="25" selected="@(pageSize == 25 ? "selected" : null)">25</option>
                            <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                            <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                        </select>
                    </div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                               class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 @(currentPage == 1 ? "pointer-events-none opacity-50" : "")">
                            <span class="sr-only">Previous</span>
                            <i class="fas fa-chevron-left text-xs"></i>
                        </a>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <a asp-action="Index" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                                   class="relative inline-flex items-center px-4 py-2 text-sm font-semibold @(i == currentPage ? "bg-blue-600 text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0")">
                                @i
                            </a>
                        }
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-pageSize="@pageSize"
                               class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 @(currentPage == totalPages ? "pointer-events-none opacity-50" : "")">
                            <span class="sr-only">Next</span>
                            <i class="fas fa-chevron-right text-xs"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>