@{
    var faculty = ViewBag.Faculty as Faculty;
    ViewData["Title"] = faculty?.Name ?? "Home";
}

@if (faculty != null)
{
    var userCount = (int)(ViewBag.UserCount ?? 0);

    <!-- Breadcrumb -->
    <nav class="mb-4" aria-label="breadcrumb">
        <ol class="flex items-center space-x-2 text-xs sm:text-sm text-gray-500">
            <li><a asp-controller="Home" asp-action="Index" class="text-blue-600 hover:underline">Home</a></li>
            <li><i class="fas fa-chevron-right text-xs text-gray-400"></i></li>
            <li class="text-gray-700 font-medium">@faculty.Name</li>
        </ol>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Logo + identity card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col items-center text-center">
            @if (!string.IsNullOrEmpty(faculty.LogoPath))
            {
                <img src="@faculty.LogoPath" alt="@faculty.Name logo"
                     class="mb-4 rounded-lg max-h-[120px] object-contain" />
            }
            else
            {
                <div class="w-24 h-24 bg-gray-100 rounded-lg flex items-center justify-center mb-4">
                    <span class="text-4xl">??</span>
                </div>
            }
            <h4 class="text-lg font-bold text-gray-800 mb-1">@faculty.Name</h4>
            <span class="inline-block px-3 py-1 text-xs font-semibold text-white bg-blue-600 rounded-full">@faculty.OfficeCode</span>
        </div>

        <!-- Details card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 md:col-span-1">
            <div class="px-6 py-4 border-b border-gray-100 font-semibold text-gray-700">
                <i class="fas fa-info-circle mr-2 text-blue-500"></i>Faculty Details
            </div>
            <div class="p-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-start gap-1">
                    <span class="text-xs sm:text-sm font-medium text-gray-500 sm:w-28 shrink-0">Address</span>
                    <span class="text-xs sm:text-sm text-gray-800">@faculty.Address</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-start gap-1">
                    <span class="text-xs sm:text-sm font-medium text-gray-500 sm:w-28 shrink-0">Phone</span>
                    <span class="text-xs sm:text-sm text-gray-800">@faculty.ContactNumber</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-start gap-1">
                    <span class="text-xs sm:text-sm font-medium text-gray-500 sm:w-28 shrink-0">Email</span>
                    <a href="mailto:@faculty.Email" class="text-sm text-blue-600 hover:underline">@faculty.Email</a>
                </div>
            </div>
        </div>

        <!-- Stats card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col items-center justify-center text-center">
            <span class="text-5xl font-bold text-blue-600">@userCount</span>
            <span class="text-xs sm:text-sm text-gray-500 mt-2">Registered Users</span>
            <a asp-controller="FacultyDashboard" asp-action="Users" asp-route-officeCode="@faculty.OfficeCode"
               class="mt-4 inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-medium text-blue-600 border border-blue-600 rounded-lg hover:bg-blue-50 transition-colors duration-200">
                <i class="fas fa-users text-xs"></i> Manage Users
            </a>
        </div>
    </div>
}
else
{
    <div class="flex flex-col items-center justify-center py-16">
        <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mb-6">
            <i class="fas fa-graduation-cap text-3xl text-blue-600"></i>
        </div>
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mb-6 rounded-lg bg-red-50 p-4 border border-red-200 flex items-start shadow-sm">
            <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-xs sm:text-sm font-medium text-red-800 whitespace-pre-line">@errorMessage</div>
        </div>
    }
        <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-3">Welcome</h1>
        <p class="text-gray-500 text-lg">Sign in to access your faculty's dashboard.</p>
    </div>
}