@{
    ViewData["Title"] = "Results";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-poll text-indigo-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Results</h1>
            <p class="text-xs sm:text-sm text-gray-500">View and manage examination results</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a asp-area="Exams" asp-controller="ExamSubjectResults" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <i class="fas fa-check-double text-blue-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Subject Results</h3>
                    <p class="text-xs sm:text-sm text-gray-500">View subject-wise exam results</p>
                </div>
            </div>
        </a>

        <a asp-area="Exams" asp-controller="ResultRecords" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
                    <i class="fas fa-clipboard-check text-green-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Result Records</h3>
                    <p class="text-xs sm:text-sm text-gray-500">View complete result records</p>
                </div>
            </div>
        </a>

        <a asp-area="Exams" asp-controller="RetotalRequests" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                    <i class="fas fa-redo-alt text-purple-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Retotaling</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage retotaling requests</p>
                </div>
            </div>
        </a>
    </div>
</div>
