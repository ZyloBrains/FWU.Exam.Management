@{
    ViewData["Title"] = "User Management";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-users text-indigo-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">User Management</h1>
            <p class="text-xs sm:text-sm text-gray-500">Manage users, roles and permissions</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a asp-area="" asp-controller="User" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <i class="fas fa-list text-blue-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">All Users</h3>
                    <p class="text-xs sm:text-sm text-gray-500">View and manage all users</p>
                </div>
            </div>
        </a>

        <a asp-area="" asp-controller="User" asp-action="Create" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
                    <i class="fas fa-user-plus text-green-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Create New User</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Add a new user to the system</p>
                </div>
            </div>
        </a>

        <a href="@(Context.Items["TenantCode"] as string != null ? $"/tenant/{Context.Items["TenantCode"]}/User/ResetPassword" : "/User/ResetPassword")" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center group-hover:bg-teal-200 transition-colors">
                    <i class="fas fa-key text-teal-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Reset Password</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Reset a user's password</p>
                </div>
            </div>
        </a>

        <a asp-area="" asp-controller="Role" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                    <i class="fas fa-user-shield text-purple-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Roles</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage user roles</p>
                </div>
            </div>
        </a>

        <a asp-area="Admin" asp-controller="RolePermissionManager" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center group-hover:bg-yellow-200 transition-colors">
                    <i class="fas fa-lock text-yellow-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Permissions</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage role permissions</p>
                </div>
            </div>
        </a>
    </div>
</div>
