@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Core Area";

    var sectionUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isSuperAdmin = sectionUser != null && await UserManager.IsInRoleAsync(sectionUser, Role.SuperAdmin);
    var sectionPermissions = sectionUser != null
        ? await PermissionService.GetUserPermissionsAsync(sectionUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => isSuperAdmin || sectionPermissions.Contains(permission);
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-cubes text-indigo-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Core Area</h1>
            <p class="text-xs sm:text-sm text-gray-500">Manage reference data: levels, genders, ethnicities, boards and countries</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (HasPerm("levels.view"))
        {
        <a asp-area="Core" asp-controller="Levels" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-cyan-100 rounded-lg flex items-center justify-center group-hover:bg-cyan-200 transition-colors">
                    <i class="fas fa-layer-group text-cyan-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Levels</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage academic levels</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("genders.view"))
        {
        <a asp-area="Core" asp-controller="Genders" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <i class="fas fa-venus-mars text-blue-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Genders</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage gender categories</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("ethnicities.view"))
        {
        <a asp-area="Core" asp-controller="Ethnicities" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center group-hover:bg-emerald-200 transition-colors">
                    <i class="fas fa-users text-emerald-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Ethnicities</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage ethnicity categories</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("boards.view"))
        {
        <a asp-area="Core" asp-controller="Boards" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                    <i class="fas fa-landmark text-purple-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Boards</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage education boards</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("countries.view"))
        {
        <a asp-area="Core" asp-controller="Countries" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center group-hover:bg-yellow-200 transition-colors">
                    <i class="fas fa-globe text-yellow-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Countries</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage country list</p>
                </div>
            </div>
        </a>
        }
    </div>
</div>
