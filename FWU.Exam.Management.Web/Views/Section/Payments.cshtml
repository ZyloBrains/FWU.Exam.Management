@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Payments";

    var sectionUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isSuperAdmin = sectionUser != null && await UserManager.IsInRoleAsync(sectionUser, Role.SuperAdmin);
    var sectionPermissions = sectionUser != null
        ? await PermissionService.GetUserPermissionsAsync(sectionUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => isSuperAdmin || sectionPermissions.Contains(permission);
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-money-bill-wave text-indigo-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Payments</h1>
            <p class="text-xs sm:text-sm text-gray-500">Manage banks, payment types and bill titles</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (HasPerm("banks.view"))
        {
        <a asp-area="Payments" asp-controller="Banks" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <i class="fas fa-university text-blue-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Banks</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage bank information</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("paymenttypes.view"))
        {
        <a asp-area="Payments" asp-controller="PaymentTypes" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
                    <i class="fas fa-credit-card text-green-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Payment Types</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage payment categories</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("billtitles.view"))
        {
        <a asp-area="Payments" asp-controller="BillTitles" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                    <i class="fas fa-file-invoice-dollar text-purple-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Bill Titles</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage bill title entries</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("paymentreconciliation.view"))
        {
        <a asp-area="Payments" asp-controller="PaymentReconciliation" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center group-hover:bg-amber-200 transition-colors">
                    <i class="fas fa-sync-alt text-amber-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Payment Reconciliation</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Verify stuck pending payments with the gateway</p>
                </div>
            </div>
        </a>
        }
    </div>
</div>
