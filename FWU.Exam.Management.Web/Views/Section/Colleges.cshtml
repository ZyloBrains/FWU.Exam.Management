@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Colleges";

    var sectionUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isSuperAdmin = sectionUser != null && await UserManager.IsInRoleAsync(sectionUser, Role.SuperAdmin);
    var sectionPermissions = sectionUser != null
        ? await PermissionService.GetUserPermissionsAsync(sectionUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => isSuperAdmin || sectionPermissions.Contains(permission);
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-school text-indigo-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Colleges</h1>
            <p class="text-xs sm:text-sm text-gray-500">Manage colleges and their programs</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (HasPerm("colleges.view"))
        {
        <a asp-area="Colleges" asp-controller="Colleges" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <i class="fas fa-school text-blue-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">All Colleges</h3>
                    <p class="text-xs sm:text-sm text-gray-500">View and manage all colleges</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("collegetypes.view"))
        {
        <a asp-area="Colleges" asp-controller="CollegeTypes" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
                    <i class="fas fa-tag text-green-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">College Types</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage college categories</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("collegeprograms.view"))
        {
        <a asp-area="Colleges" asp-controller="CollegePrograms" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                    <i class="fas fa-diagram-project text-purple-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">College Programs</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage programs offered by colleges</p>
                </div>
            </div>
        </a>
        }
    </div>
</div>
