@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Academic";

    var sectionUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isSuperAdmin = sectionUser != null && await UserManager.IsInRoleAsync(sectionUser, Role.SuperAdmin);
    var sectionPermissions = sectionUser != null
        ? await PermissionService.GetUserPermissionsAsync(sectionUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => isSuperAdmin || sectionPermissions.Contains(permission);
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-graduation-cap text-indigo-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Academic</h1>
            <p class="text-xs sm:text-sm text-gray-500">Student portal - profile, exams, marksheet and payments</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (HasPerm("student.portal.examforms"))
        {
        <a asp-area="Students" asp-controller="StudentDashboard" asp-action="ExamForms" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
                    <i class="fas fa-file-invoice text-green-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Exam Forms</h3>
                    <p class="text-xs sm:text-sm text-gray-500">View and submit exam forms</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("student.portal.marksheet"))
        {
        <a asp-area="Students" asp-controller="StudentDashboard" asp-action="Marksheet" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                    <i class="fas fa-file-alt text-purple-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Marksheet</h3>
                    <p class="text-xs sm:text-sm text-gray-500">View marksheet and grades</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("admitcards.view"))
        {
        <a asp-area="Students" asp-controller="StudentDashboard" asp-action="AdmitCards" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center group-hover:bg-teal-200 transition-colors">
                    <i class="fas fa-ticket-alt text-teal-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Admit Cards</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Download your admit cards</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("student.portal.payment"))
        {
        <a asp-area="Students" asp-controller="StudentDashboard" asp-action="PaymentHistory" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                    <i class="fas fa-history text-indigo-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Payment History</h3>
                    <p class="text-xs sm:text-sm text-gray-500">View your payment history</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("retotaling.view"))
        {
        <a asp-area="Students" asp-controller="StudentDashboard" asp-action="RetotalRequests" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center group-hover:bg-red-200 transition-colors">
                    <i class="fas fa-redo-alt text-red-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Re-evaluation</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Request retotaling of marks</p>
                </div>
            </div>
        </a>
        }
    </div>
</div>
