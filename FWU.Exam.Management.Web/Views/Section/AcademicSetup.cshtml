@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Academic Setup";

    var sectionUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isSuperAdmin = sectionUser != null && await UserManager.IsInRoleAsync(sectionUser, Role.SuperAdmin);
    var sectionPermissions = sectionUser != null
        ? await PermissionService.GetUserPermissionsAsync(sectionUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => isSuperAdmin || sectionPermissions.Contains(permission);
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-graduation-cap text-indigo-600"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Academic Setup</h1>
            <p class="text-xs sm:text-sm text-gray-500">Configure faculties, programs, semesters and subjects</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (HasPerm("faculties.view"))
        {
        <a asp-area="Core" asp-controller="Faculty" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <i class="fas fa-building text-blue-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Faculties</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage faculty departments</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("programs.view"))
        {
        <a asp-area="Core" asp-controller="Programs" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
                    <i class="fas fa-stream text-green-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Programs / Streams</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage academic programs</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("semesters.view"))
        {
        <a asp-area="Core" asp-controller="Semesters" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                    <i class="fas fa-layer-group text-purple-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Semesters</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage semester periods</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("academicyears.view"))
        {
        <a asp-area="Core" asp-controller="AcademicYears" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center group-hover:bg-yellow-200 transition-colors">
                    <i class="fas fa-calendar-alt text-yellow-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Academic Years</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage academic years</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("subjects.view"))
        {
        <a asp-area="Subjects" asp-controller="SubjectCatalogs" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center group-hover:bg-red-200 transition-colors">
                    <i class="fas fa-book text-red-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Subject Catalogs</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage subject catalog</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("subjecttypes.view"))
        {
        <a asp-area="Subjects" asp-controller="SubjectTypes" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center group-hover:bg-teal-200 transition-colors">
                    <i class="fas fa-tags text-teal-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Subject Types</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage subject categories</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("subjectofferings.view"))
        {
        <a asp-area="Subjects" asp-controller="SubjectOfferings" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center group-hover:bg-orange-200 transition-colors">
                    <i class="fas fa-layer-group text-orange-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Subject Offerings</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage subject offerings per program</p>
                </div>
            </div>
        </a>
        }

        @if (HasPerm("curriculumversions.view"))
        {
        <a asp-area="Subjects" asp-controller="CurriculumVersions" asp-action="Index" class="group block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-indigo-300 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-cyan-100 rounded-lg flex items-center justify-center group-hover:bg-cyan-200 transition-colors">
                    <i class="fas fa-code-branch text-cyan-600 text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 group-hover:text-indigo-600 transition-colors">Curriculum Versions</h3>
                    <p class="text-xs sm:text-sm text-gray-500">Manage curriculum versions</p>
                </div>
            </div>
        </a>
        }
    </div>
</div>
