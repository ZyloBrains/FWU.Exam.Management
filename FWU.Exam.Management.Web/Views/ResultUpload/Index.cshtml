@model fwu_examination_management_system.ViewModels.ResultUploadViewModel

@{
    ViewData["Title"] = "Result Upload";
}

<div class="space-y-4">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h1 class="text-2xl font-semibold text-gray-800">Result Upload</h1>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        @if (Model.HasSubmitted)
        {
            if (Model.UploadedCount > 0)
            {
                <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 px-4 py-3 text-sm">
                    Uploaded <span class="font-semibold">@Model.UploadedCount</span> result records successfully.
                </div>
            }

            if (Model.FailedCount > 0)
            {
                <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 text-sm">
                    Failed rows: <span class="font-semibold">@Model.FailedCount</span>
                </div>
            }

            if (Model.Errors.Count > 0)
            {
                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 text-red-700 px-4 py-3 text-sm">
                    <ul class="list-disc list-inside space-y-1">
                        @foreach (var err in Model.Errors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <form asp-action="Index" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="ExamScheduleId" class="block text-sm font-semibold text-gray-700 mb-1">Exam Schedule*</label>
                <select asp-for="ExamScheduleId" asp-items="Model.ExamSchedules" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></select>
                <span asp-validation-for="ExamScheduleId" class="text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Remarks" class="block text-sm font-semibold text-gray-700 mb-1">Remarks*</label>
                <textarea asp-for="Remarks" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
                <span asp-validation-for="Remarks" class="text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="UploadFile" class="block text-sm font-semibold text-gray-700 mb-1">File*</label>
                <input asp-for="UploadFile" type="file" accept=".csv,text/csv" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white" />
                <span asp-validation-for="UploadFile" class="text-sm text-red-600"></span>
            </div>

            <div class="flex flex-wrap gap-3 pt-2">
                <button type="submit" class="px-5 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">Upload</button>
                <a asp-action="DownloadSample" class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">Download Sample</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
