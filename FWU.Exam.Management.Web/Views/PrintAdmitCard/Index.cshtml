@model fwu_examination_management_system.ViewModels.PrintAdmitCardViewModel

@{
    ViewData["Title"] = "Admit Card";
}

<div class="space-y-4">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h1 class="text-2xl font-semibold text-gray-800">Admit Card</h1>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Admit Card</h2>

        <form asp-action="Index" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="AcademicYearId" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">Academic Year: *</label>
                <select asp-for="AcademicYearId" asp-items="Model.AcademicYears" class="md:col-span-2 w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="CollegeId" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">College: *</label>
                <select asp-for="CollegeId" asp-items="Model.Colleges" class="md:col-span-2 w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="ExamScheduleId" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">Exam Schedule :*</label>
                <select asp-for="ExamScheduleId" asp-items="Model.ExamSchedules" class="md:col-span-2 w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="ProgramsId" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">Program: *</label>
                <select asp-for="ProgramsId" asp-items="Model.Programs" class="md:col-span-2 w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="YearPartId" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">Year Part :*</label>
                <select asp-for="YearPartId" asp-items="Model.YearParts" class="md:col-span-2 w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="ExamTypeId" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">Exam Type:</label>
                <select asp-for="ExamTypeId" asp-items="Model.ExamTypes" class="md:col-span-2 w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="AppliedByStudentsOnly" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">Applied By Students Only:</label>
                <div class="md:col-span-2">
                    <input asp-for="AppliedByStudentsOnly" type="checkbox" class="w-10 h-10 border-gray-300 rounded" />
                </div>
            </div>

            <div class="border-t border-dashed border-gray-300 pt-4 flex flex-wrap justify-center gap-3">
                <button type="submit" class="px-5 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">Search</button>
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">Reset</a>
                <a asp-controller="Dashboard" asp-action="Index" class="px-5 py-2.5 bg-cyan-500 text-white rounded-lg hover:bg-cyan-600 transition-colors">Admit Card Back</a>
            </div>
        </form>
    </div>

    @if (Model.HasSearched)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            @if (Model.Results.Count == 0)
            {
                <div class="rounded-lg border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 text-sm">
                    No admit card records found for selected filters.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="text-left border-b border-gray-200 text-gray-600">
                                <th class="px-3 py-2">Student</th>
                                <th class="px-3 py-2">Registration No</th>
                                <th class="px-3 py-2">Exam Roll No</th>
                                <th class="px-3 py-2">Academic Year</th>
                                <th class="px-3 py-2">College</th>
                                <th class="px-3 py-2">Exam Schedule</th>
                                <th class="px-3 py-2">Program</th>
                                <th class="px-3 py-2">Year Part</th>
                                <th class="px-3 py-2">Exam Type</th>
                                <th class="px-3 py-2">Applied By Student</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Results)
                            {
                                <tr class="border-b border-gray-100 text-gray-700">
                                    <td class="px-3 py-2">@row.StudentName</td>
                                    <td class="px-3 py-2">@row.RegistrationNumber</td>
                                    <td class="px-3 py-2">@row.ExamRollNumber</td>
                                    <td class="px-3 py-2">@row.AcademicYearName</td>
                                    <td class="px-3 py-2">@row.CollegeName</td>
                                    <td class="px-3 py-2">@row.ExamScheduleName</td>
                                    <td class="px-3 py-2">@row.ProgramName</td>
                                    <td class="px-3 py-2">@row.YearPartName</td>
                                    <td class="px-3 py-2">@row.ExamTypeName</td>
                                    <td class="px-3 py-2">@((row.IsAppliedByStudent ?? false) ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
