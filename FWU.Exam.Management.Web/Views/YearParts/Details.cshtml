@model fwu_examination_management_system.Data.Models.YearPart

@{
    ViewData["Title"] = "Year Part Details";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-week text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Year Part Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <p class="text-sm font-medium text-gray-600">Code</p>
                <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.Code)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Year Part Name</p>
                <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.YearPartName)</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Period Type</p>
                <p class="mt-1 text-gray-800">@(Model.ProgramPeriodType?.ProgramPeriodTypeName ?? "-")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Year / Part</p>
                <p class="mt-1 text-gray-800">Year @Model.Year, Part @Model.Part</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Editable</p>
                <div class="mt-1">
                    @if (Model.IsEditable)
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-blue-100 text-blue-700 rounded-full">✓ Editable</span>
                    }
                    else
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-500 rounded-full">Not Editable</span>
                    }
                </div>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Status</p>
                <div class="mt-1">
                    @if (Model.IsActive)
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">✓ Active</span>
                    }
                    else
                    {
                        <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">✗ Inactive</span>
                    }
                </div>
            </div>
            <div class="md:col-span-2">
                <p class="text-sm font-medium text-gray-600">Remark</p>
                <p class="mt-1 text-gray-800">@(Model.Remark ?? "-")</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>