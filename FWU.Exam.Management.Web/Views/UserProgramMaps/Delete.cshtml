@model fwu_examination_management_system.Data.Models.UserProgramMap

@{
    ViewData["Title"] = "Delete User Program Mapping";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-user-minus text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete User Program Mapping</h1>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <!-- Warning Alert -->
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this user program mapping? This action cannot be undone.
                </p>
            </div>
        </div>

        <!-- Details Section - Two Column Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 mb-8">
            <!-- User -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">User</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.User.UserName)</p>
                <p class="text-xs text-gray-500">@Html.DisplayFor(model => model.User.Email)</p>
            </div>
            <!-- Program -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Program</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Program.ProgramName)</p>
                <p class="text-xs text-gray-500">Code: @Html.DisplayFor(model => model.Program.ProgramCode)</p>
            </div>
        </div>

        <!-- Warning Note -->
        <div class="bg-yellow-50 border-l-4 border-yellow-500 rounded-lg p-4 mb-6">
            <div class="flex items-start">
                <i class="fas fa-info-circle text-yellow-500 mr-3 text-lg mt-0.5"></i>
                <div>
                    <p class="text-sm font-semibold text-yellow-800">Important Note:</p>
                    <p class="text-xs text-yellow-700 mt-1">
                        Deleting this mapping will remove the user's access to this program immediately.
                        The user will no longer be able to view or manage data related to this program.
                    </p>
                </div>
            </div>
        </div>

        <!-- Delete Form -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this user program mapping? This action cannot be undone.');"
                        class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>