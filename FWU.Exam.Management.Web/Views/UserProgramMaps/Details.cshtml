@model fwu_examination_management_system.Data.Models.UserProgramMap

@{
    ViewData["Title"] = "User Program Mapping Details";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-info-circle text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">User Program Mapping Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <!-- Mapping Details -->
        <div class="mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Mapping Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">User</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.User.UserName)</p>
                    <p class="text-xs text-gray-500">Email: @Html.DisplayFor(model => model.User.Email)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Program</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.Program.ProgramName)</p>
                    <p class="text-xs text-gray-500">Code: @Html.DisplayFor(model => model.Program.ProgramCode)</p>
                </div>
            </div>
        </div>

        <!-- Additional Info -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Additional Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">Mapping ID</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Id)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Created Date</p>
                    <p class="mt-1 text-gray-800">@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>