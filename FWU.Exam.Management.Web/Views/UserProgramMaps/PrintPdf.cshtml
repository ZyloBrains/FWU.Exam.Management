@model IEnumerable<fwu_examination_management_system.Data.Models.UserProgramMap>

@{
    Layout = null;
    var title = "User Program Mapping Report";
    var generatedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
    var currentPage = ViewBag.CurrentPage ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var search = ViewBag.Search as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11px;
            margin: 20px;
            color: #333;
        }
        h1 {
            font-size: 18px;
            margin-bottom: 5px;
            color: #7c3aed;
        }
        .report-header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #7c3aed;
            padding-bottom: 10px;
        }
        .report-date {
            font-size: 10px;
            color: #666;
            margin-top: 5px;
        }
        .report-info {
            font-size: 10px;
            color: #666;
            margin-top: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 10px;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 6px 8px;
            text-align: left;
            vertical-align: top;
        }
        th {
            background-color: #f2f2f2;
            font-weight: bold;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .footer {
            margin-top: 30px;
            font-size: 10px;
            text-align: center;
            color: #666;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }
        .summary {
            margin-bottom: 15px;
            padding: 10px;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 4px;
            font-size: 11px;
        }
        .summary-item {
            display: inline-block;
            margin-right: 20px;
        }
        .summary-label {
            font-weight: bold;
            color: #4b5563;
        }
        .summary-value {
            color: #1f2937;
            margin-left: 5px;
        }
        @@media print {
            body {
                margin: 0;
                padding: 10px;
            }
            th {
                background-color: #f2f2f2;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="report-header">
        <h1>👥 @title</h1>
        <div class="report-date">Generated on: @generatedDate</div>
        <div class="report-info">
            Page @currentPage of @(Math.Ceiling((double)totalCount / pageSize)) | 
            Showing @Model.Count() of @totalCount records
            @if (!string.IsNullOrEmpty(search))
            {
                <text>| Search: "@search"</text>
            }
        </div>
    </div>

    <div class="summary">
        <span class="summary-item">
            <span class="summary-label">Total Mappings:</span>
            <span class="summary-value">@totalCount</span>
        </span>
        <span class="summary-item">
            <span class="summary-label">Unique Users:</span>
            <span class="summary-value">@Model.Select(x => x.UserId).Distinct().Count()</span>
        </span>
        <span class="summary-item">
            <span class="summary-label">Unique Programs:</span>
            <span class="summary-value">@Model.Select(x => x.ProgramId).Distinct().Count()</span>
        </span>
    </div>

    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Program Code</th>
                <th>Program Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.User?.UserName</td>
                    <td>@item.User?.Email</td>
                    <td>@item.Program?.ProgramCode</td>
                    <td>@item.Program?.ProgramName</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 40px; color: #999;">
            No user program mappings found.
        </div>
    }

    <div class="footer">
        <p>This is a system-generated report from Examination Management System.</p>
        <p>© @DateTime.Now.Year - All Rights Reserved</p>
    </div>

    <script>
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>