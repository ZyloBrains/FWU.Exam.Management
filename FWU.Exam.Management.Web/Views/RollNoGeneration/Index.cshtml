@model fwu_examination_management_system.ViewModels.RollNoGenerationSetupViewModel

@{
    ViewData["Title"] = "Setup";
}

<div class="space-y-4">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h1 class="text-2xl font-semibold text-gray-800">Setup</h1>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 px-4 py-3 text-sm">
                @Model.StatusMessage
            </div>
        }

        <form asp-action="Index" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label asp-for="ExamScheduleParentId" class="md:col-span-1 text-sm font-semibold text-gray-700 text-right pr-4">Exam Schedule</label>
                <div class="md:col-span-2">
                    <select asp-for="ExamScheduleParentId"
                            asp-items="Model.ExamScheduleParents"
                            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></select>
                    <span asp-validation-for="ExamScheduleParentId" class="text-sm text-red-600"></span>
                </div>
            </div>

            <div class="border-t border-dashed border-gray-300 pt-4 flex flex-wrap justify-center gap-3">
                <button type="submit" name="command" value="preview" class="px-5 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">Generate Setup</button>
                <button type="submit" name="command" value="save" class="px-5 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">Generate Setup and save</button>
                <button type="submit" name="command" value="roll" class="px-5 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">Generate Roll No By saved setup</button>
            </div>
        </form>
    </div>

    @if (Model.ExamScheduleParentId.HasValue)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <h2 class="text-lg font-semibold text-gray-700 mb-3">Saved Setup Details</h2>

            @if (Model.Setups.Count == 0)
            {
                <div class="rounded-lg border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 text-sm">
                    No setup found for selected parent exam schedule.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="text-left border-b border-gray-200 text-gray-600">
                                <th class="px-3 py-2">Setup Id</th>
                                <th class="px-3 py-2">First Roll No</th>
                                <th class="px-3 py-2">Prefix</th>
                                <th class="px-3 py-2">Suffix</th>
                                <th class="px-3 py-2">Min Length</th>
                                <th class="px-3 py-2">Round</th>
                                <th class="px-3 py-2">Min Gap</th>
                                <th class="px-3 py-2">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Setups)
                            {
                                <tr class="border-b border-gray-100 text-gray-700">
                                    <td class="px-3 py-2">@row.ExamRollNumberSetupId</td>
                                    <td class="px-3 py-2">@row.FirstExamRollNumber</td>
                                    <td class="px-3 py-2">@row.Prefix</td>
                                    <td class="px-3 py-2">@row.Suffix</td>
                                    <td class="px-3 py-2">@row.MinimumRollNumberLength</td>
                                    <td class="px-3 py-2">@row.Round</td>
                                    <td class="px-3 py-2">@row.MinimumGap</td>
                                    <td class="px-3 py-2">@(row.IsActive ? "Active" : "Inactive")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
