@model FWU.Exam.Management.Domain.Entities.Subjects.SubjectType

@{
    ViewData["Title"] = "Edit Subject Type";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-book text-amber-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit Subject Type</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="md:col-span-2">
                    <label asp-for="Name" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="Name" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="e.g., Theory, Practical, Elective, Core" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="MaxAllowedSubjects" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="MaxAllowedSubjects" type="number" min="1" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="e.g., 10, 20, 30" />
                    <span asp-validation-for="MaxAllowedSubjects" class="text-xs text-red-500 mt-1 block"></span>
                    <p class="text-xs text-gray-500 mt-1">Maximum number of subjects allowed for this type</p>
                </div>
                <div>
                    <label asp-for="Code" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="Code" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="e.g., CORE, ELEC" />
                    <span asp-validation-for="Code" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsDefault" type="checkbox" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                        <label asp-for="IsDefault" class="text-sm font-medium text-gray-700">Set as Default</label>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">If checked, this will be the default subject type.</p>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
