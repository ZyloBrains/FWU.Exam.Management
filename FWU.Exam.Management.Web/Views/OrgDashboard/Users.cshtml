@model IEnumerable<fwu_examination_management_system.ViewModels.UserListItemViewModel>

@{
    var org = ViewBag.Organization as fwu_examination_management_system.Models.Organization;
    ViewData["Title"] = $"{org!.Name} – Users";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item">
            <a asp-controller="OrgDashboard" asp-action="Index" asp-route-officeCode="@org.OfficeCode">@org.Name</a>
        </li>
        <li class="breadcrumb-item active">Users</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users — @org.Name</h1>
    <a asp-controller="OrgDashboard" asp-action="CreateUser"
       asp-route-officeCode="@org.OfficeCode"
       class="btn btn-primary">Add User</a>
</div>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Email</th>
            <th>Roles</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Email</td>
                <td>
                    @if (item.Roles.Count > 0)
                    {
                        @string.Join(", ", item.Roles)
                    }
                    else
                    {
                        <span class="text-muted">No roles</span>
                    }
                </td>
                <td>
                    <a asp-controller="OrgDashboard" asp-action="EditUser"
                       asp-route-officeCode="@org.OfficeCode" asp-route-userId="@item.Id"
                       class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-controller="OrgDashboard" asp-action="AssignRoles"
                       asp-route-officeCode="@org.OfficeCode" asp-route-userId="@item.Id"
                       class="btn btn-sm btn-outline-primary">Roles</a>
                    <a asp-controller="OrgDashboard" asp-action="DeleteUser"
                       asp-route-officeCode="@org.OfficeCode" asp-route-userId="@item.Id"
                       class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
