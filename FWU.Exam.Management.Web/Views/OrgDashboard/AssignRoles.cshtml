@model fwu_examination_management_system.ViewModels.AssignRolesViewModel

@{
    var org = ViewBag.Organization as fwu_examination_management_system.Models.Organization;
    ViewData["Title"] = $"Assign Roles — {org!.Name}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="OrgDashboard" asp-action="Index" asp-route-officeCode="@org.OfficeCode">@org.Name</a></li>
        <li class="breadcrumb-item"><a asp-controller="OrgDashboard" asp-action="Users" asp-route-officeCode="@org.OfficeCode">Users</a></li>
        <li class="breadcrumb-item active">Assign Roles</li>
    </ol>
</nav>

<h1 class="h3 mb-1">Assign Roles</h1>
<h5 class="text-muted mb-4">@Model.UserEmail</h5>

<div class="row">
    <div class="col-md-4">
        <form asp-controller="OrgDashboard" asp-action="AssignRoles"
              asp-route-officeCode="@org.OfficeCode" asp-route-userId="@Model.UserId"
              method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserEmail" />

            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <div class="form-check mb-2">
                    <input asp-for="SelectedRole"
                           type="radio"
                           value="@Model.Roles[i].RoleName"
                           id="role_@i" class="form-check-input" />
                    <label class="form-check-label" for="role_@i">@Model.Roles[i].RoleName</label>
                </div>
            }

            <span asp-validation-for="SelectedRole" class="text-danger"></span>

            <div class="mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-controller="OrgDashboard" asp-action="Users"
                   asp-route-officeCode="@org.OfficeCode"
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
