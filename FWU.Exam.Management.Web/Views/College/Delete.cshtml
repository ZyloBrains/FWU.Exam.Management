@model College

@{
    ViewData["Title"] = "Delete College";
}

<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-xl shadow-sm border border-red-200 p-6 md:p-8">
        <div class="mb-4">
            <h1 class="text-2xl font-bold text-red-700">Delete College</h1>
            <p class="text-sm text-gray-600 mt-1">Are you sure you want to delete this college?</p>
        </div>

        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <div class="text-sm text-red-800"><span class="font-semibold">Code:</span> @Model.Code</div>
            <div class="text-sm text-red-800"><span class="font-semibold">Name:</span> @Model.Name</div>
            <div class="text-sm text-red-800"><span class="font-semibold">Address:</span> @Model.Address</div>
            <div class="text-sm text-red-800"><span class="font-semibold">District:</span> @(!string.IsNullOrWhiteSpace(Model.DistrictName) ? Model.DistrictName : Model.District?.DistrictName)</div>
            <div class="text-sm text-red-800"><span class="font-semibold">College Type:</span> @(!string.IsNullOrWhiteSpace(Model.CollegeTypeName) ? Model.CollegeTypeName : Model.CollegeType?.Name)</div>
            <div class="text-sm text-red-800"><span class="font-semibold">Email:</span> @Model.Email</div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-3">
                <button type="submit" class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                    Delete
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="px-6 py-2.5 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
