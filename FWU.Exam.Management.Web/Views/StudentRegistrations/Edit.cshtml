@using FWU.Exam.Management.Domain.Entities.Students
@model StudentRegistration

@{
    ViewData["Title"] = "Edit Student Registration";
}

<div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-5xl mx-auto">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h1 class="text-xl font-semibold text-gray-800">Edit Student Registration</h1>
            </div>

            <div class="px-6 py-6">
                <form asp-action="Edit" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Personal Information -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Personal Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div>
                                <label asp-for="AcademicYearId" class="block text-sm font-medium text-gray-700 mb-1">
                                    Academic Year
                                    *
                                </label>
                                <select asp-for="AcademicYearId"
                                        class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm placeholder-gray-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500"
                                        asp-items="ViewBag.AcademicYearId"></select>
                            </div>

                            <div>
                                <label asp-for="LevelId" class="block text-sm font-medium text-gray-700 mb-1">Level/Grade *</label>
                                <select asp-for="LevelId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.LevelId"></select>
                            </div>

                            <div>
                                <label asp-for="CollegeId" class="block text-sm font-medium text-gray-700 mb-1">College/Campus *</label>
                                <select asp-for="CollegeId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.CollegeId"></select>
                            </div>

                            <div>
                                <label asp-for="FacultyId" class="block text-sm font-medium text-gray-700 mb-1">Faculty *</label>
                                <select asp-for="FacultyId"
                                        class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm"
                                        asp-items="ViewBag.FacultyId">
                                    <option value="">Select Faculty</option>
                                </select>
                                <span asp-validation-for="FacultyId" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="StudentRegistrationIndex" class="block text-sm font-medium text-gray-700 mb-1">Program/Stream</label>
                                <input asp-for="StudentRegistrationIndex" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="StudentRegistrationIndex" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="PreviousAcademicYear" class="block text-sm font-medium text-gray-700 mb-1">Year/Part</label>
                                <input asp-for="PreviousAcademicYear" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="PreviousAcademicYear" class="text-red-600 text-xs"></span>
                            </div>

                            <div class="md:col-span-3">
                                <label class="block text-sm text-gray-600 mb-1">Name *</label>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <input asp-for="FirstName" placeholder="First Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                    <input asp-for="MiddleName" placeholder="Middle Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                    <input asp-for="LastName" placeholder="Last Name" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                </div>
                            </div>

                            <div>
                                <label asp-for="GenderId" class="block text-sm text-gray-600 mb-1">Gender *</label>
                                <select asp-for="GenderId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.GenderId"></select>
                            </div>

                            <div>
                                <label asp-for="DateOfBirthBS" class="block text-sm text-gray-600 mb-1">Date of Birth (BS)</label>
                                <input asp-for="DateOfBirthBS" placeholder="YYYY-MM-DD" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="DateOfBirthBS" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="DateOfBirthAD" class="block text-sm text-gray-600 mb-1">Date of Birth (AD)</label>
                                <input asp-for="DateOfBirthAD" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="DateOfBirthAD" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="RegistrationNumber" class="block text-sm text-gray-600 mb-1">College Roll No</label>
                                <input asp-for="RegistrationNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="RegistrationNumber" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="EthnicityId" class="block text-sm text-gray-600 mb-1">Ethnicity</label>
                                <select asp-for="EthnicityId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" asp-items="ViewBag.EthnicityId"></select>
                            </div>

                            <div>
                                <label asp-for="Nationality" class="block text-sm text-gray-600 mb-1">Nationality</label>
                                <input asp-for="Nationality" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Nationality" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="Religion" class="block text-sm text-gray-600 mb-1">Religion</label>
                                <input asp-for="Religion" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Religion" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="Email" class="block text-sm text-gray-600 mb-1">Email</label>
                                <input asp-for="Email" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                            </div>

                            <div>
                                <label asp-for="ContactNumber" class="block text-sm text-gray-600 mb-1">Phone</label>
                                <input asp-for="ContactNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                                <span asp-validation-for="ContactNumber" class="text-red-600 text-xs"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Student Category -->
                    <div>
                        <label asp-for="StudentCategoryId" class="block text-sm font-medium">Student Category *</label>
                        <select asp-for="StudentCategoryId" asp-items="ViewBag.StudentCategoryId"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500 shadow-sm">
                            <option value="">Select Category</option>
                        </select>
                        <span asp-validation-for="StudentCategoryId" class="text-red-600 text-xs"></span>
                    </div>

                    <!-- Address Information -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Address Information</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">District *</label>
                                <select id="DistrictId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                    <option>Select District</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Local Level *</label>
                                <select id="LocalLevelId" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500">
                                    <option>Select Local Level</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Ward Number</label>
                                <input id="WardNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Tole/Street</label>
                                <input id="ToleStreet" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>

                            <div>
                                <label class="block text-sm text-gray-600 mb-1">House Number</label>
                                <input id="HouseNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>

                            <div>
                                <label asp-for="RowIndex" class="block text-sm text-gray-600 mb-1">Row Index</label>
                                <input asp-for="RowIndex" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-500" />
                            </div>
                        </div>
                    </div>

                    <!-- Qualification Info -->
                    <div>
                        <h2 class="text-sm font-semibold text-gray-700 mb-3">Qualification Info</h2>
                        <div class="border-t border-gray-100 mb-4"></div>

                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm text-left">
                                <thead>
                                    <tr class="border-b">
                                        <th class="py-2 pr-4">Previous Level</th>
                                        <th class="py-2 pr-4">Board</th>
                                        <th class="py-2 pr-4">Institute</th>
                                        <th class="py-2 pr-4">Passed Year</th>
                                        <th class="py-2 pr-4">Percentage</th>
                                        <th class="py-2">Roll Number</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- body-->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Hidden Fields -->
                    <input type="hidden" asp-for="IsActive" />

                    <div class="flex items-center space-x-3">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded-md text-sm hover:bg-teal-700 transition focus:outline-none focus:ring-2 focus:ring-teal-400 focus:ring-offset-1">Save changes</button>
                        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition focus:outline-none focus:ring-2 focus:ring-gray-300 focus:ring-offset-1">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {

            // District -> LocalLevel
            $("#DistrictId").change(function () {
                var districtId = $(this).val();

                $("#LocalLevelId").html('<option>Loading...</option>');

                $.get("/StudentRegistrations/GetLocalLevelsByDistrict", { districtId: districtId }, function (data) {
                    let localLevelDropdown = $("#LocalLevelId");
                    localLevelDropdown.empty();
                    localLevelDropdown.append('<option value="">Select Local Level</option>');

                    $.each(data, function (index, item) {
                        localLevelDropdown.append(`<option value="${item.id}">${item.name}</option>`);
                    });
                });
            });
        });
    </script>
}
