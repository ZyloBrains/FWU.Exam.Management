@model fwu_examination_management_system.Data.Models.ProgramPeriodType

@{
    ViewData["Title"] = "Create Program Period Type";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-orange-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Program Period Type</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 gap-5">
                <div>
                    <label asp-for="ProgramPeriodTypeName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="ProgramPeriodTypeName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="e.g., Semester, Trimester, Quarter, Annual" />
                    <span asp-validation-for="ProgramPeriodTypeName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="NumberOfMonths" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="NumberOfMonths" type="number" min="1" max="24" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500" placeholder="e.g., 6, 4, 3, 12" />
                    <span asp-validation-for="NumberOfMonths" class="text-xs text-red-500 mt-1 block"></span>
                    <p class="text-xs text-gray-500 mt-1">Enter the duration in months (e.g., 6 for Semester, 4 for Quarter, 3 for Trimester)</p>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}