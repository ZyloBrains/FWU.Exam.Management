@model fwu_examination_management_system.Data.Models.SmtpConfiguration

@{
    ViewData["Title"] = "SMTP Configuration Details";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-envelope text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">SMTP Configuration Details</h1>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <!-- SMTP Configuration Details -->
        <div class="mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Configuration Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm font-medium text-gray-600">SMTP Host</p>
                    <p class="mt-1 text-gray-800 font-semibold">@Html.DisplayFor(model => model.Host)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Port Number</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.Port)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">From Email Address</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.From)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Username</p>
                    <p class="mt-1 text-gray-800">@Html.DisplayFor(model => model.UserName)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Password</p>
                    <p class="mt-1 text-gray-800">••••••••</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">SSL/TLS Status</p>
                    <div class="mt-1">
                        @if (Model.EnableSsl)
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-700 rounded-full">✓ Enabled</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">✗ Disabled</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Connection String Example -->
        <div class="mb-6 pt-2">
            <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Connection Information</h2>
            <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-xs text-gray-500 mb-2">SMTP Connection String:</p>
                <code class="text-sm text-gray-800 break-all">
                    smtp://@(Model.UserName):*****@@Model.Host:@Model.Port/?enableSsl=@Model.EnableSsl.ToString().ToLower()
                </code>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 mt-4 border-t border-gray-200">
            @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-edit mr-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                Back to List
            </a>
        </div>
    </div>
</div>