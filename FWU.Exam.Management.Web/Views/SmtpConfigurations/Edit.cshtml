@model FWU.Exam.Management.Domain.Entities.SmtpConfiguration

@{
    ViewData["Title"] = "Edit SMTP Configuration";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-envelope text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit SMTP Configuration</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <!-- Section: SMTP Server Settings -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">SMTP Server Settings</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="Host" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="Host" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="smtp.gmail.com" />
                        <span asp-validation-for="Host" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Port" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="Port" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="587" />
                        <span asp-validation-for="Port" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="From" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="From" type="email" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="noreply@example.com" />
                        <span asp-validation-for="From" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="UserName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="UserName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Username" />
                        <span asp-validation-for="UserName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Password" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="Password" type="password" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Security Options -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Security Options</h2>
                <div class="flex flex-wrap gap-6">
                    <div class="flex items-center gap-2">
                        <input asp-for="EnableSsl" type="checkbox" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                        <label asp-for="EnableSsl" class="text-sm font-medium text-gray-700">Enable SSL/TLS</label>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
