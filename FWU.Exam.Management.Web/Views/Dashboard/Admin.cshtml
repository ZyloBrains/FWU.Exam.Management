@model DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-tachometer-alt text-green-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Admin Dashboard</h1>
                <p class="text-sm text-gray-500 mt-0.5">Manage colleges, programs, exams, and students</p>
            </div>
        </div>
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="text" placeholder="Search..."
                   class="pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white w-48 sm:w-64" />
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Colleges</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalColleges</p>
                    </div>
                    <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center"><i class="fas fa-school text-amber-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActiveColleges active</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Programs</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalPrograms</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActivePrograms active</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Students</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalStudents</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center"><i class="fas fa-user-graduate text-blue-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActiveStudents active</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Exam Schedules</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalExamSchedules</p>
                    </div>
                    <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center"><i class="fas fa-calendar-alt text-orange-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActiveExamSchedules active</span></div>
            </div>
        </div>
    </div>

    <!-- Second Row Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div><p class="text-sm text-gray-500">Subjects</p><p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalSubjects</p></div>
                <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center"><i class="fas fa-book text-teal-600"></i></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div><p class="text-sm text-gray-500">Exam Registrations</p><p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalExamRegistrations</p></div>
                <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center"><i class="fas fa-clipboard-list text-cyan-600"></i></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div><p class="text-sm text-gray-500">Academic Years</p><p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalAcademicYears</p></div>
                <div class="w-10 h-10 bg-pink-100 rounded-lg flex items-center justify-center"><i class="fas fa-calendar text-pink-600"></i></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div><p class="text-sm text-gray-500">Batches</p><p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalBatches</p></div>
                <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center"><i class="fas fa-layer-group text-gray-600"></i></div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-800">Quick Actions</h3>
            <p class="text-sm text-gray-500 mt-1">Manage academic entities</p>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
                <a asp-controller="College" asp-action="Index" class="group flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-amber-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-amber-100 group-hover:bg-amber-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-school text-xl text-amber-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-amber-700 text-center">Colleges</span>
                </a>
                <a asp-controller="Program" asp-action="Index" class="group flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-indigo-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-indigo-100 group-hover:bg-indigo-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-graduation-cap text-xl text-indigo-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-indigo-700 text-center">Programs</span>
                </a>
                <a asp-controller="Subject" asp-action="Index" class="group flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-teal-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-teal-100 group-hover:bg-teal-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-book text-xl text-teal-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-teal-700 text-center">Subjects</span>
                </a>
                <a asp-controller="ExamSchedule" asp-action="Index" class="group flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-orange-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-orange-100 group-hover:bg-orange-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-calendar-alt text-xl text-orange-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-orange-700 text-center">Exam Schedules</span>
                </a>
                <a asp-controller="AcademicYear" asp-action="Index" class="group flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-pink-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-pink-100 group-hover:bg-pink-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-calendar text-xl text-pink-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-pink-700 text-center">Academic Years</span>
                </a>
                <a asp-controller="College" asp-action="Create" class="group flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-green-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-green-100 group-hover:bg-green-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-plus text-xl text-green-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-green-700 text-center">Add College</span>
                </a>
            </div>
        </div>
    </div>
</div>
