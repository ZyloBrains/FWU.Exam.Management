@model DashboardViewModel

@{
    ViewData["Title"] = "College Admin Dashboard";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-tachometer-alt text-green-600"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">College Admin Dashboard</h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Manage your college's programs, exams, and students</p>
            </div>
        </div>
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="text" placeholder="Search..."
                   class="pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white w-48 sm:w-64" />
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Programs</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalPrograms</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActivePrograms active</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs sm:text-sm font-medium text-gray-500">Students</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalStudents</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center"><i class="fas fa-user-graduate text-blue-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActiveStudents active</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div><p class="text-xs sm:text-sm text-gray-500">Subjects</p><p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalSubjects</p></div>
                <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center"><i class="fas fa-book text-teal-600"></i></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div><p class="text-xs sm:text-sm text-gray-500">Exam Registrations</p><p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalExamRegistrations</p></div>
                <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center"><i class="fas fa-clipboard-list text-cyan-600"></i></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div><p class="text-xs sm:text-sm text-gray-500">Academic Years</p><p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1">@Model.TotalAcademicYears</p></div>
                <div class="w-10 h-10 bg-pink-100 rounded-lg flex items-center justify-center"><i class="fas fa-calendar text-pink-600"></i></div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h3 class="text-base sm:text-lg font-semibold text-gray-800">Quick Actions</h3>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Frequently used management features</p>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                <a asp-area="Exams" asp-controller="ExamRegistrations" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-cyan-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-cyan-100 group-hover:bg-cyan-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-clipboard-list text-xl text-cyan-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-cyan-700 text-center">Exam Registration</span>
                </a>
                <a asp-area="Exams" asp-controller="ExamSchedules" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-orange-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-orange-100 group-hover:bg-orange-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-calendar-alt text-xl text-orange-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-orange-700 text-center">Exam Schedules</span>
                </a>
                <a asp-area="Exams" asp-controller="CollegeAdminApprovals" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-green-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-green-100 group-hover:bg-green-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-check-double text-xl text-green-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-green-700 text-center">Schedule Approvals</span>
                </a>
                <a asp-area="Exams" asp-controller="Entrance" asp-action="ManageSchedule" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-purple-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-purple-100 group-hover:bg-purple-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-calendar-plus text-xl text-purple-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-purple-700 text-center">Entrance Schedule</span>
                </a>
                <a asp-area="Exams" asp-controller="AdmitCards" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-yellow-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-yellow-100 group-hover:bg-yellow-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-ticket-alt text-xl text-yellow-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-yellow-700 text-center">Admit Cards</span>
                </a>
                <a asp-area="Exams" asp-controller="CollegeAdminMarks" asp-action="Dashboard" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-red-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-red-100 group-hover:bg-red-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-table text-xl text-red-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-red-700 text-center">Internal Marks Entry</span>
                </a>
                <a asp-area="Exams" asp-controller="PracticalMarks" asp-action="Dashboard" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-indigo-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-indigo-100 group-hover:bg-indigo-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-flask text-xl text-indigo-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-indigo-700 text-center">Practical Marks</span>
                </a>
                <a asp-area="Exams" asp-controller="ResultRecords" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-rose-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-rose-100 group-hover:bg-rose-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-clipboard-check text-xl text-rose-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-rose-700 text-center">Result Records</span>
                </a>
                <a asp-area="Students" asp-controller="StudentAdmissions" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-blue-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-blue-100 group-hover:bg-blue-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-user-graduate text-xl text-blue-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-blue-700 text-center">Student Admissions</span>
                </a>
                <a asp-area="Core" asp-controller="Programs" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-indigo-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-indigo-100 group-hover:bg-indigo-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-graduation-cap text-xl text-indigo-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-indigo-700 text-center">Programs</span>
                </a>
                <a asp-area="Core" asp-controller="AcademicYears" asp-action="Index" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-pink-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-pink-100 group-hover:bg-pink-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-calendar text-xl text-pink-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-pink-700 text-center">Academic Years</span>
                </a>
                <a asp-controller="User" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-green-50 hover:shadow-md transition-all duration-200">
                    <div class="w-12 h-12 bg-green-100 group-hover:bg-green-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-user-plus text-xl text-green-600"></i></div>
                    <span class="text-xs font-medium text-gray-700 group-hover:text-green-700 text-center">New User</span>
                </a>
            </div>
        </div>
    </div>
</div>
