    <!-- Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-3 sm:gap-6">
        <div class="group relative bg-white rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg transition-all duration-300 overflow-hidden active:scale-[0.98]">
            <div class="relative p-3 sm:p-6">
                <div class="flex items-center justify-between mb-2 sm:mb-4">
                    <span class="inline-flex items-center gap-1 px-2 sm:px-3 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-semibold bg-indigo-50 text-indigo-600 uppercase tracking-wider">Program</span>
                    <div class="w-8 h-8 sm:w-11 sm:h-11 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-lg sm:rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20">
                        <svg class="h-4 w-4 sm:h-6 sm:w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                </div>
                <p class="text-sm sm:text-lg font-bold text-gray-900 truncate">@(Model.StudentProgramName ?? "N/A")</p>
                <p class="text-[11px] sm:text-sm text-gray-500 mt-0.5">@Model.StudentProgramCode</p>
            </div>
        </div>

        <div class="group relative bg-white rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg transition-all duration-300 overflow-hidden active:scale-[0.98]">
            <div class="relative p-3 sm:p-6">
                <div class="flex items-center justify-between mb-2 sm:mb-4">
                    <span class="inline-flex items-center gap-1 px-2 sm:px-3 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-semibold bg-purple-50 text-purple-600 uppercase tracking-wider">Level</span>
                    <div class="w-8 h-8 sm:w-11 sm:h-11 bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg sm:rounded-xl flex items-center justify-center shadow-lg shadow-purple-500/20">
                        <svg class="h-4 w-4 sm:h-6 sm:w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                </div>
                <p class="text-sm sm:text-lg font-bold text-gray-900">@(Model.LevelName ?? "N/A")</p>
                <p class="text-[11px] sm:text-sm text-gray-500 mt-0.5">@Model.AcademicYearName</p>
            </div>
        </div>

        <div class="group relative bg-white rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg transition-all duration-300 overflow-hidden active:scale-[0.98]">
            <div class="relative p-3 sm:p-6">
                <div class="flex items-center justify-between mb-2 sm:mb-4">
                    <span class="inline-flex items-center gap-1 px-2 sm:px-3 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-semibold bg-amber-50 text-amber-600 uppercase tracking-wider">College</span>
                    <div class="w-8 h-8 sm:w-11 sm:h-11 bg-gradient-to-br from-amber-500 to-orange-600 rounded-lg sm:rounded-xl flex items-center justify-center shadow-lg shadow-amber-500/20">
                        <svg class="h-4 w-4 sm:h-6 sm:w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                </div>
                <p class="text-sm sm:text-lg font-bold text-gray-900 truncate">@(Model.CollegeName ?? "N/A")</p>
                <p class="text-[11px] sm:text-sm text-gray-500 mt-0.5">Reg: @Model.RegistrationNumber</p>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 sm:gap-8">
        <!-- Left: Subjects & Exam Schedules -->
        <div class="lg:col-span-2 space-y-5 sm:space-y-8">
            <div class="bg-white rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-4 sm:px-8 py-3 sm:py-5 border-b border-gray-100 flex items-center justify-between">
                    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                        <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-lg sm:rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/20 shrink-0">
                            <svg class="h-4 w-4 sm:h-5 sm:w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-sm sm:text-lg font-bold text-gray-900 truncate">My Subjects</h3>
                            <p class="text-xs sm:text-sm text-gray-500 truncate">Your current semester subjects under @Model.StudentProgramName</p>
                        </div>
                    </div>
                    <span class="shrink-0 inline-flex items-center gap-1 px-2 sm:px-4 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-semibold @(subjectCount > 0 ? "bg-emerald-50 text-emerald-700" : "bg-gray-50 text-gray-500")">
                        @subjectCount
                    </span>
                </div>
                <div class="p-4 sm:p-8">
                    @if (subjectCount > 0)
                    {
                        <div class="space-y-4 sm:space-y-6">
                            @foreach (var semesterGroup in subjectsBySemester!)
                            {
                                var compulsorySubjects = semesterGroup.Where(so => so.IsCompulsory).ToList();
                                var homeElectiveGroups = semesterGroup.Where(so => !so.IsCompulsory)
                                    .GroupBy(so => so.SubjectCatalog?.SubjectTypeId ?? 0)
                                    .ToList();
                                <div>
                                    <div class="flex items-center gap-2 mb-2 sm:mb-3">
                                        <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-emerald-500"></div>
                                        <h4 class="text-[11px] sm:text-sm font-bold text-gray-700 uppercase tracking-wide">@semesterGroup.Key</h4>
                                        <span class="text-[10px] sm:text-xs text-gray-400">(@semesterGroup.Count())</span>
                                    </div>
                                    <div class="space-y-1.5 sm:space-y-2">
                                        @{ int idx = 0; }
                                        @foreach (var so in compulsorySubjects)
                                        {
                                            idx++;
                                            <div class="group flex items-center justify-between p-2.5 sm:p-4 bg-gray-50/80 rounded-lg sm:rounded-xl hover:bg-emerald-50/60 border border-gray-100 hover:border-emerald-200 transition-all duration-200">
                                                <div class="flex items-center gap-2 sm:gap-4 min-w-0 flex-1">
                                                    <span class="hidden sm:flex flex-shrink-0 w-8 h-8 rounded-lg bg-white shadow-sm border border-gray-100 items-center justify-center text-xs font-bold text-gray-400 group-hover:text-emerald-600">@idx</span>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="flex items-center gap-1.5 min-w-0">
                                                            <p class="text-xs sm:text-sm font-semibold text-gray-900 truncate">@so.SubjectCatalog?.SubjectName</p>
                                                            <span class="shrink-0 px-1 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-600 border border-rose-100">C</span>
                                                        </div>
                                                        <p class="text-[10px] sm:text-xs text-gray-500 font-mono mt-0.5">@so.SubjectCatalog?.SubjectCode</p>
                                                    </div>
                                                </div>
                                                <div class="flex-shrink-0 flex items-center gap-1 sm:gap-1.5 ml-2 sm:ml-4">
                                                    @if (so.HasTheory)
                                                    {
                                                        <span class="inline-flex items-center px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded text-[10px] sm:text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">T</span>
                                                    }
                                                    @if (so.HasPractical)
                                                    {
                                                        <span class="inline-flex items-center px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded text-[10px] sm:text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">P</span>
                                                    }
                                                    @if (so.HasInternal)
                                                    {
                                                        <span class="inline-flex items-center px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded text-[10px] sm:text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-100">I</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (homeElectiveGroups.Any(g => g.Any()))
                                        {
                                            @foreach (var eGroup in homeElectiveGroups.Where(g => g.Any()))
                                            {
                                                var electiveTypeName = eGroup.First().SubjectCatalog?.SubjectType?.Name;
                                                <div class="rounded-lg sm:rounded-xl border-2 border-dashed border-purple-200 bg-purple-50/40 p-2 sm:p-3 mt-2 space-y-1.5">
                                                    <div class="flex items-center justify-between gap-2 px-0.5 pt-0.5 pb-1">
                                                        <h5 class="text-[10px] sm:text-xs font-bold text-purple-700 uppercase tracking-wider truncate">Elective Subjects@(string.IsNullOrWhiteSpace(electiveTypeName) ? "" : $" - {electiveTypeName}")</h5>
                                                        <span class="shrink-0 inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] sm:text-[10px] font-semibold bg-purple-100 text-purple-700">@eGroup.Count()</span>
                                                    </div>
                                                    @foreach (var so in eGroup)
                                                    {
                                                        idx++;
                                                        <div class="group flex items-center justify-between p-2.5 sm:p-4 bg-white rounded-lg hover:bg-purple-50/60 border border-purple-100 hover:border-purple-300 transition-all duration-200">
                                                            <div class="flex items-center gap-2 sm:gap-4 min-w-0 flex-1">
                                                                <span class="hidden sm:flex flex-shrink-0 w-8 h-8 rounded-lg bg-white shadow-sm border border-gray-100 items-center justify-center text-xs font-bold text-gray-400 group-hover:text-purple-600">@idx</span>
                                                                <div class="min-w-0 flex-1">
                                                                    <div class="flex items-center gap-1.5 min-w-0">
                                                                        <p class="text-xs sm:text-sm font-semibold text-gray-900 truncate">@so.SubjectCatalog?.SubjectName</p>
                                                                        <span class="shrink-0 px-1 py-0.5 rounded text-[10px] font-bold bg-purple-50 text-purple-600 border border-purple-100">E</span>
                                                                    </div>
                                                                    <p class="text-[10px] sm:text-xs text-gray-500 font-mono mt-0.5">@so.SubjectCatalog?.SubjectCode</p>
                                                                </div>
                                                            </div>
                                                            <div class="flex-shrink-0 flex items-center gap-1 sm:gap-1.5 ml-2 sm:ml-4">
                                                                @if (so.HasTheory)
                                                                {
                                                                    <span class="inline-flex items-center px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded text-[10px] sm:text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">T</span>
                                                                }
                                                                @if (so.HasPractical)
                                                                {
                                                                    <span class="inline-flex items-center px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded text-[10px] sm:text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">P</span>
                                                                }
                                                                @if (so.HasInternal)
                                                                {
                                                                    <span class="inline-flex items-center px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded text-[10px] sm:text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-100">I</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8 sm:py-14">
                            <div class="w-14 h-14 sm:w-20 sm:h-20 bg-gray-50 rounded-xl sm:rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-5">
                                <svg class="h-7 w-7 sm:h-10 sm:w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                            </div>
                            <h4 class="text-sm sm:text-lg font-semibold text-gray-900 mb-1">No Subjects Available</h4>
                            <p class="text-xs sm:text-sm text-gray-500 max-w-xs mx-auto">Subjects for your current semester have not been published yet.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="bg-white rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-4 sm:px-8 py-3 sm:py-5 border-b border-gray-100 flex items-center justify-between">
                    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                        <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-br from-amber-500 to-orange-600 rounded-lg sm:rounded-xl flex items-center justify-center shadow-lg shadow-amber-500/20 shrink-0">
                            <svg class="h-4 w-4 sm:h-5 sm:w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" /></svg>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-sm sm:text-lg font-bold text-gray-900 truncate">Exam Schedules</h3>
                            <p class="text-xs sm:text-sm text-gray-500 truncate">Upcoming and published exam schedules</p>
                        </div>
                    </div>
                    <span class="shrink-0 inline-flex items-center gap-1 px-2 sm:px-4 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-semibold @(scheduleCount > 0 ? "bg-amber-50 text-amber-700" : "bg-gray-50 text-gray-500")">
                        @scheduleCount
                    </span>
                </div>
                <div class="p-4 sm:p-8">
                    @if (scheduleCount > 0)
                    {
                        <div class="space-y-2 sm:space-y-3">
                            @foreach (var es in Model.ExamSchedules!.OrderByDescending(es => es.StartDateBs))
                            {
                                var today = DateOnly.FromDateTime(DateTime.Now);
                                var start = es.StartDate;
                                var end = es.EndDate;
                                var isOngoing = start.HasValue && end.HasValue && today >= start.Value && today <= end.Value;
                                var isUpcoming = start.HasValue && today < start.Value;
                                var isPast = end.HasValue && today > end.Value;
                                if (!start.HasValue && !end.HasValue && es.StartDateBs != null && es.EndDateBs != null)
                                {
                                    var nowBs = DateTime.Now.ToString("yyyy-MM-dd");
                                    isOngoing = string.Compare(nowBs, es.StartDateBs) >= 0 && string.Compare(nowBs, es.EndDateBs) <= 0;
                                    isUpcoming = string.Compare(nowBs, es.StartDateBs) < 0;
                                    isPast = string.Compare(nowBs, es.EndDateBs) > 0;
                                }

                                string statusLabel, statusBg, dotColor;
                                if (isUpcoming) { statusLabel = "Upcoming"; statusBg = "bg-blue-50 text-blue-700 border-blue-100"; dotColor = "bg-blue-500"; }
                                else if (isOngoing) { statusLabel = "Ongoing"; statusBg = "bg-emerald-50 text-emerald-700 border-emerald-100"; dotColor = "bg-emerald-500"; }
                                else { statusLabel = "Completed"; statusBg = "bg-gray-50 text-gray-500 border-gray-100"; dotColor = "bg-gray-400"; }

                                <div class="flex items-center justify-between p-2.5 sm:p-4 bg-gray-50/80 rounded-lg sm:rounded-xl hover:bg-amber-50/60 border border-gray-100 hover:border-amber-200 transition-all duration-200">
                                    <div class="flex items-center gap-2 sm:gap-4 min-w-0 flex-1">
                                        <div class="hidden sm:flex flex-shrink-0 w-10 h-10 rounded-lg bg-white shadow-sm border border-gray-100 items-center justify-center">
                                            <svg class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" /></svg>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-xs sm:text-sm font-semibold text-gray-900 truncate">@es.ExamScheduleName</p>
                                            <p class="text-[10px] sm:text-xs text-gray-500 mt-0.5">
                                                <span class="font-medium">@es.SemesterInstance?.Semester?.Name</span>
                                                <span class="mx-1">&middot;</span>
                                                <span class="font-mono">@es.StartDateBs - @es.EndDateBs</span>
                                            </p>
                                        </div>
                                    </div>
                                    <span class="shrink-0 inline-flex items-center gap-1 px-2 sm:px-3 py-0.5 sm:py-1 rounded text-[10px] sm:text-xs font-semibold @statusBg border ml-2 sm:ml-4">
                                        <span class="w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full @dotColor"></span>
                                        @statusLabel
                                    </span>
                                </div>
                            }
