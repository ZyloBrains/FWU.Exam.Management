@model DashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
    var subjectCount = Model.SubjectOfferings?.Count ?? 0;
    var scheduleCount = Model.ExamSchedules?.Count ?? 0;
    var subjectsBySemester = Model.SubjectOfferings?.GroupBy(so => so.Semester?.Name ?? "Unknown").ToList();
}

<div class="min-h-screen">
    <!-- Header Section -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 mb-10">
        <div class="absolute inset-0 bg-grid-white/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl"></div>
        <div class="relative px-8 py-10 sm:px-12 sm:py-12">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
                <div class="flex items-center gap-5">
                    <div class="h-16 w-16 bg-white/10 backdrop-blur-xl rounded-2xl flex items-center justify-center shadow-2xl border border-white/20">
                        <svg class="h-9 w-9 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14v6m0 0l-3-3m3 3l3-3" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">My Dashboard</h1>
                        <p class="mt-2 text-blue-200/80 text-sm sm:text-base">Welcome back, <span class="font-semibold text-white">@Model.StudentName</span></p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-xl rounded-xl border border-white/10 text-sm text-white/90">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        @Model.RegistrationNumber
                    </span>
                    <a asp-area="Students" asp-controller="StudentDashboard" asp-action="Profile" class="inline-flex items-center gap-2 px-5 py-2 bg-white text-indigo-700 font-semibold rounded-xl hover:bg-blue-50 transition-all duration-200 shadow-lg shadow-black/10 text-sm">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        My Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <!-- Program -->
        <div class="group relative bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative p-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-600 uppercase tracking-wider">Program</span>
                    <div class="w-11 h-11 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform duration-300">
                        <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                </div>
                <p class="text-lg font-bold text-gray-900 truncate">@(Model.StudentProgramName ?? "N/A")</p>
                <p class="text-sm text-gray-500 mt-1">@Model.StudentProgramCode</p>
            </div>
        </div>

        <!-- Level & Year -->
        <div class="group relative bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative p-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-600 uppercase tracking-wider">Level</span>
                    <div class="w-11 h-11 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg shadow-purple-500/20 group-hover:scale-110 transition-transform duration-300">
                        <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                </div>
                <p class="text-lg font-bold text-gray-900">@(Model.LevelName ?? "N/A")</p>
                <p class="text-sm text-gray-500 mt-1">@Model.AcademicYearName</p>
            </div>
        </div>

        <!-- Current Semester -->
        <div class="group relative bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative p-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 uppercase tracking-wider">Semester</span>
                    <div class="w-11 h-11 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/20 group-hover:scale-110 transition-transform duration-300">
                        <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                </div>
                <p class="text-lg font-bold text-gray-900">@(Model.SemesterName ?? "N/A")</p>
                <p class="text-sm text-gray-500 mt-1">
                    @if (subjectCount > 0)
                    {
                        <span class="inline-flex items-center gap-1">
                            <svg class="h-3.5 w-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                            @subjectCount subject@(subjectCount != 1 ? "s" : "")
                        </span>
                    }
                    else
                    {
                        <span class="text-gray-400">No subjects loaded</span>
                    }
                </p>
            </div>
        </div>

        <!-- College -->
        <div class="group relative bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-amber-50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative p-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-600 uppercase tracking-wider">College</span>
                    <div class="w-11 h-11 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-lg shadow-amber-500/20 group-hover:scale-110 transition-transform duration-300">
                        <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                </div>
                <p class="text-lg font-bold text-gray-900 truncate">@(Model.CollegeName ?? "N/A")</p>
                <p class="text-sm text-gray-500 mt-1">Reg: @Model.RegistrationNumber</p>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left: Subjects & Exam Schedules -->
        <div class="lg:col-span-2 space-y-8">

            <!-- Subjects Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-300">
                <div class="px-8 py-5 border-b border-gray-100 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/20">
                            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-gray-900">My Subjects</h3>
                            <p class="text-sm text-gray-500">Subjects under @Model.StudentProgramName</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-semibold @(subjectCount > 0 ? "bg-emerald-50 text-emerald-700" : "bg-gray-50 text-gray-500")">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        @subjectCount subject@(subjectCount != 1 ? "s" : "")
                    </span>
                </div>
                <div class="p-8">
                    @if (subjectCount > 0)
                    {
                        <div class="space-y-6">
                            @foreach (var semesterGroup in subjectsBySemester!)
                            {
                                <div>
                                    <div class="flex items-center gap-2 mb-3">
                                        <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                                        <h4 class="text-sm font-bold text-gray-700 uppercase tracking-wide">@semesterGroup.Key</h4>
                                        <span class="text-xs text-gray-400">(@semesterGroup.Count() subject@(semesterGroup.Count() != 1 ? "s" : ""))</span>
                                    </div>
                                    <div class="grid gap-2">
                                        @{
                                            int idx = 0;
                                        }
                                        @foreach (var so in semesterGroup)
                                        {
                                            idx++;
                                            <div class="group flex items-center justify-between p-4 bg-gray-50/80 rounded-xl hover:bg-emerald-50/60 border border-gray-100 hover:border-emerald-200 transition-all duration-200">
                                                <div class="flex items-center gap-4 min-w-0">
                                                    <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-white shadow-sm border border-gray-100 flex items-center justify-center text-sm font-bold text-gray-400 group-hover:text-emerald-600 group-hover:border-emerald-200 transition-colors duration-200">@idx</span>
                                                    <div class="min-w-0">
                                                        <p class="text-sm font-semibold text-gray-900 truncate">@so.SubjectCatalog?.SubjectName</p>
                                                        <p class="text-xs text-gray-500 font-mono mt-0.5">@so.SubjectCatalog?.SubjectCode</p>
                                                    </div>
                                                </div>
                                                <div class="flex-shrink-0 flex items-center gap-1.5 ml-4">
                                                    @if (so.HasTheory)
                                                    {
                                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">Theory</span>
                                                    }
                                                    @if (so.HasPractical)
                                                    {
                                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">Practical</span>
                                                    }
                                                    @if (so.HasInternal)
                                                    {
                                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-100">Internal</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-14">
                            <div class="w-20 h-20 bg-gray-50 rounded-2xl flex items-center justify-center mx-auto mb-5">
                                <svg class="h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                            </div>
                            <h4 class="text-lg font-semibold text-gray-900 mb-1">No Subjects Available</h4>
                            <p class="text-sm text-gray-500 max-w-xs mx-auto">Subjects for your current semester have not been published yet. Please check back later.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Exam Schedules Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-300">
                <div class="px-8 py-5 border-b border-gray-100 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-lg shadow-amber-500/20">
                            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" /></svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-gray-900">Exam Schedules</h3>
                            <p class="text-sm text-gray-500">Upcoming and published exam schedules</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-semibold @(scheduleCount > 0 ? "bg-amber-50 text-amber-700" : "bg-gray-50 text-gray-500")">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        @scheduleCount schedule@(scheduleCount != 1 ? "s" : "")
                    </span>
                </div>
                <div class="p-8">
                    @if (scheduleCount > 0)
                    {
                        <div class="grid gap-3">
                            @foreach (var es in Model.ExamSchedules!.OrderByDescending(es => es.StartDateBs))
                            {
                                var today = DateOnly.FromDateTime(DateTime.Now);
                                var start = es.StartDate;
                                var end = es.EndDate;
                                var isOngoing = start.HasValue && end.HasValue && today >= start.Value && today <= end.Value;
                                var isUpcoming = start.HasValue && today < start.Value;
                                var isPast = end.HasValue && today > end.Value;
                                if (!start.HasValue && !end.HasValue && es.StartDateBs != null && es.EndDateBs != null)
                                {
                                    var nowBs = DateTime.Now.ToString("yyyy-MM-dd");
                                    isOngoing = string.Compare(nowBs, es.StartDateBs) >= 0 && string.Compare(nowBs, es.EndDateBs) <= 0;
                                    isUpcoming = string.Compare(nowBs, es.StartDateBs) < 0;
                                    isPast = string.Compare(nowBs, es.EndDateBs) > 0;
                                }

                                string statusLabel, statusBg, statusBorder, dotColor;
                                if (isUpcoming) { statusLabel = "Upcoming"; statusBg = "bg-blue-50"; statusBorder = "border-blue-100"; dotColor = "bg-blue-500"; }
                                else if (isOngoing) { statusLabel = "Ongoing"; statusBg = "bg-emerald-50"; statusBorder = "border-emerald-100"; dotColor = "bg-emerald-500"; }
                                else { statusLabel = "Completed"; statusBg = "bg-gray-50"; statusBorder = "border-gray-100"; dotColor = "bg-gray-400"; }

                                <div class="flex items-center justify-between p-4 bg-gray-50/80 rounded-xl hover:bg-amber-50/60 border border-gray-100 hover:border-amber-200 transition-all duration-200">
                                    <div class="flex items-center gap-4 min-w-0">
                                        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-white shadow-sm border border-gray-100 flex items-center justify-center">
                                            <svg class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" /></svg>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-gray-900">@es.ExamScheduleName</p>
                                            <p class="text-xs text-gray-500 mt-0.5">
                                                <span class="font-medium">@es.Semester?.Name</span>
                                                <span class="mx-1.5">&middot;</span>
                                                <span class="font-mono">@es.StartDateBs - @es.EndDateBs</span>
                                            </p>
                                        </div>
                                    </div>
                                    <span class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold @statusBg @statusBorder border ml-4">
                                        <span class="w-1.5 h-1.5 rounded-full @dotColor"></span>
                                        @statusLabel
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-14">
                            <div class="w-20 h-20 bg-gray-50 rounded-2xl flex items-center justify-center mx-auto mb-5">
                                <svg class="h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <h4 class="text-lg font-semibold text-gray-900 mb-1">No Exam Schedules</h4>
                            <p class="text-sm text-gray-500 max-w-xs mx-auto">No exam schedules have been published for your program yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Quick Access & Info -->
        <div class="lg:col-span-1 space-y-8">

            <!-- Quick Access -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-300">
                <div class="px-8 py-5 border-b border-gray-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20">
                            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-gray-900">Quick Access</h3>
                            <p class="text-sm text-gray-500">Student services</p>
                        </div>
                    </div>
                </div>
                <div class="p-6 space-y-3">
                    <a asp-area="Students" asp-controller="StudentDashboard" asp-action="ExamForms" class="group flex items-center gap-4 p-4 bg-gray-50/80 rounded-xl hover:bg-indigo-50/80 border border-gray-100 hover:border-indigo-200 hover:shadow-sm transition-all duration-200">
                        <div class="w-11 h-11 bg-white rounded-xl shadow-sm border border-gray-100 flex items-center justify-center group-hover:scale-110 group-hover:bg-indigo-500 group-hover:border-indigo-500 transition-all duration-300">
