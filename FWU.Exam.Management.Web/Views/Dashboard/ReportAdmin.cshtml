@model DashboardViewModel

@{
    ViewData["Title"] = "Report Admin Dashboard";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-chart-bar text-purple-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Report Admin Dashboard</h1>
                <p class="text-sm text-gray-500 mt-0.5">Reports, analytics, and data overview</p>
            </div>
        </div>
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="text" placeholder="Search reports..."
                   class="pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent bg-white w-48 sm:w-64" />
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Total Students</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalStudents</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center"><i class="fas fa-user-graduate text-blue-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActiveStudents active</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Exam Registrations</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalExamRegistrations</p>
                    </div>
                    <div class="w-12 h-12 bg-cyan-100 rounded-full flex items-center justify-center"><i class="fas fa-clipboard-list text-cyan-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-blue-600 font-medium"><i class="fas fa-chart-line mr-1"></i>All registrations</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Active Colleges</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.ActiveColleges</p>
                    </div>
                    <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center"><i class="fas fa-school text-amber-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-gray-500 font-medium"><i class="fas fa-building mr-1"></i>of @Model.TotalColleges total</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Programs</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalPrograms</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600 text-xl"></i></div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActivePrograms active</span></div>
            </div>
        </div>
    </div>

    <!-- Report Quick Access -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-800">Report Modules</h3>
            <p class="text-sm text-gray-500 mt-1">Access reports and view data</p>
        </div>
        <div class="divide-y divide-gray-100">
            <a asp-controller="College" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-center gap-3"><div class="w-9 h-9 bg-amber-100 rounded-lg flex items-center justify-center"><i class="fas fa-school text-amber-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">College Directory</span></div>
                <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalColleges</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
            </a>
            <a asp-controller="Program" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-center gap-3"><div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Program List</span></div>
                <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalPrograms</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
            </a>
            <a asp-controller="Subject" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-center gap-3"><div class="w-9 h-9 bg-teal-100 rounded-lg flex items-center justify-center"><i class="fas fa-book text-teal-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Subject Catalog</span></div>
                <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalSubjects</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
            </a>
            <a asp-controller="ExamSchedule" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-center gap-3"><div class="w-9 h-9 bg-orange-100 rounded-lg flex items-center justify-center"><i class="fas fa-calendar-alt text-orange-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Exam Schedules</span></div>
                <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalExamSchedules</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
            </a>
            <a asp-controller="AcademicYear" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-center gap-3"><div class="w-9 h-9 bg-pink-100 rounded-lg flex items-center justify-center"><i class="fas fa-calendar text-pink-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Academic Years</span></div>
                <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalAcademicYears</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
            </a>
        </div>
    </div>

    <!-- Summary Overview -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center gap-3 mb-3"><div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center"><i class="fas fa-layer-group text-gray-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Batches</span></div>
            <p class="text-3xl font-bold text-gray-800">@Model.TotalBatches</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center gap-3 mb-3"><div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center"><i class="fas fa-university text-gray-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Boards</span></div>
            <p class="text-3xl font-bold text-gray-800">@Model.TotalBoards</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center gap-3 mb-3"><div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center"><i class="fas fa-piggy-bank text-gray-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Banks</span></div>
            <p class="text-3xl font-bold text-gray-800">@Model.TotalBanks</p>
        </div>
    </div>
</div>
