@model DashboardViewModel

@{
    ViewData["Title"] = "System Admin Dashboard";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-tachometer-alt text-blue-600"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">System Admin Dashboard</h1>
                <p class="text-sm text-gray-500 mt-0.5">Complete system overview and management</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <div class="relative">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Search anything..."
                       class="pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white w-48 sm:w-64" />
            </div>
        </div>
    </div>

    <!-- Statistics Cards Row 1 - Core -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Tenants</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalTenants</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-building text-blue-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check-circle mr-1"></i>All registered</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Users</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalUsers</p>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-users text-green-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-arrow-up mr-1"></i>System users</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Roles</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalRoles</p>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-user-shield text-purple-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3"><span class="text-xs text-blue-600 font-medium"><i class="fas fa-shield-alt mr-1"></i>Access levels</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Colleges</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalColleges</p>
                    </div>
                    <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-school text-amber-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActiveColleges active</span></div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
            <div class="p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Students</p>
                        <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalStudents</p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-user-graduate text-red-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-3"><span class="text-xs text-green-600 font-medium"><i class="fas fa-check mr-1"></i>@Model.ActiveStudents active</span></div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Row 2 - Academic -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Programs</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalPrograms</p>
                </div>
                <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-graduation-cap text-indigo-600"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Subjects</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalSubjects</p>
                </div>
                <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-book text-teal-600"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Exam Schedules</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalExamSchedules</p>
                </div>
                <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-calendar-alt text-orange-600"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Academic Years</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalAcademicYears</p>
                </div>
                <div class="w-10 h-10 bg-pink-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-calendar text-pink-600"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Exam Registrations</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@Model.TotalExamRegistrations</p>
                </div>
                <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-clipboard-list text-cyan-600"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- System Status + Quick Actions -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- System Status -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">System Status</h3>
                <p class="text-sm text-gray-500 mt-1">Current system health</p>
            </div>
            <div class="p-6 space-y-5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 bg-green-100 rounded-full flex items-center justify-center"><i class="fas fa-database text-green-600 text-sm"></i></div>
                        <div><p class="text-sm font-medium text-gray-800">Database</p><p class="text-xs text-gray-500">Operational</p></div>
                    </div>
                    <span class="w-3 h-3 bg-green-500 rounded-full"></span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 bg-green-100 rounded-full flex items-center justify-center"><i class="fas fa-cloud text-green-600 text-sm"></i></div>
                        <div><p class="text-sm font-medium text-gray-800">API Services</p><p class="text-xs text-gray-500">Operational</p></div>
                    </div>
                    <span class="w-3 h-3 bg-green-500 rounded-full"></span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 bg-green-100 rounded-full flex items-center justify-center"><i class="fas fa-key text-green-600 text-sm"></i></div>
                        <div><p class="text-sm font-medium text-gray-800">Identity Service</p><p class="text-xs text-gray-500">Operational</p></div>
                    </div>
                    <span class="w-3 h-3 bg-green-500 rounded-full"></span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 bg-blue-100 rounded-full flex items-center justify-center"><i class="fas fa-shield-alt text-blue-600 text-sm"></i></div>
                        <div><p class="text-sm font-medium text-gray-800">Backup System</p><p class="text-xs text-gray-500">Up to date</p></div>
                    </div>
                    <span class="w-3 h-3 bg-blue-500 rounded-full"></span>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">Quick Actions</h3>
                <p class="text-sm text-gray-500 mt-1">Frequently used management features</p>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                    <a asp-controller="Tenant" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-blue-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-blue-100 group-hover:bg-blue-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-building text-xl text-blue-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-blue-700 text-center">New Tenant</span>
                    </a>
                    <a asp-controller="User" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-green-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-green-100 group-hover:bg-green-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-user-plus text-xl text-green-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-green-700 text-center">New User</span>
                    </a>
                    <a asp-controller="Role" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-purple-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-purple-100 group-hover:bg-purple-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-shield-alt text-xl text-purple-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-purple-700 text-center">New Role</span>
                    </a>
                    <a asp-area="Colleges" asp-controller="Colleges" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-amber-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-amber-100 group-hover:bg-amber-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-school text-xl text-amber-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-amber-700 text-center">New College</span>
                    </a>
                    <a asp-area="Core" asp-controller="Programs" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-indigo-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-indigo-100 group-hover:bg-indigo-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-graduation-cap text-xl text-indigo-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-indigo-700 text-center">New Program</span>
                    </a>
                    <a asp-controller="AcademicYear" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-pink-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-pink-100 group-hover:bg-pink-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-calendar text-xl text-pink-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-pink-700 text-center">New Academic Year</span>
                    </a>
                    <a asp-controller="ExamSchedule" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-orange-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-orange-100 group-hover:bg-orange-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-calendar-alt text-xl text-orange-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-orange-700 text-center">New Exam Schedule</span>
                    </a>
                    <a asp-controller="Subject" asp-action="Create" class="group flex flex-col items-center justify-center p-4 bg-gray-50 rounded-lg hover:bg-teal-50 hover:shadow-md transition-all duration-200">
                        <div class="w-12 h-12 bg-teal-100 group-hover:bg-teal-200 rounded-full flex items-center justify-center mb-3 transition-colors"><i class="fas fa-book text-xl text-teal-600"></i></div>
                        <span class="text-xs font-medium text-gray-700 group-hover:text-teal-700 text-center">New Subject</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Sections -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div><h3 class="text-lg font-semibold text-gray-800">Entity Management</h3><p class="text-sm text-gray-500 mt-1">Quick access to all modules</p></div>
                </div>
            </div>
            <div class="divide-y divide-gray-100">
                <a asp-controller="Tenant" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-blue-100 rounded-lg flex items-center justify-center"><i class="fas fa-building text-blue-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Tenants</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalTenants</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
                <a asp-area="Colleges" asp-controller="Colleges" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-amber-100 rounded-lg flex items-center justify-center"><i class="fas fa-school text-amber-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Colleges</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalColleges</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
                <a asp-area="Core" asp-controller="Programs" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Programs</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalPrograms</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
                <a asp-controller="Subject" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-teal-100 rounded-lg flex items-center justify-center"><i class="fas fa-book text-teal-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Subjects</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalSubjects</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
                <a asp-controller="AcademicYear" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-pink-100 rounded-lg flex items-center justify-center"><i class="fas fa-calendar text-pink-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Academic Years</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalAcademicYears</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div><h3 class="text-lg font-semibold text-gray-800">Examination Management</h3><p class="text-sm text-gray-500 mt-1">Exam-related modules</p></div>
                </div>
            </div>
            <div class="divide-y divide-gray-100">
                <a asp-controller="ExamSchedule" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-orange-100 rounded-lg flex items-center justify-center"><i class="fas fa-calendar-alt text-orange-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Exam Schedules</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalExamSchedules</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
                <a asp-controller="User" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-green-100 rounded-lg flex items-center justify-center"><i class="fas fa-users text-green-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Users</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalUsers</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
                <a asp-controller="Role" asp-action="Index" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-purple-100 rounded-lg flex items-center justify-center"><i class="fas fa-user-shield text-purple-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Roles</span></div>
                    <div class="flex items-center gap-2"><span class="text-sm font-semibold text-gray-800">@Model.TotalRoles</span><i class="fas fa-chevron-right text-gray-400 text-xs"></i></div>
                </a>
                <div class="flex items-center justify-between p-4">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-cyan-100 rounded-lg flex items-center justify-center"><i class="fas fa-clipboard-list text-cyan-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Exam Registrations</span></div>
                    <span class="text-sm font-semibold text-gray-800">@Model.TotalExamRegistrations</span>
                </div>
                <div class="flex items-center justify-between p-4">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 bg-red-100 rounded-lg flex items-center justify-center"><i class="fas fa-user-graduate text-red-600 text-sm"></i></div><span class="text-sm font-medium text-gray-700">Student Registrations</span></div>
                    <span class="text-sm font-semibold text-gray-800">@Model.TotalStudents</span>
                </div>
            </div>
        </div>
    </div>
</div>
