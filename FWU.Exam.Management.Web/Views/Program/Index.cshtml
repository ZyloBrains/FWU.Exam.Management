@model IEnumerable<fwu_examination_management_system.Models.CProgram>
@{ ViewData["Title"] = "Programs"; var totalCount = Model.Count(); }

<div class="space-y-6" x-data="{ search: '', get filtered() { return this.search.toLowerCase(); } }">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600"></i></div>
            <div><h1 class="text-2xl font-bold text-gray-800">Programs</h1><p class="text-sm text-gray-500 mt-0.5"><span class="font-semibold text-gray-700">@totalCount</span> total records</p></div>
        </div>
        @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
        { <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm"><i class="fas fa-plus text-xs"></i> Create New</a> }
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1"><i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i><input type="text" x-model="search" placeholder="Search by program name..." class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" /></div>
            <button x-show="search.length > 0" x-on:click="search = ''" class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"><i class="fas fa-times text-xs"></i> Clear</button>
        </div>
    </div>

    <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Program Name</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Short Name</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Duration</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors" x-show="search === '' || '@item.ProgramName?.ToLower()'.includes(filtered)" x-transition>
                        <td class="px-6 py-4 font-medium text-gray-800">@item.ProgramName</td>
                        <td class="px-6 py-4"><span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 text-indigo-700 rounded">@(item.ShortName ?? "—")</span></td>
                        <td class="px-6 py-4 text-gray-600">@item.Duration yrs</td>
                        <td class="px-6 py-4">@if (item.IsActive) { <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span> } else { <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span> }</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-colors" title="Details"><i class="fas fa-eye text-xs"></i></a>
                                @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors" title="Edit"><i class="fas fa-edit text-xs"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete"><i class="fas fa-trash text-xs"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="md:hidden space-y-3">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4" x-show="search === '' || '@item.ProgramName?.ToLower()'.includes(filtered)" x-transition>
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-3"><div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center"><i class="fas fa-graduation-cap text-indigo-600 text-sm"></i></div><div><h3 class="font-semibold text-gray-800 text-sm">@item.ProgramName</h3><p class="text-xs text-gray-500">@item.Duration yrs</p></div></div>
                    @if (item.IsActive) { <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded">Active</span> } else { <span class="px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700 rounded">Inactive</span> }
                </div>
                <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
                    <a asp-action="Details" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors">Details</a>
                    @if (User.IsInRole("SystemAdmin") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="flex-1 text-center py-2 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors">Delete</a>
                    }
                </div>
            </div>
        }
    </div>
</div>
