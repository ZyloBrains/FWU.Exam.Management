@model fwu_examination_management_system.Models.Programs
@{
    ViewData["Title"] = "Edit Program";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-graduation-cap text-indigo-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit Program</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-5">
            <input type="hidden" asp-for="ProgramsId" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <!-- Section: Basic Info -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ProgramName" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="ProgramName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm
                               focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="ProgramName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ShortName" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="ShortName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm
                               focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="ShortName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="LevelId" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="LevelId" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm
                               focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="LevelId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="FacultyId" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="FacultyId" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm
                               focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="FacultyId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Duration" class="text-sm font-medium text-gray-700"></label>
                        <input asp-for="Duration" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm
                               focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Duration" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Status -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Status</h2>
                <div class="flex items-center gap-3 pt-2">
                    <input asp-for="IsActive" type="checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                    <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
