@model fwu_examination_management_system.Models.Programs
@{ ViewData["Title"] = "Delete Program"; }
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left text-gray-600"></i></a>
        <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center"><i class="fas fa-trash text-red-600"></i></div>
        <h1 class="text-2xl font-bold text-gray-800">Delete Program</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-red-200 p-8">
        <div class="bg-red-50 border-2 border-red-200 rounded-lg p-4 mb-6"><p class="text-sm font-semibold text-red-700"><i class="fas fa-exclamation-triangle mr-2"></i>Are you sure you want to delete this program? This action cannot be undone.</p></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
            <div class="detail-field"><p class="field-label">Name</p><p class="field-value">@Model.ProgramName</p></div>
            <div class="detail-field"><p class="field-label">Duration</p><p class="field-value">@Model.Duration years</p></div>
        </div>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ProgramId" />
            <div class="flex items-center gap-3 pt-6 border-t border-gray-200">
                <button type="submit" class="px-6 py-3 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition-colors shadow-sm"><i class="fas fa-trash mr-2"></i>Delete</button>
                <a asp-action="Index" class="px-6 py-3 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
