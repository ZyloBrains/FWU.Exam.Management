@model List<Tenant>
@{
    ViewData["Title"] = "Select Organization";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FWU Examination System</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link href="~/lib/fonts/poppins.css" asp-append-version="true" rel="stylesheet" />
</head>
<body class="bg-gray-50 font-poppins antialiased">
<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full">
        <div class="text-center mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Far Western University</h1>
            <p class="mt-2 text-gray-600">Examination Management System</p>
        </div>

        @await Html.PartialAsync("_AlertMessages")

        <!-- Entrance Application Card -->
        <div class="mb-6">
            <a href="/Exams/Entrance/AvailableSchedules"
               class="block bg-gradient-to-r from-teal-500 to-cyan-600 rounded-2xl p-6 text-white hover:from-teal-600 hover:to-cyan-700 transition-all shadow-lg">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center">
                            <i class="fas fa-graduation-cap text-2xl"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold">Entrance Application</h2>
                            <p class="text-teal-100 text-sm mt-0.5">First step toward student registration - Apply now!</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-white text-teal-700 text-sm font-semibold rounded-lg">
                        Apply Now <i class="fas fa-arrow-right text-xs"></i>
                    </span>
                </div>
            </a>
        </div>

        <div class="relative mb-6">
            <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200"></div></div>
            <div class="relative flex justify-center"><span class="bg-gray-50 px-3 text-xs sm:text-sm text-gray-400">Admin Login</span></div>
        </div>

        <div class="grid gap-4">
            @foreach (var tenant in Model)
            {
                <a href="/tenant/@tenant.OfficeCode/Home/Index"
                   class="block bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-blue-400 transition-all duration-200">
                    <div class="flex items-center gap-4">
                        @if (!string.IsNullOrEmpty(tenant.LogoPath))
                        {
                            <img src="@tenant.LogoPath" alt="@tenant.Name" class="w-14 h-14 rounded-lg object-contain bg-gray-50" />
                        }
                        else
                        {
                            <div class="w-14 h-14 rounded-lg bg-blue-100 flex items-center justify-center text-xl font-bold text-blue-700">
                                @tenant.Name?.Substring(0, 1)
                            </div>
                        }
                        <div class="flex-1">
                            <h2 class="text-base sm:text-lg font-semibold text-gray-900">@tenant.Name</h2>
                            <p class="text-xs sm:text-sm text-gray-500">@tenant.OfficeCode</p>
                        </div>
                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-600 text-xs font-medium rounded-lg hover:bg-blue-100 hover:text-blue-700 transition">
                            <i class="fas fa-lock"></i> Admin
                        </span>
                    </div>
                </a>

                <a href="/tenant/@tenant.OfficeCode/Exams/Entrance/AvailableSchedules"
                   class="block bg-gradient-to-r from-teal-50 to-cyan-50 rounded-xl border border-teal-200 p-6 hover:shadow-md hover:border-teal-400 transition-all duration-200 -mt-3">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-lg bg-gradient-to-br from-teal-500 to-cyan-500 flex items-center justify-center text-xl text-white shadow-sm">
                            <i class="fas fa-file-alt"></i>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-base sm:text-lg font-semibold text-teal-800">Entrance Application</h2>
                            <p class="text-sm text-teal-600">Apply for admission - @tenant.Name</p>
                        </div>
                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-teal-100 text-teal-700 text-xs font-medium rounded-lg">
                            <i class="fas fa-external-link-alt"></i> Open
                        </span>
                    </div>
                </a>
            }
        </div>
    </div>
</div>
</body>
</html>
