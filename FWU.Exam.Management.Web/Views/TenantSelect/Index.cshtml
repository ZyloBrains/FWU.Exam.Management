@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Select Faculty";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 px-4">
    <div class="w-full max-w-2xl">
        <div class="text-center mb-8">
            <div class="w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                <i class="fas fa-graduation-cap text-3xl text-white"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-800">Welcome to FWU Examination System</h1>
            <p class="text-gray-500 mt-2">Please select your faculty to continue</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-700">
                    <i class="fas fa-university mr-2 text-blue-500"></i>Faculties
                </h2>
            </div>
            <div class="divide-y divide-gray-100">
                @foreach (var faculty in Model)
                {
                    <a href="/tenant/@faculty.OfficeCode/Identity/Account/Login"
                       class="flex items-center gap-4 px-6 py-4 hover:bg-blue-50 transition-colors duration-200 group">
                        <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                            <span class="text-xl font-bold text-blue-600">@faculty.Name[0]</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-gray-800 group-hover:text-blue-600 transition-colors truncate">
                                @faculty.Name
                            </h3>
                            @if (!string.IsNullOrEmpty(@faculty.Address))
                            {
                                <p class="text-sm text-gray-500 truncate">@faculty.Address</p>
                            }
                        </div>
                        <div class="shrink-0">
                            <span class="inline-block px-3 py-1 text-xs font-semibold text-blue-600 bg-blue-50 rounded-full">
                                @faculty.OfficeCode
                            </span>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 group-hover:text-blue-500 transition-colors"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
