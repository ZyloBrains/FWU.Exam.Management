@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Sign In";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 px-4 py-8"
     x-data="{ selected: null, officeCode: '', email: '', password: '', loading: false }">
    <div class="w-full max-w-lg">
        <div class="text-center mb-8">
            <div class="w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                <i class="fas fa-graduation-cap text-3xl text-white"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-800">FWU Examination System</h1>
            <p class="text-gray-500 mt-2" x-show="!selected">Select your faculty to sign in</p>
        </div>

        <template x-if="!selected">
            <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-700">
                        <i class="fas fa-university mr-2 text-blue-500"></i>Select Faculty
                    </h2>
                </div>
                <div class="divide-y divide-gray-100">
                    @foreach (var tenant in Model)
                    {
                        <button @@click="selected = '@tenant.Name'; officeCode = '@tenant.OfficeCode'"
                                class="w-full flex items-center gap-4 px-6 py-4 hover:bg-blue-50 transition-colors duration-200 group text-left">
                            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-blue-200 transition-colors shrink-0">
                                <span class="text-xl font-bold text-blue-600">@tenant.Name[0]</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="font-semibold text-gray-800 group-hover:text-blue-600 transition-colors truncate">
                                    @tenant.Name
                                </h3>
                                @if (!string.IsNullOrEmpty(@tenant.Address))
                                {
                                    <p class="text-sm text-gray-500 truncate">@tenant.Address</p>
                                }
                            </div>
                            <span class="inline-block px-3 py-1 text-xs font-semibold text-blue-600 bg-blue-50 rounded-full shrink-0">
                                @tenant.OfficeCode
                            </span>
                            <i class="fas fa-chevron-right text-gray-300 group-hover:text-blue-500 transition-colors shrink-0"></i>
                        </button>
                    }
                </div>
            </div>
        </template>

        <template x-if="selected">
            <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                    <h2 class="text-lg font-semibold text-gray-700">
                        <i class="fas fa-sign-in-alt mr-2 text-blue-500"></i>Sign In
                    </h2>
                    <button @@click="selected = null; officeCode = ''; email = ''; password = ''"
                            class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
                        &larr; Change faculty
                    </button>
                </div>
                <div class="p-6">
                    <div class="mb-4 flex items-center gap-3 p-3 bg-blue-50 rounded-lg">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center shrink-0">
                            <span class="text-lg font-bold text-blue-600" x-text="selected[0]"></span>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800 text-sm" x-text="selected"></p>
                            <p class="text-xs text-gray-500" x-text="officeCode"></p>
                        </div>
                    </div>

                    <form method="post" x-bind:action="`/tenant/${officeCode}/Identity/Account/Login`"
                          @@submit="loading = true">
                        @Html.AntiForgeryToken()

                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                <input type="email" name="Input.Email" x-model="email" required
                                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
                                       placeholder="your@email.com">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                                <input type="password" name="Input.Password" x-model="password" required
                                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
                                       placeholder="Enter your password">
                            </div>

                            <div class="flex items-center gap-2">
                                <input type="checkbox" name="Input.RememberMe" id="rememberMe"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <label for="rememberMe" class="text-sm text-gray-600">Remember me</label>
                            </div>

                            <button type="submit" x-bind:disabled="loading"
                                    class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 text-white font-semibold rounded-lg transition-colors duration-200 flex items-center justify-center gap-2">
                                <i class="fas fa-sign-in-alt" x-show="!loading"></i>
                                <i class="fas fa-spinner fa-spin" x-show="loading"></i>
                                <span x-text="loading ? 'Signing in...' : 'Sign In'"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </template>
    </div>
</div>
