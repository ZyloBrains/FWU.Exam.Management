    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<fwu_examination_management_system.Data.Models.Colleges.College>

@{
    Layout = null; // No layout for PDF export
    var title = "Colleges Report";
    var generatedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11px;
            margin: 20px;
            color: #333;
        }
        h1 {
            font-size: 18px;
            margin-bottom: 5px;
            color: #1e40af;
        }
        .report-header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #3b82f6;
            padding-bottom: 10px;
        }
        .report-date {
            font-size: 10px;
            color: #666;
            margin-top: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 10px;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 6px 8px;
            text-align: left;
            vertical-align: top;
        }
        th {
            background-color: #f2f2f2;
            font-weight: bold;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .active-badge {
            color: green;
            font-weight: bold;
        }
        .inactive-badge {
            color: red;
            font-weight: bold;
        }
        .exam-center-badge {
            color: purple;
            font-weight: bold;
        }
        .footer {
            margin-top: 30px;
            font-size: 10px;
            text-align: center;
            color: #666;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }
        .summary {
            margin-bottom: 15px;
            padding: 10px;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 4px;
            font-size: 11px;
        }
        .summary-item {
            display: inline-block;
            margin-right: 20px;
        }
        .summary-label {
            font-weight: bold;
            color: #4b5563;
        }
        .summary-value {
            color: #1f2937;
            margin-left: 5px;
        }
        @@media print {
            body {
                margin: 0;
                padding: 10px;
            }
            .no-print {
                display: none;
            }
            th {
                background-color: #f2f2f2;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .active-badge, .inactive-badge, .exam-center-badge {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="report-header">
        <h1>🏛️ @title</h1>
        <div class="report-date">Generated on: @generatedDate</div>
    </div>

    <div class="summary">
        <span class="summary-item">
            <span class="summary-label">Total Colleges:</span>
            <span class="summary-value">@Model.Count()</span>
        </span>
        <span class="summary-item">
            <span class="summary-label">Active:</span>
            <span class="summary-value">@Model.Count(x => x.IsActive)</span>
        </span>
        <span class="summary-item">
            <span class="summary-label">Inactive:</span>
            <span class="summary-value">@Model.Count(x => !x.IsActive)</span>
        </span>
        <span class="summary-item">
            <span class="summary-label">Exam Centers Only:</span>
            <span class="summary-value">@Model.Count(x => x.IsExamCenterOnly)</span>
        </span>
    </div>

    <table>
        <thead>
            <tr>
                <th>Code</th>
                <th>College Name</th>
                <th>Name (Nepali)</th>
                <th>Short Name</th>
                <th>District</th>
                @* <th>Municipality/VDC</th> *@
                <th>Ward No.</th>
                <th>House No.</th>
                <th>Phone 1</th>
                <th>Phone 2</th>
                <th>Email</th>
                <th>Website</th>
                <th>Principal Name</th>
                <th>Principal Contact</th>
                <th>Fax</th>
                <th>College Type</th>
                <th>Area</th>
                <th>Established Date</th>
                <th>Closed Date</th>
                <th>Allocated Amount</th>
                <th>Display Order</th>
                <th>Exam Center</th>
                <th>Status</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@(string.IsNullOrEmpty(item.CollegeNameNepali) ? "—" : item.CollegeNameNepali)</td>
                    <td>@(string.IsNullOrEmpty(item.ShortName) ? "—" : item.ShortName)</td>
                    <td>@(item.Address?.LocalLevel?.District?.DistrictName ?? "—")</td>
                    <td>@(item.Address?.LocalLevel?.LocalLevelName ?? "—")</td>
                    <td>@(item.Address?.WardNumber?.ToString() ?? "—")</td>
                    <td>@(item.Address?.HouseNumber ?? "—")</td>
                    <td>@(string.IsNullOrEmpty(item.Phone1) ? "—" : item.Phone1)</td>
                    <td>@(string.IsNullOrEmpty(item.Phone2) ? "—" : item.Phone2)</td>
                    <td>@(string.IsNullOrEmpty(item.Email) ? "—" : item.Email)</td>
                    <td>@(string.IsNullOrEmpty(item.Website) ? "—" : item.Website)</td>
                    <td>@(string.IsNullOrEmpty(item.PrincipalName) ? "—" : item.PrincipalName)</td>
                    <td>@(string.IsNullOrEmpty(item.PrincipalContactNumber) ? "—" : item.PrincipalContactNumber)</td>
                    <td>@(string.IsNullOrEmpty(item.Fax) ? "—" : item.Fax)</td>
                    <td>@(item.CollegeType?.Code ?? "—")</td>
                    <td>@(item.Address?.ToleStreet ?? "—")</td>
                    <td>@(item.EstablishedDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>@(item.ClosedDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td style="text-align: right;">@(item.AllocatedAmount.HasValue ? item.AllocatedAmount.Value.ToString("N2") : "—")</td>
                    <td style="text-align: center;">@item.DisplayOrder</td>
                    <td>
                        @if (item.IsExamCenterOnly)
                        {
                            <span class="exam-center-badge">✓ Yes</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="active-badge">● Active</span>
                        }
                        else
                        {
                            <span class="inactive-badge">○ Inactive</span>
                        }
                    </td>
                    <td>@(string.IsNullOrEmpty(item.Remarks) ? "—" : item.Remarks)</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 40px; color: #999;">
            No college records found.
        </div>
    }

    <div class="footer">
        <p>This is a system-generated report from Examination Management System.</p>
        <p>© @DateTime.Now.Year - All Rights Reserved</p>
    </div>

    <script>
        // Auto-trigger print dialog when page loads
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>