@model fwu_examination_management_system.Models.SubjectDetail
@{
    ViewData["Title"] = "Edit Subject";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index"
           class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>

        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-book text-teal-600"></i>
        </div>

        <h1 class="text-2xl font-bold text-gray-800">Edit Subject</h1>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8 form-card">

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-red-600 text-sm bg-red-50 p-2 rounded-lg mb-6"></div>

            <input type="hidden" asp-for="SubjectDetailId" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <div>
                    <label asp-for="SubjectCode" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="SubjectCode"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="SubjectCode" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="SubjectName" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="SubjectName"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="SubjectName" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ShortName" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="ShortName"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="ProgramsId" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="ProgramsId" type="number"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="YearPartId" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="YearPartId" type="number"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="SubjectTypeId" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="SubjectTypeId" type="number"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="TheoryFullMarks" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="TheoryFullMarks" type="number" step="0.01"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="TheoryPassMarks" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="TheoryPassMarks" type="number" step="0.01"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="PracticalFullMarks" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="PracticalFullMarks" type="number" step="0.01"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="PracticalPassMarks" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="PracticalPassMarks" type="number" step="0.01"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="CreditHours" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="CreditHours" type="number"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label asp-for="DisplayOrder" class="text-sm font-medium text-gray-700"></label>
                    <input asp-for="DisplayOrder" type="number"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Remarks" class="text-sm font-medium text-gray-700"></label>
                    <textarea asp-for="Remarks" rows="3"
                              class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                </div>

                <!-- Checkboxes -->
                <div class="flex items-center gap-6 md:col-span-2 flex-wrap pt-2">

                    <div class="flex items-center gap-3">
                        <input asp-for="HasTheory" type="checkbox" class="text-blue-600" />
                        <label asp-for="HasTheory" class="text-sm font-medium text-gray-700"></label>
                    </div>

                    <div class="flex items-center gap-3">
                        <input asp-for="HasPractical" type="checkbox" class="text-blue-600" />
                        <label asp-for="HasPractical" class="text-sm font-medium text-gray-700"></label>
                    </div>

                    <div class="flex items-center gap-3">
                        <input asp-for="HasInternal" type="checkbox" class="text-blue-600" />
                        <label asp-for="HasInternal" class="text-sm font-medium text-gray-700"></label>
                    </div>

                    <div class="flex items-center gap-3">
                        <input asp-for="IsCompulsory" type="checkbox" class="text-blue-600" />
                        <label asp-for="IsCompulsory" class="text-sm font-medium text-gray-700"></label>
                    </div>

                    <div class="flex items-center gap-3">
                        <input asp-for="IsActive" type="checkbox" class="text-blue-600" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700"></label>
                    </div>

                </div>
            </div>

            <!-- Buttons -->
            <div class="flex items-center gap-4 mt-8 pt-6 border-t border-gray-200">

                <button type="submit"
                        class="px-6 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Save Changes
                </button>

                <a asp-action="Index"
                   class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}