@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject fwu_examination_management_system.Data.ApplicationDbContext DbContext

@{
    var sideMenuUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var sideMenuRoles = sideMenuUser != null ? await UserManager.GetRolesAsync(sideMenuUser) : new List<string>();
    var primaryRole = sideMenuRoles.Contains("SystemAdmin") ? "SystemAdmin"
        : sideMenuRoles.Contains("Admin") ? "Admin"
        : sideMenuRoles.Contains("CollegeAdmin") ? "CollegeAdmin"
        : sideMenuRoles.Contains("ReportAdmin") ? "ReportAdmin"
        : sideMenuRoles.Contains("Student") ? "Student"
        : "";
    var isSystemAdmin = primaryRole == "SystemAdmin";
    var isAdmin = primaryRole == "Admin";
    var isCollegeAdmin = sideMenuRoles.Contains("CollegeAdmin");
    var isReportAdmin = primaryRole == "ReportAdmin";
    var isStudent = primaryRole == "Student";
    var collegeOfficeCode = string.Empty;

    if (sideMenuUser?.OrganizationId != null)
    {
        collegeOfficeCode = (await DbContext.Organizations.FindAsync(sideMenuUser.OrganizationId.Value))?.OfficeCode ?? string.Empty;
    }
}

