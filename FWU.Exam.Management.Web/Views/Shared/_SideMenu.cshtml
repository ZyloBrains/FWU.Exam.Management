@using System.Text.Json
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using FWU.Exam.Management.Application.Interfaces
@using FWU.Exam.Management.Web.Navigation
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    // Helper to detect active route (works for both MVC and Razor Pages)
    bool IsActive(string? controllerName = null, string? actionName = null, string? areaName = null, string? page = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

        if (!string.IsNullOrEmpty(page))
        {
            return string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrEmpty(areaName) && !string.Equals(currentArea, areaName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(controllerName) && !string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(actionName) && !string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    Func<bool, string> ParentClass = (active) => active
        ? "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl bg-white/[0.12] text-white font-semibold shadow-sm backdrop-blur-sm ring-1 ring-white/10 transition-all duration-200"
        : "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-blue-200 hover:bg-white/[0.07] hover:text-white hover:ring-1 hover:ring-white/[0.06] transition-all duration-200";

    Func<bool, string> ChildClass = (active) => active
        ? "flex items-center gap-3 px-4 py-2.5 rounded-lg bg-white/[0.12] text-white font-medium text-sm shadow-sm backdrop-blur-sm ring-1 ring-white/10 transition-all duration-200"
        : "flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-200 hover:bg-white/[0.07] hover:text-white hover:ring-1 hover:ring-white/[0.06] text-sm transition-all duration-200";

    // Get user and permissions
    var sideMenuUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isSuperAdmin = sideMenuUser != null && await UserManager.IsInRoleAsync(sideMenuUser, Role.SuperAdmin);

    // Get permissions for the current user
    var sideMenuPermissions = sideMenuUser != null
        ? await PermissionService.GetUserPermissionsAsync(sideMenuUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => isSuperAdmin || sideMenuPermissions.Contains(permission);

    var sideMenuRoles = sideMenuUser != null ? await UserManager.GetRolesAsync(sideMenuUser) : new List<string>();

    bool ItemVisible(MenuItem item) => item.Permissions.Length == 0 || item.Permissions.Any(HasPerm);

    bool SectionVisible(MenuSection section)
    {
        if (section.HideFromStudents && !isSuperAdmin && sideMenuRoles.Contains(Role.Student)) return false;
        if (section.SingleLink) return true;
        if (section.SuperAdminOnly && !isSuperAdmin) return false;
        if (section.RoleGate != null && !isSuperAdmin && !sideMenuRoles.Contains(section.RoleGate)) return false;
        return section.Items.Any(ItemVisible);
    }

    bool ItemActive(MenuItem item)
    {
        var routes = item.ActiveOns?.Length > 0 ? item.ActiveOns : [item.Target];
        return routes.Any(r => IsActive(controllerName: r.Controller, actionName: r.Action, areaName: r.Area, page: r.Page));
    }

    bool SectionActive(MenuSection section)
    {
        if (section.SingleLink && section.Items.Length > 0) return ItemActive(section.Items[0]);
        if (section.Items.Any(ItemActive)) return true;
        if (section.Landing != null && IsActive(controllerName: section.Landing.Controller, actionName: section.Landing.Action, areaName: section.Landing.Area)) return true;
        return (section.SectionActiveOns ?? Array.Empty<MenuRoute>()).Any(r => IsActive(controllerName: r.Controller, actionName: r.Action, areaName: r.Area, page: r.Page));
    }

    string ItemUrl(MenuItem item) => Url.Action(item.Target.Action, item.Target.Controller, new { area = item.Target.Area })!;

    string? SectionHeaderUrl(MenuSection section) =>
        section.SingleLink ? ItemUrl(section.Items[0])
        : section.Landing != null ? Url.Action(section.Landing.Action, section.Landing.Controller, new { area = section.Landing.Area })
        : null;

    var visibleSections = AppMenu.Sections.Where(SectionVisible).ToList();

    // Search index for the command palette. Built from the same single-source
    // menu definition and permission filters as the sidebar above.
    var searchMenuItems = new List<object>();

    void AddMenuItem(string section, string label, string? url, string icon, params string[] aliases)
    {
        searchMenuItems.Add(new { section, label, url = url ?? "", icon, aliases });
    }

    foreach (var menuSection in visibleSections)
    {
        foreach (var item in menuSection.Items.Where(ItemVisible))
        {
            AddMenuItem(menuSection.Title, item.Label, ItemUrl(item), item.Icon, item.Aliases);
        }
    }
}

<ul class="space-y-1.5 px-3 font-poppins">
    @foreach (var menuSection in visibleSections)
    {
        @if (menuSection.SingleLink)
        {
            var item = menuSection.Items[0];
            <li>
                <a href="@ItemUrl(item)" class="@ParentClass(SectionActive(menuSection))">
                    <div class="flex items-center justify-center w-6">
                        <i class="fas @item.Icon text-lg opacity-80"></i>
                    </div>
                    <span class="flex-1 text-left tracking-wide">@menuSection.Title</span>
                </a>
            </li>
        }
        else
        {
            var sectionActive = SectionActive(menuSection);
            var visibleItems = menuSection.Items.Where(ItemVisible).ToList();
            var maxHeight = Math.Max(300, visibleItems.Count * 52 + 40);
            <li x-data="{ open: @(sectionActive.ToString().ToLower()) }">
                <div class="flex items-center @(sectionActive ? ParentClass(true) : ParentClass(false).Replace(" rounded-xl", ""))">
                    @if (SectionHeaderUrl(menuSection) is string headerUrl)
                    {
                        <a href="@headerUrl" class="flex items-center gap-3.5 flex-1 min-w-0">
                            <div class="flex items-center justify-center w-6"><i class="fas @menuSection.Icon text-lg opacity-80"></i></div>
                            <span class="flex-1 text-left tracking-wide whitespace-nowrap">@menuSection.Title</span>
                        </a>
                    }
                    else
                    {
                        <a href="javascript:void(0)" class="flex items-center gap-3.5 flex-1 min-w-0" @@click.prevent.stop="open = !open">
                            <div class="flex items-center justify-center w-6"><i class="fas @menuSection.Icon text-lg opacity-80"></i></div>
                            <span class="flex-1 text-left tracking-wide whitespace-nowrap">@menuSection.Title</span>
                        </a>
                    }
                    <button @@click.stop="open = !open" class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-white/10 transition-colors shrink-0">
                        <i class="fas transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
                    </button>
                </div>
                <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                    :style="open ? 'max-height: @(maxHeight)px; opacity: 1' : 'max-height: 0; opacity: 0'">
                    @foreach (var item in visibleItems)
                    {
                        <li>
                            <a href="@ItemUrl(item)" class="@ChildClass(ItemActive(item))"><i class="fas @item.Icon w-4 text-center opacity-70"></i><span class="whitespace-nowrap">@item.Label</span></a>
                        </li>
                    }
                </ul>
            </li>
        }
    }
</ul>

<script type="application/json" id="sideMenuSearchData">
    @Html.Raw(JsonSerializer.Serialize(searchMenuItems, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    }))
</script>
