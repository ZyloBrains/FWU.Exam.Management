@using Microsoft.AspNetCore.Identity
@using FWU.Exam.Management.Application.Interfaces
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    // Helper to detect active route (works for both MVC and Razor Pages)
    bool IsActive(string? controllerName = null, string? actionName = null, string? areaName = null, string? page = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

        if (!string.IsNullOrEmpty(page))
        {
            return string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrEmpty(areaName) && !string.Equals(currentArea, areaName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(controllerName) && !string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(actionName) && !string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    Func<bool, string> ParentClass = (active) => active 
        ? "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl bg-white/[0.12] text-white font-semibold shadow-sm backdrop-blur-sm ring-1 ring-white/10 transition-all duration-200" 
        : "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-blue-200 hover:bg-white/[0.07] hover:text-white hover:ring-1 hover:ring-white/[0.06] transition-all duration-200";

    Func<bool, string> ChildClass = (active) => active 
        ? "flex items-center gap-3 px-4 py-2.5 rounded-lg bg-white/[0.12] text-white font-medium text-sm shadow-sm backdrop-blur-sm ring-1 ring-white/10 transition-all duration-200"
        : "flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-200 hover:bg-white/[0.07] hover:text-white hover:ring-1 hover:ring-white/[0.06] text-sm transition-all duration-200";

    // Get user and permissions
    var sideMenuUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var sideMenuTenantCode = Context.Items["TenantCode"] as string;
    var isSuperAdmin = sideMenuUser != null && await UserManager.IsInRoleAsync(sideMenuUser, Role.SuperAdmin);

    // Get permissions for the current user
    var sideMenuPermissions = sideMenuUser != null
        ? await PermissionService.GetUserPermissionsAsync(sideMenuUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => isSuperAdmin || sideMenuPermissions.Contains(permission);

    // Permission-based section visibility
    var showUserMgmt = HasPerm("users.view") || HasPerm("users.create") || HasPerm("roles.view") || HasPerm("permissions.manage");
    var showAcademic = HasPerm("faculties.view") || HasPerm("programs.view") || HasPerm("semesters.view") || HasPerm("academicyears.view") ||
                       HasPerm("subjects.view") || HasPerm("subjecttypes.view") || HasPerm("subjectofferings.view") || HasPerm("curriculumversions.view");
    var showColleges = HasPerm("colleges.view") || HasPerm("collegetypes.view") || HasPerm("collegeprograms.view");
    var showRegistration = HasPerm("students.view") || HasPerm("studentcategories.view") || HasPerm("studentadmissions.view");
    var showExamination = HasPerm("examschedules.view") || HasPerm("examtypes.view") || HasPerm("entrance.view") ||
                       HasPerm("gradingschemes.view") || HasPerm("examregistrations.view") || HasPerm("examsubjectresults.view") || HasPerm("resultrecords.view") ||
                       HasPerm("examcenters.view") ||
                       HasPerm("marksentry.view");
    var showResults = HasPerm("examsubjectresults.view") || HasPerm("resultrecords.view");
    var showPayments = HasPerm("banks.view") || HasPerm("paymenttypes.view") || HasPerm("billtitles.view");
    var showLocation = HasPerm("provinces.view") || HasPerm("districts.view") || HasPerm("locallevels.view");
    var showStudentPortal = isSuperAdmin || (sideMenuUser != null && await UserManager.IsInRoleAsync(sideMenuUser, Role.Student));
    var showConfig = HasPerm("tenants.view") || HasPerm("smtp.view") || HasPerm("sms.view") || HasPerm("gumpnowemail.view") || HasPerm("esewa.view") || HasPerm("khalti.view") || HasPerm("connectips.view") || HasPerm("notices.view") || HasPerm("auditlog.view") || HasPerm("backuprestore.manage");
    var showReports = HasPerm("reports.collegepayments") || HasPerm("reports.subjectcount") || HasPerm("reports.examtriplicate") || HasPerm("reports.summary") ||
                      HasPerm("reports.tabulationtriplicate") || HasPerm("reports.programwisestudent") || HasPerm("reports.attendanceheet") || HasPerm("reports.marksfoil") ||
                      HasPerm("reports.bankvoucherlist");

    // Active state detection for sections
    var isUserActive = IsActive(controllerName: "User") || IsActive(page: "/Account/ForgotPassword") ||
                       IsActive(controllerName: "Role") || IsActive(controllerName: "RolePermissionManager", areaName: "Admin") ||
                       IsActive(controllerName: "ManagePermissions", areaName: "Admin") ||
                       IsActive(controllerName: "Section", actionName: "UserManagement");
    var isAcademicActive = IsActive(controllerName: "Faculty", areaName: "Core") ||
                            IsActive(controllerName: "Programs", areaName: "Core") ||
                            IsActive(controllerName: "Semesters", areaName: "Core") ||
                            IsActive(controllerName: "SubjectCatalogs", areaName: "Subjects") ||
                            IsActive(controllerName: "SubjectTypes", areaName: "Subjects") ||
                            IsActive(controllerName: "SubjectOfferings", areaName: "Subjects") ||
                            IsActive(controllerName: "CurriculumVersions", areaName: "Subjects") ||
                            IsActive(controllerName: "AcademicYears", areaName: "Core") ||
                            IsActive(controllerName: "Section", actionName: "AcademicSetup");
    var isCollegeActive = IsActive(controllerName: "Colleges", areaName: "Colleges") ||
                           IsActive(controllerName: "CollegeTypes", areaName: "Colleges") ||
                           IsActive(controllerName: "CollegePrograms", areaName: "Colleges") ||
                           IsActive(controllerName: "Section", actionName: "Colleges");
    var isRegActive = IsActive(controllerName: "StudentRegistrations", areaName: "Students") ||
                      IsActive(controllerName: "StudentCategories") ||
                      IsActive(controllerName: "StudentAdmissions", areaName: "Students") ||
                      IsActive(controllerName: "SemesterEnrollments", areaName: "Students") ||
                      IsActive(controllerName: "Section", actionName: "Registration");
    var isExamActive = IsActive(controllerName: "Entrance", areaName: "Exams") ||
                        IsActive(controllerName: "ExamSchedules", areaName: "Exams") ||
                        IsActive(controllerName: "ExamTypes", areaName: "Exams") ||
                        IsActive(controllerName: "GradingSchemes", areaName: "Exams") ||
                        IsActive(controllerName: "ExamRegistrations", areaName: "Exams") ||
                        IsActive(controllerName: "ExamSubjectResults", areaName: "Exams") ||
                        IsActive(controllerName: "ResultRecords", areaName: "Exams") ||
                        IsActive(controllerName: "ExamCenters", areaName: "Exams") ||
                        IsActive(controllerName: "ExamCenterDistribution", areaName: "Exams") ||
                        IsActive(controllerName: "AdmitCards", areaName: "Exams") ||
                        IsActive(controllerName: "RetotalRequests", areaName: "Exams") ||
                        IsActive(controllerName: "CollegeAdminMarks", areaName: "Exams") ||
                        IsActive(controllerName: "Section", actionName: "Examination");
    var isResultActive = IsActive(controllerName: "ExamSubjectResults", areaName: "Exams") ||
                          IsActive(controllerName: "ResultRecords", areaName: "Exams") ||
                          IsActive(controllerName: "RetotalRequests", areaName: "Exams") ||
                          IsActive(controllerName: "Section", actionName: "Results");
    var isPayActive = IsActive(controllerName: "Banks", areaName: "Payments") ||
                      IsActive(controllerName: "PaymentTypes", areaName: "Payments") ||
                      IsActive(controllerName: "BillTitles", areaName: "Payments") ||
                      IsActive(controllerName: "Section", actionName: "Payments");
    var isLocActive = IsActive(controllerName: "Provinces", areaName: "Location") ||
                      IsActive(controllerName: "Districts", areaName: "Location") ||
                      IsActive(controllerName: "LocalLevels", areaName: "Location") ||
                      IsActive(controllerName: "Section", actionName: "Location");
    var isStudentActive = IsActive(controllerName: "StudentDashboard", areaName: "Students") ||
                           IsActive(controllerName: "Section", actionName: "StudentPortal");
    var isConfigActive = IsActive(controllerName: "Tenants") ||
                          IsActive(controllerName: "SmtpConfigurations", areaName: "Core") ||
                          IsActive(controllerName: "TestEmail", areaName: "Core") ||
                          IsActive(controllerName: "GumpNowEmailConfigurations", areaName: "Core") ||
                          IsActive(controllerName: "TestGumpNowEmail", areaName: "Core") ||
                          IsActive(controllerName: "ESewaConfigurations", areaName: "Core") ||
                          IsActive(controllerName: "KhaltiConfigurations", areaName: "Core") ||
                          IsActive(controllerName: "ConnectIPSConfigurations", areaName: "Core") ||
                           IsActive(controllerName: "SmsConfigurations", areaName: "Core") ||
                           IsActive(controllerName: "TestGumpNowSms", areaName: "Core") ||
                           IsActive(controllerName: "Notices", areaName: "Core") ||
                           IsActive(controllerName: "AuditLog", areaName: "Core") ||
                           IsActive(controllerName: "BackupRestore", areaName: "Core") ||
                           IsActive(controllerName: "Section", actionName: "SystemConfig");
    var isReportActive = IsActive(controllerName: "Reports", areaName: "Reports") ||
                         IsActive(controllerName: "Section", actionName: "Reports");
    var isCoreActive = IsActive(controllerName: "Programs", areaName: "Core") ||
                       IsActive(controllerName: "AcademicYears", areaName: "Core") ||
                       IsActive(controllerName: "Levels", areaName: "Core") ||
                       IsActive(controllerName: "Genders", areaName: "Core") ||
                       IsActive(controllerName: "Ethnicities", areaName: "Core") ||
                       IsActive(controllerName: "Boards", areaName: "Core") ||
                       IsActive(controllerName: "Countries", areaName: "Core") ||
                       IsActive(controllerName: "Provinces", areaName: "Location") ||
                       IsActive(controllerName: "Districts", areaName: "Location") ||
                       IsActive(controllerName: "LocalLevels", areaName: "Location");
}

<ul class="space-y-1.5 px-3 font-poppins">
    <!-- Dashboard - Everyone -->
    <li>
        <a asp-area="" asp-controller="Dashboard" asp-action="Index" class="@ParentClass(IsActive(controllerName: "Dashboard", actionName: "Index"))">
            <div class="flex items-center justify-center w-6">
                <i class="fas fa-home text-lg opacity-80"></i>
            </div>
            <span class="flex-1 text-left tracking-wide">Dashboard</span>
        </a>
    </li>

    @if (showUserMgmt)
    {
        // ----------------------------------------------------- //
        // User Management
        // ----------------------------------------------------- //
        <li x-data="{ open: @(isUserActive.ToString().ToLower()) }">
            <div class="flex items-center @(isUserActive ? ParentClass(true) : ParentClass(false).Replace(" rounded-xl", ""))">
                <a asp-area="" asp-controller="Section" asp-action="UserManagement" class="flex items-center gap-3.5 flex-1 min-w-0">
                    <div class="flex items-center justify-center w-6"><i class="fas fa-users text-lg opacity-80"></i></div>
                    <span class="flex-1 text-left tracking-wide whitespace-nowrap">User Management</span>
                </a>
                <button @@click.stop="open = !open" class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-white/10 transition-colors shrink-0">
                    <i class="fas transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
                </button>
            </div>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 500px; opacity: 1' : 'max-height: 0; opacity: 0'">
                @if (HasPerm("users.view")) { <li><a asp-area="" asp-controller="User" asp-action="Index" class="@ChildClass(IsActive(controllerName: "User", actionName: "Index"))"><i class="fas fa-list w-4 text-center opacity-70"></i><span class="whitespace-nowrap">All Users</span></a></li> }
                @if (HasPerm("users.create")) { <li><a asp-area="" asp-controller="User" asp-action="Create" class="@ChildClass(IsActive(controllerName: "User", actionName: "Create"))"><i class="fas fa-user-plus w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Create New User</span></a></li> }
                @if (HasPerm("users.edit")) { <li><a asp-area="" asp-controller="User" asp-action="ResetPassword" class="@ChildClass(IsActive(controllerName: "User", actionName: "ResetPassword"))"><i class="fas fa-key w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Reset Password</span></a></li> }
                @if (HasPerm("roles.view")) { <li><a asp-area="" asp-controller="Role" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Role"))"><i class="fas fa-user-shield w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Roles</span></a></li> }
                @if (HasPerm("permissions.manage")) { <li><a asp-area="Admin" asp-controller="RolePermissionManager" asp-action="Index" class="@ChildClass(IsActive(controllerName: "RolePermissionManager", actionName: "Index", areaName: "Admin") || IsActive(controllerName: "ManagePermissions", actionName: "Index", areaName: "Admin"))"><i class="fas fa-lock w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Permissions</span></a></li> }
            </ul>
        </li>
    }

    @if (showAcademic)
    {
        // ----------------------------------------------------- //
        // Academic Setup (Faculties, Programs, Subjects, Semesters, Academic Years)
        // ----------------------------------------------------- //
        <li x-data="{ open: @(isAcademicActive.ToString().ToLower()) }">
            <div class="flex items-center @(isAcademicActive ? ParentClass(true) : ParentClass(false).Replace(" rounded-xl", ""))">
                <a asp-area="" asp-controller="Section" asp-action="AcademicSetup" class="flex items-center gap-3.5 flex-1 min-w-0">
                    <div class="flex items-center justify-center w-6"><i class="fas fa-graduation-cap text-lg opacity-80"></i></div>
                    <span class="flex-1 text-left tracking-wide whitespace-nowrap">Academic Setup</span>
                </a>
                <button @@click.stop="open = !open" class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-white/10 transition-colors shrink-0">
                    <i class="fas transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
                </button>
            </div>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 600px; opacity: 1' : 'max-height: 0; opacity: 0'">
                @if (HasPerm("faculties.view")) { <li><a asp-area="Core" asp-controller="Faculty" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Faculty", actionName: "Index", areaName: "Core"))"><i class="fas fa-building w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Faculties</span></a></li> }
                @if (HasPerm("programs.view")) { <li><a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Programs", actionName: "Index", areaName: "Core"))"><i class="fas fa-stream w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Programs / Streams</span></a></li> }
                @if (HasPerm("semesters.view")) { <li><a asp-area="Core" asp-controller="Semesters" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Semesters", actionName: "Index", areaName: "Core"))"><i class="fas fa-layer-group w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Semesters</span></a></li> }
                @if (HasPerm("academicyears.view")) { <li><a asp-area="Core" asp-controller="AcademicYears" asp-action="Index" class="@ChildClass(IsActive(controllerName: "AcademicYears", actionName: "Index", areaName: "Core"))"><i class="fas fa-calendar-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Academic Years</span></a></li> }
                @if (HasPerm("subjects.view") || HasPerm("subjecttypes.view") || HasPerm("subjectofferings.view") || HasPerm("curriculumversions.view")) { <li class="border-t border-white/10 my-1"></li> }
                @if (HasPerm("subjects.view")) { <li><a asp-area="Subjects" asp-controller="SubjectCatalogs" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectCatalogs", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-book w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Catalogs</span></a></li> }
                @if (HasPerm("subjecttypes.view")) { <li><a asp-area="Subjects" asp-controller="SubjectTypes" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectTypes", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-tags w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Types</span></a></li> }
                @if (HasPerm("subjectofferings.view")) { <li><a asp-area="Subjects" asp-controller="SubjectOfferings" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectOfferings", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-layer-group w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Offerings</span></a></li> }
                @if (HasPerm("curriculumversions.view")) { <li><a asp-area="Subjects" asp-controller="CurriculumVersions" asp-action="Index" class="@ChildClass(IsActive(controllerName: "CurriculumVersions", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-code-branch w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Curriculum Versions</span></a></li> }
            </ul>
        </li>
    }

    @if (showColleges)
    {
        // ----------------------------------------------------- //
        // Colleges
        // ----------------------------------------------------- //
        <li x-data="{ open: @(isCollegeActive.ToString().ToLower()) }">
            <div class="flex items-center @(isCollegeActive ? ParentClass(true) : ParentClass(false).Replace(" rounded-xl", ""))">
                <a asp-area="" asp-controller="Section" asp-action="Colleges" class="flex items-center gap-3.5 flex-1 min-w-0">
                    <div class="flex items-center justify-center w-6"><i class="fas fa-school text-lg opacity-80"></i></div>
                    <span class="flex-1 text-left tracking-wide whitespace-nowrap">Colleges</span>
                </a>
                <button @@click.stop="open = !open" class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-white/10 transition-colors shrink-0">
                    <i class="fas transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
                </button>
            </div>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                @if (HasPerm("colleges.view")) { <li><a asp-area="Colleges" asp-controller="Colleges" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Colleges", actionName: "Index", areaName: "Colleges"))"><i class="fas fa-school w-4 text-center opacity-70"></i><span class="whitespace-nowrap">All Colleges</span></a></li> }
                @if (HasPerm("collegetypes.view")) { <li><a asp-area="Colleges" asp-controller="CollegeTypes" asp-action="Index" class="@ChildClass(IsActive(controllerName: "CollegeTypes", actionName: "Index", areaName: "Colleges"))"><i class="fas fa-tag w-4 text-center opacity-70"></i><span class="whitespace-nowrap">College Types</span></a></li> }
                @if (HasPerm("collegeprograms.view")) { <li><a asp-area="Colleges" asp-controller="CollegePrograms" asp-action="Index" class="@ChildClass(IsActive(controllerName: "CollegePrograms", actionName: "Index", areaName: "Colleges"))"><i class="fas fa-diagram-project w-4 text-center opacity-70"></i><span class="whitespace-nowrap">College Programs</span></a></li> }
            </ul>
        </li>
    }

    @if (showRegistration)
    {
        // ----------------------------------------------------- //
        // Registration
        // ----------------------------------------------------- //
        <li x-data="{ open: @(isRegActive.ToString().ToLower()) }">
            <div class="flex items-center @(isRegActive ? ParentClass(true) : ParentClass(false).Replace(" rounded-xl", ""))">
                <a asp-area="" asp-controller="Section" asp-action="Registration" class="flex items-center gap-3.5 flex-1 min-w-0">
                    <div class="flex items-center justify-center w-6"><i class="fas fa-address-card text-lg opacity-80"></i></div>
                    <span class="flex-1 text-left tracking-wide whitespace-nowrap">Registration</span>
                </a>
                <button @@click.stop="open = !open" class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-white/10 transition-colors shrink-0">
                    <i class="fas transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
                </button>
            </div>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 500px; opacity: 1' : 'max-height: 0; opacity: 0'">
                @if (HasPerm("students.view")) { <li><a asp-area="Students" asp-controller="StudentRegistrations" asp-action="Index" class="@ChildClass(IsActive(controllerName: "StudentRegistrations", actionName: "Index", areaName: "Students"))"><i class="fas fa-user-plus w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Student Registrations</span></a></li> }
                @if (HasPerm("studentcategories.view")) { <li><a asp-area="" asp-controller="StudentCategories" asp-action="Index" class="@ChildClass(IsActive(controllerName: "StudentCategories", actionName: "Index"))"><i class="fas fa-layer-group w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Student Categories</span></a></li> }
                @if (HasPerm("studentadmissions.view")) { <li><a asp-area="Students" asp-controller="StudentAdmissions" asp-action="Index" class="@ChildClass(IsActive(controllerName: "StudentAdmissions", actionName: "Index", areaName: "Students"))"><i class="fas fa-user-graduate w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Student Admissions</span></a></li> }
                @if (HasPerm("studentadmissions.view")) { <li><a asp-area="Students" asp-controller="SemesterEnrollments" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SemesterEnrollments", actionName: "Index", areaName: "Students"))"><i class="fas fa-user-check w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Semester Enrollments</span></a></li> }
            </ul>
        </li>
    }

    @if (showExamination)
    {
        // ----------------------------------------------------- //
        // Examination
        // ----------------------------------------------------- //
        <li x-data="{ open: @(isExamActive.ToString().ToLower()) }">
            <div class="flex items-center @(isExamActive ? ParentClass(true) : ParentClass(false).Replace(" rounded-xl", ""))">
                <a asp-area="" asp-controller="Section" asp-action="Examination" class="flex items-center gap-3.5 flex-1 min-w-0">
                    <div class="flex items-center justify-center w-6"><i class="fas fa-file-alt text-lg opacity-80"></i></div>
                    <span class="flex-1 text-left tracking-wide whitespace-nowrap">Examination</span>
                </a>
                <button @@click.stop="open = !open" class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-white/10 transition-colors shrink-0">
                    <i class="fas transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
                </button>
            </div>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 500px; opacity: 1' : 'max-height: 0; opacity: 0'">
                @if (HasPerm("examschedules.view")) { <li><a asp-area="Exams" asp-controller="ExamSchedules" asp-action="Index" class="@ChildClass(IsActive(controllerName: "ExamSchedules", actionName: "Index", areaName: "Exams"))"><i class="fas fa-calendar-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Exam Schedules</span></a></li> }
