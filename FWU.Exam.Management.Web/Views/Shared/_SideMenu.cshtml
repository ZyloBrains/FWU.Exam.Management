                    <i class="fas transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
                </button>
            </div>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 800px; opacity: 1' : 'max-height: 0; opacity: 0'">
                @if (HasPerm("reports.collegepayments")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="CollegePayments" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "CollegePayments", areaName: "Reports"))"><i class="fas fa-money-check-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">College Payments</span></a></li> }
                @if (HasPerm("reports.subjectcount")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="SubjectCount" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "SubjectCount", areaName: "Reports"))"><i class="fas fa-chart-bar w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Count Report</span></a></li> }
                @if (HasPerm("reports.examtriplicate")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="ExamTriplicate" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "ExamTriplicate", areaName: "Reports"))"><i class="fas fa-copy w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Exam Triplicate</span></a></li> }
                @if (HasPerm("reports.summary")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="Summary" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "Summary", areaName: "Reports"))"><i class="fas fa-chart-pie w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Summary Report</span></a></li> }
                @if (HasPerm("reports.tabulationtriplicate")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="TabulationTriplicate" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "TabulationTriplicate", areaName: "Reports"))"><i class="fas fa-table w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Tabulation Triplicate</span></a></li> }
                @if (HasPerm("reports.programwisestudent")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="ProgramWiseStudent" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "ProgramWiseStudent", areaName: "Reports"))"><i class="fas fa-user-friends w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Program Wise Student</span></a></li> }
                @if (HasPerm("reports.attendanceheet")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="AttendanceSheet" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "AttendanceSheet", areaName: "Reports"))"><i class="fas fa-clipboard-check w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Attendance Sheet</span></a></li> }
                @if (HasPerm("reports.marksfoil")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="MarksFoil" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "MarksFoil", areaName: "Reports"))"><i class="fas fa-poll w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Marks Foil</span></a></li> }
                @if (HasPerm("reports.bankvoucherlist")) { <li><a asp-area="Reports" asp-controller="Reports" asp-action="BankVoucherList" class="@ChildClass(IsActive(controllerName: "Reports", actionName: "BankVoucherList", areaName: "Reports"))"><i class="fas fa-file-invoice-dollar w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Bank Voucher List</span></a></li> }
            </ul>
        </li>
    }
</ul>
