        // ----------------------------------------------------- //
        // Payments Section
        // ----------------------------------------------------- //
        var isPaymentsActive = IsActive(controllerName: "Banks", actionName: "Index", areaName: "Payments") ||
                                IsActive(controllerName: "PaymentTypes", actionName: "Index", areaName: "Payments") ||
                                IsActive(controllerName: "BillTitles", actionName: "Index", areaName: "Payments");
