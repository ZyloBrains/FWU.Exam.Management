                                IsActive(controllerName: "Semesters", actionName: "Index", areaName: "Core") ||
                                IsActive(controllerName: "SmtpConfigurations", actionName: "Index", areaName: "Core") ||
                                IsActive(controllerName: "ESewaConfigurations", actionName: "Index", areaName: "Core") ||
