        // ----------------------------------------------------- //
        // Examination Section
        // ----------------------------------------------------- //
        var isExamActive = IsActive(controllerName: "Entrance", actionName: "Index", areaName: "Exams") || IsActive(controllerName: "ExamSchedules", actionName: "Index", areaName: "Exams");
