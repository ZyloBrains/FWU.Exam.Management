                    <a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(false)">
                        <i class="fas fa-pen-to-square w-4 text-center opacity-70"></i>
                        <span class="whitespace-nowrap">Edit/Verify Exam Form</span>
                    </a>
