                <li><a asp-area="" asp-controller="StudentCategories" asp-action="Index" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-100 hover:bg-admin-blue-light transition-colors duration-200 text-sm @(IsActive(controllerName: "StudentCategories", actionName: "Index") ? "bg-admin-blue-light text-white" : "")"><i class="fas fa-layer-group w-4 text-center"></i><span>Student Categories</span></a></li>
                <li><a asp-area="Core" asp-controller="AcademicYears" asp-action="Index" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-100 hover:bg-admin-blue-light transition-colors duration-200 text-sm @(IsActive(controllerName: "AcademicYears", actionName: "Index", areaName: "Core") ? "bg-admin-blue-light text-white" : "")"><i class="fas fa-user-graduate w-4 text-center"></i><span>Students</span></a></li>
            </ul>
        </li>

        // Location Section
        var isLocationActive = IsActive(controllerName: "Provinces", actionName: "Index", areaName: "Location") ||
                                IsActive(controllerName: "Districts", actionName: "Index", areaName: "Location") ||
                                IsActive(controllerName: "LocalLevels", actionName: "Index", areaName: "Location");
        <li x-data="{ open: @(isLocationActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isLocationActive)">
                <div class="flex items-center justify-center w-6">
                    <i class="fas fa-map-marker-alt text-lg opacity-80"></i>
                </div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Location</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Location" asp-controller="Provinces" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Provinces", actionName: "Index", areaName: "Location"))"><i class="fas fa-map-marked-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Provinces</span></a></li>
                <li><a asp-area="Location" asp-controller="Districts" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Districts", actionName: "Index", areaName: "Location"))"><i class="fas fa-map-pin w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Districts</span></a></li>
                <li><a asp-area="Location" asp-controller="LocalLevels" asp-action="Index" class="@ChildClass(IsActive(controllerName: "LocalLevels", actionName: "Index", areaName: "Location"))"><i class="fas fa-city w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Local Level</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Subjects Section
        // ----------------------------------------------------- //
        var isSubjectsActive = IsActive(controllerName: "SubjectCatalogs", actionName: "Index", areaName: "Subjects") ||
                               IsActive(controllerName: "SubjectTypes", actionName: "Index", areaName: "Subjects") ||
                               IsActive(controllerName: "SubjectOfferings", actionName: "Index", areaName: "Subjects") ||
                               IsActive(controllerName: "CurriculumVersions", actionName: "Index", areaName: "Subjects");
        <li x-data="{ open: @(isSubjectsActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isSubjectsActive)">
                <div class="flex items-center justify-center w-6">
                    <i class="fas fa-book-open text-lg opacity-80"></i>
                </div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Subjects</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Subjects" asp-controller="SubjectCatalogs" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectCatalogs", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-list w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Catalogs</span></a></li>
                <li><a asp-area="Subjects" asp-controller="SubjectTypes" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectTypes", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-tags w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Types</span></a></li>
