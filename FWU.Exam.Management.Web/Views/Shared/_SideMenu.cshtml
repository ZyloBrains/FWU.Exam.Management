                :style="open ? 'max-height: 500px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Colleges" asp-controller="Colleges" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Colleges", actionName: "Index", areaName: "Colleges"))"><i class="fas fa-school w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Colleges</span></a></li>
                <li><a asp-area="Exams" asp-controller="ExamSchedules" asp-action="Index" class="@ChildClass(IsActive(controllerName: "ExamSchedules", actionName: "Index", areaName: "Exams"))"><i class="fas fa-calendar-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Exam Schedules</span></a></li>
            </ul>
        </li>
    }

    @if (isStudent)
    {
        var isStudentActive = 
                              IsActive(controllerName: "StudentDashboard", areaName: "Students") ||
                              IsActive(controllerName: "StudentDashboard", actionName: "Profile", areaName: "Students") ||
                              IsActive(controllerName: "StudentDashboard", actionName: "ExamForms", areaName: "Students") ||
                              IsActive(controllerName: "StudentDashboard", actionName: "Marksheet", areaName: "Students");
        <li x-data="{ open: @(isStudentActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isStudentActive)">
                <div class="flex items-center justify-center w-6">
                    <i class="fas fa-graduation-cap text-lg opacity-80"></i>
                </div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Academic</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-4 space-y-1 overflow-hidden transition-all duration-200"
                :style="open ? 'max-height: 500px; opacity: 1' : 'max-height: 0; opacity: 0'">
               
                <li><a asp-area="Students" asp-controller="StudentDashboard" asp-action="Profile" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-100 hover:bg-admin-blue-light transition-colors duration-200 text-sm @(IsActive(controllerName: "StudentDashboard", actionName: "Profile", areaName: "Students") ? "bg-admin-blue-light text-white" : "")"><i class="fas fa-user w-4 text-center"></i><span>Profile</span></a></li>
                <li><a asp-area="Students" asp-controller="StudentDashboard" asp-action="ExamForms" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-100 hover:bg-admin-blue-light transition-colors duration-200 text-sm @(IsActive(controllerName: "StudentDashboard", actionName: "ExamForms", areaName: "Students") ? "bg-admin-blue-light text-white" : "")"><i class="fas fa-file-invoice w-4 text-center"></i><span>Exam Forms</span></a></li>
                <li><a asp-area="Students" asp-controller="StudentDashboard" asp-action="Marksheet" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-100 hover:bg-admin-blue-light transition-colors duration-200 text-sm @(IsActive(controllerName: "StudentDashboard", actionName: "Marksheet", areaName: "Students") ? "bg-admin-blue-light text-white" : "")"><i class="fas fa-file-alt w-4 text-center"></i><span>Marksheet</span></a></li>
  
            </ul>
        </li>
    }
</ul>
