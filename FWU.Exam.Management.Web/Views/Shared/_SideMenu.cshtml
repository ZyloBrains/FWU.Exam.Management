                                IsActive(controllerName: "AcademicYears", actionName: "Index", areaName: "Core") ||
                                IsActive(controllerName: "Colleges", actionName: "Index", areaName: "Colleges") ||
                                IsActive(controllerName: "CollegePrograms", actionName: "Index", areaName: "Colleges") ||
                                IsActive(controllerName: "CollegeTypes", actionName: "Index", areaName: "Colleges") ||
                              
