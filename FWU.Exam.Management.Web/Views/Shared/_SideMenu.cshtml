@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@{
    // Helper to detect active route (works for both MVC and Razor Pages)
    bool IsActive(string controllerName = null, string actionName = null, string areaName = null, string page = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

        if (!string.IsNullOrEmpty(page))
        {
            return string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrEmpty(areaName) && !string.Equals(currentArea, areaName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(controllerName) && !string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(actionName) && !string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    Func<bool, string> ParentClass = (active) => active 
        ? "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl bg-white/10 text-white font-semibold shadow-sm transition-all duration-200" 
        : "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-blue-100 hover:bg-white/10 hover:text-white transition-all duration-200";

    Func<bool, string> ChildClass = (active) => active 
        ? "flex items-center gap-3 px-4 py-2.5 rounded-lg bg-white/10 text-white font-medium text-sm shadow-sm transition-all duration-200"
        : "flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-200/90 hover:bg-white/10 hover:text-white text-sm transition-all duration-200";

    // Get user and roles
    var sideMenuUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var sideMenuRoles = sideMenuUser != null ? await UserManager.GetRolesAsync(sideMenuUser) : new List<string>();
    var primaryRole = sideMenuRoles.FirstOrDefault() ?? "";
    var isSuperAdmin = primaryRole == "SuperAdmin" || primaryRole == "SystemAdmin";
    var isFacultyAdmin = primaryRole == "FacultyAdmin";
    var isCollegeAdmin = primaryRole == "CollegeAdmin" || primaryRole == "Admin";
    var isStudent = primaryRole == "Student";
}

<ul class="space-y-1.5 px-3 font-poppins">
    <!-- Dashboard - Everyone -->
    <li>
        <a asp-area="" asp-controller="Dashboard" asp-action="Index" class="@ParentClass(IsActive(controllerName: "Dashboard", actionName: "Index"))">
            <div class="flex items-center justify-center w-6">
                <i class="fas fa-home text-lg opacity-80"></i>
            </div>
            <span class="flex-1 text-left tracking-wide">Dashboard</span>
        </a>
    </li>

    @if (isSuperAdmin)
    {
        // ----------------------------------------------------- //
        // User Management
        // ----------------------------------------------------- //
        var isUserActive = IsActive(controllerName: "User") || IsActive(page: "/Account/ForgotPassword");
        <li x-data="{ open: @(isUserActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isUserActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-users text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">User Management</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="" asp-controller="User" asp-action="Index" class="@ChildClass(IsActive(controllerName: "User", actionName: "Index"))"><i class="fas fa-list w-4 text-center opacity-70"></i><span class="whitespace-nowrap">All Users</span></a></li>
                <li><a asp-area="" asp-controller="User" asp-action="Create" class="@ChildClass(IsActive(controllerName: "User", actionName: "Create"))"><i class="fas fa-user-plus w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Create New User</span></a></li>
                <li><a asp-area="Identity" asp-page="/Account/ForgotPassword" class="@ChildClass(IsActive(page: "/Account/ForgotPassword"))"><i class="fas fa-key w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Reset Password</span></a></li>
                <li><a asp-area="" asp-controller="Role" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Role"))"><i class="fas fa-user-shield w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Roles</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Academic Structure (Faculties, Programs, Subjects, Semesters, Academic Years)
        // ----------------------------------------------------- //
        var isAcademicActive = IsActive(controllerName: "Faculty", areaName: "Core") ||
                               IsActive(controllerName: "Programs", areaName: "Core") ||
                               IsActive(controllerName: "Semesters", areaName: "Core") ||
                               IsActive(controllerName: "SubjectCatalogs", areaName: "Subjects") ||
                               IsActive(controllerName: "SubjectTypes", areaName: "Subjects") ||
                               IsActive(controllerName: "SubjectOfferings", areaName: "Subjects") ||
                               IsActive(controllerName: "CurriculumVersions", areaName: "Subjects") ||
                               IsActive(controllerName: "AcademicYears", areaName: "Core");
        <li x-data="{ open: @(isAcademicActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isAcademicActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-graduation-cap text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Academic Setup</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 600px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Core" asp-controller="Faculty" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Faculty", actionName: "Index", areaName: "Core"))"><i class="fas fa-building w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Faculties</span></a></li>
                <li><a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Programs", actionName: "Index", areaName: "Core"))"><i class="fas fa-stream w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Programs / Streams</span></a></li>
                <li><a asp-area="Core" asp-controller="Semesters" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Semesters", actionName: "Index", areaName: "Core"))"><i class="fas fa-layer-group w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Semesters</span></a></li>
                <li><a asp-area="Core" asp-controller="AcademicYears" asp-action="Index" class="@ChildClass(IsActive(controllerName: "AcademicYears", actionName: "Index", areaName: "Core"))"><i class="fas fa-calendar-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Academic Years</span></a></li>
                <li class="border-t border-white/10 my-1"></li>
                <li><a asp-area="Subjects" asp-controller="SubjectCatalogs" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectCatalogs", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-book w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Catalogs</span></a></li>
                <li><a asp-area="Subjects" asp-controller="SubjectTypes" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectTypes", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-tags w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Types</span></a></li>
                <li><a asp-area="Subjects" asp-controller="SubjectOfferings" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SubjectOfferings", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-layer-group w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Offerings</span></a></li>
                <li><a asp-area="Subjects" asp-controller="CurriculumVersions" asp-action="Index" class="@ChildClass(IsActive(controllerName: "CurriculumVersions", actionName: "Index", areaName: "Subjects"))"><i class="fas fa-code-branch w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Curriculum Versions</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Colleges
        // ----------------------------------------------------- //
        var isCollegeActive = IsActive(controllerName: "Colleges", areaName: "Colleges") ||
                              IsActive(controllerName: "CollegeTypes", areaName: "Colleges") ||
                              IsActive(controllerName: "CollegePrograms", areaName: "Colleges");
        <li x-data="{ open: @(isCollegeActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isCollegeActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-school text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Colleges</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Colleges" asp-controller="Colleges" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Colleges", actionName: "Index", areaName: "Colleges"))"><i class="fas fa-school w-4 text-center opacity-70"></i><span class="whitespace-nowrap">All Colleges</span></a></li>
                <li><a asp-area="Colleges" asp-controller="CollegeTypes" asp-action="Index" class="@ChildClass(IsActive(controllerName: "CollegeTypes", actionName: "Index", areaName: "Colleges"))"><i class="fas fa-tag w-4 text-center opacity-70"></i><span class="whitespace-nowrap">College Types</span></a></li>
                <li><a asp-area="Colleges" asp-controller="CollegePrograms" asp-action="Index" class="@ChildClass(IsActive(controllerName: "CollegePrograms", actionName: "Index", areaName: "Colleges"))"><i class="fas fa-diagram-project w-4 text-center opacity-70"></i><span class="whitespace-nowrap">College Programs</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Registration
        // ----------------------------------------------------- //
        var isRegActive = IsActive(controllerName: "StudentRegistrations", areaName: "Students") ||
                          IsActive(controllerName: "StudentCategories");
        <li x-data="{ open: @(isRegActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isRegActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-address-card text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Registration</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Students" asp-controller="StudentRegistrations" asp-action="Index" class="@ChildClass(IsActive(controllerName: "StudentRegistrations", actionName: "Index", areaName: "Students"))"><i class="fas fa-user-plus w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Student Registrations</span></a></li>
                <li><a asp-area="" asp-controller="StudentCategories" asp-action="Index" class="@ChildClass(IsActive(controllerName: "StudentCategories", actionName: "Index"))"><i class="fas fa-layer-group w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Student Categories</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Examination
        // ----------------------------------------------------- //
        var isExamActive = IsActive(controllerName: "Entrance", areaName: "Exams") ||
                           IsActive(controllerName: "ExamSchedules", areaName: "Exams") ||
                           IsActive(controllerName: "ExamTypes", areaName: "Exams");
        <li x-data="{ open: @(isExamActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isExamActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-file-alt text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Examination</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 600px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Exams" asp-controller="ExamSchedules" asp-action="Index" class="@ChildClass(IsActive(controllerName: "ExamSchedules", actionName: "Index", areaName: "Exams"))"><i class="fas fa-calendar-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Exam Schedules</span></a></li>
                <li><a asp-area="Exams" asp-controller="ExamTypes" asp-action="Index" class="@ChildClass(IsActive(controllerName: "ExamTypes", actionName: "Index", areaName: "Exams"))"><i class="fas fa-list-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Exam Types</span></a></li>
                <li><a asp-area="Exams" asp-controller="Entrance" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Entrance", actionName: "Index", areaName: "Exams"))"><i class="fas fa-file-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Entrance Applications</span></a></li>
                <li class="border-t border-white/10 my-1"></li>
                <li><a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-clipboard-list w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Internal Marks Entry</span></a></li>
                <li><a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-hashtag w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Roll No Generation</span></a></li>
                <li><a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-id-card w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Print Admit Card</span></a></li>
                <li><a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-map-marker-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Exam Center Info</span></a></li>
                <li><a asp-area="Core" asp-controller="Programs" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-upload w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Result Upload</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Payments
        // ----------------------------------------------------- //
        var isPayActive = IsActive(controllerName: "Banks", areaName: "Payments") ||
                          IsActive(controllerName: "PaymentTypes", areaName: "Payments") ||
                          IsActive(controllerName: "BillTitles", areaName: "Payments");
        <li x-data="{ open: @(isPayActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isPayActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-money-bill-wave text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Payments</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Payments" asp-controller="Banks" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Banks", actionName: "Index", areaName: "Payments"))"><i class="fas fa-university w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Banks</span></a></li>
                <li><a asp-area="Payments" asp-controller="PaymentTypes" asp-action="Index" class="@ChildClass(IsActive(controllerName: "PaymentTypes", actionName: "Index", areaName: "Payments"))"><i class="fas fa-credit-card w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Payment Types</span></a></li>
                <li><a asp-area="Payments" asp-controller="BillTitles" asp-action="Index" class="@ChildClass(IsActive(controllerName: "BillTitles", actionName: "Index", areaName: "Payments"))"><i class="fas fa-file-invoice-dollar w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Bill Titles</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Location
        // ----------------------------------------------------- //
        var isLocActive = IsActive(controllerName: "Provinces", areaName: "Location") ||
                          IsActive(controllerName: "Districts", areaName: "Location") ||
                          IsActive(controllerName: "LocalLevels", areaName: "Location");
        <li x-data="{ open: @(isLocActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isLocActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-map-marker-alt text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Location</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 400px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="Location" asp-controller="Provinces" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Provinces", actionName: "Index", areaName: "Location"))"><i class="fas fa-map-marked-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Provinces</span></a></li>
                <li><a asp-area="Location" asp-controller="Districts" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Districts", actionName: "Index", areaName: "Location"))"><i class="fas fa-map-pin w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Districts</span></a></li>
                <li><a asp-area="Location" asp-controller="LocalLevels" asp-action="Index" class="@ChildClass(IsActive(controllerName: "LocalLevels", actionName: "Index", areaName: "Location"))"><i class="fas fa-city w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Local Levels</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // System Configuration
        // ----------------------------------------------------- //
        var isConfigActive = IsActive(controllerName: "Tenants") ||
                             IsActive(controllerName: "SmtpConfigurations", areaName: "Core") ||
                             IsActive(controllerName: "ESewaConfigurations", areaName: "Core") ||
                             IsActive(controllerName: "Notices", areaName: "Core") ||
                             IsActive(controllerName: "GradingSchemes");
        <li x-data="{ open: @(isConfigActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isConfigActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-cog text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">System Config</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 500px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-area="" asp-controller="Tenants" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Tenants", actionName: "Index"))"><i class="fas fa-globe w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Tenants</span></a></li>
                <li><a asp-area="Core" asp-controller="SmtpConfigurations" asp-action="Index" class="@ChildClass(IsActive(controllerName: "SmtpConfigurations", actionName: "Index", areaName: "Core"))"><i class="fas fa-envelope w-4 text-center opacity-70"></i><span class="whitespace-nowrap">SMTP Configuration</span></a></li>
                <li><a asp-area="Core" asp-controller="ESewaConfigurations" asp-action="Index" class="@ChildClass(IsActive(controllerName: "ESewaConfigurations", actionName: "Index", areaName: "Core"))"><i class="fas fa-credit-card w-4 text-center opacity-70"></i><span class="whitespace-nowrap">eSewa Configuration</span></a></li>
                <li><a asp-area="Core" asp-controller="Notices" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Notices", actionName: "Index", areaName: "Core"))"><i class="fas fa-bullhorn w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Notices</span></a></li>
            </ul>
        </li>

        // ----------------------------------------------------- //
        // Reports
        // ----------------------------------------------------- //
        <li x-data="{ open: false }">
            <button @@click="open = !open" class="@ParentClass(false)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-chart-line text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">Reports</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 800px; opacity: 1' : 'max-height: 0; opacity: 0'">
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-money-check-alt w-4 text-center opacity-70"></i><span class="whitespace-nowrap">College Payments</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-chart-bar w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Subject Count Report</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-copy w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Exam Triplicate</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-chart-pie w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Summary Report</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-table w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Tabulation Triplicate</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-user-friends w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Program Wise Student</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-clipboard-check w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Attendance Sheet</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-poll w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Marks Foil</span></a></li>
                <li><a asp-controller="ExamSchedule" asp-action="Index" class="@ChildClass(false)"><i class="fas fa-file-invoice-dollar w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Bank Voucher List</span></a></li>
            </ul>
        </li>
    }

    @if (isFacultyAdmin)
    {
        // ----------------------------------------------------- //
        // Academic Setup
        // ----------------------------------------------------- //
        var isFacAcademicActive = IsActive(controllerName: "Colleges", areaName: "Colleges") ||
                                  IsActive(controllerName: "CollegeTypes", areaName: "Colleges") ||
                                  IsActive(controllerName: "CollegePrograms", areaName: "Colleges") ||
                                  IsActive(controllerName: "Programs", areaName: "Core") ||
                                  IsActive(controllerName: "Semesters", areaName: "Core") ||
