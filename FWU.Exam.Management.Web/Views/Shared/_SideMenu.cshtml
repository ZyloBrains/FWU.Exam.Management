@using Microsoft.AspNetCore.Identity
@using FWU.Exam.Management.Application.Interfaces
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IPermissionService PermissionService

@{
    // Helper to detect active route (works for both MVC and Razor Pages)
    bool IsActive(string controllerName = null, string actionName = null, string areaName = null, string page = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

        if (!string.IsNullOrEmpty(page))
        {
            return string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrEmpty(areaName) && !string.Equals(currentArea, areaName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(controllerName) && !string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrEmpty(actionName) && !string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    Func<bool, string> ParentClass = (active) => active 
        ? "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl bg-white/10 text-white font-semibold shadow-sm transition-all duration-200" 
        : "w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-blue-100 hover:bg-white/10 hover:text-white transition-all duration-200";

    Func<bool, string> ChildClass = (active) => active 
        ? "flex items-center gap-3 px-4 py-2.5 rounded-lg bg-white/10 text-white font-medium text-sm shadow-sm transition-all duration-200"
        : "flex items-center gap-3 px-4 py-2.5 rounded-lg text-blue-200/90 hover:bg-white/10 hover:text-white text-sm transition-all duration-200";

    // Get user and permissions
    var sideMenuUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var sideMenuTenantCode = Context.Items["TenantCode"] as string;

    // Get permissions for the current user
    var sideMenuPermissions = sideMenuUser != null
        ? await PermissionService.GetUserPermissionsAsync(sideMenuUser.Id)
        : new List<string>();
    bool HasPerm(string permission) => sideMenuPermissions.Contains(permission);

    // Permission-based section visibility
    var showUserMgmt = HasPerm("users.view") || HasPerm("users.create") || HasPerm("roles.view") || HasPerm("permissions.manage");
    var showAcademic = HasPerm("faculties.view") || HasPerm("programs.view") || HasPerm("semesters.view") || HasPerm("academicyears.view") ||
                       HasPerm("subjects.view") || HasPerm("subjecttypes.view") || HasPerm("subjectofferings.view") || HasPerm("curriculumversions.view");
    var showColleges = HasPerm("colleges.view") || HasPerm("collegetypes.view") || HasPerm("collegeprograms.view");
    var showRegistration = HasPerm("students.view") || HasPerm("studentcategories.view") || HasPerm("studentadmissions.view");
    var showExamination = HasPerm("examschedules.view") || HasPerm("examtypes.view") || HasPerm("entrance.view") ||
                       HasPerm("gradingschemes.view") || HasPerm("examregistrations.view") || HasPerm("examsubjectresults.view") || HasPerm("resultrecords.view") ||
                       HasPerm("examcenters.view") || HasPerm("admitcards.view") || HasPerm("retotaling.view");
    var showPayments = HasPerm("banks.view") || HasPerm("paymenttypes.view") || HasPerm("billtitles.view");
    var showLocation = HasPerm("provinces.view") || HasPerm("districts.view") || HasPerm("locallevels.view");
    var showStudentPortal = HasPerm("student.portal.profile") || HasPerm("student.portal.examforms") || HasPerm("student.portal.marksheet") || HasPerm("student.portal.payment") || HasPerm("retotaling.view");
    var showConfig = HasPerm("tenants.view") || HasPerm("smtp.view") || HasPerm("sms.view") || HasPerm("esewa.view") || HasPerm("khalti.view") || HasPerm("connectips.view") || HasPerm("notices.view");
    var showReports = HasPerm("reports.collegepayments") || HasPerm("reports.subjectcount") || HasPerm("reports.examtriplicate") || HasPerm("reports.summary") ||
                      HasPerm("reports.tabulationtriplicate") || HasPerm("reports.programwisestudent") || HasPerm("reports.attendanceheet") || HasPerm("reports.marksfoil") ||
                      HasPerm("reports.bankvoucherlist");

    // Active state detection for sections
    var isUserActive = IsActive(controllerName: "User") || IsActive(page: "/Account/ForgotPassword") ||
                       IsActive(controllerName: "Role") || IsActive(controllerName: "RolePermissionManager", areaName: "Admin") ||
                       IsActive(controllerName: "ManagePermissions", areaName: "Admin");
    var isAcademicActive = IsActive(controllerName: "Faculty", areaName: "Core") ||
                           IsActive(controllerName: "Programs", areaName: "Core") ||
                           IsActive(controllerName: "Semesters", areaName: "Core") ||
                           IsActive(controllerName: "SubjectCatalogs", areaName: "Subjects") ||
                           IsActive(controllerName: "SubjectTypes", areaName: "Subjects") ||
                           IsActive(controllerName: "SubjectOfferings", areaName: "Subjects") ||
                           IsActive(controllerName: "CurriculumVersions", areaName: "Subjects") ||
                           IsActive(controllerName: "AcademicYears", areaName: "Core");
    var isCollegeActive = IsActive(controllerName: "Colleges", areaName: "Colleges") ||
                          IsActive(controllerName: "CollegeTypes", areaName: "Colleges") ||
                          IsActive(controllerName: "CollegePrograms", areaName: "Colleges");
    var isRegActive = IsActive(controllerName: "StudentRegistrations", areaName: "Students") ||
                      IsActive(controllerName: "StudentCategories") ||
                      IsActive(controllerName: "StudentAdmissions", areaName: "Students");
    var isExamActive = IsActive(controllerName: "Entrance", areaName: "Exams") ||
                       IsActive(controllerName: "ExamSchedules", areaName: "Exams") ||
                       IsActive(controllerName: "ExamTypes", areaName: "Exams") ||
                       IsActive(controllerName: "GradingSchemes", areaName: "Exams") ||
                       IsActive(controllerName: "ExamRegistrations", areaName: "Exams") ||
                       IsActive(controllerName: "ExamSubjectResults", areaName: "Exams") ||
                       IsActive(controllerName: "ResultRecords", areaName: "Exams") ||
                       IsActive(controllerName: "ExamCenters", areaName: "Exams") ||
                       IsActive(controllerName: "AdmitCards", areaName: "Exams") ||
                       IsActive(controllerName: "RetotalRequests", areaName: "Exams");
    var isPayActive = IsActive(controllerName: "Banks", areaName: "Payments") ||
                      IsActive(controllerName: "PaymentTypes", areaName: "Payments") ||
                      IsActive(controllerName: "BillTitles", areaName: "Payments");
    var isLocActive = IsActive(controllerName: "Provinces", areaName: "Location") ||
                      IsActive(controllerName: "Districts", areaName: "Location") ||
                      IsActive(controllerName: "LocalLevels", areaName: "Location");
    var isStudentActive = IsActive(controllerName: "StudentDashboard", areaName: "Students");
    var isConfigActive = IsActive(controllerName: "Tenants") ||
                         IsActive(controllerName: "SmtpConfigurations", areaName: "Core") ||
                         IsActive(controllerName: "TestEmail", areaName: "Core") ||
                         IsActive(controllerName: "ESewaConfigurations", areaName: "Core") ||
                         IsActive(controllerName: "KhaltiConfigurations", areaName: "Core") ||
                         IsActive(controllerName: "ConnectIPSConfigurations", areaName: "Core") ||
                          IsActive(controllerName: "SmsConfigurations", areaName: "Core") ||
                          IsActive(controllerName: "Notices", areaName: "Core");
}

<ul class="space-y-1.5 px-3 font-poppins">
    <!-- Dashboard - Everyone -->
    <li>
        <a asp-area="" asp-controller="Dashboard" asp-action="Index" class="@ParentClass(IsActive(controllerName: "Dashboard", actionName: "Index"))">
            <div class="flex items-center justify-center w-6">
                <i class="fas fa-home text-lg opacity-80"></i>
            </div>
            <span class="flex-1 text-left tracking-wide">Dashboard</span>
        </a>
    </li>

    @if (showUserMgmt)
    {
        // ----------------------------------------------------- //
        // User Management
        // ----------------------------------------------------- //
        <li x-data="{ open: @(isUserActive.ToString().ToLower()) }">
            <button @@click="open = !open" class="@ParentClass(isUserActive)">
                <div class="flex items-center justify-center w-6"><i class="fas fa-users text-lg opacity-80"></i></div>
                <span class="flex-1 text-left tracking-wide whitespace-nowrap">User Management</span>
                <i class="fas ml-auto transition-transform duration-200 text-xs opacity-60 fa-chevron-down" :class="open ? 'rotate-180' : 'rotate-0'"></i>
            </button>
            <ul class="ml-3 pl-3 border-l border-white/10 mt-1 space-y-1 overflow-hidden transition-all duration-300"
                :style="open ? 'max-height: 500px; opacity: 1' : 'max-height: 0; opacity: 0'">
                @if (HasPerm("users.view")) { <li><a asp-area="" asp-controller="User" asp-action="Index" class="@ChildClass(IsActive(controllerName: "User", actionName: "Index"))"><i class="fas fa-list w-4 text-center opacity-70"></i><span class="whitespace-nowrap">All Users</span></a></li> }
                @if (HasPerm("users.create")) { <li><a asp-area="" asp-controller="User" asp-action="Create" class="@ChildClass(IsActive(controllerName: "User", actionName: "Create"))"><i class="fas fa-user-plus w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Create New User</span></a></li> }
                @if (HasPerm("users.edit")) { <li><a href="@(sideMenuTenantCode != null ? $"/tenant/{sideMenuTenantCode}/Identity/Account/ForgotPassword" : "/Identity/Account/ForgotPassword")" class="@ChildClass(IsActive(page: "/Account/ForgotPassword"))"><i class="fas fa-key w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Reset Password</span></a></li> }
                @if (HasPerm("roles.view")) { <li><a asp-area="" asp-controller="Role" asp-action="Index" class="@ChildClass(IsActive(controllerName: "Role"))"><i class="fas fa-user-shield w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Roles</span></a></li> }
                @if (HasPerm("permissions.manage")) { <li><a asp-area="Admin" asp-controller="RolePermissionManager" asp-action="Index" class="@ChildClass(IsActive(controllerName: "RolePermissionManager", actionName: "Index", areaName: "Admin") || IsActive(controllerName: "ManagePermissions", actionName: "Index", areaName: "Admin"))"><i class="fas fa-lock w-4 text-center opacity-70"></i><span class="whitespace-nowrap">Permissions</span></a></li> }
            </ul>
        </li>
    }

    @if (showAcademic)
    {
        // ----------------------------------------------------- //
        // Academic Setup (Faculties, Programs, Subjects, Semesters, Academic Years)
        // ----------------------------------------------------- //
        <li x-data="{ open: @(isAcademicActive.ToString().ToLower()) }">
