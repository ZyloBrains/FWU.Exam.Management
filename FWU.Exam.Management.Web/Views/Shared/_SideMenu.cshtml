@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@{
    var sideMenuUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var sideMenuRoles = sideMenuUser != null ? await UserManager.GetRolesAsync(sideMenuUser) : new List<string>();
    var primaryRole = sideMenuRoles.FirstOrDefault() ?? "";
    var isSystemAdmin = primaryRole == "SystemAdmin";
    var isAdmin = primaryRole == "Admin";
    var isReportAdmin = primaryRole == "ReportAdmin";
    var isStudent = primaryRole == "Student";
}

<ul class="space-y-1 px-3">
    <!-- Dashboard - Everyone -->
    <li>
        <a asp-controller="Dashboard" asp-action="Index"
           class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
            <i class="fas fa-tachometer-alt w-5 text-center"></i>
            <span>Dashboard</span>
        </a>
    </li>

    @if (isSystemAdmin)
    {
        <!-- SystemAdmin: Full access -->
        <li class="pt-3">
            <p class="px-4 text-xs font-semibold text-blue-200 uppercase tracking-wider">System</p>
        </li>
        <li>
            <a asp-controller="Organization" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-building w-5 text-center"></i>
                <span>Organizations</span>
            </a>
        </li>
        <li>
            <a asp-controller="User" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-users w-5 text-center"></i>
                <span>Users</span>
            </a>
        </li>
        <li>
            <a asp-controller="Role" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-user-shield w-5 text-center"></i>
                <span>Roles</span>
            </a>
        </li>
        <li class="pt-3">
            <p class="px-4 text-xs font-semibold text-blue-200 uppercase tracking-wider">Academic</p>
        </li>
        <li>
            <a asp-controller="College" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-school w-5 text-center"></i>
                <span>Colleges</span>
            </a>
        </li>
        <li>
            <a asp-controller="Program" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-graduation-cap w-5 text-center"></i>
                <span>Programs</span>
            </a>
        </li>
        <li>
            <a asp-controller="Subject" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-book w-5 text-center"></i>
                <span>Subjects</span>
            </a>
        </li>
        <li>
            <a asp-controller="AcademicYear" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-calendar w-5 text-center"></i>
                <span>Academic Years</span>
            </a>
        </li>
        <li class="pt-3">
            <p class="px-4 text-xs font-semibold text-blue-200 uppercase tracking-wider">Examination</p>
        </li>
        <li>
            <a asp-controller="ExamSchedule" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-calendar-alt w-5 text-center"></i>
                <span>Exam Schedules</span>
            </a>
        </li>
    }

    @if (isAdmin)
    {
        <!-- Admin: Academic + Exam management -->
        <li class="pt-3">
            <p class="px-4 text-xs font-semibold text-blue-200 uppercase tracking-wider">Academic</p>
        </li>
        <li>
            <a asp-controller="College" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-school w-5 text-center"></i>
                <span>Colleges</span>
            </a>
        </li>
        <li>
            <a asp-controller="Program" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-graduation-cap w-5 text-center"></i>
                <span>Programs</span>
            </a>
        </li>
        <li>
            <a asp-controller="Subject" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-book w-5 text-center"></i>
                <span>Subjects</span>
            </a>
        </li>
        <li>
            <a asp-controller="AcademicYear" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-calendar w-5 text-center"></i>
                <span>Academic Years</span>
            </a>
        </li>
        <li class="pt-3">
            <p class="px-4 text-xs font-semibold text-blue-200 uppercase tracking-wider">Examination</p>
        </li>
        <li>
            <a asp-controller="ExamSchedule" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-calendar-alt w-5 text-center"></i>
                <span>Exam Schedules</span>
            </a>
        </li>
    }
ple
    @if (isReportAdmin)
    {
        <!-- ReportAdmin: Read-only reports -->
        <li class="pt-3">
            <p class="px-4 text-xs font-semibold text-blue-200 uppercase tracking-wider">Reports</p>
        </li>
        <li>
            <a asp-controller="College" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-school w-5 text-center"></i>
                <span>Colleges</span>
            </a>
        </li>
        <li>
            <a asp-controller="Program" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-graduation-cap w-5 text-center"></i>
                <span>Programs</span>
            </a>
        </li>
        <li>
            <a asp-controller="Subject" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-book w-5 text-center"></i>
                <span>Subjects</span>
            </a>
        </li>
        <li>
            <a asp-controller="ExamSchedule" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-calendar-alt w-5 text-center"></i>
                <span>Exam Schedules</span>
            </a>
        </li>
        <li>
            <a asp-controller="AcademicYear" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-calendar w-5 text-center"></i>
                <span>Academic Years</span>
            </a>
        </li>
    }

    @if (isStudent)
    {
        <!-- Student: View-only -->
        <li class="pt-3">
            <p class="px-4 text-xs font-semibold text-blue-200 uppercase tracking-wider">Academic</p>
        </li>
        <li>
            <a asp-controller="Program" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-graduation-cap w-5 text-center"></i>
                <span>Programs</span>
            </a>
        </li>
        <li>
            <a asp-controller="Subject" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-book w-5 text-center"></i>
                <span>Subjects</span>
            </a>
        </li>
        <li>
            <a asp-controller="ExamSchedule" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
                <i class="fas fa-calendar-alt w-5 text-center"></i>
                <span>Exam Schedules</span>
            </a>
        </li>
    }

    <!-- Privacy - Everyone -->
    <li class="pt-3">
        <a asp-controller="Home" asp-action="Privacy"
           class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-admin-blue-light transition-colors duration-200">
            <i class="fas fa-shield-alt w-5 text-center"></i>
            <span>Privacy</span>
        </a>
    </li>
</ul>
