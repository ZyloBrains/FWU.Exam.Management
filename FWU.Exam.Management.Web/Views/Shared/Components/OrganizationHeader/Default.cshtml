@model Organization?

@if (Model != null)
{
    <div class="d-flex align-items-center gap-2 ms-3 border-start ps-3">
        @if (!string.IsNullOrEmpty(Model.LogoPath))
        {
            <img src="@Model.LogoPath" alt="@Model.Name logo" style="height:50px;object-fit:contain;" />
        }
        @* <span class="fw-semibold text-primary small">@Model.Name</span> *@
    </div>
}
