@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FWU.Exam.Management.Domain.Entities
@using FWU.Exam.Management.Web.Helpers
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject FWU.Exam.Management.Infrastructure.AppDbContext DbContext

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Admin Dashboard") - FWU Examination System</title>
    <link rel="icon" type="image/png" href="~/images/fwu-logo-nobg-64x64.png">
    
    <!-- Core Dependencies -->
    <script defer src="~/lib/alpinejs/cdn.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
    <link href="~/lib/fonts/poppins.css" asp-append-version="true" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .select2-container--default .select2-selection--single {
            border-color: #d1d5db;
            border-radius: 0.5rem;
            height: 42px;
            padding: 6px 12px;
            font-size: 0.875rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px;
        }
    </style>
    
    <style>
        /* AlpineJS Cloak */
        [x-cloak] { display: none !important; }

        /* Custom sidebar animations and styles applied to _SideMenu items */
        #sidebar {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 2px 0 25px rgba(0, 0, 0, 0.15);
        }

        /* Subtle sidebar border glow */
        #sidebar::after {
            content: '';
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 1px;
            background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.12), transparent);
        }

        @@media (min-width: 1024px) {
            #sidebar.sidebar-collapsed .sidebar-brand-full { display: none !important; }
            #sidebar.sidebar-collapsed .sidebar-brand-collapsed { display: flex !important; }
            
            #sidebar.sidebar-collapsed nav li > p,
            #sidebar.sidebar-collapsed nav a span,
            #sidebar.sidebar-collapsed nav button span {
                display: none !important;
            }

            #sidebar.sidebar-collapsed nav a,
            #sidebar.sidebar-collapsed nav button {
                justify-content: center;
                padding-left: 0.75rem !important;
                padding-right: 0.75rem !important;
            }
            
            #sidebar.sidebar-collapsed nav i.fa-chevron-down {
                display: none !important;
            }
        }

        /* Sidebar scrollbar styling - subtle glass look */
        #sidebar::-webkit-scrollbar { width: 3px; }
        #sidebar::-webkit-scrollbar-track { background: transparent; }
        #sidebar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 10px; }
        #sidebar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }

        /* Hide scrollbar when not hovering sidebar */
        #sidebar { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.15) transparent; }

        /* Safe area for mobile notch devices */
        .safe-area-bottom {
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }

        /* Better tap highlight for mobile */
        * {
            -webkit-tap-highlight-color: transparent;
        }

        /* Smooth scrolling */
        html {
            scroll-behavior: smooth;
        }

        /* Prevent text size adjust on mobile orientation change */
        body {
            -webkit-text-size-adjust: 100%;
        }

    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-gray-50 text-gray-800 font-poppins antialiased h-screen overflow-hidden">
    @{
        var appUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
        var displayName = appUser != null ? (appUser.UserName ?? appUser.Email ?? "User") : "Guest";
        var userDisplayName = appUser != null
            ? (appUser.FullName ?? appUser.UserName ?? appUser.Email ?? "User")
            : "Guest";
        var roleLabel = "Guest";
        var sidebarLogoPath = "~/images/oce.png";
        var orgName = "";

        var tenantCode = Context.Items["TenantCode"] as string;
        if (!string.IsNullOrEmpty(tenantCode))
        {
            var tenant = await DbContext.Set<Tenant>()
                .AsNoTracking()
                .FirstOrDefaultAsync(t => t.OfficeCode == tenantCode);
            if (tenant != null)
            {
                displayName = tenant.Name;
                orgName = tenant.OfficeCode;
                if (!string.IsNullOrWhiteSpace(tenant.BannerImagePath))
                {
                    sidebarLogoPath = tenant.BannerImagePath;
                }
            }
        }

        if (appUser?.FacultyId != null)
        {
            var faculty = await DbContext.Faculties.FindAsync(appUser.FacultyId.Value);
            if (faculty != null)
            {
                orgName = faculty.Name;
                displayName = faculty.TenantId is int tenantId
                    ? (await DbContext.Set<Tenant>().AsNoTracking().FirstOrDefaultAsync(t => t.Id == tenantId))?.Name
                      ?? faculty.Name
                    : faculty.Name;
                if (!string.IsNullOrWhiteSpace(faculty.LogoPath))
                {
                    sidebarLogoPath = faculty.LogoPath;
                }
            }
        }

        if (appUser != null)
        {
            var roles = await UserManager.GetRolesAsync(appUser);
            var firstRole = roles.FirstOrDefault();
            roleLabel = firstRole != null
                ? System.Text.RegularExpressions.Regex.Replace(firstRole, "([a-z])([A-Z])", "$1 $2")
                : "User";
        }
    }

    <!-- Root App Container with Alpine State -->
    <div x-data="{ 
            mobileSidebarOpen: false, 
            desktopCollapsed: localStorage.getItem('sidebar-collapsed') === 'true' 
         }" 
         x-init="$watch('desktopCollapsed', val => localStorage.setItem('sidebar-collapsed', val))"
         class="flex h-screen overflow-hidden">
        
        <!-- Mobile Sidebar Overlay -->
        <div x-show="mobileSidebarOpen" 
             x-transition.opacity.duration.300ms
             x-on:click="mobileSidebarOpen = false"
             class="fixed inset-0 bg-black/60 backdrop-blur-sm z-30 lg:hidden" x-cloak>
        </div>

        <!-- Sidebar -->
        <aside id="sidebar"
               x-cloak
               class="bg-gradient-to-b from-[#1C4CD2] via-[#1a3fac] to-[#143290] text-white h-screen flex flex-col fixed lg:relative z-40 transform transition-transform duration-300 ease-in-out shrink-0"
               x-bind:class="{ 
                   'translate-x-0 shadow-2xl': mobileSidebarOpen, 
                   '-translate-x-full lg:translate-x-0': !mobileSidebarOpen, 
                   'sidebar-collapsed lg:w-20': desktopCollapsed, 
                   'lg:w-72 w-72': !desktopCollapsed 
               }">
            
            <div class="px-4 py-5 lg:p-6 border-b border-white/[0.07] flex items-center justify-between sticky top-0 bg-[#1C4CD2]/70 backdrop-blur-xl z-10 min-h-[5rem]">
                <!-- Desktop: Full Logo -->
                <img src="@Url.Content(sidebarLogoPath)" alt="Faculty Logo" class="sidebar-brand-full hidden lg:block h-12 lg:h-16 w-full object-contain object-left">

                <!-- Desktop: Collapsed Icon Logo -->
                <div class="sidebar-brand-collapsed hidden w-full items-center justify-center">
                    <div class="w-10 h-10 bg-white/[0.08] rounded-xl flex items-center justify-center ring-1 ring-white/10">
                        <i class="fas fa-graduation-cap text-xl text-sky-300"></i>
                    </div>
                </div>

                <!-- Mobile: Logo -->
                <img src="@Url.Content(sidebarLogoPath)" alt="Logo" class="lg:hidden h-20 w-auto object-contain" />

            </div>

            <nav class="flex-1 overflow-y-auto py-4 custom-scrollbar">
                @if (IsSectionDefined("SideMenu"))
                {
                    @RenderSection("SideMenu")
                }
                else
                {
                    <partial name="_SideMenu" />
                }
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="flex flex-col flex-1 overflow-hidden w-full relative z-10">
            <!-- Header -->
            <header class="bg-gradient-to-r from-blue-700 to-blue-900 shadow-md text-white shrink-0 z-20">
                <div class="flex items-center justify-between px-4 lg:px-6 py-3 lg:py-4">
                    
                    <!-- Left: Toggles & Greeting -->
                    <div class="flex items-center gap-3 lg:gap-5 min-w-0">
                        <!-- Mobile Toggle -->
                        <button x-on:click="mobileSidebarOpen = true" class="lg:hidden p-2 rounded-lg bg-white/10 hover:bg-white/20 active:scale-95 transition-all text-white">
                            <i class="fas fa-bars"></i>
                        </button>

                        <!-- Mobile Page Title -->
                        <h1 class="sm:hidden text-sm font-bold truncate text-white">@ViewData["Title"]</h1>
                        
                        <!-- Desktop Toggle -->
                        <button x-on:click="desktopCollapsed = !desktopCollapsed" class="hidden lg:block p-2 rounded-lg bg-white/10 hover:bg-white/20 active:scale-95 transition-all text-white">
                            <i class="fas fa-bars" x-show="!desktopCollapsed"></i>
                            <i class="fas fa-indent" x-show="desktopCollapsed" x-cloak></i>
                        </button>

                        <div class="hidden sm:block truncate">
                            <h2 class="text-lg lg:text-xl font-bold truncate">@displayName</h2>
                            <p class="text-xs lg:text-sm text-blue-200 truncate opacity-90">
                                @roleLabel@(!string.IsNullOrEmpty(orgName) ? " · " + orgName : "")
                                <span class="hidden md:inline"> · @DateTime.Now.ToString("ddd, MMM dd, yyyy")</span>
                                <span class="hidden md:inline"> · @DateTime.Now.ToNepaliDateString()</span>
                            </p>
                        </div>
                    </div>

                    <!-- Right: Menu Search -->
                    <button type="button"
                            x-on:click="window.dispatchEvent(new CustomEvent('open-menu-search'))"
                            class="hidden md:flex items-center gap-2 pl-3 pr-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 transition-all text-white"
                            title="Search pages (Ctrl+K)">
                        <i class="fas fa-search text-sm"></i>
                        <span class="text-sm font-medium hidden lg:inline">Menu Search</span>
                        <kbd class="hidden lg:inline-flex text-[10px] font-semibold text-blue-100 bg-white/15 rounded px-1.5 py-0.5">Ctrl K</kbd>
                    </button>
                    <button type="button"
                            x-on:click="window.dispatchEvent(new CustomEvent('open-menu-search'))"
                            class="md:hidden p-2 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 transition-all text-white"
                            title="Search pages">
                        <i class="fas fa-search"></i>
                    </button>

                    <!-- Right: User Dropdown -->
                    <div x-data="{ dropdownOpen: false }" x-on:click.away="dropdownOpen = false" class="relative shrink-0">
                        <button x-on:click="dropdownOpen = !dropdownOpen" 
                                class="flex items-center gap-2 lg:gap-3 p-1.5 lg:p-2 rounded-xl hover:bg-white/10 transition-colors duration-200">
                            
                            <!-- User Avatar -->
                            <div class="w-9 h-9 lg:w-11 lg:h-11 bg-white/20 backdrop-blur-sm rounded-full border border-white/30 flex items-center justify-center shadow-inner">
                                <i class="fas fa-user text-white text-sm lg:text-base"></i>
                            </div>
                            
                            <!-- User Info (Desktop only) -->
                            <div class="hidden md:flex flex-col text-left pr-1">
                                <span class="text-sm font-semibold leading-tight text-white">@userDisplayName</span>
                                <span class="text-xs text-blue-200 leading-tight">@roleLabel</span>
                            </div>
                            
                            <i class="fas fa-chevron-down text-white/70 text-xs transition-transform duration-200 hidden md:block" 
                               x-bind:class="dropdownOpen ? 'rotate-180' : ''"></i>
                        </button>

                        <!-- Dropdown Menu -->
                        <div x-show="dropdownOpen" 
                             x-transition:enter="transition ease-out duration-100"
                             x-transition:enter-start="transform opacity-0 scale-95"
                             x-transition:enter-end="transform opacity-100 scale-100"
                             x-transition:leave="transition ease-in duration-75"
                             x-transition:leave-start="transform opacity-100 scale-100"
                             x-transition:leave-end="transform opacity-0 scale-95"
                             class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-gray-100 py-1.5 z-50 origin-top-right overflow-hidden" 
                             x-cloak>

                            @{
                                var tenantPrefix = !string.IsNullOrEmpty(tenantCode) ? $"/tenant/{tenantCode}" : "";
                                var identityBase = $"{tenantPrefix}/Identity/Account";
                            }
                            <a asp-area="" asp-controller="Profile" asp-action="Index" class="group flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 transition-colors">
                                <i class="fas fa-id-badge w-5 text-gray-400 group-hover:text-admin-blue transition-colors"></i>
                                <span class="ml-2 font-medium">My Profile</span>
                            </a>

                            <a href="@identityBase/Manage/ChangePassword" class="group flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 transition-colors">
                                <i class="fas fa-key w-5 text-gray-400 group-hover:text-admin-blue transition-colors"></i>
                                <span class="ml-2 font-medium">Update Password</span>
                            </a>

                            <div class="h-px bg-gray-100 my-1.5"></div>

                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login" class="block m-0">
                                <button type="submit" class="group flex items-center w-full px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors text-left">
                                    <i class="fas fa-sign-out-alt w-5 text-red-400 group-hover:text-red-600 transition-colors"></i>
                                    <span class="ml-2 font-medium">Sign out</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Scrollable Content -->
            <main class="flex-1 overflow-y-auto overflow-x-hidden bg-gray-50/50 p-4 relative">
                <!-- Inner Container -->
                <div class="max-w-full mx-auto">
                    @await Html.PartialAsync("_ToastMessages")
                    @RenderBody()
                </div>
            </main>
        </div>

        <!-- Command Palette: Menu Search -->
        <div x-data="menuSearchPalette()"
             x-on:open-menu-search.window="openPalette()"
             x-on:keydown.escape.window="if (open) closePalette()"
             x-cloak>
            <div x-show="open" x-transition.opacity.duration.150 class="fixed inset-0 z-[60]">
                <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" x-on:click="closePalette()"></div>
                <div class="absolute inset-x-0 top-[15vh] mx-auto w-full max-w-lg px-4">
                    <div x-on:keydown="onKeydown($event)" class="bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
                        <div class="flex items-center gap-3 px-4 py-3.5 border-b border-gray-100">
                            <i class="fas fa-search text-gray-400 text-sm"></i>
                            <input x-ref="input" type="text" autocomplete="off" spellcheck="false"
                                   x-model="query"
                                   x-on:input="index = 0"
                                   placeholder="Search pages..."
                                   class="flex-1 outline-none text-sm text-gray-700 placeholder-gray-400 bg-transparent">
                            <kbd class="shrink-0 text-[10px] font-semibold text-gray-400 border border-gray-200 rounded px-1.5 py-0.5">ESC</kbd>
                        </div>
                        <div x-ref="results" class="max-h-[45vh] overflow-y-auto p-2">
                            <template x-if="filtered.length === 0">
                                <div class="px-4 py-10 text-center">
                                    <i class="fas fa-search text-2xl text-gray-300 mb-2"></i>
                                    <p class="text-sm text-gray-400" x-text="query.trim() ? ('No pages match ' + query) : ''"></p>
                                </div>
                            </template>
                            <template x-for="group in groups" :key="group.name">
                                <div>
                                    <div class="px-3 pt-2.5 pb-1 text-[10px] font-semibold uppercase tracking-wider text-gray-400" x-text="group.name"></div>
                                    <template x-for="item in group.items" :key="item.url">
                                        <a href="#" x-on:click.prevent="navigate(item)"
                                           x-on:mouseenter="index = filtered.indexOf(item)"
                                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm cursor-pointer transition-colors"
                                           :class="filtered[index] === item ? 'bg-blue-50 text-blue-700 palette-active' : 'text-gray-700 hover:bg-gray-50'">
                                            <i class="fas w-4 text-center text-xs"
                                               :class="item.icon + ' ' + (filtered[index] === item ? 'text-blue-500' : 'text-gray-400')"></i>
                                            <span class="flex-1 min-w-0 truncate font-medium" x-text="item.label"></span>
                                            <span class="shrink-0 text-[10px] text-gray-400" x-text="item.section"></span>
                                        </a>
                                    </template>
                                </div>
                            </template>
                        </div>
                        <div class="flex items-center gap-4 px-4 py-2.5 border-t border-gray-100 bg-gray-50/50 text-[11px] text-gray-400">
                            <span><kbd class="border border-gray-200 rounded px-1">&#8593;</kbd> <kbd class="border border-gray-200 rounded px-1">&#8595;</kbd> navigate</span>
                            <span><kbd class="border border-gray-200 rounded px-1">Enter</kbd> open</span>
                            <span class="ml-auto"><kbd class="border border-gray-200 rounded px-1">Ctrl K</kbd> toggle</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Minimal Scripts Footer -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/select2/js/select2.min.js" asp-append-version="true"></script>
    <script>
        var __tenantCode = '@Context.Items["TenantCode"]';
        function tenantUrl(path) {
            return __tenantCode ? '/tenant/' + __tenantCode + path : path;
        }
    </script>
    <script>
        (function () {
            var key = 'sidebar-scroll-top';
            var nav = document.querySelector('nav.flex-1');
            if (!nav) return;
            var saved = sessionStorage.getItem(key);
            if (saved) nav.scrollTop = parseInt(saved, 10);
            nav.addEventListener('scroll', function () {
                sessionStorage.setItem(key, nav.scrollTop);
            });
        })();
    </script>
    <script>
        (function () {
            var dataEl = document.getElementById('sideMenuSearchData');
            window.__sideMenuSearchData = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
        })();
    </script>
    <script>
        function menuSearchPalette() {
            return {
                open: false,
                query: '',
                index: 0,
                items: window.__sideMenuSearchData || [],
                get filtered() {
                    var q = (this.query || '').trim().toLowerCase();
                    if (!q) return this.items;
                    return this.items.filter(function (item) {
                        if ((item.label || '').toLowerCase().indexOf(q) !== -1) return true;
                        if ((item.section || '').toLowerCase().indexOf(q) !== -1) return true;
                        return (item.aliases || []).some(function (a) {
                            return ('' + a).toLowerCase().indexOf(q) !== -1;
                        });
                    });
                },
                get groups() {
                    var map = {};
                    this.filtered.forEach(function (item) {
                        (map[item.section] = map[item.section] || []).push(item);
                    });
                    return Object.keys(map).map(function (name) {
                        return { name: name, items: map[name] };
                    });
                },
                openPalette() {
                    this.open = true;
                    this.query = '';
                    this.index = 0;
                    this.$nextTick(() => {
                        if (this.$refs.input) this.$refs.input.focus();
                    });
                },
                closePalette() {
                    this.open = false;
                },
                onKeydown(e) {
                    var list = this.filtered;
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        if (list.length) this.index = Math.min(this.index + 1, list.length - 1);
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (list.length) this.index = Math.max(this.index - 1, 0);
                    } else if (e.key === 'Enter') {
                        e.preventDefault();
                        if (list[this.index]) this.navigate(list[this.index]);
                    } else if (e.key === 'Escape') {
                        e.preventDefault();
                        this.closePalette();
                        return;
                    }
                    this.$nextTick(() => {
                        var el = this.$refs.results ? this.$refs.results.querySelector('.palette-active') : null;
                        if (el) el.scrollIntoView({ block: 'nearest' });
                    });
                },
                navigate(item) {
                    if (!item || !item.url) return;
                    window.location.href = item.url;
                }
            };
        }
    </script>
    <script>
        document.addEventListener('keydown', function (e) {
            var tag = e.target ? e.target.tagName : '';
            var typing = tag === 'INPUT' || tag === 'TEXTAREA' || (e.target && e.target.isContentEditable);
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                window.dispatchEvent(new CustomEvent('open-menu-search'));
            } else if (!typing && e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey) {
                e.preventDefault();
                window.dispatchEvent(new CustomEvent('open-menu-search'));
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

