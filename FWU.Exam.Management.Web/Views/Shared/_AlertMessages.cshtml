@{
    var success = TempData["SuccessMessage"] as string ?? TempData["Success"] as string;
    var error = TempData["ErrorMessage"] as string ?? TempData["Error"] as string;
}

@if (!string.IsNullOrEmpty(success))
{
    <div class="rounded-lg bg-green-50 p-4 border border-green-200 flex items-start shadow-sm"
         x-data="{ show: true }" x-show="show" x-transition x-init="setTimeout(() => show = false, 5000)">
        <svg class="h-5 w-5 text-green-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="text-sm font-medium text-green-800 whitespace-pre-line flex-1">@success</div>
        <button type="button" x-on:click="show = false"
                class="ml-3 shrink-0 text-green-500 hover:text-green-700">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="rounded-lg bg-red-50 p-4 border border-red-200 flex items-start shadow-sm"
         x-data="{ show: true }" x-show="show" x-transition x-init="setTimeout(() => show = false, 5000)">
        <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="text-sm font-medium text-red-800 whitespace-pre-line flex-1">@error</div>
        <button type="button" x-on:click="show = false"
                class="ml-3 shrink-0 text-red-500 hover:text-red-700">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
}
