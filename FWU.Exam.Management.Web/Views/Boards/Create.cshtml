@model fwu_examination_management_system.Data.Models.Board

@{
    ViewData["Title"] = "Create Board";
}

<div class="max-w-4xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-chalkboard text-purple-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Board</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 gap-5">
                <div>
                    <label asp-for="CountryId" class="text-sm font-medium text-gray-700 block mb-1">Country</label>
                    <select asp-for="CountryId" asp-items="ViewBag.CountryList" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                        <option value="">-- Select Country --</option>
                    </select>
                    <span asp-validation-for="CountryId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="BoardName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <input asp-for="BoardName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="Enter board name" />
                    <span asp-validation-for="BoardName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Remarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                    <textarea asp-for="Remarks" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="Enter remarks (optional)"></textarea>
                    <span asp-validation-for="Remarks" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-purple-600 rounded focus:ring-purple-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-purple-600 text-white text-sm font-semibold rounded-lg hover:bg-purple-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}