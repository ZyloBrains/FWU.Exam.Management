@model FWU.Exam.Management.Domain.Entities.Tenant

@{
    ViewData["Title"] = "Delete Tenant";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-building text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete Tenant</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-4">
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this tenant? This action cannot be undone.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 mb-8">
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Organization Name</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Name)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Office Code</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.OfficeCode)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Email</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Email)</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Contact</p>
                <p class="text-gray-800 font-medium">@(!string.IsNullOrEmpty(Model.ContactNumber) ? Model.ContactNumber : "-")</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Address</p>
                <p class="text-gray-800 font-medium">@(!string.IsNullOrEmpty(Model.Address) ? Model.Address : "-")</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Tenant Type</p>
                <p class="text-gray-800 font-medium">@Model.TenantType</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</p>
                <div class="flex items-center gap-1">
                    @if (Model.IsActive)
                    {
                        <i class="fas fa-check-circle text-green-600"></i>
                        <span class="text-gray-800 font-medium">Active</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-gray-400"></i>
                        <span class="text-gray-800 font-medium">Inactive</span>
                    }
                </div>
            </div>
        </div>

        @if (ViewBag.HasDependencies == true)
        {
            <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <i class="fas fa-exclamation-circle text-red-500 mr-3 text-lg mt-0.5"></i>
                    <div>
                        <p class="text-sm font-semibold text-red-800">Cannot Delete — Associated Data Exists</p>
                        <ul class="text-xs text-red-700 mt-2 space-y-1">
                            @foreach (var kvp in ViewBag.DependencyCounts)
                            {
                                if (kvp.Value > 0)
                                {
                                    <li>• @kvp.Key: @kvp.Value record(s)</li>
                                }
                            }
                        </ul>
                        <p class="text-xs text-red-700 mt-2">Remove or reassign the dependent records before deleting this tenant.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="bg-yellow-50 border-l-4 border-yellow-500 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <i class="fas fa-info-circle text-yellow-500 mr-3 text-lg mt-0.5"></i>
                    <div>
                        <p class="text-sm font-semibold text-yellow-800">Confirm Deletion</p>
                        <p class="text-xs text-yellow-700 mt-1">
                            This action is irreversible. The tenant and its linked faculties will be permanently removed.
                        </p>
                    </div>
                </div>
            </div>
        }

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit"
                        @(ViewBag.HasDependencies == true ? "disabled" : "")
                        onclick="return confirm('Are you sure you want to delete this tenant? This action cannot be undone.');"
                        class="px-6 py-2.5 text-white text-sm font-semibold rounded-lg shadow-md focus:ring-2 focus:ring-offset-2 @(ViewBag.HasDependencies == true ? "bg-gray-400 cursor-not-allowed" : "bg-red-600 hover:bg-red-700 focus:ring-red-500")">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
