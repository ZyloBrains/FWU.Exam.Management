@model FWU.Exam.Management.Web.ViewModels.TenantCreateViewModel

@{
    ViewData["Title"] = "Create Tenant";
}

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-building text-indigo-600"></i>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Create Tenant</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Tenant.Name" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Organization Name</label>
                    <input asp-for="Tenant.Name" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., Far-Western University" />
                    <span asp-validation-for="Tenant.Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Tenant.OfficeCode" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Office Code</label>
                    <input asp-for="Tenant.OfficeCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., FWU" />
                    <span asp-validation-for="Tenant.OfficeCode" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Tenant.Email" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Email</label>
                    <input asp-for="Tenant.Email" type="email" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="admin@example.com" />
                    <span asp-validation-for="Tenant.Email" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Tenant.ContactNumber" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Contact Number</label>
                    <input asp-for="Tenant.ContactNumber" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., 9851234567" />
                    <span asp-validation-for="Tenant.ContactNumber" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Tenant.Address" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Address</label>
                    <input asp-for="Tenant.Address" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., Mahendranagar, Kanchanpur" />
                    <span asp-validation-for="Tenant.Address" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Tenant.BannerImagePath" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Banner Image</label>
                    <input type="file" name="bannerImage" accept=".jpg,.jpeg,.png,.gif,.webp"
                           class="w-full text-sm text-gray-600 file:mr-3 file:px-3 file:py-2 file:rounded-md file:border-0 file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" />
                    <span asp-validation-for="Tenant.BannerImagePath" class="text-xs text-red-500 mt-1 block"></span>
                    <p class="text-xs text-gray-400 mt-1">JPG, PNG, GIF or WebP up to 2 MB. Shown as the profile cover banner for this tenant.</p>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Tenant.LogoPath" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Logo</label>
                    <input type="file" name="logoImage" accept=".jpg,.jpeg,.png,.gif,.webp"
                           class="w-full text-sm text-gray-600 file:mr-3 file:px-3 file:py-2 file:rounded-md file:border-0 file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" />
                    <span asp-validation-for="Tenant.LogoPath" class="text-xs text-red-500 mt-1 block"></span>
                    <p class="text-xs text-gray-400 mt-1">JPG, PNG, GIF or WebP up to 2 MB. Shown as the organization logo on this tenant's profile.</p>
                </div>
                <div>
                    <label asp-for="Tenant.TenantType" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Tenant Type</label>
                    <select asp-for="Tenant.TenantType" asp-items="Html.GetEnumSelectList<FWU.Exam.Management.Domain.Enums.TenantType>()" class="select2 w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" id="TenantTypeSelect"></select>
                    <span asp-validation-for="Tenant.TenantType" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2 mt-7">
                        <input asp-for="Tenant.IsActive" type="checkbox" checked="checked" class="w-4 h-4 text-indigo-600 rounded focus:ring-indigo-500" />
                        <label asp-for="Tenant.IsActive" class="text-xs sm:text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-200 pt-6 mt-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-user-shield text-amber-600"></i>
                    </div>
                    <h2 class="text-base sm:text-lg font-semibold text-gray-800">Admin User</h2>
                </div>
                <p class="text-xs sm:text-sm text-gray-500 mb-4">An admin user will be created for this tenant with the <span class="font-medium text-gray-700">FacultyAdmin</span> role.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="AdminFullName" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Full Name</label>
                        <input asp-for="AdminFullName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., John Doe" />
                        <span asp-validation-for="AdminFullName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="AdminEmail" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Email (Login ID)</label>
                        <input asp-for="AdminEmail" type="email" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="admin@tenant.edu" />
                        <span asp-validation-for="AdminEmail" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="AdminPassword" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Password</label>
                        <div class="relative flex">
                            <input asp-for="AdminPassword" id="AdminPasswordInput" type="password"
                                   class="w-full border border-gray-300 rounded-l-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                            <button type="button" id="toggleAdminPassword"
                                    class="px-2.5 bg-gray-100 border border-l-0 border-gray-300 text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition text-sm">
                                <i class="fas fa-eye" id="toggleAdminPasswordIcon"></i>
                            </button>
                            <button type="button" id="generatePasswordBtn"
                                    class="px-3 bg-indigo-100 text-indigo-700 text-xs font-semibold border border-l-0 border-gray-300 rounded-r-md hover:bg-indigo-200 transition flex items-center gap-1">
                                <i class="fas fa-dice"></i> Generate
                            </button>
                        </div>
                        <span asp-validation-for="AdminPassword" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmAdminPassword" class="text-xs sm:text-sm font-medium text-gray-700 block mb-1">Confirm Password</label>
                        <div class="relative flex">
                            <input asp-for="ConfirmAdminPassword" id="ConfirmAdminPasswordInput" type="password"
                                   class="w-full border border-gray-300 rounded-l-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                            <button type="button" id="toggleConfirmAdminPassword"
                                    class="px-2.5 bg-gray-100 border border-l-0 border-gray-300 rounded-r-md text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition text-sm">
                                <i class="fas fa-eye" id="toggleConfirmAdminPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmAdminPassword" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-indigo-500 text-white text-sm font-semibold rounded-lg hover:bg-indigo-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #d1d5db; border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.25rem; padding: 0; color: #374151; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            outline: 2px solid transparent; outline-offset: 2px;
            border-color: #6366f1;
        }
    </style>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            $('.select2').select2({ width: 'resolve' });

            function togglePassword(inputId, iconId) {
                var $input = $(inputId);
                var $icon = $(iconId);
                if ($input.attr('type') === 'password') {
                    $input.attr('type', 'text');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    $input.attr('type', 'password');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            }

            $('#toggleAdminPassword').on('click', function () {
                togglePassword('#AdminPasswordInput', '#toggleAdminPasswordIcon');
            });

            $('#toggleConfirmAdminPassword').on('click', function () {
                togglePassword('#ConfirmAdminPasswordInput', '#toggleConfirmAdminPasswordIcon');
            });

            $('#generatePasswordBtn').on('click', function () {
                var length = 14;
                var lower = 'abcdefghijklmnopqrstuvwxyz';
                var upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                var digits = '0123456789';
                var special = '@@#$!%*?&';
                var all = lower + upper + digits + special;

                function getRandomChar(str) {
                    var array = new Uint32Array(1);
                    window.crypto.getRandomValues(array);
                    return str[array[0] % str.length];
                }

                function shuffle(arr) {
                    for (var i = arr.length - 1; i > 0; i--) {
                        var array = new Uint32Array(1);
                        window.crypto.getRandomValues(array);
                        var j = array[0] % (i + 1);
                        var tmp = arr[i];
                        arr[i] = arr[j];
                        arr[j] = tmp;
                    }
                }

                var pw = [];
                pw.push(getRandomChar(lower));
                pw.push(getRandomChar(upper));
                pw.push(getRandomChar(digits));
                pw.push(getRandomChar(special));

                for (var i = 4; i < length; i++) {
                    pw.push(getRandomChar(all));
                }

                shuffle(pw);
                var password = pw.join('');

                $('#AdminPasswordInput').val(password).attr('type', 'text');
                $('#toggleAdminPasswordIcon').removeClass('fa-eye').addClass('fa-eye-slash');
                $('#ConfirmAdminPasswordInput').val(password).attr('type', 'text');
                $('#toggleConfirmAdminPasswordIcon').removeClass('fa-eye').addClass('fa-eye-slash');
            });
        });
    </script>
}
