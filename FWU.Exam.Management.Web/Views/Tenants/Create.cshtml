@model FWU.Exam.Management.Web.ViewModels.TenantCreateViewModel

@{
    ViewData["Title"] = "Create Tenant";
}

<div class="w-full mx-auto mt-2 space-y-3 px-4">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-building text-indigo-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Create Tenant</h1>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Tenant.Name" class="text-sm font-medium text-gray-700 block mb-1">Organization Name</label>
                    <input asp-for="Tenant.Name" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., Far-Western University" />
                    <span asp-validation-for="Tenant.Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Tenant.OfficeCode" class="text-sm font-medium text-gray-700 block mb-1">Office Code</label>
                    <input asp-for="Tenant.OfficeCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., FWU" />
                    <span asp-validation-for="Tenant.OfficeCode" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Tenant.Email" class="text-sm font-medium text-gray-700 block mb-1">Email</label>
                    <input asp-for="Tenant.Email" type="email" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="admin@example.com" />
                    <span asp-validation-for="Tenant.Email" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Tenant.ContactNumber" class="text-sm font-medium text-gray-700 block mb-1">Contact Number</label>
                    <input asp-for="Tenant.ContactNumber" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., 9851234567" />
                    <span asp-validation-for="Tenant.ContactNumber" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Tenant.Address" class="text-sm font-medium text-gray-700 block mb-1">Address</label>
                    <input asp-for="Tenant.Address" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., Mahendranagar, Kanchanpur" />
                    <span asp-validation-for="Tenant.Address" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Tenant.LogoPath" class="text-sm font-medium text-gray-700 block mb-1">Logo</label>
                    <input type="file" name="logoFile" accept="image/*" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" />
                </div>
                <div>
                    <label asp-for="Tenant.TenantType" class="text-sm font-medium text-gray-700 block mb-1">Tenant Type</label>
                    <select asp-for="Tenant.TenantType" asp-items="Html.GetEnumSelectList<FWU.Exam.Management.Domain.Enums.TenantType>()" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" id="TenantTypeSelect"></select>
                    <span asp-validation-for="Tenant.TenantType" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div id="FacultyField" style="display:none">
                    <label asp-for="SelectedFacultyId" class="text-sm font-medium text-gray-700 block mb-1">Faculty</label>
                    <select asp-for="SelectedFacultyId" asp-items="Model.FacultyList" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">-- Select Faculty --</option>
                    </select>
                    <span asp-validation-for="SelectedFacultyId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2 mt-7">
                        <input asp-for="Tenant.IsActive" type="checkbox" checked="checked" class="w-4 h-4 text-indigo-600 rounded focus:ring-indigo-500" />
                        <label asp-for="Tenant.IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-200 pt-6 mt-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-user-shield text-amber-600"></i>
                    </div>
                    <h2 class="text-lg font-semibold text-gray-800">Admin User</h2>
                </div>
                <p class="text-sm text-gray-500 mb-4">An admin user will be created for this tenant with the <span class="font-medium text-gray-700">FacultyAdmin</span> role.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="AdminFullName" class="text-sm font-medium text-gray-700 block mb-1">Full Name</label>
                        <input asp-for="AdminFullName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="e.g., John Doe" />
                        <span asp-validation-for="AdminFullName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="AdminEmail" class="text-sm font-medium text-gray-700 block mb-1">Email (Login ID)</label>
                        <input asp-for="AdminEmail" type="email" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="admin@tenant.edu" />
                        <span asp-validation-for="AdminEmail" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="AdminPassword" class="text-sm font-medium text-gray-700 block mb-1">Password</label>
                        <input asp-for="AdminPassword" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="AdminPassword" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmAdminPassword" class="text-sm font-medium text-gray-700 block mb-1">Confirm Password</label>
                        <input asp-for="ConfirmAdminPassword" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <span asp-validation-for="ConfirmAdminPassword" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-indigo-500 text-white text-sm font-semibold rounded-lg hover:bg-indigo-600 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Create
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('TenantTypeSelect').addEventListener('change', function() {
            var facultyField = document.getElementById('FacultyField');
            facultyField.style.display = this.value === '0' ? 'block' : 'none';
        });
        if (document.getElementById('TenantTypeSelect').value === '0') {
            document.getElementById('FacultyField').style.display = 'block';
        }
    </script>
}
