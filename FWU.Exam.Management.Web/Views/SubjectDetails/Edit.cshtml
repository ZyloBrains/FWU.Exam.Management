@model fwu_examination_management_system.Data.Models.Subjects.SubjectDetail

@{
    ViewData["Title"] = "Edit Subject";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-book text-blue-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Edit Subject</h1>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-300 p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 rounded-lg p-2"></div>

            <!-- Section: Basic Information -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="SubjectCode" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="SubjectCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter subject code" />
                        <span asp-validation-for="SubjectCode" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SubjectName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="SubjectName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter subject name" />
                        <span asp-validation-for="SubjectName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ShortName" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ShortName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Short name" />
                        <span asp-validation-for="ShortName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ConcurrentSubjectCode" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="ConcurrentSubjectCode" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Concurrent subject code" />
                        <span asp-validation-for="ConcurrentSubjectCode" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Classification -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Classification</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ProgramsId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="ProgramsId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-items="ViewBag.ProgramsId">
                            <option value="">-- Select Program --</option>
                        </select>
                        <span asp-validation-for="ProgramsId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SubjectGroupId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="SubjectGroupId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-items="ViewBag.SubjectGroupId">
                            <option value="">-- Select Subject Group --</option>
                        </select>
                        <span asp-validation-for="SubjectGroupId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SubjectTypeId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="SubjectTypeId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-items="ViewBag.SubjectTypeId">
                            <option value="">-- Select Subject Type --</option>
                        </select>
                        <span asp-validation-for="SubjectTypeId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="YearPartId" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <select asp-for="YearPartId" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-items="ViewBag.YearPartId">
                            <option value="">-- Select Year/Part --</option>
                        </select>
                        <span asp-validation-for="YearPartId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Year" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="Year" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Year" />
                        <span asp-validation-for="Year" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Part" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="Part" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Part" />
                        <span asp-validation-for="Part" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Marks Distribution -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Marks Distribution</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="TheoryFullMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="TheoryFullMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Theory full marks" />
                        <span asp-validation-for="TheoryFullMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="TheoryPassMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="TheoryPassMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Theory pass marks" />
                        <span asp-validation-for="TheoryPassMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="PracticalFullMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="PracticalFullMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Practical full marks" />
                        <span asp-validation-for="PracticalFullMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="PracticalPassMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="PracticalPassMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Practical pass marks" />
                        <span asp-validation-for="PracticalPassMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Internal Marks -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Internal Marks</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="InternalTheoryFullMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="InternalTheoryFullMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Internal theory full marks" />
                        <span asp-validation-for="InternalTheoryFullMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="InternalTheoryPassMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="InternalTheoryPassMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Internal theory pass marks" />
                        <span asp-validation-for="InternalTheoryPassMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="InternalPracticalFullMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="InternalPracticalFullMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Internal practical full marks" />
                        <span asp-validation-for="InternalPracticalFullMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="InternalPracticalPassMarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="InternalPracticalPassMarks" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Internal practical pass marks" />
                        <span asp-validation-for="InternalPracticalPassMarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Additional Settings -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Additional Settings</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="CreditHours" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="CreditHours" type="number" step="0.5" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Credit hours" />
                        <span asp-validation-for="CreditHours" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="DisplayOrder" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <input asp-for="DisplayOrder" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Display order" />
                        <span asp-validation-for="DisplayOrder" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Remarks" class="text-sm font-medium text-gray-700 block mb-1"></label>
                        <textarea asp-for="Remarks" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Any remarks"></textarea>
                        <span asp-validation-for="Remarks" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Options -->
            <div>
                <h2 class="text-lg font-semibold text-gray-700 mb-3 border-b pb-1">Options</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-center gap-2">
                        <input asp-for="HasTheory" type="checkbox" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                        <label asp-for="HasTheory" class="text-sm font-medium text-gray-700">Has Theory</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input asp-for="HasPractical" type="checkbox" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                        <label asp-for="HasPractical" class="text-sm font-medium text-gray-700">Has Practical</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input asp-for="HasInternal" type="checkbox" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                        <label asp-for="HasInternal" class="text-sm font-medium text-gray-700">Has Internal</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsCompulsory" type="checkbox" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                        <label asp-for="IsCompulsory" class="text-sm font-medium text-gray-700">Is Compulsory</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                        <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Update
                </button>
                <a asp-action="Index" class="px-6 py-2 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}