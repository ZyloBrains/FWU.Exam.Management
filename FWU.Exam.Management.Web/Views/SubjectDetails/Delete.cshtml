@model fwu_examination_management_system.Data.Models.Subjects.SubjectDetail

@{
    ViewData["Title"] = "Delete Subject";
}

<div class="max-w-7xl mx-auto mt-2 space-y-3 px-4">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left text-gray-600"></i>
        </a>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-book text-red-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Delete Subject</h1>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="bg-white rounded-xl shadow-lg border border-red-200 p-8">
        <!-- Warning Alert -->
        <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 mr-3 text-lg"></i>
                <p class="text-sm font-semibold text-red-700">
                    Are you sure you want to delete this subject? This action cannot be undone.
                </p>
            </div>
        </div>

        <!-- Details Section - Two Column Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 mb-8">
            <!-- Subject Code -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Subject Code</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.SubjectCode)</p>
            </div>
            <!-- Subject Name -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Subject Name</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.SubjectName)</p>
            </div>
            <!-- Short Name -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Short Name</p>
                <p class="text-gray-800 font-medium">@(string.IsNullOrEmpty(Model.ShortName) ? "�" : Model.ShortName)</p>
            </div>
            <!-- Program -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Program</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Program.ProgramCode)</p>
            </div>
            <!-- Subject Group -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Subject Group</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.SubjectType.Name)</p>
            </div>
            <!-- Subject Type -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Subject Type</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.SubjectType.Name)</p>
            </div>
            <!-- Year/Part -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Year/Part</p>
                <p class="text-gray-800 font-medium">@Model.Year / @Model.Part</p>
            </div>
            <!-- Year -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Year</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Year)</p>
            </div>
            <!-- Part -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Part</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.Part)</p>
            </div>
            <!-- Credit Hours -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Credit Hours</p>
                <p class="text-gray-800 font-medium">@Html.DisplayFor(model => model.CreditHours)</p>
            </div>
            <!-- Theory Marks -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Theory Marks</p>
                <p class="text-gray-800 font-medium">FM: @Model.TheoryFullMarks | PM: @Model.TheoryPassMarks</p>
            </div>
            <!-- Practical Marks -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Practical Marks</p>
                <p class="text-gray-800 font-medium">FM: @Model.PracticalFullMarks | PM: @Model.PracticalPassMarks</p>
            </div>
            <!-- Has Theory -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Has Theory</p>
                <div class="flex items-center gap-1">
                    @if (Model.HasTheory)
                    {
                        <i class="fas fa-check-circle text-green-600"></i>
                        <span class="text-gray-800 font-medium">Yes</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-gray-400"></i>
                        <span class="text-gray-800 font-medium">No</span>
                    }
                </div>
            </div>
            <!-- Has Practical -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Has Practical</p>
                <div class="flex items-center gap-1">
                    @if (Model.HasPractical)
                    {
                        <i class="fas fa-check-circle text-green-600"></i>
                        <span class="text-gray-800 font-medium">Yes</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-gray-400"></i>
                        <span class="text-gray-800 font-medium">No</span>
                    }
                </div>
            </div>
            <!-- Has Internal -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Has Internal</p>
                <div class="flex items-center gap-1">
                    @if (Model.HasInternal)
                    {
                        <i class="fas fa-check-circle text-green-600"></i>
                        <span class="text-gray-800 font-medium">Yes</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-gray-400"></i>
                        <span class="text-gray-800 font-medium">No</span>
                    }
                </div>
            </div>
            <!-- Is Compulsory -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Is Compulsory</p>
                <div class="flex items-center gap-1">
                    @if (Model.IsCompulsory)
                    {
                        <i class="fas fa-check-circle text-green-600"></i>
                        <span class="text-gray-800 font-medium">Yes</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-gray-400"></i>
                        <span class="text-gray-800 font-medium">No</span>
                    }
                </div>
            </div>
            <!-- Status -->
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</p>
                <div class="flex items-center gap-1">
                    @if (Model.IsActive)
                    {
                        <i class="fas fa-check-circle text-green-600"></i>
                        <span class="text-gray-800 font-medium">Active</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-gray-400"></i>
                        <span class="text-gray-800 font-medium">Inactive</span>
                    }
                </div>
            </div>
            <!-- Remarks -->
            <div class="md:col-span-2">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Remarks</p>
                <p class="text-gray-800 font-medium">@(string.IsNullOrEmpty(Model.Remarks) ? "�" : Model.Remarks)</p>
            </div>
        </div>

        <!-- Delete Form -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
                <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this subject? This action cannot be undone.');"
                        class="px-6 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition shadow-md focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                    <i class="fas fa-trash mr-2"></i> Delete
                </button>
                <a asp-action="Index" class="px-6 py-2.5 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition shadow-md">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>