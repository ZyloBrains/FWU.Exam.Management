    private static readonly DateTime _refAd = new(1943, 4, 13);
    private const int _refBsYear = 2000;

    private static readonly string[] _nepaliMonths = {
        "बैशाख", "जेठ", "असार", "साउन", "भदौ", "असोज",
        "कार्तिक", "मंसिर", "पुष", "माघ", "फागुन", "चैत"
    };

    private static readonly string[] _nepaliDays = {
        "आइतबार", "सोमबार", "मंगलबार", "बुधबार", "बिहिबार",
        "शुक्रबार", "शनिबार"
    };

    private static readonly string[] _nepaliNumerals = {
        "०", "१", "२", "३", "४", "५", "६", "७", "८", "९"
    };

    private static string ToNepaliNumeral(int value)
    {
        var result = string.Empty;
        foreach (var c in value.ToString())
            result += _nepaliNumerals[c - '0'];
        return result;
    }

    public static string ToNepaliDateString(this DateTime adDate)
    {
        var (year, month, day) = AdToBs(adDate);
        var dayOfWeek = (int)adDate.DayOfWeek;
        return $"{_nepaliDays[dayOfWeek]}, {_nepaliMonths[month - 1]} {ToNepaliNumeral(day)}, {ToNepaliNumeral(year)}";
    }

    public static DateTime? BsToAd(int bsYear, int bsMonth, int bsDay)
    {
        if (bsYear < _refBsYear || bsYear > _refBsYear + _monthDays.GetLength(0) - 1)
            return null;

        var totalDays = 0;

        for (var year = _refBsYear; year < bsYear; year++)
        {
            var yearIndex = year - _refBsYear;
            for (var m = 0; m < 12; m++)
                totalDays += _monthDays[yearIndex, m];
        }

        var currentYearIndex = bsYear - _refBsYear;
        for (var m = 0; m < bsMonth - 1; m++)
            totalDays += _monthDays[currentYearIndex, m];

        totalDays += bsDay - 1;

        return _refAd.AddDays(totalDays);
    }

    public static (int Year, int Month, int Day) AdToBs(DateTime adDate)
    {
        var totalDays = (adDate.Date - _refAd).Days;

        if (totalDays < 0)
            return (0, 0, 0);

        var bsYear = _refBsYear;
        var remainingDays = totalDays;

        while (bsYear - _refBsYear < _monthDays.GetLength(0))
        {
            var yearIndex = bsYear - _refBsYear;
            var yearDays = 0;
            for (var m = 0; m < 12; m++)
                yearDays += _monthDays[yearIndex, m];

            if (remainingDays < yearDays)
            {
                for (var m = 0; m < 12; m++)
                {
                    if (remainingDays < _monthDays[yearIndex, m])
                        return (bsYear, m + 1, remainingDays + 1);
                    remainingDays -= _monthDays[yearIndex, m];
                }
            }

            remainingDays -= yearDays;
            bsYear++;
        }

        return (0, 0, 0);
    }
}
